# R's words, for programs ported from R: `use R`. sapply, lapply and vapply are map; c(1, 2, 3) gathers its arguments
# into a list (wiki/argument.md), as R's c combines values into a vector
sapply(xs: list<T>, f: (T) -> U): list<U> := xs.map(f)
lapply(xs: list<T>, f: (T) -> U): list<U> := xs.map(f)
vapply(xs: list<T>, f: (T) -> U): list<U> := xs.map(f)
c(xs: list<T>): list<T> := xs
