# The standard module callbacks (wiki/c.md): a wap function C calls back, `qsort(base, n, 8, c_callback(compare,
# ["handle", "handle"]))`. c_callback hands C one of a fixed set of C functions (lib/native/foreign.c trampolines); C
# calling it calls the native host (wap/extensions/native/host_words.wap callback_answered), which calls this module's
# c_callback_fired(slot, arguments…) during the C call that called back. Its arguments' C types, each "i32", "i64" or
# "handle" (a pointer, held as a handle as every C pointer is), at most CALLBACK_ARGUMENTS; its number or yes/no
# result goes back to C
use foreign

CALLBACK_ARGUMENTS := 6
CALLBACK_TYPES := ["i32", "i64", "handle"]
# each slot's function, called with the list of C's arguments, and their C types
callbacks: list<(list<int>) -> int> = []
callback_types: list<list<text>> = []

# the C function pointer that calls f with arguments of the C types named
c_callback(f: () -> T, types: list<text>): int := registered(given => answer(f()), types)
c_callback(f: (int) -> T, types: list<text>): int := registered(given => answer(f(given[0])), types)
c_callback(f: (int, int) -> T, types: list<text>): int := registered(given => answer(f(given[0], given[1])), types)
c_callback(f: (int, int, int) -> T, types: list<text>): int := registered(given => answer(f(given[0], given[1], given[2])), types)
c_callback(f: (int, int, int, int) -> T, types: list<text>): int := registered(given => answer(f(given[0], given[1], given[2], given[3])), types)
c_callback(f: (int, int, int, int, int) -> T, types: list<text>): int := registered(given => answer(f(given[0], given[1], given[2], given[3], given[4])), types)
c_callback(f: (int, int, int, int, int, int) -> T, types: list<text>): int := registered(given => answer(f(given[0], given[1], given[2], given[3], given[4], given[5])), types)
# what C gets back: a number, or a yes/no as 1 or 0
answer(result: int): int := result
answer(result: bool): int := if result then 1 else 0

registered(called: (list<int>) -> int, types: list<text>): int := {
	if #types > CALLBACK_ARGUMENTS { raise "c_callback: at most ${CALLBACK_ARGUMENTS} arguments, not ${#types}" }
	for type in types { if not CALLBACK_TYPES.contains(type) { raise "c_callback: an argument is one of ${CALLBACK_TYPES.join(", ")}, not ${type}" } }
	callbacks.add(called)
	callback_types.add(types)
	c_callback_pointer(#callbacks - 1)
}
# the C function of a slot, which calls c_callback_fired(slot, …); ø past the trampolines foreign.c has
c_callback_pointer(slot: i64): handle from 'c'

# the call C made, its arguments as the C types said
export c_callback_fired(slot: int, a: int, b: int, c: int, d: int, e: int, g: int): int := {
	given = [a, b, c, d, e, g]
	types = callback_types[slot]
	callbacks[slot]((0 upto #types).map(i => if types[i] == "handle" then c_handle_of(given[i]) else given[i]))
}
