# The standard module callbacks (wiki/c.md): a wap function C calls back, `qsort(base, n, 8, c_callback(compare,
# ["handle", "handle"]))`. c_callback hands C one of a fixed set of C functions (lib/native/foreign.c trampolines); C
# calling it calls this module's c_callback_fired(slot, arguments…) during the C call that called back: directly in a
# program built natively, else through the native host (wap/extensions/native/host_words.wap callback_answered). Its
# arguments' C types, each "i32", "i64" or "handle" (a pointer, held as a handle as every C pointer is), at most
# CALLBACK_ARGUMENTS; its number or yes/no result goes back to C
use foreign

CALLBACK_ARGUMENTS := 6
CALLBACK_TYPES := ["i32", "i64", "handle"]
# each slot's function, called with the list of C's arguments, and their C types
callbacks: list<(list<int>) -> int> = []
callback_types: list<list<text>> = []

# the C function pointer that calls f with arguments of the C types named
c_callback(f: () -> T, types: list<text>): int := registered(given => answer(f()), types)
c_callback(f: (int) -> T, types: list<text>): int := registered(given => answer(f(given[0])), types)
c_callback(f: (int, int) -> T, types: list<text>): int := registered(given => answer(f(given[0], given[1])), types)
c_callback(f: (int, int, int) -> T, types: list<text>): int := registered(given => answer(f(given[0], given[1], given[2])), types)
c_callback(f: (int, int, int, int) -> T, types: list<text>): int := registered(given => answer(f(given[0], given[1], given[2], given[3])), types)
c_callback(f: (int, int, int, int, int) -> T, types: list<text>): int := registered(given => answer(f(given[0], given[1], given[2], given[3], given[4])), types)
c_callback(f: (int, int, int, int, int, int) -> T, types: list<text>): int := registered(given => answer(f(given[0], given[1], given[2], given[3], given[4], given[5])), types)
# what C gets back: a number, a yes/no as 1 or 0, or 0 for a function that gives nothing (any other result)
answer(result: int): int := result
answer(result: bool): int := if result then 1 else 0
answer(result: T): int := 0

registered(called: (list<int>) -> int, types: list<text>): int := {
	if #types > CALLBACK_ARGUMENTS { raise "c_callback: at most ${CALLBACK_ARGUMENTS} arguments, not ${#types}" }
	for type in types { if not CALLBACK_TYPES.contains(type) { raise "c_callback: an argument is one of ${CALLBACK_TYPES.join(", ")}, not ${type}" } }
	callbacks.add(called)
	callback_types.add(types)
	c_callback_pointer(#callbacks - 1)
}
# the C function of a slot, which calls c_callback_fired(slot, …); ø past the trampolines foreign.c has
c_callback_pointer(slot: i64): handle from 'c'

# the call C made, its arguments as the C types said
export c_callback_fired(slot: int, a: int, b: int, c: int, d: int, e: int, g: int): int := {
	given = [a, b, c, d, e, g]
	types = callback_types[slot]
	c_called_back(callbacks[slot], (0 upto #types).map(i => if types[i] == "handle" then c_handle_of(given[i]) else given[i]))
}

# The program's functions JavaScript is given (lib/host/native_host/webview_bridge.js): js_function(f) hands JS
# {"$callback": slot, "handed": n}, which the bridge makes a JS function. JS calls it back through js_called_back with
# its arguments, of which the function takes as many as it has parameters (Array.from gives each item's index too). A
# slot each handing, a slot JS let go (js_released) taken again; each handing counts, so a release that arrives after
# the slot was handed again frees nothing
js_functions: list<(list<any>) -> any> = []
js_handed: list<int> = []
js_free_slots: list<int> = []
js_function(f: () -> T): map<text, int> := js_slot(given => f())
js_function(f: (any) -> T): map<text, int> := js_slot(given => f(given[0]))
js_function(f: (any, any) -> T): map<text, int> := js_slot(given => f(given[0], given[1]))
js_function(f: (any, any, any) -> T): map<text, int> := js_slot(given => f(given[0], given[1], given[2]))
js_slot(called: (list<any>) -> any): map<text, int> := {
	if js_free_slots is empty {
		js_functions.add(called)
		js_handed.add(0)
	}
	slot = if js_free_slots is empty then #js_functions - 1 else js_free_slots.pop()
	js_functions[slot] = called
	js_handed[slot] += 1
	{"$callback": slot, "handed": js_handed[slot]}
}
# JS calling the function of the slot with its arguments: its result
js_called_back(slot: int, given: list<any>): any := js_functions[slot](given)
# what a slot JS let go of holds
let_go(given: list<any>): any := raise "JS called a function back it had let go"
# JS letting go of the slot's handing
js_released(slot: int, handed: int) := {
	if js_handed[slot] == handed and not js_free_slots.contains(slot) {
		js_functions[slot] = let_go
		js_free_slots.add(slot)
	}
}
