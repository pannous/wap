# The standard module channels (wiki/async.md "Channels"): `ch = channel()` hands values from one task to another
# within one run. `ch.send(v)` adds a value, `ch.receive()` takes the oldest, running the tasks (lib/tasks.wap) until one
# sent a value; `for v in ch {…}` receives until the channel is closed and empty. Sending on a closed channel is an
# error, and so is waiting when no task is left to send.
use tasks
use list

class Channel {
	waiting: list<any> = []
	closed: bool = no
}

channel(): Channel := Channel()

send(ch: Channel, value: any) := {
	if ch.closed { raise "send on a closed channel" }
	ch.waiting.add(value)
}
close(ch: Channel) := { ch.closed = yes }

# the tasks run until one sent a value or the channel closed: whether a value waits
more(ch: Channel): bool := {
	while #ch.waiting == 0 and not ch.closed and task_ran() { }
	#ch.waiting > 0
}
receive(ch: Channel): any := {
	if not more(ch) { raise "receive on a channel no task sends to: every task has ended" }
	oldest = ch.waiting#1
	ch.waiting = ch.waiting[1:]
	oldest
}
# `for v in ch {…}`: the next value, ø once the channel is closed and empty
next(ch: Channel): any := if more(ch) then receive(ch) else ø
