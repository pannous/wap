# The standard module collections (wiki/library-collections.md): Stack, Queue, Deque, Set, Counter, PriorityQueue,
# LRUCache and Ring, each a class over a list built from its items, `Queue([1, 2, 3])`, or empty, `Stack()`. A Set and a Counter
# keep the items as given and count each value once, a PriorityQueue gives its smallest item first, the earlier on a
# tie; an LRUCache of a capacity forgets its least recently used key when a new one comes, and a push into a full Ring
# of a capacity drops its oldest item and gives it. Python's and Java's method
# names work as aliases (append, offer, poll, appendleft, popleft, put).
# TODO (card any-char-equality) `xs.contains(x)` in place of holds once contains of an any item stops recursing

class Stack { items: list<any> = [] }
class Queue { items: list<any> = [] }
class Deque { items: list<any> = [] }
class Set { items: list<any> = [] }
class Counter { items: list<any> = [] }
class PriorityQueue { items: list<any> = [] }
class LRUCache { capacity: int, keys: list<any> = [], values: list<any> = [] }
class Ring { capacity: int, items: list<any> = [] }

holds(xs: list<any>, x: any): bool := xs.any(y => y == x)
# each value once, in the order it first comes
distinct(xs: list<any>): list<any> := (0 upto #xs).filter(i => not holds(xs.take(i), xs[i])).map(i => xs[i])
# the first or last item, refused for an empty list
first_of(xs: list<any>, what: text): any := if xs is empty then raise "${what} of an empty collection" else xs[0]
last_of(xs: list<any>, what: text): any := if xs is empty then raise "${what} of an empty collection" else xs.last

push(s: Stack, x: any) := s.items.add(x)
pop(s: Stack): any := {
	top = last_of(s.items, "pop")
	s.items = s.items.take(#s.items - 1)
	top
}
peek(s: Stack): any := last_of(s.items, "peek")
size(s: Stack): int := #s.items
append(s: Stack, x: any) := push(s, x)

enqueue(q: Queue, x: any) := q.items.add(x)
dequeue(q: Queue): any := {
	front = first_of(q.items, "dequeue")
	q.items = q.items.drop(1)
	front
}
peek(q: Queue): any := first_of(q.items, "peek")
size(q: Queue): int := #q.items
offer(q: Queue, x: any) := enqueue(q, x)
poll(q: Queue): any := dequeue(q)

push_back(d: Deque, x: any) := d.items.add(x)
push_front(d: Deque, x: any) := { d.items = [x] + d.items }
pop_back(d: Deque): any := {
	back = last_of(d.items, "pop_back")
	d.items = d.items.take(#d.items - 1)
	back
}
pop_front(d: Deque): any := {
	front = first_of(d.items, "pop_front")
	d.items = d.items.drop(1)
	front
}
peek_front(d: Deque): any := first_of(d.items, "peek_front")
peek_back(d: Deque): any := last_of(d.items, "peek_back")
size(d: Deque): int := #d.items
append(d: Deque, x: any) := push_back(d, x)
appendleft(d: Deque, x: any) := push_front(d, x)
popleft(d: Deque): any := pop_front(d)

members(s: Set): list<any> := distinct(s.items)
add(s: Set, x: any) := { if not holds(s.items, x) { s.items.add(x) } }
remove(s: Set, x: any) := { s.items = s.items.filter(y => y != x) }
contains(s: Set, x: any): bool := holds(s.items, x)
size(s: Set): int := #members(s)
union(a: Set, b: Set): Set := Set(distinct(a.items + b.items))
intersection(a: Set, b: Set): Set := Set(members(a).filter(x => holds(b.items, x)))
difference(a: Set, b: Set): Set := Set(members(a).filter(x => not holds(b.items, x)))
symmetric_difference(a: Set, b: Set): Set := union(difference(a, b), difference(b, a))
is_subset(a: Set, b: Set): bool := a.items.all(x => holds(b.items, x))
is_superset(a: Set, b: Set): bool := is_subset(b, a)
==(a: Set, b: Set): bool := is_subset(a, b) and is_subset(b, a)

add(c: Counter, x: any) := c.items.add(x)
get(c: Counter, x: any): int := c.items.filter(y => y == x).count
# the value counted most often, the first to come on a tie
most_common(c: Counter): any := {
	first_of(c.items, "most_common")
	distinct(c.items).fold(c.items[0], (best, x) => if get(c, x) > get(c, best) then x else best)
}

push(q: PriorityQueue, x: any) := q.items.add(x)
# the place of the smallest item, the earliest on a tie
smallest_place(q: PriorityQueue, what: text): int := {
	first_of(q.items, what)
	(0 upto #q.items).fold(0, (best, i) => if q.items[i] < q.items[best] then i else best)
}
peek(q: PriorityQueue): any := q.items[smallest_place(q, "peek")]
pop(q: PriorityQueue): any := {
	at = smallest_place(q, "pop")
	smallest = q.items[at]
	q.items = q.items.take(at) + q.items.drop(at + 1)
	smallest
}
size(q: PriorityQueue): int := #q.items

has(c: LRUCache, key: any): bool := holds(c.keys, key)
# the key's value, ø for none, the key now the most recently used
get(c: LRUCache, key: any): any := {
	if not has(c, key) { return ø }
	value = c.values[c.keys.index_where(k => k == key) - 1]
	set(c, key, value)
	value
}
# the key's value set, the key the most recently used; the least recently used forgotten when the cache is full
set(c: LRUCache, key: any, value: any) := {
	if c.capacity <= 0 { raise "an LRUCache needs a capacity above 0, not ${c.capacity}" }
	if has(c, key) {
		at = c.keys.index_where(k => k == key) - 1
		c.keys = c.keys.take(at) + c.keys.drop(at + 1)
		c.values = c.values.take(at) + c.values.drop(at + 1)
	} else if #c.keys == c.capacity {
		c.keys = c.keys.drop(1)
		c.values = c.values.drop(1)
	}
	c.keys.add(key)
	c.values.add(value)
}
put(c: LRUCache, key: any, value: any) := set(c, key, value)
size(c: LRUCache): int := #c.keys

# a push gives the item it drops, ø when the ring had room
push(r: Ring, x: any): any := {
	r.items.add(x)
	if #r.items <= r.capacity { return ø }
	oldest = r.items[0]
	r.items = r.items.drop(1)
	oldest
}
pop(r: Ring): any := {
	oldest = first_of(r.items, "pop")
	r.items = r.items.drop(1)
	oldest
}
peek(r: Ring): any := first_of(r.items, "peek")
latest(r: Ring): any := last_of(r.items, "latest")
size(r: Ring): int := #r.items
is_full(r: Ring): bool := #r.items == r.capacity
to_list(r: Ring): list<any> := r.items
