# The standard module complex (wiki/library-complex.md): Complex(re, im), its arithmetic with + - * / and == taking a
# Complex and a plain number on either side, its length and angle, polar form and the principal exp, log, sqrt, pow,
# sin and cos. Its text writes each part as the number it is, the imaginary one with i: 3+4i, 3-4i, i, -i, 2.5i, 0.
# The words that math already has for plain numbers are complex_… here (complex_abs, complex_sqrt …), and abs(z)
# works too; cadd, csub, cmul and cdiv are other names of + - * /.
use math

class Complex { re: float, im: float }

as_complex(x: float): Complex := Complex(x, 0.0)
# the imaginary unit, √-1 (wiki/keyword.md): 3 + 4ⅈ is Complex(3, 4)
ⅈ = Complex(0.0, 1.0)
polar(r: float, theta: float): Complex := Complex(r * cos(theta), r * sin(theta))

+(a: Complex, b: Complex): Complex := Complex(a.re + b.re, a.im + b.im)
-(a: Complex, b: Complex): Complex := Complex(a.re - b.re, a.im - b.im)
-(z: Complex): Complex := Complex(0.0 - z.re, 0.0 - z.im)
*(a: Complex, b: Complex): Complex := Complex(a.re * b.re - a.im * b.im, a.re * b.im + a.im * b.re)
/(a: Complex, b: Complex): Complex := {
	d = b.re * b.re + b.im * b.im
	if d == 0 { raise "complex: division by zero" }
	Complex((a.re * b.re + a.im * b.im) / d, (a.im * b.re - a.re * b.im) / d)
}
==(a: Complex, b: Complex): bool := a.re == b.re and a.im == b.im
# a plain number on either side is the Complex with no imaginary part
==(a: Complex, b: float): bool := a == as_complex(b)
==(a: float, b: Complex): bool := as_complex(a) == b
+(a: Complex, b: float): Complex := a + as_complex(b)
+(a: float, b: Complex): Complex := as_complex(a) + b
-(a: Complex, b: float): Complex := a - as_complex(b)
-(a: float, b: Complex): Complex := as_complex(a) - b
*(a: Complex, b: float): Complex := a * as_complex(b)
*(a: float, b: Complex): Complex := as_complex(a) * b
/(a: Complex, b: float): Complex := a / as_complex(b)
/(a: float, b: Complex): Complex := as_complex(a) / b
cadd(a: Complex, b: Complex): Complex := a + b
csub(a: float, b: Complex): Complex := a - b
cmul(a: Complex, b: Complex): Complex := a * b
cdiv(a: float, b: Complex): Complex := a / b

complex_abs(z: Complex): float := sqrt(z.re * z.re + z.im * z.im)
abs(z: Complex): float := complex_abs(z)
complex_arg(z: Complex): float := atan2(z.im, z.re)
conj(z: Complex): Complex := Complex(z.re, 0.0 - z.im)

complex_exp(z: Complex): Complex := polar(exp(z.re), z.im)
complex_log(z: Complex): Complex := {
	if complex_abs(z) == 0 { raise "complex: the logarithm of 0" }
	Complex(log(complex_abs(z)), complex_arg(z))
}
# the principal square root, its real part ≥ 0
complex_sqrt(z: Complex): Complex := {
	r = complex_abs(z)
	b = sqrt((r - z.re) / 2)
	Complex(sqrt((r + z.re) / 2), if z.im < 0 then 0.0 - b else b)
}
complex_sqrt(x: float): Complex := complex_sqrt(as_complex(x))
# z^w as e^(w·log z); 0^w is 0, and 1 when w is 0
complex_pow(z: Complex, w: Complex): Complex := {
	if complex_abs(z) == 0 { return if complex_abs(w) == 0 then Complex(1.0, 0.0) else Complex(0.0, 0.0) }
	complex_exp(w * complex_log(z))
}
complex_sin(z: Complex): Complex := Complex(sin(z.re) * cosh(z.im), cos(z.re) * sinh(z.im))
complex_cos(z: Complex): Complex := Complex(cos(z.re) * cosh(z.im), 0.0 - sin(z.re) * sinh(z.im))
# whether z lies within the tolerance of w
# a whole power, by repeated multiplying: ⅈ ^ 2 is -1
^(z: Complex, n: int): Complex := if n == 0 then Complex(1.0, 0.0) else if n < 0 then 1.0 / z ^ (0 - n) else z * z ^ (n - 1)
complex_near(z: Complex, w: Complex, tolerance: float): bool := complex_abs(z - w) <= tolerance
complex_near(z: Complex, w: float, tolerance: float): bool := complex_near(z, as_complex(w), tolerance)

text(z: Complex): text := {
	imaginary = if z.im == 1 then "i" else if z.im == -1 then "-i" else "${z.im}i"
	if z.im == 0 then "${z.re}" else if z.re == 0 then imaginary else "${z.re}${if z.im > 0 then "+" else ""}${imaginary}"
}
