# The standard module csv (wiki/library-csv.md, RFC 4180): CSV text as rows of texts or, under its header row, as maps,
# and back. Quoted fields keep commas, doubled quotes and line breaks; lines end in LF or CRLF; csv_text quotes a
# field only when it holds a comma, a quote or a line break, and ends each line in CRLF.

QUOTE := "\""
SEPARATOR := ","
LINE_END := "\r\n"
# what makes a field need quotes when written
SPECIAL := [SEPARATOR, QUOTE, "\n", "\r"]

# the rows of a CSV text, each the list of its fields
csv_rows(t: text): list<list<text>> := {
	characters = t.codepoints.map(c => "" + c)
	rows: list<list<text>> = []
	row: list<text> = []
	field = ""
	quoted = no
	at = 0
	while at < #characters {
		c = characters[at]
		next = if at + 1 < #characters then characters[at + 1] else ""
		if quoted {
			if c != QUOTE { field += c }
			else if next == QUOTE {
				field += QUOTE
				at += 1
			} else { quoted = no }
		} else if c == QUOTE { quoted = yes }
		else if c == SEPARATOR {
			row.add(field)
			field = ""
		} else if c == "\n" or c == "\r" {
			if c == "\r" and next == "\n" { at += 1 }
			rows.add(row + [field])
			row = []
			field = ""
		} else { field += c }
		at += 1
	}
	if quoted { raise "csv: a quote opened and never closed" }
	if #row > 0 or field != "" then rows + [row + [field]] else rows
}

# the rows after the header, each a map of the header's fields to the row's ("" for a field the row lacks)
csv_maps(t: text): list<map<text, text>> := {
	rows = csv_rows(t)
	header = rows[0]
	rows.drop(1).map(row => {
		entries: map<text, text> = {}
		for k in 0 upto #header { entries[header[k]] = if k < #row then row[k] else "" }
		entries
	})
}

# a field as CSV writes it: quoted, its quotes doubled, when it holds a special character
csv_field(field: text): text := if SPECIAL.any(special => field.contains(special)) then QUOTE + field.replace(QUOTE, QUOTE + QUOTE) + QUOTE else field
# rows of texts as CSV text, each line ending in CRLF
csv_text(rows: list<list<text>>): text := rows.map(row => row.map(csv_field).join(SEPARATOR) + LINE_END).join("")
# maps as CSV text under the header row, their values in the header's order
csv_text(maps: list<map<text, text>>, header: list<text>): text := csv_text([header] + maps.map(entries => header.map(key => entries[key])))
