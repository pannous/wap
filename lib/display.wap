# The screen (wiki/graphics.md "Sizes", wiki/unit.md): `display.width`, `display.height` in pixels, its density
# `display.dpi` a quantity that turns lengths into pixels, `3cm * display.dpi`; read only, the host's primary display
use units
use math
use "host/native_host/window.wap"

class Screen {
	width: int
	height: int
	dpi: Quantity
	density(): Quantity := dpi
	ppi(): Quantity := dpi
	size(): list<Quantity> := [width * px, height * px]
	# the diagonal as a length: its nearest whole pixel at the density
	diagonal(): Quantity := round(hypotenuse(width, height)) * px / dpi
}
display := screen_of(display_now())
screen_of(shown: Display): Screen := Screen(shown.width, shown.height, shown.dpi * dpi)
