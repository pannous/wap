# The standard module draw (wiki/graphics.md): `use draw`, a canvas of colored pixels, shapes drawn on it, and show()
# putting it on the screen: natively in a window, with no window (`--no-window`) a PNG in the temporary folder. The
# canvas is color's Picture, shown and saved as image shows and saves one; its colors are color's (rgb, hsv, the named
# colors, with_alpha)
use math
use color
use image
use "host/native_host/window.wap"

# the paper and the ink of the system's theme as the program starts (dark_mode): clear(paper) clears to the paper,
# `ink` draws what stands out on it
PALE := color(0xFAFAFA)
DARK := color(0x1D1D1D)
paper: Color = if dark_mode() then DARK else PALE
ink: Color = if dark_mode() then PALE else DARK

# the canvas until canvas(width, height) sizes it: the size the window is shown at
drawn: Picture = Picture(window_width(), window_height(), blank(window_width(), window_height()))
# the canvas as drawn so far
canvas(): Picture := drawn
# canvas(width, height): a new blank canvas of that size, the window too
canvas(width: int, height: int) := {
	drawn.width = width
	drawn.height = height
	drawn.pixels = blank(width, height)
	window_size_set(width, height)
}
blank(width: int, height: int): list<Color> := (0 upto width * height).map(at => paper)

# clear(red): the canvas all red; clear(canvas): a picture blank, all paper
clear(color: Color) := filled(drawn, color)
clear(picture: Picture) := filled(picture, paper)
filled(picture: Picture, color: Color) := {
	pixels = picture.pixels
	for at in 0 .. #pixels { pixels[at] = color }
}

# the pixel a coordinate falls in
cell(v: float): int := trunc(floor(v))
# how much of a pixel an edge `inside` pixels away from its center covers (negative: outside), smoothed over one pixel
edge(inside: float): float := clamp(inside + 0.5, 0.0, 1.0)
# the pixel col, row covered by `coverage` (0 to 1) of a shape of color, mixed over what is there by its alpha
shade(col: int, row: int, color: Color, coverage: float) := {
	if coverage <= 0 or col < 0 or row < 0 or col >= drawn.width or row >= drawn.height { return }
	at = row * drawn.width + col
	drawn.pixels[at] = mix(drawn.pixels[at], with_alpha(color, 1.0), coverage * alpha_of(color) / BRIGHTEST)
}
# each pixel from x1, y1 up to x2, y2 shaded by what `covered(col, row)` gives
shaded(x1: float, y1: float, x2: float, y2: float, color: Color, covered: (int, int) -> float) := {
	for row in cell(y1) .. cell(y2) + 1 { for col in cell(x1) .. cell(x2) + 1 { shade(col, row, color, covered(col, row)) } }
}

# the pixel x, y
dot(x: float, y: float, color: Color) := shade(cell(x), cell(y), color, 1.0)
# width × height pixels from x, y
rect(x: float, y: float, width: float, height: float, color: Color) := shaded(x, y, x + width - 1, y + height - 1, color, (col, row) => 1.0)
# a filled circle around x, y, its rim smoothed
circle(x: float, y: float, radius: float, color: Color) :=
	shaded(x - radius - 1, y - radius - 1, x + radius + 1, y + radius + 1, color, (col, row) => edge(radius - hypotenuse(col + 0.5 - x, row + 0.5 - y)))
# a line from the pixel x1, y1 to x2, y2, `width` pixels wide with round ends, its edges smoothed
line(x1: float, y1: float, x2: float, y2: float, color: Color, width: float = 1.0) := {
	reach = width / 2 + 1
	shaded(min(x1, x2) - reach, min(y1, y2) - reach, max(x1, x2) + reach, max(y1, y2) + reach, color,
		(col, row) => edge(width / 2 - segment_distance(col, row, x1, y1, x2, y2)))
}
# lines `width` pixels wide through the canvas places [x, y] one after the other
polyline(corners: list<list<float>>, color: Color, width: float = 1.0) := for at in 0 upto #corners - 1 {
	line(corners[at][0], corners[at][1], corners[at + 1][0], corners[at + 1][1], color, width)
}
# how far the pixel col, row is from the line between the pixels x1, y1 and x2, y2, their centers
segment_distance(col: int, row: int, x1: float, y1: float, x2: float, y2: float): float := {
	ahead = x2 - x1
	aside = y2 - y1
	length_squared = ahead * ahead + aside * aside
	share = if length_squared == 0 then 0.0 else clamp(((col - x1) * ahead + (row - y1) * aside) / length_squared, 0.0, 1.0)
	hypotenuse(col - x1 - share * ahead, row - y1 - share * aside)
}

# label(x, y, words, color, size): words set in the system's sans-serif font `size` pixels high from their top left
# corner, their edges mixed with what is below; `font: ./my.ttf` names a font file instead
label(x: float, y: float, words: text, color: Color, size: int = 12, font: text = "") := {
	covered = text_coverage(words, size, font)
	across = covered[0]
	for at in 0 .. across * covered[1] { shade(cell(x) + at % across, cell(y) + at ÷ across, color, covered[at + 2] / BRIGHTEST) }
}

# the canvas on the screen
show() := paint(drawn)
