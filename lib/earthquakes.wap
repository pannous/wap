# The standard module earthquakes (wiki/world.md): the world's earthquakes as the USGS reports them (GeoJSON feeds
# updated each minute, no key). `quakes(4.5).take(3)` gives the last day's quakes of at least that magnitude, then each
# new one as it is reported. A quake is a map: title, place, mag, time (ms since 1970), url, tsunami, alert …
use feeds
use map
use net
use units

# USGS keeps one feed per magnitude floor: all, 1.0, 2.5, 4.5, significant
FEEDS = "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/"
FLOORS = [4.5, 2.5, 1.0]
# how often the feed is asked again: USGS updates it once a minute
QUAKE_PERIOD = 60s

# the last day's quakes of at least the magnitude, then each new one
quakes(magnitude: number = 2.5, every: Quantity = QUAKE_PERIOD): Feed :=
	polled(every, () => quakes_now(magnitude), quake => text(as_data_map(quake).url))

# the day's quakes of at least the magnitude, as the USGS lists them now
quakes_now(magnitude: number): list<any> := {
	answer: map<text, any> = fetch(FEEDS + feed_of(magnitude))
	features: list<any> = answer.features
	strong: list<any> = []
	for feature in features {
		quake = as_data_map(as_data_map(feature).properties)
		if number(quake.mag) >= magnitude { strong.add(quake) }
	}
	strong
}

# the feed holding every quake of the magnitude: the highest floor at or below it
feed_of(magnitude: number): text := {
	floors = FLOORS.filter(floor => floor <= magnitude)
	(if floors is empty then "all" else text(floors#1)) + "_day.geojson"
}
