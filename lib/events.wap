# Named events (wiki/signal.md, wiki/keyword.md emit, listeners): each event's listeners in the order they listen,
# `listen("alarm", data => …, no)` adds one, `emitted("alarm", data)` runs them in that order with the event's data and
# gives the last one's value (ø when none listens), a listener that listens once gone after its first run. A listener
# is a value, so it is removed by itself, `unlisten("alarm", h)`, or by its number within the event, counted from 1.

# a listener: the event it listens to, its number there, whether it listens once, and what it does with the data
class Listener { event: text, number: int, once: bool, act: (any) -> any }

# each event's listeners, by the event's name
listeners: map<text, list<Listener>> = {}
# how many listeners each event has had, so a number is never given twice
listened: map<text, int> = {}

# an event's listeners, none for an event nobody listened to (`listeners[event] ?? []` once a missing key's read
# gives ø instead of raising)
listening(event: text) as list<Listener> := listeners.get(event) ?? []

listen(event: text, act: (any) -> any, once: bool) as Listener := {
	number = (listened.get(event) ?? 0) + 1
	listened[event] = number
	listener = Listener(event, number, once, act)
	listeners[event] = listening(event) + [listener]
	listener
}

emitted(event: text, data: any) as any := {
	running = listening(event)
	listeners[event] = running.filter(listener => not listener.once)
	result: any = ø
	for listener in running { result = listener.act(data) }
	result
}

# the numbers of an event's listeners, in their order
listeners_of(event: text) as list<int> := listening(event).map(listener => listener.number)

unlisten(event: text, number: int) := listeners[event] = listening(event).filter(listener => listener.number != number)
unlisten(listener: Listener) := unlisten(listener.event, listener.number)

# none listen any more
listeners_cleared(event: text) := listeners[event] = []
