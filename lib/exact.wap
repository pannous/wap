# The standard module exact (wiki/number.md): `use exact`. An Exact is a number without bounds or rounding, a whole
# numerator over a positive whole denominator in lowest terms. exact(n), exact(n, d) and exact("2/3"), exact("-1.25"),
# exact("0.3̅") make one; + - * / ÷ % and the comparisons take an Exact or an int on either side, ^ a whole power.
# text(x) is "2/3" or "-5", decimal(x) the decimal with its period overlined, "0.3̅"; numerator, denominator, abs,
# floor, ceil and round (halves away from zero) stay exact; float(x) is the nearest float, int(x) truncates toward
# zero and wraps as ints do.

# a limb holds nine decimal digits, so a limb times a limb plus a carry stays within 64 bits
LIMB := 1000000000
LIMB_DIGITS := 9
# the combining overline written after each digit of a repeating period
OVERLINE := "̅"

# a size: limbs, the lowest first, no zero limb on top; zero has none
class Magnitude { limbs: list<int> }
# sign, numerator and denominator; the denominator is never zero, the sign of zero never negative
class Exact { negative: bool, numerator: Magnitude, denominator: Magnitude }

# --- magnitudes

ZERO = Magnitude([])
ONE = Magnitude([1])
is_zero(m: Magnitude): bool := m.limbs is empty
trimmed(limbs: list<int>): Magnitude := {
	count = #limbs
	while count > 0 and limbs[count - 1] == 0 { count -= 1 }
	Magnitude(limbs.take(count))
}
# |n|, the smallest int's too: each limb is taken from the remainder toward zero, of n's sign
magnitude(n: int): Magnitude := {
	limbs: list<int> = []
	rest = n
	while rest != 0 {
		floored = rest % LIMB
		toward_zero = if rest < 0 and floored != 0 then floored - LIMB else floored
		limbs.add(abs(toward_zero))
		rest = (rest - toward_zero) ÷ LIMB
	}
	Magnitude(limbs)
}
limb(m: Magnitude, i: int): int := if i < #m.limbs then m.limbs[i] else 0
# -1, 0 or 1
compared(a: Magnitude, b: Magnitude): int := {
	if #a.limbs != #b.limbs { return if #a.limbs < #b.limbs then -1 else 1 }
	i = #a.limbs - 1
	while i >= 0 {
		if a.limbs[i] != b.limbs[i] { return if a.limbs[i] < b.limbs[i] then -1 else 1 }
		i -= 1
	}
	0
}
sum(a: Magnitude, b: Magnitude): Magnitude := {
	limbs: list<int> = []
	carry = 0
	for i in 0 upto max(#a.limbs, #b.limbs) {
		total = limb(a, i) + limb(b, i) + carry
		limbs.add(total % LIMB)
		carry = total ÷ LIMB
	}
	trimmed(limbs + [carry])
}
# a - b of a ≥ b
difference(a: Magnitude, b: Magnitude): Magnitude := {
	limbs: list<int> = []
	borrow = 0
	for i in 0 upto #a.limbs {
		total = a.limbs[i] - limb(b, i) - borrow
		borrow = if total < 0 then 1 else 0
		limbs.add(total + borrow * LIMB)
	}
	trimmed(limbs)
}
product(a: Magnitude, b: Magnitude): Magnitude := {
	limbs = (0 upto #a.limbs + #b.limbs).map(i => 0)
	for i in 0 upto #a.limbs {
		carry = 0
		for j in 0 upto #b.limbs {
			total = a.limbs[i] * b.limbs[j] + limbs[i + j] + carry
			limbs[i + j] = total % LIMB
			carry = total ÷ LIMB
		}
		limbs[i + #b.limbs] = carry
	}
	trimmed(limbs)
}
# the whole quotient of a by b and what is left
class Division { quotient: Magnitude, rest: Magnitude }
# long division, a limb of the quotient at a time, each found by halving its range
divided(a: Magnitude, b: Magnitude): Division := {
	if is_zero(b) { raise "division by zero" }
	quotient = (0 upto #a.limbs).map(i => 0)
	rest = ZERO
	i = #a.limbs - 1
	while i >= 0 {
		rest = trimmed([a.limbs[i]] + rest.limbs)
		low = 0
		high = LIMB - 1
		while low < high {
			middle = (low + high + 1) ÷ 2
			if compared(product(b, magnitude(middle)), rest) <= 0 { low = middle } else { high = middle - 1 }
		}
		quotient[i] = low
		rest = difference(rest, product(b, magnitude(low)))
		i -= 1
	}
	Division(trimmed(quotient), rest)
}
common_divisor(a: Magnitude, b: Magnitude): Magnitude := if is_zero(b) then a else common_divisor(b, divided(a, b).rest)
digits(m: Magnitude): text := {
	if is_zero(m) { return "0" }
	top = m.limbs.last
	lower_limbs = m.limbs.take(#m.limbs - 1).reverse().map(part => padded_limb(part))
	"${top}" + lower_limbs.join("")
}
padded_limb(part: int): text := {
	written = "${part}"
	"0" * (LIMB_DIGITS - #written) + written
}
# the magnitude decimal digits spell, nine of them a limb from the right
magnitude_of_digits(written: text): Magnitude := {
	limbs: list<int> = []
	stop = #written
	while stop > 0 {
		start = max(0, stop - LIMB_DIGITS)
		limbs.add(int(written[start:stop]))
		stop = start
	}
	trimmed(limbs)
}

# --- exact numbers

# n/d in lowest terms with its sign, refused for a zero d
exact_of(negative: bool, n: Magnitude, d: Magnitude): Exact := {
	if is_zero(d) { raise "division by zero" }
	common = common_divisor(n, d)
	Exact(negative and not is_zero(n), divided(n, common).quotient, divided(d, common).quotient)
}
exact(n: int): Exact := Exact(n < 0, magnitude(n), ONE)
exact(n: int, d: int): Exact := exact_of((n < 0) != (d < 0), magnitude(n), magnitude(d))
is_whole(x: Exact): bool := compared(x.denominator, ONE) == 0
numerator(x: Exact): Exact := Exact(x.negative, x.numerator, ONE)
denominator(x: Exact): Exact := Exact(no, x.denominator, ONE)
text(x: Exact): text := (if x.negative then "-" else "") + digits(x.numerator) + (if is_whole(x) then "" else "/" + digits(x.denominator))

-(x: Exact): Exact := Exact(not x.negative and not is_zero(x.numerator), x.numerator, x.denominator)
abs(x: Exact): Exact := Exact(no, x.numerator, x.denominator)
+(a: Exact, b: Exact): Exact := {
	left = product(a.numerator, b.denominator)
	right = product(b.numerator, a.denominator)
	below = product(a.denominator, b.denominator)
	if a.negative == b.negative then exact_of(a.negative, sum(left, right), below)
	else if compared(left, right) >= 0 then exact_of(a.negative, difference(left, right), below)
	else exact_of(b.negative, difference(right, left), below)
}
-(a: Exact, b: Exact): Exact := a + -b
*(a: Exact, b: Exact): Exact := exact_of(a.negative != b.negative, product(a.numerator, b.numerator), product(a.denominator, b.denominator))
/(a: Exact, b: Exact): Exact := exact_of(a.negative != b.negative, product(a.numerator, b.denominator), product(a.denominator, b.numerator))
# the floored quotient and the remainder of the same sign as b: a == b * (a ÷ b) + a % b
÷(a: Exact, b: Exact): Exact := floor(a / b)
%(a: Exact, b: Exact): Exact := a - b * (a ÷ b)
# a whole power; a negative one is the reciprocal's
^(x: Exact, k: int): Exact := {
	if k < 0 { return exact(1) / x ^ (0 - k) }
	result = exact(1)
	square = x
	rest = k
	while rest > 0 {
		if rest % 2 == 1 { result = result * square }
		rest = rest ÷ 2
		if rest > 0 { square = square * square }
	}
	result
}

# -1, 0 or 1
order(a: Exact, b: Exact): int := {
	if a.negative != b.negative { return if a.negative then -1 else 1 }
	sizes = compared(product(a.numerator, b.denominator), product(b.numerator, a.denominator))
	if a.negative then 0 - sizes else sizes
}
==(a: Exact, b: Exact): bool := order(a, b) == 0
!=(a: Exact, b: Exact): bool := order(a, b) != 0
<(a: Exact, b: Exact): bool := order(a, b) < 0

# TODO (card library-widening) one widening instead of these pairs
# an int on either side is the exact number it is
+(a: Exact, b: int): Exact := a + exact(b)
+(a: int, b: Exact): Exact := exact(a) + b
-(a: Exact, b: int): Exact := a - exact(b)
-(a: int, b: Exact): Exact := exact(a) - b
*(a: Exact, b: int): Exact := a * exact(b)
*(a: int, b: Exact): Exact := exact(a) * b
/(a: Exact, b: int): Exact := a / exact(b)
/(a: int, b: Exact): Exact := exact(a) / b
==(a: Exact, b: int): bool := a == exact(b)

# --- rounding and machine numbers

# toward zero
truncated(x: Exact): Exact := Exact(x.negative and not is_zero(divided(x.numerator, x.denominator).quotient), divided(x.numerator, x.denominator).quotient, ONE)
floor(x: Exact): Exact := if x.negative and not is_whole(x) then truncated(x) - 1 else truncated(x)
ceil(x: Exact): Exact := -floor(-x)
round(x: Exact): Exact := if x.negative then -floor(-x + exact(1, 2)) else floor(x + exact(1, 2))
float(m: Magnitude): float := m.limbs.reverse().fold(0.0, (value, part) => value * float(LIMB) + float(part))
float(x: Exact): float := (if x.negative then -1.0 else 1.0) * float(x.numerator) / float(x.denominator)
# the whole part toward zero, wrapping past 64 bits as ints do
int(x: Exact): int := {
	whole = divided(x.numerator, x.denominator).quotient
	size = whole.limbs.reverse().fold(0, (value, part) => value * LIMB + part)
	if x.negative then 0 - size else size
}

# --- decimals

# the decimal digits of x, its repeating period overlined: 1/8 is 0.125, 2/3 is 0.6̅, 1/6 is 0.16̅
decimal(x: Exact): text := {
	division = divided(x.numerator, x.denominator)
	sign = if x.negative then "-" else ""
	if is_zero(division.rest) { return sign + digits(division.quotient) }
	ten = magnitude(10)
	fraction_digits: list<text> = []
	seen: list<Magnitude> = []
	rest = division.rest
	while not is_zero(rest) and index_of_magnitude(seen, rest) == #seen {
		seen.add(rest)
		step = divided(product(rest, ten), x.denominator)
		fraction_digits.add(digits(step.quotient))
		rest = step.rest
	}
	period_start = if is_zero(rest) then #fraction_digits else index_of_magnitude(seen, rest)
	plain = fraction_digits.take(period_start).join("")
	period = fraction_digits.drop(period_start).map(digit => digit + OVERLINE).join("")
	sign + digits(division.quotient) + "." + plain + period
}
index_of_magnitude(ms: list<Magnitude>, m: Magnitude): int := {
	for i in 0 upto #ms {
		if compared(ms[i], m) == 0 { return i }
	}
	#ms
}

# "-5", "2/3", "1.25", "0.3̅", "-0.16̅" as the exact number they write
exact(written: text): Exact := {
	t = trim(written)
	negative = t.starts_with("-")
	body = if negative or t.starts_with("+") then t[1:] else t
	if body.contains("/") {
		halves = body.split("/")
		if #halves != 2 { raise "exact: ${written} is no number" }
		quotient = decimal_value(halves[0], written) / decimal_value(halves[1], written)
		return if negative then -quotient else quotient
	}
	value = decimal_value(body, written)
	if negative then -value else value
}
# a decimal without sign, its period's digits each followed by an overline
decimal_value(body: text, written: text): Exact := {
	halves = body.split(".")
	if #halves > 2 or halves[0] == "" or not is_digits(halves[0]) { raise "exact: ${written} is no number" }
	if #halves == 1 { return Exact(no, magnitude_of_digits(halves[0]), ONE) }
	marked = halves[1]
	# the period starts at the digit the first overline follows
	overlined = find(marked, OVERLINE)
	plain = if overlined == 0 then marked else marked[0:overlined - 2]
	period = marked[#plain:].replace(OVERLINE, "")
	if plain + period != "" and not is_digits(plain + period) { raise "exact: ${written} is no number" }
	whole = Exact(no, magnitude_of_digits(halves[0] + plain), ONE) / exact(10) ^ #plain
	if period == "" then whole
	else whole + Exact(no, magnitude_of_digits(period), ONE) / ((exact(10) ^ #period - 1) * exact(10) ^ #plain)
}
