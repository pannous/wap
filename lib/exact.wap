# The standard module exact (wiki/number.md): `use exact`. An Exact is a number without bounds or rounding, a whole
# numerator over a positive whole denominator in lowest terms. exact(n), exact(n, d) and exact("2/3"), exact("-1.25"),
# exact("0.3̅") make one; + - * / ÷ % and the comparisons take an Exact or an int on either side, ^ a whole power.
# text(x) is "2/3" or "-5", decimal(x) the decimal with its period overlined, "0.3̅"; numerator, denominator, abs,
# floor, ceil and round (halves away from zero) stay exact; float(x) is the nearest float, int(x) truncates toward
# zero and wraps as ints do.

use "../kernel/magnitude.wap"

# the combining overline written after each digit of a repeating period
OVERLINE := "̅"

# a signed whole numerator over a denominator, which is never zero (the types' Whole carries the sign)
class Exact { numerator: Whole, denominator: Magnitude }

# --- exact numbers

common_divisor(a: Magnitude, b: Magnitude): Magnitude := if is_zero(b) then a else common_divisor(b, divided(a, b).rest)
# n/d in lowest terms with its sign, refused for a zero d
exact_of(negative: bool, n: Magnitude, d: Magnitude): Exact := {
	if is_zero(d) { raise "division by zero" }
	common = common_divisor(n, d)
	Exact(signed(negative, divided(n, common).quotient), divided(d, common).quotient)
}
# a numerator's sign and size over a denominator, in lowest terms
reduced(n: Whole, d: Magnitude): Exact := exact_of(n.negative, n.size, d)
# a whole size, no fraction
whole_size(m: Magnitude): Exact := Exact(Whole(no, m), ONE)
exact(n: int): Exact := Exact(whole(n), ONE)
exact(n: int, d: int): Exact := exact_of((n < 0) != (d < 0), magnitude(n), magnitude(d))
is_whole(x: Exact): bool := compared(x.denominator, ONE) == 0
numerator(x: Exact): Exact := Exact(x.numerator, ONE)
denominator(x: Exact): Exact := whole_size(x.denominator)
text(x: Exact): text := text(x.numerator) + (if is_whole(x) then "" else "/" + digits(x.denominator))

-(x: Exact): Exact := Exact(-x.numerator, x.denominator)
abs(x: Exact): Exact := Exact(Whole(no, x.numerator.size), x.denominator)
# a numerator times the other's denominator: two fractions over one denominator, compared and added so
over(a: Exact, b: Exact): Whole := a.numerator * Whole(no, b.denominator)
+(a: Exact, b: Exact): Exact := reduced(over(a, b) + over(b, a), product(a.denominator, b.denominator))
-(a: Exact, b: Exact): Exact := a + -b
*(a: Exact, b: Exact): Exact := reduced(a.numerator * b.numerator, product(a.denominator, b.denominator))
/(a: Exact, b: Exact): Exact := exact_of(a.numerator.negative != b.numerator.negative, product(a.numerator.size, b.denominator), product(a.denominator, b.numerator.size))
# the floored quotient and the remainder of the same sign as b: a == b * (a ÷ b) + a % b
÷(a: Exact, b: Exact): Exact := floor(a / b)
%(a: Exact, b: Exact): Exact := a - b * (a ÷ b)
# a whole power; a negative one is the reciprocal's
^(x: Exact, k: int): Exact := {
	if k < 0 { return exact(1) / x ^ (0 - k) }
	result = exact(1)
	square = x
	rest = k
	while rest > 0 {
		if rest % 2 == 1 { result = result * square }
		rest = rest ÷ 2
		if rest > 0 { square = square * square }
	}
	result
}

# -1, 0 or 1
order(a: Exact, b: Exact): int := compared(over(a, b), over(b, a))
==(a: Exact, b: Exact): bool := order(a, b) == 0
!=(a: Exact, b: Exact): bool := order(a, b) != 0
<(a: Exact, b: Exact): bool := order(a, b) < 0

# TODO (card library-widening) one widening instead of these pairs
# an int on either side is the exact number it is
+(a: Exact, b: int): Exact := a + exact(b)
+(a: int, b: Exact): Exact := exact(a) + b
-(a: Exact, b: int): Exact := a - exact(b)
-(a: int, b: Exact): Exact := exact(a) - b
*(a: Exact, b: int): Exact := a * exact(b)
*(a: int, b: Exact): Exact := exact(a) * b
/(a: Exact, b: int): Exact := a / exact(b)
/(a: int, b: Exact): Exact := exact(a) / b
==(a: Exact, b: int): bool := a == exact(b)

# --- rounding and machine numbers

# toward zero
truncated(x: Exact): Exact := Exact(signed(x.numerator.negative, divided(x.numerator.size, x.denominator).quotient), ONE)
floor(x: Exact): Exact := if x.numerator.negative and not is_whole(x) then truncated(x) - 1 else truncated(x)
ceil(x: Exact): Exact := -floor(-x)
round(x: Exact): Exact := if x.numerator.negative then -floor(-x + exact(1, 2)) else floor(x + exact(1, 2))
float(m: Magnitude): float := m.limbs.reverse().fold(0.0, (value, part) => value * float(LIMB) + float(part))
float(x: Exact): float := (if x.numerator.negative then -1.0 else 1.0) * float(x.numerator.size) / float(x.denominator)
# the whole part toward zero, wrapping past 64 bits as ints do
int(x: Exact): int := {
	size = divided(x.numerator.size, x.denominator).quotient.limbs.reverse().fold(0, (value, part) => value * LIMB + part)
	if x.numerator.negative then 0 - size else size
}

# --- decimals

# the decimal digits of x, its repeating period overlined: 1/8 is 0.125, 2/3 is 0.6̅, 1/6 is 0.16̅
decimal(x: Exact): text := {
	division = divided(x.numerator.size, x.denominator)
	sign = if x.numerator.negative then "-" else ""
	if is_zero(division.rest) { return sign + digits(division.quotient) }
	ten = magnitude(10)
	fraction_digits: list<text> = []
	seen: list<Magnitude> = []
	rest = division.rest
	while not is_zero(rest) and index_of_magnitude(seen, rest) == #seen {
		seen.add(rest)
		step = divided(product(rest, ten), x.denominator)
		fraction_digits.add(digits(step.quotient))
		rest = step.rest
	}
	period_start = if is_zero(rest) then #fraction_digits else index_of_magnitude(seen, rest)
	plain = fraction_digits.take(period_start).join("")
	period = fraction_digits.drop(period_start).map(digit => digit + OVERLINE).join("")
	sign + digits(division.quotient) + "." + plain + period
}
index_of_magnitude(ms: list<Magnitude>, m: Magnitude): int := {
	for i in 0 upto #ms {
		if compared(ms[i], m) == 0 { return i }
	}
	#ms
}

# "-5", "2/3", "1.25", "0.3̅", "-0.16̅" as the exact number they write
exact(written: text): Exact := {
	t = trim(written)
	negative = t.starts_with("-")
	body = if negative or t.starts_with("+") then t[1:] else t
	if body.contains("/") {
		halves = body.split("/")
		if #halves != 2 { raise "exact: ${written} is no number" }
		quotient = decimal_value(halves[0], written) / decimal_value(halves[1], written)
		return if negative then -quotient else quotient
	}
	value = decimal_value(body, written)
	if negative then -value else value
}
# a decimal without sign, its period's digits each followed by an overline
decimal_value(body: text, written: text): Exact := {
	halves = body.split(".")
	if #halves > 2 or halves[0] == "" or not is_digits(halves[0]) { raise "exact: ${written} is no number" }
	if #halves == 1 { return whole_size(magnitude_of_digits(halves[0])) }
	marked = halves[1]
	# the period starts at the digit the first overline follows
	overlined = find(marked, OVERLINE)
	plain = if overlined == 0 then marked else marked[0:overlined - 2]
	period = marked[#plain:].replace(OVERLINE, "")
	if plain + period != "" and not is_digits(plain + period) { raise "exact: ${written} is no number" }
	whole = whole_size(magnitude_of_digits(halves[0] + plain)) / exact(10) ^ #plain
	if period == "" then whole
	else whole + whole_size(magnitude_of_digits(period)) / ((exact(10) ^ #period - 1) * exact(10) ^ #plain)
}
