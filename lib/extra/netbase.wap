# netbase (github.com/pannous/netbase), a semantic graph database answering natural queries over HTTP: `use netbase`,
# then `query "all cities with population > 100000"` asks a local `./netbase :server` on port 8181 and query_at(server,
# q) any other server; the entities found come back as records.
use net
use url

NETBASE_LOCAL := "http://localhost:8181"
QUERY_PATH := "/json/query/"

# the entities netbase finds at the server for the query, as records
query_at(server: text, q: text): any := fetch(server + QUERY_PATH + url_encode(q))
query(q: text): any := query_at(NETBASE_LOCAL, q)

# `load "wikidata"`: the server imports its data itself (`./netbase :import wikidata`), so load asks it whether it
# answers for the dataset, and without one says what to start
load(dataset: text): any := try { query(dataset) } catch failure {
	raise "netbase: no server answers at ${NETBASE_LOCAL} to load ${dataset}: run ./netbase :import ${dataset} and ./netbase :server"
}
