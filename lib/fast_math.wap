# The standard module fast_math: `use fast_math` rebinds sin, cos, exp, pow and atan2, in the files using it, to
# lib/machine_math.wap's polynomials, for hot loops such as shaders run on the CPU. Their precision is machine_math's,
# said there.
use machine_math

alias sin => fast_sin
alias cos => fast_cos
alias exp => fast_exp
alias pow => fast_pow
alias atan2 => fast_atan2
