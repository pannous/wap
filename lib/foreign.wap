# The standard module foreign: the program's side of a C function it calls, a foreign line `getenv(name: text): text from 'c'` (its rule:
# extensions/c/foreign.wap; the section that describes it for the native warp: extensions/c/functions.wap). A text goes to C
# as the address of its bytes and a NUL, the texts of one call one after another in the memory from BYTES_AT, after those
# of the calls it runs within; a text C gives back is copied from where its pointer points, an empty one for NULL. An
# int32 crossing to C is an address of the module's memory, which the native warp gives C as its pointer. A module whose
# foreign lines call C uses it; outside the types module, so only a program that calls C imports C's memmove, free,
# strnlen and memcpy, which a host without C (wasmtime) lacks.
# (the types module's host machinery, beside this library wherever wap is: in the compiler's folder)
use "../types/host.wap"

POINTER_BYTES := 8
# how many callbacks of C run: a call made while none runs is outermost and starts from the beginning, so one that
# raised before it ended leaves nothing behind
c_callbacks_running = 0
# The C call running: where its next text goes; its first out-pointer's slot (`sqlite3 **`), 0 when it has none; of
# the copies of the lists handed to the calls running (handed_at), how many and where the running call's still to be
# read back start
c_texts_end = BYTES_AT
c_outs = 0
c_handed = 0
c_handed_from = 0
# a call made while another runs (from a callback of its C, or in one of its arguments) places its texts, slots and
# copies after the running one's, so it overwrites none of them, and gives it its state back when it ends
class CCall { texts_end: int; outs: int; handed: int; handed_from: int; callbacks: int }
# DEBT: Where texts are GC values, the host's words (a file read, a path) still place their bytes from BYTES_AT
#   (host.wap scratch): one used by a callback overwrites the texts of the call that called it back.
# the count of the call's last bytes, which a `length` parameter after them gets
c_bytes_count = 0
# the most bytes a text C gives back is read for
C_TEXT_LIMIT := 1000000000
# the most bytes of a struct ARM64's C passes in registers
STRUCT_IN_REGISTERS := 16
# the number before a run's first handle, far from any a program writes, so a number written by hand is no handle
HANDLE_BASE := 700000000

# a new call, its texts placed after those of the calls running, whose state it gives back
c_call_started(): CCall := {
	global c_texts_end
	global c_outs
	global c_handed
	global c_handed_from
	global c_callbacks_running
	if c_callbacks_running < 1 {
		c_texts_end = BYTES_AT
		c_handed = 0
	}
	outer = CCall(c_texts_end, c_outs, c_handed, c_handed_from, c_callbacks_running)
	c_outs = 0
	c_handed_from = c_handed
	outer
}
# the call ended: the one it ran within running again, as it was
c_call_ended(outer: CCall): ø := {
	global c_texts_end = outer.texts_end
	global c_outs = outer.outs
	global c_handed = outer.handed
	global c_handed_from = outer.handed_from
	global c_callbacks_running = outer.callbacks
}
# a callback of C called with C's arguments: the C calls it makes run within the call that called it back
c_called_back(callback: (list<int>) -> int, given: list<int>): int := {
	global c_callbacks_running
	c_callbacks_running = c_callbacks_running + 1
	result = callback(given)
	c_callbacks_running = c_callbacks_running - 1
	result
}
# a text as C takes it, the address of its bytes and a NUL: its own where texts are in the memory, else a copy placed
c_text(t: text): int32 := c_address(c_text_at(t))
# (a C function that writes into its text, mkstemps, writes into the text itself where texts are in the memory: give
# it a text of its own, never a literal)
c_text_at(t: text): int := if texts_in_memory() then text_address(t) else c_placed(t)
# a text's bytes and a NUL placed after the call's others, where they start
c_placed(t: text): int := {
	at = c_reserved(byte_count(t) + 1)
	memory_placed(at, t)
	set_memory_byte(at + byte_count(t), 0)
	at
}
# a list of texts as C's NULL-ended `char *[]` (argv, posix_spawn): their C pointers, each text's own or its copy's,
# the memory's own address as C sees it added to each
# DEBT: The pointers hold while the memory stays where it is, as wasmtime's reserved memory does; a host that moves the
#   memory as it grows would leave them dangling.
c_texts(ts: list<text>): int32 := {
	at = c_reserved((#ts + 1) * POINTER_BYTES)
	base = c_memory_seen()
	slot = at
	for t in ts {
		set_memory_int(slot, base + c_text_at(t))
		slot += POINTER_BYTES
	}
	set_memory_int(slot, 0)
	c_address(at)
}
# `count` bytes after the call's others, the memory grown to hold them, where they start; new memory of their own where
# texts are in the memory, whose memory past BYTES_AT a driver and its texts use (extensions/native/run.wap)
c_reserved(count: int): int := {
	if texts_in_memory() { return text_address(text_made(count)) }
	global c_texts_end
	at = c_texts_end
	memory_holding(at - BYTES_AT + count)
	global c_texts_end = at + count
	at
}
# where C sees the memory's address 0: memmove gives back its destination as C's pointer
c_memory_seen(): int := c_moved(c_address(BYTES_AT), c_address(BYTES_AT), 0) - BYTES_AT
c_moved(destination: int32, source: int32, count: int): int := prim foreign("c", "memmove", destination, source, count)
c_address(at: int): int32 := prim i32.wrap_i64(at)
# an out-pointer for C to fill, the call's next slot, NULL until it does
c_out(): int32 := {
	global c_outs
	at = c_reserved(POINTER_BYTES)
	set_memory_int(at, 0)
	if c_outs == 0 { global c_outs = at }
	c_address(at)
}
# The handles of this run (wiki/c.md): a C pointer as the number it crosses as, never an address wap computes with,
# the same pointer always the same number, 0 for NULL; they end with the run
c_pointers: list<int> = []
c_handle_of(pointer: int): int := {
	global c_pointers
	if pointer == 0 { return 0 }
	if c_pointers.index_of(pointer) == 0 { c_pointers.add(pointer) }
	HANDLE_BASE + c_pointers.index_of(pointer)
}
# the C pointer of a handle; a number no C pointer of this run crossed as is refused
c_pointer_of(handle: int): int := if handle == 0 then 0 else if handle > HANDLE_BASE and handle <= HANDLE_BASE + #c_pointers then c_pointers#(handle - HANDLE_BASE) else raise "${handle} is no handle of this run"
# a handle C gives back: the pointer its first out-pointer holds when it has one, C's status naming a NULL one
c_handle(status: int): int := {
	global c_outs
	if c_outs == 0 { return status }
	pointer = memory_int(c_outs)
	if pointer == 0 { raise "C gave no pointer, its status ${status}" }
	pointer
}
c_text_from(pointer: int): text := if pointer == 0 then "" else c_copied(pointer, c_length(pointer, C_TEXT_LIMIT))
# a text C gives back as a pointer to its length (8 bytes) and its bytes, which the caller frees
c_counted_text(pointer: int): text := {
	if pointer == 0 { return "" }
	at = c_reserved(POINTER_BYTES)
	c_copy(c_address(at), pointer, POINTER_BYTES)
	copied = c_copied(pointer + POINTER_BYTES, memory_int(at))
	c_free(pointer)
	copied
}
# `count` bytes at a C pointer, as a text: copied through the call's memory
c_copied(pointer: int, count: int): text := {
	at = c_reserved(count)
	c_copy(c_address(at), pointer, count)
	memory_text(at, count)
}
c_free(pointer: int) := prim foreign("c", "free", pointer)
# a list of bytes as a C pointer to their copy, NULs and all; its count the `length` parameter after it gets
c_bytes(xs: list<int>): int32 := {
	at = c_reserved(#xs)
	slot = at
	for b in xs {
		set_memory_byte(slot, b)
		slot += 1
	}
	global c_bytes_count = #xs
	c_address(at)
}
# a typed list as C takes it, a pointer to its items packed at their width (items_handed); its byte
# count the `length` parameter after it gets
c_items(xs: list<T>): int32 := {
	global c_bytes_count = #xs * item_bytes(xs)
	c_address(items_handed(xs))
}
c_length(pointer: int, limit: int): int := prim foreign("c", "strnlen", pointer, limit)
c_copy(destination: int32, source: int, count: int): int := prim foreign("c", "memcpy", destination, source, count)
# a C struct of that many bytes at a C pointer, given by value: as ARM64's C passes one of more than 16 bytes, a pointer
# to a copy the caller makes; a smaller one, which crosses in registers, is refused
# TODO (card native-other-platforms) x86-64's C passes such a struct on the stack, which this copy does not, and no host
#   answers which machine it runs on (the types module's every import is answered by every host)
c_struct(pointer: int, size: int): int := {
	if size <= STRUCT_IN_REGISTERS { raise "a C struct of ${STRUCT_IN_REGISTERS} bytes or less crosses in registers, which wap's C calls do not do yet: bytes<${size}>" }
	at = c_reserved(size)
	c_copy(c_address(at), pointer, size)
	c_memory_seen() + at
}
# a C int a function gives back, as the int it means
c_number(n: int32): int := prim i64.extend_i32_s(n)
# a C unsigned int, as the int it means
c_unsigned(n: int32): int := prim i64.extend_i32_u(n)
# a `char *` the caller owns (strdup's), as a text, freed
c_owned_text(pointer: int): text := {
	t = c_text_from(pointer)
	if pointer != 0 { c_free(pointer) }
	t
}
# C's float given back as a float: of one type, so the call it is given is typed by it (float has several)
c_double(x: float32): float := float(x)
# a bool as C's int and back, of which C defines the low byte
c_flag(b: bool): int := if b then 1 else 0
c_bool(n: int): bool := n % BYTE_RANGE != 0
BYTE_RANGE := 256

# A list's items handed to C (c_items): their own address where the list holds its items in the memory
# (types/memory_lists.wap items_address), else the address of their copy, packed at their width as C reads an array of
# them, as a GC array has no address, and copied back into the list once the call returns (items_returned), as C may
# write into them. The memory may move when it grows: no C side may keep it.
items_handed(xs: list<T>): int := {
	global handed_at
	if items_address(xs) != 0 { return items_address(xs) }
	width = item_bytes(xs)
	at = c_reserved(#xs * width)
	for place in 0 upto #xs { item_placed(at + place * width, xs[place]) }
	global c_handed
	handed_at = handed_at.take(c_handed)
	handed_at.add(at)
	c_handed = c_handed + 1
	at
}
# the list's items as C left them in their copy, the first of the call's copies still to be read back
items_returned(xs: list<T>) := {
	global handed_at
	global c_handed_from
	if items_address(xs) != 0 { return }
	at = handed_at#(c_handed_from + 1)
	c_handed_from = c_handed_from + 1
	for place in 0 upto #xs { xs[place] = item_found(xs, at + place * item_bytes(xs)) }
}
# where the copies of the lists handed to the C calls running are, in the order of their parameters, the innermost
# call's last (c_handed)
handed_at: list<int> = []
item_placed(at: int, item: T) := prim item.store(at, item)
item_found(xs: list<T>, at: int): T := prim item.load(at)

# A record handed to C (extensions/c/foreign.wap, a class parameter): its fields copied as C lays out a struct of them,
# each at the next multiple of its own width, the whole a multiple of its widest, and read back once the call returns
c_record_offsets(widths: list<int>): list<int> := {
	offsets: list<int> = []
	end = 0
	for width in widths {
		start = aligned(end, width)
		offsets.add(start)
		end = start + width
	}
	offsets
}
c_record_bytes(widths: list<int>): int := aligned(c_record_offsets(widths).last + widths.last, widths.max)
aligned(at: int, width: int): int := (at + width - 1) ÷ width * width
value_bytes(x: T): int := item_bytes([x])
field_found(model: T, at: int): T := prim item.load(at)
