# The standard module fractions (wiki/library-fractions.md): exact fractions, the exact numbers of lib/exact.wap.
# fraction(n, d) is n/d in lowest terms, its denominator positive; + - * / and the comparisons take a fraction and an
# int on either side. parse_fraction("1 1/2") is 3/2, from_decimal("0.125") 1/8, from_float(0.1) the float's binary
# value exactly (3602879701896397/36028797018963968, as Python's Fraction(0.1)); limit_denominator(x, max) the closest
# fraction with a denominator up to max; mixed_text(3/2) is "1 1/2"; continued_fraction(x) its floor terms and
# from_continued_fraction(terms) back; fraction_pow(x, k) an exact whole power. Numerators and denominators have no
# bounds.
use exact

fraction(n: int, d: int): Exact := exact(n, d)
as_fraction(n: int): Exact := exact(n)

# "n", "n/d", "-n/d", "w n/d" and "-w n/d": in the mixed form the sign belongs to the whole
parse_fraction(source: text): Exact := {
	t = trim(source)
	negative = t.starts_with("-")
	if negative or t.starts_with("+") { t = trim(t[1:]) }
	words = t.split(" ").filter(word => word != "")
	if #words > 2 or (#words == 2 and not words[1].contains("/")) { raise "parse_fraction: ${source} is no fraction" }
	parts = words.last.split("/")
	if #parts > 2 { raise "parse_fraction: more than one / in ${source}" }
	part = whole_value("parse_fraction", source, parts[0]) / (if #parts == 2 then whole_value("parse_fraction", source, parts[1]) else exact(1))
	if #words == 2 and part >= exact(1) { raise "parse_fraction: the mixed number ${source} needs a proper fraction part" }
	value = (if #words == 2 then whole_value("parse_fraction", source, words[0]) else exact(0)) + part
	if negative then -value else value
}
# the whole number that digits spell, refused for none or anything but digits
whole_value(name: text, source: text, digits: text): Exact := {
	if not is_digits(digits) { raise "${name}: ${source} is no number" }
	exact(digits)
}
# "0.125", "-1.5e-3", "12.": the decimal's value exactly
from_decimal(source: text): Exact := {
	pieces = ascii_lower(trim(source)).split("e")
	if #pieces > 2 { raise "from_decimal: ${source} is no number" }
	mantissa = exact(pieces[0])
	if #pieces == 2 then mantissa * exact(10) ^ int(pieces[1]) else mantissa
}
# the float's binary value exactly
FRACTION_BITS := 52
EXPONENT_BIAS := 1075
EXPONENT_ALL_ONES := 2047
from_float(x: float): Exact := {
	bits = float_bits(x)
	# TODO (sent to wap-lead) `&` once ints have it: the sign and exponent bits, then the fraction bits below them
	high = bits >>> FRACTION_BITS
	exponent = high % (EXPONENT_ALL_ONES + 1)
	if exponent == EXPONENT_ALL_ONES { raise "from_float of ${x}: infinities and NaN have no fraction" }
	low = bits - (high << FRACTION_BITS)
	mantissa = if exponent == 0 then low else low + (1 << FRACTION_BITS)
	value = exact(mantissa) * exact(2) ^ ((if exponent == 0 then 1 else exponent) - EXPONENT_BIAS)
	if bits < 0 then -value else value
}
# the closest fraction to x with a denominator up to most (Python's limit_denominator)
limit_denominator(x: float, most: int): Exact := limit_denominator(from_float(x), most)
limit_denominator(x: Exact, most: int): Exact := {
	if most < 1 { raise "limit_denominator needs a denominator of at least 1, not ${most}" }
	limit = exact(most)
	if denominator(x) <= limit { return x }
	p0 = exact(0)
	q0 = exact(1)
	p1 = exact(1)
	q1 = exact(0)
	n = numerator(x)
	d = denominator(x)
	while q0 + n ÷ d * q1 <= limit {
		a = n ÷ d
		p2 = p0 + a * p1
		q2 = q0 + a * q1
		p0 = p1
		q0 = q1
		p1 = p2
		q1 = q2
		r = n - a * d
		n = d
		d = r
	}
	k = (limit - q0) ÷ q1
	bound = (p0 + k * p1) / (q0 + k * q1)
	nearer = p1 / q1
	if exact(2) * d * (q0 + k * q1) <= denominator(x) then nearer else bound
}
# "1 3/4", "-1/2", "3"
mixed_text(x: Exact): text := {
	sign = if x < exact(0) then "-" else ""
	size = abs(x)
	whole = floor(size)
	rest = size - whole
	if rest == exact(0) then "${sign}${whole}"
	else if whole == exact(0) then "${sign}${rest}"
	else "${sign}${whole} ${rest}"
}
# the floor terms: the first may be negative or 0, the later ones are at least 1
continued_fraction(x: Exact): list<int> := {
	terms: list<int> = []
	n = numerator(x)
	d = denominator(x)
	while d != exact(0) {
		a = n ÷ d
		terms.add(int(a))
		r = n - a * d
		n = d
		d = r
	}
	terms
}
from_continued_fraction(terms: list<int>): Exact := {
	if terms is empty { raise "from_continued_fraction of an empty list" }
	terms.take(#terms - 1).reverse().fold(exact(terms.last), (value, term) => term + 1 / value)
}
fraction_pow(x: Exact, k: int): Exact := {
	if k < 0 and x == exact(0) { raise "fraction_pow: 0 to the negative power ${k}" }
	x ^ k
}
