# The standard module fractions (wiki/library-fractions.md): exact fractions as a class of their own. fraction(n, d)
# is n/d in lowest terms, its denominator positive; + - * / and the comparisons take a Fraction and an int on either
# side. parse_fraction("1 1/2") is 3/2, from_decimal("0.125") 1/8, from_float(0.1) the float's binary value exactly
# (3602879701896397/36028797018963968, as Python's Fraction(0.1)); limit_denominator(x, max) the closest fraction
# with a denominator up to max; mixed_text(3/2) is "1 1/2"; continued_fraction(x) its floor terms and
# from_continued_fraction(terms) back; fraction_pow(x, k) an exact whole power. Numerators and denominators are
# 64-bit ints: a result that would leave that range is refused, never wrapped.
use math

class Fraction { numerator: int, denominator: int }

fraction(n: int, d: int): Fraction := {
	if d == 0 { raise "fraction: a zero denominator" }
	common = gcd(n, d) * (if d < 0 then -1 else 1)
	Fraction(n ÷ common, d ÷ common)
}
as_fraction(n: int): Fraction := Fraction(n, 1)
numerator(x: Fraction): int := x.numerator
denominator(x: Fraction): int := x.denominator
text(x: Fraction): text := if x.denominator == 1 then "${x.numerator}" else "${x.numerator}/${x.denominator}"
float(x: Fraction): float := float(x.numerator) / float(x.denominator)

# a * b, refused when it leaves the 64-bit range
exact_product(a: int, b: int): int := {
	if a == 0 or b == 0 { return 0 }
	p = a * b
	if p ÷ b != a { raise "fractions: a result leaves the 64-bit range of ints" }
	p
}
+(a: Fraction, b: Fraction): Fraction := fraction(exact_product(a.numerator, b.denominator) + exact_product(b.numerator, a.denominator), exact_product(a.denominator, b.denominator))
-(a: Fraction, b: Fraction): Fraction := a + fraction(-b.numerator, b.denominator)
-(x: Fraction): Fraction := Fraction(-x.numerator, x.denominator)
*(a: Fraction, b: Fraction): Fraction := fraction(exact_product(a.numerator, b.numerator), exact_product(a.denominator, b.denominator))
/(a: Fraction, b: Fraction): Fraction := {
	if b.numerator == 0 { raise "fractions: division by zero" }
	fraction(exact_product(a.numerator, b.denominator), exact_product(a.denominator, b.numerator))
}
==(a: Fraction, b: Fraction): bool := a.numerator == b.numerator and a.denominator == b.denominator
<(a: Fraction, b: Fraction): bool := exact_product(a.numerator, b.denominator) < exact_product(b.numerator, a.denominator)
>(a: Fraction, b: Fraction): bool := b < a
<=(a: Fraction, b: Fraction): bool := not (b < a)
>=(a: Fraction, b: Fraction): bool := not (a < b)
# an int on either side is the fraction it is
+(a: Fraction, b: int): Fraction := a + as_fraction(b)
+(a: int, b: Fraction): Fraction := as_fraction(a) + b
-(a: Fraction, b: int): Fraction := a - as_fraction(b)
-(a: int, b: Fraction): Fraction := as_fraction(a) - b
*(a: Fraction, b: int): Fraction := a * as_fraction(b)
*(a: int, b: Fraction): Fraction := as_fraction(a) * b
/(a: Fraction, b: int): Fraction := a / as_fraction(b)
/(a: int, b: Fraction): Fraction := as_fraction(a) / b

# the int that digits spell, refused for none or anything but digits
digits_value(name: text, source: text, digits: text): int := {
	if digits == "" or not is_digits(digits) { raise "${name}: ${source} is no number" }
	int(digits)
}
# "n", "n/d", "-n/d", "w n/d" and "-w n/d": in the mixed form the sign belongs to the whole
parse_fraction(source: text): Fraction := {
	t = trim(source)
	negative = t.starts_with("-")
	if negative or t.starts_with("+") { t = trim(t[1:]) }
	words = t.split(" ").filter(word => word != "")
	whole = if #words == 2 then digits_value("parse_fraction", source, words[0]) else 0
	if #words > 2 or (#words == 2 and not words[1].contains("/")) { raise "parse_fraction: ${source} is no fraction" }
	parts = words.last.split("/")
	if #parts > 2 { raise "parse_fraction: more than one / in ${source}" }
	n = digits_value("parse_fraction", source, parts[0])
	d = if #parts == 2 then digits_value("parse_fraction", source, parts[1]) else 1
	if #words == 2 and n >= d { raise "parse_fraction: the mixed number ${source} needs a proper fraction part" }
	value = fraction(exact_product(whole, d) + n, d)
	if negative then -value else value
}
# ten to a power as a fraction
power_of_ten(exponent: int): Fraction := if exponent >= 0 then as_fraction(10 ** exponent) else fraction(1, 10 ** -exponent)
# "0.125", "-1.5e-3", "12.": the decimal's value exactly
from_decimal(source: text): Fraction := {
	t = ascii_lower(trim(source))
	negative = t.starts_with("-")
	if negative or t.starts_with("+") { t = t[1:] }
	pieces = t.split("e")
	exponent = if #pieces == 2 then int(pieces[1]) else 0
	halves = pieces[0].split(".")
	part = if #halves == 2 then halves[1] else ""
	value = as_fraction(digits_value("from_decimal", source, halves[0] + part)) * power_of_ten(exponent - #part)
	if negative then -value else value
}
# the float's binary value exactly
FRACTION_BITS := 52
EXPONENT_BIAS := 1075
from_float(x: float): Fraction := {
	bits = float_bits(x)
	# TODO (sent to wap-lead) `&` once ints have it: the sign and exponent bits, then the fraction bits below them
	high = bits >>> FRACTION_BITS
	exponent = high % 2048
	if exponent == 2047 { raise "from_float of ${x}: infinities and NaN have no fraction" }
	low = bits - (high << FRACTION_BITS)
	mantissa = if exponent == 0 then low else low + (1 << FRACTION_BITS)
	shift = (if exponent == 0 then 1 else exponent) - EXPONENT_BIAS
	value = if shift >= 0 then as_fraction(mantissa) * fraction_pow(as_fraction(2), shift) else mantissa / fraction_pow(as_fraction(2), -shift)
	if bits < 0 then -value else value
}
# the closest fraction to x with a denominator up to most (Python's limit_denominator)
limit_denominator(x: float, most: int): Fraction := limit_denominator(from_float(x), most)
limit_denominator(x: Fraction, most: int): Fraction := {
	if most < 1 { raise "limit_denominator needs a denominator of at least 1, not ${most}" }
	if x.denominator <= most { return x }
	p0 = 0
	q0 = 1
	p1 = 1
	q1 = 0
	n = x.numerator
	d = x.denominator
	while q0 + n ÷ d * q1 <= most {
		a = n ÷ d
		p2 = p0 + a * p1
		q2 = q0 + a * q1
		p0 = p1
		q0 = q1
		p1 = p2
		q1 = q2
		r = n - a * d
		n = d
		d = r
	}
	k = (most - q0) ÷ q1
	bound = fraction(p0 + k * p1, q0 + k * q1)
	nearer = fraction(p1, q1)
	if 2 * d * (q0 + k * q1) <= x.denominator then nearer else bound
}
# "1 3/4", "-1/2", "3"
mixed_text(x: Fraction): text := {
	sign = if x.numerator < 0 then "-" else ""
	whole = abs(x.numerator) ÷ x.denominator
	rest = abs(x.numerator) % x.denominator
	if rest == 0 then "${sign}${whole}"
	else if whole == 0 then "${sign}${rest}/${x.denominator}"
	else "${sign}${whole} ${rest}/${x.denominator}"
}
# the floor terms: the first may be negative or 0, the later ones are at least 1
continued_fraction(x: Fraction): list<int> := {
	terms: list<int> = []
	n = x.numerator
	d = x.denominator
	while d != 0 {
		a = n ÷ d
		terms.add(a)
		r = n - a * d
		n = d
		d = r
	}
	terms
}
from_continued_fraction(terms: list<int>): Fraction := {
	if terms is empty { raise "from_continued_fraction of an empty list" }
	terms.drop(0).take(#terms - 1).reverse().fold(as_fraction(terms.last), (value, term) => term + 1 / value)
}
fraction_pow(x: Fraction, k: int): Fraction := {
	if k < 0 {
		if x.numerator == 0 { raise "fraction_pow: 0 to the negative power ${k}" }
		return fraction_pow(fraction(x.denominator, x.numerator), -k)
	}
	(0 upto k).fold(as_fraction(1), (power, i) => power * x)
}
