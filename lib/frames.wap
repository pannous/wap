# The standard module frames (wiki/graphics.md "Input and frames"): `on frame {…}` runs each frame of the window until
# it closes, its paintings shown in it; `on exit {…}` runs once the program and its frames are done. The frames start
# at the run's end (finished), after the program
use events
use "host/native_host/window.wap"

# while debugging: Escape closes the window of an `on frame` program
ESCAPE_CLOSES_WINDOW := yes
ESCAPE_KEY_CODE := 27

enum Moment { frame, exit }
on(moment: Moment, body: block) := listen(moment as text, (data: any) => body(), no)

# the frames after the program, each of the window's while it is open, then the exit
finished() := {
	if #listening(frame as text) > 0 { frames_run() }
	emitted(exit as text, ø)
}
frames_run() := {
	window_open_set(yes)
	presses_before = keys_pressed()
	while window_open() {
		emitted(frame as text, ø)
		if ESCAPE_CLOSES_WINDOW and keys_pressed() != presses_before and key_code_pressed() == ESCAPE_KEY_CODE { window_open_set(no) }
		presses_before = keys_pressed()
	}
}
