# The standard module functions (wiki/library-functions.md): functions over functions. memoize(f) remembers f's
# results by argument; retry(f, attempts, delay) calls f until it succeeds, waiting delay ms, then twice as long, before
# each retry, the last failure raised again; throttle(f, ms) and debounce(f, ms) limit by the wall clock how often f
# runs, a call they drop answering the last result.

# TODO a host sleep in place of this spin once wap/types has one (asked of wap-lead: WASI poll_oneoff)
waited(ms: int) := {
	until = wall_clock_ms() + ms
	while wall_clock_ms() < until { }
}

# f with its results kept: f runs once per argument, equal arguments (by their shown form) sharing a result
memoize(f: (any) -> any) := {
	results: map<text, any> = {}
	x => {
		key = show(x)
		if not results.has(key) { results[key] = f(x) }
		results[key]
	}
}

# f() up to attempts times, the first success its value; the waits are delay ms, 2·delay, 4·delay …
retry(f: () -> any, attempts: int, delay: int): any := {
	wait = delay
	# every attempt but the last swallows its error, the last lets it through
	for attempt in 1 upto attempts {
		value: any = ø
		succeeded = try {
			value = f()
			yes
		} catch e { no }
		if succeeded { return value }
		waited(wait)
		wait = wait * 2
	}
	f()
}

# when a limited function last ran or was last called, and what it answered
class Gate { ran_at: int = -1, called_at: int = -1, last: any = ø }
# f run at most once in each ms
throttle(f: (any) -> any, ms: int) := {
	gate = Gate()
	x => {
		now = wall_clock_ms()
		if gate.ran_at < 0 or now - gate.ran_at >= ms {
			gate.ran_at = now
			gate.last = f(x)
		}
		gate.last
	}
}
# f run only after ms without calls: the first call of a burst runs, the rest of the burst is dropped
debounce(f: (any) -> any, ms: int) := {
	gate = Gate()
	x => {
		now = wall_clock_ms()
		if gate.called_at < 0 or now - gate.called_at >= ms { gate.last = f(x) }
		gate.called_at = now
		gate.last
	}
}
