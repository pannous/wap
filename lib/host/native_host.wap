# The native host module (decisions window-in-warp, native-host-modules): what the playground answers in JavaScript
# beyond the driver's own words, natively in wap over C libraries by plain FFI. No program uses it: the native
# driver links it at the first question it does not answer itself (wap/extensions/native/driver.wap host_export) and calls its
# host_* words: the window's system values and its painting's layer (native_host/window.wap), the host words as
# host_<word> (text_coverage there, sound's in native_host/sound.warp), host_run_ended at the run's end and host_waited while the console waits for a line
use "native_host/platform.wap"
use "native_host/window.wap"
use "native_host/sound.warp"
use "native_host/webview.warp"
use "native_host/gpu.wap"

# the run's end: a still picture stays shown till its window is closed, the sounds play out
host_run_ended() := {
	window_run_ended()
	sounds_heard_out()
}
# the console waiting for its next line: the window a line painted takes its events in
host_waited() := window_waited()
