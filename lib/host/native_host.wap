# The native host module (decisions window-in-warp, native-host-modules): what the playground answers in JavaScript,
# natively in wap over C libraries by plain FFI, used as source by the library words that need it (`use host`): the
# window's system values, its painting's layer and text_coverage (native_host/window.wap), the GPU
# (native_host/gpu.wap), paint (native_host/paint.wap), sound and MIDI (native_host/sound.wap), the web view
# (native_host/webview.wap); finished() at the run's end and waited() while the console waits for a line
use "native_host/platform.wap"
use "native_host/window.wap"
use "native_host/sound.wap"
use "native_host/webview.wap"
use "native_host/gpu.wap"
use "native_host/paint.wap"

# the run's end: a still picture stays shown till its window is closed, the sounds play out
finished() := {
	window_run_ended()
	sounds_heard_out()
}
# the console waiting for its next line: the window a line painted takes its events in
waited() := window_waited()
