# paint, a part of lib/host/native_host.wap (wiki/graphics.md "Pixels and shaders"): a WGSL shader or a list of
# 0xAARRGGBB pixels shown in the window; where none can open, paint raises
use "gpu.wap"

paint(shader: text, width: int, height: int, values: map<text, any> = {}) := {
	if not shader_shown(shader, width, height, values) { no_window() }
}
paint(pixels: list<int>, width: int, height: int) := {
	if #pixels < width * height { raise "paint: " + width + "×" + height + " needs more pixels than " + #pixels }
	if not pixels_shown(pixels, width, height) { no_window() }
}
no_window() := raise "paint: no window can open here"
