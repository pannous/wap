# paint of a shader, a part of lib/host/native_host.wap (wiki/graphics.md "Pixels and shaders"): a WGSL shader shown in
# the window; where none can open, paint raises (a list of pixels paints by lib/image.wap's paint)
use "gpu.wap"

paint(shader: text, width: int, height: int, values: map<text, any> = {}) := {
	if host_shader_shown(shader, width, height, values) != 1 { no_window() }
}
no_window() := raise "paint: no window can open here"
