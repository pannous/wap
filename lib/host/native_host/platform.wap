# The native host module's platform words (lib/host/native_host.wap): SDL's start, macOS and its
# CoreFoundation strings, shared by its window and sound parts. In a part, not the module's root, so that no program
# implicitly uses the module by naming one of them (the library index reads a module's root only)

use SDL3
use c
use file
# SDL's parts started (video, audio), Control-C left to stop the program at once (card window-ctrl-c: SDL's own
# handler made it a quit event, which waited for the window's next events)
sdl_started(flags: int) := {
	SDL_SetHint(SDL_HINT_NO_SIGNAL_HANDLERS, "1")
	SDL_Init(flags)
}
# macOS, whose frameworks answer what elsewhere other libraries do (CoreText, AudioToolbox, CoreMIDI)
CORE_FOUNDATION := "/System/Library/Frameworks/CoreFoundation.framework"
on_mac() := exists(CORE_FOUNDATION)
# Windows, whose window a GPU surface is made for by its HWND and the program's module
on_windows(): bool := library_has("kernel32", "GetModuleHandleA")
# whether a C library here has the function (its address, 0 where none)
library_has(library: text, function: text): bool := library_function(library, function) != 0
# SDL3 here, for the window and the sound
sdl_present(): bool := library_has("SDL3", "SDL_Init")
GetModuleHandleA(name: handle): handle from 'kernel32'
CFStringCreateWithCString(allocator: handle, text: text, encoding: i32): handle from 'CoreFoundation'
CFStringGetCString(string: handle, buffer: handle, size: i64, encoding: i32): bool from 'CoreFoundation'
CFRelease(object: handle): void from 'CoreFoundation'
CF_UTF8 := 0x08000100
# a CoreFoundation string of a text the module names (a key, a style, a MIDI port), made once
global cf_texts: map<text, int> = {}
cf_text(t: text) := {
	if not cf_texts.has(t) { cf_texts[t] = CFStringCreateWithCString(0, t, CF_UTF8) }
	cf_texts[t]
}
CF_TEXT_MOST_BYTES := 1024
# a CoreFoundation string's text
cf_string_text(string) := {
	buffer = calloc(1, CF_TEXT_MOST_BYTES)
	read = if CFStringGetCString(string, buffer, CF_TEXT_MOST_BYTES, CF_UTF8) then field_text(buffer, 0) else ""
	free(buffer)
	read
}
# a system service that never answers a process forked without exec (WebKit's helpers, Metal's shader compiler): a run
# in such a process (a `wap test` case, run with the option `forked`) asks for a process of its own, in which it runs
# again (core/native/tests.warp)
FRESH_PROCESS_WANTED := 75
own_process() := if run_option("forked") != ø { exit(FRESH_PROCESS_WANTED) }
