# The system's web view natively (decision native-js-webview, card warp-webview-removal), a part of lib/host/native_host.wap:
# macOS's WKWebView over the Objective-C runtime by plain FFI, as libwarp_webview (crates/warp-webview) answered it
# in Objective-C. It answers the host word foreign_call for `use js` in one hidden web view a run, made at the first
# call: never shown, never activating the app, no Dock icon; `warp app` shows that view in a window, the program's
# handlers live (APP_WINDOW below, lib/markup.warp page_window_run), never under --no-window or CI; and
# webview_page_text for `warp app check`. An object of the runtime is its address here, never a program's handle;
# the classes WebKit calls back (a page loaded, a page's message, the window closing) are made at run time, their
# methods warp functions (lib/callbacks.warp), as is the block an answer comes back to

# the page's origin, the scheme the run answers itself: a warp function given to js calls back through it, the page's
# same origin (webview_bridge.js warpCalledBack), and a secure one, so crypto.randomUUID and the like are there
CALLBACK_SCHEME := "wap"
PAGE_ORIGIN := CALLBACK_SCHEME + "://localhost/"
# the message webview_bridge.js posts a slot JS let go of with (lib/callbacks.warp js_released)
RELEASED_MESSAGE := "warpReleased"
UNSEEN_ARITY := "js is given a function whose parameters the program doesn't show: pass a lambda or a function the program defines"
NESTED_CALL := "a warp function JS calls back can't call JS itself natively: the web view waits for its answer"
UTF8_ENCODING := 4
HTTP_OK := 200
HTTP_FAILED := 500
EMPTY_PAGE := "<!doctype html><meta charset=utf-8><title>wap</title>"
ANSWER_MS := 10000
SPIN_SECONDS := 0.005
MS_PER_SECOND := 1000
APP_WINDOW_WIDTH := 900.0
APP_WINDOW_HEIGHT := 700.0
APP_WINDOW_FRAME := [0.0, 0.0, APP_WINDOW_WIDTH, APP_WINDOW_HEIGHT]
JS_RUNTIME := "js"
# js-members.js (jsMember), markup.js (listenToElements, morphChildren) and markup-forms.js (submit), the page's own
# (links to web/playground/, so an installed lib/ carries them: card native-host-prebuild), and webview_bridge.js
# (warpForeignCall, the page's events), put into each page; read from the library's folder
BRIDGE_FOLDER := "/host/native_host/"
BRIDGE_FILES := ["js-members.js", "markup.js", "markup-forms.js", "webview_bridge.js"]
page_bridge(): text := BRIDGE_FILES.map(file => read(library_folder() + BRIDGE_FOLDER + file)).join("\n")
# the module `use js` calls answered here, not in the page: the run's window, `show` it, the `next` event of its page
APP_WINDOW := "warpWindow"
# what warpWindow.next answers once its time is over without an event (lib/markup.warp page_window_run)
TICK_EVENT := "tick"
# the message webview_bridge.js posts each event of the page with, its {event, detail} as JSON
EVENT_MESSAGE := "warpEvent"
# a module's or member's name as `use js` writes it, never JS source (an argument crosses only as JSON)
NAME_STARTS := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_$"
NAME_GOES_ON := NAME_STARTS + "0123456789"
# how long warpWindow.next() waits without milliseconds: till an event comes
FOREVER_MS := 1 << 62
# AppKit's and WebKit's numbers
POLICY_ACCESSORY := 1
POLICY_PROHIBITED := 2
DOCUMENT_START := 0
WINDOW_STYLE := 15
BUFFERED := 2
SIZES_WITH_WINDOW := 18
ANY_EVENT := -1
# a global block (Clang's block layout): its isa, flags, invoke and descriptor, the descriptor's size
BLOCK_IS_GLOBAL := 1 << 28
BLOCK_BYTES := 32
BLOCK_FLAGS_AT := 8
BLOCK_INVOKE_AT := 16
BLOCK_DESCRIPTOR_AT := 24

# the web view's state: the message registers, the page's loading and events, the answer awaited, the app's window
class WebView {
	message_function: int = 0
	message_integers: int = 0
	message_floats: int = 0
	# AppKit's and WebKit's classes are there once their frameworks are loaded (a symbol of each asked for loads it)
	frameworks_asked: bool = no
	# a page's loading: the navigation delegate's two answers end it, a failed one with its reason
	page_loading_ended: bool = no
	page_loading_failure: text = ""
	page_loading: int = 0
	# the page's events not yet given to the program, each its {event, detail} as JSON
	page_events: list<text> = []
	# the run's hidden web view
	hidden_view: int = 0
	# whether a function of the program runs for js now
	calling_back: bool = no
	# the answer of a body run as an async function in the view: its text, or its failure
	answer_block: int = 0
	answer_heard: bool = no
	answer_value: int = 0
	answer_error: int = 0
	# the run's window, the hidden view in it: open until it is closed
	app_window: int = 0
	app_window_open: bool = no
}
global web = WebView()

# the Objective-C runtime
use foreign
use c
use callbacks
use json
use text
use "platform.wap"
OBJC := "objc"
objc_getClass(name: text): i64 from 'objc'
sel_registerName(name: text): i64 from 'objc'
objc_allocateClassPair(superclass: i64, name: handle, extra: i64): i64 from 'objc'
class_addMethod(made: i64, selector: i64, implementation: handle, types: handle): bool from 'objc'
class_replaceMethod(made: i64, selector: i64, implementation: handle, types: handle): i64 from 'objc'
objc_registerClassPair(made: i64): void from 'objc'
objc_autoreleasePoolPush(): i64 from 'objc'
objc_autoreleasePoolPop(pool: i64): void from 'objc'
native_call(function: i64, integers: handle, floats: handle, float_result: i32): i64 from 'c'
MESSAGE_REGISTERS := 8
# a register's bytes, an integer's or a float's
REGISTER_BYTES := 8
# `[receiver selector: arguments…]`: the receiver, the selector and the arguments in the integer registers, the floats
# in the float ones (a CGRect by value is four, arm64's way); its result as a number (an object's address)
sent(receiver: int, selector: text, arguments: list<int>): int := sent_with_floats(receiver, selector, arguments, [])
sent_with_floats(receiver: int, selector: text, arguments: list<int>, floats: list<float>): int := {
	if web.message_function == 0 {
		web.message_function = handle_pointer(library_function(OBJC, "objc_msgSend"))
		web.message_integers = calloc(MESSAGE_REGISTERS, REGISTER_BYTES)
		web.message_floats = calloc(MESSAGE_REGISTERS, REGISTER_BYTES)
	}
	set_field_i64(web.message_integers, 0, receiver)
	set_field_i64(web.message_integers, REGISTER_BYTES, sel_registerName(selector))
	for at in 0 ..< #arguments { set_field_i64(web.message_integers, (at + 2) * REGISTER_BYTES, arguments[at]) }
	for at in 0 ..< #floats { set_field_f64(web.message_floats, at * REGISTER_BYTES, floats[at]) }
	native_call(web.message_function, web.message_integers, web.message_floats, 0)
}
told(receiver: int, selector: text): int := sent(receiver, selector, [])
class_named(name: text): int := {
	frameworks_loaded()
	objc_getClass(name)
}
frameworks_loaded() := {
	if not web.frameworks_asked {
		web.frameworks_asked = yes
		library_function("AppKit", "NSApp")
		library_function("WebKit", "WKErrorDomain")
	}
}
# a framework's global object (NSDefaultRunLoopMode)
framework_object(framework: text, name: text): int := field_i64(library_function(framework, name), 0)
# an NSString of a text, autoreleased; an NSString's text
ns_string(t: text): int := {
	made = handle_pointer(CFStringCreateWithCString(0, t, CF_UTF8))
	told(made, "autorelease")
}
ns_text(string: int): text := if string == 0 then "" else field_text(pointer_handle(told(string, "UTF8String")), 0)
is_kind(object: int, class_name: text): bool := object != 0 and sent(object, "isKindOfClass:", [class_named(class_name)]) != 0
# a method of a class made at run time: its selector, its Objective-C types and its implementation, a wap function
# taking the receiver, the selector and the selector's arguments as numbers (method_of)
class ObjcMethod { selector: text, types: text, implementation: int }
# a method that gives nothing back, its receiver, its selector and its arguments objects (Objective-C's "v@:@…"),
# each a number to the wap function, as c_callback takes it
method_of(selector: text, f: (int, int, int) -> T): ObjcMethod := ObjcMethod(selector, object_types(1), c_callback(f, number_arguments(3)))
method_of(selector: text, f: (int, int, int, int) -> T): ObjcMethod := ObjcMethod(selector, object_types(2), c_callback(f, number_arguments(4)))
method_of(selector: text, f: (int, int, int, int, int) -> T): ObjcMethod := ObjcMethod(selector, object_types(3), c_callback(f, number_arguments(5)))
object_types(objects: int): text := "v@:" + "@" * objects
number_arguments(count: int): list<text> := ["i64" for i in 0 ..< count]
# a class of NSObject made at run time, its methods wap functions. A class an earlier run in this process made (`wap
# test` runs each test so) stays, its methods given this run's functions
class_made(name: text, methods: list<ObjcMethod>): int := {
	made = class_named(name)
	earlier = made != 0
	if not earlier { made = objc_allocateClassPair(class_named("NSObject"), strdup(name), 0) }
	for method in methods {
		if earlier { class_replaceMethod(made, sel_registerName(method.selector), method.implementation, strdup(method.types)) }
		else { class_addMethod(made, sel_registerName(method.selector), method.implementation, strdup(method.types)) }
	}
	if not earlier { objc_registerClassPair(made) }
	made
}
instance_of(made: int): int := told(told(made, "alloc"), "init")

# the run loop turned until done() or the milliseconds are over: no when they were
spun(done: () -> bool, milliseconds: int): bool := turned(done, milliseconds, () => sent(told(class_named("NSRunLoop"), "currentRunLoop"), "runMode:beforeDate:", [framework_object("Foundation", "NSDefaultRunLoopMode"), soon()]))
# the app's events (clicks, keys) handed to its windows until done() or the milliseconds are over, as [NSApp run] would
pumped(done: () -> bool, milliseconds: int): bool := turned(done, milliseconds, () => {
	app_event = sent(application(), "nextEventMatchingMask:untilDate:inMode:dequeue:", [ANY_EVENT, soon(), framework_object("Foundation", "NSDefaultRunLoopMode"), 1])
	if app_event != 0 { sent(application(), "sendEvent:", [app_event]) }
})
turned(done: () -> bool, milliseconds: int, turn: () -> T): bool := {
	deadline = wall_clock_ms() + milliseconds
	while not done() and wall_clock_ms() < deadline { turn() }
	done()
}
soon(): int := sent_with_floats(class_named("NSDate"), "dateWithTimeIntervalSinceNow:", [], [SPIN_SECONDS])
application(): int := told(class_named("NSApplication"), "sharedApplication")
application_made(policy: int) := {
	if told(application(), "activationPolicy") == POLICY_PROHIBITED or policy != POLICY_PROHIBITED { sent(application(), "setActivationPolicy:", [policy]) }
}

loading_ended(receiver: int, selector: int, shown_in: int, navigation: int) := { web.page_loading_ended = yes }
loading_failed(receiver: int, selector: int, shown_in: int, navigation: int, failure: int) := {
	web.page_loading_failure = ns_text(told(failure, "localizedDescription"))
	web.page_loading_ended = yes
}
# (webview_bridge.js posts each event as its JSON text; a body that is no text came from no bridge of ours, and is
# left out rather than raised through WebKit's frames)
page_message(receiver: int, selector: int, controller: int, message: int) := {
	body = told(message, "body")
	if is_kind(body, "NSString") { web.page_events.add(ns_text(body)) }
}
page_released(receiver: int, selector: int, controller: int, message: int) := {
	released = parse_json(ns_text(told(message, "body")))
	js_released(released#1, released#2)
}
# a scheme task WebKit stops: each is answered at once, so none is left to stop
scheme_task_stopped(receiver: int, selector: int, view: int, task: int) := ø
# the page calling wap://localhost/<slot>?<its arguments as JSON> back: the function's result as JSON, a failure's
# message with HTTP_FAILED, which the page throws
called_back(receiver: int, selector: int, shown_in: int, task: int) := {
	url = told(told(task, "request"), "URL")
	given = parse_json(ns_text(told(told(url, "query"), "stringByRemovingPercentEncoding")))
	web.calling_back = yes
	status = HTTP_OK
	body = try { to_json(js_called_back(int(ns_text(told(url, "lastPathComponent"))), given)) } catch failure {
		status = HTTP_FAILED
		failure.message
	}
	web.calling_back = no
	response = sent(told(class_named("NSHTTPURLResponse"), "alloc"), "initWithURL:statusCode:HTTPVersion:headerFields:", [url, status, 0, 0])
	sent(task, "didReceiveResponse:", [response])
	sent(task, "didReceiveData:", [sent(ns_string(body), "dataUsingEncoding:", [UTF8_ENCODING])])
	told(task, "didFinish")
}
# WebKit's helper processes never answer a process forked without exec (native_host/platform.wap own_process)
view_made(width: float, height: float): int := {
	own_process()
	configuration = instance_of(class_named("WKWebViewConfiguration"))
	contents = told(configuration, "userContentController")
	bridge = sent(told(class_named("WKUserScript"), "alloc"), "initWithSource:injectionTime:forMainFrameOnly:", [ns_string(page_bridge()), DOCUMENT_START, 1])
	sent(contents, "addUserScript:", [bridge])
	messages = instance_of(class_made("WapHostEvents", [method_of("userContentController:didReceiveScriptMessage:", page_message)]))
	sent(contents, "addScriptMessageHandler:name:", [messages, ns_string(EVENT_MESSAGE)])
	releases = instance_of(class_made("WapHostReleases", [method_of("userContentController:didReceiveScriptMessage:", page_released)]))
	sent(contents, "addScriptMessageHandler:name:", [releases, ns_string(RELEASED_MESSAGE)])
	callbacks = instance_of(class_made("WapHostCallbacks", [method_of("webView:startURLSchemeTask:", called_back), method_of("webView:stopURLSchemeTask:", scheme_task_stopped)]))
	sent(configuration, "setURLSchemeHandler:forURLScheme:", [callbacks, ns_string(CALLBACK_SCHEME)])
	sent_with_floats(told(class_named("WKWebView"), "alloc"), "initWithFrame:configuration:", [configuration], [0.0, 0.0, width, height])
}
# the HTML shown in the view, waited for; raises why it did not load, or that it did not in time
page_loaded(shown_in: int, html: text) := {
	if web.page_loading == 0 { web.page_loading = instance_of(class_made("WapHostLoading", [method_of("webView:didFinishNavigation:", loading_ended), method_of("webView:didFailNavigation:withError:", loading_failed)])) }
	web.page_loading_ended = no
	web.page_loading_failure = ""
	sent(shown_in, "setNavigationDelegate:", [web.page_loading])
	sent(shown_in, "loadHTMLString:baseURL:", [ns_string(html), sent(class_named("NSURL"), "URLWithString:", [ns_string(PAGE_ORIGIN)])])
	loaded = spun(() => web.page_loading_ended, ANSWER_MS)
	sent(shown_in, "setNavigationDelegate:", [0])
	if not loaded { raise "the page did not load in ${ANSWER_MS ÷ MS_PER_SECOND} s" }
	if web.page_loading_failure != "" { raise "the page did not load: " + web.page_loading_failure }
}
# the run's hidden web view, made at its first use: the process never becomes an app on screen for it
hidden_view(): int := {
	if web.hidden_view != 0 { return web.hidden_view }
	application_made(POLICY_PROHIBITED)
	web.hidden_view = view_made(1.0, 1.0)
	page_loaded(web.hidden_view, EMPTY_PAGE)
	web.hidden_view
}

answer_given(block: int, result: int, failure: int) := {
	web.answer_value = if result == 0 then 0 else told(result, "retain")
	web.answer_error = if failure == 0 then 0 else told(failure, "retain")
	web.answer_heard = yes
}
# the block callAsyncJavaScript calls back, one a run (a global block: never copied, never freed)
answering_block(): int := {
	if web.answer_block == 0 {
		block = calloc(1, BLOCK_BYTES)
		descriptor = calloc(2, 8)
		set_field_i64(descriptor, 8, BLOCK_BYTES)
		set_field_pointer(block, 0, library_function("c", "_NSConcreteGlobalBlock"))
		set_field_i32(block, BLOCK_FLAGS_AT, BLOCK_IS_GLOBAL)
		set_field_pointer(block, BLOCK_INVOKE_AT, c_callback(answer_given, ["i64", "i64", "i64"]))
		set_field_pointer(block, BLOCK_DESCRIPTOR_AT, descriptor)
		web.answer_block = handle_pointer(block)
	}
	web.answer_block
}
# the text a body run as an async function in the view gives back; raises the view's failure
answered(shown_in: int, body: text, name: text, value: text): text := {
	web.answer_heard = no
	given = if name == "" then told(class_named("NSDictionary"), "dictionary") else sent(class_named("NSDictionary"), "dictionaryWithObject:forKey:", [ns_string(value), ns_string(name)])
	world = told(class_named("WKContentWorld"), "pageWorld")
	sent(shown_in, "callAsyncJavaScript:arguments:inFrame:inContentWorld:completionHandler:", [ns_string(body), given, 0, world, answering_block()])
	if not spun(() => web.answer_heard, ANSWER_MS) { raise "no answer in ${ANSWER_MS ÷ MS_PER_SECOND} s (a promise that never settles?)" }
	if web.answer_error != 0 {
		said = sent(told(web.answer_error, "userInfo"), "objectForKey:", [ns_string("WKJavaScriptExceptionMessage")])
		failure = ns_text(if said != 0 then said else told(web.answer_error, "localizedDescription"))
		told(web.answer_error, "release")
		raise failure
	}
	given_back = if web.answer_value == 0 then "" else ns_text(if is_kind(web.answer_value, "NSString") then web.answer_value else told(web.answer_value, "description"))
	if web.answer_value != 0 { told(web.answer_value, "release") }
	given_back
}

is_name(name: text): bool := #name > 0 and NAME_STARTS.contains(name[0 .. 1]) and name.codepoints().all(c => NAME_GOES_ON.contains(text(c)))
# a member `use js` may name: an identifier, or as js-members.js reads it "" (construct), "set x", "a.b"
member_named(member: text): bool := {
	name = member.remove_prefix("set ")
	name == "" or name.split(".").all(is_name)
}
# the failure as the page says it: "js Math.nope: ReferenceError: …", the call named once, without WebKit's "Error: "
failure_said(called: text, failure: text): text := {
	plain = failure.remove_prefix("Error: ")
	if plain.starts_with(called) then plain else called + ": " + plain
}

window_closing(receiver: int, selector: int, notification: int) := { web.app_window_open = no }
window_event_over(): bool := #web.page_events > 0 or not web.app_window_open
app_window_made(title: text): int := {
	made = sent_with_floats(told(class_named("NSWindow"), "alloc"), "initWithContentRect:styleMask:backing:defer:", [WINDOW_STYLE, BUFFERED, 0], APP_WINDOW_FRAME)
	sent(made, "setReleasedWhenClosed:", [0])
	sent(made, "setTitle:", [ns_string(title)])
	sent(made, "setDelegate:", [instance_of(class_made("WapHostAppWindowClosing", [method_of("windowWillClose:", window_closing)]))])
	made
}
window_shown(shown: int, shown_view: int) := {
	sent_with_floats(shown_view, "setFrame:", [], APP_WINDOW_FRAME)
	sent(shown_view, "setAutoresizingMask:", [SIZES_WITH_WINDOW])
	sent(told(shown, "contentView"), "addSubview:", [shown_view])
	told(shown, "center")
	sent(shown, "makeKeyAndOrderFront:", [0])
	sent(application(), "activateIgnoringOtherApps:", [1])
}
# `warpWindow.show()`: the run's view in a window; `warpWindow.next(milliseconds)`: the page's next event,
# {event, detail, wall}, else {event: "tick", wall} once the milliseconds are over (none or -1: wait for an event), wall
# the local wall clock's milliseconds since 1970 (lib/timers.warp); ø once the window is closed
window_answered(called: text, member: text, arguments: any): any? := {
	if member == "show" {
		if windowless() { raise called + ": no window under --no-window" }
		if web.app_window == 0 {
			shown_view = hidden_view()
			application_made(POLICY_ACCESSORY)
			told(application(), "finishLaunching")
			web.app_window = app_window_made(run_option("app-window") ?? "warp")
			web.app_window_open = yes
			window_shown(web.app_window, shown_view)
		}
		return ø
	}
	if member != "next" { raise called + ": the window has no " + member + ": show or next" }
	if web.app_window == 0 { raise called + ": no window shown: warpWindow.show(title) first" }
	waited = if arguments is list and #arguments > 0 and arguments#1 is int then arguments#1 else -1
	pumped(window_event_over, if waited >= 0 then waited else FOREVER_MS)
	if not web.app_window_open { return ø }
	happened = {event: TICK_EVENT}
	if #web.page_events > 0 {
		happened = parse_json(web.page_events#1)
		web.page_events = web.page_events[1 ..]
	}
	happened["wall"] = wall_clock_ms() + sent(told(class_named("NSTimeZone"), "localTimeZone"), "secondsFromGMT", []) * 1000
	happened
}

# foreign_call(runtime, module, member, call, arguments), as the page's host-foreign.js foreignCall answers it
foreign_call(runtime: text, module: any, member: text, call: int, arguments: any): any? := {
	pool = objc_autoreleasePoolPush()
	# (a failure is the call's Error, a value the program may catch, as the page's foreignCall gives it)
	answer: any? = foreign_answered(runtime, module, member, call == 1, arguments)
	objc_autoreleasePoolPop(pool)
	answer
}
foreign_answered(runtime: text, module: any, member: text, call: bool, arguments: any): any? := {
	named_module = module is text
	module_name = if named_module then text(module) else "value"
	called = runtime + " " + module_name + "." + member
	if runtime != JS_RUNTIME { raise called + ": " + runtime + " is not in the native wap yet" }
	if (named_module and not is_name(module)) or not member_named(member) { raise called + ": not a name js has" }
	if named_module and module == APP_WINDOW { return window_answered(called, member, arguments) }
	if web.calling_back { raise called + ": " + NESTED_CALL }
	if call and arguments.any(argument => argument is function) { raise called + ": " + UNSEEN_ARITY }
	request = to_json({module: module, member: member, arguments: if call then arguments else ø})
	answer = try answered(hidden_view(), "return await warpForeignCall(request)", "request", request) catch failure { raise failure_said(called, failure.message) }
	parse_json(answer)
}

# `wap app check`: the text the page shows, read in the hidden web view; raises why a page did not load
webview_page_text(html: text): text := {
	pool = objc_autoreleasePoolPush()
	shown_in = hidden_view()
	page_loaded(shown_in, html)
	shown = answered(shown_in, "return document.body?.innerText ?? ''", "", "")
	objc_autoreleasePoolPop(pool)
	shown
}
