# The native wap's window (decision window-in-warp, card window-ffi-replace), a part of lib/host/native_host.wap: what the
# playground's canvas answers in JavaScript (web/playground/canvas.js), natively over SDL3 by plain FFI: the window's
# system values as functions (window_open, mouse_x, key_held …) and their setters, window_layer (a painting's Metal
# layer, on Windows the window's HWND, which gpu.wap shows it in) and window_run_ended.
# `window_open = 1` or the first painting opens it, never under --no-window. Each painting is a frame, its
# title telling the frame times; each painting and reading of window_open takes the window's events in. Closed, it
# ends a program painting on; a still picture (a run's one painting) stays shown after the run until it is closed.
# A window sized by its painting opens at the largest whole multiple of it that fits a share of the screen. It resizes
# freely and goes full screen by the system value window_fullscreen or its green button: gpu.wap shows the
# painting as large as fits, its aspect kept, centered; the pointer is told in the painting's pixels
use SDL3
use c
use file
use "platform.wap"
use "gpu.wap"
WINDOW_TITLE := "wap"
DEFAULT_WIDTH := 640
DEFAULT_HEIGHT := 480
# the most of the screen a window sized by its painting opens to
SCREEN_SHARE := 0.7
TITLE_EVERY_NS := 500000000
OUT_OF_SIGHT_MS := 16
# the codes lib/keys.warp KEY_NAMES gives the keys SDL codes above the characters (web/playground/canvas.js KEY_CODES):
# the arrows, and shift, control, alt and the command key, each the same on the left and the right
class KeyCode { sdl: int, wap: int }
KEY_UP := 63232
KEY_DOWN := 63233
KEY_LEFT := 63234
KEY_RIGHT := 63235
KEY_SHIFT := 63312
KEY_CONTROL := 63313
KEY_ALT := 63314
KEY_COMMAND := 63315
KEY_CODES := [KeyCode(SDLK_UP, KEY_UP), KeyCode(SDLK_DOWN, KEY_DOWN), KeyCode(SDLK_LEFT, KEY_LEFT), KeyCode(SDLK_RIGHT, KEY_RIGHT),
	KeyCode(SDLK_LSHIFT, KEY_SHIFT), KeyCode(SDLK_RSHIFT, KEY_SHIFT), KeyCode(SDLK_LCTRL, KEY_CONTROL), KeyCode(SDLK_RCTRL, KEY_CONTROL),
	KeyCode(SDLK_LALT, KEY_ALT), KeyCode(SDLK_RALT, KEY_ALT), KeyCode(SDLK_LGUI, KEY_COMMAND), KeyCode(SDLK_RGUI, KEY_COMMAND)]
# the frame times' units: nanoseconds a millisecond, milliseconds a second, and the title's tenths
NANOS_PER_MS := 1000000.0
MS_PER_SECOND := 1000
TENTHS := 10
# the bytes of a C int and of a C double, the cells SDL, CoreText and FreeType fill
INT_BYTES := 4
DOUBLE_BYTES := 8

# the window's state, one Window the host holds
class Window {
	sdl_window: int = 0
	view: int = 0
	open_now: bool = no
	sized_by_program: bool = no
	closed_by_user: bool = no
	width: int = DEFAULT_WIDTH
	height: int = DEFAULT_HEIGHT
	# the last painting's size in points: the pointer is told in them
	painted_width: int = 0
	painted_height: int = 0
	# the pixels the next painting has to a point across (system value paint_scale): lib/draw.warp paints at the
	# display's own pixels, a Retina display's two to a point, and is shown and pointed at in points
	paint_scale: int = 1
	# the keys held, the last pressed last; the keys that went down so far and the last of them: `on key {…}` runs for a
	# press even when the key is up again before the frame looks (lib/keys.warp)
	held: list<int> = []
	presses: int = 0
	last_pressed: int = 0
	mouse_x: float = 0.0
	mouse_y: float = 0.0
	wheel: float = 0.0
	mouse_down: bool = no
	# where the button last went down, in the window's points: a stroke starts there (mouse_down_x, mouse_down_y)
	down_x: float = 0.0
	down_y: float = 0.0
	frames: int = 0
	frames_since_title: int = 0
	title_ns: int = 0
	# samples/graphics/gaussian_splats.warp --times sets this. The upload and the draw then print their milliseconds
	paint_timing: bool = no
	# the blocks SDL fills: an event, a rectangle, the window's two sides
	event: int = 0
	rectangle: int = 0
	wide_cell: int = 0
	high_cell: int = 0
}
global window = Window()

# no window under --no-window, nor without SDL3
windows_refused() := windowless() or not sdl_present()
# the keycode SDL tells as the code wap gives the key; 0 for a key without one
key_code(key: int): int := {
	for known in KEY_CODES { if known.sdl == key { return known.wap } }
	if key >= SDLK_SCANCODE_MASK then 0 else key
}
key_went_down(code: int, repeated: bool) := {
	if code != 0 and not repeated {
		window.presses += 1
		window.last_pressed = code
	}
	if code != 0 and not window.held.contains(code) { window.held.add(code) }
}
key_released(code: int) := { window.held = window.held.filter(k => k != code) }

# how many times the painting's size the window opens at: the most that fits SCREEN_SHARE of the screen, at least once
enlarged(): int := {
	if window.sized_by_program or not SDL_GetDisplayUsableBounds(SDL_GetPrimaryDisplay(), window.rectangle) { return 1 }
	times = floor(min(field_i32(window.rectangle, SDL_RECT_WIDTH_AT) * SCREEN_SHARE / window.width, field_i32(window.rectangle, SDL_RECT_HEIGHT_AT) * SCREEN_SHARE / window.height)) as int
	max(times, 1)
}
# the window's sides as it opens: the painting's, enlarged
enlarged_sides(): list<int> := {
	times = enlarged()
	[window.width * times, window.height * times]
}
# the primary display: its sides in pixels and its density (a CSS pixel is 1/96 inch, so content scale 2 is 192 dpi);
# without SDL's video, 0 by 0 at CSS's density
CSS_DPI := 96
class Display { width: int, height: int, dpi: float }
display_now(): Display := {
	if windows_refused() or not sdl_started(SDL_INIT_VIDEO) { return Display(0, 0, CSS_DPI) }
	display = SDL_GetPrimaryDisplay()
	bounds = calloc(1, SDL_RECT_BYTES)
	known = SDL_GetDisplayBounds(display, bounds)
	sides = if known then [field_i32(bounds, SDL_RECT_WIDTH_AT), field_i32(bounds, SDL_RECT_HEIGHT_AT)] else [0, 0]
	free(bounds)
	Display(sides[0], sides[1], CSS_DPI * SDL_GetDisplayContentScale(display))
}
# a window the program gave no size takes its painting's
painting_size_taken(painting_width: int, painting_height: int) := {
	window.width = painting_width
	window.height = painting_height
}
# a window that does not open raises SDL's reason
window_opened() := {
	if window.open_now or windows_refused() { return }
	if not sdl_started(SDL_INIT_VIDEO) { raise "window: " + SDL_GetError() }
	window.event = calloc(1, SDL_EVENT_BYTES)
	window.rectangle = calloc(1, SDL_RECT_BYTES)
	window.wide_cell = calloc(1, INT_BYTES)
	window.high_cell = calloc(1, INT_BYTES)
	sides = enlarged_sides()
	window.sdl_window = SDL_CreateWindow(WINDOW_TITLE, sides[0], sides[1], (if on_mac() then SDL_WINDOW_METAL else 0) + SDL_WINDOW_RESIZABLE)
	if window.sdl_window == 0 { raise "window: " + SDL_GetError() }
	window.view = if on_mac() then SDL_Metal_CreateView(window.sdl_window) else SDL_GetPointerProperty(SDL_GetWindowProperties(window.sdl_window), SDL_PROP_WINDOW_WIN32_HWND_POINTER, 0)
	window.open_now = yes
	window.title_ns = SDL_GetTicksNS()
}
window_closed() := {
	if window.view != 0 and on_mac() { SDL_Metal_DestroyView(window.view) }
	if window.sdl_window != 0 { SDL_DestroyWindow(window.sdl_window) }
	window.view = 0
	window.sdl_window = 0
	window.open_now = no
}
# the frame times in the title, every half second: the mean of the frames since
frame_timed() := {
	now = SDL_GetTicksNS()
	window.frames += 1
	window.frames_since_title += 1
	if now - window.title_ns < TITLE_EVERY_NS { return }
	milliseconds = (now - window.title_ns) / NANOS_PER_MS / window.frames_since_title
	SDL_SetWindowTitle(window.sdl_window, WINDOW_TITLE + " — " + tenths(milliseconds) + " ms a frame, " + round(MS_PER_SECOND / milliseconds) + " fps")
	window.title_ns = now
	window.frames_since_title = 0
}
tenths(x: float): text := {
	whole = round(x * TENTHS)
	"\(whole ÷ TENTHS).\(whole % TENTHS)"
}
# the window's events since the last frame taken in
events_taken() := {
	window.wheel = 0.0
	while window.open_now and SDL_PollEvent(window.event) { event_taken(field_u32(window.event, SDL_EVENT_TYPE_AT)) }
	# a window out of sight has no refresh to wait for: its frames idle instead of spinning
	out_of_sight = SDL_WINDOW_HIDDEN + SDL_WINDOW_MINIMIZED + SDL_WINDOW_OCCLUDED
	if window.open_now and (SDL_GetWindowFlags(window.sdl_window) & out_of_sight) != 0 { SDL_Delay(OUT_OF_SIGHT_MS) }
}
event_taken(type: int) := {
	if type == SDL_EVENT_QUIT or type == SDL_EVENT_WINDOW_CLOSE_REQUESTED {
		window.closed_by_user = yes
		window_closed()
	}
	if type == SDL_EVENT_KEY_DOWN { key_went_down(key_code(field_u32(window.event, SDL_KEY_AT)), field_u8(window.event, SDL_KEY_REPEAT_AT) != 0) }
	if type == SDL_EVENT_KEY_UP { key_released(key_code(field_u32(window.event, SDL_KEY_AT))) }
	if type == SDL_EVENT_MOUSE_MOTION {
		window.mouse_x = field_f32(window.event, SDL_MOUSE_X_AT)
		window.mouse_y = field_f32(window.event, SDL_MOUSE_Y_AT)
	}
	if type == SDL_EVENT_MOUSE_BUTTON_DOWN {
		window.mouse_down = yes
		window.down_x = field_f32(window.event, SDL_MOUSE_X_AT)
		window.down_y = field_f32(window.event, SDL_MOUSE_Y_AT)
	}
	if type == SDL_EVENT_MOUSE_BUTTON_UP { window.mouse_down = no }
	if type == SDL_EVENT_MOUSE_WHEEL { window.wheel += field_f32(window.event, SDL_WHEEL_Y_AT) }
}

# the window's width (across), else its height, in points
window_side(across: bool): int := {
	SDL_GetWindowSize(window.sdl_window, window.wide_cell, window.high_cell)
	field_i32(if across then window.wide_cell else window.high_cell, 0)
}
# a pointer position in the window's points as a pixel of the painting the window shows as large as fits, centered
# (gpu.wap letterboxed); across or down
in_painting(point: float, across: bool): int := {
	wide = window_side(yes)
	high = window_side(no)
	if window.painted_width <= 0 or window.painted_height <= 0 or wide <= 0 or high <= 0 { return floor(point) as int }
	scale = min(wide / window.painted_width, high / window.painted_height) as float
	margin = if across then (wide - window.painted_width * scale) / 2 else (high - window.painted_height * scale) / 2
	floor((point - margin) / scale) as int
}
# where the pointer is, and where its button last went down (a stroke starts there), in the painting's pixels; 0
# without a window
pointed(point: float, across: bool): int := if window.open_now then in_painting(point, across) else 0
mouse_x(): int := pointed(window.mouse_x, yes)
mouse_y(): int := pointed(window.mouse_y, no)
mouse_down_x(): int := pointed(window.down_x, yes)
mouse_down_y(): int := pointed(window.down_y, no)
window_fullscreen(): bool := window.open_now and (SDL_GetWindowFlags(window.sdl_window) & SDL_WINDOW_FULLSCREEN) != 0
# whether the system shows dark mode, asked without a window (SDL's theme needs its video started): macOS keeps it as
# the global preference AppleInterfaceStyle "Dark"; elsewhere not known, light. A run with no window (`--no-window`,
# every `wap test` case) shows nothing on the screen, so it follows no theme: light, its pictures documents on paper
CFPreferencesCopyAppValue(key: handle, application: handle): handle from 'CoreFoundation'
CFStringCompare(a: handle, b: handle, options: i64): i64 from 'CoreFoundation'
CF_CASE_INSENSITIVE := 1
dark_mode(): bool := {
	if not on_mac() or windowless() { return no }
	style = CFPreferencesCopyAppValue(cf_text("AppleInterfaceStyle"), cf_text("kCFPreferencesAnyApplication"))
	if style == 0 { return no }
	dark = CFStringCompare(style, cf_text("Dark"), CF_CASE_INSENSITIVE) == 0
	CFRelease(style)
	dark
}

# the window open, its events since taken in
window_open(): bool := {
	if window.open_now { events_taken() }
	window.open_now
}
window_possible(): bool := not windows_refused()
# the open window's size as its user made it, in points (a painting without a size follows it); before it opens, the
# size the program set
window_width(): int := if window.open_now then window_side(yes) else window.width
window_height(): int := if window.open_now then window_side(no) else window.height
key_down(): bool := window.open_now and #window.held > 0
# the code of the key held at a slot, the first pressed first (0 none), as the playground's canvas.js keeps them, so
# lib/keys.warp held(key) tells W and A held together: a diagonal
key_held(slot: int): int := if window.open_now and slot < #window.held then window.held[slot] else 0
# the code of the key pressed last that is still held, else 0
key_code_held(): int := if key_down() then window.held.last() else 0
# the keys that went down so far, and the last of them: `on key {…}` runs for a press even when the key is up again
# before the frame looks (lib/keys.warp)
keys_pressed(): int := window.presses
key_code_pressed(): int := window.last_pressed
mouse_down(): bool := window.open_now and window.mouse_down
mouse_wheel(): int := if window.open_now then window.wheel as int else 0
# use draw's shapes drawn on the GPU (lib/draw.warp shape_shader) where a window can show them
gpu_drawing(): bool := not windows_refused() and device_ready()

# the window opened (yes) or closed (no)
window_open_set(open: bool) := if open then window_opened() else window_closed()
window_fullscreen_set(full: bool) := { if window.open_now { SDL_SetWindowFullscreen(window.sdl_window, full) } }
# the window's size as the program sets it, which a painting then does not change
window_size_set(width: int, height: int) := {
	window.width = width
	window.height = height
	window.sized_by_program = yes
	if window.open_now { SDL_SetWindowSize(window.sdl_window, width, height) }
}
# the pixels the next painting has to a point across
paint_scale_set(scale: int) := {
	if scale < 1 { raise "paint_scale: a painting has at least one pixel to a point, not ${scale}" }
	window.paint_scale = scale
}
paint_timing_set(timed: bool) := { window.paint_timing = timed }
# a window its user closed ends the run
run_ended_if_closed() := { if window.closed_by_user { exit(0) } }
# the window's Metal layer (Windows: its HWND) for a painting of width × height, the window opened by the first; 0 where none opens. A
# window the program gave no size takes its first painting's. Closed by its user, the run ends
window_layer(pixels_wide: int, pixels_high: int): int := {
	painting_width = pixels_wide ÷ window.paint_scale
	painting_height = pixels_high ÷ window.paint_scale
	window.paint_scale = 1
	run_ended_if_closed()
	if not window.open_now {
		if not window.sized_by_program { painting_size_taken(painting_width, painting_height) }
		window_opened()
	}
	if not window.open_now or window.view == 0 { return 0 }
	events_taken()
	run_ended_if_closed()
	frame_timed()
	window.painted_width = painting_width
	window.painted_height = painting_height
	if not window.sized_by_program and window.frames == 1 and (painting_width != window.width or painting_height != window.height) {
		painting_size_taken(painting_width, painting_height)
		sides = enlarged_sides()
		SDL_SetWindowSize(window.sdl_window, sides[0], sides[1])
	}
	if on_mac() then SDL_Metal_GetLayer(window.view) else window.view
}
# the window's size in pixels, which its Metal layer's drawable keeps (gpu.wap shows a painting at it)
window_pixels(): list<int> := {
	SDL_GetWindowSizeInPixels(window.sdl_window, window.wide_cell, window.high_cell)
	[field_i32(window.wide_cell, 0), field_i32(window.high_cell, 0)]
}
# a run that painted one picture leaves it in the window until the window is closed (or Escape), shown again as the
# window comes into sight (it opens behind the app in front) or changes size; an animation's window closes with its run
window_run_ended() := { while window.open_now and window.frames == 1 and SDL_WaitEvent(window.event) { still_event_taken() } }
# the console waiting for its next line: the events that came in taken, so the picture a line painted shows as after a
# run, and closes the same way (card image-import-fix)
window_waited() := { while window.open_now and SDL_PollEvent(window.event) { still_event_taken() } }
# an event of a window showing a still picture: closing it, or the picture shown again
still_event_taken() := {
	type = field_u32(window.event, SDL_EVENT_TYPE_AT)
	escaped = type == SDL_EVENT_KEY_DOWN and field_u32(window.event, SDL_KEY_AT) == SDLK_ESCAPE
	if type == SDL_EVENT_QUIT or type == SDL_EVENT_WINDOW_CLOSE_REQUESTED or escaped { window_closed() }
	else if type == SDL_EVENT_WINDOW_EXPOSED or type == SDL_EVENT_WINDOW_PIXEL_SIZE_CHANGED { shown_again() }
}

# text_coverage(words, size) (label of use draw): the words set `size` pixels per em on one line in the system's
# sans-serif font, as [width, height, then how much each pixel is covered from 0 to 255, row by row], its height the
# font's ascent and descent, as the playground's canvas sets them (web/playground/host-media.js). On macOS CoreText
# sets them, as the system shows text; elsewhere, or with `font` naming a font file, FreeType
text_coverage(words: text, size: int, font: text): list<int> := if on_mac() and font == "" then core_text_coverage(words, size) else free_type_coverage(words, size, font)

CTFontCreateWithName(name: handle, size: f64, matrix: handle): handle from 'CoreText'
CTLineCreateWithAttributedString(string: handle): handle from 'CoreText'
CTLineGetTypographicBounds(line: handle, ascent: handle, descent: handle, leading: handle): f64 from 'CoreText'
CTLineDraw(line: handle, context: handle): void from 'CoreText'
CFAttributedStringCreateMutable(allocator: handle, most: i64): handle from 'CoreFoundation'
# (a CFRange crosses as its start and length)
CFAttributedStringReplaceString(string: handle, start: i64, length: i64, replacement: handle): void from 'CoreFoundation'
CFAttributedStringSetAttribute(string: handle, start: i64, length: i64, name: handle, value: handle): void from 'CoreFoundation'
CFStringGetLength(string: handle): i64 from 'CoreFoundation'
CGBitmapContextCreate(data: handle, width: i64, height: i64, bits: i64, row: i64, space: handle, info: i32): handle from 'CoreGraphics'
CGBitmapContextGetData(context: handle): handle from 'CoreGraphics'
CGContextSetTextPosition(context: handle, x: f64, y: f64): void from 'CoreGraphics'
SYSTEM_FONT_NAME := "Helvetica"
# kCTFontAttributeName's string
FONT_ATTRIBUTE := "NSFont"
# a bitmap of one byte a pixel, its coverage (kCGImageAlphaOnly, no color space)
ALPHA_ONLY := 7
# cells CoreText and FreeType fill: a line's ascent, descent and leading, a kerning's vector
global ascent_cell = 0
global descent_cell = 0
global leading_cell = 0
global kerning_cell = 0
cells_made() := {
	if ascent_cell == 0 {
		ascent_cell = calloc(1, DOUBLE_BYTES)
		descent_cell = calloc(1, DOUBLE_BYTES)
		leading_cell = calloc(1, DOUBLE_BYTES)
		# (FreeType's vector: x and y)
		kerning_cell = calloc(2, DOUBLE_BYTES)
	}
}
# the coverage list of a width × height bitmap, its pixels' coverage row by row
coverage_list(width: int, height: int, coverage: list<int>): list<int> := [width, height] + coverage
core_text_coverage(words: text, size: int): list<int> := {
	cells_made()
	string = CFStringCreateWithCString(0, words, CF_UTF8)
	attributed = CFAttributedStringCreateMutable(0, 0)
	CFAttributedStringReplaceString(attributed, 0, 0, string)
	font = CTFontCreateWithName(cf_text(SYSTEM_FONT_NAME), size, 0)
	CFAttributedStringSetAttribute(attributed, 0, CFStringGetLength(string), cf_text(FONT_ATTRIBUTE), font)
	line = CTLineCreateWithAttributedString(attributed)
	across = CTLineGetTypographicBounds(line, ascent_cell, descent_cell, leading_cell)
	descent = field_f64(descent_cell, 0)
	bitmap_width = max(ceil(across) as int, 1)
	bitmap_height = max(ceil(field_f64(ascent_cell, 0) + descent) as int, 1)
	bitmap = CGBitmapContextCreate(0, bitmap_width, bitmap_height, 8, bitmap_width, 0, ALPHA_ONLY)
	# (the baseline above the bottom by the descent; the bitmap's rows from the top)
	CGContextSetTextPosition(bitmap, 0, descent)
	CTLineDraw(line, bitmap)
	data = CGBitmapContextGetData(bitmap)
	covered = coverage_list(bitmap_width, bitmap_height, [field_u8(data, i) for i in 0 ..< bitmap_width * bitmap_height])
	for made in [bitmap, line, font, attributed, string] { CFRelease(made) }
	covered
}

# FreeType (Linux's own text, or label's `font` file anywhere): each font read once, each glyph rendered at its place on
# the line, its kerning from the one before
FT_Init_FreeType(library: out): handle from 'freetype'
FT_New_Face(library: handle, path: text, index: i64, face: out): handle from 'freetype'
FT_Set_Pixel_Sizes(face: handle, width: i32, height: i32): i32 from 'freetype'
FT_Get_Char_Index(face: handle, code: i64): i32 from 'freetype'
FT_Load_Glyph(face: handle, glyph: i32, flags: i32): i32 from 'freetype'
FT_Get_Kerning(face: handle, left: i32, right: i32, mode: i32, kerning: handle): i32 from 'freetype'
# the sans-serif fonts looked for, the first found used: what browsers show for sans-serif on each system
SYSTEM_FONTS := ["/System/Library/Fonts/Helvetica.ttc", "/System/Library/Fonts/Supplemental/Arial.ttf",
	"/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", "/usr/share/fonts/TTF/DejaVuSans.ttf", "/usr/share/fonts/dejavu/DejaVuSans.ttf",
	"/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf", "/usr/share/fonts/liberation-sans/LiberationSans-Regular.ttf"]
FT_LOAD_RENDER := 4
FT_KERNING_DEFAULT := 0
# FreeType's lengths are 64ths of a pixel
FT_UNITS := 64
# the fields read: FT_FaceRec's glyph and size, FT_SizeRec's metrics' ascender and descender, FT_GlyphSlotRec's
# advance.x, bitmap (rows, width, pitch, buffer), bitmap_left and bitmap_top
FT_FACE_GLYPH_AT := 152
FT_FACE_SIZE_AT := 160
FT_SIZE_ASCENDER_AT := 48
FT_SIZE_DESCENDER_AT := 56
FT_GLYPH_ADVANCE_AT := 128
FT_GLYPH_ROWS_AT := 152
FT_GLYPH_WIDTH_AT := 156
FT_GLYPH_PITCH_AT := 160
FT_GLYPH_BUFFER_AT := 168
FT_GLYPH_LEFT_AT := 192
FT_GLYPH_TOP_AT := 196
# the faces read so far, by font file ("" the system's)
global faces: map<text, int> = {}
font_face(font: text) := {
	if not faces.has(font) {
		path = if font == "" then SYSTEM_FONTS.find(exists) else font
		if path == ø { raise "no font found: install DejaVu Sans, or name a font file: label(…, font: ./my.ttf)" }
		if not exists(path) { raise "cannot read the font " + path }
		faces[font] = FT_New_Face(FT_Init_FreeType(), path, 0)
	}
	faces[font]
}
# a glyph rendered at its place on the line's bitmap: its top left, its size and its pixels' coverage row by row
class Glyph { left: int, top: int, columns: int, rows: int, coverage: list<int> }
free_type_coverage(words: text, size: int, file: text): list<int> := {
	cells_made()
	font = font_face(file)
	FT_Set_Pixel_Sizes(font, 0, size)
	metrics = field_pointer(font, FT_FACE_SIZE_AT)
	ascent = field_i64(metrics, FT_SIZE_ASCENDER_AT) / FT_UNITS
	bitmap_height = max(ceil(ascent - field_i64(metrics, FT_SIZE_DESCENDER_AT) / FT_UNITS) as int, 1)
	slot = field_pointer(font, FT_FACE_GLYPH_AT)
	glyphs: list<Glyph> = []
	caret = 0
	previous = 0
	for c in words.codepoints() {
		glyph = FT_Get_Char_Index(font, ord(c))
		if previous != 0 {
			FT_Get_Kerning(font, previous, glyph, FT_KERNING_DEFAULT, kerning_cell)
			caret += field_i64(kerning_cell, 0)
		}
		FT_Load_Glyph(font, glyph, FT_LOAD_RENDER)
		columns = field_u32(slot, FT_GLYPH_WIDTH_AT)
		rows = field_u32(slot, FT_GLYPH_ROWS_AT)
		pitch = field_i32(slot, FT_GLYPH_PITCH_AT)
		buffer = field_pointer(slot, FT_GLYPH_BUFFER_AT)
		coverage = [field_u8(buffer, (k ÷ columns) * pitch + k % columns) for k in 0 ..< columns * rows]
		glyphs.add(Glyph(caret ÷ FT_UNITS + field_i32(slot, FT_GLYPH_LEFT_AT), round(ascent) - field_i32(slot, FT_GLYPH_TOP_AT), columns, rows, coverage))
		caret += field_i64(slot, FT_GLYPH_ADVANCE_AT)
		previous = glyph
	}
	bitmap_width = max(ceil(caret / FT_UNITS) as int, 1)
	cells = int[bitmap_width * bitmap_height]
	for g in glyphs {
		for k in 0 ..< g.columns * g.rows {
			column = g.left + k % g.columns
			row = g.top + k ÷ g.columns
			if column >= 0 and column < bitmap_width and row >= 0 and row < bitmap_height { cells[row * bitmap_width + column] = min(cells[row * bitmap_width + column] + g.coverage[k], 255) }
		}
	}
	coverage_list(bitmap_width, bitmap_height, cells)
}
