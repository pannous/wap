# The files a program reads and writes beyond wap's own words: the types module reads, writes bytes, lists and tests
# files (a leading ~ the home folder) and reads the environment (started_env); lib/file.warp and lib/os.warp build on
# it. The native wap has no run options yet (no --lib, --no-window or cache): run_option is ø.
public write(path: text, content: any) := write_bytes(path, bytes(text(content)))
public read_bytes(path: text): list<int> := bytes(read(path))
# an option of this run: none on the native wap yet, so ø
run_option(name: any) := ø
