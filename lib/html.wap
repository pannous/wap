# The standard module html (wiki/library-dogfood-apps.md "comment_board", wiki/library-template.md): text made safe
# inside HTML and read back. html_escape writes HTML's special characters as entities; html_unescape reads numeric
# character references (&#39; &#x27;) and the common named ones back, anything else staying as written.

# each character HTML gives a meaning, and the entity that writes it as itself; the ampersand first
ESCAPES := [["&", "&amp;"], ["<", "&lt;"], [">", "&gt;"], ["\"", "&quot;"], ["'", "&#39;"]]
# the named references html_unescape reads, each with its character
NAMED := [["amp", "&"], ["lt", "<"], ["gt", ">"], ["quot", "\""], ["apos", "'"], ["nbsp", "\u{A0}"], ["copy", "©"], ["reg", "®"], ["trade", "™"], ["hellip", "…"], ["mdash", "—"], ["ndash", "–"], ["euro", "€"]]
# what a reference to no character gives: 0, a surrogate, a code point past Unicode
REPLACEMENT := 65533
LAST_CODE_POINT := 1114111

# the text with its HTML characters written as entities: html_escape("<b>") is "&lt;b&gt;"
html_escape(t: text): text := ESCAPES.fold(t, (escaped, entity) => escaped.replace(entity[0], entity[1]))

# the text with its character references read: "Tom &amp; Jerry &#33;" is "Tom & Jerry !"
html_unescape(t: text): text := {
	out = ""
	rest = t
	while rest.contains("&") {
		at = find(rest, "&") - 1
		out += rest[0:at]
		rest = rest[at:]
		semicolon = find(rest, ";") - 1
		character = if semicolon > 1 then referenced(rest[1:semicolon]) else ""
		if character == "" {
			out += "&"
			rest = rest[1:]
		} else {
			out += character
			rest = rest[semicolon + 1:]
		}
	}
	out + rest
}
# the character a reference's name names ("amp", "#33", "#x21"), "" for none
referenced(name: text): text := {
	if name.starts_with("#x") or name.starts_with("#X") { return numbered(name[2:], 16) }
	if name.starts_with("#") { return numbered(name[1:], 10) }
	found = NAMED.filter(entry => entry[0] == name)
	if found is empty then "" else found[0][1]
}
DIGITS := "0123456789abcdef"
# the character of a number written in base, "" when the digits are none or not all digits
numbered(digits: text, base: int): text := {
	if digits == "" or #digits > 8 or not lower(digits).codepoints.all(c => place_of_digit("${c}") >= 0 and place_of_digit("${c}") < base) { return "" }
	n = lower(digits).codepoints.fold(0, (value, c) => value * base + place_of_digit("${c}"))
	if n == 0 or n > LAST_CODE_POINT or (n >= 55296 and n <= 57343) then text(char(REPLACEMENT)) else text(char(n))
}
# a digit's value, -1 for none (find counts from 1)
place_of_digit(c: text): int := find(DIGITS, c) - 1
