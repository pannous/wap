# The standard module hyperreal (wiki/hyperreals.md): `use hyperreal`. ε (epsilon), the canonical infinitesimal, is
# bigger than 0 and smaller than every positive real; ω (omega) = 1/ε is bigger than every real; ε * ω is 1.
# A Hyperreal is a finite sum of powers of ε (ω being ε⁻¹), each times an exact real of lib/reals.wap: 1 + 2ε + ε²,
# 3ω - 1, πε. + - * and whole powers are exact, / by a single term (2ε, ω², a number) too; dividing by a sum (1 + ε)
# would need an infinite series and is refused. Comparing reads the term of the lowest power of ε, the largest one:
# ω - 1000 < ω, 1 + ε > 1, πε < 4ε. hyper(x) makes one of a Real or an int.
use reals

EPSILON_GLYPH := "ε"
OMEGA_GLYPH := "ω"

# the sum of parts[i]·ε^(low + i); neither end of parts is zero, zero has none
class Hyperreal { low: int, parts: list<Real> }

ε := Hyperreal(1, [real(1)])
ω := Hyperreal(-1, [real(1)])
epsilon := ε
omega := ω
hyper(x: Real): Hyperreal := hyperreal(0, [x])
hyper(n: int): Hyperreal := hyper(real(n))

# the sum of parts[i]·ε^(low + i) with its zero ends dropped
hyperreal(low: int, parts: list<Real>): Hyperreal := {
	first = 0
	while first < #parts and parts[first] == 0 { first += 1 }
	last = #parts
	while last > first and parts[last - 1] == 0 { last -= 1 }
	if first == last then Hyperreal(0, []) else Hyperreal(low + first, parts[first:last])
}
# the part of ε^power, 0 where it has none
part(x: Hyperreal, power: int): Real := if power >= x.low and power < x.low + #x.parts then x.parts[power - x.low] else real(0)

# --- arithmetic

+(a: Hyperreal, b: Hyperreal): Hyperreal := {
	low = min(a.low, b.low)
	high = max(a.low + #a.parts, b.low + #b.parts)
	hyperreal(low, (low upto high).map(power => part(a, power) + part(b, power)))
}
-(x: Hyperreal): Hyperreal := Hyperreal(x.low, x.parts.map(p => -p))
-(a: Hyperreal, b: Hyperreal): Hyperreal := a + -b
*(a: Hyperreal, b: Hyperreal): Hyperreal := {
	if a.parts is empty or b.parts is empty { return Hyperreal(0, []) }
	products = (0 upto #a.parts + #b.parts - 1).map(i => real(0))
	for i in 0 upto #a.parts { for j in 0 upto #b.parts { products[i + j] = products[i + j] + a.parts[i] * b.parts[j] } }
	hyperreal(a.low + b.low, products)
}
/(a: Hyperreal, b: Hyperreal): Hyperreal := {
	if #b.parts != 1 { raise "hyperreal: dividing by the sum ${text(b)} has no finite result" }
	hyperreal(a.low - b.low, a.parts.map(p => p / b.parts[0]))
}
# (1 + ε)², ε⁻¹: a whole power by repeated multiplication, a negative one 1 divided by it
^(x: Hyperreal, k: int): Hyperreal := {
	result = hyper(1)
	for i in 0 upto abs(k) { result = result * x }
	if k < 0 then hyper(1) / result else result
}

# TODO (card library-widening) one widening instead of these pairs
# a real or an int on either side is the hyperreal it is
+(a: Hyperreal, b: Real): Hyperreal := a + hyper(b)
+(a: Real, b: Hyperreal): Hyperreal := hyper(a) + b
-(a: Hyperreal, b: Real): Hyperreal := a - hyper(b)
-(a: Real, b: Hyperreal): Hyperreal := hyper(a) - b
*(a: Hyperreal, b: Real): Hyperreal := a * hyper(b)
*(a: Real, b: Hyperreal): Hyperreal := hyper(a) * b
/(a: Hyperreal, b: Real): Hyperreal := a / hyper(b)
/(a: Real, b: Hyperreal): Hyperreal := hyper(a) / b
+(a: Hyperreal, b: int): Hyperreal := a + hyper(b)
+(a: int, b: Hyperreal): Hyperreal := hyper(a) + b
-(a: Hyperreal, b: int): Hyperreal := a - hyper(b)
-(a: int, b: Hyperreal): Hyperreal := hyper(a) - b
*(a: Hyperreal, b: int): Hyperreal := a * hyper(b)
*(a: int, b: Hyperreal): Hyperreal := hyper(a) * b
/(a: Hyperreal, b: int): Hyperreal := a / hyper(b)
/(a: int, b: Hyperreal): Hyperreal := hyper(a) / b

# --- comparing

# the sign of the largest term, the one of the lowest power of ε
sign(x: Hyperreal): int := if x.parts is empty then 0 else order(x.parts[0], real(0))
==(a: Hyperreal, b: Hyperreal): bool := (a - b).parts is empty
!=(a: Hyperreal, b: Hyperreal): bool := not (a == b)
<(a: Hyperreal, b: Hyperreal): bool := sign(a - b) < 0
>(a: Hyperreal, b: Hyperreal): bool := sign(a - b) > 0
==(a: Hyperreal, b: int): bool := a == hyper(b)
<(a: Hyperreal, b: int): bool := a < hyper(b)
>(a: Hyperreal, b: int): bool := a > hyper(b)

# --- text

# 1 + 2ε + ε², 3ω - 1, πε: each term with its power of ε or ω, the largest first
text(x: Hyperreal): text := {
	if x.parts is empty { return "0" }
	shown = ""
	for i in 0 upto #x.parts {
		if not (x.parts[i] == 0) { shown += term_text(x.parts[i], x.low + i, shown == "") }
	}
	shown
}
term_text(amount: Real, power: int, leading: bool): text := {
	unit = if power == 0 then "" else power_text(if power < 0 then OMEGA_GLYPH else EPSILON_GLYPH, abs(power))
	negative = order(amount, real(0)) < 0
	size = if negative then -amount else amount
	written = if unit != "" and size == 1 then "" else if #size.terms > 1 and unit != "" then "(" + text(size) + ")" else text(size)
	(if negative and leading then "-" else if negative then " - " else if leading then "" else " + ") + written + unit
}
