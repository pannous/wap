# The standard module intervals (wiki/library-intervals.md): an Extent runs from lo to hi, half-open [lo, hi) by
# default, closed [lo, hi] made by closed_extent; its ends are numbers (time Instants once wap has them).
#
# lo is always included, each extent decides its own hi end: a point p is in e when lo <= p and p < hi (or p == hi for
# a closed one). Two extents overlap when they share a point: [1, 3) and [3, 5) don't, [1, 3] and [3, 5) do (in 3). A
# half-open extent with lo == hi is empty and overlaps nothing; a closed one is the point lo. An intersection's hi end
# is that of the extent ending first (closed only if every extent ending there is); extent_union joins overlapping or
# touching extents and refuses disjoint ones (merge_intervals gives the list). The gaps of subtract_intervals are
# half-open up to each busy start and start at each busy end.

class Extent { lo: float, hi: float, closed: bool }

# [lo, hi)
extent(lo: float, hi: float): Extent := if hi < lo then raise "extent: hi ${hi} before lo ${lo}" else Extent(lo, hi, no)
# [lo, hi]
closed_extent(lo: float, hi: float): Extent := if hi < lo then raise "closed_extent: hi ${hi} before lo ${lo}" else Extent(lo, hi, yes)
text(e: Extent): text := "[${e.lo}, ${e.hi}${if e.closed then "]" else ")"}"
is_empty(e: Extent): bool := e.lo == e.hi and not e.closed
# hi - lo, 0 for an empty one
extent_length(e: Extent): float := e.hi - e.lo

# whether the point lies in the extent
extent_contains(e: Extent, p: float): bool := e.lo <= p and (p < e.hi or (e.closed and p == e.hi))
# whether the extent x lies wholly in e
extent_contains(e: Extent, x: Extent): bool := if is_empty(x) then e.lo <= x.lo and x.lo <= e.hi else e.lo <= x.lo and (x.hi < e.hi or (x.hi == e.hi and (e.closed or not x.closed)))
# whether a and b share a point
extents_overlap(a: Extent, b: Extent): bool := {
	if is_empty(a) or is_empty(b) { return no }
	start = max(a.lo, b.lo)
	first = if a.hi < b.hi then a else if b.hi < a.hi then b else if a.closed then b else a
	start < first.hi or (start == first.hi and first.closed)
}
# the shared part, ø when none
extent_intersection(a: Extent, b: Extent): Extent? := {
	if not extents_overlap(a, b) { return ø }
	hi = min(a.hi, b.hi)
	Extent(max(a.lo, b.lo), hi, (a.hi != hi or a.closed) and (b.hi != hi or b.closed))
}
# whether a and b overlap or one ends where the other starts
extents_join(a: Extent, b: Extent): bool := extents_overlap(a, b) or a.hi == b.lo or b.hi == a.lo
# one extent covering overlapping or touching a and b; disjoint ones are refused
extent_union(a: Extent, b: Extent): Extent := {
	if is_empty(a) { return b }
	if is_empty(b) { return a }
	if not extents_join(a, b) { raise "extent_union: ${a.text()} and ${b.text()} are disjoint" }
	hi = max(a.hi, b.hi)
	Extent(min(a.lo, b.lo), hi, (a.hi == hi and a.closed) or (b.hi == hi and b.closed))
}

# the extents with overlapping and touching ones joined, sorted by lo, the empty ones dropped
merge_intervals(extents: list<Extent>): list<Extent> := {
	merged: list<Extent> = []
	for e in extents.filter(e => not is_empty(e)).sorted(by: e => e.lo) {
		if #merged > 0 and extents_join(merged.last, e) { merged = merged.take(#merged - 1) + [extent_union(merged.last, e)] }
		else { merged.add(e) }
	}
	merged
}
# the parts of whole outside every busy extent: its free slots
subtract_intervals(whole: Extent, busy: list<Extent>): list<Extent> := {
	gaps: list<Extent> = []
	cursor = whole.lo
	merged = merge_intervals(busy)
	for b in merged.filter(b => extents_overlap(whole, b) or b.lo == whole.hi) {
		if cursor < b.lo { gaps.add(Extent(cursor, min(b.lo, whole.hi), no)) }
		cursor = max(cursor, b.hi)
	}
	if cursor < whole.hi or (whole.closed and cursor == whole.hi and not merged.any(b => extent_contains(b, cursor))) { gaps.add(Extent(cursor, whole.hi, whole.closed)) }
	gaps
}
# the summed length of the merged extents
total_length(extents: list<Extent>): float := merge_intervals(extents).map(extent_length).sum

# extents kept as added, not merged, so a stabbing query sees each; add and remove give a new set, remove cutting the
# removed part out of every stored extent
class IntervalSet { items: list<Extent> }
interval_set(extents: list<Extent>): IntervalSet := IntervalSet(extents)
add(set: IntervalSet, e: Extent): IntervalSet := IntervalSet(set.items + [e])
remove(set: IntervalSet, e: Extent): IntervalSet := IntervalSet(set.items.flat_map(x => subtract_intervals(x, [e])))
contains(set: IntervalSet, p: float): bool := set.items.any(e => extent_contains(e, p))
# every stored extent holding the point
stabbing(set: IntervalSet, p: float): list<Extent> := set.items.filter(e => extent_contains(e, p))
merged(set: IntervalSet): list<Extent> := merge_intervals(set.items)
