# The standard module json (wiki/json.md): `use json`. parse_json(t) reads JSON, and JSON5's freedoms too: // and /* */
# comments, 'single' quotes, trailing commas, bare keys and numbers such as +1 and .5. JSON is YAML's flow style, so
# the reading is yaml's flow reader on a scan of C comments. An object reads as a map<text, any>, an array as a
# list<any>. to_json(x), also `x.json`, writes ø, bools, numbers, texts, lists and maps compactly: `{a: 1}.json` is
# {"a":1}, a key written as text; ∞ and NaN have no JSON form.
use text
use map
use yaml

parse_json(source: text): any := {
	s = Scan(source, 0, c_comments: yes)
	value = flow_value(s, ",]}")
	skip_blanks(s)
	if s.at < #source { raise "${source} is no json: ${rest_of(s)} after the value" }
	value
}
to_json(value: any): text := {
	if value == ø then "null"
	else if value is bool then (if value == yes then "true" else "false")
	else if value is text then double_quoted("${value}")
	else if is_map(value) then json_object(value)
	else if is_list(value) then json_array(value)
	else json_number(value)
}
json(value: any): text := to_json(value)
json_object(m: map<K, V>): text := "{" + m.keys().map(key => "${double_quoted("${key}")}:${to_json(m[key])}").join(",") + "}"
json_array(xs: list<T>): text := "[" + xs.map(to_json).join(",") + "]"
json_number(n: any): text := {
	written = "${n}"
	if written.contains("∞") or written.contains("NaN") { raise "${written} has no JSON form" }
	written
}
# `use json; parse "[1, 2]"` (wiki/use.md)
parse(source: text): any := parse_json(source)
