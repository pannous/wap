# The standard module keys (wiki/graphics.md, Input and frames): the keys are one enum Key, each case spelled as a
# window or the playground's canvas names the key (`Key.up == "ArrowUp"`), Key.none for no key; `held_key() == Key.left`
# while the arrow is held, `on(Key.escape, { … })` runs as the key goes down. A key's code is its character's, the arrows
# and modifiers above them (lib/host/native_host/window.wap key_code)
use "host/native_host/window.wap"
use events
use shown_frames

enum Key {
	none = "", escape = "Escape", enter = "Enter", tab = "Tab", backspace = "Backspace", delete = "Delete", space = " ",
	up = "ArrowUp", down = "ArrowDown", left = "ArrowLeft", right = "ArrowRight",
	shift = "Shift", control = "Control", alt = "Alt", meta = "Meta",
	a, b, c, d, e, f, g, h, i, j, k, l, m, n, o, p, q, r, s, t, u, v, w, x, y, z,
	digit0 = "0", digit1 = "1", digit2 = "2", digit3 = "3", digit4 = "4", digit5 = "5", digit6 = "6", digit7 = "7",
	digit8 = "8", digit9 = "9",
	f1 = "F1", f2 = "F2", f3 = "F3", f4 = "F4", f5 = "F5", f6 = "F6", f7 = "F7", f8 = "F8", f9 = "F9", f10 = "F10",
	f11 = "F11", f12 = "F12"
}
# the bare words of the keys, aliases of its cases
ESC := Key.escape
ESCAPE := Key.escape
ENTER := Key.enter
RETURN := Key.enter
TAB := Key.tab
BACKSPACE := Key.backspace
UP := Key.up
DOWN := Key.down
LEFT := Key.left
RIGHT := Key.right
SPACE := Key.space
# the key of a code the window gives, Key.none for 0
key_of(code: int): Key := match code {
	0 => Key.none
	27 => Key.escape
	13 => Key.enter
	9 => Key.tab
	8 => Key.backspace
	127 => Key.delete
	63232 => Key.up
	63233 => Key.down
	63234 => Key.left
	63235 => Key.right
	63312 => Key.shift
	63313 => Key.control
	63314 => Key.alt
	63315 => Key.meta
	other => lower(text(char(code))) as Key
}

# the key held now, the last pressed of those held, Key.none for none (headless always)
held_key(): Key := key_of(key_code_held())
# every key held now, the first pressed first, as many as the window keeps (headless none): `held(Key.w)` and
# `held(Key.a)` together move diagonally, where held_key is only the last one
KEYS_HELD_KEPT := 8
keys_held(): list<Key> := [key_of(key_held(at)) for at in 0 ..< KEYS_HELD_KEPT].filter(key => key != Key.none)
held(key: Key): bool := keys_held().contains(key)

# `on(Key.escape, { … })`: the block runs once as that key goes down, never each frame it is held; `on_key(key => …)`
# runs for each key going down. The listeners are the key event's (lib/events.wap), so `emitted("key", Key.q)` reaches
# them too; the window's presses are taken each frame (shown_frames's frame event)
KEY_EVENT := "key"
on(key: Key, body: () -> any) as Listener := on_key(pressed => if pressed == key then body() else ø)
on_key(heard: (Key) -> any) as Listener := listen(KEY_EVENT, pressed => heard(pressed), no)
# the presses the window counted since the last look, the last one heard as the key event: a press counts though the
# key is up again before the frame looks
presses_seen: int = keys_pressed()
keys_went_down() := {
	global presses_seen
	if keys_pressed() != presses_seen {
		presses_seen = keys_pressed()
		emitted(KEY_EVENT, key_of(key_code_pressed()))
	}
}
listen(FRAME_EVENT, shown => keys_went_down(), no)
