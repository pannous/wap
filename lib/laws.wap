# A law run on values (wiki/law.md "Checking a law"): wap verify compiles each law the program states into a list of
# trials, one for each choice of its binders' values, every binder taking the values of its type
# (wap/extensions/law_runs.wap), and law_tried prints its verdict as wiki/proof.md writes it. The words are the rules',
# brought in unsaid where they write them (core/pipeline.wap standard_brought), so a program that runs no law carries
# none

# a whole number's values: the small ones, then the edges where arithmetic wraps; the first square past the largest
# int beside them
FIRST_SQUARE_PAST := 3037000500
# a float's values: zero, the units, fractions and large magnitudes
TRIED_FLOATS := [0.0, 1.0, -1.0, 0.5, -2.5, 1e100, -1e-100]
TRIED_TEXTS := ["", "a", "ab", "aβc", " "]

trial_values(): list<int> := [0, 1, -1, 2, -2, 10, -10, FIRST_SQUARE_PAST, -FIRST_SQUARE_PAST, LAST_INT, -LAST_INT - 1]
trial_values(): list<float> := TRIED_FLOATS
trial_values(): list<bool> := [no, yes]
trial_values(): list<text> := TRIED_TEXTS
# a list's values, built of its items' values: empty, one item, two, all of them backwards
trial_lists(items: list<T>): list<list<T>> := [[], items.take(1), items.take(2), items.reverse()]

# a law's statement computed on one choice of its binders' values, and those values as `x = 0`
class LawTrial { holds: bool; values: list<text> }
# TODO (card rule-written-class) the rules write LawTrial itself once a class a rule writes is brought in as a function is
law_trial(holds: bool, values: list<text>): LawTrial := LawTrial(holds, values)
# the binder's value as a trial shows it: `x = 0`, `t = "a"`
trial_shown(binder: text, value: T): text := "${binder} = ${show(value)}"
# Tested when every trial holds, FAILED with the first one that breaks, its values the counterexample
law_tried(name: text, trials: list<LawTrial>) := {
	broken = trials.find(trial => not trial.holds)
	print "${name}: " + (if broken is ø then "Tested" else if broken!.values is empty then "FAILED" else "FAILED, counterexample " + broken!.values.join(", "))
}
