# The logic a program gets by `use logic` (wiki/proposition.md, notes/coc-t6a6.md): the connectives as propositions of
# their own, and the one door the theory leaves open. True and False are the kernel's own words (kernel/logic.wap
# logic_declared), not declared again here: false_elim and negated speak of the same False programs write.

enum And(a: Prop, b: Prop): Prop { intro(left: a, right: b) }
enum Or(a: Prop, b: Prop): Prop { left(h: a); right(h: b) }
not(x: Prop): Prop := x -> False
# a proposition with its decision as data: a proof of it or a proof of its not
enum Decidable(p: Prop): Type { yes(h: p); no(h: not p) }
law and_swap(a: Prop, b: Prop, h: And(a, b)): And(b, a) := And.intro(h.right, h.left)
# two propositions that imply each other are equal: the only door of that kind, so every proof through it says so
axiom proposition_extensionality(a: Prop, b: Prop, ab: a -> b, ba: b -> a): a == b
# a bool read as the proposition that it is yes
holds(b: bool): Prop := b == yes
