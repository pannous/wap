# The standard module machine_math: the C library's sin, cos, exp, pow and atan2 as polynomials of plain wasm
# arithmetic, named fast_sin … fast_atan2, for hot loops such as shaders run on the CPU: 10^7 calls of sin or atan2
# take ~0.6 s through the C library, ~0.05 s so. Each takes and gives floats; the largest error against the C
# library, measured on 20001 points:
#   fast_sin, fast_cos   1e-11 for |x| ≤ 1000 (grows with |x|: the reduction by τ loses the digits of x / τ beyond 2^52)
#   fast_exp             8e-14 relative, from x = -700 to 700
#   fast_pow             1e-14 relative, base > 0; a negative base takes whole exponents only (others give nan)
#   fast_atan2           3e-12 radians

FULL_TURN := 2.0 * π
LN_2 := 0.6931471805599453
SQRT_2 := 1.4142135623730951
SQRT_3 := 1.7320508075688772
# tan(π/12): atan's argument is reduced below it
TAN_PI_12 := 0.2679491924311227
# past these e^x is infinite or 0
INFINITY := 1.0 / 0.0
LARGEST_EXP := 709.78
SMALLEST_EXP := -745.2
# the highest odd power of ln's atanh series
LN_SERIES_POWER := 31

# sin of x reduced to [-π/2, π/2]: its Taylor series to x^15, whose next term is below 1e-11 there
fast_sin(x: float): float := {
	r = x - float(round(x / FULL_TURN)) * FULL_TURN
	if r > π / 2.0 { r = π - r } else if r < -π / 2.0 { r = -π - r }
	s = r * r
	r * (1.0 + s * (-0.16666666666666666 + s * (0.008333333333333333 + s * (-0.0001984126984126984 + s * (2.7557319223985893e-06 + s * (-2.505210838544172e-08 + s * (1.6059043836821613e-10 + s * -7.647163731819816e-13)))))))
}
fast_cos(x: float): float := fast_sin(x + π / 2.0)
# e^x = 2^k · e^r with r in [-ln 2 / 2, ln 2 / 2]: the Taylor series of e^r to r^13, then 2^k by squaring halves
fast_exp(x: float): float := {
	if x > LARGEST_EXP { return INFINITY }
	if x < SMALLEST_EXP { return 0.0 }
	k = round(x / LN_2)
	r = x - float(k) * LN_2
	e = 1.0 + r * (1.0 + r * (0.5 + r * (0.16666666666666666 + r * (0.041666666666666664 + r * (0.008333333333333333 + r * (0.001388888888888889 + r * (0.0001984126984126984 + r * (2.48015873015873e-05 + r * (2.755731922398589e-06 + r * (2.755731922398589e-07 + r * (2.505210838544172e-08 + r * (2.08767569878681e-09 + r * 1.6059043836821613e-10))))))))))))
	e * two_to(float(k))
}
# 2^k of a whole k by repeated squaring, so 2^-1074 … 2^1023 stay in range
two_to(k: float): float := {
	result = 1.0
	base = if k < 0 then 0.5 else 2.0
	rest = trunc(abs(k))
	while rest > 0 {
		if rest % 2 == 1 { result = result * base }
		base = base * base
		rest = rest ÷ 2
	}
	result
}
# ln x (x > 0) = 2 atanh((m - 1) / (m + 1)) + e ln 2 for x = m · 2^e, m in [√½, √2): the atanh series to the 31st power
positive_ln(x: float): float := {
	if x <= 0.0 { return if x == 0.0 then -INFINITY else 0.0 / 0.0 }
	m = x
	e = 0
	while m >= SQRT_2 { m = m / 2.0; e += 1 }
	while m < SQRT_2 / 2.0 { m = m * 2.0; e -= 1 }
	t = (m - 1.0) / (m + 1.0)
	s = t * t
	sum = 0.0
	n = LN_SERIES_POWER
	while n > 0 {
		sum = sum * s + 1.0 / float(n)
		n -= 2
	}
	2.0 * t * sum + float(e) * LN_2
}
fast_pow(base: float, exponent: float): float := {
	if exponent == 0.0 { return 1.0 }
	if base > 0.0 { return fast_exp(exponent * positive_ln(base)) }
	if base == 0.0 { return if exponent > 0.0 then 0.0 else INFINITY }
	if exponent - floor(exponent) > 0.0 { return 0.0 / 0.0 }
	magnitude = fast_exp(exponent * positive_ln(-base))
	if trunc(exponent) % 2 == 0 then magnitude else -magnitude
}
# atan of t in [0, 1]: reduced to [0, tan π/12] by atan t = π/6 + atan((t√3 - 1) / (t + √3)), then its series to t^17
small_atan(t: float): float := {
	shifted = t > TAN_PI_12
	u = if shifted then (t * SQRT_3 - 1.0) / (t + SQRT_3) else t
	s = u * u
	a = u * (1.0 + s * (-0.3333333333333333 + s * (0.2 + s * (-0.14285714285714285 + s * (0.1111111111111111 + s * (-0.09090909090909091 + s * (0.07692307692307693 + s * (-0.06666666666666667 + s * 0.058823529411764705))))))))
	if shifted then a + π / 6.0 else a
}
# the angle of the point (x, y) from the x axis in (-π, π], y first as C's atan2
fast_atan2(y: float, x: float): float := {
	if x == 0.0 and y == 0.0 { return 0.0 }
	ay = abs(y)
	ax = abs(x)
	a = if ay <= ax then small_atan(ay / ax) else π / 2.0 - small_atan(ax / ay)
	if x < 0.0 { a = π - a }
	if y < 0.0 then -a else a
}
