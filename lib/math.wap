# The standard module math (wiki/math.md), in plain wap; for now its primes (wiki/library-primes.md): the primes up to
# a number, the next prime, prime factors; and the circle's functions: sine, cosine, their inverses, degrees, rounding.

# glyph pairs that bracket a number (wiki/operator.md): ‖-5‖ is 5, ⌊3.7⌋ is 3, ⌈3.2⌉ is 4, ⟦2.6⟧ is 3
circumfix operator ‖ ‖ := abs
circumfix operator ⌊ ⌋ := floor
circumfix operator ⌈ ⌉ := ceil
circumfix operator ⟦ ⟧ := round

# whether n is a prime: above 1, and no number from 2 up to its square root divides it
is_prime(n: int): bool := {
	if n < 2 { return no }
	divisor = 2
	while divisor * divisor <= n {
		if n % divisor == 0 { return no }
		divisor += 1
	}
	yes
}
# the primes up to and including n, by the sieve of Eratosthenes: primes(10) is [2, 3, 5, 7]
primes(n: int): list<int> := {
	composite: list<bool> = (0 to n).map(i => no)
	p = 2
	while p * p <= n {
		if not composite[p] {
			multiple = p * p
			while multiple <= n {
				composite[multiple] = yes
				multiple += p
			}
		}
		p += 1
	}
	(2 to n).filter(i => not composite[i])
}
# the smallest prime above n: next_prime(7) is 11
next_prime(n: int): int := {
	candidate = max(n + 1, 2)
	while not is_prime(candidate) { candidate += 1 }
	candidate
}
# the primes whose product is n, smallest first, each as often as it divides n: prime_factors(12) is [2, 2, 3]
prime_factors(n: int): list<int> := {
	factors: list<int> = []
	rest = n
	divisor = 2
	while divisor * divisor <= rest {
		while rest % divisor == 0 {
			factors.add(divisor)
			rest = rest ÷ divisor
		}
		divisor += 1
	}
	if rest > 1 { factors.add(rest) }
	factors
}

π := 3.141592653589793
pi := π
HALF_PI := 1.5707963267948966
QUARTER_PI := 0.7853981633974483
# tan(π/8): above it atan turns its argument toward 0 by atan(x) = π/4 + atan((x - 1) / (x + 1))
TAN_EIGHTH_PI := 0.41421356237309503

# the sum of a series from its first term, each next term made from the one before and its number 1, 2, …; summed
# until a term no longer changes the sum
series_sum(first: float, next: (float, int) -> float): float := {
	sum = first
	term = first
	k = 1
	while sum + next(term, k) != sum {
		term = next(term, k)
		sum += term
		k += 1
	}
	sum
}
# sine and cosine near 0, |r| ≤ π/4, by their Taylor series
sine_series(r: float): float := series_sum(r, (term, k) => -term * r * r / ((2 * k) * (2 * k + 1)))
cosine_series(r: float): float := series_sum(1.0, (term, k) => -term * r * r / ((2 * k - 1) * (2 * k)))
# sin(x + quarters · π/2): x brought within π/4 of a multiple of π/2, then the series of that quarter
sine_turned(x: float, quarters: int): float := {
	nearest = round(x / HALF_PI)
	r = x - nearest * HALF_PI
	turn = (nearest + quarters) % 4
	if turn == 0 then sine_series(r) else if turn == 1 then cosine_series(r) else if turn == 2 then -sine_series(r) else -cosine_series(r)
}
sin(x: float): float := sine_turned(x, 0)
cos(x: float): float := sine_turned(x, 1)
tan(x: float): float := sin(x) / cos(x)

# the arc tangent in radians, -π/2 … π/2: turned toward 0, then its series
atan(x: float): float := {
	if x < 0 then -atan(-x)
	else if x > 1 then HALF_PI - atan(1 / x)
	else if x > TAN_EIGHTH_PI then QUARTER_PI + atan((x - 1) / (x + 1))
	else series_sum(x, (term, k) => -term * x * x * (2 * k - 1) / (2 * k + 1))
}
# the angle of the point (x, y) from the x axis, -π … π
atan2(y: float, x: float): float := {
	if x > 0 then atan(y / x)
	else if x < 0 then atan(y / x) + (if y >= 0 then π else -π)
	else if y > 0 then HALF_PI
	else if y < 0 then -HALF_PI
	else 0.0
}
asin(x: float): float := atan2(x, sqrt(1 - x * x))
acos(x: float): float := atan2(sqrt(1 - x * x), x)

LN2 := 0.6931471805599453
two_to(k: int): float := if k >= 0 then 2.0 ^ k else 1 / 2.0 ^ (0 - k)
# e^x: x = k·ln 2 + r with |r| ≤ ln 2 / 2, so e^x = 2^k · e^r, e^r by its series
exp(x: float): float := {
	k = round(x / LN2)
	r = x - k * LN2
	series_sum(1.0, (term, n) => term * r / n) * two_to(k)
}
# the natural logarithm of a positive x: x = m·2^k with 1 ≤ m < 2, ln m = 2·atanh((m - 1) / (m + 1)) by its series
log(x: float): float := {
	if x <= 0 { raise "log of ${x}: only positive numbers have a logarithm" }
	k = 0
	m = x
	while m >= 2 {
		m = m / 2
		k += 1
	}
	while m < 1 {
		m = m * 2
		k -= 1
	}
	s = (m - 1) / (m + 1)
	2 * series_sum(s, (term, n) => term * s * s * (2 * n - 1) / (2 * n + 1)) + k * LN2
}
sinh(x: float): float := (exp(x) - exp(-x)) / 2
cosh(x: float): float := (exp(x) + exp(-x)) / 2

to_radians(degrees: float): float := degrees * π / 180
to_degrees(radians: float): float := radians * 180 / π
# x rounded to some places after the point, a half away from zero: `round_to(2.345, 2)` is 2.35. Of x's two
# neighbours on that grid the nearer one wins, measured against x itself: x * 100 is 234.49999999999997
# (the types module's own once function.md's types patch lands; this one goes then)
round_to(x: float, places: int): float := if x < 0 then 0.0 - round_to(0.0 - x, places) else nearest_on_grid(x, 10.0 ^ places)
nearest_on_grid(x: float, scale: float): float := {
	steps = floor(x * scale)
	below = steps / scale
	above = (steps + 1.0) / scale
	if above - x <= x - below then above else below
}
