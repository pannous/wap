# The standard module math (wiki/math.md, wiki/standard-library.md "math"), in plain wap: whole numbers (gcd, digits,
# bases, bits, divisors), the primes (wiki/library-primes.md): the primes up to a number, the next prime, prime factors;
# the circle's functions: sine, cosine, their inverses, degrees, rounding; and the long names of the C words
# (square_root for sqrt).

# glyph pairs that bracket a number (wiki/operator.md): ‖-5‖ is 5, ⌊3.7⌋ is 3, ⌈3.2⌉ is 4, ⟦2.6⟧ is 3
circumfix operator ‖ ‖ := abs
circumfix operator ⌊ ⌋ := floor
circumfix operator ⌈ ⌉ := ceil
circumfix operator ⟦ ⟧ := round

# whether n is a prime: above 1, and no number from 2 up to its square root divides it
is_prime(n: int): bool := {
	if n < 2 { return no }
	divisor = 2
	while divisor * divisor <= n {
		if n % divisor == 0 { return no }
		divisor += 1
	}
	yes
}
# the primes up to and including n, by the sieve of Eratosthenes: primes(10) is [2, 3, 5, 7]
primes(n: int): list<int> := {
	composite: list<bool> = (0 to n).map(i => no)
	p = 2
	while p * p <= n {
		if not composite[p] {
			multiple = p * p
			while multiple <= n {
				composite[multiple] = yes
				multiple += p
			}
		}
		p += 1
	}
	(2 to n).filter(i => not composite[i])
}
# the smallest prime above n: next_prime(7) is 11
next_prime(n: int): int := {
	candidate = max(n + 1, 2)
	while not is_prime(candidate) { candidate += 1 }
	candidate
}
# the primes whose product is n, smallest first, each as often as it divides n: prime_factors(12) is [2, 2, 3]
prime_factors(n: int): list<int> := {
	factors: list<int> = []
	rest = n
	divisor = 2
	while divisor * divisor <= rest {
		while rest % divisor == 0 {
			factors.add(divisor)
			rest = rest ÷ divisor
		}
		divisor += 1
	}
	if rest > 1 { factors.add(rest) }
	factors
}

# the arc tangent in radians, -π/2 … π/2: turned toward 0, then its series
atan(x: float): float := {
	if x < 0 then -atan(-x)
	else if x > 1 then HALF_PI - atan(1 / x)
	else if x > TAN_EIGHTH_PI then QUARTER_PI + atan((x - 1) / (x + 1))
	else series_sum(x, (term, k) => -term * x * x * (2 * k - 1) / (2 * k + 1))
}
# the angle of the point (x, y) from the x axis, -π … π
atan2(y: float, x: float): float := {
	if x > 0 then atan(y / x)
	else if x < 0 then atan(y / x) + (if y >= 0 then π else -π)
	else if y > 0 then HALF_PI
	else if y < 0 then -HALF_PI
	else 0.0
}
asin(x: float): float := atan2(x, sqrt(1 - x * x))
acos(x: float): float := atan2(sqrt(1 - x * x), x)

to_radians(degrees: float): float := degrees * π / 180
to_degrees(radians: float): float := radians * 180 / π

# --- whole numbers

# the digits of the bases up to 36
BASE_DIGITS := "0123456789abcdefghijklmnopqrstuvwxyz"
gcd(a: int, b: int): int := if b == 0 then abs(a) else gcd(b, a % b)
lcm(a: int, b: int): int := if a == 0 or b == 0 then 0 else abs(a ÷ gcd(a, b) * b)
factorial(n: int): int := (1 upto n + 1).fold(1, (product, k) => product * k)
# the ways to choose k of n, each step's product whole
choose(n: int, k: int): int := (0 upto k).fold(1, (ways, i) => ways * (n - i) ÷ (i + 1))
is_even(n: int): bool := n % 2 == 0
is_odd(n: int): bool := n % 2 == 1
# the decimal digits: digits(1234) is [1, 2, 3, 4]
digits(n: int): list<int> := "${abs(n)}".bytes.map(b => b - ZERO_BYTE)
# base^exponent % modulus, squaring as the exponent halves
mod_pow(base: int, exponent: int, modulus: int): int := {
	result = 1
	b = base % modulus
	e = exponent
	while e > 0 {
		if e % 2 == 1 { result = result * b % modulus }
		b = b * b % modulus
		e = e ÷ 2
	}
	result
}
# the whole square root, rounded down, by Newton's steps
isqrt(n: int): int := {
	if n < 0 { raise "isqrt of ${n}: a negative number has no square root" }
	x = n
	y = (x + 1) ÷ 2
	while y < x {
		x = y
		y = (x + n ÷ x) ÷ 2
	}
	x
}
is_square(n: int): bool := n >= 0 and isqrt(n) * isqrt(n) == n
divisors(n: int): list<int> := (1 upto n + 1).filter(d => n % d == 0)
to_base(n: int, base: int): text := {
	if n < 0 { return "-" + to_base(-n, base) }
	if n < base then BASE_DIGITS[n:n + 1] else to_base(n ÷ base, base) + BASE_DIGITS[n % base:n % base + 1]
}
from_base(t: text, base: int): int := ascii_lower(t).bytes.fold(0, (n, b) => n * base + find(BASE_DIGITS, byte_text(b)) - 1)
bit_count(n: int): int := {
	if n < 0 { raise "bit_count of ${n}: only whole numbers ≥ 0 count their bits" }
	if n == 0 then 0 else n % 2 + bit_count(n ÷ 2)
}
bit_and(a: int, b: int): int := a & b
bit_or(a: int, b: int): int := a | b

# --- numbers

clamp(x: T, low: T, high: T): T := min(max(x, low), high)
sign(x: float): int := if x > 0 then 1 else if x < 0 then -1 else 0
round(x: float, decimals: int): float := round_to(x, decimals)
lerp(a: float, b: float, t: float): float := a + (b - a) * t
# the part of x after its floor, GLSL's fract: fract(2.25) is 0.25, fract(-0.25) is 0.75
fract(x: float): float := x - floor(x)
percent(part: float, whole: float): float := part * 100 / whole
whole_part(x: float): int := trunc(x)
# what remains of a after taking out b as often as it fits, with the sign of a (C's fmod)
remainder(a: float, b: float): float := a - b * trunc(a / b)
tanh(x: float): float := sinh(x) / cosh(x)
cbrt(x: float): float := if x == 0 then 0.0 else sign(x) * exp(log(abs(x)) / 3)
hypotenuse(a: float, b: float): float := sqrt(a * a + b * b)
# the angle of the point (x, y) from the x axis, in radians
angle(x: float, y: float): float := atan2(y, x)

# --- the long names of the C words
square(x: float): float := x * x
square_root(x: float): float := sqrt(x)
cube_root(x: float): float := cbrt(x)
# a whole exponent multiplies, any other goes through the logarithm
power(base: float, exponent: float): float := if exponent == trunc(exponent) then base ^ trunc(exponent) else exp(exponent * log(base))
exponential(x: float): float := exp(x)
natural_log(x: float): float := log(x)
binary_log(x: float): float := log(x) / LN2
decimal_log(x: float): float := logarithm(x, 10)
logarithm(x: float, base: float): float := log(x) / log(base)
sine(x: float): float := sin(x)
cosine(x: float): float := cos(x)
tangent(x: float): float := tan(x)
arc_sine(x: float): float := asin(x)
arc_cosine(x: float): float := acos(x)
arc_tangent(x: float): float := atan(x)
arcsin(x: float): float := asin(x)
arccos(x: float): float := acos(x)
arctan(x: float): float := atan(x)
hyperbolic_sine(x: float): float := sinh(x)
hyperbolic_cosine(x: float): float := cosh(x)
hyperbolic_tangent(x: float): float := tanh(x)
ceiling(x: float): float := ceil(x)
