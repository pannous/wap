# The standard module matrix (wiki/library-matrix.md), in plain wap: a matrix is the list of its rows. Linear systems,
# inverses and determinants by one Gauss-Jordan elimination with partial pivoting; a singular matrix is refused where
# a solution is asked for.

# how near 0 a pivot counts as 0, the matrix singular
SINGULAR := 0.000000000001

transpose(m: list<list<float>>): list<list<float>> := (0 upto #m[0]).map(j => m.map(row => row[j]))
matmul(a: list<list<float>>, b: list<list<float>>): list<list<float>> := {
	columns = transpose(b)
	a.map(row => columns.map(column => (0 upto #row).map(k => row[k] * column[k]).sum))
}
identity(n: int): list<list<float>> := (0 upto n).map(i => (0 upto n).map(j => if i == j then 1.0 else 0.0))

# a square matrix reduced to the identity beside the columns of extra: the matrix's determinant and extra turned into
# a⁻¹·extra; a singular matrix has determinant 0 and no solved columns (ø)
class Elimination { determinant: float, solved: list<list<float>>? }
eliminated(a: list<list<float>>, extra: list<list<float>>): Elimination := {
	n = #a
	rows = (0 upto n).map(i => a[i] + extra[i])
	sign_and_pivots = 1.0
	for column in 0 upto n {
		pivot = (column upto n).fold(column, (best, i) => if abs(rows[i][column]) > abs(rows[best][column]) then i else best)
		if abs(rows[pivot][column]) < SINGULAR { return Elimination(0.0, ø) }
		if pivot != column {
			swapped = rows[pivot]
			rows[pivot] = rows[column]
			rows[column] = swapped
			sign_and_pivots = -sign_and_pivots
		}
		lead = rows[column][column]
		sign_and_pivots = sign_and_pivots * lead
		rows[column] = rows[column].map(x => x / lead)
		for i in 0 upto n {
			factor = rows[i][column]
			if i != column and factor != 0 { rows[i] = (0 upto #rows[i]).map(k => rows[i][k] - factor * rows[column][k]) }
		}
	}
	Elimination(sign_and_pivots, rows.map(row => row.drop(n)))
}
# the columns of extra turned into a⁻¹·extra, refused for a singular a
solved_columns(a: list<list<float>>, extra: list<list<float>>, what: text): list<list<float>> := {
	elimination = eliminated(a, extra)
	if elimination.solved == ø { raise "${what}: the matrix is singular (its determinant is 0)" }
	elimination.solved
}

determinant(a: list<list<float>>): float := eliminated(a, a.map(row => row.take(0))).determinant
# the matrix's inverse, refused for a singular one
inverse(a: list<list<float>>): list<list<float>> := solved_columns(a, identity(#a), "inverse")
# x with a·x = b, refused for a singular a
solve(a: list<list<float>>, b: list<float>): list<float> := solved_columns(a, b.map(value => [value]), "solve").map(row => row[0])
