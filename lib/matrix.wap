# The standard module matrix (wiki/library-matrix.md), in plain wap; for now what numeric's polyfit needs: a matrix
# is the list of its rows.

transpose(m: list<list<float>>): list<list<float>> := (0 upto #m[0]).map(j => m.map(row => row[j]))
matmul(a: list<list<float>>, b: list<list<float>>): list<list<float>> := {
	columns = transpose(b)
	a.map(row => columns.map(column => (0 upto #row).map(k => row[k] * column[k]).sum))
}
# x with a·x = b, by Gauss-Jordan elimination: each column's largest pivot brought up, its row scaled to 1 and taken
# out of every other row; a singular matrix is refused
solve(a: list<list<float>>, b: list<float>): list<float> := {
	n = #a
	rows = (0 upto n).map(i => a[i] + [b[i]])
	for column in 0 upto n {
		pivot = (column upto n).fold(column, (best, i) => if abs(rows[i][column]) > abs(rows[best][column]) then i else best)
		if rows[pivot][column] == 0 { raise "solve: the matrix is singular, the system has no single solution" }
		swapped = rows[pivot]
		rows[pivot] = rows[column]
		rows[column] = swapped.map(x => x / swapped[column])
		for i in 0 upto n {
			if i != column {
				factor = rows[i][column]
				rows[i] = (0 upto n + 1).map(k => rows[i][k] - factor * rows[column][k])
			}
		}
	}
	rows.map(row => row[n])
}
