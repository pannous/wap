# The standard module memory: linear memory by its bytes (samples/wasm/wasm_interop.wap). `memory.slice(at, end)` reads
# the bytes at…end-1, `memory.copy(bytes, at)` writes them from at on; addresses are byte offsets from 0

# todo (card wasm-peek-poke) Expose basic WASM primitives as small built-in functions peek poke

use "../types/host.wap"

slice(start: int, end: int): list<int> := (start upto end).map(address => memory_byte(address))
# the bytes written from `at` on, their count given back
copy(bytes: list<int>, at: int): int := {
	for i in 0 upto #bytes { set_memory_byte(at + i, bytes[i]) }
	#bytes
}
