# The standard module meshlets: clusters of triangles, a coarser regular grid, and which clusters a camera keeps.
# This is not Nanite and not the three.js meshlet renderer: there is no cluster hierarchy, no streaming, and no GPU
# draw. The cone test follows meshoptimizer's published bounds (MIT, Arseny Kapoulkine) as three.js uses it in
# MeshletDrawingPipeline (MIT); the code here is new. Coarsening is only a stride-2 heightfield (notes/meshlets.md).
# A point is [x, y, z], a triangle three points; a plane is [nx, ny, nz, d], inside where n·p + d >= 0; a place is
# [x, z, yaw, scale]: a point p of a tree becomes (x, 0, z) + scale · R(yaw) · p, world y up.
use bits
use file
use geometry
use math

TREE_MESH_SOURCE := "the EZ Tree meshes are fetched by scripts/sample-assets.sh fetch, or generated by node scripts/ez_tree/export.mjs, hero.mjs and python3 scripts/ez_tree/atlas.py (samples/graphics/ez_trees/NOTICE.md)"
MESHLET_TRIANGLES := 64
# meshoptimizer drops a cone once it is about 168 degrees wide (min dot at most 0.1). Wider than that, or any
# degenerate triangle, and the cluster stays: a cull would not be true of every triangle
CONE_MIN_DOT := 0.1
MESHLET_EPSILON := 0.000000001
# a cone that never culls; a place that leaves a cluster where it is
IDLE_AXIS := [0.0, 0.0, 1.0]
NOT_CULLED := 1.0
UNMOVED := [0.0, 0.0, 0.0, 1.0]

class Sphere { center: list<float>, radius: float }
class Cone { axis: list<float>, cutoff: float, cullable: bool }
# `at` is the cluster's first triangle in the mesh level, so a draw can name the range without copying it
class Cluster { triangles: list<list<list<float>>>, sphere: Sphere, cone: Cone, at: int }
class MeshLevel { triangles: list<list<list<float>>>, clusters: list<Cluster>, error: float }
# a tree mesh read from an .eztree file: its levels, each the point soup MeshLevel plus the vertices and indexed
# triangles the GPU draws; base and vertex_at are where pack_tree_meshes put them (-1 before)
class TreeLevel { mesh: MeshLevel, vertices: list<list<float>>, indices: list<list<int>>, base: int, vertex_at: int }
class TreeMesh { levels: list<TreeLevel> }
# a mesh as its vertices and a triangle index list, three indices a triangle
class IndexedMesh { vertices: list<list<float>>, indices: list<int> }
class MeshPack { vertices: list<list<float>>, texels: list<list<float>>, triangles: list<list<int>> }

# --- the grid: (cells_x + 1) · (cells_y + 1) heights, row by row
grid_checked(cells_x: int, cells_y: int, heights: list<float>) := {
	if cells_x < 2 or cells_y < 2 or cells_x % 2 != 0 or cells_y % 2 != 0 { raise "meshlets: a grid needs even cell counts of at least 2, not ${cells_x} by ${cells_y}" }
	wanted = (cells_x + 1) * (cells_y + 1)
	if #heights != wanted { raise "meshlets: a ${cells_x} by ${cells_y} grid needs ${wanted} heights, not ${#heights}" }
}
grid_height(cells_x: int, heights: list<float>, i: int, j: int): float := heights[j * (cells_x + 1) + i]
grid_vertex(cells_x: int, heights: list<float>, i: int, j: int): list<float> := [float(i), float(j), grid_height(cells_x, heights, i, j)]

# the grid's triangles at a stride: both triangles of a cell wind counter-clockwise seen from +z, so a flat grid faces up
grid_cells(cells_x: int, cells_y: int, heights: list<float>, step: int): list<list<list<float>>> := [cell_triangle for j in (0 .. cells_y /! step).map(k => k * step) for i in (0 .. cells_x /! step).map(k => k * step) for cell_triangle in cell_triangles(cells_x, heights, i, j, step)]
cell_triangles(cells_x: int, heights: list<float>, i: int, j: int, step: int): list<list<list<float>>> := {
	a = grid_vertex(cells_x, heights, i, j)
	b = grid_vertex(cells_x, heights, i + step, j)
	d = grid_vertex(cells_x, heights, i + step, j + step)
	c = grid_vertex(cells_x, heights, i, j + step)
	[[a, b, d], [a, d, c]]
}

# the height of the coarse triangulation at a fine vertex. Even vertices are kept, so their error is zero; an odd
# vertex reads the coarse cell that holds it, on the far edge the cell before it
coarse_height(cells_x: int, cells_y: int, heights: list<float>, i: int, j: int): float := {
	if i % 2 == 0 and j % 2 == 0 { return grid_height(cells_x, heights, i, j) }
	i0 = if i == cells_x then i - 2 else i - i % 2
	j0 = if j == cells_y then j - 2 else j - j % 2
	u = (i - i0) / 2.0
	v = (j - j0) / 2.0
	za = grid_height(cells_x, heights, i0, j0)
	zb = grid_height(cells_x, heights, i0 + 2, j0)
	zc = grid_height(cells_x, heights, i0, j0 + 2)
	zd = grid_height(cells_x, heights, i0 + 2, j0 + 2)
	if u >= v then (1.0 - u) * za + (u - v) * zb + v * zd else (1.0 - v) * za + (v - u) * zc + u * zd
}
# the largest vertical gap between the fine grid and the coarse one
grid_error(cells_x: int, cells_y: int, heights: list<float>): float := [abs(grid_height(cells_x, heights, i, j) - coarse_height(cells_x, cells_y, heights, i, j)) for j in 0 .. cells_y + 1 for i in 0 .. cells_x + 1].max

flat_heights(cells_x: int, cells_y: int): list<float> := {
	heights = [0.0 for i in 0 .. (cells_x + 1) * (cells_y + 1)]
	grid_checked(cells_x, cells_y, heights)
	heights
}
grid_triangles(cells_x: int, cells_y: int, heights: list<float>): list<list<list<float>>> := {
	grid_checked(cells_x, cells_y, heights)
	grid_cells(cells_x, cells_y, heights, 1)
}
# the fine grid as vertices and a triangle index list, three indices a triangle, the triangles of grid_triangles
grid_indexed(cells_x: int, cells_y: int, heights: list<float>): IndexedMesh := {
	grid_checked(cells_x, cells_y, heights)
	span = cells_x + 1
	vertices = [grid_vertex(cells_x, heights, i, j) for j in 0 .. cells_y + 1 for i in 0 .. cells_x + 1]
	indices = [index for j in 0 .. cells_y for i in 0 .. cells_x for index in cell_indices(j * span + i, span)]
	IndexedMesh(vertices, indices)
}
cell_indices(a: int, span: int): list<int> := [a, a + 1, a + span + 1, a, a + span + 1, a + span]
# level 0 is the grid, level 1 keeps every other vertex and records the largest vertical gap
grid_levels(cells_x: int, cells_y: int, heights: list<float>): list<MeshLevel> := {
	grid_checked(cells_x, cells_y, heights)
	fine = grid_cells(cells_x, cells_y, heights, 1)
	coarse = grid_cells(cells_x, cells_y, heights, 2)
	[MeshLevel(fine, cluster_triangles(fine), 0.0), MeshLevel(coarse, cluster_triangles(coarse), grid_error(cells_x, cells_y, heights))]
}

# --- clusters
point_checked(p: list<float>) := { if #p != 3 { raise "meshlets needs 3D points, not ${p}" } }

# the sphere of the axis-aligned box: larger than the smallest sphere, and still holding every vertex
sphere_of(points: list<list<float>>): Sphere := {
	box = bounding_box(points)
	center = [(box[0][k] + box[1][k]) / 2.0 for k in 0 .. 3]
	Sphere(center, points.map(p => geo_distance(center, p)).max)
}

# no cull when a triangle has no area, the normals cancel, or the cone is wider than CONE_MIN_DOT. The cutoff is the
# sine of the half-angle, and NOT_CULLED means "do not cull"
cone_of(triangles: list<list<list<float>>>): Cone := {
	edges = triangles.map(t => vec_cross(vec_sub(t[1], t[0]), vec_sub(t[2], t[0])))
	idle = Cone(IDLE_AXIS, NOT_CULLED, no)
	if #edges == 0 or edges.any(edge => vec_norm(edge) <= MESHLET_EPSILON) { return idle }
	normals = edges.map(vec_unit)
	total = normals.fold([0.0, 0.0, 0.0], vec_add)
	if vec_norm(total) <= MESHLET_EPSILON { return idle }
	axis = vec_unit(total)
	least = min(normals.map(n => vec_dot(n, axis)).min, 1.0)
	if least <= CONE_MIN_DOT { return Cone(axis, NOT_CULLED, no) }
	Cone(axis, sqrt(1.0 - least * least), yes)
}

cluster_of(triangles: list<list<list<float>>>, at: int): Cluster := Cluster(triangles, sphere_of(triangles.flat_map(t => t)), cone_of(triangles), at)

# consecutive triangles, MESHLET_TRIANGLES to a cluster: not a spatial partition
cluster_triangles(triangles: list<list<list<float>>>): list<Cluster> := {
	for t in triangles {
		if #t != 3 { raise "meshlets needs a triangle of 3 points, not ${t}" }
		for p in t { point_checked(p) }
	}
	starts = (0 .. (#triangles + MESHLET_TRIANGLES - 1) /! MESHLET_TRIANGLES).map(k => k * MESHLET_TRIANGLES)
	starts.map(at => cluster_of(triangles[at .. min(at + MESHLET_TRIANGLES, #triangles)], at))
}

# triangle records [a, b, c, …] as the flat index buffer a hardware draw reads: the part and anything after c stay out
mesh_draw_indices(indices: list<list<int>>): list<int> := {
	for triangle in indices { if #triangle < 3 { raise "meshlets: an index triple is three numbers, not ${triangle}" } }
	if #indices == 0 { raise "meshlets: indices are empty" }
	indices.flat_map(triangle => triangle[0 .. 3])
}

# frames a second from a counted run (the samples print it when launched with `fps`)
frame_rate(frames: int, spent_ms: float): float := {
	if frames <= 0 { raise "meshlets: frames must be a positive int, not ${frames}" }
	if spent_ms <= 0 { raise "meshlets: the measured time must be positive, not ${spent_ms}" }
	frames * 1000.0 / spent_ms
}

# --- levels of detail
error_checked(error: float) := { if error < 0 { raise "meshlets: error must not be negative, not ${error}" } }
# errors grow from the finest level to the coarsest
errors_checked(errors: list<float>) := {
	if #errors == 0 { raise "meshlets: levels must be a non-empty list" }
	for k in 0 .. #errors {
		error_checked(errors[k])
		if k > 0 and errors[k] < errors[k - 1] { raise "meshlets: level errors must not decrease" }
	}
}

# perspective pixels: error / distance · cot(half fov) · screen height / 2
projected_error(error: float, distance: float, cot_half_fov: float, screen_height: float): float := {
	error_checked(error)
	if distance <= 0 { raise "meshlets: distance must be positive, not ${distance}" }
	if cot_half_fov < 0 or screen_height < 0 { raise "meshlets: cot(half fov) and screen height must not be negative, not ${cot_half_fov} and ${screen_height}" }
	error / distance * cot_half_fov * screen_height / 2.0
}

# the last level whose projected error is within the threshold, counted from 1, the finest; 0 when none is
level_within(errors: list<float>, distance: float, cot_half_fov: float, screen_height: float, threshold: float): int := {
	errors_checked(errors)
	if threshold < 0 { raise "meshlets: threshold must not be negative, not ${threshold}" }
	within = (0 .. #errors).filter(k => projected_error(errors[k], distance, cot_half_fov, screen_height) <= threshold)
	if #within == 0 then 0 else within.max + 1
}
lod_picked(errors: list<float>, distance: float, cot_half_fov: float, screen_height: float, threshold: float): int := {
	picked = level_within(errors, distance, cot_half_fov, screen_height, threshold)
	if picked == 0 { raise "meshlets: no level is within the error threshold" }
	picked
}
chosen_level(levels: list<MeshLevel>, distance: float, cot_half_fov: float, screen_height: float, threshold: float): int := lod_picked(levels.map(level => level.error), distance, cot_half_fov, screen_height, threshold)

# --- culling
plane_checked(plane: list<float>) := { if #plane != 4 { raise "meshlets: a plane is nx, ny, nz, d, not ${plane}" } }

# inside every plane: a sphere that only touches a plane stays inside
sphere_inside(sphere: Sphere, planes: list<list<float>>): bool := planes.all(plane => {
	plane_checked(plane)
	vec_dot(plane[0 .. 3], sphere.center) + plane[3] >= -sphere.radius
})

# strict: a sphere that only touches the back cone stays visible
cone_faces_away(cone: Cone, sphere: Sphere, camera: list<float>): bool := {
	if not cone.cullable { return no }
	to_center = vec_sub(sphere.center, camera)
	apart = vec_norm(to_center)
	apart != 0 and vec_dot(to_center, cone.axis) > cone.cutoff * apart + sphere.radius
}
kept_by(sphere: Sphere, cone: Cone, planes: list<list<float>>, camera: list<float>): bool := sphere_inside(sphere, planes) and not cone_faces_away(cone, sphere, camera)

visible_clusters(clusters: list<Cluster>, planes: list<list<float>>, camera: list<float>): list<Cluster> := {
	point_checked(camera)
	clusters.filter(cluster => kept_by(cluster.sphere, cluster.cone, planes, camera))
}
triangle_count(clusters: list<Cluster>): int := clusters.map(cluster => #cluster.triangles).sum()

# --- placed trees
place_checked(place: list<float>) := {
	if #place != 4 { raise "meshlets: a place is x, z, yaw, scale, not ${place}" }
	if place[3] <= 0 { raise "meshlets: scale must be positive, not ${place[3]}" }
}
yaw_into(v: list<float>, yaw: float): list<float> := [cos(yaw) * v[0] + sin(yaw) * v[2], v[1], -sin(yaw) * v[0] + cos(yaw) * v[2]]

# the planes and the camera moved into the tree's own frame, so the shared clusters are culled where they stand:
# [planes, camera]
local_view(planes: list<list<float>>, camera: list<float>, place: list<float>): list<any> := {
	place_checked(place)
	point_checked(camera)
	origin = [place[0], 0.0, place[1]]
	local_camera = vec_scale(yaw_into(vec_sub(camera, origin), place[2]), 1.0 / place[3])
	local_planes = planes.map(plane => {
		plane_checked(plane)
		normal = plane[0 .. 3]
		yaw_into(normal, place[2]) + [(vec_dot(normal, origin) + plane[3]) / place[3]]
	})
	[local_planes, local_camera]
}

# a tree's point in the world: yaw turns it the other way from local_view
placed_point(point: list<float>, place: list<float>): list<float> := {
	place_checked(place)
	point_checked(point)
	turned = yaw_into(vec_scale(point, place[3]), -place[2])
	[turned[0] + place[0], turned[1], turned[2] + place[1]]
}
# a cluster's sphere [x, y, z, radius] and cone [axis, cutoff] where the place puts it
placed_sphere(cluster: Cluster, place: list<float>): Sphere := Sphere(placed_point(cluster.sphere.center, place), cluster.sphere.radius * place[3])
placed_cone(cluster: Cluster, place: list<float>): Cone := Cone(yaw_into(cluster.cone.axis, -place[2]), cluster.cone.cutoff, cluster.cone.cullable)
placed_bounds(cluster: Cluster, place: list<float>): list<float> := {
	sphere = placed_sphere(cluster, place)
	sphere.center + [sphere.radius]
}
placed_cone_row(cluster: Cluster, place: list<float>): list<float> := placed_cone(cluster, place).axis + [cluster.cone.cutoff]

# one vec4 a cluster: first index, index count (three a triangle), then two zeros
cluster_ranges(clusters: list<Cluster>): list<list<float>> := clusters.map(cluster => [float(cluster.at * 3), float(#cluster.triangles * 3), 0.0, 0.0])
cluster_bounds(clusters: list<Cluster>): list<list<float>> := clusters.map(cluster => placed_bounds(cluster, UNMOVED))
cluster_cones(clusters: list<Cluster>): list<list<float>> := clusters.map(cluster => placed_cone_row(cluster, UNMOVED))

# how many clusters stay, tested where they stand: the GPU cull uses the same sphere and the stored cutoff
placed_visible(clusters: list<Cluster>, planes: list<list<float>>, camera: list<float>, place: list<float>): int := {
	point_checked(camera)
	#clusters.filter(cluster => kept_by(placed_sphere(cluster, place), placed_cone(cluster, place), planes, camera))
}

# --- the GPU cull, its WGSL written here. Cone test: meshoptimizer (MIT, Arseny Kapoulkine); indirect words: the shape
# of three.js PR 35191 (MIT). A cutoff of 1 means do not cull, as cone_of keeps it.
# view[0] is the camera, its w the sprite count of an instanced grove; view[1] the LOD parameters: cot(half fov), screen
# height, threshold and the plane count; the planes start at view[2], view[1].w of them
CULL_FN := "
fn sphere_out(center: vec3f, radius: f32) -> bool {
	let count = u32(view[1].w);
	for (var p = 0u; p < count; p++) {
		let plane = view[2u + p];
		if (dot(plane.xyz, center) + plane.w < -radius) { return true; }
	}
	return false;
}
fn cone_away(center: vec3f, radius: f32, cone: vec4f) -> bool {
	if (cone.w >= 1.0) { return false; }
	let away = center - view[0].xyz;
	let apart = length(away);
	if (apart == 0.0) { return false; }
	return dot(away, cone.xyz) > cone.w * apart + radius;
}
fn cluster_kept(i: u32) -> bool {
	let bound = bounds[i];
	return !sphere_out(bound.xyz, bound.w) && !cone_away(bound.xyz, bound.w, cones[i]);
}
"
# the least max-depth of the 8 by 8 tiles the pixel rect covers; 1 means do not cull
OCCLUDE_FN := "
fn occluder(px: f32, py: f32, radius: f32, width: f32, height: f32) -> f32 {
	let tiles_x = u32(ceil(width / 8.0));
	let tiles_y = u32(ceil(height / 8.0));
	let x0 = i32(floor((px - radius) / 8.0));
	let x1 = i32(floor((px + radius) / 8.0));
	let y0 = i32(floor((py - radius) / 8.0));
	let y1 = i32(floor((py + radius) / 8.0));
	var nearest = 1.0;
	var any = false;
	for (var y = y0; y <= y1; y++) {
		if (y < 0 || u32(y) >= tiles_y) { continue; }
		for (var x = x0; x <= x1; x++) {
			if (x < 0 || u32(x) >= tiles_x) { continue; }
			any = true;
			let d = pyramid[u32(y) * tiles_x + u32(x)];
			if (d < nearest) { nearest = d; }
		}
	}
	if (!any) { return 1.0; }
	return nearest;
}
"
LOD_FN := "
fn projected(error: f32, distance: f32) -> f32 {
	return error / distance * view[1].x * view[1].y * 0.5;
}
fn level_from_view(at: u32, count: u32, distance: f32) -> u32 {
	var picked = 0u;
	for (var i = 0u; i < count; i++) {
		if (projected(view[at + i].z, distance) <= view[1].z) { picked = i + 1u; }
	}
	return picked;
}
"
LODS_FN := "
fn level_picked(first: u32, count: u32, distance: f32) -> u32 {
	var picked = 0u;
	for (var i = 0u; i < count; i++) {
		if (projected(lods[first + i].z, distance) <= view[1].z) { picked = i + 1u; }
	}
	return picked;
}
"
# the bindings of a cull that writes an index list, and the indices of its kept clusters copied, and its draw words
INDEX_BINDINGS := "
@binding(0) @group(0) var<storage, read> bounds: array<vec4f>;
@binding(1) @group(0) var<storage, read> cones: array<vec4f>;
@binding(2) @group(0) var<storage, read> view: array<vec4f>;
@binding(3) @group(0) var<storage, read> ranges: array<vec4f>;
@binding(4) @group(0) var<storage, read> source: array<f32>;
@binding(5) @group(0) var<storage, read_write> indices: array<u32>;
@binding(6) @group(0) var<storage, read_write> indirect: array<u32>;
"
INDICES_COPIED := "
		let first = u32(ranges[i].x);
		let last = first + u32(ranges[i].y);
		for (var k = first; k < last; k++) {
			indices[count] = u32(source[k]);
			count++;
		}
"
INDEXED_DRAW := "
	indirect[0] = count;
	indirect[1] = 1u;
	indirect[2] = 0u;
	indirect[3] = 0u;
	indirect[4] = 0u;
}
"
# the bindings of a cull that keeps instanced clusters, the kept ones moved to the front, and its draw words
INSTANCE_BINDINGS := "
@binding(0) @group(0) var<storage, read_write> draws: array<vec4f>;
@binding(1) @group(0) var<storage, read_write> spans: array<vec4f>;
@binding(2) @group(0) var<storage, read> bounds: array<vec4f>;
@binding(3) @group(0) var<storage, read> cones: array<vec4f>;
@binding(4) @group(0) var<storage, read> view: array<vec4f>;
@binding(5) @group(0) var<storage, read_write> indirect: array<u32>;
"
INSTANCE_KEPT := "
		draws[kept] = draws[i];
		spans[kept] = spans[i];
		kept++;
"
INSTANCED_DRAW := "
	indirect[0] = 4u;
	indirect[1] = u32(view[0].w) + kept * ${MESHLET_TRIANGLES}u;
	indirect[2] = 0u;
	indirect[3] = 0u;
}
"
INDEX_CULL := INDEX_BINDINGS + CULL_FN + "
@compute @workgroup_size(1) fn main() {
	var count = 0u;
	let n = arrayLength(&bounds);
	for (var i = 0u; i < n; i++) {
		if (!cluster_kept(i)) { continue; }
" + INDICES_COPIED + "
	}
" + INDEXED_DRAW
INSTANCE_CULL := INSTANCE_BINDINGS + CULL_FN + "
@compute @workgroup_size(1) fn main() {
	var kept = 0u;
	let n = arrayLength(&bounds);
	for (var i = 0u; i < n; i++) {
		if (!cluster_kept(i)) { continue; }
" + INSTANCE_KEPT + "
	}
" + INSTANCED_DRAW
PYRAMID_BINDING := "
@binding(7) @group(0) var<storage, read> pyramid: array<f32>;
"
# after the planes, two levels (first cluster, count, error) and the screen size; the distance is view[0].w
LOD_INDEX := INDEX_BINDINGS + PYRAMID_BINDING + CULL_FN + LOD_FN + OCCLUDE_FN + "
fn grid_hidden(center: vec3f, radius: f32) -> bool {
	let at = 2u + u32(view[1].w);
	let screen = view[at + 2u];
	let x_ndc = center.x * 1.6;
	let y_ndc = center.y * 1.6 - 0.85;
	let depth = clamp(center.z * 0.5 + 0.5, 0.0, 1.0);
	let nearest = clamp(depth - radius * 0.5, 0.0, 1.0);
	let px = (x_ndc * 0.5 + 0.5) * screen.x;
	let py = (0.5 - y_ndc * 0.5) * screen.y;
	let rad = radius * 1.6 * 0.5 * screen.x;
	return nearest > occluder(px, py, rad, screen.x, screen.y);
}
@compute @workgroup_size(1) fn main() {
	var count = 0u;
	let at = 2u + u32(view[1].w);
	let picked = level_from_view(at, 2u, view[0].w);
	if (picked > 0u) {
		let level = view[at + picked - 1u];
		let first_c = u32(level.x);
		let last_c = first_c + u32(level.y);
		for (var i = first_c; i < last_c; i++) {
			if (!cluster_kept(i) || grid_hidden(bounds[i].xyz, bounds[i].w)) { continue; }
" + INDICES_COPIED + "
		}
	}
" + INDEXED_DRAW
# lods[t] is a tree's first level, level count and local distance; the tree's levels follow in order
LOD_INSTANCE := INSTANCE_BINDINGS + "
@binding(6) @group(0) var<storage, read> lods: array<vec4f>;
" + PYRAMID_BINDING + CULL_FN + LOD_FN + LODS_FN + OCCLUDE_FN + "
fn forest_hidden(center: vec3f, radius: f32) -> bool {
	let base = 2u + u32(view[1].w);
	let forward = view[base].xyz;
	let focal = view[base].w;
	let right = view[base + 1u].xyz;
	let centre_x = view[base + 1u].w;
	let up = view[base + 2u].xyz;
	let centre_y = view[base + 2u].w;
	let near = view[base + 3u].x;
	let far = view[base + 3u].y;
	let width = view[base + 3u].z;
	let height = view[base + 3u].w;
	let d = center - view[0].xyz;
	let z = dot(d, forward);
	if (z < 0.2) { return false; }
	let nearest = clamp((z - radius - near) / (far - near), 0.0, 1.0);
	let px = centre_x + dot(d, right) / z * focal;
	let py = centre_y - dot(d, up) / z * focal;
	return nearest > occluder(px, py, radius * focal / z, width, height);
}
@compute @workgroup_size(1) fn main() {
	var kept = 0u;
	let base = 2u + u32(view[1].w);
	let trees_n = u32(view[base + 4u].x);
	for (var t = 0u; t < trees_n; t++) {
		let tree = lods[t];
		let picked = level_picked(u32(tree.x), u32(tree.y), tree.z);
		if (picked == 0u) { continue; }
		let level = lods[u32(tree.x) + picked - 1u];
		let first = u32(level.x);
		let last = first + u32(level.y);
		for (var i = first; i < last; i++) {
			if (!cluster_kept(i) || forest_hidden(bounds[i].xyz, bounds[i].w)) { continue; }
" + INSTANCE_KEPT + "
		}
	}
" + INSTANCED_DRAW

# --- tree meshes (.eztree). EZ Tree writes a branch, then that branch's leaves, so 64 consecutive triangles already
# sit together: cluster_triangles is the partition, with no spatial rebuild.
# "EZT1", then a u32 level count. Each level is u32 vertices, u32 triangles, f32 error, then its vertices (x, y, z, u,
# v as f32) and triangles (u16 a, b, c, part; part 0 is bark and 1 a leaf)
TREE_MAGIC := [69, 90, 84, 49]
TREE_HEAD_BYTES := 8
TREE_LEVEL_HEAD_BYTES := 12
TREE_VERTEX_BYTES := 20
TREE_TRIANGLE_BYTES := 8
TREE_LEVELS := 8
U16_LIMIT := 65535
LEAF_PART := 1

tree_mesh_of(bytes: list<int>): TreeMesh := {
	if #bytes < TREE_HEAD_BYTES or bytes[0 .. 4] != TREE_MAGIC { raise "meshlets: a tree mesh starts with EZT1" }
	levels_n = u32_at(bytes, 4)
	if levels_n == 0 or levels_n > TREE_LEVELS { raise "meshlets: a tree mesh needs 1 to ${TREE_LEVELS} levels, not ${levels_n}" }
	at = TREE_HEAD_BYTES
	levels: list<TreeLevel> = []
	for n in 0 .. levels_n {
		span_checked(bytes, at, TREE_LEVEL_HEAD_BYTES)
		vertices_n = u32_at(bytes, at)
		triangles_n = u32_at(bytes, at + 4)
		error = f32_at(bytes, at + 8)
		at += TREE_LEVEL_HEAD_BYTES
		errors_checked(levels.map(level => level.mesh.error) + [error])
		if vertices_n > U16_LIMIT { raise "meshlets: a level has more vertices than a u16 index holds, ${vertices_n}" }
		span_checked(bytes, at, vertices_n * TREE_VERTEX_BYTES + triangles_n * TREE_TRIANGLE_BYTES)
		vertices = tree_vertices(bytes, at, vertices_n)
		at += vertices_n * TREE_VERTEX_BYTES
		indices = tree_indices(bytes, at, triangles_n)
		at += triangles_n * TREE_TRIANGLE_BYTES
		for index in indices {
			outside = index[0 .. 3].filter(corner => corner >= vertices_n)
			if #outside > 0 { raise "meshlets: a triangle index is outside the vertices, not ${outside[0]}" }
			if index[3] > LEAF_PART { raise "meshlets: a triangle part is bark or leaf, not ${index[3]}" }
		}
		triangles = indices.map(index => index[0 .. 3].map(corner => vertices[corner][0 .. 3]))
		levels = levels + [TreeLevel(MeshLevel(triangles, cluster_triangles(triangles), error), vertices, indices, -1, -1)]
	}
	if at != #bytes { raise "meshlets: a tree mesh has leftover bytes" }
	TreeMesh(levels)
}
# n vertices of five f32s, and n triangles of four u16s, from `from`
tree_vertices(bytes: list<int>, from: int, n: int): list<list<float>> := [[f32_at(bytes, from + TREE_VERTEX_BYTES * v + 4 * k) for k in 0 .. 5] for v in 0 .. n]
tree_indices(bytes: list<int>, from: int, n: int): list<list<int>> := [[u16_at(bytes, from + TREE_TRIANGLE_BYTES * t + 2 * k) for k in 0 .. 4] for t in 0 .. n]
span_checked(bytes: list<int>, at: int, n: int) := { if at + n > #bytes { raise "meshlets: a tree mesh is shorter than it says" } }

# a tree file that is not there names what makes it: the larger EZ Tree meshes are kept out of git
tree_mesh(path: text): TreeMesh := if exists(path) then tree_mesh_of(read_bytes(path)) else raise "meshlets: no tree mesh ${path}: " + TREE_MESH_SOURCE

# one vertex and triangle buffer for every mesh, in order: each level's base is its first triangle there, and its
# vertex_at is added to the level's own indices
pack_tree_meshes(meshes: list<TreeMesh>): MeshPack := {
	vertices: list<list<float>> = []
	texels: list<list<float>> = []
	triangles: list<list<int>> = []
	for level in meshes.flat_map(mesh => mesh.levels) {
		level.vertex_at = #vertices
		level.base = #triangles
		vertices = vertices + level.vertices.map(vertex => vertex[0 .. 4])
		texels = texels + level.vertices.map(vertex => [vertex[4]])
		triangles = triangles + level.indices.map(index => index[0 .. 3].map(corner => level.vertex_at + corner) + [index[3]])
	}
	if #vertices == 0 { raise "meshlets: a packed mesh has no vertices" }
	MeshPack(vertices, texels, triangles)
}
