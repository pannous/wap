# libm through its C library: `use m`; the native wap finds it in the process (libm, libSystem). Each line is the C
# function as C has it, for programs that call C on purpose; where wap has the word itself (sqrt, floor, hypotenuse),
# the wap word is the one to use.
hypot(x: f64, y: f64): f64 from 'm'
ldexp(x: f64, exponent: i32): f64 from 'm'
cbrt(x: f64): f64 from 'm'
sqrtf(x: f32): f32 from 'm'
fabsf(x: f32): f32 from 'm'
ldexpf(x: f32, exponent: i32): f32 from 'm'
fmin(x: f64, y: f64): f64 from 'm'
