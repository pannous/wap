# The standard module net (wiki/standard-library.md net, part of `use script`): fetch(url) gets what a URL answers,
# post(url, body) sends a text there, both by curl, run by its argument vector, so no shell sees the URL. An answer of
# status 400 or more raises, naming what curl and the answer said.
use os
use json
use text

# curl's words for every request: silent but for its errors, following redirects, an error answer a failure
CURL := ["curl", "-sSL", "--fail-with-body"]
# a posted text's type unless the headers name one
POST_CONTENT_TYPE := "text/plain; charset=utf-8"
# `fetch "://example.com"`: a URL without its scheme goes over https
SCHEMELESS := "://"

# fetch(url): what a GET of the url answers: a JSON array or object as wap data (lists, maps), any other answer its text
fetch(url: text): any := fetch(url, {})
# fetch(url, {"Accept": "application/json"}): the map's pairs are the request's headers
fetch(url: text, headers: map<text, text>): any := fetched_value(exec(curl_words(url, headers, [])))
post(url: text, body: text): text := post(url, body, {})
# post(url, body, {"x-api-key": key}): the body sent as it is, the map's pairs the request's headers; the answer's text
post(url: text, body: text, headers: map<text, text>): text := exec(curl_words(url, typed_headers(headers), ["--data-binary", body]))

# curl's words for a request: each header, then the request's own words, the URL last
curl_words(url: text, headers: map<text, text>, request: list<text>): list<text> :=
	CURL + headers.keys().flat_map(name => ["-H", "${name}: ${headers[name]}"]) + request + [full_url(url)]
full_url(url: text): text := if url.starts_with(SCHEMELESS) then "https" + url else url
typed_headers(headers: map<text, text>): map<text, text> := {
	if headers.keys().any(name => lower(name) == "content-type") { return headers }
	typed = {"Content-Type": POST_CONTENT_TYPE}
	for name in headers.keys() { typed[name] = headers[name] }
	typed
}
fetched_value(answer: text): any := if is_json_shaped(answer) then parse_json(answer) else answer
is_json_shaped(answer: text): bool := trim(answer).starts_with("[") or trim(answer).starts_with("{")
