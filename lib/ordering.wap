# The standard module ordering: `use ordering`, texts in natural order, their digit runs compared as numbers:
# natural_sort(["a10", "a2", "a1"]) is ["a1", "a2", "a10"]

# a text as its runs of digits and of other characters: "a10b" is ["a", "10", "b"]
natural_runs(t: text): list<text> := {
	runs: list<text> = []
	run = ""
	for letter in t.characters {
		if run != "" and is_digit(letter) != is_digit(run[0:1]) {
			runs.add(run)
			run = ""
		}
		run += letter
	}
	if run != "" { runs.add(run) }
	runs
}
# -1, 0 or 1 as the difference is below, at or above zero
sign_of(difference: int): int := if difference < 0 then -1 else if difference > 0 then 1 else 0
# digit runs by their numbers (then fewer leading zeros first), other runs by their characters
natural_compare(a: text, b: text): int := {
	xs = natural_runs(a)
	ys = natural_runs(b)
	for i in 0 upto min(#xs, #ys) {
		x = xs[i]
		y = ys[i]
		if is_digits(x) and is_digits(y) {
			if int(x) != int(y) { return sign_of(int(x) - int(y)) }
			if #x != #y { return sign_of(#x - #y) }
		} else if x != y { return sign_of(compared(x, y)) }
	}
	sign_of(#xs - #ys)
}
natural_sort(xs: list<text>): list<text> := xs.sorted(compare: natural_compare)
