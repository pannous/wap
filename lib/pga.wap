# The standard module pga (wiki/3d.md "Algebra"): `use pga`, Clifford algebras of any metric and the projective
# geometric algebras of the plane and of space built on them. A Multivector holds the squares of its basis vectors
# (metric, e0 first) and one coefficient per basis blade (parts), the blade of index m being the product of the basis
# vectors whose bits m sets, in ascending order: in the plane's metric [0, 1, 1], parts[3] is e01.
# + - and * (the geometric product) and == take a Multivector or a plain number on either side; the other products
# are words: wedge (outer, a meet in PGA), regressive (a join in PGA), inner (the symmetric inner product), contract
# (the left contraction). The PGA words are one verb with overloads: point, line, plane, join, meet, reflect, rotor,
# translator, motor, apply, coordinates, arrow, ray, span, collection. The glyphs ⋏ ⋎ ↦ ↣ ⟇ ⊔ spell meet, join,
# arrow, ray, span and collection; ∧, ∨ and → keep their meanings and, or and maps-to.
# Conventions those of bivector.net: the plane's point (x, y) is x·e20 + y·e01 + e12, its line a·x + b·y + c = 0 is
# a·e1 + b·e2 + c·e0; space's point is e123 + x·e032 + y·e013 + z·e021, its plane a·x + b·y + c·z + d = 0 is
# a·e1 + b·e2 + c·e3 + d·e0. The dual is the right complement, e_m ∧ dual(e_m) = I, which needs no metric and so works
# in the degenerate PGA metrics.
use bits
use list

# the products mv_product makes, by which pairs of blades it keeps
enum Product { geometric, outer, contraction, inner }

class Multivector { metric: list<int>, parts: list<float> }

# --- blades

# how many blades an algebra of that metric has
blade_count(metric: list<int>): int := 1 << #metric
# coefficient times the blade of index m
blade(metric: list<int>, m: int, coefficient: float): Multivector := {
	if m < 0 or m >= blade_count(metric) { raise "pga: no blade ${m} in an algebra of ${#metric} basis vectors" }
	parts = fill(blade_count(metric), 0.0)
	parts[m] = coefficient
	Multivector(metric, parts)
}
# the basis vector e_i, e0 the first
basis(metric: list<int>, i: int): Multivector := blade(metric, 1 << i, 1.0)
pseudoscalar(metric: list<int>): Multivector := blade(metric, blade_count(metric) - 1, 1.0)
# a plain number as the scalar of the algebra of that metric
scalar(metric: list<int>, x: float): Multivector := blade(metric, 0, x)
# a multivector's scalar, its part of grade 0
scalar(x: Multivector): float := x.parts[0]
# the sign e_a·e_b takes to become e_(a xor b): -1 for each swap that orders the basis vectors, times the square of
# each one both share
blade_sign(a: int, b: int, metric: list<int>): float := {
	swaps = 0
	s = a >> 1
	while s != 0 {
		swaps += popcount(s & b)
		s = s >> 1
	}
	sign = if swaps % 2 == 0 then 1.0 else -1.0
	shared = a & b
	for i in 0 upto #metric { if (shared & (1 << i)) != 0 { sign = sign * float(metric[i]) } }
	sign
}
# whether e_a·e_b adds to the product of that kind
blade_kept(a: int, b: int, kind: Product): bool := {
	shared = a & b
	if kind == Product.geometric then yes else if kind == Product.outer then shared == 0 else if kind == Product.contraction then shared == a else shared == a or shared == b
}

# --- products

combined(a: Multivector, b: Multivector, sign: float): Multivector := Multivector(a.metric, (0 upto #same_algebra(a, b).parts).map(m => a.parts[m] + sign * b.parts[m]))
same_algebra(a: Multivector, b: Multivector): Multivector := if #a.parts != #b.parts then raise "pga: multivectors of different algebras" else a
mv_product(a: Multivector, b: Multivector, kind: Product): Multivector := {
	out = fill(#same_algebra(a, b).parts, 0.0)
	for i in 0 upto #a.parts {
		for j in 0 upto #b.parts {
			if a.parts[i] != 0.0 and b.parts[j] != 0.0 and blade_kept(i, j, kind) {
				k = i xor j
				out[k] = out[k] + a.parts[i] * b.parts[j] * blade_sign(i, j, a.metric)
			}
		}
	}
	Multivector(a.metric, out)
}
+(a: Multivector, b: Multivector): Multivector := combined(a, b, 1.0)
-(a: Multivector, b: Multivector): Multivector := combined(a, b, -1.0)
*(a: Multivector, b: Multivector): Multivector := mv_product(a, b, Product.geometric)
==(a: Multivector, b: Multivector): bool := a.parts == b.parts
# a plain number on either side is the scalar of the other's algebra
+(a: Multivector, x: float): Multivector := a + scalar(a.metric, x)
+(x: float, a: Multivector): Multivector := scalar(a.metric, x) + a
-(a: Multivector, x: float): Multivector := a - scalar(a.metric, x)
-(x: float, a: Multivector): Multivector := scalar(a.metric, x) - a
*(a: Multivector, x: float): Multivector := a * scalar(a.metric, x)
*(x: float, a: Multivector): Multivector := scalar(a.metric, x) * a
wedge(a: Multivector, b: Multivector): Multivector := mv_product(a, b, Product.outer)
contract(a: Multivector, b: Multivector): Multivector := mv_product(a, b, Product.contraction)
inner(a: Multivector, b: Multivector): Multivector := mv_product(a, b, Product.inner)

# each blade's coefficient times what f gives for its index and the coefficient
by_blade(a: Multivector, f: (int, float) -> float): Multivector := Multivector(a.metric, (0 upto #a.parts).map(m => f(m, a.parts[m])))
# the reverse: each blade's vectors in the opposite order, the sign (-1)^(k(k-1)/2) of grade k
reverse(a: Multivector): Multivector := a.by_blade((m, x) => if (popcount(m) * (popcount(m) - 1) ÷ 2) % 2 == 0 then x else -x)
# the part of grade k
grade(a: Multivector, k: int): Multivector := a.by_blade((m, x) => if popcount(m) == k then x else 0.0)
scalar_part(a: Multivector): float := a.parts[0]
# the right complement: e_m becomes ±e_(not m) with e_m ∧ dual(e_m) = I; undual undoes it
dual(a: Multivector): Multivector := complement(a, m => blade_sign(m, #a.parts - 1 - m, []))
undual(a: Multivector): Multivector := complement(a, m => blade_sign(#a.parts - 1 - m, m, []))
complement(a: Multivector, sign: (int) -> float): Multivector := {
	full = #a.parts - 1
	Multivector(a.metric, (0 upto #a.parts).map(m => a.parts[full - m] * sign(full - m)))
}
# the regressive product, the dual of the outer product of the duals: in PGA the join of points
regressive(a: Multivector, b: Multivector): Multivector := undual(wedge(dual(a), dual(b)))
# √|⟨a·ã⟩₀|
norm(a: Multivector): float := sqrt(abs(scalar_part(a * reverse(a))))
# a divided by its norm; a null multivector has none
normalized(a: Multivector): Multivector := {
	n = norm(a)
	if n == 0.0 { raise "pga: a null multivector has no direction to keep" }
	a * (1.0 / n)
}
# x transformed by the versor r, r·x·r̃: a rotor turns, a motor moves, a plane reflects
sandwich(r: Multivector, x: Multivector): Multivector := r * x * reverse(r)

# --- the plane, R(2,0,1): e0² = 0, e1² = e2² = 1

PGA2 := [0, 1, 1]
point(x: float, y: float): Multivector := blade(PGA2, 5, -x) + blade(PGA2, 3, y) + blade(PGA2, 6, 1.0)
# the line a·x + b·y + c = 0
line(a: float, b: float, c: float): Multivector := blade(PGA2, 2, a) + blade(PGA2, 4, b) + blade(PGA2, 1, c)
# the rotor turning by angle radians counter-clockwise around the point (x, y)
rotor(angle: float, x: float, y: float): Multivector := point(x, y) * -sin(angle / 2.0) + cos(angle / 2.0)
translator(dx: float, dy: float): Multivector := blade(PGA2, 0, 1.0) + blade(PGA2, 3, -dx / 2.0) + blade(PGA2, 5, -dy / 2.0)

# --- space, R(3,0,1): e0² = 0, e1² = e2² = e3² = 1

PGA3 := [0, 1, 1, 1]
# space's basis blades by their bivector.net names, with a sign where the name orders its vectors otherwise
e0 := blade(PGA3, 1, 1.0)
e1 := blade(PGA3, 2, 1.0)
e2 := blade(PGA3, 4, 1.0)
e3 := blade(PGA3, 8, 1.0)
e01 := blade(PGA3, 3, 1.0)
e02 := blade(PGA3, 5, 1.0)
e03 := blade(PGA3, 9, 1.0)
e12 := blade(PGA3, 6, 1.0)
e31 := blade(PGA3, 10, -1.0)
e23 := blade(PGA3, 12, 1.0)
e021 := blade(PGA3, 7, -1.0)
e013 := blade(PGA3, 11, 1.0)
e032 := blade(PGA3, 13, -1.0)
e123 := blade(PGA3, 14, 1.0)
e0123 := blade(PGA3, 15, 1.0)
# the same blades named by what they are: the directions, so point(x, y, z) == origin + x·ẋ + y·ẏ + z·ż
ẋ := e032
ẏ := e013
ż := e021
origin := e123
I := e0123
point(x: float, y: float, z: float): Multivector := origin + x * ẋ + y * ẏ + z * ż
# the point at its coordinates, [x, y] or [x, y, z]: coordinates(p)'s inverse
point(at: list<float>): Multivector := if #at == 2 then point(at#1, at#2) else point(at#1, at#2, at#3)
plane(a: float, b: float, c: float, d: float): Multivector := a * e1 + b * e2 + c * e3 + d * e0
# a rotor around the line axis, or around the direction (x, y, z) through the origin
rotor(angle: float, axis: Multivector): Multivector := normalized(axis) * -sin(angle / 2.0) + cos(angle / 2.0)
rotor(angle: float, x: float, y: float, z: float): Multivector := rotor(angle, join(point(0.0, 0.0, 0.0), point(x, y, z)))
translator(dx: float, dy: float, dz: float): Multivector := 1.0 + (dx * e01 + dy * e02 + dz * e03) * -0.5

# --- the verbs of both

# a point's coordinates, [x, y] or [x, y, z]; an ideal point (a direction, weight 0) has none
coordinates(p: Multivector): list<float> := {
	weight = p.parts[#p.parts - 2]
	if weight == 0.0 { raise "pga: an ideal point (a direction) has no coordinates" }
	weighted = if #p.metric == 3 then [-p.parts[5], p.parts[3]] else [-p.parts[13], p.parts[11], -p.parts[7]]
	weighted.map(c => c / weight)
}
meet(a: Multivector, b: Multivector): Multivector := wedge(a, b)
join(a: Multivector, b: Multivector): Multivector := regressive(a, b)
# the mirror reflects x; a rotor or motor applied to x
reflect(mirror: Multivector, x: Multivector): Multivector := sandwich(mirror, x)
apply(versor: Multivector, x: Multivector): Multivector := sandwich(versor, x)
# the translator after the rotor
motor(r: Multivector, t: Multivector): Multivector := t * r
# an arrow from a to b, anchored at a; a ray from a through b; the span of two objects; two objects assembled
arrow(a: Multivector, b: Multivector): list<Multivector> := [a, b - a]
ray(a: Multivector, b: Multivector): list<Multivector> := [a, join(a, b)]
span(a: Multivector, b: Multivector): list<Multivector> := [a, b]
collection(a: Multivector, b: Multivector): list<Multivector> := [a, b]
infix operator ⋏(a: Multivector, b: Multivector): Multivector := meet(a, b)
infix operator ⋎(a: Multivector, b: Multivector): Multivector := join(a, b)
infix operator ↦(a: Multivector, b: Multivector): list<Multivector> := arrow(a, b)
infix operator ↣(a: Multivector, b: Multivector): list<Multivector> := ray(a, b)
infix operator ⟇(a: Multivector, b: Multivector): list<Multivector> := span(a, b)
infix operator ⊔(a: Multivector, b: Multivector): list<Multivector> := collection(a, b)
operator ⋏ has precedence above ⋎
# English words of the same: intersection, crossing and connect typed, so list intersection keeps its meaning
alias intersect => meet
alias segment => arrow
alias halfline => ray
alias subspace => span
alias assembly => collection
intersection(a: Multivector, b: Multivector): Multivector := meet(a, b)
crossing(a: Multivector, b: Multivector): Multivector := meet(a, b)
connect(a: Multivector, b: Multivector): Multivector := join(a, b)

# --- text

# the name of the blade of index m: e, then the indices of its vectors, e013; the scalar's is empty
blade_name(m: int): text := if m == 0 then "" else "e" + (0 upto 63).filter(i => ((m >> i) & 1) == 1).map(i => "${i}").join("")
part_text(x: float): text := if x == floor(x) and abs(x) < 1e15 then "${int(x)}" else "${x}"
# "1 + 2e1 - e12": the nonzero parts by blade index, a coefficient of ±1 left out before a blade; "0" for zero
text(a: Multivector): text := {
	terms = (0 upto #a.parts).filter(m => a.parts[m] != 0.0)
	if terms is empty then "0" else (1 to #terms).map(at => term_text(a.parts[terms#at], terms#at, at == 1)).join("")
}
term_text(x: float, m: int, first: bool): text := {
	sign = if x < 0.0 then (if first then "-" else " - ") else (if first then "" else " + ")
	size = abs(x)
	sign + (if m > 0 and size == 1.0 then "" else part_text(size)) + blade_name(m)
}
