# The standard module process: a program started by its argument vector, without a shell, natively. run(["ls", "-l"])
# waits for it and gives its exit status, what it printed and what it said on stderr; folder: names the folder it
# starts in, seconds: a cap after which it and the processes it started are stopped and run raises. A failing program
# is no error, its status says so; one killed by a signal has 128 + the signal, as sh gives it. Started by
# posix_spawnp, its outputs written to temporary files, which run reads back.
use file

# posix_spawn's opaque objects: room for either kind on every libc
SPAWN_OBJECT_BYTES := 1024
# a wait status holds the exit status above its low byte, a killing signal in its low 7 bits
STATUS_UNIT := 256
SIGNAL_BITS := 128
KILLED_STATUS := 128
SIGKILL := 9
# posix_spawnattr's flag for a process group of its own, and waitpid's for not waiting
POSIX_SPAWN_SETPGROUP := 2
WNOHANG := 1
# how often a capped program is looked at
POLL_MS := 10
MS_PER_SECOND := 1000
# the bytes of a C pointer and of a wait status
POINTER_BYTES := 8
STATUS_BYTES := 4

malloc(size: i64): handle from 'c'
free(pointer: handle): ø from 'c'
fopen(path: text, mode: text): handle from 'c'
fileno(file: handle): i32 from 'c'
fclose(file: handle): i32 from 'c'
posix_spawn_file_actions_init(actions: handle): i32 from 'c'
posix_spawn_file_actions_adddup2(actions: handle, file: i32, to: i32): i32 from 'c'
posix_spawn_file_actions_addchdir_np(actions: handle, folder: text): i32 from 'c'
posix_spawn_file_actions_destroy(actions: handle): i32 from 'c'
posix_spawnattr_init(attributes: handle): i32 from 'c'
posix_spawnattr_setflags(attributes: handle, flags: i32): i32 from 'c'
posix_spawnattr_setpgroup(attributes: handle, group: i32): i32 from 'c'
posix_spawnattr_destroy(attributes: handle): i32 from 'c'
posix_spawnp(child: out, file: text, actions: handle, attributes: handle, words: texts, environment: handle): handle from 'c'
waitpid(child: i32, status: handle, options: i32): i32 from 'c'
kill(child: i32, signal: i32): i32 from 'c'
# DEBT: macOS's way to C's environ; glibc has only the variable, which no C call gives
_NSGetEnviron(): handle from 'c'

# a program's exit status, what it printed and what it said on stderr, each without its trailing line ends
class Ran { status: int, out: text, err: text }

# the little-endian int of size bytes C wrote at a pointer
int_at(pointer: int, size: int): int := c_copied(pointer, size).bytes.reverse().fold(0, (n, b) => n * 256 + b)

run(words: list<text>, folder: text = ".", seconds: int? = ø): Ran := {
	if words is empty { raise "run: no program named" }
	out = temp_file()
	err = temp_file()
	out_file = fopen(out, "w")
	err_file = fopen(err, "w")
	actions = malloc(SPAWN_OBJECT_BYTES)
	attributes = malloc(SPAWN_OBJECT_BYTES)
	status = malloc(STATUS_BYTES)
	posix_spawn_file_actions_init(actions)
	posix_spawn_file_actions_adddup2(actions, fileno(out_file), 1)
	posix_spawn_file_actions_adddup2(actions, fileno(err_file), 2)
	posix_spawn_file_actions_addchdir_np(actions, home_expanded(folder))
	posix_spawnattr_init(attributes)
	posix_spawnattr_setflags(attributes, POSIX_SPAWN_SETPGROUP)
	posix_spawnattr_setpgroup(attributes, 0)
	child = try posix_spawnp(words[0], actions, attributes, words, int_at(_NSGetEnviron(), POINTER_BYTES)) catch e { 0 }
	fclose(out_file)
	fclose(err_file)
	posix_spawn_file_actions_destroy(actions)
	posix_spawnattr_destroy(attributes)
	stopped = child != 0 and not waited(child, status, seconds)
	answer = Ran(exit_status(int_at(status, STATUS_BYTES)), without_line_ends(read(out)), without_line_ends(read(err)))
	for pointer in [actions, attributes, status] { free(pointer) }
	delete_file(out)
	delete_file(err)
	if child == 0 { raise "run: cannot start ${words[0]}" }
	if stopped { raise "run: ${words.join(" ")} stopped after ${seconds ?? 0} seconds" }
	answer
}
# the child waited for, its wait status at status; past the cap it and its group are killed: no then
waited(child: int, status: int, seconds: int?): bool := {
	if seconds is ø {
		waitpid(child, status, 0)
		return yes
	}
	deadline = wall_clock_ms() + (seconds ?? 0) * MS_PER_SECOND
	while waitpid(child, status, WNOHANG) == 0 {
		if wall_clock_ms() > deadline {
			kill(-child, SIGKILL)
			waitpid(child, status, 0)
			return no
		}
		sleep_ms(POLL_MS)
	}
	yes
}
exit_status(waited: int): int := {
	signal = waited % SIGNAL_BITS
	if signal == 0 then waited ÷ STATUS_UNIT else KILLED_STATUS + signal
}
without_line_ends(t: text): text := {
	end = #t
	while end > 0 and t#end == "\n" { end -= 1 }
	t[0 .. end]
}
