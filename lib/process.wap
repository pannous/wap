# The standard module process: a program started by its argument vector, without a shell, natively. run(["ls", "-l"])
# waits for it and gives its exit status, what it printed and what it said on stderr; folder: names the folder it
# starts in, seconds: a cap after which it and the processes it started are stopped and run raises, merged: yes puts
# what it says on stderr into its out, in the order said, as sh's 2>&1, input: a text it reads as its standard input,
# else it reads the program's. A failing program is no error, its status says so; one killed by a signal has 128 + the
# signal, as sh gives it. start(words) runs one beside the program: exited(child) is ø till it ends, then its Ran,
# waited(child) waits for that, stop(child) kills it and the programs it started; start's captured: no shares the
# program's outputs with it. Started by posix_spawnp, its input and outputs temporary files, which run writes and reads.
use foreign
use file
use c

# posix_spawn's opaque objects: room for either kind on every libc
SPAWN_OBJECT_BYTES := 1024
# a wait status holds the exit status above its low byte, a killing signal in its low 7 bits
STATUS_UNIT := 256
SIGNAL_BITS := 128
KILLED_STATUS := 128
SIGKILL := 9
# posix_spawnattr's flag for a process group of its own, and waitpid's for not waiting
POSIX_SPAWN_SETPGROUP := 2
WNOHANG := 1
# how often a running program is looked at
POLL_MS := 10
MS_PER_SECOND := 1000
# the bytes of a pid and of a wait status
INT_BYTES := 4

fileno(file: handle): i32 from 'c'
posix_spawn_file_actions_init(actions: handle): i32 from 'c'
posix_spawn_file_actions_adddup2(actions: handle, file: i32, to: i32): i32 from 'c'
posix_spawn_file_actions_addchdir_np(actions: handle, folder: text): i32 from 'c'
posix_spawn_file_actions_destroy(actions: handle): i32 from 'c'
posix_spawnattr_init(attributes: handle): i32 from 'c'
posix_spawnattr_setflags(attributes: handle, flags: i32): i32 from 'c'
posix_spawnattr_setpgroup(attributes: handle, group: i32): i32 from 'c'
posix_spawnattr_destroy(attributes: handle): i32 from 'c'
posix_spawnp(child: handle, file: text, actions: handle, attributes: handle, words: texts, environment: handle): i32 from 'c'
waitpid(child: i32, status: handle, options: i32): i32 from 'c'
kill(child: i32, signal: i32): i32 from 'c'
# C's environ, the environment the program's children get (lib/native/system.h)
process_environment(): handle from 'c'
# an int field of a C struct by its offset

# a program's exit status, what it printed and what it said on stderr, each without its trailing line ends
class Ran { status: int, out: text, err: text }


# a program started and not yet waited for: its words, its pid, the slot its wait status goes to, the files its outputs
# go to ("" for one it shares with the program starting it) and the one its input comes from
class Child { words: list<text>, pid: int, status: int, out: text, err: text, given: text }

# `run(["ls", "-l"])`: the program started, waited for, its Ran
run(words: list<text>, folder: text = ".", seconds: int? = ø, merged: bool = no, input: text? = ø): Ran := waited(start(words, folder: folder, merged: merged, input: input), seconds: seconds)
# `run("ls | wc -l")`: a command line handed to sh, its Ran
run(command: text): Ran := run(["sh", "-c", command])
# the started program waited for, its Ran; seconds: the cap after which it and the programs it started are stopped and
# waited raises
waited(child: Child, seconds: int? = ø): Ran := {
	deadline = wall_clock_ms() + (seconds ?? 0) * MS_PER_SECOND
	answer = exited(child)
	while answer is ø {
		if seconds != ø and wall_clock_ms() > deadline {
			stop(child)
			while exited(child) is ø { sleep_ms(POLL_MS) }
			raise "run: ${child.words.join(" ")} stopped after ${seconds ?? 0} seconds"
		}
		sleep_ms(POLL_MS)
		answer = exited(child)
	}
	answer!
}
# `server = start(["python3", "-m", "http.server"])`: the program started, running beside this one till exited gives its
# Ran; captured: no shares this program's outputs with it
start(words: list<text>, folder: text = ".", merged: bool = no, input: text? = ø, captured: bool = yes): Child := {
	if words is empty { raise "run: no program named" }
	out = if captured then temp_file() else ""
	err = if captured then temp_file() else ""
	given = temp_file()
	write(given, input ?? "")
	actions = malloc(SPAWN_OBJECT_BYTES)
	attributes = malloc(SPAWN_OBJECT_BYTES)
	child_slot = malloc(INT_BYTES)
	posix_spawn_file_actions_init(actions)
	given_file = fopen(given, "r")
	if input != ø { posix_spawn_file_actions_adddup2(actions, fileno(given_file), 0) }
	out_file = fopen(if captured then out else given, if captured then "w" else "r")
	err_file = fopen(if captured then err else given, if captured then "w" else "r")
	if captured {
		posix_spawn_file_actions_adddup2(actions, fileno(out_file), 1)
		posix_spawn_file_actions_adddup2(actions, fileno(if merged then out_file else err_file), 2)
	}
	posix_spawn_file_actions_addchdir_np(actions, home_expanded(folder))
	posix_spawnattr_init(attributes)
	posix_spawnattr_setflags(attributes, POSIX_SPAWN_SETPGROUP)
	posix_spawnattr_setpgroup(attributes, 0)
	started = posix_spawnp(child_slot, words[0], actions, attributes, words, process_environment()) == 0
	for file in [given_file, out_file, err_file] { fclose(file) }
	posix_spawn_file_actions_destroy(actions)
	posix_spawnattr_destroy(attributes)
	child = Child(words, field_i32(child_slot, 0), malloc(INT_BYTES), out, err, given)
	for pointer in [actions, attributes, child_slot] { free(pointer) }
	if not started {
		removed(child)
		raise "run: cannot start ${words[0]}"
	}
	child
}
# the program's Ran once it has ended, its files then removed; ø while it runs
exited(child: Child): Ran? := {
	if waitpid(child.pid, child.status, WNOHANG) == 0 { return ø }
	answer = Ran(exit_status(field_i32(child.status, 0)), output_of(child.out), output_of(child.err))
	removed(child)
	answer
}
# the program and every program it started killed; exited then gives its Ran
stop(child: Child) := { kill(-child.pid, SIGKILL) }
output_of(path: text): text := if path == "" then "" else without_line_ends(read(path))
removed(child: Child) := {
	free(child.status)
	for path in [child.out, child.err, child.given] { if path != "" { delete_file(path) } }
}
exit_status(waited: int): int := {
	signal = waited % SIGNAL_BITS
	if signal == 0 then waited ÷ STATUS_UNIT else KILLED_STATUS + signal
}
without_line_ends(t: text): text := {
	end = #t
	while end > 0 and t#end == "\n" { end -= 1 }
	t[0 .. end]
}
