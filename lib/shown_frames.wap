# The standard module shown_frames: shown_frames(f) runs f each frame of the window for up to the milliseconds, or once
# when no window is open (a windowless run, no video device)
use "host/native_host/window.wap"

FRAME_MS := 1000 /! 60
shown_frames(f: () -> any, milliseconds: int = 10000) := {
	f()
	started = wall_clock_ms()
	while window_open() and wall_clock_ms() - started < milliseconds {
		f()
		sleep_ms(FRAME_MS)
	}
}
