# The standard module shown_frames: `shown_frames(f)` runs f each frame of the window for up to `milliseconds`, or once
# when none opens (--no-window, no video device), so a paint loop paints one picture headless. After each frame the
# frame event is emitted (lib/events.wap): `listen(FRAME_EVENT, …)` runs once a frame, as keys takes the presses
use "host/native_host/window.wap"
use events

FRAME_MS := 16
FRAME_EVENT := "frame"
shown_frames(f: () -> any, milliseconds: int = 10000) := {
	frame_shown(f)
	if not window_open() { return }
	started = wall_clock_ms()
	while window_open() and wall_clock_ms() - started < milliseconds {
		frame_shown(f)
		sleep_ms(FRAME_MS)
	}
}
frame_shown(f: () -> any) := {
	f()
	emitted(FRAME_EVENT, ø)
}
