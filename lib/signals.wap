# The standard module signals (wiki/signal.md): a value whose writes its listeners hear. `x = signal(0)` makes one, and
# a later `x = 6` is its set (a value a name's type does not hold goes to that type's set). `on set x {…}` runs after
# each write, `on change x {…}` after a write that changed the value, `whenever c {…}` each time the condition c comes
# to hold after a write, `once c {…}` the first time only.

class Signal { value: any; listeners: list<Heard> = []; notifying: bool = no }
# a listener of a signal: whether it hears only changes, and what it does
class Heard { changes_only: bool; act: () -> any }
# the writes of a signal a listener hears, `set x` all of them, `change x` those that changed it
class Writes { changes_only: bool }
# a condition watched over every write: whether it held after the last one, whether it runs only once, and whether it
# ran so and is gone
class Watch { condition: () -> bool; act: () -> any; held: bool; once: bool; gone: bool = no }
watches: list<Watch> = []

signal(value: any): Signal := Signal(value)
# a signal read where another type is wanted gives its value, `x > 5`
get(of: Signal): any := of.value
set(of: Signal): Writes := Writes(no)
change(of: Signal): Writes := Writes(yes)
# `on change x {…}`: on given the word, the signal and the block
on(writes: (Signal) -> Writes, of: Signal, act: block) := { of.listeners = of.listeners + [Heard(writes(of).changes_only, act)] }
whenever(condition: block, act: block) := watched_from(condition, act, no)
once(condition: block, act: block) := watched_from(condition, act, yes)
watched_from(condition: () -> bool, act: () -> any, once: bool) := watches.add(Watch(condition, act, condition(), once))

# the signal given its value, then its listeners told and the conditions checked; a listener writing the signal it
# hears writes it without telling the listeners again, so a write never loops
set(to: any, of: Signal) := {
	old = of.value
	of.value = to
	if of.notifying { return }
	of.notifying = yes
	for heard in of.listeners { if not heard.changes_only or to != old { heard.act() } }
	of.notifying = no
	for watch in watches { if not watch.gone { checked(watch) } }
}
# a watch checked after a write, its act run when its condition came to hold, once only where it runs once
checked(watch: Watch) := {
	now = watch.condition()
	came = now and not watch.held
	watch.held = now
	watch.gone = came and watch.once
	if came { watch.act() }
}
