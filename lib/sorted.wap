# The standard module sorted (wiki/library-collections.md "Sorted maps and sets"): `use sorted`. A SortedMap keeps its
# keys in order, numbers by value and texts by their characters, each with its value; a SortedSet keeps its items so.
# sorted_map([[980, "Bea"], [1200, "Ada"]]) and sorted_set([3, 1, 2]) make them. set, add and remove give a new
# collection and leave the receiver; a missing get is ø. rank(k) is the key's 1-based place, 0 when it is absent; at(i)
# the i-th smallest key; between(lo, hi) the keys from lo to hi. A key is found by halving, in log n steps.

class SortedMap { keys: list<any>, values: list<any> }
class SortedSet { items: list<any> }

as_number(x: any): float := if x is int then float(x as int) else x as float
# whether a goes before b: texts by their characters, numbers by value
before(a: any, b: any): bool := if a is text and b is text then compared("${a}", "${b}") < 0 else as_number(a) < as_number(b)
# the place of the first key that does not go before k
place_of(keys: list<any>, k: any): int := {
	low = 0
	high = #keys
	while low < high {
		middle = (low + high) ÷ 2
		if before(keys[middle], k) { low = middle + 1 } else { high = middle }
	}
	low
}
# whether the key at the place is k
found_at(keys: list<any>, place: int, k: any): bool := place < #keys and not before(k, keys[place])
smallest(keys: list<any>, what: text): any := if keys is empty then raise "min of an empty ${what}" else keys[0]
largest(keys: list<any>, what: text): any := if keys is empty then raise "max of an empty ${what}" else keys.last

sorted_map(entries: list<list<any>>): SortedMap := entries.fold(SortedMap([], []), (m, entry) => m.set(entry[0], entry[1]))
set(m: SortedMap, k: any, v: any): SortedMap := {
	at = place_of(m.keys, k)
	rest = if found_at(m.keys, at, k) then at + 1 else at
	SortedMap(m.keys.take(at) + [k] + m.keys.drop(rest), m.values.take(at) + [v] + m.values.drop(rest))
}
remove(m: SortedMap, k: any): SortedMap := {
	at = place_of(m.keys, k)
	if not found_at(m.keys, at, k) then m else SortedMap(m.keys.take(at) + m.keys.drop(at + 1), m.values.take(at) + m.values.drop(at + 1))
}
get(m: SortedMap, k: any): any := {
	at = place_of(m.keys, k)
	if found_at(m.keys, at, k) then m.values[at] else ø
}
has(m: SortedMap, k: any): bool := found_at(m.keys, place_of(m.keys, k), k)
size(m: SortedMap): int := #m.keys
min(m: SortedMap): any := smallest(m.keys, "sorted map")
max(m: SortedMap): any := largest(m.keys, "sorted map")
rank(m: SortedMap, k: any): int := if m.has(k) then place_of(m.keys, k) + 1 else 0
at(m: SortedMap, i: int): any := m.keys[i - 1]
between(m: SortedMap, low: any, high: any): list<any> := m.keys.filter(k => not before(k, low) and not before(high, k))

sorted_set(xs: list<any>): SortedSet := SortedSet(xs.fold(SortedMap([], []), (m, x) => m.set(x, yes)).keys)
# a set of the items, as a map of them
as_map(s: SortedSet): SortedMap := SortedMap(s.items, s.items)
has(s: SortedSet, x: any): bool := as_map(s).has(x)
add(s: SortedSet, x: any): SortedSet := SortedSet(as_map(s).set(x, x).keys)
remove(s: SortedSet, x: any): SortedSet := SortedSet(as_map(s).remove(x).keys)
size(s: SortedSet): int := #s.items
min(s: SortedSet): any := smallest(s.items, "sorted set")
max(s: SortedSet): any := largest(s.items, "sorted set")
at(s: SortedSet, i: int): any := s.items[i - 1]
union(a: SortedSet, b: SortedSet): SortedSet := sorted_set(a.items + b.items)
intersection(a: SortedSet, b: SortedSet): SortedSet := SortedSet(a.items.filter(x => b.has(x)))
difference(a: SortedSet, b: SortedSet): SortedSet := SortedSet(a.items.filter(x => not b.has(x)))
is_subset(a: SortedSet, b: SortedSet): bool := a.items.all(x => b.has(x))
