# The standard module strsim: how alike two texts are, by their characters, as Rust's strsim crate measures it.
# levenshtein("kitten", "sitting") is 3, the fewest single-character insertions, deletions and substitutions that turn
# one into the other; jaro_winkler("martha", "marhta") is about 0.961, from 0 (nothing alike) to 1 (equal)
use list

# Jaro-Winkler: a Jaro similarity above BOOST_THRESHOLD grows by PREFIX_SCALE for each of at most PREFIX_MOST
# leading characters the texts share
BOOST_THRESHOLD := 0.7
PREFIX_SCALE := 0.1
PREFIX_MOST := 4

levenshtein(a: text, b: text): int := {
	xs = a.characters
	ys = b.characters
	# the distances from a's first i characters to each start of b, one row per i
	row = (0 to #ys).map(j => j)
	for i in 0 upto #xs {
		next = [i + 1]
		for j in 0 upto #ys {
			substituted = row[j] + (if xs[i] == ys[j] then 0 else 1)
			next.add(min(substituted, min(row[j + 1], next[j]) + 1))
		}
		row = next
	}
	row.last
}

# Jaro: the characters that match within half the longer text's length of each other, and how many of those stand
# in another order
jaro(a: text, b: text): float := {
	xs = a.characters
	ys = b.characters
	if #xs == 0 and #ys == 0 { return 1.0 }
	if #xs == 0 or #ys == 0 { return 0.0 }
	reach = max(max(#xs, #ys) ÷ 2 - 1, 0)
	taken = (0 upto #ys).map(j => no)
	matched_in_a: list<text> = []
	for i in 0 upto #xs {
		for j in max(i - reach, 0) upto min(i + reach + 1, #ys) {
			if not taken[j] and xs[i] == ys[j] {
				taken[j] = yes
				matched_in_a.add(xs[i])
				break
			}
		}
	}
	matches = #matched_in_a
	if matches == 0 { return 0.0 }
	matched_in_b = (0 upto #ys).filter(j => taken[j]).map(j => ys[j])
	out_of_order = (0 upto matches).filter(k => matched_in_a[k] != matched_in_b[k])
	(float(matches) / #xs + float(matches) / #ys + (matches - #out_of_order / 2.0) / matches) / 3
}

jaro_winkler(a: text, b: text): float := {
	similarity = jaro(a, b)
	if similarity <= BOOST_THRESHOLD { return similarity }
	xs = a.characters
	ys = b.characters
	limit = min(PREFIX_MOST, min(#xs, #ys))
	shared = (0 upto limit).take_while(k => xs[k] == ys[k])
	similarity + PREFIX_SCALE * #shared * (1 - similarity)
}
