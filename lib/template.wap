# The standard module template (wiki/library-template.md): Mustache templates (mustache.github.io: interpolation,
# sections, inverted sections, comments, partials and set-delimiter; no lambdas). {{x}} is HTML-escaped, {{{x}}} and
# {{& x}} are not; {{a.b}} looks a name up through the contexts, {{.}} is the current one; {{#x}}…{{/x}} hides for ø,
# no or an empty list (Mustache's falsey: an empty text still shows), repeats for a list and enters any other value;
# {{^x}}…{{/x}} shows only for those; {{! …}} is a comment, {{> name}} the partial of that name, {{=<% %>=}} changes the delimiters.
# A section, comment, partial or delimiter tag alone on its line takes the line with it (the spec's standalone rule).
use html
use text
use map

# what a piece of a template is
enum Kind { Literal, Escaped, Raw, Section, Inverted, Closing, Comment, Partial, Delimiters }
# a piece: a literal's text or a tag's name, and for a standalone partial the indentation its lines get
class Token { kind: Kind, content: text, indent: text }

# the character after a tag's opening that names its kind; a tag without one is Escaped
SIGILS := {"#": Section, "^": Inverted, "/": Closing, "!": Comment, ">": Partial, "&": Raw, "=": Delimiters}
# the kinds that take their line with them when alone on it
STANDALONE := [Section, Inverted, Closing, Comment, Partial, Delimiters]
OPENING := "{{"
CLOSING := "}}"
LINE_BREAK := "\n"

# the template as literal pieces and tags, the delimiters changing where a Delimiters tag says
template_tokens(t: text): list<Token> := {
	found: list<Token> = []
	open = OPENING
	close = CLOSING
	rest = t
	while rest != "" {
		at = find(rest, open)
		if at == 0 {
			found.add(Token(Literal, rest, ""))
			rest = ""
		} else {
			if at > 1 { found.add(Token(Literal, rest[0:at - 1], "")) }
			rest = rest[at - 1 + #open:]
			triple = open == OPENING and rest.starts_with("{")
			ending = if triple then "}" + close else close
			end = find(rest, ending)
			if end == 0 { raise "template: a tag opened and never closed: ${open}${rest}" }
			content = trim(rest[0:end - 1])
			rest = rest[end - 1 + #ending:]
			kind = if triple then Raw else SIGILS.get(content[0:1]) ?? Escaped
			name = if kind == Escaped then content else trim(content[1:])
			if kind == Delimiters {
				pair = words(name[0:#name - 1])
				open = pair[0]
				close = pair[1]
			}
			found.add(Token(kind, name, ""))
		}
	}
	found
}

# whether a text holds only spaces and tabs (a CRLF's CR counting as one)
is_blank_run(t: text): bool := t.codepoints.all(c => c == ' ' or c == '\t' or c == '\r')
# a text's part after its last line break, before its first
line_tail(t: text): text := t.split(LINE_BREAK).last
line_head(t: text): text := t.split(LINE_BREAK)[0]
is_literal(tokens: list<Token>, at: int): bool := at >= 0 and at < #tokens and tokens[at].kind == Literal

# whether the tag at the place is alone on its line, only spaces and tabs beside it
is_standalone(tokens: list<Token>, at: int): bool := {
	if not STANDALONE.contains(tokens[at].kind) { return no }
	before = at == 0 or (is_literal(tokens, at - 1) and (tokens[at - 1].content.contains(LINE_BREAK) or at == 1) and is_blank_run(line_tail(tokens[at - 1].content)))
	if at + 1 == #tokens then before
	else before and is_literal(tokens, at + 1) and (if tokens[at + 1].content.contains(LINE_BREAK) then is_blank_run(line_head(tokens[at + 1].content)) else is_blank_run(tokens[at + 1].content) and at + 2 == #tokens)
}
# the standalone rule applied: a standalone tag loses the blanks before it and its line's end after it, a partial
# keeping those blanks as the indentation of its lines; decided on the template as written, then applied
standalone_trimmed(tokens: list<Token>): list<Token> := {
	standalone = (0 upto #tokens).filter(at => is_standalone(tokens, at))
	out = tokens
	for at in standalone {
		if at > 0 {
			before = out[at - 1].content
			tail = line_tail(before)
			out[at - 1] = Token(Literal, before[0:#before - #tail], "")
			out[at] = Token(out[at].kind, out[at].content, tail)
		}
		if at + 1 < #out {
			after = out[at + 1].content
			out[at + 1] = Token(Literal, if after.contains(LINE_BREAK) then after[find(after, LINE_BREAK):] else "", "")
		}
	}
	out
}

# where the section opened at the place closes
closing_of(tokens: list<Token>, start: int): int := {
	depth = 0
	at = start + 1
	while at < #tokens {
		kind = tokens[at].kind
		if kind == Section or kind == Inverted { depth += 1 }
		else if kind == Closing {
			if depth == 0 {
				if tokens[at].content != tokens[start].content { raise "template: {{/${tokens[at].content}}} closes {{#${tokens[start].content}}}" }
				return at
			}
			depth -= 1
		}
		at += 1
	}
	raise "template: {{#${tokens[start].content}}} is not closed"
}

# a name looked up through the stack of contexts, innermost first, its dotted parts inside the first one holding it;
# ø for none
lookup(stack: list<any>, name: text): any := {
	if name == "." { return stack.last }
	parts = name.split(".")
	holders = stack.filter(context => holds(context, parts[0]))
	if holders is empty { return ø }
	parts.drop(1).fold(holders.last[parts[0]], (value, part) => if holds(value, part) then value[part] else ø)
}
# whether a value is a map that has the key (TODO (card any-values): written in place as `value is map and
# value.has(key)` once `is map` narrows to the map the value holds, not a bare map that has and indexing refuse)
holds(value: any, key: text): bool := is_map(value) and value.has(key)
# what hides a section and shows an inverted one: no value, no, an empty list (TODO (card any-truth-crash):
# `value == no` without the bool test once comparing an any holding a text with a bool gives no instead of crashing)
hides(value: any): bool := value == ø or (is_bool(value) and value == no) or (is_list(value) and #value == 0)
is_bool(value: any): bool := value is bool
value_text(value: any): text := if value == ø then "" else text(value)
# a partial's lines each after the indentation of its standalone tag
indented(t: text, indent: text): text := if indent == "" then t else t.split(LINE_BREAK).map(line => if line == "" then "" else indent + line).join(LINE_BREAK)

# what one tag that is no section gives
tag_text(token: Token, stack: list<any>, partials: map<text, text>): text := match token.kind {
	Literal => token.content
	Escaped => html_escape(value_text(lookup(stack, token.content)))
	Raw => value_text(lookup(stack, token.content))
	Partial => if partials.has(token.content) then filled(indented(partials[token.content], token.indent), stack, partials) else ""
	_ => ""
}
# the tokens from one place up to another filled in from the stack of contexts
rendered(tokens: list<Token>, from: int, to: int, stack: list<any>, partials: map<text, text>): text := {
	out = ""
	at = from
	while at < to {
		token = tokens[at]
		if token.kind == Section or token.kind == Inverted {
			end = closing_of(tokens, at)
			value = lookup(stack, token.content)
			if token.kind == Inverted { if hides(value) { out += rendered(tokens, at + 1, end, stack, partials) } }
			else if is_list(value) { for item in value { out += rendered(tokens, at + 1, end, stack + [item], partials) } }
			else if not hides(value) { out += rendered(tokens, at + 1, end, stack + [value], partials) }
			at = end + 1
		} else {
			out += tag_text(token, stack, partials)
			at += 1
		}
	}
	out
}
filled(t: text, stack: list<any>, partials: map<text, text>): text := {
	tokens = standalone_trimmed(template_tokens(t))
	rendered(tokens, 0, #tokens, stack, partials)
}

# the template filled in from the context (a map, or any value for {{.}}), its partials by name
mustache(t: text, context: any, partials: map<text, text>): text := filled(t, [context], partials)
mustache(t: text, context: any): text := mustache(t, context, {})
