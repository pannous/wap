# The standard module testing (wiki/keyword.md test, expect): `test 1 + 1 == 2` is a soft check, which every run
# checks, counts and goes on from; the run ends with the summary, `✓ 1 test passed`. `expect 30 10+20` is
# `test 10+20 == 30`

tests_passed = 0
tests_failed = 0
# a soft check: counted, a failed one named by its count as it fails
test(holds: bool) := {
	global tests_passed
	global tests_failed
	if holds {
		tests_passed += 1
	} else {
		tests_failed += 1
		print "✗ test \(tests_passed + tests_failed) failed"
	}
}
expect(value: T, given: T) := test(given == value)
# the run's end: the summary of its tests
export finished() := {
	global tests_passed
	global tests_failed
	print if tests_failed == 0 then "✓ \(counted(tests_passed)) passed" else "✗ \(counted(tests_failed)) of \(tests_passed + tests_failed) failed"
}
counted(tests: int): text := if tests == 1 then "1 test" else "\(tests) tests"
