# The text words beyond the types module's (wiki/string.md): upper case, words, a spelled number. `upper` knows ASCII
# only, as the types module's `lower` does.

# the bytes of a and z
LOWER_A_BYTE := 97
LOWER_Z_BYTE := 122
# the blanks between words beside the space: tab, line feed, carriage return
OTHER_BLANKS := ["\t", "\n", "\r"]

upper(t: text): text := t.bytes.map(b => byte_text(if b >= LOWER_A_BYTE and b <= LOWER_Z_BYTE then b - CASE_DISTANCE else b)).join("")
# the words between runs of blanks
words(t: text): list<text> := OTHER_BLANKS.fold(t, (spaced, blank) => spaced.replace(blank, " ")).split(" ").filter(word => word != "")
# the int or float a text spells, digits and all (a sign, a fraction, an exponent and _ between digits allowed):
# `spelled_number("1_000")` is 1000, `spelled_number("1.5")` 1.5; ø for any other text
spelled_number(t: text): any := {
	plain = t.replace("_", "")
	if not plain.codepoints.any(c => c >= '0' and c <= '9') { return ø }
	try int(plain) else try float(plain) else ø
}
# the escapes a backslash writes in a double-quoted text, and the character each stands for
BACKSLASH_ESCAPES := [["\\\\", "\\"], ["\\\"", "\""], ["\\n", "\n"], ["\\t", "\t"], ["\\r", "\r"]]
# the escapes written by the two characters, none or one
escapes_written(two: text): list<list<text>> := BACKSLASH_ESCAPES.filter(escape => two == escape[0])
# a double-quoted text's inside with its escapes read: `a\"b\n` is a"b and a line break
unescaped(t: text): text := {
	out = ""
	at = 0
	while at < #t {
		pair = escapes_written(t[at:at + 2])
		if pair is empty {
			out += t[at:at + 1]
			at += 1
		} else {
			out += pair[0][1]
			at += 2
		}
	}
	out
}
# the text in double quotes, its quotes, backslashes and line breaks escaped
double_quoted(t: text): text := "\"" + BACKSLASH_ESCAPES.fold(t, (out, escape) => out.replace(escape[1], escape[0])) + "\""
# where part first comes at or after from outside '…' and "…" (a backslash escaping inside "…"), 0-based; -1 for none
place_outside_quotes(t: text, part: text, from: int): int := {
	quote = ""
	at = from
	while at < #t {
		c = t[at:at + 1]
		if quote == "" and t[at:at + #part] == part { return at }
		if quote == "\"" and c == "\\" { at += 1 }
		else if quote == "" and (c == "\"" or c == "'") { quote = c }
		else if c == quote { quote = "" }
		at += 1
	}
	-1
}
# the pieces between the separators outside quotes
split_outside_quotes(t: text, separator: text): list<text> := {
	pieces: list<text> = []
	start = 0
	at = place_outside_quotes(t, separator, 0)
	while at >= 0 {
		pieces.add(t[start:at])
		start = at + #separator
		at = place_outside_quotes(t, separator, start)
	}
	pieces + [t[start:]]
}
# the text before a comment mark outside quotes
without_comment(t: text, mark: text): text := {
	at = place_outside_quotes(t, mark, 0)
	if at < 0 then t else t[0:at]
}
