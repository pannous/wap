# The text words beyond the types module's (wiki/string.md): upper case, a spelled number, quotes and escapes,
# and a Scan that reads a text piece by piece. `upper` knows ASCII only, as the types module's `lower` does.

# the bytes of a and z
LOWER_A_BYTE := 97
LOWER_Z_BYTE := 122

upper(t: text): text := t.bytes.map(b => byte_text(if b >= LOWER_A_BYTE and b <= LOWER_Z_BYTE then b - CASE_DISTANCE else b)).join("")
# the int or float a text spells, digits and all (a sign, a fraction, an exponent and _ between digits allowed):
# `spelled_number("1_000")` is 1000, `spelled_number("1.5")` 1.5; ø for any other text
spelled_number(t: text): any := {
	plain = t.replace("_", "")
	if not plain.codepoints.any(c => c >= '0' and c <= '9') { return ø }
	try int(plain) else try float(plain) else ø
}
# the escapes a backslash writes in a double-quoted text, and the character each stands for
BACKSLASH_ESCAPES := [["\\\\", "\\"], ["\\\"", "\""], ["\\n", "\n"], ["\\t", "\t"], ["\\r", "\r"], ["\\b", text(char(8))], ["\\f", text(char(12))]]
# and those only read, written as themselves
READ_ESCAPES := BACKSLASH_ESCAPES + [["\\/", "/"]]
# \u and four hex digits, the character of that code point: `\u00e9` is é
UNICODE_ESCAPE := "\\u"
# the escapes written by the two characters, none or one
escapes_written(two: text): list<list<text>> := READ_ESCAPES.filter(escape => two == escape[0])
# a double-quoted text's inside with its escapes read: `a\"b\n` is a"b and a line break, `\u00e9` é
unescaped(t: text): text := {
	out = ""
	at = 0
	while at < #t {
		pair = escapes_written(t[at:at + 2])
		if t[at:at + 2] == UNICODE_ESCAPE {
			out += text(char(hex_value(t[at + 2:at + 6])))
			at += 6
		} else if pair is empty {
			out += t[at:at + 1]
			at += 1
		} else {
			out += pair[0][1]
			at += 2
		}
	}
	out
}
# the text in double quotes, its quotes, backslashes and line breaks escaped
double_quoted(t: text): text := "\"" + BACKSLASH_ESCAPES.fold(t, (out, escape) => out.replace(escape[1], escape[0])) + "\""
# where part first comes at or after from outside '…' and "…" (a backslash escaping inside "…"), 0-based; ø for none
place_outside_quotes(t: text, part: text, from: int): int? := {
	quote = ""
	at = from
	while at < #t {
		c = t[at:at + 1]
		if quote == "" and t[at:at + #part] == part { return at }
		if quote == "\"" and c == "\\" { at += 1 }
		else if quote == "" and (c == "\"" or c == "'") { quote = c }
		else if c == quote { quote = "" }
		at += 1
	}
	ø
}
# the text before mark's first place and the text after it, ø when t holds no mark
split_once(t: text, mark: text): list<text>? := {
	at = find(t, mark)
	if at == 0 then ø else [t[0:at - 1], t[at - 1 + #mark:]]
}
# the pieces between the separators outside quotes
split_outside_quotes(t: text, separator: text): list<text> := {
	at = place_outside_quotes(t, separator, 0)
	if at is ø then [t] else [t[0:at]] + split_outside_quotes(t[at + #separator:], separator)
}
# the text before a comment mark outside quotes
without_comment(t: text, mark: text): text := {
	at = place_outside_quotes(t, mark, 0)
	if at is ø then t else t[0:at]
}

# a text being read and the place reached; a scan of C comments (JSON5's) takes // and /* */ comments for blanks
class Scan { source: text, at: int, c_comments: bool = no }
rest_of(s: Scan): text := s.source[s.at:]
# the character at the scan, "" at the end
next_of(s: Scan): text := s.source[s.at:s.at + 1]
skip_blanks(s: Scan) := {
	while s.at < #s.source and " \t\n\r".contains(next_of(s)) { s.at += 1 }
	if s.c_comments and rest_of(s).starts_with("//") { skip_past(s, "\n") }
	else if s.c_comments and rest_of(s).starts_with("/*") { skip_past(s, "*/") }
}
# the scan after the next end, or at the text's end
skip_past(s: Scan, end: text) := {
	# find counts from 1, 0 for none
	place = find(s.source[s.at + 2:], end)
	s.at = if place == 0 then #s.source else s.at + 1 + place + #end
	skip_blanks(s)
}
# the text quoted by the character at the scan, its escapes read, the scan after its closing quote
quoted_at(s: Scan): text := {
	quote = next_of(s)
	closing = s.at + 1
	while closing < #s.source and s.source[closing:closing + 1] != quote { closing += if s.source[closing:closing + 1] == "\\" then 2 else 1 }
	inside = s.source[s.at + 1:closing]
	s.at = closing + 1
	unescaped(inside)
}
# whether another item follows in brackets being read, the scan past the blanks and comma before it; at the closing
# bracket no, the scan past it. The scan starts just inside the opening bracket.
more_items(s: Scan, closing: text): bool := {
	skip_blanks(s)
	if next_of(s) == "," { s.at += 1 }
	skip_blanks(s)
	if s.at >= #s.source { raise "${closing} missing in ${s.source}" }
	if next_of(s) != closing { return yes }
	s.at += 1
	no
}
# the text with each %XY read as the byte of hex XY, either case: "a%20b" is "a b"; a % without two hex digits stays
HEX_DIGITS := "0123456789abcdef"
is_hex(t: text): bool := t != "" and lower(t).codepoints.all(c => HEX_DIGITS.contains("${c}"))
percent_decoded(t: text): text := {
	out = ""
	at = 0
	while at < #t {
		if t[at:at + 1] == "%" and #t[at + 1:at + 3] == 2 and is_hex(t[at + 1:at + 3]) {
			out += byte_text(hex_value(t[at + 1:at + 3]))
			at += 3
		} else {
			out += t[at:at + 1]
			at += 1
		}
	}
	out
}
# the number hex digits write (find counts from 1)
hex_value(digits: text): int := lower(digits).codepoints.fold(0, (value, c) => value * 16 + find(HEX_DIGITS, "${c}") - 1)

# a text's UTF-8 bytes and back: `from_utf8(to_utf8("é"))` is "é"
to_utf8(t: text): list<int> := t.bytes
from_utf8(bytes: list<int>): text := bytes_text(bytes)
