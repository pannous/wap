# The standard module time (wiki/library-time-patterns-durations.md): instants, durations and date patterns, in UTC.
# An Instant is milliseconds since 1970: `"2026-10-07" as Instant`, now(). A Duration is milliseconds:
# `"1h30m" as Duration`, `"PT1H30M" as Duration`; `d as text` writes it short ("1h 30m"), format(d, long: yes) in words
# and format(d, iso: yes) in ISO 8601. format(i, Pattern("yyyy-MM-dd HH:mm")) writes an instant in a pattern and
# parse(t, Pattern(…)) reads one: a run of one letter is a field (yyyy year, yy its last two digits, MMMM month name,
# MMM its first three letters, MM month 01-12, M 1-12, dd day 01-31, d 1-31, EEEE weekday name, EEE its first three
# letters, HH hour 00-23, H 0-23, mm minute, ss second, SSS millisecond); any other character, and text in 'single
# quotes', is itself. relative_time(t, now) says "3 minutes ago", "in 2 days" or "just now".

DAY_MS := 86400000
HOUR_MS := 3600000
MINUTE_MS := 60000
SECOND_MS := 1000
WEEK_MS := 604800000
MONTH_MS := 30 * DAY_MS
YEAR_MS := 365 * DAY_MS
# within this, a relative time is "just now"
JUST_NOW_MS := 5000
MONTH_NAMES := ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
WEEKDAY_NAMES := ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
# the months of 30 days
SHORT_MONTHS := [4, 6, 9, 11]

class Instant { ms: int }
class Duration { ms: int }
class Pattern { written: text }
now(): Instant := Instant(wall_clock_ms())

# --- the calendar: a day number (days since 1970-01-01) and its proleptic Gregorian date

class Date { year: int, month: int, day: int }
# Howard Hinnant's days_from_civil and civil_from_days
days_from_civil(year: int, month: int, day: int): int := {
	y = if month <= 2 then year - 1 else year
	era = y ÷ 400
	of_era = y - era * 400
	day_of_year = (153 * (if month > 2 then month - 3 else month + 9) + 2) ÷ 5 + day - 1
	day_of_era = of_era * 365 + of_era ÷ 4 - of_era ÷ 100 + day_of_year
	era * 146097 + day_of_era - 719468
}
date_of_day(days: int): Date := {
	z = days + 719468
	era = z ÷ 146097
	day_of_era = z - era * 146097
	of_era = (day_of_era - day_of_era ÷ 1460 + day_of_era ÷ 36524 - day_of_era ÷ 146096) ÷ 365
	day_of_year = day_of_era - (365 * of_era + of_era ÷ 4 - of_era ÷ 100)
	shifted = (5 * day_of_year + 2) ÷ 153
	month = if shifted < 10 then shifted + 3 else shifted - 9
	Date(of_era + era * 400 + (if month <= 2 then 1 else 0), month, day_of_year - (153 * shifted + 2) ÷ 5 + 1)
}
is_leap_year(year: int): bool := year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
days_in_month(year: int, month: int): int := if month == 2 then (if is_leap_year(year) then 29 else 28) else if SHORT_MONTHS.contains(month) then 30 else 31
day_number(i: Instant): int := i.ms ÷ DAY_MS
date_of(i: Instant): Date := date_of_day(day_number(i))
# the time since the instant's midnight
day_time(i: Instant): Duration := Duration(i.ms % DAY_MS)
# ISO weekday: Monday 1 … Sunday 7
weekday(i: Instant): int := (day_number(i) + 3) % 7 + 1
padded(n: int, width: int): text := {
	digits = "${abs(n)}"
	(if n < 0 then "-" else "") + "0" * max(0, width - #digits - (if n < 0 then 1 else 0)) + digits
}
# ISO 8601: 2026-10-07 and 13:05:09
date(i: Instant): text := format(i, Pattern("yyyy-MM-dd"))
time(i: Instant): text := format(i, Pattern("HH:mm:ss"))
text(i: Instant): text := if i.ms % DAY_MS == 0 then date(i) else "${date(i)}T${time(i)}Z"
# "2026-10-07" or "2026-10-07T13:05:09Z" as an Instant
Instant(t: text): Instant := if #t > 10 then parse(t, Pattern("yyyy-MM-dd'T'HH:mm:ss'Z'")) else parse(t, Pattern("yyyy-MM-dd"))

# --- patterns

# one part of a pattern: a field, its letter written run times, or literal text
enum PatternPart { Field(letter: text, run: int), Literal(written: text) }
# an instant's fields by their pattern letters: y M d, the weekday E, H m s and the millisecond S
fields_of(i: Instant): map<text, int> := {
	date = date_of(i)
	of_day = i.ms % DAY_MS
	{y: date.year, M: date.month, d: date.day, E: weekday(i), H: of_day ÷ HOUR_MS, m: of_day % HOUR_MS ÷ MINUTE_MS, s: of_day % MINUTE_MS ÷ SECOND_MS, S: of_day % SECOND_MS}
}
# the fields of 1970-01-01 00:00:00.000, which a parsed text lacking a field takes
EPOCH_FIELDS = fields_of(Instant(0))
pattern_parts(pattern: text): list<PatternPart> := {
	parts: list<PatternPart> = []
	i = 0
	while i < #pattern {
		c = pattern[i:i + 1]
		if c == "'" {
			closing = i + 1
			while closing < #pattern and pattern[closing:closing + 1] != "'" { closing += 1 }
			parts.add(Literal(if closing == i + 1 then "'" else pattern[i + 1:closing]))
			i = closing + 1
		} else if EPOCH_FIELDS.has(c) {
			run = 1
			while i + run < #pattern and pattern[i + run:i + run + 1] == c { run += 1 }
			parts.add(Field(c, run))
			i += run
		} else {
			parts.add(Literal(c))
			i += 1
		}
	}
	parts
}
# the names a field is written in, what they name, and their run: three letters or more
class Names { names: list<text>, kind: text }
WEEKDAYS = Names(WEEKDAY_NAMES, "weekday")
MONTHS = Names(MONTH_NAMES, "month")
NAMED_RUN := 3
# the names of a field written in words, ø for one written in digits: E, EEE, EEEE, and MMM, MMMM
names_of(letter: text, run: int): Names? := if letter == "E" then WEEKDAYS else if letter == "M" and run >= NAMED_RUN then MONTHS else ø
# a name at its run's length: four letters or more the whole name, else its first three
name_at(names: Names, place: int, run: int): text := if run > NAMED_RUN then names.names[place - 1] else names.names[place - 1][0:NAMED_RUN]
# yy, the year in two digits, of this century
is_short_year(letter: text, run: int): bool := letter == "y" and run == 2
CENTURY := 2000
format(i: Instant, pattern: Pattern): text := {
	fields = fields_of(i)
	pattern_parts(pattern.written).map(part => part_text(part, fields)).join("")
}
part_text(part: PatternPart, fields: map<text, int>): text := match part {
	Literal(written) => written
	Field(letter, run) => field_text(letter, run, fields[letter])
}
field_text(letter: text, run: int, n: int): text := {
	names = names_of(letter, run)
	if names != ø then name_at(names, n, run)
	else if is_short_year(letter, run) then padded(n % 100, 2)
	else padded(n, run)
}
digits_at(t: text, at: int): int := {
	n = 0
	while at + n < #t and is_digits(t[at + n:at + n + 1]) { n += 1 }
	n
}
mismatch(t: text, pattern: Pattern, at: int, expected: text): never := raise "parse: \"${t}\" does not match \"${pattern.written}\": ${expected} expected at character ${at + 1}"
# the place of the name among names that t has at at, from 1; ø for none
name_found(t: text, at: int, names: Names, run: int): int? := {
	for place in 1 to #names.names {
		name = name_at(names, place, run)
		if lower(t[at:at + #name]) == lower(name) { return place }
	}
	ø
}
parse(t: text, pattern: Pattern): Instant := {
	given = fields_of(Instant(0))
	at = 0
	for part in pattern_parts(pattern.written) {
		at = match part {
			Literal(written) => literal_read(t, pattern, at, written)
			Field(letter, run) => field_read(t, pattern, at, letter, run, given)
		}
	}
	if at != #t { mismatch(t, pattern, at, "the end") }
	if given["M"] < 1 or given["M"] > 12 or given["d"] < 1 or given["d"] > days_in_month(given["y"], given["M"]) { raise "parse: ${t} names no date" }
	if given["H"] > 23 or given["m"] > 59 or given["s"] > 59 { raise "parse: ${t} names no time of day" }
	Instant(days_from_civil(given["y"], given["M"], given["d"]) * DAY_MS + given["H"] * HOUR_MS + given["m"] * MINUTE_MS + given["s"] * SECOND_MS + given["S"])
}
# the place after the literal text at at
literal_read(t: text, pattern: Pattern, at: int, written: text): int := {
	if t[at:at + #written] != written { mismatch(t, pattern, at, "'${written}'") }
	at + #written
}
# the field at at read into given, and the place after it: a name, or digits, as many as follow for a field of one
# letter, else exactly its run
field_read(t: text, pattern: Pattern, at: int, letter: text, run: int, given: map<text, int>): int := {
	names = names_of(letter, run)
	if names != ø {
		place = name_found(t, at, names, run) ?? mismatch(t, pattern, at, "a ${names.kind} name")
		given[letter] = place
		return at + #name_at(names, place, run)
	}
	width = if run == 1 then digits_at(t, at) else run
	if width == 0 or digits_at(t, at) < width { mismatch(t, pattern, at, "${run} digits") }
	n = int(t[at:at + width])
	given[letter] = if is_short_year(letter, run) then CENTURY + n else n
	at + width
}

# --- durations

# a unit of time: its long name, its milliseconds, its short name in a duration and its ISO 8601 designator, ø where
# it has none; years and months of relative times count 365 and 30 days
class TimeUnit { long: text, ms: int, short: text?, iso: text? }
TIME_UNITS := [TimeUnit("year", YEAR_MS, ø, ø), TimeUnit("month", MONTH_MS, ø, ø), TimeUnit("week", WEEK_MS, ø, "W"), TimeUnit("day", DAY_MS, "d", "D"), TimeUnit("hour", HOUR_MS, "h", "H"), TimeUnit("minute", MINUTE_MS, "m", "M"), TimeUnit("second", SECOND_MS, "s", "S"), TimeUnit("millisecond", 1, "ms", ø)]
# the units a duration is written in, d h m s ms
DURATION_UNITS = TIME_UNITS.filter(u => u.short != ø)
# the units a relative time counts in, years down to seconds
SPAN_UNITS = TIME_UNITS.filter(u => u.ms >= SECOND_MS)
+(a: Duration, b: Duration): Duration := Duration(a.ms + b.ms)
-(a: Duration, b: Duration): Duration := Duration(a.ms - b.ms)
*(d: Duration, k: int): Duration := Duration(d.ms * k)
*(k: int, d: Duration): Duration := d * k
+(i: Instant, d: Duration): Instant := Instant(i.ms + d.ms)
-(i: Instant, d: Duration): Instant := Instant(i.ms - d.ms)
-(a: Instant, b: Instant): Duration := Duration(a.ms - b.ms)
==(a: Duration, b: Duration): bool := a.ms == b.ms
==(a: Instant, b: Instant): bool := a.ms == b.ms
<(a: Instant, b: Instant): bool := a.ms < b.ms
<(a: Duration, b: Duration): bool := a.ms < b.ms
abs(d: Duration): Duration := Duration(abs(d.ms))
# the whole days of a duration, rounded down: `days(Duration("36h"))` is 1
days(d: Duration): int := d.ms ÷ DAY_MS

# "1h30m", "2d 4h", "500ms", or ISO 8601's "PT1H30M", as a Duration
Duration(t: text): Duration := Duration(if t.starts_with("P") then iso_ms(t) else short_ms(t))
refused_duration(t: text, why: text): never := raise "\"${t}\" as Duration: ${why}"
# whole numbers each with its unit (d h m s ms), blanks between them allowed
short_ms(t: text): int := {
	total = 0
	at = 0
	amounts = 0
	while at < #t {
		if t[at:at + 1] == " " {
			at += 1
		} else {
			digits = digits_at(t, at)
			if digits == 0 { refused_duration(t, "a number expected at character ${at + 1} (like 1h30m, 2d 4h, 500ms)") }
			n = int(t[at:at + digits])
			at += digits
			start = at
			while at < #t and t[at:at + 1] != " " and digits_at(t, at) == 0 { at += 1 }
			unit = t[start:at]
			found = DURATION_UNITS.filter(u => u.short == unit)
			if found is empty { refused_duration(t, "unknown unit \"${unit}\" after ${n} (d, h, m, s or ms)") }
			total += n * found[0].ms
			amounts += 1
		}
	}
	if amounts == 0 { refused_duration(t, "it names no duration (like 1h30m, 2d 4h, 500ms)") }
	total
}
# ISO 8601 durations of weeks, days and times: "PT1H30M", "P2DT4H", "P1W", "PT0.5S"; years and months have no fixed
# length, so P1Y and P1M are refused
iso_ms(t: text): int := {
	total = 0
	in_time = no
	at = 1
	while at < #t {
		if t[at:at + 1] == "T" {
			in_time = yes
			at += 1
		} else {
			start = at
			while at < #t and (digits_at(t, at) > 0 or t[at:at + 1] == ".") { at += 1 }
			if at == start or at >= #t { refused_duration(t, "a number and its designator expected at character ${start + 1}") }
			amount = float(t[start:at])
			designator = t[at:at + 1]
			at += 1
			found = TIME_UNITS.filter(u => u.iso == designator and (u.ms < DAY_MS) == in_time)
			if found is empty { refused_duration(t, "no designator ${designator} here (years and months have no fixed length)") }
			total += round(amount * float(found[0].ms))
		}
	}
	total
}
# how many of a unit
class Amount { count: int, unit: TimeUnit }
# the units of ms from the largest down, the zero ones left out
parts_of(ms: int): list<Amount> := {
	rest = abs(ms)
	parts: list<Amount> = []
	for unit in DURATION_UNITS {
		amount = rest ÷ unit.ms
		if amount > 0 { parts.add(Amount(amount, unit)) }
		rest = rest % unit.ms
	}
	parts
}
sign_of(ms: int): text := if ms < 0 then "-" else ""
# "1h 30m", "0s"
text(d: Duration): text := if d.ms == 0 then "0s" else sign_of(d.ms) + parts_of(d.ms).map(part => "${part.count}${part.unit.short}").join(" ")
counted(n: int, word: text): text := "${n} ${word}" + (if n == 1 then "" else "s")
# "1 hour 30 minutes" with long, "PT1H30M" with iso
format(d: Duration, long: bool = no, iso: bool = no): text := {
	if long { return if d.ms == 0 then "0 seconds" else sign_of(d.ms) + parts_of(d.ms).map(part => counted(part.count, part.unit.long)).join(" ") }
	if iso { return iso_text(d.ms) }
	raise "format(${text(d)}) names no style: write d as text, or format(d, long: yes), format(d, iso: yes)"
}
iso_text(ms: int): text := {
	if ms == 0 { return "PT0S" }
	rest = abs(ms)
	days = rest ÷ DAY_MS
	rest = rest % DAY_MS
	hours = rest ÷ HOUR_MS
	minutes = rest % HOUR_MS ÷ MINUTE_MS
	millis = rest % MINUTE_MS
	seconds = if millis == 0 then "" else if millis % SECOND_MS == 0 then "${millis ÷ SECOND_MS}S" else "${float(millis) / float(SECOND_MS)}S"
	clock = (if hours > 0 then "${hours}H" else "") + (if minutes > 0 then "${minutes}M" else "") + seconds
	sign_of(ms) + "P" + (if days > 0 then "${days}D" else "") + (if clock == "" then "" else "T" + clock)
}

# --- relative times

relative_time(t: Instant, now: Instant): text := relative_time(t.ms, now.ms)
relative_time(t: int, now: int): text := {
	difference = t - now
	size = abs(difference)
	if size < JUST_NOW_MS { return "just now" }
	unit = SPAN_UNITS.filter(u => size >= u.ms)[0]
	amount = counted(size ÷ unit.ms, unit.long)
	if difference < 0 then "${amount} ago" else "in ${amount}"
}

# --- time zones (wiki/time.md "Time zones"): the offset a zone has at an instant under the European and United States
# daylight saving rules, and the instant a wall time means there. Times here are whole seconds since 1970, offsets
# seconds east of UTC.

HOUR_SECONDS := 3600
DAY_SECONDS := 86400

# the daylight saving rule of a zone: none; the last Sunday of March to the last Sunday of October, switching at 01:00
# UTC (since 1996); the second Sunday of March to the first Sunday of November, switching at 02:00 local time (since
# 2007)
enum Dst { Never, Europe, UnitedStates }
# which instant a wall time means when a transition skips or repeats it
enum Disambiguation { Reject, Earlier, Later }
class Zone { name: text, standard: int, dst: Dst }

# the embedded subset of the IANA database
TIME_ZONES := [Zone("UTC", 0, Never), Zone("Etc/UTC", 0, Never), Zone("Europe/London", 0, Europe),
	Zone("Europe/Dublin", 0, Europe), Zone("Europe/Lisbon", 0, Europe), Zone("Europe/Berlin", 3600, Europe),
	Zone("Europe/Paris", 3600, Europe), Zone("Europe/Madrid", 3600, Europe), Zone("Europe/Rome", 3600, Europe),
	Zone("Europe/Amsterdam", 3600, Europe), Zone("Europe/Brussels", 3600, Europe), Zone("Europe/Vienna", 3600, Europe),
	Zone("Europe/Zurich", 3600, Europe), Zone("Europe/Stockholm", 3600, Europe), Zone("Europe/Oslo", 3600, Europe),
	Zone("Europe/Copenhagen", 3600, Europe), Zone("Europe/Warsaw", 3600, Europe), Zone("Europe/Prague", 3600, Europe),
	Zone("Europe/Budapest", 3600, Europe), Zone("Europe/Athens", 7200, Europe), Zone("Europe/Helsinki", 7200, Europe),
	Zone("Europe/Kyiv", 7200, Europe), Zone("Europe/Bucharest", 7200, Europe), Zone("Europe/Istanbul", 10800, Never),
	Zone("Europe/Moscow", 10800, Never), Zone("Asia/Dubai", 14400, Never), Zone("Asia/Kolkata", 19800, Never),
	Zone("Asia/Shanghai", 28800, Never), Zone("Asia/Singapore", 28800, Never), Zone("Asia/Tokyo", 32400, Never),
	Zone("Australia/Brisbane", 36000, Never), Zone("America/Sao_Paulo", -10800, Never),
	Zone("America/New_York", -18000, UnitedStates), Zone("America/Chicago", -21600, UnitedStates),
	Zone("America/Denver", -25200, UnitedStates), Zone("America/Phoenix", -25200, Never),
	Zone("America/Los_Angeles", -28800, UnitedStates), Zone("America/Anchorage", -32400, UnitedStates),
	Zone("Pacific/Honolulu", -36000, Never)]

zone_named(name: text): Zone := {
	for zone in TIME_ZONES { if zone.name == name { return zone } }
	raise "unknown time zone ${name}: not in the time zone rules (lib/time.wap TIME_ZONES)"
}
# the day number of the last Sunday of a month, and of its n-th from 1
last_sunday(year: int, month: int): int := {
	last = days_from_civil(year, month, days_in_month(year, month))
	last - ((last + 3) % 7 + 1) % 7
}
nth_sunday(year: int, month: int, n: int): int := {
	first = days_from_civil(year, month, 1)
	first + (7 - ((first + 3) % 7 + 1)) % 7 + 7 * (n - 1)
}
# whether seconds since 1970 fall in a zone's summer time of that year
european_summer(year: int, seconds: int): bool :=
	seconds >= last_sunday(year, 3) * DAY_SECONDS + HOUR_SECONDS and seconds < last_sunday(year, 10) * DAY_SECONDS + HOUR_SECONDS
united_states_summer(year: int, seconds: int, standard: int): bool := {
	start = nth_sunday(year, 3, 2) * DAY_SECONDS + 2 * HOUR_SECONDS - standard
	end = nth_sunday(year, 11, 1) * DAY_SECONDS + HOUR_SECONDS - standard
	seconds >= start and seconds < end
}
in_summer(zone: Zone, seconds: int): bool := {
	year = date_of_day(seconds ÷ DAY_SECONDS).year
	match zone.dst {
		Never: no
		Europe: european_summer(year, seconds)
		UnitedStates: united_states_summer(year, seconds, zone.standard)
	}
}
# seconds east of UTC in effect in a zone at seconds since 1970
zone_offset(zone: Zone, seconds: int): int := if in_summer(zone, seconds) then zone.standard + HOUR_SECONDS else zone.standard
# the instant (seconds since 1970) a wall time (seconds since 1970 on the zone's wall clock) means in a zone: of the
# summer and the winter offset, those that hold at the instant they give; one is the answer, none (skipped by a
# transition) or both (repeated) need the choice
zone_instant(zone: Zone, wall: int, choice: Disambiguation = Reject): int := {
	later = wall - zone.standard
	if zone.dst == Never { return later }
	earlier = later - HOUR_SECONDS
	earlier_holds = zone_offset(zone, earlier) == zone.standard + HOUR_SECONDS
	later_holds = zone_offset(zone, later) == zone.standard
	if earlier_holds != later_holds { return if earlier_holds then earlier else later }
	match choice {
		Earlier: earlier
		Later: later
		Reject: raise(if earlier_holds then "that wall time is ambiguous in ${zone.name}: it occurs twice, the clocks are set back by a daylight saving transition; choose disambiguation: earlier or later" else "that wall time does not exist in ${zone.name}: it is skipped by a daylight saving transition; choose disambiguation: earlier or later")
	}
}
