# The standard module timers (wiki/signal.md "Signals from outside"): `on every(500ms) { … }` runs its block at each
# period. A handler never runs in the middle of main: the timers run once the run's main is over, each at its beat, and
# keep the run going until one ends it with exit(code).
use units
use list

# a period of time, as `every(500ms)` gives it, kept until `on` gives it a handler
class Period { milliseconds: int }

# a started timer: its period, when it is due next on the wall clock, and what it runs
class Timer { milliseconds: int, due: int, handler: () -> any }

# the program's timers, in the order they started
timers: list<Timer> = []

every(interval: Quantity): Period := {
	milliseconds = round(interval in ms)
	if milliseconds <= 0 { raise "every(${interval}): a timer's period is longer than no time" }
	Period(milliseconds)
}

on(period: Period, handler: () -> any): Timer := {
	timer = Timer(period.milliseconds, wall_clock_ms() + period.milliseconds, handler)
	timers.add(timer)
	timer
}

# the run's end: the timers fire in turn, the one due first next, each keeping its beat; one fallen behind by more
# than its period goes on from now
export finished() := {
	while timers is not empty {
		next = timers.min_by(timer => timer.due)
		wait = next.due - wall_clock_ms()
		if wait > 0 { sleep_ms(wait) }
		beat = next.due + next.milliseconds
		next.due = if beat > wall_clock_ms() then beat else wall_clock_ms() + next.milliseconds
		next.handler()
	}
}
