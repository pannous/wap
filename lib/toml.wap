# The standard module toml (wiki/library-config-formats.md): TOML text read into maps and lists, and written back.
# parse_toml(t) gives a map: [tables] and [[arrays of tables]] by their dotted names, bare, quoted and dotted keys,
# "basic" (with backslash escapes) and 'literal' strings, integers (1_000), floats, true and false, arrays (also over
# several lines) and inline tables; a date or time stays the text it is written as. A key twice is refused, naming
# its line. to_toml(m) writes a map's plain values first, then each map as a [table] and each list of maps as
# [[tables]]; a whole float keeps its .0 so that it reads back a float.
use text
use map

# --- reading

# where a token ends: at a comma, a closing bracket or brace, a blank, or the end
TOKEN_ENDS := ",]} \t\n"

refused_line(number: int, why: text): never := raise "toml line ${number}: ${why}"

# the keys of a dotted key, each unquoted
keys_of(t: text): list<text> := split_outside_quotes(trim(t), ".").map(key => unquoted_key(trim(key)))
unquoted_key(key: text): text := if key.starts_with("\"") then unescaped(key[1:#key - 1]) else if key.starts_with("'") then key[1:#key - 1] else key

# the map at the keys below m, made where missing; a list of tables gives its last table
table_at(m: map<text, any>, keys: list<text>): map<text, any> := keys.fold(m, (table, key) => {
	if not table.has(key) {
		fresh: map<text, any> = {}
		table[key] = fresh
	}
	inner_table(table[key])
})
inner_table(value: any): map<text, any> := if is_list(value) then last_table(value as list<any>) else value as map<text, any>
# TODO (sent to wap-lead) inline in inner_table once two `as` in one expression no longer clash
last_table(tables: list<any>): map<text, any> := tables.last as map<text, any>
# the list of tables at the keys below m, made where missing
tables_at(m: map<text, any>, keys: list<text>): list<any> := {
	parent = table_at(m, keys.take(#keys - 1))
	if not parent.has(keys.last) {
		fresh: list<any> = []
		parent[keys.last] = fresh
	}
	parent[keys.last] as list<any>
}

# how many brackets and braces are open after the text, quotes skipped
open_brackets(t: text): int := {
	count = 0
	for opening in ["[", "{"] {
		count += split_outside_quotes(t, opening).count - 1
	}
	for closing in ["]", "}"] {
		count -= split_outside_quotes(t, closing).count - 1
	}
	count
}

# the keys a table header names inside its brackets, depth of them: [a.b] or [[a.b]]; a header left open is refused
header_keys(line: text, depth: int, number: int): list<text> := {
	closing = "]" * depth
	if not line.ends_with(closing) { refused_line(number, "${line} is not closed by ${closing}") }
	keys_of(line[depth:#line - depth])
}
parse_toml(source: text): map<text, any> := {
	root: map<text, any> = {}
	current = root
	lines = source.replace("\r\n", "\n").split("\n")
	i = 0
	while i < #lines {
		number = i + 1
		line = trim(without_comment(lines[i], "#"))
		i += 1
		if line == "" { }
		else if line.starts_with("[[") {
			table: map<text, any> = {}
			tables_at(root, header_keys(line, 2, number)).add(table)
			current = table
		} else if line.starts_with("[") {
			current = table_at(root, header_keys(line, 1, number))
		} else {
			equals = place_outside_quotes(line, "=", 0) ?? refused_line(number, "no = in ${line}")
			written = line[equals + 1:]
			while open_brackets(written) > 0 and i < #lines {
				written += "\n" + without_comment(lines[i], "#")
				i += 1
			}
			keys = keys_of(line[0:equals])
			table = table_at(current, keys.take(#keys - 1))
			if table.has(keys.last) { refused_line(number, "the key ${keys.join(".")} twice") }
			s = Scan(trim(written), 0)
			table[keys.last] = value_of(s)
			if trim(rest_of(s)) != "" { refused_line(number, "${trim(rest_of(s))} after the value") }
		}
	}
	root
}

# the value at the scan, the scan after it
value_of(s: Scan): any := {
	skip_blanks(s)
	c = next_of(s)
	if c == "\"" then quoted_at(s)
	else if c == "'" then literal_at(s)
	else if c == "[" then array_of(s)
	else if c == "{" then inline_table_of(s)
	else token_value(s)
}
# a 'literal' string as written
literal_at(s: Scan): text := {
	closing = find(s.source[s.at + 1:], "'") + s.at
	inside = s.source[s.at + 1:closing]
	s.at = closing + 1
	inside
}
array_of(s: Scan): list<any> := {
	items: list<any> = []
	s.at += 1
	while more_items(s, "]") { items.add(value_of(s)) }
	items
}
inline_table_of(s: Scan): map<text, any> := {
	table: map<text, any> = {}
	s.at += 1
	while more_items(s, "}") {
		equals = place_outside_quotes(s.source, "=", s.at) ?? raise("toml: an inline table entry without =")
		keys = keys_of(s.source[s.at:equals])
		s.at = equals + 1
		table_at(table, keys.take(#keys - 1))[keys.last] = value_of(s)
	}
	table
}
# the scan moved past the token at it
token_skipped(s: Scan) := { while s.at < #s.source and not TOKEN_ENDS.contains(next_of(s)) { s.at += 1 } }
# true, false, a number, or a date or time kept as its text
token_value(s: Scan): any := {
	start = s.at
	token_skipped(s)
	token = s.source[start:s.at]
	# a date and a time may be parted by one space
	if is_date(token) and next_of(s) == " " and "0123456789".contains(s.source[s.at + 1:s.at + 2]) {
		s.at += 1
		token_skipped(s)
		return s.source[start:s.at]
	}
	number = spelled_number(token)
	if token == "true" then yes
	else if token == "false" then no
	else if number != ø then number
	else if is_date(token) or token.contains(":") then token
	else raise "toml: ${token} is no value"
}
is_date(token: text): bool := #token >= 10 and token[4:5] == "-" and token[7:8] == "-"

# --- writing

is_tables(value: any): bool := is_list(value) and holds_tables(value)
holds_tables(xs: list<T>): bool := #xs > 0 and xs.all(x => is_map(x))
key_text(key: text): text := if key != "" and key.codepoints.all(c => (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '-') then key else double_quoted(key)
value_text(value: any): text := {
	if value is text then double_quoted("${value}")
	else if value is bool then (if value == yes then "true" else "false")
	else if value is float then float_text(value)
	else if is_list(value) then list_text(value)
	else if is_map(value) then inline_text(value)
	else "${value}"
}
float_text(x: float): text := if "${x}".contains(".") or "${x}".contains("e") then "${x}" else "${x}.0"
list_text(xs: list<T>): text := "[" + xs.map(x => value_text(x)).join(", ") + "]"
inline_text(m: map<text, V>): text := "{" + m.keys().map(key => "${key_text(key)} = ${value_text(m[key])}").join(", ") + "}"

to_toml(m: map<text, V>): text := table_text(m, "")
# a table's plain values, then its tables and lists of tables under their dotted names
table_text(m: map<text, V>, prefix: text): text := {
	plain = m.keys().filter(key => not is_section(m[key])).map(key => "${key_text(key)} = ${value_text(m[key])}\n").join("")
	nested = m.keys().filter(key => is_section(m[key])).map(key => section_text(m[key], prefix + key_text(key))).join("")
	plain + nested
}
is_section(value: any): bool := is_map(value) or is_tables(value)
section_text(value: any, name: text): text := if is_map(value) then "\n[${name}]\n" + table_text(value, name + ".") else array_sections(value, name)
array_sections(tables: list<T>, name: text): text := tables.map(table => array_section(table, name)).join("")
# one table of a list (any, as the list's item type need not be a map)
array_section(table: any, name: text): text := "\n[[${name}]]\n" + table_text(table, name + ".")
