# The standard module ui (wiki/standard-library.md "ui"): `use ui`, then `c = slider(-2 to 2)` is a UI value. Its start
# is the middle of the range; `slider(-2, 2)` is the same, and `slider(-2 to 2, -0.8)` starts at a value in the range.
# A value outside is refused. The playground shows a control and reruns the program with the new value.

slider(low: float, high: float, value: float): float := {
	if high < low { raise "slider: ${low} to ${high} is empty" }
	if value < low or value > high { raise "slider: ${value} is outside ${low} to ${high}" }
	value
}
slider(low: float, high: float): float := slider(low, high, (low + high) / 2)
slider(span: Range, value: float): float := slider(float(span.from), float(span.last), value)
slider(span: Range): float := slider(float(span.from), float(span.last))
