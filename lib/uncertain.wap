# The standard module uncertain (wiki/number.md "Uncertain values"): `use uncertain`. `x ± r` is a worst-case
# interval, `(5 ± 1) + (2 ± 1)` is 7.0 ± 2.0; `x ± r * σ` a Gaussian of r standard deviations, independent ones added
# in quadrature, `(5 ± σ) + (2 ± σ)` is 7.0 ± 1.4σ. Each shows only the digits its spread justifies, two significant
# digits of the ± part. < and > answer yes only when certain; possibly_less and possibly_greater when some of it is.

# a ± part shown to this many significant digits: it lies in [9.5, 99.5) at its shown scale
SHOWN_LOW := 9.5
SHOWN_HIGH := 99.5
# the most decimals a float holds
FLOAT_DIGITS := 17
LARGEST_SCALED := 1e17

# An interval with its value: worst-case bounds, no correlation, so `x - x` is 0 ± 2
class Interval { value: float, low: float, high: float }
# one independent Gaussian's share of another's deviation: ∂/∂that · its σ
class Contribution { id: int, amount: float }
# `5 ± 1 * σ`: one standard deviation about the value; arithmetic propagates linearly and adds independent deviations
# in quadrature, a value met twice is one error (Measurements.jl), so `x - x` is 0 ± 0σ
class Gaussian { value: float, contributions: list<Contribution> }
# a spread counted in standard deviations: `0.3 * σ`
class Deviation { amount: float }
σ := Deviation(1.0)

# each Gaussian made by ± is independent of all others: its own id
global gaussian_count = 0

# --- making them

infix operator ±(value: float, radius: float): Interval := {
	if radius < 0.0 { raise "an uncertainty must not be negative" }
	Interval(value, value - radius, value + radius)
}
infix operator ±(value: float, spread: Deviation): Gaussian := {
	if spread.amount < 0.0 { raise "an uncertainty must not be negative" }
	gaussian_count += 1
	Gaussian(value, [Contribution(gaussian_count, spread.amount)])
}
*(a: float, d: Deviation): Deviation := Deviation(a * d.amount)
interval(x: float): Interval := Interval(x, x, x)
gaussian(x: float): Gaussian := Gaussian(x, [])

# --- intervals

+(a: Interval, b: Interval): Interval := Interval(a.value + b.value, a.low + b.low, a.high + b.high)
-(a: Interval, b: Interval): Interval := Interval(a.value - b.value, a.low - b.high, a.high - b.low)
*(a: Interval, b: Interval): Interval := spanned(a.value * b.value, [a.low * b.low, a.low * b.high, a.high * b.low, a.high * b.high])
/(a: Interval, b: Interval): Interval := spanned(a.value / b.value, [a.low / b.low, a.low / b.high, a.high / b.low, a.high / b.high])
# the value and the extreme corners: least and greatest of the endpoint results
spanned(value: float, corners: list<float>): Interval := Interval(value, min(corners), max(corners))
# `y < x` certainly: the whole interval below
<(a: Interval, b: Interval): bool := a.high < b.low
>(a: Interval, b: Interval): bool := a.low > b.high
possibly_less(a: Interval, b: Interval): bool := a.low < b.high
possibly_greater(a: Interval, b: Interval): bool := a.high > b.low
# the intervals overlap
≈(a: Interval, b: Interval): bool := a.low <= b.high and b.low <= a.high
==(a: Interval, b: Interval): bool := a.value == b.value and a.low == b.low and a.high == b.high
# how far the interval reaches from its value, on its farther side
uncertainty(x: Interval): float := max(x.high - x.value, x.value - x.low)
# its bounds as handed out, to the digits its spread justifies
low_bound(x: Interval): float := guarded_bound(x.low, uncertainty(x))
high_bound(x: Interval): float := guarded_bound(x.high, uncertainty(x))
# √ rises, so it maps the bounds: √(2.0 ± 0.01) spans √1.99 … √2.01
√(x: Interval): Interval := Interval(sqrt(x.value), sqrt(x.low), sqrt(x.high))
text(x: Interval): text := uncertain_text(x.value, uncertainty(x), "")

# a number on either side is the interval it is
# TODO (card library-widening) one widening instead of these pairs
+(a: Interval, b: float): Interval := a + interval(b)
+(a: float, b: Interval): Interval := interval(a) + b
-(a: Interval, b: float): Interval := a - interval(b)
-(a: float, b: Interval): Interval := interval(a) - b
*(a: Interval, b: float): Interval := a * interval(b)
*(a: float, b: Interval): Interval := interval(a) * b
/(a: Interval, b: float): Interval := a / interval(b)
/(a: float, b: Interval): Interval := interval(a) / b
<(a: Interval, b: float): bool := a < interval(b)
>(a: Interval, b: float): bool := a > interval(b)

# --- Gaussians

+(a: Gaussian, b: Gaussian): Gaussian := combined(a.value + b.value, a, 1.0, b, 1.0)
-(a: Gaussian, b: Gaussian): Gaussian := combined(a.value - b.value, a, 1.0, b, -1.0)
*(a: Gaussian, b: Gaussian): Gaussian := combined(a.value * b.value, a, b.value, b, a.value)
/(a: Gaussian, b: Gaussian): Gaussian := combined(a.value / b.value, a, 1.0 / b.value, b, 0.0 - a.value / (b.value * b.value))
# the Gaussian `value` whose contributions are a's times ∂a and b's times ∂b, those of one id summed
combined(value: float, a: Gaussian, da: float, b: Gaussian, db: float): Gaussian := {
	merged = a.contributions.map(c => Contribution(c.id, c.amount * da))
	for c in b.contributions {
		at = merged.index_where(m => m.id == c.id)
		if at == 0 { merged.add(Contribution(c.id, c.amount * db)) }
		else { merged[at - 1] = Contribution(c.id, merged#at.amount + c.amount * db) }
	}
	Gaussian(value, merged)
}
# σ: √(Σ contribution²)
deviation(g: Gaussian): float := sqrt(g.contributions.map(c => c.amount * c.amount).sum)
uncertainty(g: Gaussian): float := deviation(g)
low_bound(g: Gaussian): float := g.value - deviation(g)
high_bound(g: Gaussian): float := g.value + deviation(g)
<(a: Gaussian, b: Gaussian): bool := high_bound(a) < low_bound(b)
>(a: Gaussian, b: Gaussian): bool := low_bound(a) > high_bound(b)
≈(a: Gaussian, b: Gaussian): bool := low_bound(a) <= high_bound(b) and low_bound(b) <= high_bound(a)
==(a: Gaussian, b: Gaussian): bool := a.value == b.value and deviation(a) == deviation(b)
# linear propagation: d√x = dx / (2√x)
√(g: Gaussian): Gaussian := combined(sqrt(g.value), g, 0.5 / sqrt(g.value), gaussian(0.0), 0.0)
text(g: Gaussian): text := uncertain_text(g.value, deviation(g), "σ")

# TODO (card library-widening) one widening instead of these pairs
+(a: Gaussian, b: float): Gaussian := a + gaussian(b)
+(a: float, b: Gaussian): Gaussian := gaussian(a) + b
-(a: Gaussian, b: float): Gaussian := a - gaussian(b)
-(a: float, b: Gaussian): Gaussian := gaussian(a) - b
*(a: Gaussian, b: float): Gaussian := a * gaussian(b)
*(a: float, b: Gaussian): Gaussian := gaussian(a) * b
/(a: Gaussian, b: float): Gaussian := a / gaussian(b)
/(a: float, b: Gaussian): Gaussian := gaussian(a) / b

# --- text

# the ± part to 2 significant digits, the value to the same place, 7.0 ± 2.0; a ± part of 0 or ∞, or past a float's
# digits, as each float prints; unit follows the ± part (σ for a Gaussian)
uncertain_text(value: float, radius: float, unit: text): text := {
	if not (radius > 0.0 and is_finite(radius)) { return "${value} ± ${radius}${unit}" }
	decimals = shown_decimals(radius)
	scale = 10.0 ^ decimals
	if decimals > FLOAT_DIGITS or abs(value) * scale >= LARGEST_SCALED { return "${value} ± ${radius}${unit}" }
	shown = max(decimals, 0)
	place_text(value, scale, shown) + " ± " + place_text(radius, scale, shown) + unit
}
# the decimal place a ± part of this radius shows to, its two significant digits: 2 for 0.3, -1 for 300
shown_decimals(radius: float): int := {
	decimals = 0
	while radius * 10.0 ^ decimals < SHOWN_LOW and decimals <= FLOAT_DIGITS { decimals += 1 }
	while radius * 10.0 ^ decimals >= SHOWN_HIGH { decimals -= 1 }
	decimals
}
# x rounded to the place of 1/scale with that many decimals, a half away from zero
place_text(x: float, scale: float, decimals: int): text := {
	sign = if x < 0.0 then "-" else ""
	if decimals == 0 { return sign + "${round(floor(abs(x) * scale + 0.5) / scale)}" }
	digits = round(abs(x) * scale)
	fraction = ""
	while #fraction < decimals {
		fraction = "${digits % 10}" + fraction
		digits = digits ÷ 10
	}
	sign + "${digits}." + fraction
}
# a bound an interval of that radius hands out: rounded one digit finer than its ± text shows, a guard digit, so
# 12.0 ± 1.9 reaches 10.26 and 13.86, never 13.860000000000001
guarded_bound(bound: float, radius: float): float := {
	if not (radius > 0.0 and is_finite(radius)) { return bound }
	scale = 10.0 ^ (shown_decimals(radius) + 1)
	if abs(bound) * scale >= LARGEST_SCALED then bound else float(round(bound * scale)) / scale
}
