# The standard module unicode (wiki/library-unicode.md): the normalization forms of UAX #15 and full case folding,
# Unicode 15.1.0 (the version of lib/unicode_data.wap). nfc(t), nfd(t), nfkc(t), nfkd(t), unicode_normalize(t, "NFC"),
# is_normalized(t, "NFKD"): full canonical or compatibility decomposition applied recursively, marks put in canonical
# order by their combining class, then canonical composition with its blocking rule, skipping the full composition
# exclusions (CompositionExclusions.txt, the singletons and the non-starter decompositions, derived from the tables).
# Hangul syllables decompose and compose by arithmetic (UAX #15, Unicode 3.12), not by tables. casefold(t) is the full
# case folding of CaseFolding.txt's statuses C and F ("Straße" to "strasse", "İ" to "i̇"); the Turkic mappings (status
# T) are not applied. unicode_upper(t) and unicode_lower(t) are the full default case mappings, locale-independent
# (UnicodeData.txt and SpecialCasing.txt's unconditional mappings: "straße" to "STRASSE"). codepoint_numbers(t) and text_of_codepoints(ns) go between texts and code point numbers.
# The tables are built when the module loads, from lib/unicode_data.wap (scripts/gen-unicode-tables.py writes it).
use unicode_data
use text

# Hangul syllables: the first syllable, the first leading consonant, vowel and trailing consonant, and their counts
HANGUL_S := 44032
HANGUL_L := 4352
HANGUL_V := 4449
HANGUL_T := 4519
HANGUL_L_COUNT := 19
HANGUL_V_COUNT := 21
HANGUL_T_COUNT := 28
HANGUL_N_COUNT := 588
HANGUL_S_COUNT := 11172
# a code point below this decomposes to itself
FIRST_DECOMPOSING := 160
# two code points as one composition key
PAIR_BASE := 2097152

numbers_in(t: text, separator: text): list<int> := t.split(separator).filter(part => part != "").map(part => int(part))

# the combining class of every code point that has one
combining_classes: map<int, int> = classes_read()
classes_read(): map<int, int> := {
	classes: map<int, int> = {}
	runs = numbers_in(unicode_ccc_text(), " ")
	edge = 0
	for i in 0 upto #runs ÷ 3 {
		start = edge + runs[3 * i]
		for n in start upto start + runs[3 * i + 1] { classes[n] = runs[3 * i + 2] }
		edge = start + runs[3 * i + 1]
	}
	classes
}
combining_class(n: int): int := combining_classes.get(n) ?? 0

# each decomposing code point's mapping, and whether it is a compatibility one
class Decomposition { parts: list<int>, compatible: bool }
decompositions: map<int, Decomposition> = decompositions_read()
decompositions_read(): map<int, Decomposition> := {
	table: map<int, Decomposition> = {}
	key = 0
	for entry in unicode_decomposition_text().split(";") {
		parts = entry.split(" ")
		key += int(parts[0])
		compatible = parts[1] == "1"
		if parts[2].starts_with("*") {
			# a run of keys each one code point at the same distance
			run = int(parts[2][1:])
			distance = int(parts[3])
			for n in key upto key + run { table[n] = Decomposition([n + distance], compatible) }
			key += run - 1
		} else {
			table[key] = Decomposition(parts.drop(2).map(part => int(part)), compatible)
		}
	}
	table
}

# the starter a pair of code points composes to: canonical two-part decompositions, less the exclusions
compositions: map<int, int> = compositions_read()
compositions_read(): map<int, int> := {
	excluded = numbers_in(unicode_exclusion_text(), " ")
	table: map<int, int> = {}
	for n in keys(decompositions) {
		d = decompositions[n]
		composes = #d.parts == 2 and not d.compatible and not excluded.contains(n) and combining_class(n) == 0 and combining_class(d.parts[0]) == 0
		if composes { table[d.parts[0] * PAIR_BASE + d.parts[1]] = n }
	}
	table
}

# a case mapping read from its runs and its mappings to several code points: every code point it changes
case_mapping(runs_text: text, multi_text: text): map<int, list<int>> := {
	table: map<int, list<int>> = {}
	runs = numbers_in(runs_text, " ")
	edge = 0
	for i in 0 upto #runs ÷ 4 {
		start = edge + runs[4 * i]
		count = runs[4 * i + 1]
		stride = runs[4 * i + 2]
		for j in 0 upto count {
			n = start + j * stride
			table[n] = [n + runs[4 * i + 3]]
		}
		edge = start + (count - 1) * stride
	}
	for entry in multi_text.split(";") {
		ns = numbers_in(entry, " ")
		table[ns[0]] = ns.drop(1)
	}
	table
}

codepoint_numbers(t: text): list<int> := t.codepoints.map(c => ord(c))
text_of_codepoints(ns: list<int>): text := ns.map(n => text(char(n))).join("")

# the full decomposition of one code point
fully_decomposed(n: int, compatible: bool): list<int> := {
	if n >= HANGUL_S and n < HANGUL_S + HANGUL_S_COUNT { return hangul_parts(n - HANGUL_S) }
	if not decompositions.has(n) { return [n] }
	d = decompositions[n]
	if d.compatible and not compatible { return [n] }
	d.parts.flat_map(part => fully_decomposed(part, compatible))
}
hangul_parts(index: int): list<int> := {
	parts = [HANGUL_L + index ÷ HANGUL_N_COUNT, HANGUL_V + index % HANGUL_N_COUNT ÷ HANGUL_T_COUNT]
	if index % HANGUL_T_COUNT != 0 { parts.add(HANGUL_T + index % HANGUL_T_COUNT) }
	parts
}
# decomposed and in canonical order: each run of marks stably sorted by combining class
decomposed(ns: list<int>, compatible: bool): list<int> := {
	out: list<int> = []
	for n in ns {
		if n < FIRST_DECOMPOSING { out.add(n) } else { out = out + fully_decomposed(n, compatible) }
	}
	for i in 1 upto #out {
		class_here = combining_class(out[i])
		j = i
		while class_here != 0 and j > 0 and combining_class(out[j - 1]) > class_here {
			swapped = out[j - 1]
			out[j - 1] = out[j]
			out[j] = swapped
			j -= 1
		}
	}
	out
}
# the code point a and b compose to, -1 for none
composed_pair(a: int, b: int): int := {
	if a >= HANGUL_L and a < HANGUL_L + HANGUL_L_COUNT and b >= HANGUL_V and b < HANGUL_V + HANGUL_V_COUNT { return HANGUL_S + ((a - HANGUL_L) * HANGUL_V_COUNT + b - HANGUL_V) * HANGUL_T_COUNT }
	if a >= HANGUL_S and a < HANGUL_S + HANGUL_S_COUNT and (a - HANGUL_S) % HANGUL_T_COUNT == 0 and b > HANGUL_T and b < HANGUL_T + HANGUL_T_COUNT { return a + b - HANGUL_T }
	key = a * PAIR_BASE + b
	compositions.get(key) ?? -1
}
# canonical composition of a decomposed, ordered sequence: a mark joins the last starter unless a starter, or a mark
# of the same or a higher class, stands between them
composed(ns: list<int>): list<int> := {
	out: list<int> = []
	starter = -1
	# the highest class of the marks between the starter and here, -1 for none
	between = -1
	for n in ns {
		class_here = combining_class(n)
		joined = -1
		if starter >= 0 and (#out - 1 == starter or between < class_here) { joined = composed_pair(out[starter], n) }
		if joined >= 0 {
			out[starter] = joined
		} else {
			if class_here == 0 {
				starter = #out
				between = -1
			} else {
				between = if #out - 1 == starter then class_here else max(between, class_here)
			}
			out.add(n)
		}
	}
	out
}
nfd(t: text): text := text_of_codepoints(decomposed(codepoint_numbers(t), no))
nfkd(t: text): text := text_of_codepoints(decomposed(codepoint_numbers(t), yes))
nfc(t: text): text := text_of_codepoints(composed(decomposed(codepoint_numbers(t), no)))
nfkc(t: text): text := text_of_codepoints(composed(decomposed(codepoint_numbers(t), yes)))
unicode_normalize(t: text, form: text): text := {
	named = upper(form)
	if named == "NFC" then nfc(t)
	else if named == "NFD" then nfd(t)
	else if named == "NFKC" then nfkc(t)
	else if named == "NFKD" then nfkd(t)
	else raise "unicode_normalize: the form is NFC, NFD, NFKC or NFKD, not ${form}"
}
is_normalized(t: text, form: text): bool := unicode_normalize(t, form) == t
# the full case folding, upper case and lower case of every code point they change
foldings: map<int, list<int>> = case_mapping(unicode_folding_text(), unicode_folding_multi_text())
uppers: map<int, list<int>> = case_mapping(unicode_upper_text(), unicode_upper_multi_text())
lowers: map<int, list<int>> = case_mapping(unicode_lower_text(), unicode_lower_multi_text())
# the text with each code point the mapping changes replaced by what it maps to
case_mapped(t: text, mapping: map<int, list<int>>): text := text_of_codepoints(codepoint_numbers(t).flat_map(n => mapping.get(n) ?? [n]))
casefold(t: text): text := case_mapped(t, foldings)
# the full default case mappings, locale-independent: "straße" is "STRASSE" in upper case, "İ" is "i̇" in lower case
unicode_upper(t: text): text := case_mapped(t, uppers)
unicode_lower(t: text): text := case_mapped(t, lowers)

# NormalizationTest.txt's invariants for one line's five columns (lists of code points): the ones that fail, by
# name, [] for a line that holds. For each form, the column each column's normal form must equal
class NormalForm { name: text, columns: list<int> }
NORMAL_FORMS := [NormalForm("NFC", [1, 1, 1, 3, 3]), NormalForm("NFD", [2, 2, 2, 4, 4]), NormalForm("NFKC", [3, 3, 3, 3, 3]), NormalForm("NFKD", [4, 4, 4, 4, 4])]
normalization_check(columns: list<list<int>>): list<text> := {
	failed: list<text> = []
	for form in NORMAL_FORMS {
		for i in 0 upto 5 {
			got = codepoint_numbers(unicode_normalize(text_of_codepoints(columns[i]), form.name))
			if got != columns[form.columns[i]] { failed.add("${form.name}(c${i + 1})") }
		}
	}
	failed
}
