# The standard module uniscript: `use uniscript`, linked only into the programs that use it. unicode_upper(t) and
# unicode_lower(t) are the full default case mappings, locale-independent (UnicodeData.txt and SpecialCasing.txt's
# unconditional mappings): "straße" is "STRASSE" in upper case, "İ" is "i̇" in lower case. The tables are
# lib/unicode_data.wap's, shared with unicode's case folding.
use unicode
use unicode_data

uppers: map<int, list<int>> = case_mapping(unicode_upper_text(), unicode_upper_multi_text())
lowers: map<int, list<int>> = case_mapping(unicode_lower_text(), unicode_lower_multi_text())
unicode_upper(t: text): text := case_mapped(t, uppers)
unicode_lower(t: text): text := case_mapped(t, lowers)
