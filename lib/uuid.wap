# The standard module uuid (wiki/library-uuid.md, RFC 9562): `use uuid`. uuid() is a random version 4 UUID as
# lowercase text, 8-4-4-4-12 hex digits, made of the host's randomness: its version nibble 4, its variant bits 10.
# is_uuid(t) says whether a text is one in that form (any version, either case), uuid_parsed(t) gives its 16 bytes.
use encoding
use text

# where the dashes stand in the text, and the hex digits of each group
DASHES := [8, 13, 18, 23]
GROUPS := [8, 4, 4, 4, 12]

uuid(): text := {
	bytes = random_bytes(16)
	bytes[6] = 0x40 + bytes[6] % 16
	bytes[8] = 0x80 + bytes[8] % 64
	grouped(hex_encode(bytes))
}
# 32 hex digits as 8-4-4-4-12
grouped(digits: text): text := {
	at = 0
	parts: list<text> = []
	for size in GROUPS {
		parts.add(digits[at:at + size])
		at += size
	}
	parts.join("-")
}
is_uuid(t: text): bool := #t == 36 and (0 upto 36).all(i => if DASHES.contains(i) then t[i:i + 1] == "-" else is_hex(t[i:i + 1]))
uuid_parsed(t: text): list<int> := {
	if not is_uuid(t) { raise "not a UUID: ${t} (8-4-4-4-12 hex digits)" }
	hex_decode_bytes(lower(t).replace("-", ""))
}
