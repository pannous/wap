# The standard module version (wiki/use.md "versions"): `use version`. version("1.2.3") is a version as written,
# compared part by part as whole numbers, so 1.9 < 1.10.0, a missing part counting as 0, so 1.2.0 == 1.2; a leading v
# is no part, version("v1.2") is 1.2. Semantic versions with prereleases and npm ranges: the module semver.

use text

VERSION_SEPARATOR := "."

class Version { written: text }
version(written: word): Version := Version(written.remove_prefix("v"))
text(v: Version): text := v.written
# the whole numbers of "1.10.0", [1, 10, 0]
parts(v: Version): list<int> := v.written.split(VERSION_SEPARATOR).map(part => int(part))
# below, at or above 0 as b is greater, equal or smaller: the first part that differs decides
compare(a: Version, b: Version): int := {
	left = parts(a)
	right = parts(b)
	for at in 1 to max(#left, #right) {
		difference = part_at(left, at) - part_at(right, at)
		if difference != 0 { return difference }
	}
	0
}
part_at(parts: list<int>, at: int): int := if at <= #parts then parts#at else 0
==(a: Version, b: Version): bool := compare(a, b) == 0
<(a: Version, b: Version): bool := compare(a, b) < 0
