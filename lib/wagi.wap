# The standard module wagi (wiki/standard-library.md wagi): a program's routes (lib/router) answering one request the
# WAGI way (Spin's wagi executor, Akamai Functions): the request comes in the environment (REQUEST_METHOD, PATH_INFO,
# QUERY_STRING), the answer goes CGI-style to the standard output: its status and headers, a blank line, the body.
use router
use url

# the request the environment holds
wagi_request(): Request :=
	Request(started_env("REQUEST_METHOD") ?? "GET", started_env("PATH_INFO") ?? "/", query_map(started_env("QUERY_STRING") ?? ""))
# the answer of the program's routes to the environment's request, printed as CGI writes it
routes_wagi() := print(cgi_text(answer_of(wagi_request())))
cgi_text(answer: Answer): text :=
	(["Status: ${answer.status}", "Content-Type: ${answer.content_type}"] + answer.header_lines).join("\n") + "\n\n" + answer.body
