# The standard module wikipedia (wiki/world.md): the edits of every Wikimedia wiki as they happen, from Wikimedia's
# public event stream (server-sent events, no key). `for edit in changes("enwiki").take(5) { print edit.title }`; an
# edit is a map: title, user, wiki, type (edit, new, log, categorize), bot, comment, timestamp, server_name …
use feeds
use map

RECENT_CHANGES = "https://stream.wikimedia.org/v2/stream/recentchange"

# the recent changes of one wiki ("enwiki", "dewiki", "wikidatawiki" …), of all of them by default
changes(wiki: text = ""): Feed := streamed(RECENT_CHANGES, edit => wiki == "" or as_data_map(edit).wiki == wiki)
