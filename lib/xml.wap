# The standard module xml (wiki/library-xml.md): a non-validating XML 1.0 reader into Elements, path queries in the
# manner of ElementTree, the text of an element and a writer, parse_xml(to_xml(e)) giving e again.
# An Element has a name, its attributes in document order, its children (elements and text pieces, an element without
# a name being a text piece) and its own direct text. The declaration, comments, processing instructions and a
# DOCTYPE are skipped; CDATA is literal text; the entities are XML's five and &#n; / &#xh;. A text run of only blanks
# between tags is dropped. A path is steps parted by /: a name or *, // for any depth below, and predicates [n]
# (1-based among the parent's matching children), [@attr] and [@attr='v']. Malformed XML is refused with its line
# and column.
use html
use text

class Element { name: text, attributes: map<text, text>, children: list<Element>, text: text }
# a text being read and the place reached in it
class Reader { source: text, at: int }

ENTITIES := {amp: "&", lt: "<", gt: ">", quot: "\"", apos: "'"}
HEX_DIGITS := "0123456789abcdef"
BLANKS := " \t\n"
NAME_ENDS := " \t\n/>=?"
COMMENT := ["<!--", "-->"]
INSTRUCTION := ["<?", "?>"]
CDATA := ["<![CDATA[", "]]>"]

# --- reading ---

failed(r: Reader, message: text): any := {
	before = r.source[0:r.at]
	lines = before.split("\n")
	raise "xml line ${#lines}, column ${#lines.last + 1}: ${message}"
}
is_at(r: Reader, s: text): bool := r.source[r.at:r.at + #s] == s
expect(r: Reader, s: text) := {
	if not is_at(r, s) { failed(r, "expected ${s}") }
	r.at += #s
}
skip_blanks(r: Reader) := {
	while r.at < #r.source and BLANKS.contains(r.source[r.at:r.at + 1]) { r.at += 1 }
}
# the text up to the end mark, the reader after it
read_until(r: Reader, ending: text): text := {
	found = find(r.source, ending, r.at + 1)
	if found == 0 { failed(r, "no ${ending} after this") }
	read = r.source[r.at:found - 1]
	r.at = found - 1 + #ending
	read
}
# skips a comment or instruction (or, with a DOCTYPE, that too) at the reader; whether one was there
skipped_markup(r: Reader, doctype: bool): bool := {
	for marks in [COMMENT, INSTRUCTION] {
		if is_at(r, marks[0]) {
			read_until(r, marks[1])
			return yes
		}
	}
	if doctype and is_at(r, "<!DOCTYPE") {
		subset = read_until(r, ">")
		if subset.contains("[") and not subset.contains("]") {
			read_until(r, "]")
			read_until(r, ">")
		}
		return yes
	}
	no
}
skip_misc(r: Reader) := {
	skip_blanks(r)
	while skipped_markup(r, yes) { skip_blanks(r) }
}
read_name(r: Reader): text := {
	start = r.at
	while r.at < #r.source and not NAME_ENDS.contains(r.source[r.at:r.at + 1]) { r.at += 1 }
	if r.at == start { failed(r, "expected a name") }
	r.source[start:r.at]
}

hex_number(t: text): int := t.codepoints.fold(0, (n, c) => n * 16 + find(HEX_DIGITS, ascii_lower(text(c))) - 1)
# the character an entity's name stands for
entity(r: Reader, name: text): text := {
	if ENTITIES.has(name) { return ENTITIES[name] }
	digits = if name.starts_with("#x") then name[2:] else if name.starts_with("#") then name[1:] else ""
	if digits == "" { failed(r, "unknown entity &${name}; (XML has only amp, lt, gt, quot and apos)") }
	code = if name.starts_with("#x") then hex_number(digits) else int(digits)
	text(char(code))
}
# raw text with its entities read
decoded(r: Reader, raw: text): text := {
	parts = raw.split("&")
	parts.drop(1).fold(parts[0], (out, part) => {
		semi = find(part, ";")
		if semi == 0 { failed(r, "an & without ; (write &amp;)") }
		out + entity(r, part[0:semi - 1]) + part[semi:]
	})
}

text_piece(t: text): Element := {
	children: list<Element> = []
	attributes: map<text, text> = {}
	Element("", attributes, children, t)
}
read_attributes(r: Reader): map<text, text> := {
	attributes: map<text, text> = {}
	skip_blanks(r)
	while not is_at(r, ">") and not is_at(r, "/>") {
		name = read_name(r)
		if attributes.has(name) { failed(r, "the attribute ${name} twice") }
		skip_blanks(r)
		expect(r, "=")
		skip_blanks(r)
		quote = r.source[r.at:r.at + 1]
		if quote != "\"" and quote != "'" { failed(r, "an attribute value in quotes") }
		r.at += 1
		attributes[name] = decoded(r, read_until(r, quote)).replace("\t", " ").replace("\n", " ")
		skip_blanks(r)
	}
	attributes
}
# the element at the reader, its closing tag read too
read_element(r: Reader): Element := {
	expect(r, "<")
	name = read_name(r)
	attributes = read_attributes(r)
	children: list<Element> = []
	if is_at(r, "/>") {
		r.at += 2
		return Element(name, attributes, children, "")
	}
	expect(r, ">")
	while not is_at(r, "</") {
		if r.at >= #r.source { failed(r, "<${name}> is not closed") }
		if is_at(r, CDATA[0]) {
			r.at += #CDATA[0]
			children.add(text_piece(read_until(r, CDATA[1])))
		} else if skipped_markup(r, no) { }
		else if is_at(r, "<") { children.add(read_element(r)) }
		else {
			start = r.at
			while r.at < #r.source and not is_at(r, "<") { r.at += 1 }
			raw = r.source[start:r.at]
			if trim(raw) != "" { children.add(text_piece(decoded(r, raw))) }
		}
	}
	r.at += 2
	closing = read_name(r)
	if closing != name { failed(r, "</${closing}> closes <${name}>") }
	skip_blanks(r)
	expect(r, ">")
	Element(name, attributes, children, children.filter(c => c.name == "").map(c => c.text).join(""))
}

# the root element of an XML text
parse_xml(source: text): Element := {
	r = Reader(source.replace("\r\n", "\n"), 0)
	skip_misc(r)
	if r.at >= #r.source { failed(r, "no root element") }
	root = read_element(r)
	skip_misc(r)
	if r.at < #r.source { failed(r, "text after the root element") }
	root
}

# the text of an element and all it holds, in document order
xml_text(e: Element): text := if e.name == "" then e.text else e.children.map(xml_text).join("")

# --- paths ---

# a path's step: whether it looks at any depth below, the name or *, its predicates
class Step { deep: bool, test: text, predicates: list<text> }
path_steps(path: text): list<Step> := {
	if path == "" or (path.starts_with("/") and not path.starts_with("//")) { raise "xml path ${path}: start with a name, * or //" }
	steps: list<Step> = []
	deep = no
	for part in path.split("/") {
		if part == "" { deep = yes }
		else {
			pieces = part.split("[")
			if pieces[0] == "" or pieces.drop(1).any(p => not p.ends_with("]")) { raise "xml path ${path}: unsupported step ${part}" }
			steps.add(Step(deep, pieces[0], pieces.drop(1).map(p => p[0:#p - 1])))
			deep = no
		}
	}
	if deep { raise "xml path ${path}: a path ending in /" }
	steps
}
# whether an element passes a predicate, given its position among the parent's matching children
passes(e: Element, predicate: text, position: int): bool := {
	if is_digits(predicate) { return position == int(predicate) }
	if not predicate.starts_with("@") { raise "xml path: unsupported predicate [${predicate}] (use [n], [@attr] or [@attr='v'])" }
	sides = predicate[1:].split("=")
	if #sides == 1 { return e.attributes.has(sides[0]) }
	value = sides[1]
	e.attributes.has(sides[0]) and e.attributes[sides[0]] == value[1:#value - 1]
}
# the element and every element below it, in document order
with_descendants(e: Element): list<Element> := [e] + e.children.filter(c => c.name != "").flat_map(with_descendants)
# the children of an element matching a step
matching(e: Element, step: Step): list<Element> := {
	named = e.children.filter(c => c.name != "" and (step.test == "*" or c.name == step.test))
	(0 upto #named).filter(i => step.predicates.all(p => passes(named[i], p, i + 1))).map(i => named[i])
}
# every element the path reaches from the element, in document order per step
xml_find_all(e: Element, path: text): list<Element> := path_steps(path).fold([e], (current, step) => (if step.deep then current.flat_map(with_descendants) else current).flat_map(base => matching(base, step)))
# the first element the path reaches, ø for none
xml_find(e: Element, path: text): Element? := {
	found = xml_find_all(e, path)
	if found is empty then ø else found[0]
}

# --- writing ---

xml_escape(t: text): text := html_escape(t).replace("&#39;", "&apos;")
to_xml(e: Element): text := {
	if e.name == "" { return xml_escape(e.text) }
	opening = "<" + e.name + e.attributes.keys().map(k => " ${k}=\"${xml_escape(e.attributes[k])}\"").join("")
	if e.children is empty then opening + "/>" else opening + ">" + e.children.map(to_xml).join("") + "</${e.name}>"
}
