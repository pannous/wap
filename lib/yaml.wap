# The standard module yaml (wiki/library-config-formats.md): the YAML people write for configuration, read into maps
# and lists and written back. parse_yaml(t) reads one document, parse_yaml_all(t) every document between --- lines.
# Read: block maps and sequences (also `- key: value` items), one-line [flow] and {flow}, plain, 'single' and "double"
# quoted scalars, | literal and > folded blocks, # comments, and the core schema: null and ~ for ø, true and false,
# ints and floats; any other scalar is text. A key twice is refused, naming its line. to_yaml(m) writes block style,
# quoting a text only where it would read as something else.
use text
use map

# --- reading

# a line of the source: its indentation, its text without indentation and comment, and the line as written
class Row { indent: int, content: text, raw: text, number: int }
# a value read and the place of the row after it
class Read { value: any, next: int }

leading_spaces(line: text): int := {
	count = 0
	while line[count:count + 1] == " " { count += 1 }
	count
}
# a comment starts at a # after a blank, or at the line's start
yaml_comment_cut(line: text): text := without_comment(" " + line, " #")[1:]
row_of(line: text, number: int): Row := Row(leading_spaces(line), trim(yaml_comment_cut(line)), line, number)

refused_row(row: Row, why: text): never := raise "yaml line ${row.number}: ${why}"

# the place of the first row with content from at on, #rows for none
content_at(rows: list<Row>, at: int): int := if at < #rows and rows[at].content == "" then content_at(rows, at + 1) else at
# whether the row at place, one with content, has this indentation
continues(rows: list<Row>, place: int, indent: int): bool := place < #rows and rows[place].indent == indent
is_item(content: text): bool := content == "-" or content.starts_with("- ")
# an item row as a dash and its content, a row of its own indented where it starts: `- name: a` begins a map below
# the dash, `- - x` a sequence
item_rows(row: Row): list<Row> := {
	rest = trim(row.content[1:])
	if not is_item(row.content) or rest == "" then [row]
	else [Row(row.indent, "-", row.raw, row.number)] + item_rows(Row(row.indent + #row.content - #rest, rest, row.raw, row.number))
}
# where the colon of a `key: value` row stands, ø for a row that is no entry
colon_of(content: text): int? := if content.starts_with("[") or content.starts_with("{") then ø else place_outside_quotes(content + " ", ": ", 0)

parse_yaml(source: text): any := {
	documents = parse_yaml_all(source)
	if #documents > 1 { raise "parse_yaml: ${#documents} documents, parse_yaml_all reads them all" }
	if documents is empty then ø else documents[0]
}
parse_yaml_all(source: text): list<any> := {
	documents: list<any> = []
	rows: list<Row> = []
	lines = source.replace("\r\n", "\n").split("\n")
	for i in 0 upto #lines {
		line = lines[i]
		if line == "---" or line.starts_with("--- ") or line == "..." {
			if has_content(rows) { documents.add(document_of(rows)) }
			rows = []
		} else {
			rows = rows + item_rows(row_of(line, i + 1))
		}
	}
	if has_content(rows) { documents.add(document_of(rows)) }
	documents
}
has_content(rows: list<Row>): bool := rows.any(row => row.content != "")
document_of(rows: list<Row>): any := {
	at = content_at(rows, 0)
	read = block_value(rows, at, rows[at].indent)
	after = content_at(rows, read.next)
	if after < #rows { refused_row(rows[after], "${rows[after].content} is outside the document's indentation") }
	read.value
}

# the map, sequence or scalar starting at the row at at, one with content, indented by indent
block_value(rows: list<Row>, at: int, indent: int): Read := {
	row = rows[at]
	if is_item(row.content) then sequence_of(rows, at, indent)
	else if colon_of(row.content) != ø then mapping_of(rows, at, indent)
	else Read(scalar_of(row.content), at + 1)
}
mapping_of(rows: list<Row>, at: int, indent: int): Read := {
	m: map<text, any> = {}
	place = at
	while continues(rows, place, indent) and not is_item(rows[place].content) {
		row = rows[place]
		colon = colon_of(row.content) ?? refused_row(row, "${row.content} is no key: value")
		key = "${scalar_of(trim(row.content[0:colon]))}"
		if m.has(key) { refused_row(row, "the key ${key} twice") }
		entry = entry_value(rows, place + 1, trim(row.content[colon + 1:]), indent)
		m[key] = entry.value
		place = content_at(rows, entry.next)
	}
	Read(m, place)
}
# what follows a key's colon: a block scalar, a value on the line, or the rows indented below (a sequence may stand at
# the key's own indentation)
entry_value(rows: list<Row>, at: int, rest: text, indent: int): Read := {
	if rest == "|" or rest == ">" { return block_scalar(rows, at, indent, rest) }
	if rest != "" { return Read(scalar_of(rest), at) }
	below = content_at(rows, at)
	if continues(rows, below, indent) and is_item(rows[below].content) then sequence_of(rows, below, indent) else value_below(rows, at, indent)
}
sequence_of(rows: list<Row>, at: int, indent: int): Read := {
	items: list<any> = []
	place = at
	while continues(rows, place, indent) and is_item(rows[place].content) {
		item = value_below(rows, place + 1, indent)
		items.add(item.value)
		place = content_at(rows, item.next)
	}
	Read(items, place)
}
# the value on the rows indented deeper than indent, ø for none
value_below(rows: list<Row>, at: int, indent: int): Read := {
	below = content_at(rows, at)
	if below < #rows and rows[below].indent > indent then block_value(rows, below, rows[below].indent) else Read(ø, at)
}
# a | block keeps its line breaks, a > block folds lines into spaces, blank lines into breaks; both end in one break
block_scalar(rows: list<Row>, at: int, indent: int, style: text): Read := {
	first = content_at(rows, at)
	if first == #rows or rows[first].indent <= indent { return Read("", at) }
	inner = rows[first].indent
	place = at
	while place < #rows and (trim(rows[place].raw) == "" or leading_spaces(rows[place].raw) >= inner) { place += 1 }
	lines = rows[at:place].map(row => row.raw[inner:])
	while #lines > 0 and trim(lines.last) == "" { lines = lines.take(#lines - 1) }
	Read((if style == "|" then lines.join("\n") else folded(lines)) + "\n", place)
}
folded(lines: list<text>): text := lines.fold("", (out, line) => if line == "" then out + "\n" else if out == "" or out.ends_with("\n") then out + line else out + " " + line)

# the characters a set is made of, each a text of one
characters_of(t: text): list<text> := t.codepoints.map(c => text(c))
# where a plain scalar ends: in a value, an item of a flow list, a key and a value of a flow map
VALUE_ENDS = characters_of(",]}")
ITEM_ENDS = characters_of(",]")
KEY_ENDS = characters_of(":,}")
ENTRY_ENDS = characters_of(",}")
# a scalar or flow collection written on one line
scalar_of(t: text): any := {
	s = Scan(t, 0)
	value = flow_value(s, VALUE_ENDS)
	skip_blanks(s)
	if s.at < #t { raise "yaml: ${rest_of(s)} after ${t}" }
	value
}
# the value at the scan; a plain scalar ends at one of ends (in flow at a comma or bracket, outside it at the line's end)
flow_value(s: Scan, ends: list<text>): any := {
	skip_blanks(s)
	c = next_of(s)
	if c == "\"" then quoted_at(s)
	else if c == "'" then single_quoted_at(s)
	else if c == "[" then flow_list(s)
	else if c == "{" then flow_map(s)
	else plain_at(s, ends)
}
# a 'single-quoted' scalar, '' standing for one quote
single_quoted_at(s: Scan): text := {
	closing = s.at + 1
	while closing < #s.source and not (s.source[closing:closing + 1] == "'" and s.source[closing + 1:closing + 2] != "'") {
		closing += if s.source[closing:closing + 2] == "''" then 2 else 1
	}
	inside = s.source[s.at + 1:closing]
	s.at = closing + 1
	inside.replace("''", "'")
}
plain_at(s: Scan, ends: list<text>): any := {
	start = s.at
	while s.at < #s.source and not ends.contains(next_of(s)) and not (s.c_comments and next_of(s) == "/") { s.at += 1 }
	plain_value(trim(s.source[start:s.at]))
}
flow_list(s: Scan): list<any> := {
	items: list<any> = []
	s.at += 1
	while more_items(s, "]") { items.add(flow_value(s, ITEM_ENDS)) }
	items
}
flow_map(s: Scan): map<text, any> := {
	m: map<text, any> = {}
	s.at += 1
	while more_items(s, "}") {
		key = "${flow_value(s, KEY_ENDS)}"
		skip_blanks(s)
		if next_of(s) == ":" {
			s.at += 1
			m[key] = flow_value(s, ENTRY_ENDS)
		} else {
			m[key] = ø
		}
	}
	m
}
# the core schema: null, bool, int, float, else the text itself
NULLS := ["", "~", "null", "Null", "NULL"]
TRUES := ["true", "True", "TRUE"]
FALSES := ["false", "False", "FALSE"]
plain_value(t: text): any := {
	number = spelled_number(t)
	if NULLS.contains(t) then ø
	else if TRUES.contains(t) then yes
	else if FALSES.contains(t) then no
	else if number != ø and not t.contains("_") then number
	else t
}

# --- writing

to_yaml(value: any): text := if is_map(value) then map_block(value, "") else if is_list(value) then list_block(value, "") else scalar_text(value) + "\n"
# each level of a written block is indented this much more
BLOCK_INDENT := "  "
# whether a value is written on rows of its own: a map or list with something in it
is_nested(value: any): bool := (is_map(value) or is_list(value)) and not (value is empty)
block_text(value: any, indent: text): text := if is_map(value) then map_block(value, indent) else list_block(value, indent)
map_block(m: map<text, V>, indent: text): text := m.keys().map(key => entry_text("${scalar_text(key)}:", m[key], indent)).join("")
list_block(xs: list<T>, indent: text): text := xs.map(x => item_text(x, indent)).join("")
entry_text(head: text, value: any, indent: text): text := if is_nested(value) then "${indent}${head}\n" + block_text(value, indent + BLOCK_INDENT) else "${indent}${head} ${scalar_text(value)}\n"
# a list item, a map or list in it starting on the item's own row
item_text(value: any, indent: text): text := {
	if not is_nested(value) { return "${indent}- ${scalar_text(value)}\n" }
	inner = block_text(value, indent + BLOCK_INDENT)
	"${indent}- " + inner[#indent + #BLOCK_INDENT:]
}
# characters that make a text read as something else at its start, or anywhere
SPECIAL_STARTS = characters_of("-?:,[]{}#&*!|>'\"%@` ")
SPECIAL_PARTS := [": ", " #", "\n", "\t"]
scalar_text(value: any): text := {
	if value is text then text_scalar("${value}")
	else if is_map(value) then "{}"
	else if is_list(value) then "[]"
	else scalar_word(value)
}
# ø, a bool or a number as YAML and JSON write them; ∞ and NaN have no form
scalar_word(value: any): text := {
	if value == ø then "null"
	else if value is bool then (if value == yes then "true" else "false")
	else if value is float and not is_finite(value as float) then raise("${value} has no JSON form")
	else "${value}"
}
text_scalar(t: text): text := {
	plain = t != "" and not SPECIAL_STARTS.contains(t[0:1]) and not t.ends_with(" ") and not SPECIAL_PARTS.any(part => t.contains(part))
	if plain and plain_value(t) is text then t else double_quoted(t)
}
