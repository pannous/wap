 "any-values": {
  "id": "PVTI_lAHOAAfgFs4BsfrazhK5xb8",
  "title": "any value used as its own type",
  "updated": "2026-11-23T23:56:22Z",
  "key": "any-values",
  "agent": "wap-a6",
  "try": "",
