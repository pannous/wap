 "function-type-result": {
  "id": "PVTI_lAHOAAfgFs4BsfrazhLIrzQ",
  "title": "function type written as a result is refused",
  "updated": "2026-11-23T14:48:33Z",
  "key": "function-type-result",
  "agent": "wap-binding",
  "try": "",
