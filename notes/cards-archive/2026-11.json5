 "definition-comma-list": {
  "id": "PVTI_lAHOAAfgFs4BsfrazhLiraE",
  "title": "A comma list after a definition should belong to…",
  "updated": "2026-11-24T19:24:52Z",
  "key": "definition-comma-list",
  "agent": "wap-theory-conditions-lifted",
