 "elaborate-overload-exponential": {
  "id": "PVTI_lAHOAAfgFs4BsfrazhLm9DU",
  "title": "The elaborator takes time exponential in the…",
  "updated": "2026-11-24T23:49:53Z",
  "key": "elaborate-overload-exponential",
  "agent": "wap-theory-conditions-lifted",
  "try": "",
