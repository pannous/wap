 "resultless-lambda": {
  "id": "PVTI_lAHOAAfgFs4BsfrazhLIzdo",
  "title": "lambda whose body gives no value is refused where…",
  "updated": "2026-11-23T21:30:22Z",
  "key": "resultless-lambda",
