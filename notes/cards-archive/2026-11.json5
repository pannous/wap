 "theory-effects-typed": {
  "id": "PVTI_lAHOAAfgFs4BsfrazhLhTfA",
  "title": "Proofs don't track effects yet: no Pure, no Div",
  "updated": "2026-11-24T18:54:02Z",
  "key": "theory-effects-typed",
  "agent": "wap-theory-conditions-lifted",
  "try": "",
  "repeat": "",
  "now_by_todo": "2026-11-24T17:24:55Z",
