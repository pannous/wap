 "census-declaration-typing": {
  "id": "PVTI_lAHOAAfgFs4BsfrazhLH-WA",
  "title": "census leaves typing stage untyped when…",
  "updated": "2026-11-24T07:46:47Z",
  "key": "census-declaration-typing",
  "agent": "wap-binding",
  "try": "",
