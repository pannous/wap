 "format-colon-result": {
  "id": "PVTI_lAHOAAfgFs4BsfrazhLaOJQ",
  "title": "format writes a result type as `as B` where…",
  "updated": "2026-11-25T23:20:07Z",
  "key": "format-colon-result",
  "agent": "wap-annotation-attachment-fix",
  "try": "",
