 "theory-laws": {
  "id": "PVTI_lAHOAAfgFs4BsfrazhLaIps",
  "title": "law with a proof is a theorem, wap verify needs…",
  "updated": "2026-11-24T14:26:32Z",
  "key": "theory-laws",
  "agent": "wap-wiki-tidy",
  "try": "",
