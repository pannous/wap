 "class-inheritance": {
  "id": "PVTI_lAHOAAfgFs4BsfrazhLiHLI",
  "title": "A class that extends another class does not get…",
  "updated": "2026-11-24T19:50:09Z",
  "key": "class-inheritance",
  "agent": "wap-binding",
  "try": "",
  "repeat": "",
  "now_by_todo": "2026-11-24T17:59:02Z",
