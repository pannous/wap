 "one-list-of-type-words": {
  "id": "PVTI_lAHOAAfgFs4BsfrazhLK9jk",
  "title": "compiler keeps type words in separate lists",
  "updated": "2026-11-24T07:30:00Z",
  "key": "one-list-of-type-words",
  "agent": "wap-enum-index-constant-time",
  "try": "",
  "repeat": "",
  "now_by_todo": "2026-11-24T07:21:14Z",
