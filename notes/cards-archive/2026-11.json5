 "case-name": {
  "id": "PVTI_lAHOAAfgFs4BsfrazhL_CDU",
  "title": "A case name two used enums share stops working as…",
  "updated": "2026-11-26T20:15:44Z",
  "key": "case-name",
  "agent": "wap-annotation-attachment-fix",
  "try": "",
  "repeat": "",
  "now_by_todo": "2026-11-26T19:17:13Z",
  "assignees": [
   "pannous"
