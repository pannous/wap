 "closure-call-performance": {
  "id": "PVTI_lAHOAAfgFs4BsfrazhLr57g",
  "title": "Closure calls spend most of the compiler's time…",
  "updated": "2026-11-26T17:08:45Z",
  "key": "closure-call-performance",
  "agent": "wap-primitive-lookup-tables",
  "try": "",
