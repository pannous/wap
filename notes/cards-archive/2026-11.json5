 "theory-arithmetic": {
  "id": "PVTI_lAHOAAfgFs4BsfrazhLaLF8",
  "title": "compiler proves ring identities and linear facts",
  "updated": "2026-11-25T02:23:05Z",
  "key": "theory-arithmetic",
