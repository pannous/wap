# Duplicate contacts found although typed differently: composed and decomposed accents, the ﬁ ligature, full-width
# letters and German ß all compare equal after NFKC and case folding (unicode, tables)
use unicode
use tables

COMBINING_DIAERESIS := 776
diaeresis = text(char(COMBINING_DIAERESIS))
names = ["Zoë Müller", "Zoe${diaeresis} Mu${diaeresis}ller", "ZOË MÜLLER", "Sofia Strauß", "sofia STRAUSS", "ﬁona Ｌｅｅ", "Fiona Lee", "Fiona Leigh"]
key(name: text): text := casefold(nfkc(name))

rows = names.map(name => ["${name}", "${#codepoint_numbers(name)}", "${#codepoint_numbers(nfc(name))}", key(name)])
print(table_text(rows, headers: ["as typed", "code points", "after NFC", "match key"]))
print("")
# the names by their match key, in the order the keys first come
groups: map<text, list<text>> = {}
for name in names {
	k = key(name)
	if not groups.has(k) { groups[k] = [] }
	groups[k].add(name)
}
print("${#keys(groups)} people among ${#names} entries")
for k in keys(groups) {
	if #groups[k] > 1 { print("same person: ${groups[k].join(" | ")}") }
}
print("already NFC? ${is_normalized(names[1], "NFC")}, after nfc: ${is_normalized(nfc(names[1]), "NFC")}")
