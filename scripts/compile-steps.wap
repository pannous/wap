# A warm compile split into its steps, each one's wall time in ms (notes/coc-plan.md 10.5, the baseline of the
# compile-time gates): the steps wap/compiler.wap takes, with the warm state and library a build left in wap/. Run from
# the tree's root after a build (test/wap/compile.sh): wap <wap.wasm> scripts/compile-steps.wap steps.wasm, then
#   wap steps.wasm <program.wap>
use "../wap/core/pipeline.wap"
use "../wap/core/parse/cascade.wap"
use "../wap/core/parse/atoms.wap"
use "../wap/core/analyze/declarations.wap"
use "../wap/core/analyze/variables.wap"
use "../wap/core/parse/operators.wap"
use "../wap/core/rules/stages.wap"
use "../wap/core/format.wap"
use "../wap/core/emit/wasm.wap"
use "../wap/core/emit/emitter.wap"
use "../wap/core/emit/functions.wap"
use "../wap/core/language.wap"
use "../wap/extensions/wasm/modules.wap"
use "../wap/extensions/c/functions.wap"
use "../wap/extensions/wasm/library.wap"
use "../wap/core/stage.wap"
use "../wap/core/analyze/types.wap"
use "../wap/core/bindings.wap"
use "../wap/extensions/warm.wap"
use "../wap/extensions/native/memory.wap"

WAP_FOLDER = "wap"
program = args#1
marks = [wall_clock_ms()]
# the time since the step before, under the step's name
step(name: text) := {
	now = wall_clock_ms()
	print "${name}\t${now - marks.last} ms"
	marks.add(now)
}
language = base_language()
language.build.bringers[MODULE_ENDING] = module_brought
warm_brought(language, WAP_FOLDER, read(in_folder(WAP_FOLDER, "warm.packed")))
language.build.use_free_modules = USE_FREE_MODULES
step("warm state brought in")
rules_files_loaded(language, WAP_FOLDER)
rules_files_loaded(language, WAP_FOLDER, BUILD_RULES)
rules_checked(language)
step("rules compiled")
library_held(WAP_FOLDER, read(in_folder(WAP_FOLDER, LIBRARY_MODULE)))
library = library_file(WAP_FOLDER, program)
types = types_declared(language, WAP_FOLDER, library)
step("types module declared")
modules = declared_modules(language, program)
step("program declared")
typed = typed_modules(language, modules, types, program)
step("typed")
exported = compiled_once(modules.last, added_records(Records(), statements_in(typed)))
module_bytes(emitted(typed, program, exported.map(signature => export_key(signature.definer)), language.build.memory, raise_module(WAP_FOLDER, library), no))
step("emitted")
