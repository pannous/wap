# The elaborator's census (notes/coc-plan.md S1, test/wap/ratchet_census.sh): `wap scripts/theory-census.wap --tree
# <root> program.wap…` elaborates and checks every statement of each program as the elaborator's door does, each
# program alone on the prelude, but a refusal ends only its statement and takes back what that statement wrote. It
# prints each refusal as `refused <program>: <refusal>`, then the total, `accepted n of N statements`.
use "../wap/extensions/theory/elaborate/file.wap"
use "../wap/extensions/theory/elaborate/read.wap"
use "../wap/extensions/theory/options.wap"
use "../wap/extensions/theory/environment.wap"

REFUSED_LINE := "refused "
TOTAL_LINE := "accepted "

refusal_printed(program: text, refusal: Error) := print "${REFUSED_LINE}${program}: ${refusal.message}"
# a program's statements elaborated into a theory of its own, each refusal printed: how many the kernel accepted, of
# how many; a program the elaborator cannot read has all its statements refused
program_counted(spellings: Theory, program: text): list<int> := {
	p = copied(spellings)
	try {
		taken = program_units(p, program).map(unit => statement_accepted(p, program, unit))
		return [#taken.filter(accepted => accepted), #taken]
	} catch refusal { refusal_printed(program, refusal) }
	[0, #written_units(program)]
}
# whether the kernel accepted a statement, its refusal printed and what it wrote into the theory taken back
statement_accepted(p: Theory, program: text, unit: list<Node>): bool := {
	before = copied(p)
	try {
		unit_elaborated(p, unit)
		return yes
	} catch refusal { refusal_printed(program, refusal) }
	held(p, before)
	no
}

spellings = Theory()
door_run(spellings, args, arguments => {
	counts = arguments.programs.map(program => program_counted(spellings, program))
	print "${TOTAL_LINE}${counts.map(c => c#1).sum} of ${counts.map(c => c#2).sum} statements"
})
