# User comments rendered safely into an HTML page: markup in the text is escaped, entities typed by users decode
# once, and the page round-trips (html)
use html

class Comment { author: text, words: text }
comments = [
	Comment("ana", "Great post! <3"),
	Comment("mallory", "<script>alert('hi')</script>"),
	Comment("ben", "Tom &amp; Jerry &copy; 1940 &mdash; classic"),
	Comment("cleo", "5 > 3 & 2 < 4")
]
item(c: Comment): text := "  <li><b>${html_escape(c.author)}</b>: ${html_escape(html_unescape(c.words))}</li>"
page = (["<ul>"] + comments.map(item) + ["</ul>"]).join("\n")
print(page)
print("")
print("no live script tag: ${not page.contains("<script>")}")
print("decoded again: ${html_unescape(html_escape(comments[1].words))}")
print("numeric references: ${html_unescape("&#72;&#x69;&#33; &#128512;")}")
