# Free slots for a meeting: three calendars' busy hours (minutes since midnight) merged, cut out of the working day,
# and the slots long enough for a 45 minute meeting listed (intervals)
use intervals

MEETING_MINUTES := 45
two_digits(n: int): text := if n < 10 then "0${n}" else "${n}"
clock(minutes: float): text := "${two_digits(int(minutes) ÷ 60)}:${two_digits(int(minutes) % 60)}"
shown(e: Extent): text := "${clock(e.lo)}-${clock(e.hi)}"
listed(extents: list<Extent>): text := extents.map(shown).join(", ")

class Calendar { name: text, busy: list<Extent> }
calendars = [
	Calendar("ana", [extent(540, 600), extent(780, 840)]),
	Calendar("ben", [extent(570, 660), extent(900, 960)]),
	Calendar("cleo", [extent(720, 780), extent(990, 1020)])
]
for c in calendars { print("${c.name} busy: ${listed(c.busy)}") }
merged = merge_intervals(calendars.flat_map(c => c.busy))
print("busy together: ${listed(merged)}")
print("busy minutes: ${int(total_length(merged))}")
free = subtract_intervals(extent(540, 1050), merged)
print("free: ${listed(free)}")
print("${MEETING_MINUTES} minute slots: ${listed(free.filter(e => extent_length(e) >= MEETING_MINUTES))}")
print("is 12:30 free? ${free.any(e => extent_contains(e, 750))}")
