# A recipe for 4 scaled to 6 servings and to 1, its amounts kept exact and printed as mixed numbers in a table
# (fractions, tables)
use fractions
use tables

RECIPE_SERVINGS := 4
SERVINGS := [4, 6, 1]
class Ingredient { name: text, amount: text, unit: text }
recipe = [
	Ingredient("flour", "2 1/4", "cups"),
	Ingredient("butter", "3/4", "cup"),
	Ingredient("sugar", "1/3", "cup"),
	Ingredient("milk", "1/2", "cup"),
	Ingredient("eggs", "2", ""),
	Ingredient("vanilla", "1 1/2", "tsp")
]
scaled(amount: text, servings: int): Fraction := parse_fraction(amount) * fraction(servings, RECIPE_SERVINGS)
rows = recipe.map(i => [i.name, i.unit] + SERVINGS.map(s => mixed_text(scaled(i.amount, s))))
print(table_text(rows, headers: ["ingredient", "unit"] + SERVINGS.map(s => "for ${s}")))
print("flour for 6, exactly: ${text(scaled("2 1/4", 6))} cups")
