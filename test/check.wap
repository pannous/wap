# the check of wap's test programs, test/test_<area>.wap, run by `wap test`: ✓ and the check's name when the value is
# the one expected, else ✗, the value got and the one expected; the runner counts the lines
check(name: text, value: T, expected: T) := print(if value == expected then "✓ ${name}" else "✗ ${name}: got ${show(value)}, expected ${show(expected)}")
