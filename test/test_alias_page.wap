# the examples of wiki/alias.md, each as the page writes it (the forms not built yet: test_alias_wanted.wap)
use "check.wap"

alias span => count
check("alias new => meaning adds a word", span [1, 2], 2)
alias count <= tally
check("alias meaning <= new is the same, the canonical word first", tally [1, 2, 3], 3)
check("the dash – is minus", 5 – 3, 2)
type Long = int
check("a type alias names the same type", [3 is Long, "a" is Long], [yes, no])
type Color < int
text(c: Color): text := "color " + (c as int)
check("a subtype's own words replace its base's: text(5 as Color)", text(5 as Color), "color 5")
check("a subtype's value is a value of its base: (5 as Color) + 1", (5 as Color) + 1, 6)
check("a base's value fills a subtype's place: 3 is Color", 3 is Color, yes)
shade(x: Color): text := "color"
shade(x: int): text := "int"
check("a subtype's overload is chosen for its values, its base's for the base's", [shade(5 as Color), shade(5)], ["color", "int"])
