# the forms wiki/alias.md "type aliases" shows that wap does not build yet: each red line is a to-do
use "check.wap"

type Long = int
check("a type alias names the same type", [3 is Long, "a" is Long], [yes, no])
type Bytes = list of byte
f(b: Bytes) := #b
check("a type alias of a list type", f([0x00, 0x61, 0x73, 0x6D]), 4)
