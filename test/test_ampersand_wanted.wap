# the forms wiki/&.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

square(x) := x * x
doubled(x) := x * 2
check("& between two functions composes them in reading order", (square & doubled)(3), 18)
check("&f passes a function", map &square [1 2 3], [1, 4, 9])
