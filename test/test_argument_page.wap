# the examples of wiki/argument.md: defaults and named arguments
use "check.wap"

twice(t = 1) := t * 2
check("a parameter's default fills a missing argument", twice(), 2)
minus(a, b) := a - b
check("named arguments may come in any order", minus(b: 1, a: 10), 9)
b = 5
check("b=1 among a call's arguments names the parameter and assigns nothing", [minus(b=1, a=10), b], [9, 5])
