# the forms wiki/argument.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

lasting(t = 1s) := t * 2
check("a default may be a quantity", lasting(), 2s)
total(xs: numbers) := sum(xs)
check("extra arguments gather into a last list parameter", total 1 2 3, 6)
say(level: text, parts: texts) := level + ": " + parts.join(" ")
check("extra texts gather into a last list of texts", say "warn" "a" "b", "warn: a b")
to move piece from a to b := piece + a - b
check("after to, a preposition in the head labels an argument", move 1 from: 10 to: 3, 8)
shifted(x, from a, to b) := x + a - b
check("labelled arguments come in any order", shifted 1 to: 3 from: 10, 8)
play(tone, for duration) := tone * duration
check("for labels an argument", play(440, for: 2), 880)
saved(made, as file) := made + file
check("as labels an argument", saved "a" as: "b", "ab")
