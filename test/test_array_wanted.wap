# the forms wiki/array.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

check("a type with a length in brackets is that many zeros", [int[3], float[2]], [[0, 0, 0], [0.0, 0.0]])
zeroed = int[3]
zeroed#1 = 4
check("a list of zeros reads and writes like any other", [zeroed, #zeroed], [[4, 0, 0], 3])
