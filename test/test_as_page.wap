# the examples of wiki/as.md: as converts a value and types a name
use "check.wap"

check("as converts a value", 3.14 as int, 3)
ten_times(n: int) := n * 10
check("after a call without parentheses as converts the argument", ten_times 2.2 as int, 20)
doubled_float(x: float) := x * 2.0
check("a call in parentheses converts its result", (doubled_float 2.2) as int, 4)
fib(i) as int := if i<2 then 1 else fib(i-1) + fib(i-2)
check("as gives a function its result type", fib(5), 8)
hi() as int := 42
hi() as text := "fourtytwo"
check("as after a call picks the variant of that result", hi() as int, 42)
