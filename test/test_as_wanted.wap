# the forms wiki/as.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

person as text = "Joe"
check("as types a variable", person, "Joe")
answer() as int := 42
answer() as text := "fourtytwo"
picked as text = answer()
check("a variable typed by as picks the variant of that result", picked, "fourtytwo")
