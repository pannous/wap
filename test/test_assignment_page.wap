# the examples of wiki/assignment.md: = binds a value now, := at every use
use "check.wap"

side = 3
now_squared = side*side
every_use_squared := side*side
side = 4
check("= evaluates the right side now", now_squared, 9)
check(":= evaluates the right side at every use", every_use_squared, 16)
doubled := x => x*2
check(":= with a function on the right binds the function", doubled(4), 8)
square(n) := n*n
same_square = square
check("= with a function's name names the function itself", same_square(3), 9)
first = 2
second = 3
spaced_now = first second
spaced_each_use := first second
check("= binds lower than a list of spaced values", spaced_now, [2, 3])
check(":= binds lower than a list of spaced values", spaced_each_use, [2, 3])
compared = 2
check("= in an if condition compares", (if compared = 2 then "two" else "other"), "two")
class Person { name: text; age: int }
check("in a type : declares a field", Person("Ann", 3).age, 3)
holder = {bar: 3}
check("= binds a map to a variable", holder.bar, 3)
