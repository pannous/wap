# the forms wiki/assignment.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

doubled(n: int) := n*2
plus_one(n: int) := n+1
doubled_plus_one := doubled | plus_one
check(":= with a pipe of functions binds their composition", doubled_plus_one(4), 9)
name, age, source = "Crystal, 123, GitHub".split(", ")
check("names parted by commas take a list's items", source, "GitHub")
arrowed <- 3
check("R's <- assigns", arrowed, 3)
