# the forms wiki/async.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"
use tasks

tripled(n: int): int := n * 3
awaited: int = go { tripled(3) }
check("a task put into a place typed as a value is awaited", awaited, 9)
jobs = []
jobs.add(go({1}))
check("a task given as an argument is one argument", await(jobs#1), 1)
handled = 0
finishing = go { 3 }
once finishing finishes: handled = 7
await finishing
check("once a task finishes its handler runs", handled, 7)
ch = channel()
go { for i in 1 to 3 { ch.send(i) }; ch.close() }
received = 0
for v in ch { received += v }
check("a channel hands values from one task to another until it is closed", received, 6)
shared hits = int[1]
count_up(xs) := { for i in 0..1000 { xs#1 += 1 }; 0 }
first = go { count_up(hits) }
second = go { count_up(hits) }
await first
await second
check("a shared array is reached by every task, adding atomically", hits#1, 2000)
shared total = 0
go for x in [1, 2, 3, 4, 5] { total += x }
check("go for runs each iteration as a task and ends when all did", total, 15)
