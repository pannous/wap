# the forms wiki/Bad.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

fib := if it<2 : 1 else fib(it - 1) + fib it - 2
check("a colon after an if condition reads as then, in a function of it calling itself", fib 4, 5)
check("an if with a colon picks its branch", (if (fib 4) == 5 : "of course" else "no"), "of course")
