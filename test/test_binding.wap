# wap's binding analysis: what each name refers to is decided once, by its scope (warp's notes/first_principles.md 15;
# wiki/Footguns.md "Parameter shadowing": a local named like a library word hides it only in its own function)
use "check.wap"

# a function's local never leaks into the rest of the program, whatever its name (the old compiler's push-shadowing
# bug): every check below prints
quiet() := { print = "x" }
check("a local named like a library word stays in its function", "Hello", "Hello")
# a typed parameter binds its name, its type left as written
keep(x: int) := { y = x }
check("a typed parameter", "Hello", "Hello")
# wiki/Footguns.md "Closures capturing loop variables": a function's `x = …` of a program's variable reads two ways;
# `let` makes the function its own, `global` changes the program's
kept = 1
shadow() := { let kept = 2 }
shadow()
check("let makes a new variable", kept, 1)
changed = 1
change() := { global changed = 2 }
change()
check("global changes the program's", changed, 2)
# a function that declares `global x` reads and changes the program's x, as it is when called (wiki/Footguns.md
# "Closures capturing loop variables": late binding with an explicit `global`)
named = 1
rename() := { global named
  named = 5 }
rename()
check("global x changes the program's", named, 5)
late = 1
read_late() := { global late
  late }
late = 5
check("global x reads the program's as it is when called", read_late(), 5)
unchanged = 1
read_unchanged() := unchanged
check("a variable that never changes needs no global", read_unchanged(), 1)
summed(xs: list<int>) := {
  doubled = xs.map(x => {
    taken = x * 2
    taken
  })
  taken = doubled#1 + doubled#2
  taken
}
check("a variable defined only after a function value is no variable yet in it", summed([1, 2]), 6)
found_two() := {
  found: int? = ø
  for x in [1, 2] { if x == 2 { found = x } }
  found
}
check("a variable keeps its written optional type when given ø first", found_two() == 2, yes)
enum Kind { Word, Sep }
enum Sep { Space, None }
k = Sep
check("an enum's case by its enum beside a case of the enum's name", "${#[Sep.None, Sep.Space]} ${k == Kind.Sep}", "2 yes")
# a function value inside a function that declares `global x` reads the program's x, no capture of it (wiki/Footguns.md
# "Closures capturing loop variables": an explicit `global` binds late)
count = 0
bump() := {
	global count
	count = count + 1
	[1, 2].map(x => x + count)
}
bump()
check("a function value reads a global its function names", text(bump()) + " " + text(count), "[3, 4] 2")
# a word that names another (size and length name count) is the program's own wherever the program defines it, a
# field included; only a word nothing defines reads as the word it names
class Sized { size: int }
check("a record's field named size reads as the field", Sized(9).size, 9)
class Shelf { books: list<text> }
size(shelf: Shelf) as int := #shelf.books * 10
shelf = Shelf(["a", "b"])
check("a program's own function named size is its own, called either way: size(shelf)", size(shelf), 20)
check("a program's own function named size is its own, called either way: shelf.size", shelf.size, 20)
check("length, which the program leaves undefined, reads as count", [1, 2, 3].length, 3)
pushed = [1, 2]
pushed.push(3)
check("push, which the program leaves undefined, reads as add", pushed, [1, 2, 3])
# a name's first assignment reads its value before its new variable exists (user 2026-11-26): the word around it
class Maker { name: text; make: () -> int }
made_once(m: Maker): int := {
  make = m.make()
  make + 1
}
check("a variable named as the field it takes its first value from: make = m.make()", made_once(Maker("a", () => 3)), 4)
twice(x: int) as int := x * 2
twice_once(n: int): int := {
  twice = n.twice()
  twice
}
check("a variable named as the function it takes its first value from: twice = n.twice()", twice_once(4), 8)
# `global x = …` declares the program's x for the whole function, its own value too (wiki/charged.md: global on either side)
bumped = 1
bumped_once() := { global bumped = bumped + 1 }
bumped_once()
bumped = bumped * 10
bumped_once()
check("global x = x + 1 in a function changes the program's x as it is when called", bumped, 21)
