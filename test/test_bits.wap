# Whole numbers as bits and bytes, lib/bits.warp (its header and wiki/standard-library.md): a word's instructions,
# widths of 8 to 64 bits, both byte orders, floats as their IEEE 754 bytes
use "../lib/bits.warp"
use "check.wap"

check("the bit instructions: popcount(255)", popcount(255), 8)
check("the bit instructions: leading_zeros(1)", leading_zeros(1), 63)
check("the bit instructions: trailing_zeros(8)", trailing_zeros(8), 3)
check("the bit instructions: shift_right(-1, 60)", shift_right(-1, 60), 15)
check("the bit instructions: rotate_left(1, 3, 8)", rotate_left(1, 3, 8), 8)
check("ints as bytes in both orders and back", "${text(int_bytes(258, 16))} ${text(little_endian(258, 2))} ${bytes_int([1, 2])} ${signed(255, 8)}", "[1, 2] [2, 1] 258 -1")
check("floats as their bytes and back, 32 and 64 bits", "${text(float_bytes(1.0, 32))} ${bytes_float([63, 128, 0, 0])} ${bytes_float(float_bytes(-2.5))}", "[63, 128, 0, 0] 1 -2.5")
check("half floats, f16 and bf16, as their bits and back", "${f16_bits(1.0)} ${f16_bits(65504.0)} ${f16_bits(0.0000001)} ${f16_float(1)} ${bf16_bits(3.14159)} ${bf16_float(16256)}", "15360 31743 2 5.960464477539063e-8 16457 1")
