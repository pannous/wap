# the examples of wiki/block.md: code kept to run later
use "check.wap"

kept := {1+2}
check("a block kept by := runs by a call", kept(), 3)
square_block := { it * it }
check("a block that uses it is a function of it: the call passes it", square_block(4), 16)
check("a block of it given to map", map [1 2 3] {it*it}, [1, 4, 9])
# any expression given where a block is wanted is run by the call, not at once (user 2026-11-23, card lazy-arguments)
bumps = 0
bumped(): int := { global bumps; bumps += 1; bumps }
both(action: block) := [action(), action()]
check("an expression given where a block is wanted runs at each call", both bumped(), [1, 2])
# a block in braces fits the block parameter of one definition among several (wiki/html.md routes, `get "/teapot" { … }`)
shown_with(x: text, body: block): text := x + body()
shown_with(x: int, y: int): text := "ints"
check("a block fits the one definition among several that takes a block", shown_with "ab" { "cd" }, "abcd")
# braces holding fields stay a map beside a block overload
taking(m: map<text, int>): text := "map"
taking(b: block): text := "block"
check("braces of fields are a map, braces of code a block, beside both overloads", [taking({a: 1}), taking { 3 }], ["map", "block"])
ran = 0
if_not(c: bool, body: block) := if !c: body()
if_not 0>1 { ran = 1 }
check("a parameter declared block takes a block", ran, 1)
repeated = 0
repeats(n: int, body: block) := { for i in 1 to n { body() } }
repeats 3 { repeated += 1 }
check("a block after a call's arguments is its last argument", repeated, 3)
c = 0
twice(body: block) := { body(); body() }
twice { c += 1 }
check("a block runs by a call", c, 2)
