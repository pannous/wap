# the examples of wiki/block.md: code kept to run later
use "check.wap"

kept := {1+2}
check("a block kept by := runs by a call", kept(), 3)
square_block := { it * it }
check("a block that uses it is a function of it: the call passes it", square_block(4), 16)
check("a block of it given to map", map [1 2 3] {it*it}, [1, 4, 9])
