# the forms wiki/block.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

ran = 0
if_not(c: bool, body: block) := if !c: body()
if_not 0>1 { ran = 1 }
check("a parameter declared block takes a block", ran, 1)
repeated = 0
repeats(n: int, body: block) := { for i in 1 to n { body() } }
repeats 3 { repeated += 1 }
check("a block after a call's arguments is its last argument", repeated, 3)
again_count = 0
again(n: int, block) := { for i in 1 to n { block() } }
again 2 { again_count += 1 }
check("a parameter named block is a block", again_count, 2)
timed = 0
3 times { timed += 1 }
check("times runs a block a number of times", timed, 3)
c = 0
twice(body: block) := { body(); body() }
twice { c += 1 }
check("a block runs by a call", c, 2)
a = 2
code_items = [code a+1, code a*2]
check("code before an expression keeps it as a block", code_items#2(), 4)
