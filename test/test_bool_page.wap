# the examples of wiki/bool.md: yes and no
use "check.wap"

check("true and false are yes and no, and a bool equals its number", [no == 0, yes == 1, true == yes], [yes, yes, yes])
check("bool of a value is its truthiness", [bool(0), bool([0])], [no, yes])
check("as bool reads the word", ["no" as bool, "hello" as bool], [no, yes])
check("a condition does not convert a text", if "0" {1} else {2}, 1)
check("loose equality reads a bool as its number, strict compares the type", [0 == false, 0 === false], [yes, no])
check("in is a predicate", 2 in [1, 2], yes)
kept_mark = no
check("a branch keeps its value's own kind", if kept_mark then 2 else true, yes)
