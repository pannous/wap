# the forms wiki/broadcasting.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

squared(n: number) := n*n
check("a function of one number broadcasts over a list", squared [1 2 3], [1, 4, 9])
check("a function of one number broadcasts over a map's values", squared({a: 1, b: 2, c: 3}), {a: 1, b: 4, c: 9})
check("abs broadcasts over a list", abs([-1, 2]), [1, 2])
check("round broadcasts over a list", round [1.4 2.6], [1, 3])
check("cos broadcasts over a list", cos([0.0, 0.0]), [1.0, 1.0])
