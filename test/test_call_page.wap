# the examples of wiki/call.md: calls without parentheses
use "check.wap"

check("a word takes the values after it", max 3 4, 4)
check("a call without parentheses is the one statement of a control-flow block", (if yes { sum [1 2] }), 3)
check("nested words take the result of the next", sin cos 0.0, sin(cos(0.0)))
