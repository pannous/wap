# the forms wiki/call.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

check("a minus before a call negates it", -sin 0.0, -(sin 0.0))
doubled(x: int) := x*2
check("a call without parentheses after an operator takes the values after it", 1 + doubled 3, 7)
