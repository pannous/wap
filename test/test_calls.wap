# wap's calls written with a dot (wiki/function.md: `x.f(a)` is just another way to write `f(x, a)`): `x.f` is
# f(x), `x.f(y)` is f(x, y), any function on any value, a chain read in order
use "check.wap"

twice(n: int): int := n
x = 3
check("x.f calls f with x", x.twice, 3)
second(a: int, b: int) := b
check("x.f(y) calls f with x first", 3.second(4), 4)
one(a: int) := a
two(a: int, b: int) := b
check("a dot chain runs in order", 5.one.two(6), 6)
shout(t: text) := t
check("a dot call on a text", "hey".shout, "hey")
which(a: int) := 1
which(a: text) := 2
check("x.f picks the f that takes x's type", "st".which, 2)
same(a: T, b: T) as text := "any"
same(a: T?, b: T?) as text := "optional"
maybe: int? = 3
check("an overload writing more structure is more specific: T? beats T: same(maybe, maybe)", same(maybe, maybe), "optional")
check("an overload writing more structure is more specific: T? beats T: same(1, 2)", same(1, 2), "any")
enum Color { red green }
enum Tone { low high }
==(a: Color, b: Color): bool := yes
check("a definition for a named enum wins over one for any enum: Color.red == Color.green", Color.red == Color.green, yes)
check("a definition for a named enum wins over one for any enum: Tone.low == Tone.high", Tone.low == Tone.high, no)
hi() as int := 42
hi() as text := "fourtytwo"
t = hi() as int
check("a word with several results gives the one that is wanted", text(t) + " " + (hi() as text), "42 fourtytwo")
class P { name: text }
check("a type's words travel with it: a library's show of a list finds each record's own show", show([P("a"), P("b")]), '[P{name: "a"}, P{name: "b"}]')
class Named { name: text }
show(p: Named) as text := "P " + p.name
check("a word the program writes wins over the one a rule writes for the same type: a class's own show: show(Named(\"a\"))", show(Named("a")), "P a")
check("a word the program writes wins over the one a rule writes for the same type: a class's own show: show([Named(\"b\")])", show([Named("b")]), "[P b]")
# a part's item called, `b.fs["a"]("x")`, calls the item the part holds, never fs on b
class Handlers { fs: map<text, (text) -> text> = {} }
exclaimed(s: text) as text := s + "!"
handlers = Handlers({"a": exclaimed})
check("a part's item is called", handlers.fs["a"]("x"), "x!")
picked = [1]
picked.add(if picked.count > 0 then 2 else 3)
check("a dot call's argument may be an if-expression", picked, [1, 2])
