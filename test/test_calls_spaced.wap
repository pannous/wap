# A call written with a blank before its brackets (wiki/significant-whitespace.md: `f() == f ()`). Its own program: a
# refusal stops only this check
use "check.wap"

f() := 7
check("a call with a blank before its empty brackets", f (), 7)
# a function's name glued to a map calls it with the map (decision spaced-is-two); spaced, the two are two items
entries(m: map<text, int>) := #m
check("a function glued to a map is called with it", entries{a: 1, b: 2}, 2)
