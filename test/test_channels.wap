# the standard module channels (wiki/async.md "Channels"): values handed from one task to another
use "check.wap"
use channels
use tasks

ch = channel()
go { for i in 1 to 3 { ch.send(i) }; ch.close() }
check("a receive runs the tasks until one sent a value, the oldest first", [ch.receive(), ch.receive()], [1, 2])
check("a closed channel still gives what waits in it", ch.receive(), 3)
check("receiving on a closed, empty channel is an error", try ch.receive() catch e { "refused" }, "refused")
check("sending on a closed channel is an error", try ch.send(4) catch e { "refused" }, "refused")
