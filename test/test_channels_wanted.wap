# the channel forms wiki/async.md "Channels" shows that wap does not build yet: each red line is a to-do
use "check.wap"
use channels
use tasks

handed = channel()
go { send 5 to handed }
check("send v to ch is ch.send(v)", handed.receive(), 5)
chat = channel "chat"
chat.send("hi")
check("channel \"chat\" is the machine-wide channel of that name, listening from its assignment on", chat.receive(), "hi")
