# the examples of wiki/char.md: characters of a text
use "check.wap"

check("a one-character text is a character", 'a' == "a", yes)
check("# reads a character, safely past wide ones", "aβc"#2, 'β')
check("# counts characters, byte_size counts bytes", [#"aβc", byte_size("aβc")], [3, 4])
check("count bytes of a text counts its UTF-8 bytes", count bytes of: "aβc", 4)
check("count chars of a text counts its characters", count chars of: "aβc", 3)
check("a text's bytes are still its bytes beside the counting unit", "aé".bytes, [97, 195, 169])
