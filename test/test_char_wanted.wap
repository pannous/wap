# the forms wiki/char.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

check("chars lists a text's characters", "abc".chars, ['a', 'b', 'c'])
replaced = "abc"
replaced#2 = 'β'
check("# sets a character safely", replaced, "aβc")
check("count graphemes of a text counts the characters a reader sees", count graphemes of: "⚠️βć", 3)
