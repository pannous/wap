# the examples of wiki/charged.md: when code runs
use "check.wap"

square_named(x: int) := x*x
square_alias = square_named
check("a function given to a name is that function", square_alias(3), 9)
base = 3
area := base*base
base = 4
check("a getter reads a changed variable at each use, no global needed", area, 16)
doubled := n => n*2
check("a function value after := is called as that function", doubled(3), 6)
ran_at_once = {1+2}
check("braces after = run at once and give their value", ran_at_once, 3)
