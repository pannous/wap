# the forms wiki/charged.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

squared_global = 3
def read_global(): global squared_global; squared_global*squared_global
squared_global = 4
check("global reads the variable as it is when called", read_global(), 16)
global limit = 10
def below_limit(n){n < limit}
check("a variable declared global is shared with every function", below_limit(3), yes)
fs = []
for i in 0..3 { fs.add(n => n + i) }
check("a function made in a loop keeps that iteration's value", [fs#1(0), fs#2(0), fs#3(0)], [0, 1, 2])
def fib(n): if n < 2 then n else fib(n-1) + fib(n-2)
check("def with a colon defines", fib(10), 55)
three := {1+2}
check("a block runs by a call", three(), 3)
check("interpret runs a block fully", interpret three, 3)
a = 1; b = 2
o = {s1: a+b, s2 := a+b}
check("in braces : gives data and := a getter", [o.s1, o.s2], [3, 3])
check("data keeps a call as a list", #(data [cube 3]), 2)
unless(c: bool, body: block) := if !c: body()
set_by_block = 0
unless(no, {set_by_block = 5})
check("a block parameter takes its argument unevaluated", set_by_block, 5)
