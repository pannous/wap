# the examples of wiki/choices.md: comments both ways, everything an expression
use "check.wap"

hashed = 1 # a comment
slashed = 2 // another comment
check("# and // both start a comment", hashed + slashed, 3)
picked = if yes then 1 else 2
check("there is no difference between statements and expressions: an if gives a value", picked, 1)
