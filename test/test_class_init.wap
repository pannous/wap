# A class's constructor init (wiki/class.md "init is the constructor", wiki/keyword.md init): a call of the class runs
# its init with the arguments (red: wap does not run init yet)
use "check.wap"

class P { x: int = 0
	init(v: int) := { x = v * 2 }
}
check("init runs for a call of the class", P(3).x, 6)
class Q { x: int = 0
	init(v: text) := { x = #v }
}
check("init takes arguments other than the fields", Q("abcd").x, 4)
