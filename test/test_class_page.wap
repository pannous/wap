# the examples of wiki/class.md: receivers and defaults
use "check.wap"

class Counter { c: int; inc() := { c = c + 1 } }
counted = Counter(1)
counted.inc()
check("inside a method bare field names write the receiver", counted.c, 2)
class Shared { pi = 3 }
check("a plain value in a class body is a per-instance default", Shared().pi, 3)
