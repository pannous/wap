# the examples of wiki/class.md: receivers and defaults
use "check.wap"

class Counter { c: int; inc() := { c = c + 1 } }
counted = Counter(1)
counted.inc()
check("inside a method bare field names write the receiver", counted.c, 2)
class Shared { pi = 3 }
check("a plain value in a class body is a per-instance default", Shared().pi, 3)
class Shape { x: int }
class Square extends Shape { side: int }
check("a class extending another has its fields, then its own", Square(1, 4).side, 4)
class Tile < Shape {}
check("class B < A inherits A's fields", Tile(5).x, 5)
class Cube extends Square { depth: int }
check("a class extending one that extends another has the fields of both", Cube(1, 2, 3).x, 1)
class Plank: Shape { long: int }
check("class B: A inherits A's fields", Plank(2, 9).x, 2)
class Stepper { step: (Stepper) -> int; start: int }
class Ticker extends Stepper { label: text }
check("a class extending one with a function field taking it has the base's fields", Ticker(c => 1, 7, "t").start, 7)
class Doubled { x: int; twice() := x * 2 }
class Wider extends Doubled { z: int }
check("a class extending another takes its methods", Wider(3, 4).twice(), 6)
class Widest extends Wider {}
doubled_x(d: Doubled) := d.x
check("a value of a class two steps down fits a place typed by the first", doubled_x(Widest(4, 5)), 4)
class Trunk { next: Branch? }
class Branch extends Trunk {}
check("a class extending one whose field names it", Branch(Branch(ø)).next != ø, yes)

class Animal { name: text }
class Dog extends Animal { }
names(xs: list<Animal>) := xs.map(it.name)
check("a list of a subclass passes where a list of its parent is wanted", names([Dog("Rex")]), ["Rex"])
