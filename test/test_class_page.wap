# the examples of wiki/class.md: receivers and defaults
use "check.wap"

class Counter { c: int; inc() := { c = c + 1 } }
counted = Counter(1)
counted.inc()
check("inside a method bare field names write the receiver", counted.c, 2)
class Shared { pi = 3 }
check("a plain value in a class body is a per-instance default", Shared().pi, 3)
class Shape { x: int }
class Square extends Shape { side: int }
check("a class extending another has its fields, then its own", Square(1, 4).side, 4)
class Tile < Shape {}
check("class B < A inherits A's fields", Tile(5).x, 5)
class Cube extends Square { depth: int }
check("a class extending one that extends another has the fields of both", Cube(1, 2, 3).x, 1)
class Plank: Shape { long: int }
check("class B: A inherits A's fields", Plank(2, 9).x, 2)
class Counter { step: (Counter) -> int; start: int }
class Ticker extends Counter { label: text }
check("a class extending one with a function field taking it has the base's fields", Ticker(c => 1, 7, "t").start, 7)
