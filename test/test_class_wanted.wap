# the forms wiki/class.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"
use units

class Spot { x: int; y: int }
check("an instance built by position reads by position", Spot(2, 3)#1, 2)
class Animal { name: "?" }
check("a field given a value declares its default", Animal().name, "?")
class Box { v: int; double := v * 2 }
check("a body definition without parentheses is a getter", Box(4).double, 8)
class Base { x: int }
class Derived extends Base {}
base_x(a: Base) := a.x
check("a value of a class extending another fits a place typed by it", base_x(Derived(4)), 4)
check("a map with all the fields fits a class extending none", base_x({x: 3}), 3)
measured(d: Length) := d
check("a conversion to the class fits a place typed by it", measured(5), 5m)
class full name { given:text; family:text }
ann = full name{given:"Ann", family:"Lee"}
check("a class name of several words is one name", ann.family, "Lee")
check("a class name of several words prints with a hyphen", "${type of ann}", "full-name")
