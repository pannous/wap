# command line options, lib/cli.wap (wiki/library-cli.md): options parsed from a spec, git-style commands, help texts
use cli
use "check.wap"

spec = [
	{name: "verbose", short: "v", kind: "flag", help: "talk more"},
	{name: "count", short: "n", kind: "int", default: 1, help: "how many"},
	{name: "tag", short: "t", many: yes, help: "a tag, again for more"},
	{name: "mode", choices: ["fast", "safe"], default: "safe"},
	{name: "out", required: yes, help: "where to write"},
	{name: "files", positional: yes, many: yes, help: "the inputs"}
]
refusal(argv: list<text>): text := try {
	parse_args(spec, argv)
	"accepted"
} catch e { e.message }

check("short options combined, = values, many, positionals and --", show(parse_args(spec, ["-vn3", "--out=report.txt", "a.csv", "--tag", "x", "-ty", "--", "-b.csv"])), "{help: no, verbose: yes, count: 3, tag: [\"x\", \"y\"], mode: \"safe\", out: \"report.txt\", files: [\"a.csv\", \"-b.csv\"]}")
check("--no-, a negative number, a choice", show(parse_args(spec, ["--out", "o", "--no-verbose", "--count=-2", "--mode", "fast"])), "{help: no, verbose: no, count: -2, tag: [], mode: \"fast\", out: \"o\", files: []}")
check("a value not among the choices", refusal(["--mode=quick", "--out=o"]), "cli: --mode is one of fast, safe, not quick")
check("a required option left out", refusal(["a.csv"]), "cli: missing required --out")
check("an unknown option", refusal(["--out=o", "--colour"]), "cli: unknown option --colour")
check("the other refusals", [refusal(["--out"]), refusal(["--out=o", "-n"]), refusal(["--out=o", "--count=x"]), refusal(["--out=o", "--verbose=1"])], ["cli: --out needs a value", "cli: -n needs a value", "cli: --count wants an int, not x", "cli: --verbose takes no value"])
check("-h gives help and checks nothing", show(parse_args(spec, ["-h", "--colour"])["help"]), "yes")
check("the help text", cli_help("prog", spec), "usage: prog [-h] [--verbose] [--count COUNT] [--tag TAG] [--mode {fast,safe}] --out OUT [files ...]

positional arguments:
  files                 the inputs

options:
  -h, --help            show this help
  -v, --verbose, --no-verbose
                        talk more
  -n, --count COUNT     how many (default 1)
  -t, --tag TAG         a tag, again for more
  --mode {fast,safe}    (default safe)
  --out OUT             where to write (required)")

globals = [{name: "file", short: "f", default: "todo.json", help: "the store"}]
commands = {
	add: {help: "add a todo", options: [{name: "priority", short: "p", choices: ["low", "high"], default: "low"}, {name: "title", positional: yes, many: yes}]},
	done: {help: "mark one done", options: [{name: "id", kind: "int", positional: yes}]}
}
check("a command with global options", show(parse_commands(globals, commands, ["-f", "work.json", "add", "-p", "high", "call", "Ada"])), "{help: no, file: \"work.json\", command: \"add\", priority: \"high\", title: [\"call\", \"Ada\"]}")
check("a command's positional", show(parse_commands(globals, commands, ["done", "3"])), "{help: no, file: \"todo.json\", command: \"done\", id: 3}")
check("an unknown command", try show(parse_commands(globals, commands, ["undo"])) catch e { e.message }, "cli: unknown command undo (add, done)")
check("a command without options", show(parse_commands(globals, {list: {help: "show them"}}, ["list"])), "{help: no, file: \"todo.json\", command: \"list\"}")
check("the help of a program with commands", cli_commands_help("todo", globals, commands), "usage: todo [-h] [--file FILE] {add,done} ...

commands:
  add                   add a todo
  done                  mark one done

options:
  -h, --help            show this help
  -f, --file FILE       the store (default todo.json)")
check("the help of one command", cli_command_text("todo", commands, "add"), "usage: todo add [-h] [--priority {low,high}] [title ...]

positional arguments:
  title

options:
  -h, --help            show this help
  -p, --priority {low,high}
                        (default low)")
one_file = [{name: "file", positional: yes}]
check("a positional missing, one too many", [try show(parse_args(one_file, [])) catch e { e.message }, try show(parse_args(one_file, ["a", "b"])) catch e { e.message }], ["cli: missing file", "cli: unexpected b"])
