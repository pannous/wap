# the examples of wiki/closure.md: lambdas, blocks of it and named functions as values
use "check.wap"

added = (x,y)=>{x+y}
check("a lambda has parameters", added(2, 3), 5)
check("a block with the implicit parameter it is a function", map [1 2 3] {it*it}, [1, 4, 9])
squared(n: int) := n*n
check("a named function works as a lambda", map [1 2 3] squared, [1, 4, 9])
times_itself = (x)=>x*x
check("a lambda assigned to a name is called by it", times_itself(3), 9)
