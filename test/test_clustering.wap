# lib/clustering.wap's k-means and e-means (notes/emeans.md), on two blobs of points far apart
use "check.wap"
use clustering
use random

seed(7)
points = [[0.0, 0.1], [0.2, 0.0], [0.1, 0.2], [10.0, 10.1], [10.2, 9.9], [9.9, 10.0]]
apart(labels: list<int>): bool := labels[0] == labels[1] and labels[1] == labels[2] and labels[3] == labels[4] and labels[4] == labels[5] and labels[0] != labels[3]
check("kmeans puts each blob in a cluster of its own", apart(kmeans(points, 2).labels), yes)
check("kmeans' error is the mean squared distance to the centroids", round_to(kmeans(points, 2).error, 3), 0.018)
check("kmeans_steps gives the centroids after each step, the start first", #kmeans_steps(points, 2, 4), 5)
check("emeans puts each blob in a cluster of its own", apart(emeans(points, 2).labels), yes)
