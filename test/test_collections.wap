# Collections, lib/collections.wap (wiki/library-collections.md): stacks, queues, deques, sets, counters, priority
# queues and LRU caches
use collections
use "check.wap"

s = Stack()
s.push(1)
s.push(2)
check("a stack gives its last item first", "${[s.pop(), s.size()]}", "[2, 1]")
q = Queue([1, 2, 3])
q.enqueue(4)
check("a queue gives its first item first", "${[q.dequeue(), q.size()]}", "[1, 3]")
pq = PriorityQueue([5, 1, 3])
check("a priority queue gives its smallest first", "${[pq.pop(), pq.pop()]}", "[1, 3]")
check("the items of an intersection", "${Set([1, 2, 3]).intersection(Set([2, 3, 4])).items}", "[2, 3]")
d = Deque()
d.push_back(2)
d.push_front(1)
check("a deque takes and gives at both ends", "${[d.pop_back(), d.popleft()]}", "[2, 1]")
check("an empty stack refuses pop", try "${Stack().pop()}" else "refused", "refused")
# one-letter texts are characters, compared through any (red until card any-char-equality lands)
c = Counter(["a", "b", "a", "c", "a"])
check("a counter counts each value", "${[c.get("a"), c.most_common()]}", "[3, 'a']")
cache = LRUCache(2)
cache.put("a", 1)
cache.put("b", 2)
cache.get("a")
cache.put("c", 3)
check("an LRU cache forgets its least recently used key", "${[cache.has("a"), cache.has("b")]}", "[yes, no]")
ring = Ring(3)
for x in [10, 20, 30] { ring.push(x) }
check("a push into a full ring drops its oldest item", "${[ring.push(40), ring.to_list()]}", "[10, [20, 30, 40]]")
