# lib/color.wap's colors, as wiki/graphics.md names them (red, rgb, hsv) and warp's color tests showed them
use "check.wap"
use color

check("a named color prints as its name", "${red}", "red")
check("light adds: red and blue are magenta", "${red + blue}", "#ff00ff")
check("a color less itself is black", "${red - red}", "black")
check("a color times a number scales its channels, capped", "${gray * 2.0}", "white")
check("a CSS hex text reads as its color", red + blue == color("#ff00ff"), yes)
check("the short CSS hex form doubles each digit", color("#00f") == blue, yes)
check("rgb takes channels from 0 to 255", "${rgb(16.0, 32.0, 48.0)}", "#102030")
check("a color not opaque prints its alpha last", "${with_alpha(red, 0.5)}", "#ff000080")
check("eight hex digits end in the alpha", alpha_of(color(0xFF800080)), 128)
check("mix goes halfway by default", "${mix(red, blue)}", "#800080")
check("hsv gives a hue's color", "${hsv(120.0, 1.0, 1.0)}", "#00ff00")
check("a named color is found by its name", "${color_named("purple") ?? black}", "purple")
check("a color as its CSS number, alpha last", rgba_hex(red), 0xff0000ff)

check("a color from a hex code", "${color(0xFF0000)}", "red")
