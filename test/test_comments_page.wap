# the examples of wiki/comments.md: the comment forms and the glued #
use "check.wap"

/// a documentation comment
## a documentation comment too
blocked = 1 /* a block comment */ + 2
check("/* */ is a block comment", blocked, 3)
hashed = 1 /# a hash block comment #/ + 2
check("/# #/ is a block comment", hashed, 3)
counted = "abc"
check("a # glued to what follows is the count", #counted, 3)
check("floor division is spelled /!", 7 /! 2, 3)
