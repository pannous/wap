# Complex numbers, lib/complex.wap (wiki/library-complex.md): arithmetic with plain numbers on either side, the
# principal sqrt, exp and log, the text form
use complex
use math
use "check.wap"

check("a product", (Complex(1, 2) * Complex(3, 4)).text(), "-5+10i")
check("the square root of -1", complex_sqrt(-1).text(), "i")
check("the length", complex_abs(Complex(3, 4)), 5.0)
check("Euler's identity", complex_near(complex_exp(Complex(0, pi)), -1, 0.000000001), yes)
check("a plain number on the left", (10 - Complex(1, 1)).text(), "9-i")
check("a quotient by a plain number on the left", (1 / Complex(0, 1)).text(), "-i")
check("log undoes exp", complex_near(complex_log(complex_exp(Complex(1, 0.5))), Complex(1, 0.5), 0.000000001), yes)
check("a power", complex_near(complex_pow(Complex(0, 1), Complex(2, 0)), -1, 0.000000001), yes)
# (wiki/keyword.md: ⅈ, the imaginary unit, `ⅈ * ⅈ` → -1)
check("ⅈ times ⅈ is -1", text(ⅈ * ⅈ), "-1")
check("a number glued to ⅈ is its imaginary part", text(3 + 4ⅈ), "3+4i")
check("a whole power of a complex number", text(ⅈ ^ 2), "-1")
