# DEFLATE, gzip and zlib, lib/compress.wap (wiki/library-compress.md)
use compress
use text
use hash
use "check.wap"

check("gzip and back", from_utf8(gunzip(gzip("hello"))), "hello")
check("zlib and back", from_utf8(decompress(compress("hello"))), "hello")
check("raw deflate and back", from_utf8(inflate(deflate("xy"))), "xy")
check("bytes back as bytes", decompress(compress("hello")) == to_utf8("hello"), yes)
check("Adler-32", adler32("Wikipedia"), 300286872)
check("CRC-32", crc32("hello"), 907060870)
check("zlib's own bytes for hello", compress("hello"), [120, 156, 203, 72, 205, 201, 201, 7, 0, 6, 44, 2, 21])
repeated = "abcabcabcabcabcabcabcabcabcabc" * 20
check("repeats shrink and come back", [#deflate(repeated) < 30, from_utf8(inflate(deflate(repeated))) == repeated], [yes, yes])
check("corrupt input raises", try from_utf8(decompress([120, 156, 1, 2])) else "refused", "refused")
