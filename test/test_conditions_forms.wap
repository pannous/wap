# wap's If (wap/kernel/forms.wap: If; wiki/keyword.md): `if c then a else b`, `if c { a } else { b }`, the else
# optional. With both parts of one type an If has the chosen part's value. The forms an If is written in; its
# conditions' truthiness and what a guard finds: test/test_conditions_truthiness.wap
use "check.wap"

check("the then part when yes", if yes then "a" else "b", "a")
check("the else part when no", if no { "a" } else { "b" }, "b")
shown = "c"
if no { shown = "a" }
check("no else part", shown, "c")
check("else if chains", if no then "a" else if yes then "b" else "c", "b")
x = if no then 1 else 2
check("an If's value given to a name", x, 2)
pick(c: bool) := if c then 10 else 20
check("an If's value as a function's result", pick(yes), 10)
grouped = (if no then 1 else 2)
check("an if in round brackets is one phrase", grouped, 2)
# and, or: the second part runs only when the first does not decide (wiki/operator.md); loud() says it ran
said = ""
loud(): bool := { global said; said = said + "ran "; yes }
skipped = if no and loud() then "a" else "b"
check("and skips its second part after no", said + skipped, "b")
said = ""
run = if yes and loud() then "a" else "b"
check("and runs its second part after yes", said + run, "ran a")
said = ""
short = if yes or loud() then "a" else "b"
check("or skips its second part after yes", said + short, "a")
check("not turns a condition round", [if not no then "a" else "b", if !yes then "c" else "d"], ["a", "d"])
check("an if later in a phrase is the earlier word's argument", text if no then "one" else "two", "two")
chosen = no ? 1 : 2
check("c ? a : b chooses", chosen, 2)
check("a choice as a spaced call's argument", text yes ? "a" : "b", "a")
guarded: list<text> = []
guarded.add("shown") if yes
guarded.add("hidden") if no
guarded.add("end")
check("a statement guarded after it", guarded, ["shown", "end"])
c = no
line = ""
if c {
	line = "a"
}
else if not c { line = "d" }
else { line = "e" }
check("an else on the next line continues the if", line, "d")
indented = if c then 1
	else 2
below = ""
if c then below = "a"
	else if c then below = "b"
	else below = "c"
check("an else indented below continues the if", "${indented} ${below}", "2 c")
positive(a: int) as int? := if a > 0 then a else ø
doubled(a: int) as int := {
	y = positive(a) ?? return 0
	y * 2 }
check("?? runs its right side only when the left is missing", [doubled(3), doubled(-1)], [6, 0])
on = yes
body = ""
if on
	body = "body"
check("a block indented below an if is its body", body, "body")
assigned = 0
if c then assigned = 1 else assigned = 2
xs = [1]
if not c then xs[0] = 5 else xs.add(2)
check("an assignment in a then or else part assigns there", [assigned, xs[0]], [2, 5])
items = [1] + [if no then 2 else 3]
check("an if as a list's one item", items#2, 3)
