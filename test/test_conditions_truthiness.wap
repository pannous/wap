# wap's If (wap/kernel/forms.wap: If; wiki/keyword.md): its condition's truthiness (wiki/truthiness.md) and what a guard
# finds present for the statements after it. The forms an If is written in: test/test_conditions_forms.wap
use "check.wap"

xs = [1]
t = ""
o: int? = ø
seen: list<text> = []
if xs { seen.add("list") }
if not t { seen.add("empty text") }
if xs and not o { seen.add("both") }
if o or xs { seen.add("either") }
check("a list, a text and an optional are conditions by their truthiness", seen, ["list", "empty text", "both", "either"])
plus_one(o: int?) := if o then o + 1 else 0
check("an optional tested bare is its value where present: plus_one(2)", plus_one(2), 3)
check("an optional tested bare is its value where present: plus_one(ø)", plus_one(ø), 0)
missing: int? = ø
check("0, 0.0, an empty text or list and a missing value are empty, and falsy: text(0 is empty) + \" \" + text(0.0 is empty) + \" \" + text(\"\" is empty) + \" \" + text([] is empty) + \" \" + text(missing is empty) + \" \" + text(3 is empty)", text(0 is empty) + " " + text(0.0 is empty) + " " + text("" is empty) + " " + text([] is empty) + " " + text(missing is empty) + " " + text(3 is empty), "yes yes yes yes yes no")
check("0, 0.0, an empty text or list and a missing value are empty, and falsy: (if 0 then \"t\" else \"f\") + (if [1] then \"t\" else \"f\") + (if \"\" then \"t\" else \"f\")", (if 0 then "t" else "f") + (if [1] then "t" else "f") + (if "" then "t" else "f"), "ftf")
count: int? = 0
check("an optional holding 0 is falsy", if count then "truthy" else "falsy", "falsy")
class Escape { reads: int }
found(n: int) as Escape? := if n > 1 then Escape(n) else ø
reads_of(n: int) as int := {
	escape = found(n)
	if escape == ø { return 0 }
	escape.reads + 1
}
counted(n: int) as int := {
	escape = found(n)
	total = 0
	while total < 6 {
		if escape == ø { break }
		total = total + escape.reads
	}
	total
}
check("a guard whose block never finishes leaves the variable present for the statements after it, in a loop's body too: reads_of(5)", reads_of(5), 6)
check("a guard whose block never finishes leaves the variable present for the statements after it, in a loop's body too: reads_of(0)", reads_of(0), 0)
check("a guard whose block never finishes leaves the variable present for the statements after it, in a loop's body too: counted(2)", counted(2), 6)
check("a guard whose block never finishes leaves the variable present for the statements after it, in a loop's body too: counted(0)", counted(0), 0)
looped(n: int) as text := {
	escape = found(n)
	i = 0
	while i < 0 {
		if escape == ø { break }
		i = i + 1
	}
	if escape == ø then "none" else "some"
}
tried(n: int) as text := {
	escape = found(n)
	r = try { if escape == ø { raise "none" }; escape.reads } else 0
	if escape == ø then "none" else "some"
}
handled(n: int) as text := {
	escape = found(n)
	r = try { 1 } catch e { if escape == ø { return "raised" }; 2 }
	if escape == ø then "none" else "some"
}
check("a guard inside a loop's body or a try's part narrows only there: after them the variable may still be missing: looped(0) + \" \" + looped(5)", looped(0) + " " + looped(5), "none some")
check("a guard inside a loop's body or a try's part narrows only there: after them the variable may still be missing: tried(0) + \" \" + tried(5)", tried(0) + " " + tried(5), "none some")
check("a guard inside a loop's body or a try's part narrows only there: after them the variable may still be missing: handled(0) + \" \" + handled(5)", handled(0) + " " + handled(5), "none some")
again(n: int) as text := {
	escape = found(n)
	if escape == ø { return "first" }
	escape = found(n - 4)
	if escape == ø then "none" else "some"
}
check("a variable given a new value after its guard may be missing again", again(0) + " " + again(5) + " " + again(9), "first none some")
read_either(n: int) as int := {
	escape = found(n)
	if escape == ø or n > 8 { return 0 }
	escape.reads + 1
}
check("a guard of either test, a or b, leaves what neither finds for the statements after it: read_either(5)", read_either(5), 6)
check("a guard of either test, a or b, leaves what neither finds for the statements after it: read_either(0)", read_either(0), 0)
check("a guard of either test, a or b, leaves what neither finds for the statements after it: read_either(9)", read_either(9), 0)
kept(ys: list<text>, n: int) as text := if n > 0 and ys then "yes" else "no"
check("a condition of a test and a list, a and xs, is yes when the test holds and the list has items", kept(["a"], 1) + " " + kept([], 1) + " " + kept(["a"], 0), "yes no no")
no_items: list<int> = []
word = "a"
told: list<text> = []
if no no_items { told.add("no items") }
if no [1] { told.add("wrong") } else { told.add("items") }
if no word then told.add("wrong") else told.add("a text")
b = no
check("no before a value tests it for emptiness, no alone is the literal: told", told, ["no items", "items", "a text"])
check("no before a value tests it for emptiness, no alone is the literal: [text(b) + \" \" + text([1, ø].contains(ø))]", [text(b) + " " + text([1, ø].contains(ø))], ["no yes"])
class Inner { n: int }
class Outer { inner: Inner? }
outer = Outer(Inner(3))
present: list<text> = []
if outer.inner != ø { present.add(text(outer.inner.n)) }
bare = Outer(ø)
if bare.inner == ø { present.add("none") } else { present.add(text(bare.inner.n)) }
check("a condition finds a field of a variable present as it finds the variable", present, ["3", "none"])
class Box { n: int }
shifted(box: Box?, ns: list<int>) as list<int> := {
	if box == ø { return [] }
	ns.map(x => x + box.n)
}
check("what a condition finds of a variable holds in a function value that captures it", shifted(Box(10), [1, 2]), [11, 12])
value_of(n: Node?) as text := if n is Text { match n { Text(value) => value } } else "other"
check("a shape test narrows an optional value to the shape, as it does a present one", value_of(Text("a")) + " " + value_of(ø), "a other")
first_or(ns: list<int?>) as int := if ns#1 == ø or ns#1 < 0 then 0 else ns#1 + 1
check("a condition finds an item at a written place present, on the right of an or too: first_or([4, ø])", first_or([4, ø]), 5)
check("a condition finds an item at a written place present, on the right of an or too: first_or([ø, 2])", first_or([ø, 2]), 0)
check("a condition finds an item at a written place present, on the right of an or too: first_or([-3])", first_or([-3]), 0)
# wiki/ambiguity.md "is not": `a is not b` reads `not (a is b)`, of a predicate and of a type alike
five = [5]
no_items: list<int> = []
check("a is not b is not (a is b): five is not empty", five is not empty, yes)
check("a is not b is not (a is b): no_items is not empty", no_items is not empty, no)
check("a is not b is not (a is b): 3 is not text", 3 is not text, yes)
class D { by_name: map<text, list<int>> }
class P { d: D }
made(x: int) as P? := if x > 1 then P(D({})) else ø
compared: list<text> = []
if made(2) != ø { compared.add("some") }
if made(0) == ø { compared.add("none") }
if made(0) is ø { compared.add("is none") }
check("a comparison with ø tests whether the value is missing, whatever its type compares by", compared, ["some", "none", "is none"])
# a word a rule writes means its function past a program's variable of that name: `x == ø` is missing(x) beside a
# variable `missing`
missing: int? = ø
escape_text(escape: int?) as text := if escape == ø then "none" else "some"
check("a variable named as a rule's word leaves the rule's word alone: escape_text(ø)", escape_text(ø), "none")
check("a variable named as a rule's word leaves the rule's word alone: escape_text(1)", escape_text(1), "some")
check("a variable named as a rule's word leaves the rule's word alone: text(missing == ø)", text(missing == ø), "yes")
class Tally { n: int }
tally_of(tally: Tally?) as int := {
	known = tally != ø
	if known { return tally.n }
	0
}
check("a variable holding a condition carries what the condition found: tally_of(Tally(4))", [tally_of(Tally(4)), tally_of(ø)], [4, 0])
check("a value or a condition, as a condition, reads the value's truthiness: while waiting or n < 2", {
	waiting: list<int> = []
	n = 0
	while waiting or n < 2 { n = n + 1 }
	n
}, 2)
check("a or b is a's value when a is not empty", [[1] or [2], [] or [2]], [[1], [2]])
check("a list made empty and grown by +=", {
	grown = []
	grown += ["a"]
	#grown
}, 1)
