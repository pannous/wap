# YAML, TOML and INI, lib/yaml.wap, lib/toml.wap, lib/ini.wap (wiki/library-config-formats.md): configuration read
# into maps and lists and written back
use yaml
use toml
use "check.wap"

check("TOML tables and arrays", show(parse_toml("title = \"demo\"\n[server]\nport = 8080\nhosts = [\"a\", \"b\"]\n")), "{title: \"demo\", server: {port: 8080, hosts: [\"a\", \"b\"]}}")
check("TOML written", to_toml({title: "demo", server: {port: 8080}}), "title = \"demo\"\n\n[server]\nport = 8080\n")
check("TOML arrays of tables, dotted keys, inline tables", show(parse_toml("a.b = 1.5 # note\n[[fruit]]\nname = 'apple'\n[[fruit]]\nname = \"pear\"\npoint = {x = 1, y = 2}\n")), "{a: {b: 1.5}, fruit: [{name: \"apple\"}, {name: \"pear\", point: {x: 1, y: 2}}]}")
check("TOML read back", show(parse_toml(to_toml(parse_toml("x = [1, 2]\nflag = true\nwhen = 1979-05-27T07:32:00Z\n[t]\nf = 2.0\n")))), "{x: [1, 2], flag: yes, when: \"1979-05-27T07:32:00Z\", t: {f: 2}}")
check("a key twice is refused", try show(parse_toml("a = 1\na = 2")) else "refused", "refused")
check("a table header left open is refused", try show(parse_toml("[server\nport = 1")) else "refused", "refused")

check("YAML read", show(parse_yaml("name: wap\nversion: 1.5\ntags: [lang, wasm]\n")), "{name: \"wap\", version: 1.5, tags: [\"lang\", \"wasm\"]}")
check("YAML written", to_yaml({name: "wap", tags: ["lang", "wasm"]}), "name: wap\ntags:\n  - lang\n  - wasm\n")
check("YAML nesting, items holding maps, comments, quotes, the core schema", show(parse_yaml("# servers\nservers:\n- name: a   # first\n  port: 80\n- name: 'b''s'\n  tags:\n    - x\non: true\nnote: \"a: b\"\nflow: {k: [1, 2.5], m: no}\n")), "{servers: [{name: \"a\", port: 80}, {name: \"b's\", tags: [\"x\"]}], on: yes, note: \"a: b\", flow: {k: [1, 2.5], m: \"no\"}}")
# TODO a map holding ø shown whole once show takes an any holding ø (sent to wap-lead)
is_missing(m: map<text, any>, key: text): bool := m.has(key) and m[key] == ø
check("YAML null", is_missing(parse_yaml("empty: ~\nalso: null\n"), "also"), yes)
blocks: map<text, any> = parse_yaml("poem: |\n  one\n  two\n\nprose: >\n  one\n  two\n\n  three\nafter: 1\n")
check("YAML literal block", blocks["poem"], "one\ntwo\n")
check("YAML folded block", blocks["prose"], "one two\nthree\n")
check("YAML after a block", blocks["after"], 1)
check("YAML documents", show(parse_yaml_all("a: 1\n---\n- 2\n- 3\n")), "[{a: 1}, [2, 3]]")
check("YAML read back", show(parse_yaml(to_yaml(parse_yaml("list:\n  - a: 1\n    b: [x, \"y z\"]\n  - '42'\n  - true\nmap: {}\nn: 2.0\n")))), "{list: [{a: 1, b: [\"x\", \"y z\"]}, \"42\", yes], map: {}, n: 2}")
check("a YAML key twice is refused", try show(parse_yaml("a: 1\na: 2")) else "refused", "refused")
use ini
check("INI sections and top-level keys, values kept as texts", show(parse_ini("debug = true\n[db]\nhost = localhost\nport = 5432\n")), "{debug: \"true\", db: {host: \"localhost\", port: \"5432\"}}")
check("INI written", to_ini({db: {host: "localhost"}}), "[db]\nhost = localhost\n")
check("INI comments are whole lines, quotes keep a value's spaces", show(parse_ini("; note\nurl: http://x/#top\npad = \" a \"")), "{url: \"http://x/#top\", pad: \" a \"}")
