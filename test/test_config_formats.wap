# YAML, TOML and INI, lib/yaml.wap, lib/toml.wap, lib/ini.warp (wiki/library-config-formats.md): configuration read
# into maps and lists and written back
use toml
use "check.wap"

check("TOML tables and arrays", show(parse_toml("title = \"demo\"\n[server]\nport = 8080\nhosts = [\"a\", \"b\"]\n")), "{title: \"demo\", server: {port: 8080, hosts: [\"a\", \"b\"]}}")
check("TOML written", to_toml({title: "demo", server: {port: 8080}}), "title = \"demo\"\n\n[server]\nport = 8080\n")
check("TOML arrays of tables, dotted keys, inline tables", show(parse_toml("a.b = 1.5 # note\n[[fruit]]\nname = 'apple'\n[[fruit]]\nname = \"pear\"\npoint = {x = 1, y = 2}\n")), "{a: {b: 1.5}, fruit: [{name: \"apple\"}, {name: \"pear\", point: {x: 1, y: 2}}]}")
check("TOML read back", show(parse_toml(to_toml(parse_toml("x = [1, 2]\nflag = true\nwhen = 1979-05-27T07:32:00Z\n[t]\nf = 2.0\n")))), "{x: [1, 2], flag: yes, when: \"1979-05-27T07:32:00Z\", t: {f: 2}}")
check("a key twice is refused", try show(parse_toml("a = 1\na = 2")) else "refused", "refused")
