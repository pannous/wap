# the forms wiki/constructor.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

class Tagged { name: text; id: int = 0; init() := { id = 7 } }
check("init runs for an instance written in braces", Tagged{name: "Joe"}.id, 7)
class Shouted { name: text; constructor(name) := { self.name = name + "!" } }
check("JavaScript's constructor names the init", Shouted("joe").name, "joe!")
class Asked { name: text; __init__(name) := { self.name = name + "?" } }
check("Python's __init__ names the init", Asked("joe").name, "joe?")
class Plain { name: text }
check("new before a class call builds what the call builds", (new Plain("joe")).name, "joe")
class Child { name: text; parent: text? }
check("an optional field may be left out", Child{name: "a"}.name, "a")
