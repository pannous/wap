# How a value gets to another type (wiki/conversion.md: fitting, repacking, making `T(x)`, testing; wiki/truthiness.md,
# wiki/falsey.md: `empty` is the one word a condition asks; wiki/reference.md: `copy`). One line per decided rule
use "check.wap"

check("a float made into an int is cut, written either way: int(2.7)", int(2.7), 2)
check("a float made into an int is cut, written either way: 2.7 as int", 2.7 as int, 2)
check("a bool made from a text is read from it: bool(\"no\")", bool("no"), no)
check("a bool made from a text is read from it: bool(\"0\")", bool("0"), no)
check("a bool made from a text is read from it: bool(\"yes\")", bool("yes"), yes)
check("a bool made from any other value is its test: bool([])", bool([]), no)
check("a bool made from any other value is its test: bool(3)", bool(3), yes)
check("a condition tests a text, it does not read it", if "0" then 1 else 2, 1)
a = [1]
b = copy(a)
b.add(2)
check("a copy is a list of its own: #a", #a, 1)
check("a copy is a list of its own: #b", #b, 2)
class Box { items: list<int> = [] }
check("an instance whose class says nothing counts as yes", if Box() then "yes" else "no", "yes")
size(xs: list) := #xs
check("a range where a list is wanted", size(1 to 3), 3)
check("a text and a number join: \"a\" + 3", "a" + 3, "a3")
check("a text and a number join: \"x·\" + 12", "x·" + 12, "x·12")
# decision atom-into-node: a plain atom given where a Node is wanted becomes its case
shown(n: Node) := show(n)
c: Node = 'a'
k = 2
arm: Node = match k { 1 => "one"; 2 => 2; _ => Symbol("many") }
turned: Node = match k { 1 => Symbol("many"); 2 => 2; _ => "one" }
check("an atom where a Node is wanted is its case, in assignments, arguments and arms", shown(c) + " " + shown(3) + " " + shown("hi") + " " + show(arm) + " " + show(turned) + " " + show(if k > 1 then 2.5 else Symbol("x")), "Char(\"a\") Number(3) Text(\"hi\") Number(2) Number(2) Number(2.5)")
point = "é" as codepoint
check("a text of one character is that character", text(point) + " " + text(point == char(233)), "é yes")
# the decided conversions and truthiness (wiki/conversion.md, wiki/truthiness.md)
class person { name: text; age: int }
check("an instance made from a map, each field made into its type", person({name: "Ann", age: "40"}).age + 1, 41)
hi() as int := 42
hi() as text := "fourtytwo"
t = hi() as int
check("a word with several results gives the one that is wanted", t, 42)
class Bag { items: list<int> = [] }
empty(bag: Bag): bool := #bag.items == 0
empty_bag = Bag()
full_bag = Bag([1])
check("a class says when it is empty, and every test follows: if empty_bag then \"full\" else \"empty\"", if empty_bag then "full" else "empty", "empty")
check("a class says when it is empty, and every test follows: if full_bag then \"full\" else \"empty\"", if full_bag then "full" else "empty", "full")
check("a class says when it is empty, and every test follows: if empty_bag is empty then \"empty\" else \"full\"", if empty_bag is empty then "empty" else "full", "empty")
check("a class says when it is empty, and every test follows: if not full_bag then \"empty\" else \"full\"", if not full_bag then "empty" else "full", "full")
# a character is a text too, also held in an any (wiki/Footguns.md "Tiny surprises")
texted(x: any) := if x is text then x + "!" else "?"
check("an any holding a character is a text", [texted("a"), texted("ab"), texted(3)], ["a!", "ab!", "?"])
# a list of one-letter texts made anew, `:=`, read where a list of texts is wanted (wiki/char.md:19)
LETTERS := ["a"]
holds_letter(word: text): bool := LETTERS.contains(word)
check("a constant list of one-letter texts is a list of texts inside a function", holds_letter("a"), yes)
# a value that is a T already stays itself with as T, an any holding a T is that T (wiki/conversion.md §3)
held_box: any = Box([1, 2])
check("an any holding an instance is that instance with as", #((held_box as Box).items), 2)
# a number holding an int is that int with as, and a condition's test finds the name it gives (wiki/conversion.md §3)
whole_of(value: number): int := value as int
check("a number holding an int is that int with as", whole_of(3), 3)
# a bool counts as 1 or 0 in arithmetic, never where an int is declared (wiki/Footguns.md "Booleans count as 1/0")
check("a bool counts as 1 or 0 in arithmetic", [true + true, false * 3, (1 < 2) + 1], [2, 0, 2])
check("a bool is still a bool", "${3 > 2}", "yes")
# an any holding a range passes the test for its list, in every build (wiki/conversion.md "a range is a list of its numbers")
held_range: any = 1 to 3
check("an any holding a range is a list of its numbers", held_range is list<int>, yes)
