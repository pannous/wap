# the examples of wiki/conversion.md that test_conversion.wap does not hold: fitting, repacking and making
use "check.wap"

as_number: number = 3
check("an int fits where a number is wanted", as_number, 3)
optional: int? = 3
check("a T fits where a T? is wanted", optional!, 3)
anything: any = "hi"
check("everything fits where an any is wanted", anything, "hi")
none_yet: list<int> = []
check("an empty list is a list of what is wanted", #none_yet, 0)
mixed: list = [1, "a"]
unboxed: int = mixed#1
check("an item of a bare list is checked, then plain again", unboxed, 1)
sized(xs: list) := #xs
check("a list<int> is repacked where a list is wanted", sized([1, 2, 3]), 3)
check("a range is a list of its numbers", sized(1 to 3), 3)
check("text made from a number", text(3), "3")
check("a list made from a range", list(1 to 3), [1, 2, 3])
check("an int read from a text", int("40"), 40)
check("a float read from a text", float("2.5"), 2.5)
class fahrenheit { degrees: float }
class celsius { degrees: float }
celsius(f: fahrenheit) := celsius((f.degrees - 32) * 5 / 9)
check("a class adds its own making", celsius(fahrenheit(212.0)).degrees, 100.0)
