# Vixie cron's 5-field expressions (crontab(5)), as lib/cron.wap's header describes them
use "check.wap"
use cron
use time

check("the next quarter hour", text(cron_next("*/15 * * * *", "2026-11-04 10:07")), "2026-11-04T10:15:00Z")
check("weekdays by name, a range", text(cron_next("0 9 * * mon-fri", "2026-11-07 10:00")), "2026-11-09T09:00:00Z")
check("a macro, back in time", text(cron_previous("@daily", "2026-11-04 10:07")), "2026-11-04")
check("a wall time a DST change skips never fires", text(cron_next("30 2 * * *", "2026-03-28 12:00", "Europe/Berlin")), "2026-03-30T00:30:00Z")
check("an expression matches its time", cron_matches("0 12 1 * *", parse("2026-12-01 12:00", Pattern("yyyy-MM-dd HH:mm"))), yes)
check("an invalid field raises, naming it", try { text(cron_next("61 * * * *", "2026-11-04 10:07")) } catch e { e.message }, "cron: 61 is out of the minute's 0-59")
check("a weekday range up to 7, Sunday", text(cron_next("0 9 * * 5-7", "2026-11-07 10:00")), "2026-11-08T09:00:00Z")
