# the forms wiki/crystal.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

numbered = {1:2 3:4}
check("a map with number keys needs no commas", numbered[3], 4)
skipped = 1
skipped = 2 if no
check("an if after a statement skips it otherwise", skipped, 1)
