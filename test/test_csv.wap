# CSV, lib/csv.wap (wiki/library-csv.md, RFC 4180): rows of texts, maps by the header row, and back to text
use csv
use "check.wap"

check("a quoted field keeps its comma", csv_rows("name,city\nAda,\"London, UK\"\nAlan,Wilmslow"), [["name", "city"], ["Ada", "London, UK"], ["Alan", "Wilmslow"]])
check("the rows under the header as maps", csv_maps("name,age\nAda,36\nAlan,41"), [{"name": "Ada", "age": "36"}, {"name": "Alan", "age": "41"}])
check("written back, a field with quotes or a comma is quoted, each line ends in CRLF", csv_text([["name", "note"], ["Ada", "says \"hi\", twice"]]), "name,note\r\nAda,\"says \"\"hi\"\", twice\"\r\n")
