# wap builds data as the reader reads it (wap/kernel/forms.wap Data; wiki/list.md): a list `[a, b]` is a value, `xs#i`
# its i-th item counting from 1, `#xs` how many it holds
use "check.wap"

tens = [10, 20, 30]
check("a list's item by its place", tens#2, 20)
check("a list's size", #tens, 3)
names = ["ann", "bo"]
check("a list of texts", names#2, "bo")
pair = [1, 2]
pair#1 = 5
check("an item set anew", pair#1 + pair#2, 7)
second(xs: list<int>): int := xs#2
check("a list given to a function", second [4, 5, 6], 5)
second_in_words(xs: list of int) as int := xs#2
check("a list's type in words", second_in_words [1, 2], 2)
check("an item by its index, from 0", tens[0] + tens[2], 40)
indexed = [1, 2]
indexed[1] = 5
check("an item set by its index", indexed#2, 5)
three_names = ["ann", "bo", "cy"]
check("a list of any items counted", #three_names, 3)
seen = []
for name in ["ann", "bo"] { seen.add(name) }
check("for over a list of texts", seen, ["ann", "bo"])
multiplied = [1, 2, 3]
multiplied#2 *= 5
check("a compound assignment to a list position", multiplied#2, 10)
joined = [1, 2] + [3]
check("two lists joined: #joined", #joined, 3)
check("two lists joined: joined#3", joined#3, 3)
NAMES = {yes: 1, no: 0}
check("a map written as data, read by its key", NAMES.yes, 1)
set_map = {a: 1}
set_map.a = 5
set_map.b = 7
check("a map's value set by its key, a new key added", set_map.a + set_map.b, 12)
placed = [1, 2]
placed[0] = 5
check("an item counted from 0 is a place", placed[0] + placed[1], 7)
letters = "abc"
check("a text's character counted from 0", letters[2], "c")
text_keyed = {"a": 1, "bb": 2}
check("a map with text keys, one letter long too", text_keyed["bb"] + text_keyed["a"], 3)
grown = [1]
holder = grown
for i in 1 to 9 { grown.add(i) }
check("a list grows in place, every name holding it sees the items", #holder, 10)
popping = [7, 8]
check("the last item taken off a list: popping.pop()", popping.pop(), 8)
check("the last item taken off a list: #popping", #popping, 1)
part(xs: list<int>, from: int, count: int): list<int> := xs.slice(from to from + count - 1)
check("a slice of a list, a new list of its items", show(part([1, 2, 3, 4], 1, 2)), "[2, 3]")
keyed = {a: 1, b: 2}
ks = keyed.keys()
ks.add("zz")
check("a map's keys, a new list that leaves the map as it was", "${show(ks)} ${#keyed.keys()}", '["a", "b", "zz"] 2')
has_map = {ab: 1, b: 2}
has_map.cd = 3
check("a map's keys in the order set, and whether it has a key", "${has_map.has("cd")} ${has_map.has("zz")} ${#has_map.keys()}", "yes no 3")
removing = {aa: 1, bb: 2, cc: 3}
removing.remove("bb")
removing.remove("zz")
removing.dd = 4
check("a map's entry removed, the others kept in their order", removing.aa + removing.cc + removing.dd, 8)
removed = {aa: 1, bb: 2}
removed.remove("aa")
check("remove takes a key out of a map", "${#removed.keys()} ${removed.has("aa")}", "1 no")
called_key = {"a": 1}
key_of(k: text) := k + "b"
called_key[key_of("a")] = 2
check("an entry set by a key a call gives", called_key["ab"], 2)
settled = {}
settled["a"] = 1
check("an empty map takes its entries' type from the first one given", settled["a"], 1)
wanted: map<text, text> = {}
wanted["k"] = "v"
class G { names: map<text, int> = {} }
field_map = G().names
field_map["b"] = 2
entries_counted(m: map<text, int>) as int := 7
check("an empty map of the type its place wants", "${wanted["k"]} ${field_map["b"]} ${entries_counted({})}", "v 2 7")
class P { a: int; b: int = 2 }
p = P{a: 1}
check("an instance written without a field takes the field's default", p.a + p.b, 3)
class Q { n: int; o: text? = ø }
q = Q(2)
r = Q{n: 4}
check("a field whose default is ø may be left out", "${q.n} ${r.o == ø}", "2 yes")
M = {"ab": [1], "cd": [2]}
worded = {name: "x", title: "y"}
check("a map's own word read as its part is that word, any other name its entry: M.keys#2 + \"z\"", M.keys#2 + "z", "cdz")
check("a map's own word read as its part is that word, any other name its entry: worded.name + worded.title", worded.name + worded.title, "xy")
check("a quoted key reads the entry even where a map word has its name", {name: "x", first: "y"}#"first", "y")
class person { name: text; age: int }
form = {name: "Bo", age: "7"}
class lock { keys: int }
check("an instance made from a map, each field made into its type", "${person({name: "Ann", age: "40"}).age + 1} ${person(form).name} ${lock({keys: "3"}).keys}", "41 Bo 3")
nested = [[1, 2, 3], [4]]
check("an item's own index takes the item first, as a part's does", nested#1[1 ..], [2, 3])
valued = {a: 1, b: 2}
vs = valued.values
vs.add(3)
check("a map's values, a new list in the order their keys were set", "${show(vs)} ${#valued.values()}", "[1, 2, 3] 2")
# wiki/trait.md: `f(m: map) := m.keys`, a bare map takes any map
key_count(m: map) as int := #m.keys
check("a bare map takes any map: key_count({\"a\": 1})", key_count({"a": 1}), 1)
check("a bare map takes any map: key_count({\"b\": \"x\", \"c\": \"y\"})", key_count({"b": "x", "c": "y"}), 2)
# a map of any values holds a map or a list as one of them
held: map<text, any> = {}
inner: map<text, any> = {}
inner["k"] = "v"
held["section"] = inner
held["list"] = [1]
check("a map of any values holds a map and a list", #held, 2)
# a key's value or ø (lib's unit tables, `zeros.get(symbol) ?? 0`)
got = {"a": 1}
check("get gives a key's value, ø for a missing key", "${got.get("a") ?? 0} ${got.get("b") ?? 0}", "1 0")
# a key in a map, `in` asking whether the map holds it
check("a key in a map", "${"ab" in has_map} ${"zz" in has_map}", "yes no")
# a map shown as text, its entries as written (wiki/Script.md: `{lines: 3, words: 5}`)
check("a map shown as text", text({lines: 3, words: 5}), "{lines: 3, words: 5}")
# two maps are equal when they hold the same keys, each with an equal value, in whatever order they were set
check("maps with the same entries are equal: {\"k\": 1} == {\"k\": 1}", {"k": 1} == {"k": 1}, yes)
check("maps with the same entries are equal: {a: 1, b: 2} == {b: 2, a: 1}", {a: 1, b: 2} == {b: 2, a: 1}, yes)
check("maps with the same entries are equal: {a: 1} == {a: 2}", {a: 1} == {a: 2}, no)
check("maps with the same entries are equal: {a: 1} != {a: 1, b: 2}", {a: 1} != {a: 1, b: 2}, yes)
check("a quoted key named like a word reads the key", {count: 5, b: 2}#"count", 5)
