# the forms wiki/data.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

parsed = parse("n * 1")
check("parse gives the node data gives", parsed == data(n * 1), yes)
check("the node words read parsed data", "${parsed.op}", "*")
check("a text that does not parse is an error try catches", try parse("(1 2") else "bad", "bad")
quoted = data (n * 1)
check("quoted code remembers its line", quoted.line, 7)
check("quoted code remembers its column", quoted.column, 15)
settings = data {
	// how many
	count: 3
}
check("quoted data keeps the comment above an entry", settings#1.comment, "how many")
ended = data {
	count: 3 // how many
	size: 4
}
check("quoted data keeps the comment ending an entry's line", ended#1.comment, "how many")
