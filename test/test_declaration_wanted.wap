# the forms wiki/declaration.md and wiki/function.md show that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

function squared(n: number) { n*n }
check("function declares a function as def does", squared(3), 9)
fn tripled(n: int) { n*3 }
check("fn declares a function as def does", tripled(3), 9)
fun halved(n: float) { n/2 }
check("fun declares a function as def does", halved(3.0), 1.5)
seven := {7}
check("do runs a block as a call does", do seven, 7)
