# Diffs and patches, lib/diff.wap (wiki/library-diff.md): diffs by longest common subsequence, git's unified diff,
# its patch applied back, a similarity ratio
use diff
use "check.wap"

check("the edits from one list to another", diff([1, 2, 3], [1, 3, 4]), [Keep(1), Delete(2), Keep(3), Insert(4)])
check("a unified diff of two texts", unified_diff("a\nb\nc", "a\nx\nc"), "--- a\n+++ b\n@@ -1,3 +1,3 @@\n a\n-b\n+x\n c\n")
check("a unified diff applied gives the new text", patched("a\nb\nc", unified_diff("a\nb\nc", "a\nx\nc")), "a\nx\nc")
check("how alike two words are", similarity("kitten", "sitting"), 0.6153846153846154)
