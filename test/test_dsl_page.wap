# the examples of wiki/dsl.md, each as the page writes it
use "check.wap"

shout(words: phrase): text := upper(words)
check("a phrase parameter takes the rest of the line as text", shout hello big world, "HELLO BIG WORLD")
check("parentheses stop a phrase", shout(a b) + "!", "A B!")
twice(action: block) := [action(), action()]
check("a block parameter takes wap code to run later", twice { "hi" }, ["hi", "hi"])
shader(wgsl: raw): text := dedented(wgsl)
mouse = 3
glow = shader {
  let d = distance(at.xy, vec2f($mouse));   // pixels from the pointer
  return vec4<f32>(0.0, 0.0, 1.0 - d / 200.0, 1.0);   /* a comment */
}
check("a raw block keeps its foreign text verbatim, its comments too", glow.contains("// pixels from the pointer"), yes)
check("dedented takes a raw block's common indentation off", glow.split("\n"), ["let d = distance(at.xy, vec2f($mouse));   // pixels from the pointer", "return vec4<f32>(0.0, 0.0, 1.0 - d / 200.0, 1.0);   /* a comment */"])
html(page: raw): text := page.trim()
check("html in a raw block", html { <p>it's here</p> }, "<p>it's here</p>")
