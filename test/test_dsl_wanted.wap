# the forms wiki/dsl.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

mouse = 3
glow = shader {
  let d = distance(at.xy, vec2f($mouse));   // pixels from the pointer
  return vec4f(0.0, 0.0, 1.0 - d / 200.0, 1.0);
}
check("a raw block keeps its foreign text verbatim", text(glow).contains("// pixels from the pointer"), yes)
query(q: data) := q
asked = query {select: [name age], from: people}
check("a data parameter keeps bare words as symbols", text(asked.from), "people")
check("a data parameter keeps the structure", count asked.select, 2)
