# the forms wiki/dsl.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

shout(words: phrase): text := upper(words)
check("a phrase parameter takes the rest of the line as text", shout hello big world, "HELLO BIG WORLD")
check("parentheses stop a phrase", shout(a b) + "!", "A B!")
