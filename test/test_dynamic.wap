# wap's dynamic typing (warp's notes/first_principles.md: "dynamic where we can't infer the type", "any is the dynamic
# type, and inference falls back to it", "any list fits a bare list", "one function that ranks the definitions of a
# word"): a value whose type nothing settles is an any, and a program means the same whether its types are known
use "check.wap"

describe(x: int) := "a number"
describe(x: text) := "a text"
describe(x: T?) := "maybe something"

mixed = ["ab", 1]
check("items of two types make a list of anything", #mixed, 2)
xs = ["ab", 3]
check("a known and an unknown value choose the same definition: describe(3)", describe(3), "a number")
check("a known and an unknown value choose the same definition: describe(xs#2)", describe(xs#2), "a number")
check("an unknown value chooses by what it is", describe(xs#1), "a text")
three = ["ab", 3, 4]
check("an operator of two unknown values", text(three#2 + three#3), "7")
size(ys: list) := #ys
check("a list of anything fits a parameter typed list", size(["ab", 1]), 2)
class Pen { name: text }
pens = [Pen("blue"), 3]
check("a field read on an unknown value", text(pens#1.name), "blue")
n: int = xs#2
check("an unknown value given to a typed name is checked there", n + 1, 4)
e: any = 2.5
check("an unknown value beside a known one chooses by both: e == 2.5", e == 2.5, yes)
check("an unknown value beside a known one chooses by both: e == 3.5", e == 3.5, no)
kinds(x: any) as text := if x is map then "map" else if x is list then "list" else if x is text then "text" else "other"
check("an any tells a map, a list and a text apart, whatever their item types: kinds({\"a\": 1})", kinds({"a": 1}), "map")
check("an any tells a map, a list and a text apart, whatever their item types: kinds({\"a\": \"b\"})", kinds({"a": "b"}), "map")
check("an any tells a map, a list and a text apart, whatever their item types: kinds([1])", kinds([1]), "list")
check("an any tells a map, a list and a text apart, whatever their item types: kinds(\"st\")", kinds("st"), "text")
check("an any tells a map, a list and a text apart, whatever their item types: kinds(2)", kinds(2), "other")
# a character is a text too (wiki/Footguns.md: 'A' is text → yes), held by an any as well
letter: any = "z"
check("a one-character text an any holds is a text", letter is text, yes)
# a map's value read out of an any is the map's own, whichever map of one shape came first
key_of(m: any) as any := m["k"]
check("a value read from maps held as any, a yes/no's map and a character's", [text(key_of({k: yes})), text(key_of({k: "N"}))], ["yes", "N"])
# two anys holding the same character are equal, as two holding the same text are
equal_anys(a: any, b: any) as bool := a == b
check("two anys holding one character are equal", equal_anys("a", "a"), yes)
# two lists or two instances an any holds are equal as they are without the any: by their items, by their fields
class Spot { x: int }
check("two lists anys hold are equal by their items", [equal_anys([1], [1]), equal_anys([1], [2])], [yes, no])
check("two instances anys hold are equal by their fields", equal_anys(Spot{x: 1}, Spot{x: 1}), yes)
class Point { x: int; y: int }
class Size { x: int; y: int }
check("two instances of classes of one shape anys hold differ", equal_anys(Point(1, 2), Size(1, 2)), no)
# a dispatcher never re-enters itself through its last case: lists holding lists, a map's any (wap-lead)
check("lists holding lists compare item by item", [[1, 2], 3] == [[1, 2], 3], yes)
held: map<text, any> = {k: "NN"}
check("an any read from a map compared with no", held["k"] == no, no)
# texts an any holds order as texts do (red: `<` over anys has no text case)
ys: list<any> = ["b", "a"]
check("texts held as any sort", "${ys.sorted()}", "[\"a\", \"b\"]")
# an any found a list or a map by a bare `is list`, `is map` stays an any: its calls reach the definitions for what it
# holds when the program runs
keys_of(given: any) := { if given is map { return given.keys }; [] }
check("an any found a map by is reaches the map's words: keys", keys_of({one: 1}), ["one"])
some_big(v: any): bool := { if v is list { return v.any(x => x > 1) }; no }
check("an any found a list by is reaches the list's words: any", some_big([1, 2]), yes)
counted(v: any): int := { if v is list { return #v }; 0 }
check("an any found a list by is has a count", counted([1, 2, 3]), 3)
# a function reading a map held as any without a written result: maps of different value types reach it
read_ab(m: any) := m["ab"]
check("a value read from maps held as any, whatever the maps' value types", [text(read_ab({ab: 1})), text(read_ab({ab: "x"}))], ["1", "x"])
