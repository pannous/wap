# the forms wiki/effects.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

price(net) := net * (1 + emit tax_rate)
on tax_rate { 0.2 }
check("an emit gets the value of the program's handler, however deep the call", price(100), 120.0)
# red while print may not end and may fail: its write loops until every byte is taken (Div until loops have
# measures, T5d) and stops the program when a write fails (Fail)
limited_greeting(t: text): ø ! IO := print(t)
check("a function limited to IO in its signature prints, and its effects are IO", "${effects of limited_greeting}", "IO")

# red while a function nothing calls is typed only for written parameter types: no body of double is typed
double(x): int ! Pure := x * 2
check("! Pure claims a function only computes", "${effects of double}", "Pure")
# a write through a parameter is State (notes/coc-t5b.md "Effects as facts"), until the memory model says what a write
# means
pushed(xs: list<int>) := xs.add(1)
check("a function that changes a list it is given has the effect State", "${effects of pushed}", "State")
