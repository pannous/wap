# element-wise arithmetic on lists, `.+ .- .* ./` (wiki/Footguns.md "lists": NumPy's broadcasting has its own spelling)
use "check.wap"
check("lists multiplied item by item", [1, 2] .* [3, 4], [3, 8])
check("each item plus a number", [1, 2, 3] .+ 4, [5, 6, 7])
check("float lists", [1.5, 3.0] ./ 1.5, [1.0, 2.0])
check("lists subtracted", [5, 5] .- [1, 2], [4, 3])
check("neighbours: decimals, methods, ranges", "${1.5 + .5} ${[1, 2].map(x => x * 2)} ${#(1..4)}", "2 [2, 4] 3")
class Spot { x: int, y: int }
p = Spot(3, 4)
check("a field read before * stays a field read", p.x*2, 6)
check("whole numbers divided item by item give floats", [4, 6] ./ 2, [2.0, 3.0])
