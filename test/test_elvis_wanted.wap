# the forms wiki/elvis.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

missing: int? = ø
check("?: takes the default to the right of an absent value", missing ?: 1, 1)
present: int? = 3
check("?: keeps a value that is there", present ?: 1, 3)
check("?. reads the property of a value that is there", {a: 1}?.a, 1)
