# Texts and bytes in base64, base32, hex, base58, ascii85 and z85, lib/encoding.wap (wiki/library-reference.md
# "Encodings")
use encoding
use text
use "check.wap"

check("base64", [base64_encode("foo"), base64_encode("fo"), base64_decode("Zm9vYmFy"), base64_decode("Zm8")], ["Zm9v", "Zm8=", "foobar", "fo"])
check("base32 and base32hex", [base32_encode("foo"), base32_decode("mzxw6==="), base32hex_encode("foo")], ["MZXW6===", "foo", "CPNMU==="])
check("hex of text and bytes", [hex_encode("hi"), hex_encode([0, 171, 255]), text(hex_decode_bytes("FF00"))], ["6869", "00abff", "[255, 0]"])
check("base58 keeps leading zeros", [base58_encode("hello world"), base58_encode([0, 0, 1]), text(base58_decode_bytes("112"))], ["StV1DL6CwTryKyV", "112", "[0, 0, 1]"])
check("ascii85", [ascii85_encode("Man "), ascii85_encode([0, 0, 0, 0]), ascii85_encode("hi"), ascii85_decode("<~9jqo^~>"), ascii85_decode("BP@")], ["9jqo^", "z", "BP@", "Man ", "hi"])
check("z85", [z85_encode([134, 79, 210, 111, 181, 89, 247, 91]), text(z85_decode_bytes("HelloWorld"))], ["HelloWorld", "[134, 79, 210, 111, 181, 89, 247, 91]"])
check("a character outside the alphabet raises", try base64_decode("Zm9v!") else "refused", "refused")
check("an odd hex digit raises", try hex_decode("abc") else "refused", "refused")
