# the examples of wiki/enum.md that test_variants.wap does not hold
use "check.wap"

enum Coin { Penny, Nickel, Dime }
check("Coin::Dime names the case too", Coin::Dime == Coin.Dime, yes)
check("for C a plain as int gives the index", Coin.Dime as int, 2)
class Box { n: int }
enum Kind { Box, Other }
check("beside a class of the same name the bare name is the class", Box(3).n, 3)
expected: Kind = Box
check("where its enum is expected the bare name is the case", expected == Kind.Box, yes)
check("a bare case name nothing else has is the case", Other == Kind.Other, yes)
enum Level { Error, Warning = "warn", Hint }
check("a case without a spelling is spelled by its name", Level.Error as text, "Error")
