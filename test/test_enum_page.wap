# the examples of wiki/enum.md that test_variants.wap does not hold
use "check.wap"

enum Coin { Penny, Nickel, Dime }
check("Coin::Dime names the case too", Coin::Dime == Coin.Dime, yes)
check("for C a plain as int gives the index", Coin.Dime as int, 2)
check("an int that is no case is an error naming the enum", try { 9 as Coin } catch e { e.message }, "9 is no Coin case")
class Box { n: int }
enum Kind { Box, Other }
check("beside a class of the same name the bare name is the class", Box(3).n, 3)
expected: Kind = Box
check("where its enum is expected the bare name is the case", expected == Kind.Box, yes)
check("a bare case name nothing else has is the case", Other == Kind.Other, yes)
enum Level { Error, Warning = "warn", Hint }
check("a case without a spelling is spelled by its name", Level.Error as text, "Error")
enum Measure { bytes, chars }
measured(m: Measure) := match m { bytes: 1; chars: 2 }
check("a bare case in a match arm is the subject's case, also where a function has its name", [measured(Measure.bytes), measured(Measure.chars)], [1, 2])
enum Edit { add, remove, replace }
check("a case named like a library function, add, is the subject's case in a match arm", match Edit.replace { add: "a"; remove: "rm"; replace: "set" }, "set")
# "Arguments and result types": what is written after an enum's name, `<T>`, is the same in every case
enum Stack<T> { empty, item(first: T, rest: Stack<T>) }
top(s: Stack<int>): int := match s { empty: 0; item(first, rest): first }
check("an enum's letter is the same in every case", top(Stack.item(4, Stack.empty)), 4)
words: Stack<text> = Stack.item("a", Stack.empty)
check("a case takes its letter from the type its place expects", match words { empty: ""; item(first, rest): first + "b" }, "ab")
check("two values of a generic enum are equal case by case", Stack.item(4, Stack.empty) == Stack.item(4, Stack.empty), yes)
check("a generic enum's value shows its fields", text(Stack.item(4, Stack.empty)), "item(4, empty)")
