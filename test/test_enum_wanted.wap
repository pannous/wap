# the forms wiki/enum.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

enum Coin { Penny, Nickel, Dime }
check("as index counts a case from 0", Coin.Dime as index, 2)
check("as position counts a case from 1", Coin.Dime as position, 3)
items = [10, 20, 30]
check("an index and a position find the same item", items[Coin.Dime as index] == items#(Coin.Dime as position), yes)
check("Swift's .dime names the case where its enum is expected", (.Dime) == Coin.Dime, yes)
enum Valued { Penny = 1, Nickel = 5, Dime = 10 }
check("a case carrying a number gives it as int", Valued.Dime as int, 10)
check("as takes a case's number back", 5 as Valued, Valued.Nickel)
enum Chordal { major, minor }
enum Modal { major, dorian }
kind_name(kind: Chordal): text := kind as text
check("where its enum is expected the bare name is its case, though another enum has one of that name", kind_name(major), "major")
enum Same(a: T): T -> Prop { same: Same(a, a) }
kept(p: Same(1, 1)): text := match p { same => "kept" }
check("a match on the case of an enum of equality's shape runs", kept(Same.same), "kept")
