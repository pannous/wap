# the examples of wiki/equality.md: == compares values, === is strict
use "check.wap"

check("== compares values, not types: 3 == 3.0", 3 == 3.0, yes)
check("=== is stricter: 3 === 3.0", 3 === 3.0, no)
class Point { x: int; y: int }
check("instances are equal field by field", Point(1, 2) == Point(1, 2), yes)
made(n) := (x => x + n)
check("functions differ where an argument gives different results", made(1) == made(2), no)
check("is asks equality too", 3 is 3, yes)
check("≈ compares numbers within rounding", 0.1 + 0.2 ≈ 0.3, yes)
held = 3; same = 3
check("is asks equality of two variables", held is same, yes)
check("=== converts nothing: 3 === 3.0", 3 === 3.0, no)
listed = [1]; copied = [1]
check("=== compares values, never identity", listed === copied, yes)
check("=== compares field by field", Point(1, 2) === Point(1, 3), no)
enum Chain { End; Link(rest: Chain) }
chain(n: int): Chain := if n == 0 then End else Link(chain(n - 1))
check("values of a recursive enum are equal part by part, however deep", chain(300) == chain(300) and chain(300) != chain(299), yes)
