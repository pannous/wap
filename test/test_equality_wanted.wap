# the forms wiki/equality.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

made(n) := (x => x + n)
check("functions are equal when they give equal results for every argument", made(1) == made(1), yes)
check("an int is a number", 3 is number, yes)
check("an int is of a type it can become", 3 is i32, yes)
check("== between types is exact", type(2) == type(3), yes)
check("is between types is the subtype test", type(0) is number, yes)
check("a type is not its subtype", type(0) == number, no)
check("a type is not a text", type(3) == "int", no)
check("a value never equals a type", 3 == int, no)
class Fuzzy { v: int; similar(other: Fuzzy) := yes }
check("~ asks the class's similar", Fuzzy(1) ~ Fuzzy(2), yes)
check("equal maps descend into children, an int equal to a float", {x: {y: 3.0}} == {x: {y: 3}}, yes)
class Loose { v: int }
==(a: Loose, b: Loose): bool := yes
check("== asks the class's own ==", Loose(1) == Loose(2), yes)
check("=== leaves the class's own == out", Loose(1) === Loose(2), no)
