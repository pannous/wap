# the examples of wiki/Error.md: raised errors caught by try, and the fallbacks of a missing value
use "check.wap"

check("try … else gives the fallback when the body raises", try raise "x" else 0, 0)
items = [1, 2]
check("an index out of range raises, and try catches it", try items[5] else 0, 0)
# wiki/Footguns.md "Index out of range": place 0 and a write past the end raise too
check("a list's place 0 raises, and try catches it", try items#0 else 7, 7)
check("a write past a list's end raises, and try catches it", try { items#4 = 0; 1 } else 7, 7)
check("catch names the Error, which knows its text", try { raise "boom" } catch e { e.message }, "boom")
check("throw is raise", try { throw "boom" } catch e { e.message }, "boom")
check("a catch that names no Error", try { raise "boom" } catch { 7 }, 7)
caught = try { raise "boom" } catch e { e }
check("the caught Error kept as a value", caught.message, "boom")
x = ø
check("?? replaces a missing value", x ?? 5, 5)
check("or replaces every falsy value", 0 or 10, 10)
check("assert gives 1 when its condition holds", assert 1 + 1 == 2, 1)
check("assert raises when its condition fails", try { assert(1 > 2, "too small") } catch e { e.message }, "too small")
# a braceless call after ?? is its right side: `x ?? raise "none"` raises only where x is missing
check("?? raise raises for a missing value", try { x ?? raise "none" } catch e { e.message }, "none")
named: text? = "Ann"
check("?? raise gives a value that is there", named ?? raise "none", "Ann")
# a try around code that gives nothing gives a value of its own when it succeeds
raising_above(x: int) := { if x > 0 { raise "big" } }
check("a try of code giving nothing names its own value", [try { raising_above(3); "ok" } catch e { "refused" }, try { raising_above(0); "ok" } catch e { "refused" }], ["refused", "ok"])
failing(x: int): int or Error := if x < 0 then error("negative") else x
check("a failable value holds an Error that failed tests", [failing(0 - 1) is failed, failing(3) is failed, failed(failing(0 - 2))], [yes, no, yes])
kept: int = failing(3)
check("a failable value holds its value when it succeeds", kept, 3)
check("an Error given where a type without Error is wanted stops the program with it", try { taken: int = failing(0 - 1); taken } catch e { e.message }, "negative")
check("an Error is empty", if no failing(0 - 1) then "none" else "some", "none")
check("a failable value or a default is the default when it failed", [failing(0 - 1) or 0, failing(3) or 0], [0, 3])
parsed_sign(x: int): int?? := if x < 0 then error("negative") else if x == 0 then ø else x
check("a failable value, int??, holds an int, ø or an Error", [parsed_sign(0 - 1) is failed, parsed_sign(0) is ø, parsed_sign(0) is failed, parsed_sign(3) is failed], [yes, yes, no, no])
check("a failable value or a default is its int when it holds one", [parsed_sign(3) or 0, parsed_sign(0) or 0, parsed_sign(0 - 1) or 0], [3, 0, 0])
# a text's place is checked as a list's is (wiki/Footguns.md: `"ab"#3` is an index out of range)
check("a text's place past its end raises, and try catches it", try "ab"#3 else "none", "none")
# a place is proved only where nothing changes the list in place, an alias's write too (wiki/type.md "Proved or checked")
popped_sum(xs: list<int>): int := { ys = xs; s = 0; for i in 1 to #xs { ys.pop(); s = s + xs#i }; s }
check("a place in a loop whose list an alias shrinks is still checked, and try catches it", try popped_sum([1, 2, 3]) else 0, 0)
held: any = [1, 2]
check("a place in a list an any holds is checked too, and try catches it", try held#5 else 0, 0)
