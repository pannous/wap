# the forms wiki/Error.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

held = {a: 1}
check("default gives a fallback for a missing key", held["b"] default 0, 0)
check("default keeps a falsy value", 0 default 10, 0)
check("otherwise, failing, except and rescue are default", [(1/0) otherwise 2, (1/0) failing 3, (1/0) except 4, (1/0) rescue 5], [2, 3, 4, 5])
check("try X except Y is the same fallback", try 1/0 except 6, 6)
missing = ø
check("?? replaces only nothing", missing ?? 5, 5)
