# the forms wiki/Error.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

held = {a: 1}
check("default gives a fallback for a missing key", held["b"] default 0, 0)
check("default keeps a falsy value", 0 default 10, 0)
check("otherwise, failing, except and rescue are default", [(1/0) otherwise 2, (1/0) failing 3, (1/0) except 4, (1/0) rescue 5], [2, 3, 4, 5])
check("try X except Y is the same fallback", try 1/0 except 6, 6)
divided(x) := 10/x
guarded(x) := try divided(x) else 0
check("effects of a function that can fail name Fail, try removes it", [text(effects of divided), text(effects of guarded)], ["Fail", "Allocation"])
x = 0
check("assert … else raises the text after else", try { assert x > 0 else "x must be positive" } catch e { e.message }, "x must be positive")
n = 0
r = try 10/2 finally n = 7
check("finally runs whatever happens, the try's value stays the result", r + n, 12)
m = 0
tripped = try 1 ÷ 0 finally m = 7
check("finally runs when the try raises, the Error its value", [text(tripped failed), text(m)], ["yes", "7"])
quotient = try 10 ÷ 0
check("a bare try keeps the raised Error as its value, failed tests it", if quotient failed then quotient.message else "2", "divide by zero")
check("an integer divided by zero raises, as any error", try { 10 ÷ 0 } catch e { e.message }, "divide by zero")
