# the examples of wiki/evaluation.md: running blocks, unwrapping, calling a function value
use "check.wap"

kept := {3}
check("x() runs a block once", kept(), 3)
held: int? = 4
check("x! runs nothing, it unwraps an optional", held!, 4)
check("a glued group calls a function value", (x => x * 2)(7), 14)
