# Named events, lib/events.wap (wiki/signal.md, wiki/keyword.md emit and listeners): listeners run in order with the
# event's data, a once listener only the first time, a removed one never
use "../lib/events.wap"
use "check.wap"

said: list<text> = []
listen("alarm", (data: any) => { global said = said + ["first ${data}"]; 1 }, no)
second = listen("alarm", (data: any) => { global said = said + ["second ${data}"]; 2 }, no)
listen("alarm", (data: any) => { global said = said + ["once ${data}"]; 3 }, yes)
check("the last listener's value is the emit's", emitted("alarm", "a"), 3)
check("every listener ran, in order", said, ["first a", "second a", "once a"])
check("a once listener is gone after its run", listeners_of("alarm"), [1, 2])
unlisten(second)
said = []
emitted("alarm", "b")
check("a removed listener runs no more", said, ["first b"])
check("an event nobody listens to gives ø", emitted("nobody", "x") == ø, yes)
listeners_cleared("alarm")
check("cleared, an event has no listeners", listeners_of("alarm"), [])
