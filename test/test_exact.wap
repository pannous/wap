# exact numbers, lib/exact.wap (wiki/number.md: Decimals and fractions, Whole numbers, rounding and division)
use exact
use "check.wap"

check("decimals are exact", exact("0.1") + exact("0.2") == exact("0.3"), yes)
check("a third and a third", text(exact(1, 3) + exact(1, 3)), "2/3")
check("a repeating decimal written back", decimal(exact(1, 3)), "0.3̅")
check("a repeating decimal read", exact("0.3̅") * 3 == 1, yes)
check("lowest terms", "${numerator(exact(6, 8))} ${denominator(exact(-1, 3))}", "3 3")
check("a whole number past 64 bits", text(exact(2) ^ 62 * 4), "18446744073709551616")
check("big products and quotients", text(exact(10) ^ 30 / exact(10) ^ 28 - 99), "1")
check("rounding: halves away from zero, floor, ceil, truncation", "${round(exact(5, 2))} ${round(exact(-5, 2))} ${floor(exact(-27, 10))} ${ceil(exact(27, 10))} ${int(exact(-27, 10))}", "3 -3 -3 3 -2")
check("floored quotient and remainder", "${exact(-7) ÷ exact(2)} ${exact(-7) % exact(2)}", "-4 1")
check("decimals that end, and periods after plain digits", "${decimal(exact(1, 8))} ${decimal(exact(-1, 6))} ${decimal(exact(5))}", "0.125 -0.16̅ 5")
check("a negative power is the reciprocal's", text(exact(2, 3) ^ -2), "9/4")
check("as a float", float(exact(1, 4)), 0.25)
check("divide by zero is raised", try text(exact(1) / exact(0)) catch e { e.message }, "division by zero")
