# the examples of wiki/falsey.md: what a condition takes as no
use "check.wap"

check("0, no, an empty list and an empty text are taken as no", [if 0 then 1 else 2, if no then 1 else 2, if [] then 1 else 2, if "" then 1 else 2], [2, 2, 2, 2])
missing: int? = ø
check("a missing optional is taken as no", if missing then 1 else 2, 2)
check("values with something in them are taken as yes", [if 1 then 1 else 2, if "a" then 1 else 2, if [0] then 1 else 2], [1, 1, 1])
check("an empty map is taken as no", if {} then 1 else 2, 2)
keyed = {a: 1}
check("a map with keys is taken as yes", if keyed then 1 else 2, 1)
check("an empty map is empty", {} is empty, yes)
