# the outcome lines of decision fast-flow-contagion (warp notes/decisions.md 11-27, notes/fast_types_contagious.md) and
# wiki/number.md "Whole numbers, rounding and division": a value of a fast type (i64: a parameter, a field, a declared
# result) stays fast wherever it goes, so it wraps at 2^63; a plain int stays exact; fast mixed with plain never becomes
# fast silently; a law over i64 speaks of wrapping. Red until T8c is built.
use math
use "check.wap"

class Box { n: i64 }
global stride = (4611686018427387904 as i64)
big_word(): i64 := 4611686018427387904
square_word(x: i64): i64 := x * x
square_exact(x: int): int := x * x
law square_word(x) >= 0
law square_exact(x) >= 0

# a fast value stays fast through an untyped local, a field, a declared result, a global and a loop
through_local(n: i64) := { x = n; x * 4 }
check("an i64 parameter copied to an untyped local wraps at 2^63: through_local(2^62)", "${through_local(4611686018427387904)}", "0")
through_field(b: Box) := { x = b.n; x * 4 }
check("an i64 field copied to an untyped local wraps at 2^63: through_field(Box(2^62))", "${through_field(Box(4611686018427387904))}", "0")
check("a declared i64 result copied to an untyped local wraps at 2^63: big_word() * 4", "${big_word() * 4}", "0")
through_global() := { x = stride; x * 4 }
check("an i64 global copied to an untyped local wraps at 2^63: through_global()", "${through_global()}", "0")
through_loop(n: i64) := { total = n; for i in 1 to 1 { total = total * 2 }; total }
check("an i64 value doubled in a loop wraps at 2^63: through_loop(2^62)", "${through_loop(4611686018427387904)}", "-9223372036854775808")

# a plain int stays exact, through the same moves
plain = 4611686018427387904
check("a plain int stays exact: 2^62 * 4", "${plain * 4}", "18446744073709551616")
exact_loop() := { total = plain; for i in 1 to 1 { total = total * 2 }; total }
check("a plain int doubled in a loop stays exact: 2^62 * 2", "${exact_loop()}", "9223372036854775808")

# i64 with a plain int never silently wraps: warp's 24! (a fast loop counter times an exact accumulator)
mixed(a: i64, b: int) := a * b
check("an i64 times a plain int is exact: mixed(2^62, 4)", "${mixed(4611686018427387904, 4)}", "18446744073709551616")
check("24! is exact: factorial(24)", "${factorial(24)}", "620448401733239439360000")

# a law over i64 speaks of wrapping (wiki/Footguns.md "Integer overflow"): its square wraps negative at 3037000500
check("a law over i64 is violated where the square wraps: square_word(3037000500)", try square_word(3037000500) else "violated", "violated")
check("a law over int holds where the square would wrap: square_exact(3037000500)", "${square_exact(3037000500)}", "9223372037000250000")
