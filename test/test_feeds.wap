# the standard module feeds (wiki/world.md): a feed gives its events one at a time, ø once it ends; take(n) the next n
use "check.wap"
use feeds

class Counter { at: int = 0 }
counter = Counter()
# three batches of two events, then the end
batch(): list<any>? := {
	counter.at += 1
	if counter.at > 3 { return ø }
	found: list<any> = [counter.at, counter.at * 10]
	found
}
small = Feed(refill: batch, keeps: event => event < 20)
check("take gives the next events the feed keeps", text(small.take(3)), "[1, 10, 2]")
check("next gives the next event", small.next(), 3)
check("next gives ø once the feed ended", small.next() is ø, yes)
