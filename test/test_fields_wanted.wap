# the forms wiki/field.md and wiki/optional.md show that wap does not build yet: each red line is a to-do
use "check.wap"

class aged { age as int }
check("as gives a field its type", aged{age: 3}.age, 3)
class car { name: text; year: int? }
check("an optional field may be left out", car{name: "a"}.year is ø, yes)
class Email { at: text }
class Order { id: int, email }
check("a field named like a type is of that type", Order(1, Email("a@b")).email.at, "a@b")
class Card { id: int, email optional }
check("optional marks a field as ? does: it may be left out", Card(2).id, 2)
