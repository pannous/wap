# Files: temporary ones, appending, lines, globs and removing, lib/file.wap (wiki/library-reference.md "Temporary
# files", wiki/standard-library.md "file")
use file
use path
use "check.wap"

p = temp_folder() + "/warp_wiki_example.txt"
one_letter: text = "x"
write(p, one_letter)
check("a file written, deleted once, then gone", [exists(p), delete_file(p), exists(p), delete_file(p)], [yes, yes, no, no])
check("the temporary folder is there, without a trailing /", [exists(temp_folder()), temp_folder().ends_with("/")], [yes, no])
folder = temp_dir()
f = path_join(folder, "a.txt")
append_file(f, "one\n")
append_file(f, "two")
check("appended lines", file_lines(f), ["one", "two"])
write(path_join(folder, "b.md"), "")
check("a glob matches the last part", glob(folder + "/*.txt").map(x => basename(x)), ["a.txt"])
delete(f)
check("a folder is a folder and a plain file is none", [is_folder(folder), is_folder(path_join(folder, "b.md")), is_folder(path_join(folder, "none"))], [yes, no, no])
check("a deleted file is gone", exists(f), no)
check("a fresh temporary file is empty", read(temp_file()), "")
# the working folder is the one the run is in now (wiki/script.md `cwd`): after a change of folder the new one, which
# a relative path starts from
use os
cd("/")
check("after a change of folder the working folder is the new one", cwd(), "/")
check("a relative path starts from the working folder of now", absolute_path("notes.txt"), "/notes.txt")
