# the forms wiki/Footguns.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

check("an exact whole number can be a float, so it is one", [.0 is float, 3 is float], [yes, yes])
check("an int can be an i32 where it fits", 3 is i32, yes)
check("a fraction is no int, and an int past 32 bits no i32", [2.5 is int, 3_000_000_000 is i32], [no, no])
check("an int past 2^53 is no float: no float holds it exactly", 9_007_199_254_740_993 is float, no)
check("the type of .0 stays exact", text(type(.0)), "nat")
