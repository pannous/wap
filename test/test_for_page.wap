# the examples of wiki/for.md, each as the page writes it
use "check.wap"
bound = 3
rounds = 0
for i in 0..bound { bound = 10; rounds += 1 }
check("the end of a range is read once, before the first round", rounds, 3)
excluded = 0
for 1..4 : excluded += it
check("for over a range without a name gives each number as it, .. excluding the end", excluded, 6)
included = 0
for 1...4 : included += it
check("... includes the end", included, 10)
upto = 0
for 1 upto 4 : upto += it
check("upto excludes the end", upto, 6)
# a list a function's loop adds to with +=
gathered(xs: list<int>): list<int> := { found: list<int> = []; for x in xs { found += [x * 2] }; found }
check("a function's loop adds to its list with +=", gathered([1, 2]), [2, 4])

total = 0
for [1, 2, 3] { total += it }
check("a for loop without a name gives it", total, 6)
