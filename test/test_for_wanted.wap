# the forms wiki/for.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

excluded = 0
for 1..4 : excluded += it
check("for over a range without a name gives each number as it, .. excluding the end", excluded, 6)
included = 0
for 1...4 : included += it
check("... includes the end", included, 10)
upto = 0
for 1 upto 4 : upto += it
check("upto excludes the end", upto, 6)
named = 0
for x in [1, 2] { named += it }
check("in for x in xs the variable is also it", named, 3)
spelled = ""
for c in "hey": spelled += c
check("for walks a text's characters, a colon before the body", spelled, "hey")
rubyish = 0
for x in 0..3; rubyish += x; end
check("Ruby's for … end works too", rubyish, 3)
