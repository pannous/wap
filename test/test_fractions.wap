# exact fractions, lib/fractions.wap (wiki/library-fractions.md)
use fractions
use "check.wap"

check("a mixed number parsed, a fraction added", mixed_text(parse_fraction("1 1/2") + fraction(1, 4)), "1 3/4")
check("an improper fraction as a mixed number", mixed_text(parse_fraction("7/4")), "1 3/4")
check("a decimal exactly", text(from_decimal("0.125")), "1/8")
check("the closest fraction with a small denominator", mixed_text(limit_denominator(3.14159265, 100)), "3 14/99")
check("continued fraction terms", continued_fraction(parse_fraction("415/93")), [4, 2, 6, 7])
check("and back", text(from_continued_fraction([4, 2, 6, 7])), "415/93")
check("a float's binary value exactly", text(from_float(0.1)), "3602879701896397/36028797018963968")
check("lowest terms, the sign on the numerator, ints on either side", [text(fraction(6, -8)), text(2 - fraction(1, 3)), text(fraction(3, 4) * 4), text(1 / fraction(2, 3))], ["-3/4", "5/3", "3", "3/2"])
check("comparisons", [fraction(1, 3) < fraction(1, 2), fraction(2, 4) == fraction(1, 2), fraction(3, 2) >= fraction(1, 1)], [yes, yes, yes])
check("negative mixed numbers, powers, decimals with exponents", [mixed_text(parse_fraction("-2 1/3")), text(fraction_pow(fraction(2, 3), -2)), text(from_decimal("-1.5e-3"))], ["-2 1/3", "9/4", "-3/2000"])
check("a zero denominator is refused", try text(fraction(1, 0)) else "refused", "refused")
