#!/usr/bin/env wap
# wap's emitter: functions, locals and globals (wap/kernel/forms.wap: Define, Set, Call, a name's value). A function's
# value is its body's, a value given to a name is that value again, as warp has it. Part one: calls, function values,
# parameters (part two: test_functions_returns.wap)
use "check.wap"

check("a value given to a global is the program's value", (assigned = 3), 3)
x = 3
check("a global read back", x, 3)
same(n: int) := n
check("a function gives back its parameter", same(5), 5)
four() := { y = 4
y }
check("a function's local", four(), 4)
seen_x = 6
seen() := seen_x
check("a function sees a global set before its call", seen(), 6)
grouped = (7)
check("round brackets group one value", grouped, 7)
check("round brackets around statements run them in order", (ordered = 4; ordered), 4)
twice(f, x) := f(f(x))
check("a function value passed and called twice", twice(x => x + 1, 3), 5)
added(n: int) := {
	g = x => x + n
	g(5)
}
check("a function value reads its function's parameter", added(2), 7)
outer(a: int) := {
	b = 10
	make = x => (y => x + y + a + b)
	inner = make(100)
	inner(1000)
}
check("a function value made by a function value keeps what both read", outer(1), 1111)
id = x => x
check("one function value called with an int and a text", "${id("ab")} ${id(3)}", "ab 3")
sum = (a, b) => a + b
check("a function value of two parameters", sum(3, 4), 7)
limit = 3
check("the list words take function values: [1, 2].all(x => x < limit)", [1, 2].all(x => x < limit), yes)
check("the list words take function values: [1, 5].any(x => x > limit)", [1, 5].any(x => x > limit), yes)
check("the list words take function values: [\"a\", \"b\"].contains(\"c\")", ["a", "b"].contains("c"), no)
check("the list words take function values: [4, 5].contains(5)", [4, 5].contains(5), yes)
early = later(2)
later(x: int) := x * 2
check("a call before its function's definition line", early, 4)
inc(x: int) := x + 1
apply(f, x) := f(x)
named_inc = inc
check("a function's name passed as a value: apply(inc, 2)", apply(inc, 2), 3)
check("a function's name passed as a value: named_inc(named_inc(5))", named_inc(named_inc(5)), 7)
is_small(x) := x < 3
check("the list words take a function's name: [1, 2].all(is_small)", [1, 2].all(is_small), yes)
check("the list words take a function's name: [4, 5].any(is_small)", [4, 5].any(is_small), no)
adder(n: int) := x => x + n
check("a call of the value another call gives: adder(2)(40)", adder(2)(40), 42)
check("a call of the value another call gives: (x => x * 3)(5)", (x => x * 3)(5), 15)
apply_typed(f: (int) -> int, x: int) := f(x)
twice_typed(f: (T) -> T, x: T): T := f(f(x))
check("a parameter of a function type takes a function value, its letters bound by typing the value's function", "${apply_typed(y => y + 1, 4)} ${twice_typed(y => y * 3, 2)} ${twice_typed(t => t + "!", "ab")}", "5 18 ab!!")
# a definition without parameters is a constant: its name where no function is wanted is its value
n := 5
doubled(x: int) := x * 2
check("a constant's name is its value: n + 1", n + 1, 6)
check("a constant's name is its value: doubled(n)", doubled(n), 10)
arrowed = (a, b) -> a + b
check("-> writes a function value as => does (wiki: both arrows denote lambdas)", arrowed(1, 2), 3)
# code that never finishes, a return, fits any parameter
pick(a: int, b: int) as int := a
picked_or_returned(a: int) as int := pick(a, return 7)
check("a return given as an argument", picked_or_returned(1), 7)
recursive(n: int): int := if n < 1 then 0 else n + recursive(n - 1)
check("a function calls itself", recursive(3), 6)
# a parameter's default, which a call that leaves it out gives it (a class's field default the same, its constructor's)
defaulted(x: int, y: int = 2) := x + y
class P { x: int; tag: text = "?" }
check("a parameter's default", "${defaulted(1) + defaulted(1, 5)} ${P(3).tag + P(3, "a").tag}", "9 ?a")
# a function of a bare list parameter is typed when called, for the list given, so one nothing calls is not refused
front(xs: list) := xs#1
check("an uncalled function of a bare list", "ok", "ok")
# an argument given by its parameter's name, in any order, the parameters between left to their defaults
minus(a: int, b: int) := a - b
summed(a: int, b: int = 10, c: int = 100) := a + b + c
class Op3 { spelling: text; kind: text = "" }
pick_by(ys: list<text>, by: (text) -> int) := by(ys#1)
check("named arguments", "${minus(b: 1, a: 5)} ${summed(1, c: 2)} ${Op3(".", kind: "access").kind} ${["ccc", "a"].pick_by(by: t => #t)}", "4 13 access 3")
k = 5
default_named(g: int = k) := g
check("a parameter's default names a value of the program", default_named(), 5)
enum Grouping { Left, Right }
class Group { name: text, grouping: Grouping = Grouping.Left }
group = Group("a")
check("a field's default is a case of an enum", group.grouping == Grouping.Left, yes)
which_keys(m: map<K, V>) as text := "any keys"
which_keys(m: map<text, V>) as text := "text keys"
keys_named(key: K, of: map<K, V>) as text := which_keys(of)
text_keyed: map<text, int> = {}
int_keyed: map<int, int> = {}
text_key: text = "a"
# DONE (card split-list-checks, abdebd6) split ALL tests that test multiple things in one list into smaller individual tests 
check("a generic function's instance chooses the overload its types make most specific: map<text, V> over map<K, V>: keys_named(text_key, text_keyed)", keys_named(text_key, text_keyed), "text keys")
check("a generic function's instance chooses the overload its types make most specific: map<text, V> over map<K, V>: keys_named(1, int_keyed)", keys_named(1, int_keyed), "any keys")
# a function giving a value of its own type where a function type giving any is wanted: its result is boxed as any
run_any(f: (any) -> any, x: any) as any := f(x)
inc_one(a: int) as int := a + 1
apply_any(f: (int) -> any, x: int) as any := f(x)
# DONE (card split-list-checks, abdebd6) split ALL tests that test multiple things in one list into smaller individual tests 
check("a function giving an int or a text fits a function giving any: text(run_any(x => 1, 3))", text(run_any(x => 1, 3)), "1")
check("a function giving an int or a text fits a function giving any: text(run_any(x => \"a \${x}\", 3))", text(run_any(x => "a ${x}", 3)), "a 3")
check("a function giving an int or a text fits a function giving any: text(apply_any(inc_one, 3))", text(apply_any(inc_one, 3)), "4")
# a named function given to a place of a function type, a map's entry or a variable, is a value of that type
shout(s: text) as text := s + "!"
shouts: map<text, (text) -> text> = {}
shouts["a"] = shout
shout_held: (text) -> text = shout
check("a named function given to a map entry or a variable of a function type: shouts[\"a\"](\"x\")", shouts["a"]("x"), "x!")
check("a named function given to a map entry or a variable of a function type: shout_held(\"y\")", shout_held("y"), "y!")
# a class's field of a function type holds any function value, what a lambda reads going along; `h.act(2)` calls it
class Acting { act: (int) -> int }
step = 10
check("a lambda held in a class's field, called through the field: Acting(x => x + 1).act(2)", Acting(x => x + 1).act(2), 3)
check("a lambda held in a class's field, called through the field: Acting(x => x + step).act(2)", Acting(x => x + step).act(2), 12)
# a function value giving a plain value, passed on where a function giving any is wanted, gives its value boxed
class Listening { act: (any) -> any }
listening(act: (any) -> any) as Listening := Listening(act)
check("a lambda giving an int, passed on into a field of a function giving any", text(listening((data: any) => { 1 }).act(5)), "1")
# a function value read from a map, passed on and called twice through a parameter of its signature
twice_typed(f: (int) -> int, x: int) as int := f(f(x))
steps: map<text, (int) -> int> = {}
steps["one"] = inc_one
steps["ten"] = x => x + step
check("a function value read from a map, called twice through a parameter: twice_typed(steps[\"one\"], 3)", twice_typed(steps["one"], 3), 5)
check("a function value read from a map, called twice through a parameter: twice_typed(steps[\"ten\"], 3)", twice_typed(steps["ten"], 3), 23)

# wiki/function.md "Calling and passing functions" (card signature-function-values): function values that meet are one
# value of their signature, settled by the call through them or a written function type
growing = [x => x + 1, x => x * 2]
check("a list of function values, each called through the list: growing[0](3)", growing[0](3), 4)
check("a list of function values, each called through the list: growing[1](3)", growing[1](3), 6)
check("a function value chosen by if", (if growing then (x => x) else (x => x + 1))(2), 2)
scale = 10
scaled = [x => x + scale, x => x * scale]
check("function values capturing a variable, called through their list", scaled[1](3), 30)
doubling: (int) -> int = growing[1]
check("a value of the list given to a written function type", doubling(10), 20)
quoted(x: int) := "<${x}>"
quoted(x: text) := "«${x}»"
quote_number: (int) -> text = quoted
quote_text: (text) -> text = quoted
check("an overloaded name as a value takes the definition its function type wants", quote_number(1) + quote_text("a"), "<1>«a»")
is_long(value: any) as bool := text(value).size > 1
check("a function taking any is a value where a narrower parameter is wanted", ["ab", "cd"].all(is_long), yes)
widened_twice(x: float) as float := x * 2
check("a function value's parameter takes the wanted one widened", [1, 2].map(widened_twice), [2.0, 4.0])
changing = x => x + 1
changing = x => x * 2
check("a variable given a second function value", changing(5), 10)
stepped = 0
for doing in growing { stepped += doing(7) }
check("function values called through a loop over their list", stepped, 22)

no_comma(a,b):=a+b
check("Function arguments don't need commas",no_comma 1 2, 3)
no_comma2(a:int,b:int):=a+b
check("Function arguments spread if no list overload defined",no_comma (1, 2), 3)
# check("Function arguments spread if no list type defined",no_comma (1 2), 3)
held_text(v: any): text := "${v}"
check("a method read without parentheses takes its receiver as a call does", [[1, 2].held_text, 3.held_text], ["[1, 2]", "3"])
handlers: list<(int, int) -> int> = []
handlers.add((a, b) => a * 10)
check("a lambda added to a list of functions takes the list's function type", handlers.map(h => h(5, 3)), [50])
doubled_int(x: int) as int := x * 2
added_one(x: int) as int := x + 1
twice_then(f: (A) -> B, g: (B) -> C): (A) -> C := x => g(f(x))
check("letters only function values bind are bound by their signatures", twice_then(doubled_int, added_one)(4), 9)
global counted = 0
count_once() := {
	if counted > 0 { return }
	counted = counted + 1
}
count_once(); count_once()
check("a function whose bare return stands beside an assignment at its end runs", counted, 1)
same_as(a: T, b: T) as bool := a == b
slash() as text := "/"
check("one-character literals read as texts beside the texts a letter is bound to", [same_as([slash(), slash()], ["/", "/"]), same_as(["/", "/"], [slash(), slash()])], [yes, yes])
