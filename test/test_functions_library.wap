# Functions over functions, lib/functions.wap (wiki/library-functions.md): memoize, retry, throttle, debounce
use functions
use "check.wap"

global calls = 0
slow(n) := {
	global calls
	calls += 1
	n * n
}
fast = memoize(slow)
check("a memoized function runs once per argument", "${[fast(4), fast(4), calls]}", "[16, 16, 1]")
global tries = 0
flaky() := {
	global tries
	tries += 1
	if tries < 3 { raise "busy" }
	"ok after " + text(tries)
}
check("retry until it succeeds", retry(flaky, 5, 1), "ok after 3")
down(): text := raise "down"
check("the last failure is raised again", try retry(down, 2, 1) else "gave up", "gave up")
global runs = 0
counted(x) := {
	global runs
	runs += 1
	x
}
limited = throttle(counted, 100000)
check("a throttled function runs once in its time", "${[limited(1), limited(2), runs]}", "[1, 1, 1]")
