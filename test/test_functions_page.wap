# the examples of wiki/function.md: how functions are defined, typed, overloaded, dispatched and called
use "check.wap"

def doubled_by_def(x) { x * 2 }
check("a function defined with def and a brace body", doubled_by_def 4, 8)
check("an argument reaches right while it fits the parameter", sqrt 4 + 5, 3.0)

twice_untyped(x) := x * 2
check("an untyped parameter fits a number", twice_untyped(3), 6)
repeated_untyped(x) := x * 2
check("an untyped parameter fits a text", repeated_untyped("ab"), "abab")

class Deck { cards:int }
sort(d:Deck) := "shuffled " + d.cards + " cards"
check("a function of a class is its method", sort(Deck(52)), "shuffled 52 cards")
check("a method called with a dot is the same call", Deck(3).sort(), "shuffled 3 cards")

class Hand { cards:int; take(k) := cards - k }
check("a method in the class body reads the fields", Hand(5).take(2) == take(Hand(5), 2), yes)

class Box { size:int; size() := 7 }
b = Box(3)
check("a method named like a field keeps both: b.size", b.size, 3)
check("a method named like a field keeps both: b.size()", b.size(), 7)
check("a method named like a field keeps both: size(b)", size(b), 7)

check("a function value called where it is written", (x => x * 2)(5), 10)
check("a library function passed to map", [1.7, 2.2].map(floor), [1.0, 2.0])

infix operator ⊕ := left + right
check("an infix operator declared", 1 ⊕ 2, 3)

check("minus binds weaker than a call", 1 + -floor(2.5), -1.0)

give(v, to) := v + to
check("a phrase is a call with named arguments", give 2 to: 40, 42)

three_as() as int := 3
three_colon(): int := 3
check("a result type written with as or a colon: three_as()", three_as(), 3)
check("a result type written with as or a colon: three_colon()", three_colon(), 3)

nullary_or_one() := 3
nullary_or_one(x) := x
check("a bare overloaded name calls its nullary variant", nullary_or_one + 1, 4)

takes(g: function) := 1
takes(g: (int, int) -> any) := 2
check("a function-type parameter is more specific than function", takes((a, b) => a + b), 2)

half(x) := x /! 2
half(x) as float := x / 2
y: float = half 7
check("a declared type picks the variant of that result", y, 3.5)

check("the standard words of lists and texts need no use: unique([1, 1, 2])", unique([1, 1, 2]), [1, 2])
check("the standard words of lists and texts need no use: take([1, 2, 3], 2)", take([1, 2, 3], 2), [1, 2])
twice_either(x) := x * 2
check("one untyped function called with two kinds gets a version for each", [text(twice_either(3)), twice_either("ab")], ["6", "abab"])

check("| and & of two whole numbers combine bits", [5 | 3, 5 & 3], [7, 1])
check("the exponent bits of a float", (float_bits(1.0) >> 52) & 2047, 1023)
square_piped(n: float) := n * n
check("a value piped through functions, with | or |>", [2.0 | square_piped | sqrt, 3.0 |> square_piped], [2.0, 9.0])
check("a text's words", words("ab  cd\tef"), ["ab", "cd", "ef"])
check("a number rounded to places, a half away from zero", [round_to(2.345, 2), round_to(-2.5, 0), round_to(2.0, 1)], [2.35, -3.0, 2.0])
check("a text backwards, by its characters", ["abc".reverse, "zoë".reverse], ["cba", "ëoz"])

check("an argument reaches right while it fits the parameter: sqrt 4 + 5 is sqrt(9)", sqrt 4 + 5, 3.0)
# the most specific method is decided at run time: a Dog in a list of Animals barks, as does a Puppy, a Dog too
class Creature { name: text }
class Hound extends Creature { }
class Pup extends Hound { }
voice(a: Creature) := a.name + " makes a sound"
voice(d: Hound) := d.name + " barks"
check("the most specific method is decided at run time", [Creature("Kitty"), Hound("Rex"), Pup("Bit")].map(pet => voice(pet)), ["Kitty makes a sound", "Rex barks", "Bit barks"])
check("a class's value is tested for its extension when the program runs", [Creature("Kitty"), Hound("Rex"), Pup("Bit")].map(pet => pet is Hound), [no, yes, yes])
kept_pet: Creature = Hound("Max")
check("a place typed by a class holds its extension, whose method answers", [voice(kept_pet), kept_pet.voice()], ["Max barks", "Max barks"])
