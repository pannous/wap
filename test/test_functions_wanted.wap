# the forms wiki/function.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

check("type(x) is a value's type", text(type(3)), "int")
add_two(a, b) := a + b
inc := add_two(1, _)
check("a _ leaves an argument open and makes a new function", inc 5, 6)
grown = [1 2]
grown.add 4
check("a method call needs no parentheses", grown, [1, 2, 4])
doubled(x: float) := x * 2
check("a declared scalar parameter broadcasts over a list", doubled([1.0, 2.0]), [2.0, 4.0])
quoted(x: int) := "int"
quoted(x: text) := "text"
check("a name with several definitions used as a value is its overload set", [1, 2].map(quoted), ["int", "int"])
total(xs: numbers) := sum(xs)
check("more arguments than parameters gather into the last, a list", total 1 2 3, 6)
square_assigned(n)=n*n
check("a definition written with = after a head", square_assigned(3), 9)
to square_to x := x*x
to add_to a b := a + b
check("after to a definition head needs no parentheses", [square_to 3, add_to 1 2], [9, 3])
square_piped(x: float) := x * x
check("| pipes a value through functions", 2.0 | square_piped | sqrt, 2.0)
check("| and & of two whole numbers combine bits", [5 | 3, 5 & 3], [7, 1])
To square_english a number: return it times it
check("an English To definition, as to defines", square_english 3, 9)

check("the parameter type groups: count xs > 3 is count(xs) > 3", count [1, 2, 3, 4] > 3, yes)
# wiki/function.md: the method is decided at run time, by the class a value has, a Dog in a list of Animals barking
class Pet { name: text }
class Hound extends Pet { }
voice(a: Pet) := a.name + " makes a sound"
voice(d: Hound) := d.name + " barks"
check("the most specific method is decided at run time", [Pet("Kitty"), Hound("Rex")].map(pet => voice(pet)), ["Kitty makes a sound", "Rex barks"])
