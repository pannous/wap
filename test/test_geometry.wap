# Geometry, lib/geometry.wap (wiki/library-geometry.md): polygons, point in polygon, convex hull, segment
# intersection, great-circle distance
use geometry
use math
use "check.wap"

RECTANGLE: list<list<float>> = [[0, 0], [4, 0], [4, 3], [0, 3]]
check("a 4 by 3 rectangle's area", polygon_area(RECTANGLE), 12.0)
check("a point inside the rectangle", point_in_polygon([2, 1], RECTANGLE), yes)
check("the hull leaves the inner points out", convex_hull([[0, 0], [2, 1], [4, 0], [2, 3], [1, 1]]), [[0.0, 0.0], [4.0, 0.0], [2.0, 3.0]])
check("Berlin to Munich in km", round_to(haversine_km([52.52, 13.405], [48.137, 11.575]), 1), 504.3)
check("the diagonals of a square cross in its middle", segment_intersection([0, 0], [4, 4], [0, 4], [4, 0]), [2.0, 2.0])
