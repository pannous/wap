# A global written by any function of its file (wiki/variable.md: "a variable declared `global x` is written by a plain
# `x = …` in any function, no `global` inside the function needed"; wiki/library-functions.md's example)
# (red: wap asks for `global calls` inside the function)
use functions
use "check.wap"

global calls = 0
slow(n) := { calls += 1; n * n }
fast = memoize(slow)
check("a function changes a global of its file", "${[fast(4), fast(4), calls]}", "[16, 16, 1]")
