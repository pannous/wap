# lib/draw.wap's canvas, as wiki/graphics.md shows it: canvas, clear, the shapes, show and save
use "check.wap"
use draw
use png
use color
use file

canvas(320, 200)
clear(paper)
circle(160, 100, 40, red)
check("use draw gives a canvas to paint on", canvas.width, 320)
check("a circle covers its center", canvas.pixels[100 * 320 + 160], red)
check("clear(paper) leaves the paper where nothing is drawn", canvas.pixels[0], paper)
rect(10, 10, 20, 5, blue)
check("a rect covers the pixels it spans", canvas.pixels[12 * 320 + 15], blue)
line(0, 199, 319, 199, green)
check("a line covers the pixels it runs through", canvas.pixels[199 * 320 + 100], green)
show()
save(canvas, "${temp_folder()}/wap-graphics-test.png")
check("save writes the canvas as a PNG", png_picture(read_bytes("${temp_folder()}/wap-graphics-test.png")).pixels[100 * 320 + 160], red)
