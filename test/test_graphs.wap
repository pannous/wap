# Graphs, lib/graphs.wap (wiki/library-graphs.md): cheapest paths, topological order, components, walks, spanning trees
use graphs
use "check.wap"

ROADS := [["home", "a", 4], ["home", "b", 1], ["b", "a", 2], ["a", "work", 1], ["b", "work", 5]]
roads = graph_of(ROADS, yes)
check("the cheapest path", show(dijkstra_path(roads, "home", "work")!), "[\"home\", 'b', 'a', \"work\"]")
check("a path's cost", path_cost(roads, dijkstra_path(roads, "home", "work")!), 4.0)
check("A* with a heuristic finds the same path", show(a_star(roads, "home", "work", node => 0.0)!), "[\"home\", 'b', 'a', \"work\"]")
check("no path is ø", dijkstra_path(roads, "work", "home") == ø, yes)
check("every step after what it needs", show(topological_sort(graph_of([["fetch", "build"], ["build", "test"], ["build", "docs"], ["test", "release"]], yes))), "[\"fetch\", \"build\", \"test\", \"docs\", \"release\"]")
check("a cycle has no topological order", try "${topological_sort(graph_of([["a", "b"], ["b", "a"]], yes))}" else "refused", "refused")
check("the components", show(connected_components(graph_of([[1, 2], [2, 3], [4, 5]], no))), "[[1, 2, 3], [4, 5]]")
tree = graph_of([["a", "b"], ["a", "c"], ["b", "d"]], no)
check("breadth first", show(bfs(tree, "a")), "['a', 'b', 'c', 'd']")
check("depth first", show(dfs(tree, "a")), "['a', 'b', 'd', 'c']")
check("the minimum spanning tree", show(minimum_spanning_tree(graph_of([["a", "b", 3], ["b", "c", 1], ["a", "c", 2]], no))), "[['b', 'c', 1], ['a', 'c', 2]]")
people = disjoint_set(5)
for pair in [[1, 2], [2, 3], [4, 5]] { people.unite(pair[0], pair[1]) }
check("disjoint sets joined by unite", [people.components(), people.size_of(1)], [2, 3])
check("unite says whether two sets became one", [people.unite(1, 3), people.connected(3, 4)], [no, no])
