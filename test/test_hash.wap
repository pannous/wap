# Hashes of texts and bytes, lib/hash.wap (wiki/standard-library.md "hash")
use hash
use "check.wap"

check("md5", md5("abc"), "900150983cd24fb0d6963f7d28e17f72")
check("sha1", sha1("abc"), "a9993e364706816aba3e25717850c26c9cd0d89d")
check("sha256", sha256("abc"), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
check("sha256 over several blocks", sha256("a" * 200), "c2a908d98f5df987ade41b5fce213067efbcc21ef2240212a41e54b5e7c28ae5")
check("sha512", sha512("abc"), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
check("sha224 and sha384, SHA-2 kept shorter from their own start", [sha224("abc"), sha384("abc")], ["23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7", "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7"])
check("a digest as its bytes", [sha256_bytes("abc").take(4), #sha512_bytes("abc")], [[186, 120, 22, 191], 64])
check("crc32", crc32("hello"), 907060870)
check("hmac, sha256 by default", hmac("key", "The quick brown fox jumps over the lazy dog"), "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8")
check("hmac with sha1", hmac("key", "message", algorithm: HashAlgorithm.sha1), "2088df74d5f2146b48146caf4965377e9d0be3a4")
check("hmac with a key longer than sha512's block", hmac("k" * 100, "m", algorithm: HashAlgorithm.sha512), "98673229a457fdd49a37fb6955d619f2d77389040d07d884eed48cce7053aa0d58a3ff6bf57b045226cdd28c58496b3f3aed8b46f9911d85e7d1ea90b04dbb1d")
