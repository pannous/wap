# hmac with an algorithm named by its case, lib/hash.wap (wiki/standard-library.md "hash"; interviewer OK 2026-11-23)
# red until a bare case in an enum place resolves (wap-binding)
use hash
use "check.wap"

check("hmac with sha1", hmac("key", "message", algorithm: sha1), "2088df74d5f2146b48146caf4965377e9d0be3a4")
check("hmac with a key longer than sha512's block", hmac("k" * 100, "m", algorithm: sha512), "98673229a457fdd49a37fb6955d619f2d77389040d07d884eed48cce7053aa0d58a3ff6bf57b045226cdd28c58496b3f3aed8b46f9911d85e7d1ea90b04dbb1d")
