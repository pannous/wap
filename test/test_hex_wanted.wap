# the forms wiki/hex.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

check("hex shows a number in lowercase hex", "${hex 255}", "0xff")
check("x as hex is the same", "${255 as hex}", "0xff")
check("a hex value equals its number", hex 255 == 255, yes)
check("arithmetic on a hex value gives a plain int", (hex 255) + 1, 256)
check("as binary shows a number in binary", "${5 as binary}", "0b101")
check("bin is binary", "${bin 5}", "0b101")
check("binary literals are written with 0b", 0b101, 5)
