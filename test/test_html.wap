# HTML text escaped and read back, lib/html.wap (wiki/library-dogfood-apps.md "comment_board")
use html
use "check.wap"

check("escaped, then the entities read once", html_escape(html_unescape("<b>Tom &amp; Jerry</b> &copy;")), "&lt;b&gt;Tom &amp; Jerry&lt;/b&gt; ©")
check("numeric references, decimal and hex", html_unescape("&#72;&#x69;&#33; &#128512;"), "Hi! 😀")
check("what names no character stays as written", html_unescape("a & b &nosuch; &#xZZ;"), "a & b &nosuch; &#xZZ;")
check("escape and unescape round-trip", html_unescape(html_escape("<script>alert('hi')</script>")), "<script>alert('hi')</script>")
