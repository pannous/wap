# hyperreal numbers, lib/hyperreal.wap (wiki/hyperreals.md)
use hyperreal
use reals
use "check.wap"

check("ε times ω is 1", ε * ω == 1, yes)
check("sums and powers of ε, the largest term first", "${(1 + ε) ^ 2} ${3 * ω - 1} ${ε ^ -1}", "1 + 2ε + ε² 3ω - 1 ω")
check("an exact real times ε", text(exact_pi * ε), "πε")
check("ε is above 0 and below every positive real", [ε > 0, ε < hyper(real(1) / 1000000)], [yes, yes])
check("ω is above every real", [ω > 1000000, ω - 1000 < ω, 1 + ε > 1], [yes, yes, yes])
check("comparing by the largest term", exact_pi * ε < 4 * ε, yes)
check("the plain number again when no ε is left", text(ε * ω + 1), "2")
check("dividing by a single term", text((ε + ε ^ 2) / ε), "1 + ε")
check("a negative leading term", text(0 - ω), "-ω")
