# translations with plural categories and transliteration, lib/i18n.wap (wiki/in.md: `print name in cyrillic`)
use i18n
use "check.wap"

check("a name in Cyrillic letters, a capital kept", "James" in cyrillic, "Джамес")
check("the longest spelling first", "Shchukin" in cyrillic, "Щукин")
messages: map<text, map<text, any>> = {en: {cart: {one: "{count} item", other: "{count} items"}, hello: "hi {name}"}, ru: {cart: {one: "{count} товар", few: "{count} товара", many: "{count} товаров"}}}
check("a plural category by the language's rule", translate(messages, "ru", "cart", {count: 3}), "3 товара")
check("a region reads its base language", translate(messages, "ru-RU", "cart", {count: 25}), "25 товаров")
check("a missing language reads the first one", translate(messages, "de", "cart", {count: 1}), "1 item")
check("holes filled by name", translate(messages, "en", "hello", {name: "Ada"}), "hi Ada")
check("a key no language has is an error", try translate(messages, "en", "nope", {count: 1}) else "missing", "missing")
