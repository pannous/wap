# lib/idna.wap's Punycode (RFC 3492) and domain names (UTS #46), against what Python's punycode and idna codecs give
use "check.wap"
use idna

check("Punycode of a text", punycode_encode("bücher"), "bcher-kva")
check("Punycode of a text of no ASCII at all", punycode_encode("ü"), "tda")
check("Punycode decoded", punycode_decode("bcher-kva"), "bücher")
check("a domain in ASCII, each label lowercased", domain_to_ascii("Bücher.example"), "xn--bcher-kva.example")
check("an ideographic full stop is a dot", domain_to_ascii("münchen。de"), "xn--mnchen-3ya.de")
check("a domain back in Unicode", domain_to_unicode("xn--bcher-kva.example"), "bücher.example")
