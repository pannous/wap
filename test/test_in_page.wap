# the examples of wiki/in.md: in asks whether a list or text holds a value
use "check.wap"
use i18n

check("in asks whether a list holds a value", 2 in [5 2], yes)
check("in asks whether a text holds a part", "ell" in "hello", yes)
check("xs.has(x) is the same test", [5 2].has(2), yes)
name = "James"
check("a text in a script gives its letters in that script", "${name in cyrillic}", "Джамес")
