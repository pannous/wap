# the examples of wiki/indexing.md: [] from 0, # from 1, slices and map keys
use "check.wap"

check("[] indexes from 0", (1 2 3)[1], 2)
check("# counts positions from 1", [1 2 3]#2, 2)
check("find gives a position in characters", "abc".find("b"), 2)
paged = [10 20 30 40]
check("xs[1:3] slices indexes 1 up to 3 as in Python", paged[1:3], [20, 30])
check("a map's key in brackets", {a:1, b:2}["a"], 1)
check("a map's key after a dot", {a:1, b:2}.a, 1)
