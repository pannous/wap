# the examples of wiki/indexing.md: [] from 0, # from 1, slices and map keys
use "check.wap"

check("[] indexes from 0", (1 2 3)[1], 2)
check("# counts positions from 1", [1 2 3]#2, 2)
check("find gives a position in characters", "abc".find("b"), 2)
paged = [10 20 30 40]
check("xs[1:3] slices indexes 1 up to 3 as in Python", paged[1:3], [20, 30])
check("a map's key in brackets", {a:1, b:2}["a"], 1)
check("a map's key after a dot", {a:1, b:2}.a, 1)
check("byte_index_of gives an offset in bytes from 0", "abc".byte_index_of("b"), 1)
# a class giving `[]` by key through its own #: the key reaches # as written, an index alone counts from 0
class Store { values: map<text, int> }
#(s: Store, key: text): int := s.values[key]
set(to: int, of: Store, key: text) := { of.values[key] = to }
store = Store({"a": 1})
store["b"] = 2
check("a key that is no index reaches the class's own #", [store["a"], store["b"], store.values["b"]], [1, 2, 2])

letters = "abc"
counted_letters = #letters
check("a spaced # counts", counted_letters, 3)
