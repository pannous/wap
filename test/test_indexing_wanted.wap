# the forms wiki/indexing.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

tens = [10 20 30]
check("a position meeting brackets is converted to an index", tens[tens.index_of(20)], 20)
check("arithmetic keeps a position a position", tens[tens.index_of(10) + 1], 20)
check("argmax gives an index", argmax(tens), 2)
counted = "abc"
declared: index = counted.find("b")
check("a declared index holds the value counted its way", declared, 1)
paged = [10 20 30 40]
check("a range of positions takes a slice", paged#(2 to 3), [20, 30])
check("… is a range too", paged#(2…3), [20, 30])
