# wap's texts with holes (wiki/string.md "templates interpolation"): `"a ${x} b"` and `"a \(x) b"` show x's text in
# place, a hole is any code, texts inside it too; a hole's value is shown by text(x)
use "check.wap"

n = 3
check("a hole shows a variable's value", "n is ${n}", "n is 3")
c = yes
check("a hole of code with texts inside: \"<\${if c then \"a\" else \"\"}>\"", "<${if c then "a" else ""}>", "<a>")
check("a hole of code with texts inside: \"<\${if no then \"a\" else \"\"}>\"", "<${if no then "a" else ""}>", "<>")
a = 1
b = 2
check("holes written the Swift way, several in a text", "\(a) and \(b) make \(a + b)", "1 and 2 make 3")
check("the texts of ints, characters, yes and no", "${-120} ${0} ${'é'} ${yes} ${no}", "-120 0 é yes no")
check("a dollar without braces and an escaped hole stay text", "costs \$5, \${x} and $y", 'costs $5, ${x} and $y')
