# Intervals, lib/intervals.wap (wiki/library-intervals.md): extents [lo, hi) and [lo, hi], overlap, merging, free
# slots, stabbing queries, total length
use intervals
use "check.wap"

check("half-open extents that touch share no point", extents_overlap(extent(1, 3), extent(3, 5)), no)
check("overlapping extents merged, sorted", merge_intervals([extent(5, 7), extent(1, 3), extent(2, 4)]).map(e => e.text()), ["[1, 4)", "[5, 7)"])
check("the free slots between busy extents", subtract_intervals(extent(0, 10), [extent(2, 3), extent(8, 12)]).map(e => e.text()), ["[0, 2)", "[3, 8)"])
check("every stored extent holding a point", interval_set([extent(0, 10), extent(5, 20)]).stabbing(7).map(e => e.text()), ["[0, 10)", "[5, 20)"])
check("the length the extents cover", total_length([extent(1, 3), extent(2, 6)]), 5.0)
