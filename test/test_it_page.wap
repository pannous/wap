# the examples of wiki/it.md: it, and _ as a plain name
use "check.wap"

_ = 5
check("_ is a plain name", _, 5)

# it belongs to the innermost block: a condition's it is the condition's own, so the definition stays a value
xs = [1, 2, 3]
bigger := xs where it > 1
filtered := xs.filter(it > 1)
check("a definition whose condition names it is a value", bigger, [2, 3])
check("a definition whose filter's argument names it is a value", filtered, [2, 3])
