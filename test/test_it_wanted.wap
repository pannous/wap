# the forms wiki/it.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

3 + 4
check("it is the last result at the top level", it + 1, 8)
check("it belongs to the innermost block", [[1,2],[3]].map { it.map { it*10 } }, [[10, 20], [30]])
positional = { $0 + $1 }
check("$0 and $1 are a block's positional parameters", positional(2, 3), 5)

3 + 4
last_doubled = it * 2
check("it is the last statement's value", last_doubled, 14)
