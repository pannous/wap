# the forms wiki/iteration.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

walked = []
each [1,2,3]: walked.add(it)
all [1,2,3]: walked.add(it)
check("each and all walk a list as for does", walked, [1, 2, 3, 1, 2, 3])
nums = [1,2,3,4]
check("that filters a list in English", nums that are even, [2, 4])
numbers = [1 2 3 4]
above = []
all numbers > 2: above.add(it)
check("all walks the items a comparison keeps", above, [3, 4])
square_value(number: float) := number*number
check("a function of a number given a map maps its values", square_value({a: 1.0, b: 2.0}), {a: 1.0, b: 4.0})
