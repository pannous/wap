# JSON read and written, lib/json.wap (wiki/json.md, wiki/standard-library.md "json", wiki/use.md)
use json
use "check.wap"

check("an object written", to_json({a: 1, b: [yes, ø, "xy"], c: 1.5}), "{\"a\":1,\"b\":[true,null,\"xy\"],\"c\":1.5}")
check("a list written", to_json([1, 2]), "[1,2]")
check("JSON read", to_json(parse_json("{\"a\": [1, 2.5, true, null, \"h\\u00e9\"]}")), "{\"a\":[1,2.5,true,null,\"hé\"]}")
check("JSON5 read", to_json(parse_json("{a: 'x y', // a comment\n /* another */ n: +1, m: .5, t: [1, 2,],}")), "{\"a\":\"x y\",\"n\":1,\"m\":0.5,\"t\":[1,2]}")
check("parse after use json", to_json(parse "[1, 2]"), "[1,2]")
check("a text of one character written", to_json(["a"]), "[\"a\"]")
check("∞ has no JSON form", try to_json(1.0 / 0.0) else "error", "error")
check("x.json writes x", [1, 2].json, "[1,2]")
