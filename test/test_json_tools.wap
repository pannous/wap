# JSON tools, lib/json_tools.wap (wiki/library-json-tools.md): JSON Pointer, JSON Patch, JSON Merge Patch and a JSON
# Schema validator over wap values, the inputs never changed
use json_tools
use "check.wap"

check("a pointer read", json_pointer_get({users: [{name: "Ada"}, {name: "Alan"}]}, "/users/1/name"), "Alan")
check("a patch", show(json_patch({name: "Ada", tags: ["math"]}, [{op: "add", path: "/tags/-", value: "code"}, {op: "replace", path: "/name", value: "Ada L."}])), "{name: \"Ada L.\", tags: [\"math\", \"code\"]}")
check("a merge patch", show(json_merge_patch({theme: "light", font: {size: 12}}, {font: {size: 14}, theme: ø})), "{font: {size: 14}}")
check("a schema's errors", json_validate({name: "Ada", age: "old"}, {type: "object", required: ["name", "email"], properties: {age: {type: "integer"}}}), ["(root): missing required property email", "/age: expected integer, got string"])
check("pointer escapes and the fragment form", show([json_pointer_get({"a/b": 1, "m~n": 2}, "/a~1b"), json_pointer_get({"a/b": 1, "m~n": 2}, "/m~0n"), json_pointer_get({"a b": 3}, "#/a%20b")]), "[1, 2, 3]")
check("a missing member is refused", try json_pointer_get({a: 1}, "/b") else "refused", "refused")
doc = {a: [1, 2, 3], b: {c: "xy"}}
check("remove, move, copy, test", show(json_patch(doc, [{op: "remove", path: "/a/0"}, {op: "move", from: "/b/c", path: "/d"}, {op: "copy", from: "/a", path: "/e"}, {op: "test", path: "/d", value: "xy"}])), "{a: [2, 3], b: {}, d: \"xy\", e: [2, 3]}")
check("the patched input is unchanged", show(doc), "{a: [1, 2, 3], b: {c: \"xy\"}}")
check("a failing test operation fails the patch", try show(json_patch(doc, [{op: "test", path: "/b/c", value: "y"}])) else "refused", "refused")
check("numbers, texts, arrays and combinators", json_validate([5, "ab", [1, 1], 7], {prefixItems: [{minimum: 6}, {pattern: "^a", maxLength: 1}, {uniqueItems: yes}], items: {anyOf: [{type: "string"}, {multipleOf: 2}]}}), ["/0: 5 is less than the minimum 6", "/1: longer than 1 characters", "/2: items 0 and 1 are equal", "/3: matches none of anyOf"])
check("$ref, oneOf, additionalProperties", json_validate({n: 3, extra: 1}, {"$defs": {small: {maximum: 2}}, properties: {n: {"$ref": "#/$defs/small"}}, additionalProperties: no}), ["/n: 3 is more than the maximum 2", "/extra: additional property extra is not allowed"])
check("a valid document has no errors", json_validate({name: "Ada", age: 36}, {type: "object", required: ["name"], properties: {age: {type: "integer", minimum: 0}}}), [])
