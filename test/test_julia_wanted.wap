# the forms wiki/Julia.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

words = ["ab", "c"]
check("each applies a function to every item", length each words, [2, 1])
check(".* multiplies item by item", [1, 2] .* [3, 4], [3, 8])
check(".+ adds item by item", [1, 2] .+ [3, 4], [4, 6])
