# the examples of wiki/keyword.md's tables, each as the page writes it
use "check.wap"

check("if 2 > 1 {'yes'} else {'no'}", if 2 > 1 {'yes'} else {'no'}, "yes")
big_x = 2
check("if big_x > 1 then 'big' else 'small'", if big_x > 1 then 'big' else 'small', "big")
w = 0
while w < 3 { w += 1 }
check("w", w, 3)
s7 = 0
for i in 1 to 3 { s7 += i }
check("s7", s7, 6)
check("2 in [1, 2]", 2 in [1, 2], yes)
def returned(x) { return x + 1 }
check("returned(1)", returned(1), 2)
cs = 0
for i in 1..4 { if i == 2 { continue }; cs += i }
check("cs", cs, 4)
def doubled_def(x) { x * 2 }
check("doubled_def(4)", doubled_def(4), 8)
class Point { x: int; y: int }
check("Point(1, 2).y", Point(1, 2).y, 2)
let y5 = 5
check("y5", y5, 5)
const z7 = 7
check("z7", z7, 7)
global g1 = 1
check("g1", g1, 1)
check("true and false", true and false, no)
check("not true", not true, no)
check("1 xor 0", 1 xor 0, 1)
check("9 minus 4", 9 minus 4, 5)
check("3 plus 4", 3 plus 4, 7)
check("5 mod 3", 5 mod 3, 2)
check("7 rem 3", 7 rem 3, 1)
check("3 as text", 3 as text, "3")
nothing_in = []
check("nothing_in is empty", nothing_in is empty, yes)
check("[\"bbb\", \"a\", \"cc\"].sort(by: it => it.length)", ["bbb", "a", "cc"].sort(by: it => it.length), ["a", "cc", "bbb"])
check("[x * 2 for x in 1..4 if x > 1]", [x * 2 for x in 1..4 if x > 1], [4, 6])
es = 0
for each in [1, 2] { es = es + each }
check("es", es, 3)
enum Color { red green blue }
check("Color.green as int", Color.green as int, 1)
class C { n: int = 1; double() := self.n * 2 }
check("C().double()", C().double(), 2)
tx = 0
until tx >= 3 { tx += 1 }
check("tx", tx, 3)
check("\"${try { raise 'oops' } catch e { e }}\"", "${try { raise 'oops' } catch e { e }}", "oops")
suffix operator ‼ := it*2
check("3‼", 3‼, 6)
use math
check("sqrt(16)", sqrt(16), 4.0)
# the other words for def and class (wiki/keyword.md's table, wiki/struct.md)
define tripled(x) { x * 3 }
check("define is def", tripled(2), 6)
func quartered(x) { x - 4 }
check("func is def", quartered(5), 1)
record Coordinate { x: int; y: int }
check("record is class", Coordinate(1, 2).y, 2)
