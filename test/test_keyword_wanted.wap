# the forms wiki/keyword.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

tried = try 1 /! 0 else 0
check("tried", tried, 0)
check("try { 1 /! 0 } catch { 'caught' }", try { 1 /! 0 } catch { 'caught' }, "caught")
kept = try 10 /! 0
check("kept failed", kept failed, yes)
lx = 0
loop { lx += 1; if lx == 4 { break } }
check("lx", lx, 4)
ticked = ✅
check("ticked and ⊤", ticked and ⊤, yes)
check("not ❌", not ❌, yes)
quoted = data(n + 1)
check("quoted == data(n + 1)", quoted == data(n + 1), yes)
wx=0
hits=0
whenever wx>1 {hits+=1}
wx=1
wx=2
wx=3
wx=0
check("hits", hits, 1)
class Doubling { x=0; init(v) := { x = v * 2 } }
check("Doubling(3).x", Doubling(3).x, 6)
on ring {1}
on ring {2}
check("count ring.listeners", count ring.listeners, 2)
level=0
on alarm {level=event.level}
emit alarm{level:3}
check("level", level, 3)
ex = 5
check("if ex < 3 {'a'} elif ex < 6 {'b'} else {'c'}", if ex < 3 {'a'} elif ex < 6 {'b'} else {'c'}, "b")
dx = 0
while dx < 2 do dx += 1 end
check("dx", dx, 2)
sx = 2
check("switch sx { 1: 'one' 2: 'two' default: 'many' }", switch sx { 1: 'one' 2: 'two' default: 'many' }, "two")
mx = 7
check("match mx { 1: 'one' _: 'many' }", match mx { 1: 'one' _: 'many' }, "many")
empty_map = {}
check("empty_map[\"a\"] default 0", empty_map["a"] default 0, 0)
warn "careful"
warned = 1
check("warned", warned, 1)
ox=0
once_hits=0
once ox==5 {once_hits+=1}
for i in 1..10 { ox = i }
check("once_hits", once_hits, 1)
record Pair(a: int, b: int)
check("Pair(1, 2).b", Pair(1, 2).b, 2)
trait Shaped { area() }
class Square implements Shaped { side: int; area() := side * side }
check("Square(3).area()", Square(3).area(), 9)
mixin Walker{ steps:int=0; walk() := 'walks' }
class Cat with Walker { name: text }
check("Cat('tom').walk()", Cat('tom').walk(), "walks")
class V{x:int; operator +(o) := V(x + o.x)}
check("(V(1) + V(2)).x", (V(1) + V(2)).x, 3)
square(x) := x*x
law square(-x) == square(x)
check("square(3)", square(3), 9)
sq(x) := x*x
sq(3)
check("result", result, 9)
ob = no
ob or= yes
check("ob", ob, yes)
check("true nand true", true nand true, no)
check("1 + 1 is 2", 1 + 1 is 2, yes)
check("3 is not 4", 3 is not 4, yes)
sa = 1
check("sa same as 1", sa same as 1, yes)
check("5 is greater than 3", 5 is greater than 3, yes)
check("5 is at least 5", 5 is at least 5, yes)
check("8 divided by 2", 8 divided by 2, 4)
check("7 div 2", 7 div 2, 3)
check("[1, 2] contains 2", [1, 2] contains 2, yes)
check("3 down to 1", 3 down to 1, [3, 2, 1])
check("0.1 + 0.2 circa 0.3", 0.1 + 0.2 circa 0.3, yes)
held_code = data 6*7
check("interpret held_code", interpret held_code, 42)
check("3 is an int", 3 is an int, yes)
neg = error "neg"
check("if neg failed then 1 else 2", if neg failed then 1 else 2, 1)
xs = [1, 2]
add 3 to xs
check("xs", xs, [1, 2, 3])
added(a, b) := a + b
check("added(all [1, 2], 10)", added(all [1, 2], 10), [11, 12])
gf(x):=x*2
job = go({ gf(3) })
check("await(job)", await(job), 6)
class Q { x:int; sq() := x*x }
check("Q.methods", Q.methods, ["sq"])
pf(a:int, b:int) := a+b
check("pf.params", pf.params, ["a", "b"])
sf(a:int, b:int) := a+b
check("sf.signature", sf.signature, "(a:int, b:int) -> int")
class R { x:int }
r = R(1)
check("r.type == R", r.type == R, yes)
# a variable, one that may change (wiki/keyword.md var)
var x2 = 1
x2 = 2
check("var x = 1; x = 2; x", x2, 2)
# wiki/keyword.md test and expect: soft checks every run counts and goes on from, its summary at the run's end
test 1 + 1 == 2
expect 30 10+20
