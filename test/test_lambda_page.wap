# the examples of wiki/lambda.md: function values
use "check.wap"

half = (x:float) => x / 2
check("a lambda's parameter declares its type", half(3), 1.5)
picked = [x => x + 1, x => x * 2]
check("a function value picked from a list is called where it is picked", picked[1](3), 6)
check("a library word passed to map", [1.5 2.5].map(floor), [1.0, 2.0])
check("cos is a library word", [0.0 0.0].map(cos), [1.0, 1.0])
sorted_words = ["banana" "fig" "apple" "kiwi"]
check("sort by a function of two items is a comparison", sort(sorted_words, (a, b) => a > b), ["kiwi", "fig", "banana", "apple"])
check("sort by a comparator: negative means before", sort([3 1 2], (a, b) => b - a), [3, 2, 1])
check("sort by: names the key", sorted_words.sort(by: it => it.length), ["fig", "kiwi", "apple", "banana"])
close_to(a: float, b: float): bool := abs(a - b) < 0.000000000000001 * max(1.0, abs(b))
check("sin, cos and tan at the quarter turns", [sin(PI / 2.0), sin(0.0), cos(PI), cos(0.0), tan(0.0)], [1.0, 0.0, -1.0, 1.0, 0.0])
check("sin, exp and ln within a digit", [close_to(sin(1.0), 0.8414709848078965), close_to(exp(1.0), 2.718281828459045), close_to(ln(exp(2.0)), 2.0), close_to(ln(8.0) / ln(2.0), 3.0)], [yes, yes, yes, yes])
