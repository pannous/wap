# the examples of wiki/lambda.md: function values
use "check.wap"

half = (x:float) => x / 2
check("a lambda's parameter declares its type", half(3), 1.5)
picked = [x => x + 1, x => x * 2]
check("a function value picked from a list is called where it is picked", picked[1](3), 6)
check("a library word passed to map", [1.5 2.5].map(floor), [1.0, 2.0])
