# the forms wiki/lambda.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

floor_ref = function floor
check("function names a library word without calling it", floor_ref(2.5), 2.0)
words = ["banana" "fig" "apple" "kiwi"]
check("sort by a block of it orders by its value", sort(words, {it.length}), ["fig", "kiwi", "apple", "banana"])
listed(make: () -> list<any>): list<any> := make()
check("a lambda giving a list of ints fits a function giving a list of any", #listed(() => [1, 2]), 2)
