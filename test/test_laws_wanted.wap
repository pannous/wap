# the forms wiki/laws.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

twice(x) := x + x
law twice_doubles:
  for x: int
  twice(x) == 2 * x
check("a named law with a for line per variable leaves the program's value alone", twice(4), 8)
fact(n) := if n <= 0 then 1 else n * fact(n - 1)
law fact(n) > 0
check("a law of a recursive function leaves the program's value alone", fact(4), 24)
