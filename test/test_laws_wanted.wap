# the forms wiki/laws.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

twice(x) := x + x
law twice_doubles:
  for x: int
  twice(x) == 2 * x
check("a named law with a for line per variable leaves the program's value alone", twice(4), 8)
fact(n) := if n <= 0 then 1 else n * fact(n - 1)
law fact(n) > 0
check("a law of a recursive function leaves the program's value alone", fact(4), 24)

# a subtype's condition that is a recursive function of a program's enum is decided on the value (wiki/type.md "Proved or checked", notes/coc-t5c3.md)
enum Tree { leaf, node(left: Tree, right: Tree) }
leaves(t: Tree): int := match t { leaf => 1; node(l, r) => leaves(l) + leaves(r) }
type four = Tree where leaves(it) == 4
four_tree: four = node(node(leaf, leaf), node(leaf, leaf))
check("a recursive function of an enum may be a subtype's condition", leaves(four_tree), 4)
