# a generic letter is found at each use (wiki/universe.md "One definition at every level"): two calls of one generic
# each find their own T, and so does a call of a generic inside its own definition
use "check.wap"

pair(a: T, b: T) as list<T> := [a, b]
check("two calls of one generic each find their T", "${pair(1, 2)#2 + 1} ${pair("a", "b")#2 + "c"}", "3 bc")
last_of(xs: list<T>) as T := if #xs == 1 then xs#1 else last_of(xs.drop(1))
check("a generic calling itself finds its T at each use", "${last_of([1, 2, 3]) + 1} ${last_of(["x", "y"]) + "z"}", "4 yz")
