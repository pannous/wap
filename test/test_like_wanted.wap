# the forms wiki/like.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

class photo{width:int height:int}
class image{width:int height:int}
image like photo
area(p:photo) := p.width * p.height
check("a type declared like another stands for it", area(image{width:3 height:4}), 12)
class thumb{width:int}
thumb like photo
keep(p:photo) := p.width
check("like changes no value: a thumb kept as a photo is read by its uses", keep(thumb{width:3}), 3)
