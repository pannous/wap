# the forms wiki/list.md shows that wap does not build yet: each red line is a to-do, fixed by building the form.
# Source: wiki/list.md "a list on the right concatenates, `[1, 2] + [4]`": a list written on one side takes the
# other side's item type, a function's type too
use "check.wap"

double(n: int): int := n * 2
square(n: int): int := n * n
steps: list<(int) -> int> := [double]
joined = steps + [square]
check("a written list of a function joins a list of functions", joined.map(step => step(3)), [6, 9])
