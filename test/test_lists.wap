# wap's list words (wap/types/lists.wap): plain warp over lists and function values, called as `xs.all(…)` or
# all(xs, …). Source: the lead's census of wap's own source (scripts/wap-census.warp), wiki/list.md
use "check.wap"

check("every item fits a test", [1, 2, 3].all(x => x > 0), yes)
check("an item fits a test", [1, 2, 3].any(x => x > 2), yes)
check("a list holds an item", [1, 2, 3].contains(4), no)
check("texts joined by a separator", ["a", "b", "c"].join(", "), "a, b, c")
check("an item's position, 0 for none", [[10, 20].index_of(20), [10, 20].index_of(5)], [2, 0])
check("the first item that fits a test", [3, 4, 5].index_where(x => x > 3), 2)
joined = [1, 2] + [3]
check("two lists joined", [#joined, joined#3], [3, 3])
check("each item's result", [1, 2].map(x => x * 10)#2, 20)
check("the items that fit a test", [1, 2, 3, 4].filter(x => x > 2), [3, 4])
check("the items of optionals that hold a value", [1, ø, 3].compact, [1, 3])
check("each item's list of results, joined", [1, 2].flat_map(x => [x, x]), [1, 1, 2, 2])
check("an item in a list", [2 in [1, 2], 5 in [1, 2]], [yes, no])
check("the items combined from a first value", "${[1, 2, 3].fold(0, (sum, x) => sum + x)} ${[1, 2].fold("", (t, x) => t + text(x))}", "6 12")
rows = [1, 2
3, 4]
check("a row in brackets is a list: [1, 2 / 3, 4] holds two rows", [#rows, rows#2#1], [2, 3])
key_rows = {a: 1, b: 2
c: 3}
check("rows of keys in braces are one map", key_rows["c"], 3)
sliced = slice([1, 2, 3, 4], Range(1, 9))
check("a slice takes the items at a range's places, counting from 0, up to the list's end", [#sliced, sliced#1], [3, 2])
# an empty list's item type is settled by the first use that adds to it
doubles = []
for i in 1 to 3 { doubles = doubles + [i * 2] }
squares(n: int) := {
	found = []
	for i in 1 to n { found += [i * i] }
	found
}
counted(ys: list<int>) := #ys
check("an empty list takes its item type from what is added", [doubles#3, #squares(4), counted([])], [6, 4, 0])
nothing_added = []
count_before = #nothing_added
nothing_added += [4]
check("an empty list nothing adds to counts no items", [#[], count_before, #nothing_added], [0, 0, 1])
short_texts = ["ccc", "a", "bb"]
check("a one-letter text beside texts is a text", short_texts#2 + "!", "a!")
check("the first items of a list, and the rest after them", "${show([1, 2, 3].take(2))} ${show([1, 2, 3].drop(2))} ${show([1].take(5))} ${show([1].drop(5))}", "[1, 2] [3] [1] []")
check("a list's items summed", "${[1, 2, 3].sum()} ${[0.5, 0.25].sum()}", "6 0.75")
check("a list sorted by a key, equal keys in their order", ["ccc", "bb", "aa", "dddd"].sorted(t => #t), ["bb", "aa", "ccc", "dddd"])
added_later = []
added_later.add(2)
never_added = []
check("an empty list typed by its later use", [added_later.sum(), #never_added], [2, 0])
check("a list sorted by a key named by", ["ccc", "bb", "dddd"].sorted(by: t => #t), ["bb", "ccc", "dddd"])
spread_from = [1, 2]
spread = [0, ...spread_from, 4, ...spread_from]
check("a list's items spread into another list", [#spread, spread#5], [6, 1])
check("a list's last item", "wap/core/x.wap".split("/").last, "x.wap")
check("a list of lists shown and searched, each word typed for its item type", "${show([[1, 2], [3]])} ${[["ab"], ["cd", "ef"]].any(row => row.contains("ef"))}", "[[1, 2], [3]] yes")
with_empty = [[1], []]
grown_empty = with_empty#2 + [5]
check("an empty list beside lists of ints is one too", grown_empty#1 + with_empty#1#1, 6)
check("a list's text is its items' texts in brackets", [text([1, 2, 3]), text([[1], [2, 3]])], ["[1, 2, 3]", "[[1], [2, 3]]"])
counting = [4, 5, 6]
check("a list's count, also written length or size", [counting.count, counting.length, [1].size], [3, 3, 1])
check("two lists are equal when their items are, in order", [[1, 2] == [1, 2], [1, 2] == [2, 1], ["a"] != ["a", "b"]], [yes, no, yes])
check("a list's items joined by their texts", [1, 2].join(" ") + "|" + "ab".codepoints.join("-") + "|" + ["x", "y"].join(", "), "1 2|a-b|x, y")
original = [1]
copied = copy(original)
copied.add(2)
same_list = original
same_list.add(3)
check("a copied list grows apart from the first", [#original, #copied], [2, 2])
check("a list's items without their repeats, each where it first appears", text([3, 1, 3, 2, 1].unique), "[3, 1, 2]")
found(n: int) as int? := if n > 0 then n else ø
check("an optional value is in a list when it is there, a missing one in none", [found(2) in [1, 2], found(3) in [1, 2], found(0) in [1, 2], [1, 2].contains(found(1))], [yes, no, no, yes])
check("a missing value is in a list that holds a missing value", [found(0) in [found(1), found(0)], found(0) in [found(1)]], [yes, no])
finding = [1, 2, 3]
check("a list finds its first item that fits a test, none when no item does", "${finding.find(x => x > 1) ?? 0} ${finding.find(x => x > 5) ?? 0} ${["a", "bc"].find(t => #t == 2) ?? "none"}", "2 0 bc")
optionals = [ø, 2]
optionals.add(3)
check("a list of optional ints takes an int, which it holds as an int?", [#optionals, optionals#3 ?? 0], [3, 3])
picked(n: int) as list<int>? := {
	if n < 0 { return ø }
	if n == 0 { return [] }
	[n]
}
check("an empty list where an optional list is the result is a list of the item type it holds", "${text(picked(0))} ${text(picked(2))} ${picked(-1) == ø}", "[] [2] yes")
unsettled = []
settled_texts = ["x"]
emptiness_before = [empty(unsettled), empty(settled_texts)]
unsettled += ["y"]
check("a function of any list called on a list before its item type settles and on one of that type is one function", [emptiness_before#1, emptiness_before#2, empty(unsettled)], [yes, no, no])
shape_nodes: list<Node> = [Symbol("b")]
shape_joined = [Text("a")] + shape_nodes
check("a list of a shape's values joins a list of the type it narrows", #shape_joined, 2)
scaled(length: int, count: int): int := length * 10 + count
own_names() as list<int> := {
	length = 3
	count = 4
	[scaled(length, count), length, [1, 2].size]
}
check("a program's own length and count are two names; size still reads as count", own_names(), [34, 3, 2])
keys: list<text> = ["b", "c", "a"]
check("a list of items that have an order sorts by itself", "${text(keys.sorted())} ${text([3, 1, 2].sorted())}", "[a, b, c] [1, 2, 3]")
# a list sorted by a comparison, `before(a, b)` yes when a goes first (lib's natural and semver orders)
check("a list sorted by a comparison", [3, 1, 2].sorted(before: (a, b) => a > b), [3, 2, 1])
