# the examples of wiki/list.md, each as the page writes it
use "check.wap"

check("space, comma and semicolon in brackets form the same list", [1 2 3] == [1,2,3] and [1,2,3] == [1;2;3], yes)
check("a block's items run in order, the last one its value", {1;2;3}, 3)
lines_block := {1;2;3}
check("a function's block yields its last item", lines_block(), 3)
keys_on_lines = {a:1
b:2}
check("a map written on two lines keeps both keys", [keys_on_lines.a, keys_on_lines.b], [1, 2])
a = 5
check("a space before a glued sign starts a new item; spaced or glued minus subtracts", [[a -1], [a - 1], [a-1]], [[5, -1], [4], [4]])

appended = [1 2 3]
appended += [5 6]
check("+= with a list joins it", appended, [1, 2, 3, 5, 6])
check("the list words work as a method or as a function", [[3 1 1 2].unique(), unique([3 1 1 2])], [[3, 1, 2], [3, 1, 2]])
spread_items = [1 2]
check("a spread splices a list into a list literal", [...spread_items, 4], [1, 2, 4])

taken = [1 2 3]
check("pop gives the last item", taken.pop(), 3)
shared = {a: 1}
sharing = shared
sharing.a = 2
check("a map is shared by the names holding it", shared.a, 2)
original = [1]
copied = original.copy()
copied.add(2)
check("copy gives a list that grows apart", #original, 1)
check("1 to 4 includes 4, 1..4 does not", [#(1 to 4), #(1..4)], [4, 3])
held = [1 2]
check("in is yes or no", [2 in held, 5 in held], [yes, no])
grown = [1]
grown.add(2)
check("add appends", grown, [1, 2])
round = (1, 2, 3)
round#1 = 9
check("round brackets with commas are a plain list", round, [9, 2, 3])
appended = [1 2 3]
check("+ appends an item that is no list", appended + 4, [1, 2, 3, 4])
started = []
started += "a"
check("an empty list started with [] takes an item", started, ["a"])
popped = [1 2 3]
check("Python's pop takes out the item at a place counting from 0", [popped.pop(1), #popped], [2, 2])
cleared = [1 2 3]
cleared.clear()
check("Python's clear takes every item out", #cleared, 0)
extended = [1 2]
extended.extend([3])
check("Python's extend adds a list's items in place", extended, [1, 2, 3])
check("Python's reversed and tuple", [reversed([1 2 3]), tuple([1 2])], [[3, 2, 1], [1, 2]])
popped_map = {a: 1, b: 2}
check("Python's pop of a map gives a key's value and takes the key out", [popped_map.pop("a"), #popped_map], [1, 1])
updated = {a: 1}
updated.update({b: 2})
check("Python's update gives a map another map's keys", updated.b, 2)
defaulted = {a: 1}
check("Python's setdefault gives a missing key its default", [defaulted.setdefault("b", 3), defaulted.setdefault("a", 9), #defaulted], [3, 1, 2])
counted = [1 2]
check("size, count and # count items, len too", [size(counted), count(counted), #counted, counted.size, len(counted)], [2, 2, 2, 2, 2])
check("norm is a list's Euclidean length, length stays the count", [norm([3, 4]), norm([3.0, 4.0])], [5.0, 5.0])
check("a map is shown in wap notation", show([{type: "image", src: "cat.jpg"}]), "[{type: \"image\", src: \"cat.jpg\"}]")
