# the examples of wiki/list.md, each as the page writes it
use "check.wap"

check("space, comma and semicolon in brackets form the same list", [1 2 3] == [1,2,3] and [1,2,3] == [1;2;3], yes)
check("a block's items run in order, the last one its value", {1;2;3}, 3)
lines_block := {1;2;3}
check("a function's block yields its last item", lines_block(), 3)
keys_on_lines = {a:1
b:2}
check("a map written on two lines keeps both keys: keys_on_lines.a", keys_on_lines.a, 1)
check("a map written on two lines keeps both keys: keys_on_lines.b", keys_on_lines.b, 2)
a = 5
check("a space before a glued sign starts a new item; spaced or glued minus subtracts: [a -1]", [a -1], [5, -1])
check("a space before a glued sign starts a new item; spaced or glued minus subtracts: [a - 1]", [a - 1], [4])
check("a space before a glued sign starts a new item; spaced or glued minus subtracts: [a-1]", [a-1], [4])
check("outside brackets too, a value before a glued sign starts a list: a -1", a -1, [5, -1])

appended = [1 2 3]
appended += [5 6]
check("+= with a list joins it", appended, [1, 2, 3, 5, 6])
check("the list words work as a method or as a function: [3 1 1 2].unique()", [3 1 1 2].unique(), [3, 1, 2])
check("the list words work as a method or as a function: unique([3 1 1 2])", unique([3 1 1 2]), [3, 1, 2])
spread_items = [1 2]
check("a spread splices a list into a list literal", [...spread_items, 4], [1, 2, 4])

taken = [1 2 3]
check("pop gives the last item", taken.pop(), 3)
shared = {a: 1}
sharing = shared
sharing.a = 2
check("a map is shared by the names holding it", shared.a, 2)
original = [1]
copied = original.copy()
copied.add(2)
check("copy gives a list that grows apart", #original, 1)
check("1 to 4 includes 4, 1..4 does not: #(1 to 4)", #(1 to 4), 4)
check("1 to 4 includes 4, 1..4 does not: #(1..4)", #(1..4), 3)
held = [1 2]
check("in is yes or no: 2 in held", 2 in held, yes)
check("in is yes or no: 5 in held", 5 in held, no)
grown = [1]
grown.add(2)
check("add appends", grown, [1, 2])
round = (1, 2, 3)
round#1 = 9
check("round brackets with commas are a plain list", round, [9, 2, 3])
appended = [1 2 3]
check("+ appends an item that is no list", appended + 4, [1, 2, 3, 4])
started = []
started += "a"
check("an empty list started with [] takes an item", started, ["a"])
popped = [1 2 3]
check("Python's pop takes out the item at a place counting from 0: popped.pop(1)", popped.pop(1), 2)
check("Python's pop takes out the item at a place counting from 0: #popped", #popped, 2)
cleared = [1 2 3]
cleared.clear()
check("Python's clear takes every item out", #cleared, 0)
extended = [1 2]
extended.extend([3])
check("Python's extend adds a list's items in place", extended, [1, 2, 3])
check("Python's reversed and tuple: reversed([1 2 3])", reversed([1 2 3]), [3, 2, 1])
check("Python's reversed and tuple: tuple([1 2])", tuple([1 2]), [1, 2])
popped_map = {a: 1, b: 2}
check("Python's pop of a map gives a key's value and takes the key out: popped_map.pop(\"a\")", popped_map.pop("a"), 1)
check("Python's pop of a map gives a key's value and takes the key out: #popped_map", #popped_map, 1)
updated = {a: 1}
updated.update({b: 2})
check("Python's update gives a map another map's keys", updated.b, 2)
defaulted = {a: 1}
check("Python's setdefault gives a missing key its default: defaulted.setdefault(\"b\", 3)", defaulted.setdefault("b", 3), 3)
check("Python's setdefault gives a missing key its default: defaulted.setdefault(\"a\", 9)", defaulted.setdefault("a", 9), 1)
check("Python's setdefault gives a missing key its default: #defaulted", #defaulted, 2)
counted = [1 2]
check("size, count and # count items, len too: size(counted)", size(counted), 2)
check("size, count and # count items, len too: count(counted)", count(counted), 2)
check("size, count and # count items, len too: #counted", #counted, 2)
check("size, count and # count items, len too: counted.size", counted.size, 2)
check("size, count and # count items, len too: len(counted)", len(counted), 2)
check("norm is a list's Euclidean length, length stays the count: norm([3, 4])", norm([3, 4]), 5.0)
check("norm is a list's Euclidean length, length stays the count: norm([3.0, 4.0])", norm([3.0, 4.0]), 5.0)
check("a map is shown in wap notation", show([{type: "image", src: "cat.jpg"}]), "[{type: \"image\", src: \"cat.jpg\"}]")
# a spread splices a list into a list literal, `...xs` or `*xs` (wiki/list.md "Spread")
spread = [1 2]
check("a spread written *xs as in Python, beside a product", [2 * 3, *spread], [6, 1, 2])
# values parted by blanks are a list of them, in round brackets too (user 2026-11-23); a number before a word measures it
spaced = (1 2)
check("values parted by blanks in round brackets are a list", spaced, [1, 2])
check("a round list of spaced values counts its items", #(1 2 3), 3)
unbracketed = 1+1 2+2
check("values parted by blanks are a list without brackets too", unbracketed, [2, 4])
check("round lists of spaced values join as lists do", (1 2 3) + (4 5 6), [1, 2, 3, 4, 5, 6])
check("Python's index counts from 0, wap's index_of from 1: [10 20 30].index(20)", [10 20 30].index(20), 1)
check("Python's index counts from 0, wap's index_of from 1: [10 20 30].index_of(20)", [10 20 30].index_of(20), 2)
line_list = 1 2 3
check("spaced values given to a name are a list", line_list, [1, 2, 3])
# `it` is the parameter code names without declaring it (wiki/function.md, wiki/list.md)
square_it := it * it
check("a definition naming it takes it as its parameter", square_it(3), 9)
square_block = {it * it}
check("a block naming it is a function of it", square_block(4), 16)
check("where keeps the items that fit a condition on it", [1 2 3] where it > 1, [2, 3])
check("a function value's own it stays its own", [1 2].map(it => it * 10), [10, 20])
glued_sign = 5 -2
check("a space before a glued sign starts a new item outside brackets too", glued_sign, [5, -2])
check("values parted by blanks in braces are a list", {1 2 3}, [1, 2, 3])
typed_list: list of number = [1, 2]
check("list of a type declares a typed list", #typed_list, 2)
# "Counted lists": a number times a type, `·` as `⋅` and `*` write it
counted_items(xs: 3·int) := #xs
check("a number times a type with a middle dot is a list of that many items: 3·int", counted_items([4, 5, 6]), 3)
check("xs.count(2) is how often 2 is in xs", [2, 1, 2].count(2), 2)
