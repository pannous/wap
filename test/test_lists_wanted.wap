# the forms wiki/list.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

spaced_map = {a:1 b:2 c:3}
check("a map's entries need no commas", [spaced_map.a, spaced_map.c], [1, 3])
matrix = (1 2; 3 4)
check("a semicolon parts the rows of a matrix", matrix, [[1, 2], [3, 4]])
square := it*it
check("a function of a number given a list maps over it", square([1 2 3]), [1, 4, 9])
check("Python's items gives a map's entries", #({a: 1, b: 2}.items()), 2)
check("Python's fromkeys gives each key one value", dict.fromkeys(["a", "b"], 0).b, 0)
plural_typed: numbers = [1, 2]
check("a plural type name is a list of it", #plural_typed, 2)
# wiki/standard-library.md "prelude": xs.first() is first(xs), also for the list a split gives
check("the first item of a split text", "a:b".split(":").first, "a")
# "Counted lists": a number times a type as a value is that many initialized items
my_data = 10·byte
check("10·byte is ten initialized bytes", #my_data, 10)

summed(xs: int list) := sum(xs)
check("int list is [int] in English order", summed([1, 2]), 3)
nested = [[1]]
copied = copy(nested)
copied[0][0] = 9
check("copy is deep", nested, [[1]])
cloned_from = [[1]]
cloned = clone(cloned_from)
cloned[0][0] = 9
check("clone is deep", cloned_from, [[1]])
