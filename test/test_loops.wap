# wap's loops and returns (wap/kernel/forms.wap: While, Return; wiki/keyword.md): `while c { b }` runs b while c holds,
# `return x` leaves the function with x
use "check.wap"

go = yes
said = ""
while go { said = said + "once "
go = no }
check("a loop runs while its condition holds", said + "done", "once done")
early(c: bool) := { if c then return 1
2 }
check("an early return's value", early(yes), 1)
check("the end's value when no return runs", early(no), 2)
f(c: bool) := if c then return 5 else 6
check("a return in one part of an If", f(yes), 5)
counter = 0
running = 0
while counter < 5 { counter = counter + 1
running = running + counter }
check("a counting loop's sum", running, 15)
compared = 3
check("a comparison chooses", if compared == 3 then "three" else "other", "three")
broken = 0
while yes { broken = broken + 1
if broken == 3 then break }
check("break leaves the loop", broken, 3)
step = 0
skipped = 0
while step < 6 { step = step + 1
if step == 2 then continue
skipped = skipped + step }
check("continue starts the next run", skipped, 19)
phrase = 1
while phrase < 2 { if phrase == 1 { phrase = 2 } }
check("a block of one keyword phrase", phrase, 2)
# until c { b } is while not c (wiki/keyword.md)
upward = 0
until upward >= 3 { upward = upward + 1 }
check("until loops until its condition holds", upward, 3)
ranged = 0
for i in 1 to 4 { ranged = ranged + i }
check("for counts through a range", ranged, 10)
total_of(xs: list<int>): int := {
	total = 0
	for x in xs { total = total + x }
	total
}
summed = total_of [1, 2, 3, 4]
check("for takes each item of a list", summed, 10)
items = ""
for x in [1, 2, 3] { if x == 2 then continue
items = items + "item " }
check("continue in a for moves to the next item", items, "item item ")
pairs = 0
for i in 1 to 3 { for j in 1 to 2 { pairs = pairs + 1 } }
check("a for inside a for", pairs, 6)
counted = 2 to 5
check("a range held in a name counts its ints", #counted, 4)
written = 0
for i in 1 .. 4 { written = written + i }
named = 2 to 5
held = 0
for i in named { held = held + i }
check("a for loop walks a range, written or named, by its # word: written", written, 6)
check("a for loop walks a range, written or named, by its # word: held", held, 14)
listed = [1, 2]
indented = ""
for i in listed
	indented = indented + "${i} "
again = yes
while again
	indented = indented + "once"
	again = no
check("a block indented below a loop is its body", indented, "1 2 once")
# a range walked without naming its item names it `it` (wiki/for.md): `..` stops before its end, `to` and `…` reach it
walked = ""
for 1..3 { walked = walked + text(it) }
for 1 to 2 { walked = walked + text(it) }
for 1…2 { walked = walked + text(it) }
check("a range walked without naming its item names it it", walked, "121212")
# a loop's head ends in a colon, the rest of the line or the block indented below it its body (wiki/for.md)
colon_seen = ""
for n in [1, 2]: colon_seen = colon_seen + text(n)
for word in ["a", "b"]:
	colon_seen = colon_seen + word
colon_counted = 0
while colon_counted < 3: colon_counted = colon_counted + 1
check("a loop's head ends in a colon: for and while", [colon_seen, text(colon_counted)], ["12ab", "3"])
# a range's end is read once, before the first round, as in Python (wiki/for.md)
end_read = 3
rounds = 0
for i in 0..end_read { end_read = 10; rounds = rounds + 1 }
check("a range's end is read once: for i in 0..n { n = 10 } runs n times", rounds, 3)
# a for over nothing runs no round, a range counting down holds no int, break leaves a for, and writing the loop's
# name changes only this round: the next round takes the next item, the list keeps its own (wiki/for.md, wiki/Footguns.md)
no_items: list<int> = []
empty_rounds = 0
for x in no_items { empty_rounds = empty_rounds + 1 }
for i in 5 to 1 { empty_rounds = empty_rounds + 1 }
check("a for over an empty list or a range counting down runs no round", empty_rounds, 0)
broken_at = 0
for x in [1, 2, 3, 4] { broken_at = x; if x == 2 then break }
check("break leaves a for", broken_at, 2)
kept = [1, 2, 3]
for x in kept { x = 0 }
check("writing a for's item leaves the list's item", kept#2, 2)
written_rounds = 0
for i in 1 to 5 { i = i + 10; written_rounds = written_rounds + 1 }
check("writing the loop's name changes only this round", written_rounds, 5)
# a range whose end is below its start holds no int, its count never below zero where numbers stop at zero (wiki/for.md)
up_to_zero_rounds = 0
for i in 1 to 0 { up_to_zero_rounds = up_to_zero_rounds + 1 }
check("a range ending below its start runs no round", up_to_zero_rounds, 0)
