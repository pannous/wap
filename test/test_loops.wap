# wap's loops and returns (wap/kernel/forms.wap: While, Return; wiki/keyword.md): `while c { b }` runs b while c holds,
# `return x` leaves the function with x
use "check.wap"

go = yes
said = ""
while go { said = said + "once "
go = no }
check("a loop runs while its condition holds", said + "done", "once done")
first(c: bool) := { if c then return 1
2 }
check("an early return's value", first(yes), 1)
check("the end's value when no return runs", first(no), 2)
f(c: bool) := if c then return 5 else 6
check("a return in one part of an If", f(yes), 5)
counter = 0
running = 0
while counter < 5 { counter = counter + 1
running = running + counter }
check("a counting loop's sum", running, 15)
compared = 3
check("a comparison chooses", if compared == 3 then "three" else "other", "three")
broken = 0
while yes { broken = broken + 1
if broken == 3 then break }
check("break leaves the loop", broken, 3)
step = 0
skipped = 0
while step < 6 { step = step + 1
if step == 2 then continue
skipped = skipped + step }
check("continue starts the next run", skipped, 19)
phrase = 1
while phrase < 2 { if phrase == 1 { phrase = 2 } }
check("a block of one keyword phrase", phrase, 2)
# until c { b } is while not c (wiki/keyword.md)
upward = 0
until upward >= 3 { upward = upward + 1 }
check("until loops until its condition holds", upward, 3)
ranged = 0
for i in 1 to 4 { ranged = ranged + i }
check("for counts through a range", ranged, 10)
sum(xs: list<int>): int := {
	total = 0
	for x in xs { total = total + x }
	total
}
summed = sum [1, 2, 3, 4]
check("for takes each item of a list", summed, 10)
items = ""
for x in [1, 2, 3] { if x == 2 then continue
items = items + "item " }
check("continue in a for moves to the next item", items, "item item ")
pairs = 0
for i in 1 to 3 { for j in 1 to 2 { pairs = pairs + 1 } }
check("a for inside a for", pairs, 6)
counted = 2 to 5
check("a range held in a name counts its ints", #counted, 4)
written = 0
for i in 1 .. 4 { written = written + i }
named = 2 to 5
held = 0
for i in named { held = held + i }
check("a for loop walks a range, written or named, by its # word", [written, held], [6, 14])
listed = [1, 2]
indented = ""
for i in listed
	indented = indented + "${i} "
again = yes
while again
	indented = indented + "once"
	again = no
check("a block indented below a loop is its body", indented, "1 2 once")
