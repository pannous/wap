# the polynomial circle and growth functions, lib/machine_math.wap (its header): within their stated error of the
# types' own sin, cos, exp, log and math's atan2
use machine_math
use math
use "check.wap"

# the largest gap between f and g over n + 1 points from low to high
largest_gap(f: (float) -> float, g: (float) -> float, low: float, high: float, n: int): float := {
	(0 to n).map(i => low + (high - low) * float(i) / float(n)).fold(0.0, (gap, x) => max(gap, abs(f(x) - g(x))))
}
check("fast_sin and fast_cos within 1e-11 up to 1000", [largest_gap(fast_sin, sin, -1000.0, 1000.0, 20000) < 1e-11, largest_gap(fast_cos, cos, -1000.0, 1000.0, 20000) < 1e-11], [yes, yes])
check("fast_exp within 8e-14 relative", largest_gap(x => fast_exp(x) / exp(x), x => 1.0, -700.0, 700.0, 20000) < 8e-14, yes)
check("fast_pow of a positive base", abs(fast_pow(2.0, 0.5) - sqrt(2.0)) < 1e-14, yes)
check("fast_pow of a negative base and a whole power", [fast_pow(-2.0, 3.0), fast_pow(-2.0, 2.0)], [-8.0, 4.0])
check("fast_atan2 within 3e-12 radians", largest_gap(t => fast_atan2(sin(t), cos(t)), t => atan2(sin(t), cos(t)), -3.0, 3.0, 20000) < 3e-12, yes)
check("two_to by squaring", [two_to(10.0), two_to(-2.0)], [1024.0, 0.25])
