# map helpers, lib/map.wap (wiki/library-map-helpers.md, wiki/standard-library.md "map"): maps merged, filtered and
# turned around, paths into nested maps and lists
use map
use text
use "check.wap"

check("deep merge", show(deep_merge({a: 1, b: {c: 2}}, {b: {d: 3}})), "{a: 1, b: {c: 2, d: 3}}")
check("a path read", get_path({server: {port: 8080}}, ["server", "port"]), 8080)
check("a path set", show(set_path({server: {port: 8080}}, ["server", "host"], "localhost")), "{server: {port: 8080, host: \"localhost\"}}")
check("keys transformed", show(transform_keys({a: 1, b: 2}, k => upper(k))), "{A: 1, B: 2}")
check("entries filtered", show(filter_entries({a: 1, b: 2, c: 3}, (k, v) => v > 1)), "{b: 2, c: 3}")
check("a path through a list", get_path({a: [{b: 5}]}, ["a", 0, "b"]), 5)
# TODO the ø results shown in one list once show takes an any holding ø (with wap-binding)
check("a path off the data", [get_path({a: [1]}, ["a", 3]) == ø, get_path({a: 1}, ["a", "b"]) == ø, get_path({a: 1}, ["x"]) == ø], [yes, yes, yes])
original = {a: {b: 1}}
changed = set_path(original, ["a", "b"], 2)
check("set_path leaves the data unchanged", show([original, changed]), "[{a: {b: 1}}, {a: {b: 2}}]")
# TODO (card one-char-literal) ["b"] inline once a one-character text literal is a text where a list<text> is wanted
just_b: list<text> = ["b"]
check("merge, pick, omit", show([merge({a: 1, b: 2}, {b: 3}), pick({a: 1, b: 2}, just_b), omit({a: 1, b: 2}, just_b)]), "[{a: 1, b: 3}, {b: 2}, {a: 1}]")
check("invert, entries, from_pairs", show([invert({a: 1, b: 2}), entries({a: 1}), from_pairs([["x", 1], ["y", 2]])]), "[{1: \"a\", 2: \"b\"}, [[\"a\", 1]], {x: 1, y: 2}]")
check("get_or, find_key, filter_values, map_values", show([get_or({a: 1}, "b", 0), find_key({a: 1, b: 2}, v => v > 1), filter_values({a: 1, b: 2}, v => v > 1), map_values({a: 1}, v => v * 10)]), "[0, \"b\", {b: 2}, {a: 10}]")
first_map = {a: 1}
copied_map = copy(first_map)
copied_map["b"] = 2
check("a copy grows apart from the first", show([first_map, copied_map]), "[{a: 1}, {a: 1, b: 2}]")
