# the examples of wiki/map.md, each as the page writes it; and the user's list-text decision of 2026-11-23, whose
# sibling a map's text is: its values shown as show does, texts quoted
use "check.wap"

grown = {}
grown["x"] = 1
check("a = {} starts an empty map", #grown, 1)
first_of(m) := m.first
check("a map's first value", first_of({first: 9}), 9)
named(m) := m.name
check("a key named like no map word is the map's field", named({name: 9}), 9)
entries(m) := m.count
check("a word that takes a map wins over a key of its name, read in brackets: entries({count: 5, b: 2})", entries({count: 5, b: 2}), 2)
check("a word that takes a map wins over a key of its name, read in brackets: {count: 5, b: 2}[\"count\"]", {count: 5, b: 2}["count"], 5)
check("a word that takes a map wins over a key of its name, read in brackets: {a: 1}.count", {a: 1}.count, 1)
firsts = []
for p in [{first: 2}] { firsts += [p.first] }
check("a map in a list reads its key", firsts, [2])
nested = {a:1, b:{c:2, d:3}}
check("a map's text is its entries in braces", text(nested), "{a: 1, b: {c: 2, d: 3}}")
hashed = {}
for i in 0..1000 { hashed["k\(i)"] = i }
check("a map of a thousand keys set one by one", hashed["k999"] + count(hashed), 1999)
check("a map's text quotes its texts, as show does", text({name: "Ada", age: 36}), "{name: \"Ada\", age: 36}")
# a map declared `a: map` holds the keys and values its uses give, as `a = {}` does (map prototype)
declared_map: map = {}
declared_map["key"] = 1
check("a:map = {} holds what its uses give: declared_map[\"key\"]", declared_map["key"], 1)
declared_list: list = []
declared_list.add(3)
check("xs: list = [] is a list its uses settle", declared_list, [3])
walked_keys = []
for key in {one: 1, two: 2} { walked_keys.add(key) }
check("for walks a map by its keys (wiki/inventions.md)", walked_keys, ["one", "two"])
check("a map without commas reads its keys", {y:2.5 x:1}.x, 1.0)
# an empty {} beside a map is of that map's type, so a missing entry's default is one (notes/coc-t3.md "Gate", the
# user's T3 plan of 2026-11-25)
coalesced_maps: map<text, map<text, text>> = {}
coalesced = coalesced_maps.get("k") ?? {}
coalesced["x"] = "y"
check("an empty {} after ?? is a map of the left's type", #coalesced, 1)
# a map used as a whole value is the same map: a section written through another name stays in the map that holds it,
# and the entries written before it stay too
sections(source: text) := {
	root = {}
	section = root
	for line in source.split("\n") {
		if line.starts_with("[") {
			fresh = {}
			root[line] = fresh
			section = fresh
		} else {
			section[line] = "v"
		}
	}
	root
}
check("a map written through a name that held it, then another map inside it, keeps both", show(sections("top\n[db]\nhost")), "{top: \"v\", [db]: {host: \"v\"}}")
# a key written as a text is a text however it is written, an interpolated one too (wiki/text.md)
file = "notes"
check("a map's key may be an interpolated text", {"${file}.txt": 1}["notes.txt"], 1)

check("count(m) counts a map's entries, even one named count", count({count: 5, b: 2}), 2)
