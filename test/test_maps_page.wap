# the examples of wiki/map.md, each as the page writes it; and the user's list-text decision of 2026-11-23, whose
# sibling a map's text is: its values shown as show does, texts quoted
use "check.wap"

grown = {}
grown["x"] = 1
check("a = {} starts an empty map", #grown, 1)
first_of(m) := m.first
check("a map's first value", first_of({first: 9}), 9)
named(m) := m.name
check("a key named like no map word is the map's field", named({name: 9}), 9)
entries(m) := m.count
check("a word that takes a map wins over a key of its name, read in brackets", [entries({count: 5, b: 2}), {count: 5, b: 2}["count"], {a: 1}.count], [2, 5, 1])
firsts = []
for p in [{first: 2}] { firsts += [p.first] }
check("a map in a list reads its key", firsts, [2])
nested = {a:1, b:{c:2, d:3}}
check("a map's text is its entries in braces", text(nested), "{a: 1, b: {c: 2, d: 3}}")
hashed = {}
for i in 0..1000 { hashed["k\(i)"] = i }
check("a map of a thousand keys set one by one", hashed["k999"] + count(hashed), 1999)
check("a map's text quotes its texts, as show does", text({name: "Ada", age: 36}), "{name: \"Ada\", age: 36}")
