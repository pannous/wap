# the forms wiki/map.md and wiki/inventions.md show that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

check("a single entry in braces is a pair", {a:1} == (a:1), yes)

counted = {count: 5, b: 2}
check("an entry wins over a word that takes maps", counted.count, 5)
held = {a: 0}
set "a" of: held to: 1
check("set … of: … to: writes an entry", held["a"], 1)
