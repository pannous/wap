# Markdown, lib/markdown.wap (wiki/library-markdown.md): headings, emphasis, code, links, quotes, lists, tables
use markdown
use "check.wap"

check("a heading and a paragraph with emphasis and code", markdown_html("# Title\n\nSome *emphasis* and `code`."), "<h1>Title</h1>\n<p>Some <em>emphasis</em> and <code>code</code>.</p>\n")
check("a tight list", markdown_html("- one\n- two"), "<ul>\n<li>one</li>\n<li>two</li>\n</ul>\n")
check("a table with an aligned column", markdown_html("| a | b |\n|---|--:|\n| 1 | 2 |"), "<table>\n<thead>\n<tr>\n<th>a</th>\n<th align=\"right\">b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td align=\"right\">2</td>\n</tr>\n</tbody>\n</table>\n")
check("strong, strike and a link", markdown_html("**bold** ~~gone~~ [wap](https://example.com \"home\")"), "<p><strong>bold</strong> <del>gone</del> <a href=\"https://example.com\" title=\"home\">wap</a></p>\n")
check("a fenced block keeps its text", markdown_html("```js\nif (a < b) {}\n```"), "<pre><code class=\"language-js\">if (a &lt; b) {}\n</code></pre>\n")
check("a quote around a list", markdown_html("> 1. a\n> 2. b"), "<blockquote>\n<ol>\n<li>a</li>\n<li>b</li>\n</ol>\n</blockquote>\n")
check("a nested list", markdown_html("- a\n  - b"), "<ul>\n<li>a\n<ul>\n<li>b</li>\n</ul>\n</li>\n</ul>\n")
check("a loose list wraps its items in paragraphs", markdown_html("- a\n\n- b"), "<ul>\n<li>\n<p>a</p>\n</li>\n<li>\n<p>b</p>\n</li>\n</ul>\n")
check("escapes, an image, an autolink, a hard break", markdown_html("\\*x\\* ![cat](c.png) <https://a.b>  \nnext"), "<p>*x* <img src=\"c.png\" alt=\"cat\" /> <a href=\"https://a.b\">https://a.b</a><br />\nnext</p>\n")
check("a rule and an intraword underscore", markdown_html("snake_case_name\n\n---"), "<p>snake_case_name</p>\n<hr />\n")
