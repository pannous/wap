# wap's match (wiki/pattern-matching.md; wap/kernel/forms.wap Case): the first arm whose pattern fits the subject gives
# the value; a literal fits the value equal to it, a name fits any value and holds it, `_` fits any
use "check.wap"

two = 2
check("the first literal arm that fits", match two { 1 => "one"; 2 => "two"; _ => "many" }, "two")
size(n: int): text := match n {
	0 => "none"
	1 => "one"
	_ => "many"
}
check("a match gives its arm's value: size(0)", size(0), "none")
check("a match gives its arm's value: size(5)", size(5), "many")
twice(n: int) := match n { 0 => 0; k => k + k }
check("a name arm holds the subject", twice(21), 42)
greet(who: text): text := match who {
	"wap" => "hello, self"
	other => "hello, " + other
}
check("texts are matched by their characters: greet(\"wap\")", greet("wap"), "hello, self")
check("texts are matched by their characters: greet(\"warp\")", greet("warp"), "hello, warp")
ran = ""
match 5 { 1 => ran = "one" }
check("no arm fits: nothing runs", ran + "after", "after")
inner = text match two { 1 => "one"; _ => "other" }
check("a match later in a phrase is the earlier word's argument", inner, "other")
y = 0
x = 1
match x {
	1 => y = 2
	_ => y = 3
}
check("an arm assigns in its result, not to the arrow", y, 2)
k(n: int, b: bool) := match b {
  yes => n
  _ => ø
}
check("a match with a value in one arm and ø in another gives an optional: k(3, yes) == 3", k(3, yes) == 3, yes)
check("a match with a value in one arm and ø in another gives an optional: k(3, no) == ø", k(3, no) == ø, yes)
total(xs: list<int>): int := match xs { [] => 0; [first, ...rest] => first + total(rest) }
check("a list pattern takes the first item and the rest", total([1, 2, 3]), 6)
second(xs: list<text>) := match xs { [a, b] => b; [a, b, ...more] => b + "+"; _ => "none" }
check("list patterns fit by count: second([\"x\", \"y\"])", second(["x", "y"]), "y")
check("list patterns fit by count: second([\"x\", \"y\", \"z\"])", second(["x", "y", "z"]), "y+")
check("list patterns fit by count: second([\"x\"])", second(["x"]), "none")
enum Shape { Dot, Circle(r: int) }
f(s: Shape?) := match s { Circle(r) => r; Dot => 0; _ => -1 }
check("a match on an optional tests its value's cases: f(Circle(3))", f(Circle(3)), 3)
check("a match on an optional tests its value's cases: f(Dot)", f(Dot), 0)
check("a match on an optional tests its value's cases: f(ø)", f(ø), -1)
pattern Duo = (duo $name: Symbol $items: List)
named(d: Duo) as text := match d { Duo(name, items) => text(name) }
counted(d: Duo) as int := match d { Duo(name, items) => match items { List(parts, bracket, separator) => #parts } }
duo: Node = Duo(symbol("a"), List([symbol("x"), symbol("y")], Bracket.Square, Separator.Comma))
check("a declared pattern is a type: a match naming its shape fits every value of it, its holes of their types", "${named(duo)} ${counted(duo)}", "a 2")
kind(d: Duo) as text := "duo"
kind(n: Node) as text := "node"
empty_duo: Node = Duo(symbol("a"), List([], Bracket.Square, Separator.Comma))
held: Duo = empty_duo
check("a Node where a shape is wanted is told apart at run time: kind(empty_duo)", kind(empty_duo), "duo")
check("a Node where a shape is wanted is told apart at run time: kind(symbol(\"b\"))", kind(symbol("b")), "node")
check("a Node where a shape is wanted is told apart at run time: text(match held { Duo(name, items) => name })", text(match held { Duo(name, items) => name }), "a")
said(n: Node) as text := if n is Duo then named(n) else "other"
check("a declared pattern's name after is tests the shape, and the then-arm holds a value of it: said(Duo(symbol(\"a\"), List([], Bracket.Square, Separator.Comma)))", said(Duo(symbol("a"), List([], Bracket.Square, Separator.Comma))), "a")
check("a declared pattern's name after is tests the shape, and the then-arm holds a value of it: said(symbol(\"b\"))", said(symbol("b")), "other")
parts_of(n: Node) as int := match n {
	Duo(name, items) => match items { List(parts, bracket, separator) => #parts }
	_ => 0
}
check("an arm naming a declared pattern on a Node holds its holes of their types: a match inside it on one is whole", parts_of(Duo(symbol("a"), List([symbol("x"), symbol("y")], Bracket.Square, Separator.Comma))) + parts_of(symbol("b")), 2)
# a parameter of a declared pattern's type reads its parts by their holes' names (wiki/pattern-matching.md "Named
# patterns as types")
pattern Choice = (choose $condition: Node $then: Node $else: Node)
chosen(c: Choice) as Node := c.then
check("a named pattern's parts read by name", chosen(Choice(Symbol("ready"), Number(1), Number(2))), Number(1))
# arms written as keys (wiki/matching.md)
enum Coin { Penny, Nickel, Dime, Quarter }
cents(coin: Coin) as int := match coin {
	Penny: 1
	Nickel: 5
	Dime: 10
	Quarter: 25
}
check("a match's arms written as keys", cents(Coin.Dime), 10)
ends(xs: list<int>) := match xs { [a, ...middle, z] => [a, z, #middle]; _ => [] }
check("a rest anywhere in a list pattern: the items before it from the start, those after it from the end", [ends([1, 2, 3, 4]), match [1, 2, 3] { [...init, last] => [last] }], [[1, 4, 2], [3]])
# a bracketed match is one operand: `(match …) + rest`
check("a bracketed match adds to the rest", (match two { 2 => 10; _ => 0 }) + 1, 11)
# a declared pattern's bare name in an arm matches its shape, as its call does, and names each hole by the hole's own
# name (wiki/pattern-matching.md "Named patterns": `Tagged => label`); only a name that names no case or pattern binds
pattern Halt = (halt)
halted(n: Node) as text := match n { Halt => "halt"; _ => "other" }
check("a declared pattern's bare name matches only its shape, so the next arm takes the rest", "${halted(Halt())} ${halted(symbol("go"))}", "halt other")
check("a declared pattern's bare name names its holes", match duo { Duo => text(name); _ => "none" }, "a")

enum Tree { leaf, node(left: Tree, right: Tree) }
check("a pattern inside a pattern", match node(node(leaf, leaf), leaf) { node(leaf, r) => 1; node(l, r) => 2; leaf => 0 }, 2)
