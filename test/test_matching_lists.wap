# wap's named list patterns (wiki/pattern-matching.md "Named patterns as types"): a declared pattern whose body is a
# list takes a list of that shape apart. Its own program: a pattern wap refuses stops only these checks
use "check.wap"

pattern Pair = [$a: int, $b: int]
check("a named list pattern takes a list apart", match [5, 6] { Pair(x, y) => x + y }, 11)
check("a named list pattern builds a list of its parts", Pair(3, 4), [3, 4])
