# the forms wiki/matching.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

class contact{name:text; image:text}
to assign a photo to a contact: contact.image = photo
ann = contact("Ann", "")
assign "me.png" to ann
check("a phrase head's type words name its parameters: assign a photo to a contact", ann.image, "me.png")
to plus number a to number b: a+b
check("in each part of a head the last word names the parameter, the words before it its type", plus(1.5, 2), 3.5)
to measure a parcel: parcel+1
check("an unknown noun after an article is an untyped name", measure 2, 3)
to call a phone number: number+1
check("a name of several words is typed by its last word", call 2, 3)
enum Coin { Penny, Nickel, Dime, Quarter }
to get value of coin in cents:
    match coin {
        Penny : 1
        Nickel : 5
        Dime : 10
        Quarter : 25
    }
cents = get value of Dime in cents
check("a phrase head of a type name matches an enum's cases", cents, 10)
