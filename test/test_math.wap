# the whole-number and long-named words of math, lib/math.wap (wiki/standard-library.md "math")
use math
use "check.wap"

check("gcd and lcm", [gcd(12, 18), lcm(4, 6)], [6, 12])
check("factorial and choose", [factorial(5), choose(5, 2)], [120, 10])
check("digits of a whole number", digits(1234), [1, 2, 3, 4])
check("a power modulo", mod_pow(4, 13, 497), 445)
check("the whole square root", [isqrt(17), is_square(16), is_square(17)] == [4, yes, no], yes)
check("divisors", divisors(12), [1, 2, 3, 4, 6, 12])
check("a number in a base and back", [to_base(255, 16), "${from_base("ff", 16)}"], ["ff", "255"])
check("bits", [bit_count(6), bit_and(-129, 127)], [2, 127])
check("rounding to decimals", round(3.14159, 2), 3.14)
check("a percentage", percent(1, 4), 25.0)
check("the whole part toward zero", whole_part(-2.5), -2)
check("a remainder with the sign of a", remainder(-7.0, 3.0), -1.0)
check("a logarithm to any base", round(logarithm(8, 2), 9), 3.0)
check("clamp and sign", [clamp(15, 0, 10), sign(-3)], [10, -1])
check("the long names of the C words", [square_root(16.0), square(3.0), hypotenuse(3, 4)], [4.0, 9.0, 5.0])
