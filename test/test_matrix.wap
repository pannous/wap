# Matrices, lib/matrix.wap (wiki/library-matrix.md): determinant, linear systems and inverses by Gaussian elimination
use matrix
use "check.wap"

check("the determinant of a 2 by 2 matrix", determinant([[1, 2], [3, 4]]), -2.0)
check("the solution of a linear system", solve([[2, 1], [1, 3]], [3, 5]), [0.8, 1.4])
check("the inverse of a matrix", inverse([[4, 7], [2, 6]]), [[0.6000000000000001, -0.7000000000000001], [-0.2, 0.4]])
