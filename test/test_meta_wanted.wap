# the forms wiki/meta.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"
use comments

class point{x:int y:int}
tagged = @source("gps") point{x:1 y:2}
check("a meta key written in front of a value", tagged.@source, "gps")
p = point{x:1 y:2 @source:"gps"}
check("a meta key written inside the literal", p.@source, "gps")
p.@source = "manual"
check("a meta key is written as a field is", p.@source, "manual")
check("a glued @ reads a meta key", p@source, "manual")
check("a meta key read by its name", p["@source"], "manual")
check("a meta key is never a field: # does not count it", #p, 2)
check("a meta key is never a field: == ignores it", p == point{x:1 y:2}, yes)
check("p.source falls back to the meta key @source", p.source, "manual")
// the answer
answer = 42
check("under use comments a binding carries its comment", answer.@comment, "the answer")
