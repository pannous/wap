# Money, lib/money.wap (wiki/library-money.md): exact amounts in minor units, one currency at a time, splitting that
# sums back, parsing and the en/de styles
use money
use "check.wap"

check("an amount's text", money_of(12.34, "EUR").text(), "EUR 12.34")
check("two amounts of one currency add exactly", (money_of(19.99, "USD") + money_of(5.01, "USD")).text(), "USD 25.00")
check("a split sums back, the cent left going first", money_split(money_of(100, "EUR"), 3).map(m => m.text()), ["EUR 33.34", "EUR 33.33", "EUR 33.33"])
check("a German amount parsed, written in English", money_format(money_parse("€1.234,56"), "en"), "€1,234.56")
check("an amount written in German", money_format(money_of(1234.56, "EUR"), "de"), "1.234,56 €")
check("two currencies do not add", try (money_of(1, "EUR") + money_of(1, "USD")).text() else "refused: two currencies", "refused: two currencies")
