# several places given values at once (wiki/multi-value.md): every value is taken first, then each place gets its own,
# so `x, y = y, x` swaps; one value that is a list gives its items in turn
use "check.wap"

x = 1
y = 2
x, y = y, x
check("names parted by commas swap: x, y = y, x", [x, y], [2, 1])
xs = [1, 2, 3]
xs[0], xs[2] = xs[2], xs[0]
check("items swap as names do: xs[0], xs[2] = xs[2], xs[0]", xs, [3, 2, 1])
divmod(a: int, b: int) := [a /! b, a % b]
q, r = divmod(17, 5)
check("names take the items of one list: q, r = divmod(17, 5)", [q, r], [3, 2])
