# the forms wiki/multi-value.md shows, built: a row of values after a definition is its value
# Source: wiki/multi-value.md
use "check.wap"

listed = 1, 2, 3
check("a = 1, 2, 3 is a list", listed, [1, 2, 3])
defined := 1, 2, 3
check("x := 1, 2, 3 is a list too", defined, [1, 2, 3])
computed = 1 + 1, 3
check("each value of the row is read whole before the comma", computed, [2, 3])
