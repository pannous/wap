# the forms wiki/multi-value.md shows, built: a row of values after a definition is its value
# Source: wiki/multi-value.md, the definition's row (user 2026-11-24: the comma binds tighter than a definition)
use "check.wap"

listed = 1, 2, 3
check("a = 1, 2, 3 is a list", listed, [1, 2, 3])
defined := 1, 2, 3
check("x := 1, 2, 3 is a list too", defined, [1, 2, 3])
summed = 1 + 1, 3
check("an operator binds tighter than the comma, the comma tighter than the definition", summed, [2, 3])
first = 1, second = 2, 3
check("each definition of a row opens its own group: the first", first, 1)
check("each definition of a row opens its own group: the bare values after one are its", second, [2, 3])
enum Mark {
	Colon = ":", Dot = "."
}
check("a row of definitions alone stays a row of definitions", Mark.Dot as text, ".")
pair(x, y) := [x, y]
check("a definition inside a call's brackets is one argument", #pair(d := 1, 2), 2)
sum_row := 1 + 2, 4
check("an operator's value is one item of the row", sum_row, [3, 4])
enum Severity { Fatal, Notice = "note", Quiet }
check("a row of cases with a value among them stays cases", Severity.Quiet as text, "Quiet")
