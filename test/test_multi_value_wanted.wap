# the forms wiki/multi-value.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

divmod(a, b) := return a /! b, a % b
q, r = divmod(17, 5)
check("return a, b gives several values, x, y = f() takes them apart: q", q, 3)
check("return a, b gives several values, x, y = f() takes them apart: r", r, 2)
check("several values used whole are a list", divmod(17, 5), [3, 2])
swapped_x = 1
swapped_y = 2
swapped_x, swapped_y = swapped_y, swapped_x
check("several values on the right are all evaluated first, so this swaps", [swapped_x, swapped_y], [2, 1])
