# the examples of wiki/mutable.md, each as the page writes it
use "check.wap"

greeting = "hello"
greeting += " world"
check("a variable's text grows with +=", greeting, "hello world")
greeting = "bye"
check("a variable takes another value", greeting, "bye")
const fixed = (1, 2, 3)
check("a const list is a list", fixed, [1, 2, 3])
