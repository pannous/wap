# lib/net.wap's words, as wiki/standard-library.md (net) shows them, against files curl reads by file:// URLs
use "check.wap"
use net
use file

answer_file(content: text): text := {
	path = temp_file()
	write(path, content)
	"file://" + path
}
check("fetch gives a JSON answer as data", fetch(answer_file("{\"name\": \"wap\", \"tags\": [1, 2]}")).json, "{\"name\":\"wap\",\"tags\":[1,2]}")
check("fetch gives any other answer as its text", fetch(answer_file("plain words\n")), "plain words")
check("fetch with headers gives the answer too", fetch(answer_file("[3]"), {"Accept": "application/json"}).json, "[3]")
check("a failed request raises curl's complaint", try { fetch("file:///nowhere/at/all") } catch e { e.message.contains("curl") }, yes)
