# the forms wiki/node.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

pair = data (x: 3)
check("a quoted pair's parts: key, value, operator and name", [pair.key, pair.value, pair.op, pair.name], data [x 3 ":" "x"])
call = data f(1, 2)
check("a quoted call keeps its bracket", call.bracket, "(")
commas = data [a, b]
check("a quoted list keeps its separator", commas.separator, ",")
check("a built list equals the written one: bracketed", bracketed([1, 2], "(") == (1, 2), yes)
check("a built list equals the written one: separated", separated([1, 2], ";") == [1; 2], yes)
