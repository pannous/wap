# wap's Node (wap/types/nodes.wap): warp's node built and taken apart in plain wap, its position and facts kept in a
# Meta, as wap's own stages read them
use "check.wap"

check("a symbol by its name", match symbol("x") { Symbol(name) => name; _ => "other" }, "x")
placed = positioned(Text("a"), 3, 7)
check("a node's position", "${line_of(placed)}:${column_of(placed)}", "3:7")
check("a node without a position", line_of(Text("a")) == ø, yes)
faceted = with_attribute(positioned(Symbol("x"), 2, 1), Text("f"))
check("a fact added keeps the position", "${#attributes_of(faceted)} ${line_of(faceted)}", "1 2")
check("a node shows its parts", show(List([Symbol("f"), Text("a")], Bracket.Round, Separator.Space)), 'List([Symbol("f"), Text("a")], Round, Space)')
a = symbol("a")
check("a node's text, as warp prints it", "${a} ${Key(a, Op.Colon, Number(1))} ${Key(symbol("f"), Op.None, List([a], Bracket.Round, Separator.Comma))} ${Key(a, Op.Add, a)} ${Key(a, Op.And, a)}", "a a: 1 f(a) a+a a and a")
check("a list node's text, as warp prints it", [text(List([Text("x"), Number(2.5)], Bracket.Square, Separator.Comma)), text(List([a, a], Bracket.Curly, Separator.Semicolon))], ['["x", 2.5]', "{a; a}"])
x = symbol("x")
check("two nodes are equal wherever they were written", [positioned(x, 4, 2) == x, [positioned(x, 1, 1)] == [x], Key(positioned(x, 2, 2), Op.Add, x) == Key(x, Op.Add, x), x == Text("x"), positioned(x, 1, 1) != symbol("y")], [yes, yes, yes, no, yes])
check("an empty node is no in a condition", [Empty, False, Number(0), Text(""), List([], Bracket.Square, Separator.Comma), Key(Text(""), Op.Colon, Number(0)), positioned(Number(0), 1, 1)].map(n => if n then "t" else "f").join(""), "fffffff")
check("any other node is yes in a condition", [True, a, Number(2), Text("x"), List([a], Bracket.Round, Separator.Space), Key(a, Op.Colon, Number(0))].map(n => if n then "t" else "f").join(""), "tttttt")
hi = positioned(Text("hi"), 1, 1)
check("a Node pattern looks through the Meta a node's position wraps it in", match hi { Text(t) => t; _ => "other" }, "hi")
check("a Meta pattern sees the Meta", match hi { Meta(inner, data) => "meta"; _ => "other" }, "meta")
