# wap's Node (wap/nodes.wap): warp's node built and taken apart in plain wap, its position and facts kept in a
# Meta, as wap's own stages read them
use "check.wap"

check("a symbol by its name", match symbol("x") { Symbol(name) => name; _ => "other" }, "x")
placed = positioned(Text("a"), 3, 7)
check("a node's position", "${line_of(placed)}:${column_of(placed)}", "3:7")
check("a node without a position", line_of(Text("a")) == ø, yes)
faceted = with_attribute(positioned(Symbol("x"), 2, 1), Text("f"))
check("a fact added keeps the position", "${#attributes_of(faceted)} ${line_of(faceted)}", "1 2")
check("a node shows its parts", show(List([Symbol("f"), Text("a")], Bracket.Round, Separator.Space)), 'List([Symbol("f"), Text("a")], Round, Space)')
a = symbol("a")
check("a node's text, as warp prints it", "${a} ${Key(a, Op.Colon, Number(1))} ${Key(symbol("f"), Op.None, List([a], Bracket.Round, Separator.Comma))} ${Key(a, Op.Add, a)} ${Key(a, Op.And, a)}", "a a: 1 f(a) a+a a and a")
check("a list node's text, as warp prints it: text(List([Text(\"x\"), Number(2.5)], Bracket.Square, Separator.Comma))", text(List([Text("x"), Number(2.5)], Bracket.Square, Separator.Comma)), '["x", 2.5]')
check("a list node's text, as warp prints it: text(List([a, a], Bracket.Curly, Separator.Semicolon))", text(List([a, a], Bracket.Curly, Separator.Semicolon)), "{a; a}")
x = symbol("x")
check("two nodes are equal wherever they were written: positioned(x, 4, 2) == x", positioned(x, 4, 2) == x, yes)
check("two nodes are equal wherever they were written: [positioned(x, 1, 1)] == [x]", [positioned(x, 1, 1)] == [x], yes)
check("two nodes are equal wherever they were written: Key(positioned(x, 2, 2), Op.Add, x) == Key(x, Op.Add, x)", Key(positioned(x, 2, 2), Op.Add, x) == Key(x, Op.Add, x), yes)
check("two nodes are equal wherever they were written: x == Text(\"x\")", x == Text("x"), no)
check("two nodes are equal wherever they were written: positioned(x, 1, 1) != symbol(\"y\")", positioned(x, 1, 1) != symbol("y"), yes)
# a node read as a condition, t for yes and f for no
condition_letter(n: Node) as text := if n then "t" else "f"
check("an empty node is no in a condition: Empty", condition_letter(Empty), "f")
check("an empty node is no in a condition: False", condition_letter(False), "f")
check("an empty node is no in a condition: Number(0)", condition_letter(Number(0)), "f")
check("an empty node is no in a condition: Text(\"\")", condition_letter(Text("")), "f")
check("an empty node is no in a condition: List([], Bracket.Square, Separator.Comma)", condition_letter(List([], Bracket.Square, Separator.Comma)), "f")
check("an empty node is no in a condition: Key(Text(\"\"), Op.Colon, Number(0))", condition_letter(Key(Text(""), Op.Colon, Number(0))), "f")
check("an empty node is no in a condition: positioned(Number(0), 1, 1)", condition_letter(positioned(Number(0), 1, 1)), "f")
check("any other node is yes in a condition: True", condition_letter(True), "t")
check("any other node is yes in a condition: a", condition_letter(a), "t")
check("any other node is yes in a condition: Number(2)", condition_letter(Number(2)), "t")
check("any other node is yes in a condition: Text(\"x\")", condition_letter(Text("x")), "t")
check("any other node is yes in a condition: List([a], Bracket.Round, Separator.Space)", condition_letter(List([a], Bracket.Round, Separator.Space)), "t")
check("any other node is yes in a condition: Key(a, Op.Colon, Number(0))", condition_letter(Key(a, Op.Colon, Number(0))), "t")
hi = positioned(Text("hi"), 1, 1)
check("a Node pattern looks through the Meta a node's position wraps it in", match hi { Text(t) => t; _ => "other" }, "hi")
check("a Meta pattern sees the Meta", match hi { Meta(inner, data) => "meta"; _ => "other" }, "meta")
# an enum's case where a Node is wanted is the Symbol of its text, its spelling or else its name (user decision
# wap-type-system 2026-11-21)
enum Grade { pass, fail = "✗" }
graded(n: Node): text := show(n)
grade = Grade.pass
check("an enum's case read as a Node is the Symbol of its text", "${graded(Grade.pass)} ${graded(Grade.fail)} ${graded(grade)}", "Symbol(\"pass\") Symbol(\"✗\") Symbol(\"pass\")")
