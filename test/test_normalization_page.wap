# the examples of wiki/Normalization.md: every spelling a table lists means what its canonical form means
use "check.wap"

check("int('123') is '123' as int", int('123'), '123' as int)
check("str(42) is text(42)", str(42), text(42))
check("float(2) is 2 as float", float(2), 2 as float)
check("65 as char", 65 as char, 'A')
check("x && y is x and y", yes && no, yes and no)
check("x || y is x or y", yes || no, yes or no)
check("x ** 2 is x ^ 2", 3 ** 2, 3 ^ 2)
check("x ? y : z is if x then y else z", (yes ? 1 : 2), if yes then 1 else 2)
check("s[0] is s#1", "abc"[0], "abc"#1)
