# the examples of wiki/null.md, with a typed optional
use "check.wap"

maybe_n: int? = ø
check("a missing optional is taken as no", if maybe_n then 1 else 2, 2)
check("if not tests a missing optional", if not maybe_n then 1 else 2, 1)
check("a missing optional is empty", maybe_n is empty, yes)
check("a missing optional is missing", maybe_n is missing, yes)
found: int? = 3
check("after if, the optional is surely there", if found then found! else 0, 3)
