# the forms wiki/null.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

unset: int? = ø
check("absent says empty", unset is absent, yes)
check("unknown says empty", unset is unknown, yes)
check("undefined says empty", unset is undefined, yes)
class contact { name: text; email: text? }
ann = contact("Ann")
check("an optional field left out is missing", if ann.email then 1 else 2, 2)
