# the examples of wiki/number.md, each as the page writes it
use "check.wap"

check("1/3 + 1/3 == 2/3", 1/3 + 1/3 == 2/3, yes)
x = 4
check("a number next to a name multiplies it: 3x", 3x, 12)
check("2.4.round", 2.4.round, 2)
check("{\"round\":7}.round", {"round":7}.round, 7)
check("-2.7 as int", -2.7 as int, -2)
check("0 - 3", 0 - 3, -3)
empty_counts: list<int> = []
check("#xs - 1 is -1 for an empty list", #empty_counts - 1, -1)
counted(xs: 3⋅int) := #xs
check("a number times a type is an array of that many items: 3⋅int", counted([1, 2, 3]), 3)

check("a decimal literal is a float", "${0.1 + 0.2}", "0.30000000000000004")
check("i64 wraps as the machine does", "${(9223372036854775807 as i64) + 1}", "-9223372036854775808")
small: i32 = 5
check("a whole numeral is an i32 where one is wanted", int(small) + 1, 6)
# `nat` is `int where it >= 0`, a numeral a nat where a nat is wanted, and a nat an int (wiki/number.md)
count: nat = 3
check("a nat holds a numeral and is an int", [count, count + 1], [3, 4])
