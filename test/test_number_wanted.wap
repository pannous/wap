# the forms wiki/number.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"
use uncertain

check("0.3̅ * 3", 0.3̅ * 3, 1)
check("text((1/3) as decimal)", text((1/3) as decimal), "0.3̅")
check("numerator(6/8)", numerator(6/8), 3)
check("denominator(-1/3)", denominator(-1/3), 3)
check("16.sqrt", 16.sqrt, 4)
check("0.1f + 0.2 ≈ 0.30000000000000004", 0.1f + 0.2 ≈ 0.30000000000000004, yes)
xs = [2^62]
check("text(xs#1 * 4)", text(xs#1 * 4), "18446744073709551616")
check("yes * 3", yes * 3, 3)
check("3 .* 3", 3 .* 3, 9)
check("⌊2.7⌋", ⌊2.7⌋, 2)
check("⌈2.2⌉", ⌈2.2⌉, 3)
x7: int = 7
x7 /= 2
check("x7", x7, 3)
check("try 1 / 0 else 7", try 1 / 0 else 7, 7)
check("10%", 10%, 1/10)
check("50 % of 200", 50 % of 200, 100)
check("one plus two", one plus two, 3)
check("2 ↑ 3", 2 ↑ 3, 8)
check("8 ↓ 2", 8 ↓ 2, 3)
check("3½", 3½, 3.5)
real_x = 2
check("text(real_x / 3)", text(real_x / 3), "0.6̅")
check("text((5 ± 1) + (2 ± 1))", text((5 ± 1) + (2 ± 1)), "7.0 ± 2.0")
check("type(3) is int", text(type(3)), "int")
big: int = 2^70
check("an int is unbounded: big: int = 2^70", text(big), "1180591620717411303424")
n: nat = 3
check("a numeral is a nat where a nat is wanted", n + 1, 4)
check("(9223372036854775807 as i64) + 1", (9223372036854775807 as i64) + 1, -9223372036854775808 as i64)

check("divisions of integers are exact", 1/10 + 2/10 == 3/10, yes)
check("an int's quotient is exact past a word, never a trap: the smallest word ÷ -1", "${(-9223372036854775807 - 1) ÷ -1}", "9223372036854775808")
# a sum that fits in one instance of a function and leaves the word in another stays exact in both
type small = int where it >= 0 and it <= 100
twice(x) := x + x
few: small = 3
check("an int sum is exact in every instance: twice of a small and of the largest word", "${twice(few)} ${twice(9223372036854775807)}", "6 18446744073709551614")
check("an int sum past the largest word is exact", text(9223372036854775807 + 1), "9223372036854775808")
nears = [-9223372036854775807]
check("an int near the smallest word sums and shows exactly", text(nears#1 - 1 + 5), "-9223372036854775803")
check("two whole numbers past 64 bits made two ways are equal", 2^64 == 2^32 * 2^32, yes)
check("a shift past 64 bits is exact", text(1 << 70), "1180591620717411303424")
near = -9223372036854775000
check("an int literal near the smallest word keeps its value", "${near + 0 == near} ${near}", "yes -9223372036854775000")
squares = 0
for i in 1 to 100 { squares += i * i }
check("a counted loop's sum of squares", squares, 338350)
last = 0
for i in 1 to 3 { i = i * 1099511627776; last = i * i }
check("a counter given a value in its loop's body is exact past 64 bits", text(last), "10880332376531662821752832")
