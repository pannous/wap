# Numbers written other ways (wiki/Footguns.md: `.5+1 → 1.5`; wiki/significant-whitespace.md: `2x` multiplies).
# Its own program: a refusal stops only these checks
use "check.wap"

check("a decimal without its leading zero", .5 + 1, 1.5)
x = 3
check("a number glued to a name multiplies it", 2x, 6)
