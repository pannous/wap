# Numerics, lib/numeric.wap (wiki/library-numeric.md): roots, integrals, interpolation, polynomials (constant first)
use numeric
use "check.wap"

check("the root of x² - 2 between 0 and 2, by bisection", root(x => x * x - 2, 0, 2), 1.4142135623724243)
check("the integral of x² from 0 to 3", integrate(x => x * x, 0, 3), 9.0)
check("the roots of 1 - 3x + 2x², ascending", poly_roots([1, -3, 2]), [0.5, 1.0])
check("a value between two points lies on their line", linear_interpolate([0, 10], [0, 100], 2.5), 25.0)
check("the line through three points on y = 1 + 2x", polyfit([0, 1, 2], [1, 3, 5], 1), [1.0, 2.0])
