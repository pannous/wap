# the examples of wiki/operator.md, each as the page writes it
use "check.wap"

square(x) := x*x
check("square 1 + 2", square 1 + 2, 9)
check("√4+5", √4+5, 7)
check("1 + 2 == 1 plus 2", 1 + 2 == 1 plus 2, yes)
infix operator ⊕ := left + right
check("2 ⊕ 3", 2 ⊕ 3, 5)
check("2^3^2", 2^3^2, 512)
a = b = 3
check("[a, b]", [a, b], [3, 3])
n1: int? = ø
n2: int? = ø
check("n1 ?? n2 ?? 7", n1 ?? n2 ?? 7, 7)
check("no ? 1 : yes ? 2 : 3", no ? 1 : yes ? 2 : 3, 2)
check("12 & 10", 12 & 10, 8)
check("12 | 10", 12 | 10, 14)
check("12 and 10", 12 and 10, 10)
infix operator divides(d:int, n:int) := n % d == 0
check("[3 divides 12, 5 divides 12]", [3 divides 12, 5 divides 12], [yes, no])
infix operator times := left * right
check("times", 3 times 4, 12)
infix operator ⇔(a: bool, b: bool) := a == b
check("(1 > 0) ⇔ (2 > 0)", (1 > 0) ⇔ (2 > 0), yes)
infix operator *(a: text, b: text) := 7
check("[\"a\" * \"b\", 2 * 3]", ["a" * "b", 2 * 3], [7, 6])
infix operator ⊗(a: int, b: int) := a * b + 1
cx = 2
cx ⊗= 3
check("cx", cx, 7)
prefix operator ⁻ := it*-1
check("⁻3", ⁻3, -3)
suffix operator ³ := it*it*it
check("2³", 2³, 8)
class Person3 { n: int }
+(a:Person3, b:Person3) := "married!"
check("Person3(1) + Person3(2)", Person3(1) + Person3(2), "married!")
