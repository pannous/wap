# the forms wiki/operator.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

check("{x:1 y:2} ≈ {y:2.0000000001 x:1}", {x:1 y:2} ≈ {y:2.0000000001 x:1}, yes)
check("yes ≈ 2", yes ≈ 2, yes)
check("2↑3", 2↑3, 8)
check("8↓2", 8↓2, 3)
check("log(1000, 10)", log(1000, 10), 3.0)
check("log([1, 100], 10)", log([1, 100], 10), [0.0, 2.0])
check("yes ⊼ yes", yes ⊼ yes, no)
check("yes & no", yes & no, no)
check("3²", 3², 9)
check("length of characters in \"hello\"", length of characters in "hello", 5)
class Person { name: text }
people = [Person("a"), Person("b")]
check("people.names", people.names, ["a", "b"])
class Person2 { name: text }
people2 = [Person2("a"), Person2("b")]
check("names of people2", names of people2, ["a", "b"])
