# a program's own operators (wiki/operator.md "A word can be an infix operator too"), compiled and run
use "check.wap"
use math

infix operator times(n: int, xs: list<int>) := (1 to n).flat_map(_ => xs)
check("a program's own infix word repeats a list", 3 times [1], [1, 1, 1])
# a glyph pair brackets its operand and calls its function; lib/math.wap declares the math ones (wiki/operator.md)
check("a circumfix operator: ‖-5‖+1", ‖-5‖+1, 6)
check("a circumfix operator: ⌊3.7⌋", ⌊3.7⌋, 3.0)
check("a circumfix operator: ⌈3.2⌉", ⌈3.2⌉, 4.0)
check("a circumfix operator: ⟦2.6⟧", ⟦2.6⟧, 3)
check("circumfix operators nest: ‖2 - ⌈7.5⌉‖", ‖2 - ⌈7.5⌉‖, 6.0)
doubled(n: int) := n * 2
circumfix operator ⟨ ⟩ := doubled
check("a program's own circumfix operator: ⟨3⟩ + 1", ⟨3⟩ + 1, 7)
# a sign glued after what ends an operand is the operator: x³+1 (wiki/operator.md)
suffix operator ³ := it * it * it
check("a sign glued after a suffix operator adds: 2³+1", 2³+1, 9)
