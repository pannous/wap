# the examples of wiki/optional.md, each as the page writes it
use "check.wap"

class car { name: text; year: int? }
beetle = car("vw", ø)
check("an optional field may be missing", if beetle.year then 1 else 2, 2)
parsed = "12" as int?
check("parsing as an optional gives the number when it parses", if parsed then parsed! else 0, 12)
unparsed = "x" as int?
check("parsing as an optional gives a missing number when it does not", if no unparsed then 1 else 2, 1)
widened = 3 as float?
check("a value as an optional type converts as plain as does: 3 as float?", if widened then widened! else 0.0, 3.0)
# a function value converts into an optional of its function type as into the function type (wiki/optional.md, wiki/lambda.md)
class Hook { answer: ((int) -> int)? = ø }
hook = Hook()
hook.answer = (n: int) => n + 1
check("a lambda assigned straight to an optional function field is that function", (hook.answer!)(2), 3)
