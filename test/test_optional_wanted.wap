# the forms wiki/optional.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

def half(x: int) as int { if x < 0 { return ø }; x / 2 }
check("a plain result type that can answer ø is read as optional, with a warning", half(-1) is missing, yes)
parsed = "12" as int?
check("parsing as an optional gives the number when it parses", if parsed then parsed! else 0, 12)
unparsed = "x" as int?
check("parsing as an optional gives a missing number when it does not", if no unparsed then 1 else 2, 1)
