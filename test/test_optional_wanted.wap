# the forms wiki/optional.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

def half(x: int) as int { if x < 0 { return ø }; x / 2 }
check("a plain result type that can answer ø is read as optional, with a warning", half(-1) is missing, yes)

# a function value converts into an optional of its function type as into the function type (wiki/optional.md, wiki/lambda.md)
class Hook { answer: ((int) -> int)? = ø }
hook = Hook()
hook.answer = (n: int) => n + 1
check("a lambda assigned straight to an optional function field is that function", hook.answer!(2), 3)
