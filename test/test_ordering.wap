# texts in natural order, lib/ordering.wap (its header)
use ordering
use "check.wap"

check("digit runs compare as numbers", natural_sort(["a10", "a2", "a1", "b", "a02"]), ["a1", "a2", "a02", "a10", "b"])
check("a text as its runs", natural_runs("a10b"), ["a", "10", "b"])
check("equal texts, and a shorter text first", [natural_compare("x7", "x7"), natural_compare("x", "x7")], [0, -1])
