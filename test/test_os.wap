# lib/os.wap's words, as wiki/script.md and wiki/standard-library.md (os) show them
use "check.wap"
use os

check("command gives what a sh line printed", command("echo hi | tr h H"), "Hi")
check("run gives a failing command's exit status", run(["sh", "-c", "exit 3"]).status, 3)
check("run keeps each word whole, quotes and spaces too", run(["printf", "%s", "it's a b"]).out, "it's a b")
check("run gives what a command said on stderr", run(["sh", "-c", "echo no >&2"]).err, "no")
check("exec gives what the command printed", exec(["echo", "x  y"]), "x  y")
check("a failing command raises its status", try { command("exit 2") } catch e { e.message.starts_with("sh -c exit 2 failed (exit status: 2)") }, yes)
check("setenv sets what env reads", setenv("WAP_OS_CHECK", "fast") and env("WAP_OS_CHECK") == "fast", yes)
check("the commands a program runs see what setenv set", command("echo $WAP_OS_CHECK"), "fast")
check("an unset variable is missing", env("WAP_OS_CHECK_UNSET") ?? "none", "none")
check("cd changes the folder commands start in", [cd("/"), cwd(), command("pwd")].join(" "), "/ / /")
