# Packed notation (wap/extensions/packed.wap; wap#42, decision wap-packed-library): a node packed to bytes unpacks to
# the same node, its positions and comments along, a repeated subtree written once
use "check.wap"
use "../wap/extensions/packed.wap"
use "../wap/core/parse/reader.wap"

again(n: Node) as Node := unpack(pack(n))
code = "rule $from .. $end => Range($from, $end - 1)  // a range stops before its end\nx: [3, -200, 2.5, 'é', \"ab\", yes, ø]"
read_code = notation(code, "ranges.wap")
check("a program's notation unpacks as it was read", again(read_code) == read_code, yes)
second_line = match again(read_code) { List(lines, bracket, separator) => line_of(lines#2); _ => ø }
check("its positions come along", second_line, 2)
check("each kind of atom comes back", text(again(List([Number(3), Number(-200), Number(2.5), Char('é'), Text("ab"), Symbol("ab"), True, False, Empty], Bracket.Square, Separator.Comma))), "[3, -200, 2.5, \"é\", \"ab\", ab, yes, no, ø]")
repeated = Key(Symbol("long_name"), Op.Colon, Text("long text"))
check("a repeated subtree is written once", byte_count(pack(List([repeated, repeated, repeated], Bracket.Square, Separator.Comma))) < 2 * byte_count(pack(repeated)), yes)
