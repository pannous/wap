# Paths, lib/path.wap (wiki/library-path.md): file paths as text, POSIX style, nothing touches the disk
use path
use "check.wap"

check("two parts joined by one slash", path_join("docs", "intro.md"), "docs/intro.md")
check("the folder of a path", dirname("/usr/local/bin/wap"), "/usr/local/bin")
check("the name without its last extension", stem("archive.tar.gz"), "archive.tar")
check("the last extension, its dot included", extension("archive.tar.gz"), ".gz")
check("dots and the part a .. takes back dropped", normalize_path("a/./b/../c"), "a/c")
check("the way from one folder to another", relative_path("/a/b/c", "/a/d"), "../../d")
check("** crosses folders, * stays within a name", glob_match("src/**/*.wap", "src/lib/math.wap"), yes)
