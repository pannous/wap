# the examples of wiki/pattern-matching.md, each as the page writes it
use "check.wap"

check("match [\"\", \"x\", \"\"] { [\"\", middle, \"\"] => middle + \"!\"; _ => \"never mind\" }", match ["", "x", ""] { ["", middle, ""] => middle + "!"; _ => "never mind" }, "x!")
check("match (1, 2) { (1, t) => t; _ => 0 }", match (1, 2) { (1, t) => t; _ => 0 }, 2)
check("match (3, 4) { (a, b) => a + b }", match (3, 4) { (a, b) => a + b }, 7)
check("match [3, \"b\"] { [int, x] => x; _ => \"no\" }", match [3, "b"] { [int, x] => x; _ => "no" }, "b")
xs = [1, 2]
check("match xs { [a, b] => xs.length }", match xs { [a, b] => xs.length }, 2)
check("match \"bob\" { \"alice\" => \"hi Al\"; name => \"hi \" + name }", match "bob" { "alice" => "hi Al"; name => "hi " + name }, "hi bob")
check("match [1, 2, 3] { [.., last] => last }", match [1, 2, 3] { [.., last] => last }, 3)
