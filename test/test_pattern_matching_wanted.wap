# the forms wiki/pattern-matching.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

check("match [1, [2, [3]]] { [outer, [middle, [inner]]] => outer + middle + inner; _ => 0 }", match [1, [2, [3]]] { [outer, [middle, [inner]]] => outer + middle + inner; _ => 0 }, 6)
total(xs) := match xs { [] => 0; [first, ...rest] => first + total(rest) }
check("total([1, 2, 3])", total([1, 2, 3]), 6)
response = {status: 200, data: {user: {name: "Ann"}}}
check("match response { {status: 200, data: {user: {name}}} => name; _ => \"?\" }", match response { {status: 200, data: {user: {name}}} => name; _ => "?" }, "Ann")
check("match \"/users/7\" { \"/users/\" + id: int => id + 1000; _ => 0 }", match "/users/7" { "/users/" + id: int => id + 1000; _ => 0 }, 1007)
check("\"v12\" is \"v\" + n", "v12" is "v" + n, yes)
check("match \"v12\" { \"v\" + n: digits => n; _ => \"no\" }", match "v12" { "v" + n: digits => n; _ => "no" }, "12")
check("match 19 { 13..20 => \"teen\"; _ => \"other\" }", match 19 { 13..20 => "teen"; _ => "other" }, "teen")
check("match 20 { 13..20 => \"teen\"; _ => \"other\" }", match 20 { 13..20 => "teen"; _ => "other" }, "other")
class Point{x:int; y:int}
p = Point(3, 4)
check("match p { Point{x, ..} => x }", match p { Point{x, ..} => x }, 3)
enum Shape { Circle(r), Dot }
area(s) := match s { Circle(r) => r * r; Dot => 0 }
check("area(Circle(2))", area(Circle(2)), 4)
xs = [1, 2]
check("xs is [_, 2]", xs is [_, 2], yes)
check("if xs is [a, b] then b else 0", if xs is [a, b] then b else 0, 2)
check("match [4, 5, 6] { [a, ...rest] => value.length }", match [4, 5, 6] { [a, ...rest] => value.length }, 3)
check("match all = [4, 5] { [a, b] => all.length }", match all = [4, 5] { [a, b] => all.length }, 2)
pattern Pair = [_, _]
check("[1, 2] is Pair", [1, 2] is Pair, yes)
pattern Tagged = ["tag", $label, ..]
check("match [\"tag\", \"red\", 1] { Tagged => label; _ => \"none\" }", match ["tag", "red", 1] { Tagged => label; _ => "none" }, "red")
pattern Pair4 = [$a: int, $b: int]
area4(r: Pair4) := r.a * r.b
check("area4([3, 4])", area4([3, 4]), 12)
pattern Adult = {age: >= 18}
check("{age: 20} is Adult", {age: 20} is Adult, yes)
check("match {age: 30} { {age: 18..65} => \"working age\"; _ => \"?\" }", match {age: 30} { {age: 18..65} => "working age"; _ => "?" }, "working age")
check("match {code: 302} { {code: 301 | 302} => \"moved\"; _ => \"other\" }", match {code: 302} { {code: 301 | 302} => "moved"; _ => "other" }, "moved")
pattern Config = {port: int, host: text, debug?: bool}
check("json('{\"port\": 8080, \"host\": \"localhost\"}') is Config", json('{"port": 8080, "host": "localhost"}') is Config, yes)
pattern Config2 = {port: int, host: text, debug?: bool}
check("{port: \"80\", host: \"x\"} is Config2", {port: "80", host: "x"} is Config2, no)
page = {top: {logo: {type: "image", src: "logo.png"}}, body: [{type: "text"}, {type: "image", src: "cat.jpg"}]}
check("page find {type: \"image\", src}", page find {type: "image", src}, ["logo.png", "cat.jpg"])
check("[[1, 2], [3, [1, 5]]] find [1, x]", [[1, 2], [3, [1, 5]]] find [1, x], [2, 5])
check("[[1, 2], [3, [1, 5]]] replace [1, x] with x", [[1, 2], [3, [1, 5]]] replace [1, x] with x, [2, [3, 5]])
simplify(code) := match code { data($a + 0) => a; data($a * 1) => a; _ => code }
check("simplify(data(n * 1))", simplify(data(n * 1)), data(n))
add_pair([a, b]) := a + b
check("add_pair([3, 4])", add_pair([3, 4]), 7)
class Point5{x:int; y:int}
total5(Point5{x, y}) := x + y
check("total5(Point5(2, 5))", total5(Point5(2, 5)), 7)
fib(0) := 0
fib(1) := 1
fib(n) := fib(n - 1) + fib(n - 2)
check("fib(10)", fib(10), 55)

class Disc{r: int}
disc_area(s) := match s { Disc{r} => r * r; _ => 0 }
check("a declared class matches by its fields", disc_area(Disc(3)), 9)

twice(k: int): int := 2 * k
twice⁻¹(n: int): int? := if n % 2 == 0 then n ÷ 2
half(n: int): int := match n { twice(k) => k; _ => 0 }
check("a pattern names a function with an inverse, fitting where the inverse gives a value", [half(10), half(7)], [5, 0])
