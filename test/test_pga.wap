# the standard module pga, lib/pga.wap: the forms wiki/3d.md "Algebra" shows
use "check.wap"
use pga

check("the meet of two planes is their line", meet(plane(0, 1, 0, 0), plane(0, 0, 1, 0)) == join(point(0, 0, 0), point(1, 0, 0)), yes)
mirror = plane(1, 0, 0, 0)
check("a point reflected in a plane twice is the point again", mirror.reflect(mirror.reflect(point(1, 2, 3))) == point(1, 2, 3), yes)
check("a rotor by a right angle around the z-axis turns (1, 0, 0) into (0, 1, 0)", [round(c) for c in coordinates(rotor(pi / 2, 0, 0, 1).apply(point(1, 0, 0)))], [0, 1, 0])
check("a point is written as it is built from the origin and the directions", point(1, 2, 3) == origin + ẋ + 2 * ẏ + 3 * ż, yes)
check("⋏ is meet", e1 ⋏ e2 == e12, yes)
