# the examples of wiki/3d.md "Algebra": use pga, points, lines and planes of space as Multivectors
use "check.wap"
use pga

check("the meet of two planes is their line", meet(plane(0, 1, 0, 0), plane(0, 0, 1, 0)) == join(point(0, 0, 0), point(1, 0, 0)), yes)
check("a point reflected in a plane twice is the point again", plane(1, 0, 0, 0).reflect(plane(1, 0, 0, 0).reflect(point(1, 2, 3))) == point(1, 2, 3), yes)
check("a right turn around z turns x into y", [round(c) for c in coordinates(rotor(pi / 2, 0, 0, 1).apply(point(1, 0, 0)))], [0, 1, 0])
check("a point is written as it is built", point(1, 2, 3) == origin + ẋ + 2 * ẏ + 3 * ż, yes)
check("e1 meets e2 in e12", e1 ⋏ e2 == e12, yes)
