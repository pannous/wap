# the forms wiki/pipe.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

check("piping into the library words: 2|square|root is root(square(2))", 2|square|root, 2.0)
squared(x) := x * x
plus_one(x) := x + 1
check("(f|g)(x) is g(f(x))", (squared|plus_one)(3), 10)
