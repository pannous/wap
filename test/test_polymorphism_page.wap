# the examples of wiki/polymorphism.md, each as the page writes it
use "check.wap"

foo(x:int) := x + x
foo(x:text) := x.length
foo(x:any) := 1
check("a call picks the variant its argument's type fits: foo(3)", foo(3), 6)
check("a call picks the variant its argument's type fits: foo(\"abc\")", foo("abc"), 3)
check("the any variant takes every other value", foo(2.5), 1)
random = 4
check("a variable in scope is the most specific meaning of a word", random, 4)
check("a map's own entry comes before a library word", {first: 1}.first, 1)
