# the forms wiki/polymorphism.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

class pdf{body: text}
class docx{body: text}
render(t: text) as pdf := pdf("%PDF " + t)
render(t: text) as docx := docx("<w:t>" + t)
rendered = (render "hello") as pdf
check("the type the caller expects picks the variant: as pdf", rendered.body, "%PDF hello")
example: docx = render "hello MS"
check("the type the caller expects picks the variant: a declared variable", example.body, "<w:t>hello MS")
