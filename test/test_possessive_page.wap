# the examples of wiki/possessive.md, each as the page writes it
use "check.wap"

person = {name: "Joe", number: 12345}
check("a property read with a dot", person.name, "Joe")
check("a property read by index", person["name"], "Joe")
class Person { name: text; number: int }
field = "name"
check("a key computed at run time reads a class value's field, as an any", Person("Joe", 12345)[field], "Joe")
# a word for any record, field by field: its field names, each read by its key (wiki/reflection.md)
class Visit { place: text; days: int }
class Spot { x: int; y: int }
described(r: T): text := r.fields.map(field => "${field}=${show(r[field])}").join(", ")
check("a generic word reads any record by its fields", [described(Visit("Rome", 3)), described(Spot(3, 4))], ["place=\"Rome\", days=3", "x=3, y=4"])
