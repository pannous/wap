# the examples of wiki/possessive.md, each as the page writes it
use "check.wap"

person = {name: "Joe", number: 12345}
check("a property read with a dot", person.name, "Joe")
check("a property read by index", person["name"], "Joe")
class Person { name: text; number: int }
field = "name"
check("a key computed at run time reads a class value's field, as an any", Person("Joe", 12345)[field], "Joe")
