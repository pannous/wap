# the examples of wiki/precedence.md, each as the page writes it
use "check.wap"

square(x) := x * x
check("a function's argument after a blank takes the whole expression: square 3 * 3", square 3 * 3, 81)
squared_nine = square 3 * 3
check("the argument reaches up to =", squared_nine, 81)
check("brackets give the other reading", (square 3) * 3, 27)
