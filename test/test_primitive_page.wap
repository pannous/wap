# the primitives wiki/primitive.md names, int32 and float32, kept in lists and shown as the numbers they hold
use "check.wap"

whole: list<int32> = [int32(1), int32(-2)]
check("a list<int32> shows its items", text(whole), "[1, -2]")
halves: list<float32> = [float32(0.5), float32(1.25)]
check("a list<float32> shows its items", text(halves), "[0.5, 1.25]")
class Frame { xs: list<float32> }
check("a class with a list<float32> field is shown", text(Frame(halves)), "Frame{xs: [0.5, 1.25]}")
