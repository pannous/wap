# lib/process.wap's run, as wiki/standard-library.md (process) shows it
use "check.wap"
use process

ran = run(["sh", "-c", "echo hi; echo no >&2; exit 3"])
check("run gives a program's status, output and errors", "${ran.status} ${ran.out} ${ran.err}", "3 hi no")
check("run keeps each word whole, quotes and spaces too", run(["printf", "%s", "it's a b"]).out, "it's a b")
check("merged: puts stderr into out, in the order said", run(["sh", "-c", "echo a; echo b >&2; echo c"], merged: yes).out, "a\nb\nc")
check("input: is what the program reads on its standard input", run(["tr", "a-z", "A-Z"], input: "shout\n").out, "SHOUT")
check("folder: names the folder the program starts in", run(["pwd"], folder: "/").out, "/")
check("a program killed by a signal has 128 + the signal", run(["sh", "-c", "kill -9 $$"]).status, 137)
check("seconds: stops a program past its cap and raises", try { run(["sleep", "5"], seconds: 1).status } catch e { e.message }, "run: sleep 5 stopped after 1 seconds")
check("a program no folder of the PATH has raises", try { run(["no-such-program-anywhere"]).status } catch e { e.message }, "run: cannot start no-such-program-anywhere")
