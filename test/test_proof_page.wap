# the examples of wiki/proof.md and wiki/enum.md "The recursor" that wap builds, each as the pages write them
use "check.wap"

enum nat { zero, successor(n: nat) }
double(n: nat): int := match n { zero => 0; successor(k) => double(k) + 2 }
check("a match over an enum, the recursion a proof by induction is", double(successor(successor(successor(zero)))), 6)
