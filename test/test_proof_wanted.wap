# the forms wiki/proof.md and wiki/enum.md "The recursor" show that wap does not build yet: each red line is a to-do,
# fixed by building the form
use "check.wap"

double(n: nat): nat := match n { zero => 0; successor(k) => double(k) + 2 }
law double(n) == n + n
enum Even: nat -> Prop { zero: Even(0), step(e: Even(n)): Even(n + 2) }
law double_even(n: nat): Even(double(n)) :=
	match n { zero => Even.zero; successor(k) => Even.step(double_even(k)) }
check("a law's proof is a function giving a proof for each value", type of double_even(3), Even(6))
law double_three: double(3) == 6 := refl
law add_zero(a: int): a + 0 == a
law add_commutes(a: int, b: int): a + b == b + a
law swap(a: int, b: int): a + b + 0 == b + a := by add_zero, add_commutes
law swap_steps(a: int, b: int): a + b + 0 == b + a := chain
	a + b + 0
	== a + b       by add_zero
	== b + a       by add_commutes
check("a proved law is used by calling it", type of add_commutes(1, 2), (1 + 2 == 2 + 1))
law hard(n: nat): n * n >= n := assume
check("axioms of a law proved without any", axioms of double_even, [])
check("axioms of an assumed law", axioms of hard, [hard])
check("a recursor computes like the match it makes", nat.recursor(0, (k, double_k) => double_k + 2, 3), 6)
recursive_double(n: nat): nat := nat.recursor(0, (k, double_k) => double_k + 2, n)
check("a function by its recursor", recursive_double(3), 6)
divided(a: int, b: int, nonzero: b != 0 = by): int := a ÷ b
seven_halved(): int := divided(7, 2)
check("a call leaves a parameter's proof to the provers, at the arguments before it", seven_halved(), 3)
seven_by(b: int): int := divided(7, b)
check("a call's proof the provers cannot give is checked when the program runs", seven_by(2), 3)
first_of(xs: list<T>, nonempty: #xs > 0 = by): T := xs#1
first_three(): int := first_of([3, 4])
check("a generic function's call leaves its proof to the provers as any call does", first_three(), 3)
type vector(T, n: nat) = list<T> where #it == n
at_index(xs: vector(int, n), i: int, inside: i < n = by): int := xs#i
second_of_three(): int := at_index([5, 6, 7], 2)
check("a call's proof may name a letter its arguments' types give", second_of_three(), 6)
