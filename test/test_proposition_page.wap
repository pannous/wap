# the examples of wiki/proposition.md that wap builds, each as the page writes it
use "check.wap"

check("a comparison in a bool place is decided", 1 < 2 and 2 < 3, yes)
# the table's `A implies B`: a proof of it is a function from proofs of A to proofs of B
law self_implied(a: Prop): a implies a := (h: a) => h
check("a implies b between propositions is proved by a function from a's proofs to b's", type of self_implied(True), (True implies True))
