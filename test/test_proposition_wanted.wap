# the forms wiki/proposition.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

check("an equation is a proposition", type of (2 + 2 == 4), Prop)
check("a false equation is a proposition too", type of (2 + 2 == 5), Prop)
law four: 2 + 2 == 4 := refl
law both: 1 < 2 and 2 < 3
law some_sum: exists n: nat where n + n == 4
law doubled:
  for n: nat
  n + n == 2 * n
law doubled_again(n: nat): n + n == 2 * n
check("laws stated beside a program leave it running", 4, 4)
enum Even: nat -> Prop { zero: Even(0), step(e: Even(n)): Even(n + 2) }
law four_is_even: Even(4) := Even.step(Even.step(Even.zero))
check("an enum of proofs proves its cases", type of four_is_even, Even(4))
check("True has its proof", type of True.intro, True)
check("a statement over every n is a proposition", type of ((n: nat) -> n + n == 2 * n), Prop)
# a function type's result reads its parameter (wiki/type.md "Functions")
check("a function type whose result names its parameter is a type", type of ((n: nat) -> vector(int, n)), Type)
