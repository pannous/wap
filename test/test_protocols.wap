# wap's protocols (wiki/trait.md): `trait shape { area(); scaled(by) }` names what a value can do, a class of required
# words, members without a body; a class fits it by having each word, and claims it by `class pet: named {…}`
use "check.wap"

trait movable { scaled(by); moved(x: int, y: int) }
check("a trait declared beside a program", "ok", "ok")
trait sized { area(); scaled(by) }
check("a trait word without parameters", "ok", "ok")

trait shape { area() }
class square { side: int }
area(s: square) := s.side * s.side
class rect { w: int
h: int
}
area(r: rect) := r.w * r.h
total(a: shape, b: shape) := area(a) + area(b)
check("a class fits a protocol by having its words, each call the given class's own", total(square(1), rect(2, 3)), 7)
trait named { name(): text }
class pet: named { called: text }
name(p: pet) := p.called
greeting(n: named) := "hi " + name(n)
check("a class claims a protocol it has the words of", greeting(pet("Rex")), "hi Rex")
trait growing { grown(by: int) }
class plant { height: int }
grown(p: plant, by: int) := plant(p.height + by)
tallest(g: growing) := grown(grown(g, 1), 2)
check("a function of a protocol is typed for each class given, a word's result the class's own", tallest(plant(1)).height, 4)
class counter { n: int; bump: (counter) -> counter }
check("a class with a field of a function taking it is a plain class", counter(2, c => c).n, 2)
trait measured { size(): int := 5; scaled(by) }
class tile { side: int }
scaled(t: tile, by) := t.side * by
class slab { side: int }
scaled(s: slab, by) := s.side
size(s: slab) := 100
measure(m: measured) := size(m) + scaled(m, 2)
check("a protocol's default body is the word of a class without its own", measure(tile(3)), 11)
check("a class's own word replaces the protocol's default", measure(slab(3)), 103)
rule tagged $name => @protocol Record($name, [area: (($name) -> int)], [])
@final tagged boxy
area(t: tile) := t.side * 2
boxed_area(b: boxy) := area(b)
check("an annotated phrase a rule writes as an annotated record keeps the rule's annotation", boxed_area(tile(2)), 4)
