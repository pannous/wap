# the examples of wiki/quotient.md that wap builds, each as the page writes it
use "check.wap"

class fraction {top: int; bottom: int}
same_value(a: fraction, b: fraction) := a.top * b.bottom == b.top * a.bottom
check("a relation joins two fractions of one value", same_value(fraction(1, 2), fraction(2, 4)), yes)

