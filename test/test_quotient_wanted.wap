# the forms wiki/quotient.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

class fraction { top: int; bottom: int where it != 0 }
same_value(a: fraction, b: fraction) := a.top * b.bottom == b.top * a.bottom
type rational = quotient(fraction, same_value)
half: rational = fraction(1, 2)
check("values the relation joins are equal", half == fraction(2, 4), yes)
check("quotient.of makes a value of the quotient", quotient.of(fraction(1, 2)) == half, yes)
sign(q: rational): int := q.lift(f => sign(f.top * f.bottom))
check("a lifted function gives one answer for joined values", [sign(half), sign(fraction(-2, 4))], [1, -1])
law lift_of(a: fraction): quotient.of(a).lift(f => sign(f.top * f.bottom)) == sign(a.top * a.bottom) := refl
check("a set is a list up to order and repeats", set([1, 2, 2]) == set([2, 1]), yes)
check("i64 wraps around", (9223372036854775807 as i64) + 1, -9223372036854775808 as i64)
add_one(n: int) := n + 1
one_more(n: int) := 1 + n
law add_commutes(a: int, b: int): a + b == b + a
law same: add_one == one_more := function_extensionality(n => add_commutes(n, 1))
check("functions equal for every argument are equal", axioms of function_extensionality, [quotient_sound])
law joined_values(a: fraction, b: fraction, h: same_value(a, b)): (quotient.of(a) as rational) == quotient.of(b) := quotient_sound(a, b, joined(same_value), h)
check("a bool relation's quotient is the one its joined proposition makes", axioms of joined_values, [quotient_sound])
