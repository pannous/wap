# lib/R.wap's words for programs ported from R (wiki/standard-library.md R)
use "check.wap"
use R

check("sapply maps a function over a list", sapply([1, 2, 3], x => x * 2), [2, 4, 6])
check("lapply maps too", lapply(["a", "b"], t => t + "!"), ["a!", "b!"])
check("c of a list is the list", c([4, 5]), [4, 5])
