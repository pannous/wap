# Random numbers, lib/random.wap (wiki/random.md, wiki/standard-library.md "random"): splitmix64's numbers, a seed
# repeating a run, the ranges, shuffles and samples
use random
use "check.wap"

rng = Random(seed: 1234567)
check("splitmix64's numbers", "${rng.next()} ${rng.next()}", "6457827717110365317 3203168211198807973")
seed(42)
first = [random_below(100), random_below(100)]
seed(42)
check("the same numbers after the same seed", [random_below(100), random_below(100)], first)
check("the draws vary", (0 upto 20).map(i => random_below(1000)).unique().count > 10, yes)
draws = (0 upto 200).map(i => random())
check("random() lies from 0 up to 1", draws.all(x => x >= 0 and x < 1), yes)
rolls = (0 upto 200).map(i => random(1, 6))
check("a die roll is 1 to 6, both ends included", "${rolls.all(r => r >= 1 and r <= 6)} ${rolls.contains(1)} ${rolls.contains(6)}", "yes yes yes")
check("random(a, b) of fractions lies from a up to b", (0 upto 50).map(i => random(2.5, 3.5)).all(x => x >= 2.5 and x < 3.5), yes)
check("a shuffle keeps the items", shuffle([1, 2, 3, 4, 5]).sorted(), [1, 2, 3, 4, 5])
check("a sample takes k different items", "${sample([1, 2, 3, 4, 5], 3).unique().count} ${sample([1, 2, 3], 5).sorted()}", "3 [1, 2, 3]")
check("a choice is one of the items", [10, 20, 30].contains(choice([10, 20, 30])), yes)
check("a zero weight is never drawn", (0 upto 50).map(i => weighted_choice([1, 2], [0.0, 1.0])).all(x => x == 2), yes)
secret = random_bytes(16)
check("random_bytes(n) gives n bytes of the host's randomness, new each time", [#secret, secret.all(b => b >= 0 and b < 256), random_bytes(16) != secret], [16, yes, yes])
