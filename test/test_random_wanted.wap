# the forms wiki/random.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"
use random

check("random of a list picks an item", random of [7, 7], 7)
check("random bool is a bool", random bool is bool, yes)
check("random of a range picks from it", random 1..2, 1)
