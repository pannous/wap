# the examples of wiki/range.md, each as the page writes it
use "check.wap"

check("1…5 includes 5", #(1…5), 5)
check("1...5 includes its end too", #(1...5), 5)
check("1..5 excludes 5", #(1..5), 4)
summed = 0
for i in 1…5 { summed += i }
check("a loop over 1…5", summed, 15)

check("list of a range lists its items", list(1..5), [1, 2, 3, 4])
check("sum of a range adds its items", sum(1..5), 10)
