# wap's ranges (wiki/range.md, wiki/keyword.md for): `a to b` includes b, `a .. b` stops before it; both are the
# preload's Range
use "check.wap"

closed = 2 to 5
check("a range includes its end", closed.last, 5)
open = 1 .. 4
check("upto stops before its end", open.last, 3)
dotted = 3…7
check("a range's ends in its other spelling", dotted.last - dotted.from, 4)
worded = 1 upto 4
check("upto in words stops before its end", worded.last, 3)
xs = [1, 2, 3, 4]
check("a range as an item key slices, open on either side", [xs[2 ..], xs[.. 2], xs[1 .. 3]], [[3, 4], [1, 2], [2, 3]])
check("a range mapped, each int's result in order", text((0 upto 3).map(at => at * 2)) + " " + text((0 upto 3).map(at => at * 2)#2), "[0, 2, 4] 2")
listed: list<int> = 1 to 3
base = 10
check("a range is a list of its numbers wherever a list is wanted", text(listed) + " " + text((1 to 3).flat_map(at => [at + base])) + " " + text((1 to 3).filter(n => n > 1)), "[1, 2, 3] [11, 12, 13] [2, 3]")
