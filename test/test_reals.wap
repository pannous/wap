# exact reals, lib/reals.wap (wiki/Footguns.md: Exact real numbers)
use reals
use "check.wap"

two = real(2)
three = real(3)
check("roots multiply exactly", √two * √two == 2, yes)
check("a root's square factors come out", text(√real(8)), "2√2")
check("a perfect square's root is whole", text(√real(9)), "3")
check("π's multiples and fractions print as written", "${exact_pi / 2} ${2 * exact_pi} ${3 * exact_pi / 4} ${exact_tau}", "π/2 2π 3π/4 2π")
check("negative powers of π stand below the line", "${3 / exact_pi} ${√two / exact_pi} ${exact_pi ^ -2}", "3/π √2/π 1/π²")
check("roots of π", "${√exact_pi} ${√(2 * exact_pi)} ${√exact_pi ^ 2}", "√π √(2π) π")
check("the root rises above the fraction line", text(1 / √two), "√2/2")
check("unlike terms stay a sum, the rational first", "${exact_pi + 2} ${√two - exact_pi / 2}", "2 + π √2 - π/2")
check("a sum multiplies term by term", text((√two + √three) ^ 2), "5 + 2√6")
check("alike terms merge, a zero sum is 0", "${exact_pi + exact_pi} ${(1 + exact_pi) - (exact_pi + 1)}", "2π 0")
check("comparing by value", [exact_pi > real(3), exact_pi < 355 / real(113), √two < 3 / real(2)], [yes, yes, yes])
check("as a float", float(exact_tau), 6.283185307179586)
check("digits are exact", digits(exact_pi, 30), "3.14159265358979323846264338328")
check("digits of a root and of a sum", "${digits(√two, 20)} ${digits(exact_pi + √two, 10)}", "1.4142135623730950488 4.555806216")
check("sin and cos of half turns are exact", "${sin(exact_pi)} ${cos(exact_pi)} ${sin(exact_pi / 2)} ${cos(3 * exact_pi / 2)}", "0 -1 1 0")
