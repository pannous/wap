# wap's records (wap/kernel/forms.wap Record; wiki/class.md): `class Point { x: int; y: int }` declares a type, its
# constructor Point(x, y) builds an instance, `p.x` reads a field and `p.x = 5` sets it
use "check.wap"

class Point { x: int; y: int }
p = Point(1, 2)
check("an instance's fields", p.x + p.y, 3)
written = Point{x: 3, y: 4}
check("an instance written as data", written.y, 4)
moved = Point(1, 2)
moved.x = 5
check("a field set anew", moved.x, 5)
class Person { name: text }
check("a text field", Person("ann").name, "ann")
sum(p: Point): int := p.x + p.y
check("an instance given to a function", sum(Point(2, 5)), 7)
class Box { w: int; h: int; area() := self.w * self.h }
b = Box(2, 3)
check("a method reads its instance through self", b.area(), 6)
class Scaled { w: int; h: int; scaled(k: int) := self.w * k }
check("a method's parameters follow self", Scaled(2, 3).scaled(10), 20)
check("a method without parentheses is called too", b.area, 6)
class Counter { c: int
inc() := { c = c + 1; c }
}
fresh = Counter(4).inc()
k = Counter(1)
k.inc()
k.inc()
class Bare { w: int
h: int
area() := w * h
scaled(w) := w * h
}
bare = Bare(2, 3)
check("a method reads and sets its receiver's fields by their bare names, a parameter hiding one", [fresh, k.c, bare.area(), bare.scaled(10)], [5, 3, 6, 30])
class P { x: int }
check("a class of one field", P(3).x, 3)
class Q { p: P; name: text }
check("an instance shows itself in its constructor form", show(Q(P(1), "a")), 'Q{p: P{x: 1}, name: "a"}')
class G { names: map<text, int> }
g = G({"a": 1})
g.names["b"] = 2
class H { xs: list<int> }
h = H([5, 6])
h.xs[0] = 7
check("a field's item read and set through the dot", [g.names["a"] + g.names["b"], h.xs[0] + h.xs[1]], [3, 13])
class Item { n: int }
class Holder { item: Item? = ø }
holder = Holder(Item(1))
holder.item = ø
check("a field of a class type takes ø", holder.item == ø, yes)
class Linked { n: int; crate: Crate? }
class Crate { item: Linked }
linked = Linked(7, ø)
crate = Crate(linked)
linked.crate = crate
check("records that refer to each other", crate.item.n, 7)
class Tree { n: int; kids: list<Tree> }
count(kids: list<Tree>) as int := #kids
t = Tree(1, [Tree(2, []), Tree(3, [])])
check("a record holding a list of itself, the list given to a function", count(t.kids), 2)
# a function value equals only itself (the rule an `any` follows): two instances holding the same one are equal
class Act { f: (int) -> int }
step = Act(x => x + 1)
check("a record holding a function value equals itself", step == step, yes)
check("records holding two function values differ", step == Act(x => x + 1), no)
# a value's properties (decision property-accessors): a getter read as a field, a setter called as a method
class Sheet { cells: int }
sheet = Sheet(12)
sheet.area := sheet.cells * 2
sheet.area(new_area: int) := { sheet.cells = new_area ÷ 2 }
sheet.area(30)
check("a property's getter and setter", sheet.area, 30)
sheet.area = 50
check("a property set by assignment calls its setter", sheet.cells, 25)
# a field of a pattern's type holds a Node of that shape, alone, optional or in a map
pattern Twin = (Twin $a: Node $b: Node)
class TwinHolder { kept: Twin; spare: Twin? = ø; all: map<text, Twin> = {} }
twins = TwinHolder(Twin(Number(1), Number(2)))
twins.all["x"] = twins.kept
check("a field of a pattern's type", twins.all["x"].b, Number(2))
# `this` is the instance too, a word alias of self (wiki/keyword.md)
class Doubler { n: int = 1; double() := this.n * 2 }
check("this in a method", Doubler().double(), 2)
# a method that writes its result type (wiki/class.md), an operator named by its spelling among them
class Gap { n: int; less(o: Gap) as Gap := Gap(n - o.n); -(o: Gap): Gap := Gap(n - o.n) }
check("methods with result types", "${Gap(9).less(Gap(2)).n} ${(Gap(9) - Gap(4)).n}", "7 5")
# a sibling method called bare in a method passes the receiver, as a bare field reads it (wiki/class.md)
class Ranges { cells: list<int>; range_field(at: int, index: int) as int := cells[at * 2 + index]; range_start(at: int) as int := range_field(at, 0) }
check("a sibling method called bare", Ranges([1, 2, 3, 4]).range_start(1), 3)
