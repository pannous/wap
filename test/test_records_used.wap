# a used module's class and the program's own class of one name (wiki/use.md "which word a name means"): each name
# means the nearest definition, so the module's code makes its Point and the program's its own, two types
use "check.wap"
use "points_elsewhere.wap"

class Point { x: int; y: int }
first(xs: list<T>): T := xs#1
check("a used module's class and the program's own of one name stay two types", "${first([made_elsewhere()]).label} ${first([Point(1, 2)]).x}", "far 1")
