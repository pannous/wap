# the forms of wiki/reflection.md wap builds (the forms not built yet: test_reflection_wanted.wap)
use "check.wap"

next(x: int) as int := x + 1
step = 3
held: list<any> = [next, (y) => y * step, 1, "next", {a: 1}]
check("a function, a closure, a number, a text and a map in an any: only the function values are functions", held.map(value => value is function), [yes, yes, no, no, no])
check("a function in an any is no map", held.map(value => value is map), [no, no, no, no, yes])
