# the forms wiki/reflection.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"
use math
use text

class Point { x: int; y: int; length() := sqrt(x*x + y*y) }
p = Point(3, 4)
check("dir(p)", dir(p), ["x", "y", "length"])
class Point4 { x: int; y: int }
p4 = Point4(3, 4)
check("p4.class == Point4", p4.class == Point4, yes)
check("dir({a: 1, b: 2})", dir({a: 1, b: 2}), ["a", "b"])
area3(width: int, height: int) := width * height
check("\"${area3.dump}\"", "${area3.dump}", "area3(width:int, height:int) := width*height")
area4(width: int, height: int) := width * height
check("\"${area4.body}\"", "${area4.body}", "width*height")
fun twice(x) {
	"doubles a number"
	x*2
}
check("twice.doc", twice.doc, "doubles a number")
# doubles a number
twice2(x) := x*2
check("twice2.doc", twice2.doc, "doubles a number")
f = function gcd
check("f.name", f.name, "gcd")
f2 = function gcd
check("f2(12, 18)", f2(12, 18), 6)
f3 = function upper
check("f3 is function", f3 is function, yes)
