# Regular expressions, lib/regex.wap (wiki/library-regex.md): matching, finding, replacing and the groups of a match
# TODO `use regex` once the module search looks in lib/ before its folders (use.md: lib/<name>.wap; wap-lead asked the
# user): today lib/crates/regex.warp, warp's crate spec, is a second module regex
use "../lib/regex.wap"
use "check.wap"

check("a match anywhere", matches("order 66", "[0-9]+"), yes)
check("the first match", first_match("order 66, then 7", "[0-9]+"), "66")
check("no match is ø", first_match("no digits", "[0-9]+") == ø, yes)
check("every match", find_all("a1 b22 c333", "[0-9]+").join(" "), "1 22 333")
check("groups in a replacement", replace_all("2026-11-05", "([0-9]+)-([0-9]+)-([0-9]+)", "$3.$2.$1"), "05.11.2026")
check("the groups of the first match", match_groups("v1.22", "v([0-9]+)[.]([0-9]+)")!.join(" "), "1 22")
check("no match has no groups", match_groups("nope", "v([0-9]+)") == ø, yes)
check("the groups of every match", find_all_groups("a=1, b=22", "([a-z])=([0-9]+)").map(g => g.join("=")).join(" "), "a=1 b=22")
check("a group that took no part is empty", match_groups("ab", "(a)(x)?(b)")!.join(","), "a,,b")
LINE := "10.0.0.7 - - [05/Nov/2026:09:15:11 +0100] GET /api 401"
check("a log line's fields", match_groups(LINE, "^([0-9.]+) .*[[]([^]]+)[]] ([A-Z]+) ([^ ]+) ([0-9]+)$")!.join("|"), "10.0.0.7|05/Nov/2026:09:15:11 +0100|GET|/api|401")
check("classes, counts, choices, boundaries", find_all("cat catalog bobcat dog", "\\b(?:cat|dog)\\w{0,3}\\b").join(" "), "cat dog")
check("more than nine groups", replace_all("abcdefghijk", "(a)(b)(c)(d)(e)(f)(g)(h)(i)(j)(k)", "\${11}\${10}"), "kj")
check("$0 is the whole match", replace_all("a1 b2", "[0-9]", "<$0>"), "a<1> b<2>")
