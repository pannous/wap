# A used module's infix word (wiki/library-regex.md `"order 66" matches "^order"`; operator.md "Infix operators")
# (red: a declared infix operator is known only in its own file; asked of wap-interviewer)
use "../lib/regex.wap"
use "check.wap"

check("matches as an infix word", "order 66" matches "^order", yes)
