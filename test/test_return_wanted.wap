# the forms wiki/return.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

def either(x) as int or text { if x > 0 { return x }; "neg" }
check("a union result type with or, in a def", either(3), 3)
either_short(x) as int or text := if x > 0 then x else "neg"
check("a union result type with or, in a := definition", either_short(-1), "neg")
def arrowed(a: int, b: float) -> float { return a + b * 2.0 }
check("-> keeps working for the result type", arrowed(1, 2.0), 5.0)
to calculate number a, number b as real:
    return a + b * 2.0
check("a phrase head names its result type after as", calculate 1, 2.0, 5.0)
