# wap's shape rules (notes/first_principles.md "Holes"; wap/kernel/forms.wap: `unless c { b }` is a rule writing If): a
# spelling written as other code by a rule, from sugar or from the program itself, compiled and run. The rules
# whose template writes prints themselves stay in test/wap/test_rules.sh
use "check.wap"

ran = "not run"
unless no { ran = "ran" }
check("unless runs its body when the condition is no", ran, "ran")
skipped = "end"
unless yes { skipped = "skipped" }
check("unless skips its body when the condition is yes", skipped, "end")
hellos: list<text> = []
rule doubly $body => { $body; $body }
doubly { hellos += ["hi"] }
check("a program's own rule", hellos, ["hi", "hi"])
# a result type after `as` (wiki/function.md: `f() as int := 3` reports its result as int)
greet(t: text) as text := t
check("a result type written with as", greet("hi"), "hi")
# a hole inside a template text is the spelling of what it took, the longer hole name first (core/rules/templates.wap)
rule hail $who $whom => "hi $who and $whom"
check("a hole inside a template text", (hail ann bob), "hi ann and bob")
rule hello($names...) => "hello"
check("a rest hole in brackets takes an empty group", hello(), "hello")
rule swapped { $a $b } => [$b, $a]
check("a block pattern fits statements parted by ; or line ends", [swapped { "x"; "y" }, swapped {
	"p"
	"q"
}], [["y", "x"], ["q", "p"]])
rule klass $name { ($field: $type)... ($m := $b)... } => "two"
check("two repeated groups in a row", [klass P { x: int; y: int }, klass Q { x: int; f := 1 }], ["two", "two"])
rule methods { ($method($parameters...) := $body)... } => ($method(self: int, $parameters...) := $body)...
methods { twice(k: int) := self * k; ten() := self * 10 }
check("a template that is a repetition, with and without the rest it repeats", twice(3, 4) + ten(2), 32)
check("a block pattern of two parts fits a group of one item", klass P { x: int }, "two")
rule kept $x: Number => $x
rule kept $x: Text => ()
rule numbers [$items...] => #[(kept $items)...]
check("a rule that writes nothing leaves its place in the list", (numbers [1, "skip", 2]), 2)
rule twin $x: Symbol => $x, $x
q = 5
check("a row a rule writes joins the list it lands in", #[(twin q), 1], 3)
rule row_of { $cases... } => [$cases...]
ws = row_of {
	5, 6
	7
}
check("in braces a line's comma row gives its items to a repetition", #ws, 3)
rule mk { $ms... } => {(nm ($ms))...}
rule nm ($f: $t) => $f: 1
m = mk { a: int; b: int }
check("a rule's result in a group of one gives way to the key it became", m.a + m.b, 2)
rule mk_bare { $ms... } => {(nm_bare $ms)...}
rule nm_bare ($f: $t) => $f: 1
m_bare = mk_bare { a: int; b: int }
check("a key in brackets in a pattern fits the key written bare", m_bare.a + m_bare.b, 2)
rule shout => "HI"
rule never => False()
rule shout $x => "phrase"
check("a rule of one word rewrites that word standing alone, a template writes a literal by its case", [shout, (shout 1), text(never)], ["HI", "phrase", "no"])
# wiki/rule.md "Holes", stage 2: a hole typed function takes a name declared as one
rule applied_twice $f: function $x => $f($f($x))
inc(n: int): int := n + 1
check("a rule's function hole takes a name the program declares as a function", (applied_twice inc 3), 5)
# a call of a function the program defines is the program's own, no rule of that word rewrites it: the program's word
# wins (sugar/conditions.wap writes chains as comparison_chain)
comparison_chain(a: int, b: int, c: int, d: int, e: int) as int := a + b + c + d + e
check("a program's own function beats a rule of its name", comparison_chain(1, 2, 3, 4, 5), 15)
