# wiki/3d.md: a scene declared as the things in it, `{ car, tree, tree, house }`, each at its natural size, a family's
# member picked at random
use "check.wap"
use scene

placed = scene("{car, tree, tree, house}")
check("a scene holds the things it names", placed.map(thing => thing.name), ["car", "tree", "tree", "house"])
check("a tree is one of the trees", placed.filter(thing => thing.name == "tree").all(thing => thing.kind in ["palm", "apple", "pine"]), yes)
check("a house is meters high", placed[3].thing.size[1], 7.0)
check("an unknown thing is refused", try scene("unicorn") else "refused", "refused")
