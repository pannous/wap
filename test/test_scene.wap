# A 3d scene declared as the things in it, lib/scene.wap (wiki/3d.md)
use scene
use "check.wap"

placed = scene("{car, tree, tree, house}")
check("a scene holds the things it names", placed.map(thing => thing.name), ["car", "tree", "tree", "house"])
check("a tree is a palm, an apple or a pine tree", placed.filter(thing => thing.name == "tree").all(thing => ["palm", "apple", "pine"].contains(thing.kind)), yes)
check("a tree's natural height is between 1 and 50 meters", placed.filter(thing => thing.name == "tree").all(thing => size_of(thing)[1] >= 1.0 and size_of(thing)[1] <= 50.0), yes)
check("every thing stands upright on the ground", placed.all(thing => thing.position[1] == 0.0 and scene_boxes(thing).all(b => b.low[1] >= 0.0)), yes)
check("a scene is drawn as triangles, twelve a box", #scene_triangles(scene("rock")), 36)
