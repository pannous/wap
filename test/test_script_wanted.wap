# the forms wiki/script.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"
use script

check("a path written without quotes is a path", "${type(./a.txt)}", "path")
check("a path is a text too", ./a.txt is text, yes)
check("a path in quotes is a plain text", "./a.txt" is path, no)
check("as path marks a text as a path", "${type("./a" as path)}", "path")
check("a path joins a text as a text does", "dir: " + ./docs, "dir: ./docs")
kind(p: path) := "path"
kind(t: text) := "text"
check("a path parameter takes the paths beside a text one", [kind(./a), kind("./a")], ["path", "text"])
check("pwd is the working directory", #pwd > 0, yes)
