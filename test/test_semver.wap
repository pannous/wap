# semantic versions and npm ranges, lib/semver.wap (wiki/library-semver.md)
use semver
use "check.wap"

check("a version's prerelease", semver("v1.2.3-rc.1+b5").prerelease, ["rc", "1"])
check("a version written back", text(semver("v1.2.3-rc.1+b5")), "1.2.3-rc.1+b5")
check("versions sorted by precedence", semver_sort(["1.0.0", "1.0.0-alpha.1", "1.0.0-alpha", "0.9.9", "1.0.0-beta"]), ["0.9.9", "1.0.0-alpha", "1.0.0-alpha.1", "1.0.0-beta", "1.0.0"])
check("caret ranges", [satisfies("1.4.0", "^1.2.3"), satisfies("2.0.0", "^1.2.3"), satisfies("0.3.0", "^0.2.3")], [yes, no, no])
check("tilde ranges and wildcards", [satisfies("1.2.9", "~1.2.3"), satisfies("1.3.0", "~1.2.3"), satisfies("1.5.0", "1.x"), satisfies("3.0.0", "*")], [yes, no, yes, yes])
check("a range of sets", satisfies("2.5.0", "1.2.7 || >=2.0.0 <3.0.0"), yes)
check("a prerelease only in a range naming its version", [satisfies("1.2.3-beta.2", ">=1.2.3-beta.1"), satisfies("1.2.4-beta.2", ">=1.2.3-beta.1")], [yes, no])
