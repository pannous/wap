# a list, a map and an instance are shared, as in Python (wiki/Footguns.md "Aliasing"; user 2026-11-27 write-meaning)
use "check.wap"

zs = [1, 2]
ws = zs
ws#2 = 8
check("a write through a second name changes the list both names see", zs, [1, 8])

class Spot { x: int }
p = Spot(1)
q = p
q.x = 5
check("a field written through a second name changes the instance both names see", p.x, 5)

grown(xs: list<int>) := { xs.add(3) }
ys = [1, 2]
grown(ys)
check("a function that adds to its list parameter changes the caller's list", ys, [1, 2, 3])

original = [1, 2]
copied = original.copy()
copied#1 = 9
check("x.copy() copies", original, [1, 2])
