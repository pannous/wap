# the shell's words, lib/shell.wap (wiki/script.md: The shell's words), in a fresh temporary folder
use shell
use file
use path
use "check.wap"

folder = temp_dir()
notes = path_join(folder, "notes.txt")
write(notes, "todo: write\nread more\ntodo: test\n")
mkdir(path_join(folder, "src/deep"))
write(path_join(folder, "src/a.wap"), "x")
write(path_join(folder, "src/deep/b.wap"), "yy")
write(path_join(folder, ".hidden"), "")

check("ls: the names, sorted, the hidden ones left out", ls(folder), ["notes.txt", "src"])
check("cat: a file's text", cat(notes), "todo: write\nread more\ntodo: test\n")
check("head and tail: the first and last lines", [head(notes, 2), tail(notes, 1)], [["todo: write", "read more"], ["todo: test"]])
check("wc: lines, words and bytes", wc(notes), {lines: 3, words: 6, bytes: 33})
check("grep: the lines a regular expression matches", grep("^todo", notes), ["todo: write", "todo: test"])
check("sort_lines and unique_lines", sort_lines(notes), ["read more", "todo: test", "todo: write"])
check("find_files: the paths below a folder whose name matches", find_files(folder, "*.wap").map(p => p[#folder:]), ["/src/a.wap", "/src/deep/b.wap"])
check("file_size: a folder's bytes are its files'", file_size(path_join(folder, "src")), 3)
cp(notes, path_join(folder, "src"))
check("cp into a folder keeps the name", cat(path_join(folder, "src/notes.txt")), cat(notes))
write_bytes(path_join(folder, "bytes.bin"), (0 upto 256).map(b => b))
cp(path_join(folder, "bytes.bin"), path_join(folder, "copy.bin"))
check("cp keeps every byte of a binary file", [file_size(path_join(folder, "copy.bin")), read(path_join(folder, "copy.bin")) == read(path_join(folder, "bytes.bin"))], [256, yes])
mv(path_join(folder, "src/notes.txt"), path_join(folder, "moved.txt"))
check("mv renames", [exists(path_join(folder, "src/notes.txt")), exists(path_join(folder, "moved.txt"))], [no, yes])
touch(path_join(folder, "empty.txt"))
check("touch makes a missing file empty", cat(path_join(folder, "empty.txt")), "")
check("pwd is the working folder", pwd().starts_with("/"), yes)
check("which finds a program on the PATH, ø for none", [which("sh") != ø, which("no-such-program-anywhere") == ø], [yes, yes])
