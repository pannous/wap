# wap's shown values (wap/preload numbers, texts, lists): a value in warp notation, as old warp shows a program's
# result: texts in quotes with their quote and backslash escaped, characters in single quotes, lists of shown items
use "check.wap"

check("numbers and bools shown", [show(3), show(3.5), show(yes)], ["3", "3.5", "yes"])
check("a text shown in quotes, escaped", show("a\"b\\c"), "\"a\\\"b\\\\c\"")
check("a character shown in single quotes", show('c'), "'c'")
check("a list shown item by item", [show(["ab", "c d"]), show([1, 2])], ['["ab", "c d"]', "[1, 2]"])
