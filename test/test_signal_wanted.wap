# the forms wiki/signal.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

edged = 0
edges = 0
whenever edged > 5 { edges += 1 }
edged = 6
edged = 7
edged = 3
edged = 8
check("whenever runs each time the condition becomes true", edges, 2)
changed = 0
changes = 0
on change changed { if changed > 5 { changes += 1 } }
changed = 6
changed = 7
changed = 7
changed = 3
changed = 8
check("on change runs at every change", changes, 3)
written = 0
writes = 0
on set written { if written > 5 { writes += 1 } }
written = 6
written = 7
written = 7
written = 3
written = 8
check("on set runs at every write", writes, 4)
counted = 1
halfway = 0
once counted == 5 { halfway += 1 }
for i in 1..10 { counted = i }
check("once runs the first time the condition holds", halfway, 1)
price = 3
amount = 2
total := price * amount
seen = 0
on change total { seen = value }
amount = 5
check("a := value is a derived signal its listeners watch", seen, 15)
morning = 1
on every day at 9:00 { morning = 2 }
check("a handler never runs in the middle of main", morning, 1)
stops = 0
on stop the machine { stops += 1 }
emit stop the machine
check("a signal's type is its name, unquoted", stops, 1)
