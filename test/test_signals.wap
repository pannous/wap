# a value whose writes its listeners hear, `x = signal(0)` (wiki/signal.md; the user's decision on class setters,
# card class-setter)
use "check.wap"
use signals

edged = signal(0)
edges = 0
whenever edged > 5 { global edges += 1 }
edged = 6
edged = 7
edged = 3
edged = 8
check("whenever runs each time the condition comes to hold", edges, 2)
changed = signal(0)
changes = 0
on change changed { global changes += 1 }
changed = 6
changed = 6
changed = 3
check("on change runs after a write that changed the value", changes, 2)
written = signal(1)
writes = 0
on set written { global writes += 1 }
written = 1
written = 2
check("on set runs after each write", writes, 2)
halfway = signal(10)
said = 0
once halfway == 5 { global said += 1 }
for n in 1 to 10 { halfway = 10 - n }
check("once runs the first time the condition holds", said, 1)
looped = signal(0)
on change looped { global looped = 7 }
looped = 5
check("a listener writing what it hears does not loop", looped.value, 7)
read = signal(4)
check("a signal reads as its value where no word takes the signal itself", read > 3 and read + 1 == 5, yes)
original = signal(1)
shared = original
original = 2
check("a plain copy shares the signal, so it follows", shared.value, 2)
typed: int = original
valued = original.value
original = 3
check("a typed copy copies the value, and does not follow", typed, 2)
check("the value copies, and does not follow", valued == 2, yes)
