# the examples of wiki/significant-whitespace.md, each as the page writes it
use "check.wap"

x = 3
check("a number glued to a name multiplies it: 2x", 2x, 6)
check("a blank parts list items: [2 x]", [2 x], [2, 3])
check("a glued sign starts a new item: 1 +1", 1 +1, [1, 1])
check("a glued minus starts a new item: 1 -1", 1 -1, [1, -1])
check("a spaced minus subtracts: 1 - 1", 1 - 1, 0)
answer() := 4
check("a space before an empty () changes nothing", answer (), 4)
check("# glued to a value takes an item", "abc"#3, 'c')
style = 1
check("a word a blank parts from the map after it is two items", #(style {a: 1}), 2)
