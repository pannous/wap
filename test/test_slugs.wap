# Slugs and case conversions, lib/slugs.wap (wiki/library-slugs.md): folding to ASCII, URL slugs, the case conversions
# that keep acronyms whole, word-aware truncation
use slugs
use "check.wap"

check("a slug folds, lowers and joins the words by dashes", slugify("Crème Brûlée: A Recipe!"), "creme-brulee-a-recipe")
check("the German folding writes umlauts as two letters", ascii_fold_german("Müller Größe"), "Mueller Groesse")
check("an acronym stays one word", to_snake("HTTPServer"), "http_server")
check("digits stay with the letters before them", to_camel("parse_url2_text"), "parseUrl2Text")
check("truncation cuts at a word and marks the cut", truncate_words("the quick brown fox jumps", 3), "the quick brown…")
check("kebab case", to_kebab("HTTPServer"), "http-server")
check("pascal case", to_pascal("parse_url2_text"), "ParseUrl2Text")
check("constant case", to_constant("parseURL2Text"), "PARSE_URL2_TEXT")
