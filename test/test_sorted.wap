# sorted maps and sets, lib/sorted.wap (wiki/library-collections.md "Sorted maps and sets")
use sorted
use "check.wap"

board = sorted_map([[980, "Bea"], [1200, "Ada"], [1500, "Cal"], [90, "Fay"]])
check("a sorted map's keys in order", "${board.keys}", "[90, 980, 1200, 1500]")
check("the i-th smallest key and its value", "${[board.at(4), board.get(board.at(4))]}", "[1500, \"Cal\"]")
check("a key's rank, 0 when absent", "${[board.rank(980), board.rank(5)]}", "[2, 0]")
check("the keys between two", "${board.between(900, 1300)}", "[980, 1200]")
check("set gives a new map and leaves the receiver", "${[board.set(5, "Gus").size(), board.size()]}", "[5, 4]")
s = sorted_set(["pear", "apple", "fig"])
check("a sorted set's items in order", "${s.add("kiwi").items}", "[\"apple\", \"fig\", \"kiwi\", \"pear\"]")
check("set operations", "${[s.union(sorted_set(["date"])).items, s.intersection(sorted_set(["fig", "plum"])).items]}", "[[\"apple\", \"date\", \"fig\", \"pear\"], [\"fig\"]]")
