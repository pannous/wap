# notes, chords and scales as values (wiki/sound.md "Music words" and its last section); nothing here plays a sound
use "check.wap"
use file
use sound
use units

check("A4 is 440", hertz(A4), 440.0)
check("midi(A4) is 69", midi(A4), 69)
check("a note an octave up is the next octave's", transpose(C4, 12) == C5, yes)
check("a sharp note by its letter", text(F#4), "F#4")
check("note(445Hz) is A4 and its cents off it", text(note(445Hz)), "A4+20c")
check("a Note equals the text of its name", note("C#4") == "C#4", yes)
check("note names are frequencies", C4 * 2.0, 523.26)
check("notes added are a chord, shown as written", text(C4 + E4 + G4), "C4+E4+G4")
check("a chord by kind word", text(chord(C4, ChordKind.major7)), "C4+E4+G4+B4")
check("a scale by kind word", scale(D4, Scale.dorian).map(n => text(n)).join(" "), "D4 E4 F4 G4 A4 B4 C5 D5")
check("a note tied longer", text(C4 ~ 2.0), "C4~2")
check("euclid spreads three notes over eight steps", euclid(C5, 3, 8).map(step => text(step)).join(" "), "C5 rest rest C5 rest rest C5 rest")
tune_file = temp_file()
save(MidiFile([[0.0, C4, 0.5, 100], [0.5, E4, 0.25, 80]]), tune_file)
check("a MIDI file saved reads back as its notes, each note's frequency", "${midi_file(tune_file).notes}", "[[0, 261.63, 0.5, 100], [0.5, 329.63, 0.25, 80]]")
tone = chord_samples([440.0], 0.05, "sine")
check("a tone's spectrum is loudest in its band", spectrum(tone, 0.0, 8).index_of(spectrum(tone, 0.0, 8).max()) - 1, nearest_band(440.0, 8))

check("pause alone is a rest", text(pause), "rest")
