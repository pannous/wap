# the forms wiki/standard-library.md shows
# the standard modules list, text and map: their words in every program, no `use` needed
use "check.wap"

check("the list module's words need no use", zip([1, 2], [3, 4]), [[1, 3], [2, 4]])
check("the text module's words need no use", remove_prefix("wap.wasm", "wap"), ".wasm")
check("the map module's words need no use", merge({a: 1}, {b: 2}), {a: 1, b: 2})
check("a relative path made absolute starts at the root and ends with the path, an absolute one stays", [absolute_path("notes.txt").starts_with("/"), absolute_path("notes.txt").ends_with("/notes.txt"), absolute_path("/a/b")], [yes, yes, "/a/b"])
