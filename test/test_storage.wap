# Values kept under names, lib/storage.wap (wiki/standard-library.md "storage")
use storage
use "check.wap"

storage["score"] = 42
check("a value kept in the database is read back by its name", storage["score"] == 42, yes)
check("database and local are storage", database["score"] == 42 and local["score"] == 42, yes)
session["page"] = "home"
check("a session value is kept while the run lasts", session["page"] == "home", yes)
check("keys lists the names kept", [keys(storage), keys(session)], [["score"], ["page"]])
delete(storage, "score")
check("a deleted value is gone", storage["score"] == ø, yes)
check("stored_value keeps its default the first time", [stored_value("visits", 1), storage["visits"] == 1], [1, yes])
storage["n"] = 1
try { transaction { storage["n"] = 2; raise "stop" } } catch failure { }
check("a failed transaction lands none of its writes", storage["n"] == 1, yes)
transaction { storage["n"] = 3 }
check("a transaction that finishes lands its writes", storage["n"] == 3, yes)
