# the forms of lib/storage.wap's module that wap does not build yet (warp's storage.warp had them): each red line is a
# to-do, fixed by building the form
use storage
use "check.wap"

# a class's instances kept as the rows of a table named as the list: needs a class's fields read by their names
class User { name: text, age: int }
stored_save("users", [User("Ada", 36), User("Bo", 20)])
check("a stored table gives its rows back as instances", stored_table("users", User).map(u => u.name), ["Ada", "Bo"])
# a variable whose every write is kept: needs a declaration a library keeps (notes/lib-rules.md "data")
stored visits default 0
visits = visits + 1
check("a stored variable keeps its value", storage["visits"] == 1, yes)
