# the examples of wiki/string.md, each as the page writes it
use "check.wap"

shalom = "שָלוֹם"
check("each letter's vowel point is one more code point", count shalom.codepoints, 6)
check("count counts code points", count shalom, 6)
check("an emoji with a skin tone is two code points", size "👍🏽", 2)
check("a number joins a text in front of it", 1 + "x", "1x")
check("a text times a number repeats it", "ab" * 2, "abab")
check("reverse reverses a text", reverse "abc", "cba")
friend = "Bo"
check("a backslash hole interpolates", "Hello \(friend)", "Hello Bo")
start = 1
time = 5
check("a dollar-brace hole interpolates", "It took ${time - start} milliseconds", "It took 4 milliseconds")
check("a bare $ is text", "costs $5, not $friend", "costs $5, not $friend")
check("a text inside a container shows double-quoted", show(["ab"]), "[\"ab\"]")
check("graphemes lists the characters as a reader sees them", count shalom.graphemes, 4)
check("an emoji with a skin tone is one grapheme", "👍🏽".graphemes.count, 1)
check("characters is another name for chars", [chars("aé").join("-"), characters("aé").join("-")], ["a-é", "a-é"])
