# the forms wiki/string.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"
use text

shalom_text = "שָלוֹם"
check("count counts characters, a letter with its marks one", count shalom_text, 4)
check("a single emoji is one character", size "👍🏽", 1)
bytes_seen = 0
for each byte in "你好" { bytes_seen += 1 }
check("for each byte walks the UTF-8 bytes", bytes_seen, 6)
cursor = Cursor("ab12 cd")
check("a Cursor reads while a test holds", cursor.take_while(is_letter), "ab")
check("a Cursor reads on from where it stopped", cursor.take_while(is_digit), "12")
check("3 times a text repeats it", 3 times "ab", "abab")
check("upper knows all of Unicode", upper "straße", "STRASSE")
check("letters of a text are its Unicode letters", letters of "a1 b!", ['a', 'b'])
names = ["a", "b"]
check("names.upper is upper names", names.upper, ["A", "B"])
