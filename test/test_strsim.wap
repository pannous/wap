# How alike two texts are, lib/strsim.wap (wiki/standard-library.md "strsim")
use strsim
use "check.wap"

check("levenshtein counts the fewest single-character edits", [levenshtein("kitten", "sitting"), levenshtein("", "abc"), levenshtein("flaw", "flaw")], [3, 3, 0])
check("levenshtein counts characters, not bytes", levenshtein("café", "cafe"), 1)
check("jaro_winkler is 1 for equal texts and 0 for nothing alike", [jaro_winkler("same", "same"), jaro_winkler("abc", "xyz")], [1.0, 0.0])
check("jaro_winkler weighs a shared prefix", [round(jaro_winkler("martha", "marhta") * 1000), round(jaro_winkler("dwayne", "duane") * 1000)], [961, 840])
