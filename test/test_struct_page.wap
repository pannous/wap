# the examples of wiki/struct.md, each as the page writes it
use "check.wap"

struct Point { x: int; y: int }
check("struct is another word for class", Point(1, 2).y, 2)

struct point{
  x:int
  y:int
}
check("a struct is built from its fields", point(1,2).y, 2)
class Spot{ x:int; y:int }
check("a class body may follow the name glued", Spot(1,2).y, 2)
