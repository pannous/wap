# the examples of wiki/subtype.md that wap builds, each as the page writes it
use "check.wap"

check("a text of length 1 is a char", "a" is char, yes)
check("a longer text is no char", "ab" is char, no)
c: char = "a"
check("a char place takes a one-character text", c, "a")
shout(t: text) := t.upper + "!"
check("every text word takes a char", shout(c), "A!")
check("a char joined to a text is a text", c + "b", "ab")
line = "x"
f = line as char
check("as converts to a subtype, checked when the program runs", f, "x")
type positive = int where it > 0
check("where names the values that meet a condition", [3 is positive, 0 is positive], [yes, no])
class person { name: text; age: int }
type adult = person where it.age >= 18
check("a condition may read a field", [person("Ann", 40) is adult, person("Bo", 9) is adult], [yes, no])

# a subtype of int is an int: every int word takes it (wiki/subtype.md "A char is a text")
grown(a: positive): int := a + 1
check("every int word takes a value of an int subtype", grown(2), 3)
# a list of a subtype changes only by a copy: an int added to it is checked, its filtered copy is a list of ints
kept: list<positive> = [1, 2]
k: int = 3
kept.add(k)
check("an int added to a list of a subtype is checked and added", kept, [1, 2, 3])
widened: list<int> = kept.filter(each => each > 1)
check("a filtered list of a subtype is a list of ints where one is wanted", widened, [2, 3])
