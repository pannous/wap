# the subtypes wiki/alias.md "type aliases" shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

type Color < int
text(c: Color): text := "color " + (c as int)
check("a subtype may give its own text", "" + (5 as Color), "color 5")
check("a subtype is still its parent: + gives an int", (5 as Color) + 1, 6)
check("an int is of the subtype", 3 is Color, yes)
