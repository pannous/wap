# the subtypes wiki/alias.md "type aliases" shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

type Color < int
text(c: Color): text := "color " + (c as int)
check("a subtype may give its own text", "" + (5 as Color), "color 5")
check("a subtype is still its parent: + gives an int", (5 as Color) + 1, 6)
check("an int is of the subtype", 3 is Color, yes)

# the forms wiki/subtype.md shows that wap does not build yet
type positive = int where it > 0
check("where names the values that meet a condition", [3 is positive, 0 is positive], [yes, no])
class person { name: text; age: int }
type adult = person where it.age >= 18
check("a condition may read a field", person("Ann", 40) is adult, yes)
initial(name: text where #it > 0): char := name#1
check("a parameter's condition is known inside the function", initial("Ada"), "A")
line = read_line()
check("inside an if, its condition fills the subtype", if #line == 1 { e: char = line; e } else { "-" }, if #line == 1 then line else "-")
type Port < int where 0 <= it and it < 65536
check("< with a condition makes a new type of the values that meet it", (8080 as Port) as int, 8080)
type vector(T, n: nat) = list<T> where #it == n
check("a list of three ints is a vector of three", [1, 2, 3] is vector(int, 3), yes)
type index(xs: list<T>) = nat where 1 <= it and it <= #xs
xs = [10, 20, 30]
check("an index of a list reads its item", xs#(2 as index(xs)), 20)

# a list of a subtype where a list of its parent is wanted (wiki/subtype.md "A list of a subtype"): shared when the function only reads it, `as` copies for one that changes it
total(xs: list<int>): int := xs.sum
check("a function that only reads takes a list of a subtype as it is", total([1, 2] as list<positive>), 3)
grow(xs: list<int>) := xs.add(0)
shared: list<positive> = [1, 2]
grow(shared as list<int>)
check("a function that changes the list takes a copy: the list of the subtype stays", shared, [1, 2])
grown_by(xs: list<int>) := { ys = xs; ys.add(0) }
grown_by(shared as list<int>)
check("a change through a local name of the parameter takes a copy too", shared, [1, 2])
same_list(xs: list<int>): list<int> := xs
grown_back(xs: list<int>) := same_list(xs).add(0)
grown_back(shared as list<int>)
check("a change through the returned parameter takes a copy too", shared, [1, 2])
down(xs: list<int>, n: int) := if n > 0 { up(xs, n - 1) }
up(xs: list<int>, n: int) := { xs.add(0); down(xs, n) }
down(shared as list<int>, 2)
check("a change inside two functions that call each other takes a copy", shared, [1, 2])
first_of(xs: list<T>): T := xs#1
check("a generic function reading a list of a subtype shares it", first_of(shared), 1)
checked = [1, 2, 3] as list<int> as list<positive>
check("a list of ints as a list of a subtype is checked and copied", checked, [1, 2, 3])
check("a list written out in place is a list of a subtype or of ints, as the place wants", [total([1, 2]), total(checked)], [3, 6])
class Animal { name: text }
class Cat extends Animal {}
name_count(xs: list<Animal>) := #xs
rename_all(xs: list<Animal>) := xs.add(Animal("x"))
cats: list<Cat> = [Cat("Tom")]
check("a list of a subclass is shared where a list of its parent is only read", name_count(cats), 1)
rename_all(cats as list<Animal>)
check("a list of a subclass written as a list of its parent is a copy for a function that changes it", #cats, 1)
