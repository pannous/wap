# the subtypes wiki/alias.md "type aliases" shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

type Color < int
text(c: Color): text := "color " + (c as int)
check("a subtype may give its own text", "" + (5 as Color), "color 5")
check("a subtype is still its parent: + gives an int", (5 as Color) + 1, 6)
check("an int is of the subtype", 3 is Color, yes)

# the forms wiki/subtype.md shows that wap does not build yet
type positive = int where it > 0
check("where names the values that meet a condition", [3 is positive, 0 is positive], [yes, no])
class person { name: text; age: int }
type adult = person where it.age >= 18
check("a condition may read a field", person("Ann", 40) is adult, yes)
initial(name: text where #it > 0): char := name#1
check("a parameter's condition is known inside the function", initial("Ada"), "A")
line = read_line()
check("inside an if, its condition fills the subtype", if #line == 1 { e: char = line; e } else { "-" }, if #line == 1 then line else "-")
type Port < int where 0 <= it and it < 65536
check("< with a condition makes a new type of the values that meet it", (8080 as Port) as int, 8080)
type vector(T, n: nat) = list<T> where #it == n
check("a list of three ints is a vector of three", [1, 2, 3] is vector(int, 3), yes)
type index(xs: list<T>) = nat where 1 <= it and it <= #xs
xs = [10, 20, 30]
check("an index of a list reads its item", xs#(2 as index(xs)), 20)
# wiki/type.md "Dependent Types": a parameter's type reads the parameters before it, filled by the call's own arguments
below(n: int, m: int where it < n): int := m
around(n: int): int := below(1000, 500)
check("a parameter's condition reads the call's argument before it, never a name where the call sits", around(1), 500)
at(xs: list<T>, i: index(xs)): T := xs#i
check("the type of i names the argument before it", at([10, 20, 30], 2), 20)
