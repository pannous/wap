# the forms wiki/switch.md shows that wap builds: catch-all cases, a case that fits nothing, switch as map indexing,
# an else taking the whole expression
use "check.wap"

check("other takes what no case took", match 3 { 1 => "one"; other => "many" }, "many")
check("_ takes what no case took", match 3 { 1 => "one"; _ => "many" }, "many")
check("default takes what no case took", match 3 { 1 => "one"; default => "many" }, "many")
check("else takes what no case took", match 3 { 1 => "one"; else => "many" }, "many")
check("a value no case fits is an error", try match 3 { 1 => "one"; 2 => "two" } else "no case", "no case")
check("a map of actions indexed", {green: "woods!", red: "fire!"}["red"], "fire!")
check("an else takes the whole expression after it", if no {1} else 3+1, 4)
