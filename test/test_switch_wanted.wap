# the forms wiki/switch.md shows that wap does not build yet
use "check.wap"

color = "red"
check("switch picks the case of the value's key", switch color { green: "woods!"; red: "fire!" }, "fire!")
x = 1
check("case may stand before a case", match x { case 1: "one"; case 2: "two" }, "one")
check("| lists several keys for one case", match 2 { 1 | 2 => "small"; _ => "big" }, "small")
check("or lists several keys for one case", match 2 { 1 or 2 => "small"; _ => "big" }, "small")
check("a comma lists several keys for one case", match 2 { 1, 2 => "small"; _ => "big" }, "small")
age = 15
check("a range as key takes every value in it", match age { 0 to 12 => "child"; 13 to 19 => "teen"; other => "adult" }, "teen")
check("ranges: ... includes its end, .. stops before it, 65.. has no end", [20, 70, 19].map(n => match n { 65.. => "old"; 13...19 => "teen"; 20..30 => "twenties"; _ => "x" }), ["twenties", "old", "teen"])
f(n) := match n { 0 => "zero"; n if n < 0 => "negative"; _ => "positive" }
check("if after a key adds a condition", f(-5), "negative")
describe(v) := match v { i: int => i + 1; t: text => t + "!" }
check("a type word as key tests and names the value", "${describe(3)} ${describe("a")}", "4 a!")
check("types mix with values in a case", match "s" { 0 or text => "zero or text"; _ => "other" }, "zero or text")
check("a comparison after a switch compares its value", switch 3 {1: "one"; 3: "three"} == "three", yes)
i = 0
check("a while loop's value is its last body value", while i < 3 { i = i + 1 }, 3)

check("Kotlin's when is a match", when 1 { 1 -> "one"; else -> "many" }, "one")
