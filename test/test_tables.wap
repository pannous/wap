# Tables, lib/tables.wap (wiki/library-tables.md): display widths, truncation, tables in the plain, box and markdown
# styles
use tables
use "check.wap"

check("wide characters take two columns", display_width("中文 ok"), 7)
check("a combining mark takes none", display_width("é"), 1)
check("a plain table under headers, numbers right", table_text([["Ada", 36], ["Alan", 41]], headers: ["name", "age"]), "name  age\n----  ---\nAda    36\nAlan   41")
check("a box table of maps", table_text([{name: "Ada", age: 36}, {name: "Alan", age: 41}], style: box), "┌──────┬─────┐\n│ name │ age │\n├──────┼─────┤\n│ Ada  │  36 │\n│ Alan │  41 │\n└──────┴─────┘")
# TODO (card one-char-literal) `headers: ["x", "n"]` in place, once a list of one-letter texts fits list<text> for a word with overloads
names: list<text> = ["x", "n"]
check("a markdown table", table_text([["a|b", 1]], headers: names, style: markdown), "| x    |   n |\n| :--- | --: |\n| a\\|b |   1 |")
check("one alignment for every column", table_text([["a", 1]], align: center), "a  1")
check("a long text cut with an ellipsis", truncate_display("a long description", 10), "a long de…")
check("a wide character never splits", truncate_display("中文中文", 4), "中…")
