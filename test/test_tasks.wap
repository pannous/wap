# The tasks module (wiki/task.md, wiki/async.md "Controlling a task"): a task's value, its error, pause and cancel.
use "check.wap"
use tasks

download(url: text): text := url + " downloaded"
spin(n: int): int := {
	i = 0
	while i < n { i += 1 }
	i
}

job = go { download("https://example.com") }
check("await gives the task's value", await job, "https://example.com downloaded")
check("a second await gives the same value", finish job, "https://example.com downloaded")

stopped = go { download("https://example.com") }
stopped.stop
check("a stopped task is paused, an await resumes it", await stopped, "https://example.com downloaded")

paused = go { spin(3000) }
pause paused
resume paused
check("a paused task resumed runs to its end", await paused, 3000)

endless = go { spin(100000000000) }
cancel endless
check("a cancelled task's await raises", try await endless else -1, -1)

failing = go { [1, 2][5] }
check("an error inside the task is the await's", try await failing else "caught", "caught")

x = 0
done = go { 3 }
once_finished(done, () => x = 7)
await done
check("a handler runs once the task finishes", x, 7)
check("every task's value", "${await_all([go { 1 }, go { 2 }])}", "[1, 2]")
