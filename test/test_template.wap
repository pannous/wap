# Mustache templates, lib/template.wap (wiki/library-template.md): interpolation, sections, inverted sections,
# HTML escaping
use template
use "check.wap"

check("a name filled in", mustache("Hello {{name}}!", {name: "Ada"}), "Hello Ada!")
check("a section repeats for each item of a list", mustache("{{#items}}- {{.}}\n{{/items}}", {items: ["milk", "eggs"]}), "- milk\n- eggs\n")
check("{{x}} is escaped, {{{x}}} is not", mustache("{{x}} vs {{{x}}}", {x: "<b>"}), "&lt;b&gt; vs <b>")
