# lib/text.wap's words, as wiki/standard-library.md lists them under text
use "check.wap"
use text

check("remove_prefix takes the start a text begins with", remove_prefix("Error: boom", "Error: "), "boom")
check("remove_prefix leaves a text that begins otherwise", remove_prefix("boom", "Error: "), "boom")
check("remove_suffix takes the end a text ends with", remove_suffix("page.html", ".html"), "page")
check("repeat gives the text n times over", [repeat("ab", 3), "ab".repeat(2)], ["ababab", "abab"])
