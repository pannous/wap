# wap's texts compared and joined (wap/preload/prelude.wap; wiki/text.md): `==` and `!=` compare the characters, `+`
# joins two texts
use "check.wap"

warp_name = "warp"
check("texts are equal by their characters", warp_name == "wa" + "rp", yes)
check("texts of other characters or lengths differ", ["warp" != "wasp", "warp" == "war"], [yes, no])
greeting(name: text) := "Hello, " + name + "!"
check("two texts joined", greeting("wap"), "Hello, wap!")
# a one-character text is a character (wiki/char.md), and a character is a text wherever one is wanted
greet() := "x"
check("a character given where a text is wanted", [greet(), "a" + greet()], ["x", "ax"])
code_of(c: char): int := prim i64.extend_i32_u(c)
char_of(n: int): char := prim i32.wrap_i64(n)
byte_count(t: text): int := prim array.len(t)
byte_at(t: text, at: int): int := prim array.get_u(t, at)
bytes_between(t: text, start: int, stop: int): text := prim array_slice(t, start, stop - start)
check("a text's bytes and characters' codes by primitives", "${code_of(char_of(97))} ${byte_count("é")} ${byte_at("ab", 1)} ${bytes_between("hello", 1, 4)}", "97 2 98 ell")
check("int of a text of decimal digits, a leading - its sign", [int("-42") + 1, int("7")], [-41, 7])
