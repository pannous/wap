# wap's texts compared and joined (wap/types/prelude.wap; wiki/text.md): `==` and `!=` compare the characters, `+`
# joins two texts
use "check.wap"

warp_name = "warp"
check("texts are equal by their characters", warp_name == "wa" + "rp", yes)
check("texts of other characters or lengths differ: \"warp\" != \"wasp\"", "warp" != "wasp", yes)
check("texts of other characters or lengths differ: \"warp\" == \"war\"", "warp" == "war", no)
greeting(name: text) := "Hello, " + name + "!"
check("two texts joined", greeting("wap"), "Hello, wap!")
# a one-character text is a character (wiki/char.md), and a character is a text wherever one is wanted
greet() := "x"
check("a character given where a text is wanted: greet()", greet(), "x")
check("a character given where a text is wanted: \"a\" + greet()", "a" + greet(), "ax")
code_of(c: char): int := prim i64.extend_i32_u(c)
char_of(n: int): char := prim i32.wrap_i64(n)
byte_count_of(t: text): int := prim array.len(t)
byte_of(t: text, at: int): int := prim array.get_u(t, at)
check("a text's bytes and characters' codes by primitives", "${code_of(char_of(97))} ${byte_count_of("é")} ${byte_of("ab", 1)} ${bytes_between("hello", 1, 4)}", "97 2 98 ell")
check("int of a text of decimal digits, a leading - its sign: int(\"-42\") + 1", int("-42") + 1, -41)
check("int of a text of decimal digits, a leading - its sign: int(\"7\")", int("7"), 7)
# wiki/in.md: `"ell" in "hello"` is yes, a text in a text as an item in a list
check("a text or a char in a text: \"ell\" in \"hello\"", "ell" in "hello", yes)
check("a text or a char in a text: \"x\" in \"hello\"", "x" in "hello", no)
check("a text or a char in a text: 'e' in \"hello\"", 'e' in "hello", yes)
# wiki/text.md "Embedded files": `embedded("file")` is the file's bytes, read when the program is compiled
check("a file embedded when the program is compiled", "check(name: text" in embedded("check.wap"), yes)
# a text and an int join in either order, a text spelling a number too, with a note (wiki/string.md "text + anything",
# user 2026-11-22)
check("a text and an int join in either order: 1 + \"xy\"", 1 + "xy", "1xy")
check("a text and an int join in either order: \"a\" + 3", "a" + 3, "a3")
check("a text that spells a number joins as a text: 1 + \"2\"", 1 + "2", "12")
check("a text that spells a number joins as a text: \"3\" + 3", "3" + 3, "33")
# a list's texts joined, the separator between each two (wiki/argument.md `parts.join(" ")`)
check("a list's texts joined with a separator", ["a", "b", "c"].join(", "), "a, b, c")
check("a list's numbers joined as their texts", [1, 2].join(" "), "1 2")
# a text's character by its place, counted from 1, in any order and across texts (wiki/text.md `"abc"#2` is "b")
check("characters by their places, read out of order and from two texts", "héllo"#5 + "wörld"#2 + "héllo"#2 + "héllo"#1, "oöéh")
# a long text's characters read back and forth, and its count asked again (wiki/text.md `"abc"#2` is "b")
long = "é" + "abcdefghij" * 10 + "ö"
check("a long text's characters by their places, read forward, back and forward again", long#102 + long#101 + long#2 + long#1 + long#102, "öjaéö")
check("a long text's count, asked twice", "${#long} ${#long}", "102 102")
# a constant interpolated in another text (wiki/String.md): the two texts joined
MARK := "·"
check("a text constant interpolated in another: \"${MARK}False\"", "${MARK}False", "·False")
