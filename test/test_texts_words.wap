# wap's text words (wap/types/texts.wap): characters counted and taken, searched, compared, and their kinds, as
# warp's runtime text words give them (core/runtime/text_words.warp; wiki/string.md)
use "check.wap"

check("a text's characters counted", #"héllo", 5)
check("where a part stands", "abcab".find("ca"), 3)
check("a text holds a part", "abc".contains("x"), no)
check("a text starts and ends with parts", "hello".starts_with("he") and "hello".ends_with("lo"), yes)
check("texts in order", "ab" < "b", yes)
check("the kinds of characters", is_digit("7") and is_alpha("q") and is_hex_digit("F") and not is_digit("x"), yes)
check("a text's character at a place", text("héllo"#2), "é")
check("each place of a part replaced: \"a-b--c\".replace(\"-\", \"+\")", "a-b--c".replace("-", "+"), "a+b++c")
check("each place of a part replaced: \"x\".replace(\"y\", \"z\")", "x".replace("y", "z"), "x")
check("a text trimmed of blanks at both ends: \"  a b\\t\\n\".trim()", "  a b\t\n".trim(), "a b")
check("a text trimmed of blanks at both ends: \"   \".trim()", "   ".trim(), "")
check("a text in lower case", "Hé ABC".lower(), "hé abc")
check("a text split at each separator: \"a/bb//c\".split(\"/\")", "a/bb//c".split("/"), ["a", "bb", "", "c"])
check("a text split at each separator: \"abc\".split(\", \")", "abc".split(", "), ["abc"])
check("is_letter is another name of is_alpha", is_letter("q") and not is_letter("1"), yes)
check("a text's characters from one place to another, counted from 0: \"warp\"[1 .. 3]", "warp"[1 .. 3], "ar")
check("a text's characters from one place to another, counted from 0: \"warp\"[1 ..]", "warp"[1 ..], "arp")
check("a text's characters from one place to another, counted from 0: \"aé€x\"[1 to 2]", "aé€x"[1 to 2], "é€")
coded = "aé€x"
check("a text's characters as codes, decoded from UTF-8", "${#coded.codepoints} ${ord(coded.codepoints#3)} ${text(coded.codepoints#2)}", "4 8364 é")
check("a text's UTF-8 bytes", "${text("aé".bytes)} ${#"".bytes}", "[97, 195, 169] 0")
check("a text repeated: \"ab\" * 3", "ab" * 3, "ababab")
check("a text repeated: \"xy\" * 0", "xy" * 0, "")
check("a text's count, also written length or size, counts its characters: \"abé\".length", "abé".length, 3)
check("a text's count, also written length or size, counts its characters: \"\".count", "".count, 0)
check("a text's count, also written length or size, counts its characters: (1 to 4).size", (1 to 4).size, 4)
check("a character's text, its 2, 3 or 4 UTF-8 bytes", text('ü') + text('€') + text('😀') + " " + text(text('😀').bytes), "ü€😀 [240, 159, 152, 128]")
check("a letter or a digit is alphanumeric", is_alphanumeric("q") and is_alphanumeric("7") and not is_alphanumeric("-"), yes)
check("is_digits: decimal digits only, and at least one: \"123\".is_digits", "123".is_digits, yes)
check("is_digits: decimal digits only, and at least one: \"\".is_digits", "".is_digits, no)
check("is_digits: decimal digits only, and at least one: \"1a\".is_digits", "1a".is_digits, no)
# wiki/string.md: bytes are named `byte_size(text)`, also read as the text's word
check("a text's size in bytes: \"aé\".byte_size", "aé".byte_size, 3)
check("a text's size in bytes: byte_size(\"aé\")", byte_size("aé"), 3)
