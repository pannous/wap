# the forms wiki/thread.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

shared done = false
go { sleep 1s; done = true }
last = after done return "third"
check("after waits on a shared value, await gives its value", await last or "no third", "third")
shared never = false
waiting = after never return "third"
cancel waiting
check("await of a cancelled task gives the fallback", await waiting or "no third", "no third")
