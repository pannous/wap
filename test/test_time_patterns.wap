# date patterns, durations and relative times, lib/time.wap (wiki/library-time-patterns-durations.md)
use time
use "check.wap"

check("an instant in a pattern with names", format("2026-11-04" as Instant, Pattern("EEEE d MMMM yyyy")), "Wednesday 4 November 2026")
check("a text read by a pattern", parse("04.11.2026", Pattern("dd.MM.yyyy")).date, "2026-11-04")
check("a duration's plain text", "1h 30m" as Duration as text, "1h 30m")
check("a duration in words", format("1h30m" as Duration, long: yes), "1 hour 30 minutes")
check("a duration in ISO 8601", format("1h30m" as Duration, iso: yes), "PT1H30M")
check("a relative time", relative_time(0, 7200000), "2 hours ago")
check("times of day, short names, quoted text and two-digit years", format(parse("2026-11-04 14:05:09", Pattern("yyyy-MM-dd HH:mm:ss")), Pattern("EEE, d MMM yy 'at' H:mm")), "Wed, 4 Nov 26 at 14:05")
check("ISO durations read", ["PT1H30M" as Duration as text, "P2DT4H" as Duration as text, "P1W" as Duration as text, "PT0.5S" as Duration as text], ["1h 30m", "2d 4h", "7d", "500ms"])
check("the future and just now", [relative_time(172800000, 0), relative_time(1000, 0)], ["in 2 days", "just now"])
check("dates before 1970 and leap days", [format("1969-12-31" as Instant, Pattern("EEEE")), parse("29.02.2024", Pattern("dd.MM.yyyy")).date], ["Wednesday", "2024-02-29"])
check("a text off the pattern is refused", try parse("2026/11/04", Pattern("yyyy-MM-dd")).date catch e { e.message }, "parse: \"2026/11/04\" does not match \"yyyy-MM-dd\": '-' expected at character 5")
check("an unknown unit is refused", try ("2x" as Duration as text) catch e { e.message }, "\"2x\" as Duration: unknown unit \"x\" after 2 (d, h, m, s or ms)")
