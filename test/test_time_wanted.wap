# the forms wiki/time.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"
use time

d = 2024-01-31
check("a date literal plus a day", d + 1 day, 2024-02-01)
check("a date's field", d.year, 2024)
check("two dates subtract to their days apart", 2024-03-10 - 2024-03-01, 9)
check("a duration times a whole number", 2 hours * 3, 6 hours)
check("a duration in another unit", 1 day in h, 24h)
check("as converts a duration too", 1 day as h, 24h)
check("durations compare when the answer holds on every date: days and hours", 1 day > 2 hours, yes)
check("durations compare when the answer holds on every date: a month and days", 1 month > 27 days, yes)
check("now is an instant", now is instant, yes)
check("a date literal is a date", 2024-06-01 is date, yes)
t = 2024-06-01T12:00Z
check("in places an instant in a zone", text(t in "Europe/Berlin"), "2024-06-01T14:00+02:00[Europe/Berlin]")
