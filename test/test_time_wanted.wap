# the forms wiki/time.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"
use time

d = date 2024-01-31
check("a date literal plus a day", d + 1day, date 2024-02-01)
check("a date's field", d.year, 2024)
check("two dates subtract to their days apart", date(2024-03-10) - date(2024-03-01), 9)
check("a duration times a whole number", 2hours * 3, 6hours)
check("a duration in another unit", 1day in h, 24h)
check("as converts a duration too", 1day as h, 24h)
check("durations compare when the answer holds on every date: days and hours", 1day > 2hours, yes)
check("durations compare when the answer holds on every date: a month and days", 1month > 27days, yes)
check("now is an instant", now is instant, yes)
check("a date literal is a date", date 2024-06-01 is date, yes)
t = date 2024-06-01T12:00Z
check("in places an instant in a zone", text(t in "Europe/Berlin"), "2024-06-01T14:00+02:00[Europe/Berlin]")

check("15:00 is a local time", (15:00).hour, 15)
