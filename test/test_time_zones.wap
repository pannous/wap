# lib/time.wap's zones (wiki/time.md "Time zones"): a zone's offset follows its summer rules, a skipped wall time
# needs a choice
use "check.wap"
use time

berlin = zone_named("Europe/Berlin")
june_noon = days_from_civil(2024, 6, 1) * DAY_SECONDS + 12 * HOUR_SECONDS
check("Berlin is two hours east of UTC in summer", zone_offset(berlin, june_noon), 7200)
check("and one in winter", zone_offset(berlin, days_from_civil(2024, 1, 1) * DAY_SECONDS), 3600)
check("New York is four hours west in summer", zone_offset(zone_named("America/New_York"), june_noon), -14400)
skipped = days_from_civil(2024, 3, 31) * DAY_SECONDS + 2 * HOUR_SECONDS + 1800
check("a skipped wall time taken later is 03:30+02:00", zone_instant(berlin, skipped, Later) - days_from_civil(2024, 3, 31) * DAY_SECONDS, 5400)
check("a skipped wall time is an error unless you choose", try { "${zone_instant(berlin, skipped)}" } catch e { e.message.starts_with("that wall time does not exist in Europe/Berlin") }, yes)
