# the forms wiki/trait.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

check("a number is Comparable", 3 is Comparable, yes)
class aged {name: text; age:int}
compare(a:aged, b:aged) := a.age - b.age
people = [aged("Ann", 40), aged("Bob", 30)]
check("sort uses a class's compare", (sort people)#1.name, "Bob")
check("> uses a class's compare", aged("Ann", 40) > aged("Bob", 30), yes)
class word {spelling: text}
equals(a:word, b:word) := a.spelling.lower == b.spelling.lower
check("== uses a class's equals", word("Hi") == word("hi"), yes)
trait shape { area(); perimeter() }
class square {side:int}
area(s:square) := s.side*s.side
perimeter(s:square) := 4*s.side
check("a class defining a trait's words is of the trait", square(1) is shape, yes)
class bag {a:int; b:int}
iterate(g:bag) := [g.a, g.b]
walked = 0
for item in bag(3, 4) { walked += item }
check("for walks what iterate gives", walked, 7)
# a trait in a value's place is the union of the types that do its words (notes/coc-c2.md, wiki/trait.md "Dispatch")
class circle {r:int}
area(c:circle) := 3*c.r*c.r
perimeter(c:circle) := 6*c.r
check("each item of a mixed list takes its own type's word", [square(2), circle(1)].map(area), [4, 3])
