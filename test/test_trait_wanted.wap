# the forms wiki/trait.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

check("a number is Comparable", 3 is Comparable, yes)
class aged {name: text; age:int}
compare(a:aged, b:aged) := a.age - b.age
people = [aged("Ann", 40), aged("Bob", 30)]
check("sort uses a class's compare", (sort people)#1.name, "Bob")
check("> uses a class's compare", aged("Ann", 40) > aged("Bob", 30), yes)
class word {spelling: text}
equals(a:word, b:word) := a.spelling.lower == b.spelling.lower
check("== uses a class's equals", word("Hi") == word("hi"), yes)
trait shape { area(); perimeter() }
class square {side:int}
area(s:square) := s.side*s.side
perimeter(s:square) := 4*s.side
check("a class defining a trait's words is of the trait", square(1) is shape, yes)
class bag {a:int; b:int}
iterate(g:bag) := [g.a, g.b]
walked = 0
for item in bag(3, 4) { walked += item }
check("for walks what iterate gives", walked, 7)
class circle {r: int}
area(c: circle) := 3 * c.r * c.r
describe(x: T): int := area(x)
shapes: list<shape> = [square(2), circle(1)]
check("a generic call on mixed boxed values picks each type's area", shapes.map(describe), [4, 3])
# wiki/trait.md "Declaring a trait", "Dispatch" and "Comparable" (sort needs Comparable values): each item of a list of a trait takes its own type's word, chosen
# when the program runs
check("each item of a mixed list takes its own type's word", [square(2), circle(1)].map(area), [4, 3])
ranked: list<Comparable> = [aged("Ann", 40), aged("Bob", 30)]
check("a list of a trait sorts by each item's compare", ((sort ranked)#1 as aged).name, "Bob")
class rect: shape {w: int; h: int}
area(r: rect) := r.w * r.h
perimeter(r: rect) := 2 * (r.w + r.h)
claimed: list<shape> = [square(2), rect(2, 3)]
check("a class that claims a trait is held as the trait too, each item takes its own word", claimed.map(describe), [4, 6])
# wiki/trait.md "Declaring a trait": a default body names its receiver as its first parameter
trait doubling { area(); doubled(s) := area(s) * 2 }
class crate {side: int}
area(c: crate) := c.side
check("a default word names its receiver and calls the words of its class", doubled(crate(3)), 6)
# a default's receiver may be typed as the trait, `doubled(s: shape)`, the same receiver as a bare one
trait sizing { area(); twice(s: sizing) := area(s) * 2 }
check("a default word's receiver typed as its trait", twice(crate(3)), 6)
