# the examples of wiki/truthiness.md, each as the page writes it
use "check.wap"

check("an empty text is falsy", if '' then "truthy" else "falsy", "falsy")
check("0.0 is falsy", if 0.0 then "truthy" else "falsy", "falsy")
check("a list holding 0 is truthy", if [0] then "truthy" else "falsy", "truthy")
check("a map with a field is truthy, whatever it holds", if {x:0} then "truthy" else "falsy", "truthy")
check("and gives its second operand when the first is truthy", 7 and "hi", "hi")
check("or gives its second operand when the first is falsy", 0 or 5, 5)
check("a condition reads the truthiness of or's result", if 0 or 5 then 1 else 2, 1)
check("and/or is not if/else: a falsy middle falls through", 1 and 0 or 2, 2)
name = ""
check("or gives a default for an empty text", name or "anonymous", "anonymous")
nothing: int? = ø
check("or gives a default for a missing value", nothing or 3, 3)
count: int? = 0
check("a known zero equals 0", count == 0, yes)
check("a known zero is not missing", count is ø, no)
