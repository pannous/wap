# the forms wiki/truthiness.md shows that wap does not build yet: each red line is a to-do
use "check.wap"

check("and gives its first operand when it is falsy", 0 and "hi", 0)
# a typed optional given ø is refused as "no place to assign" (`x: int? = ø`)
absent: int? = ø
check("or gives a default for a missing value", absent or 3, 3)
