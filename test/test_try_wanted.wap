# the forms wiki/try.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

inventory = {a: 1}
try item = inventory["b"] else "invalidSelection"
check("try … else gives a missing value's fallback to the name", item, "invalidSelection")
stock = 0
check("assert … else raises its text", try { assert stock > 0 else "outOfStock" } catch e { e.message }, "outOfStock")
guarded_sign(n: int): int := {
	try {
		if n < 0 { raise "negative" }
		return n
	} catch error {
		return -1
	}
}
check("return inside try and inside catch leaves the function with its value", [guarded_sign(3), guarded_sign(-3)], [3, -1])
