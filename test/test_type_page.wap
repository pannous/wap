# the examples of wiki/type.md, each as the page writes it
use "check.wap"

i:integer=7
check("a type after a colon types a variable", i, 7)
class Leaf {name: text?; v:int}
check("a field typed with ? may hold ø", Leaf(ø, 3).v, 3)
letters: list of char = ['a', 'b']
check("list of types a list", #letters, 2)
fib(n: int) as int := if n < 2 then n else fib(n - 1) + fib(n - 2)
check("a typed argument names its type after a colon", fib(10), 55)
class Address{street: text; city: text?}
class Contact{name: text; email: text?; address: Address}
ann = Contact("Ann", ø, Address("Main", ø))
check("typed classes nest, an optional field last", ann.address.street, "Main")

# the rewritten page (types are values)
check("is tests a value's type", 3 is int, yes)
k = 7 as int
check("as types a value", k, 7)
typed_fib(n: int): int := if n < 2 then n else typed_fib(n - 1) + typed_fib(n - 2)
check("a result type after a colon", typed_fib(10), 55)
class Point { x: int; y: int }
check("a class is a type with fields", Point(1, 2).y, 2)
enum Tree { leaf(value: int), branch(children: list<Tree>) }
check("an enum may nest itself under a list", branch([leaf(1)]) is Tree, yes)
held: any = [1, "a"]
taken: int = held#1
check("the way from any to a type is a check", taken, 1)
# a type before the name declares it (wiki/type.md "Writing a type": `int j = 7`)
int j7 = 7
check("int j = 7", j7, 7)
class Spot { x: int; y: int }
Spot spot = Spot(1, 2)
check("a class before the name: Point p = Point(1, 2)", spot.x, 1)
text t9 = "a"
check("text t = \"a\"", t9 + "b", "ab")
bool b9 = yes
check("bool b = yes", b9, yes)
# type of gives a value's type, as the compiler knows it ("The type of a value"); a type's type is Type
check("type of gives a value's type", ["${type of 3}", "${type of [1, 2]}"], ["int", "list<int>"])
check("a type has a type: type of int is Type", "${type of int}", "Type")
either: int or text = 3
check("a union holds a value of either type", either, 3)
worded: int | text = "three"
check("| writes a union too", worded, "three")
check("is tests a union", 3 is (int or text), yes)
described(n: int) := "number"
described(t: text) := "text"
check("a call on a union picks the definition that takes the value", described(either), "number")
check("a call on a union picks the definition that takes the value, a text", described(worded), "text")
