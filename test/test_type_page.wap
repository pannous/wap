# the examples of wiki/type.md, each as the page writes it
use "check.wap"

i:integer=7
check("a type after a colon types a variable", i, 7)
class Leaf {name: text?; v:int}
check("a field typed with ? may hold ø", Leaf(ø, 3).v, 3)
letters: list of char = ['a', 'b']
check("list of types a list", #letters, 2)
fib(n: int) as int := if n < 2 then n else fib(n - 1) + fib(n - 2)
check("a typed argument names its type after a colon", fib(10), 55)
