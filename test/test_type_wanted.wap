# the forms wiki/type.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

either: int or text = 3
check("or joins types", either, 3)
piped: int | text = "three"
check("| joins types too", piped, "three")
three = 3
check("is tests a union", three is (int or text), yes)
same(v: int or text) := v
check("a union types a parameter", [same(2), same("a")], [2, "a"])
small(x: int or text) := if x is int then x else 0
check("a comparison after a union-typed call applies to its result", small 2 < 3, yes)
class Tree {left: Tree?; v:int}
check("an optional field may be left out", Tree(v: 3).v, 3)
class Adder { k: int; call(x) := x + k }
adder = Adder(1)
check("an instance with call is called like a function", [adder(2), Adder(10)(2)], [3, 12])
check("|> passes a value to a callable instance", 2 |> adder, 3)
class person {}
class dog {}
to kill a person { "BYE!" }
to kill a dog { "WUF!" }
check("to … a class dispatches on the class", kill dog(), "WUF!")
check("Kotlin's Int is int", Int(3) + 1, 4)
check("type reports a list's inferred element type", text(type([1/2, 3/4])), "list of exact")

# the rewritten page (types are values)
check("type of a value", [type of 3, type of [1, 2], type of "a"], [int, list<int>, text])
check("a type has a type", type of int, Type)
check("a type computes: vector(int, 2 + 1) is vector(int, 3)", vector(int, 2 + 1) == vector(int, 3), yes)
int j = 7
check("a type before the name", j, 7)
type Long = int
check("type names a type", 3 is Long, yes)
fibonacci number := if number < 2 then number else fibonacci(number - 1) + fibonacci(number - 2)
check("a parameter named like a type is of that type", fibonacci 10, 55)
switching: int or text = 1
switching = "a"
check("a union lets a name change its type", switching, "a")
check("a list of unlike items holds their union", type of [1, "a"], list<int or text>)
dot(a: vector(number, n), b: vector(number, n)): number := sum(a .* b)
check("one-letter names are found from the arguments", dot([1, 2, 3], [4, 5, 6]), 32)
append(a: vector(T, m), b: vector(T, n)): vector(T, m + n) := a + b
check("a result type computed from the arguments' types", type of append([1], [2, 3]), vector(int, 3))
at(xs: list<T>, i: index(xs)): T := xs#i
check("a parameter's type names the parameter before it", at([5, 6], 2), 6)
check("3 * char is a vector of chars", 3 * char, vector(char, 3))
class Pair<A, B> { first: A; second: B }
check("a class takes type arguments", Pair(1, "a").second, "a")
enum Expression { number(n: int), block(body: list<Statement>) }
enum Statement { show(e: Expression), assign(name: text, e: Expression) }
check("two enums name each other", block([show(number(1))]) is Expression, yes)
describe(n: int) := "number"
describe(t: text) := "text"
s: int or text = 3
check("a call on a union picks the definition that takes the value", describe(s), "number")
check("a function type", type of ((n: int) -> text), Type)
spelled: int[] = [1, 2]
bracketed: [int] = [3]
check("int[] and [int] spell list of int", ["${type of spelled}", "${type of bracketed}"], ["list<int>", "list<int>"])
paired: Pair<int, text> = Pair(1, "a")
check("a class's instance takes its letters from the type its place expects", paired.second + "b", "ab")
