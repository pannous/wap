# wap's typed rules (stage 3, decision hole-types): a rule with a hole of a value type fires on code whose type is
# settled, and what it writes is typed again
use "check.wap"

fires(x: int) := x
rule fires $x: int => 9
check("a typed rule fires on its type", (fires 3), 9)
other(x: int) := x
rule other $x: text => 9
check("a typed rule leaves another type alone", (other 3), 3)
again(x: int) := x
thrice(x: int) := 8
rule again $x: int => thrice $x
check("what a typed rule writes is typed again", (again 3), 8)
untyped(x) := x
rule untyped $x: text => 4
check("a typed rule sees the type a parameter without one was called with", (untyped "a b"), 4)
# a generic's bare name in a hole takes it with any parts: `$m: map` any map, `$xs: list` any list
size_of(x) := 0
rule size_of $m: map => 7
rule size_of $xs: list => 3
check("a hole of a bare generic type takes any of its instances: (size_of {\"a\": 1})", (size_of {"a": 1}), 7)
check("a hole of a bare generic type takes any of its instances: (size_of [1, 2])", (size_of [1, 2]), 3)
check("a hole of a bare generic type takes any of its instances: (size_of 5)", (size_of 5), 0)
# a typed rule fires as typing writes the code, so the code around it reads the type the rule gives, and the function
# values typing lifted are never typed again (warp-lead, 2026-11-20, typed-rules-ordering)
placed(t: text) as text := t
rule placed $x: text => 4
placed_value = placed "a b"
added(n: int) := {
	f = y => y + n
	f(5)
}
check("a typed rule's code is typed where it stands, beside a function value: placed_value + 1", placed_value + 1, 5)
check("a typed rule's code is typed where it stands, beside a function value: added(2)", added(2), 7)
# a word only a typed rule defines: its call is offered to the typed rules (rules/typed.wap's header, `twice 3`)
rule twice $x: int => $x + $x
check("a typed rule's word needs no function of that name", (twice 3), 6)
