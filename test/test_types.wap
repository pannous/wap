# wap's typing stage (core/analyze/types.wap): every value's type, and the function each call means. A call picks
# among a name's definitions by its arguments' types, then by the type wanted; a parameter without a type makes one
# version of the function per tuple of argument types. Source: the lead's typing interface (notes/backbone.md).
# The checks that declare a name the preload has too are in test_types_own.wap; test/wap/test_types.sh keeps the one
# that a class of the same fields declared beside it breaks
use "check.wap"

by_argument(x: int) := 1
by_argument(x: text) := 2
check("a call picks the definition its argument's type fits", (by_argument "ab"), 2)
by_result(): int := 4
by_result(): float := 2.5
wanted: int = by_result()
check("a call picks the definition whose result is the type wanted", wanted, 4)
untyped(x) := x
untyped_text = untyped "ab"
check("a parameter without a type takes each type it is called with", (untyped 5), 5)
same(n: int): int := n
check("a written result type", same(6), 6)
typed_variable: int = 3
check("a typed variable", typed_variable, 3)
first_of_two(a: int, b: text) := a
check("two typed parameters", first_of_two(3, "b"), 3)
check("a bool beside an int counts as 1 or 0, as == compares loosely", [0 == no, yes == 1, 2 == yes, no == no], [yes, yes, no, yes])
class P { x: int }
x_of(p: P) := p.x
check("a one-letter name the program declares is that type, not a generic letter", x_of(P(4)) + 1, 5)
check("=== is equal and of one type", [1 === 1, 0 === no, "ab" === "ab", 1 !== 2], [yes, no, yes, yes])
plus_one(x: int?) := if x != ø then x + 1 else 0
check("an optional int takes an int or ø, its value read where a condition found it present, ?? giving a default", [plus_one(4) + plus_one(ø), ø ?? 3], [5, 3])
# any holds every value, number an int or a float (core/node.warp's Data(value: any))
one_of_any(x: any) := 1
check("any value fits any", one_of_any(3) + one_of_any("ab") + one_of_any([1]) + one_of_any(2.5), 4)
two_of_number(x: number) := 2
check("an int or a float fits a number", two_of_number(3) + two_of_number(2.5), 4)
# a function's written result type is its type, whatever its body gives that fits it
nothing_of(a: int) as int? := ø
one_of_optional(x: int?) := 1
check("the written result type wins", text(missing(nothing_of(1))) + " " + text(one_of_optional(nothing_of(1))), "yes 1")
enum Holder { Held(value: any) }
check("a case with an any field shows it", show(Held(3)), "Held(3)")
# a name given only ø holds an optional whose type its uses settle; a generic function given a type not settled yet is
# typed once it is
held = ø
count_of(xs: list<T>): int := #xs
late = []
counted = count_of(late)
late += [5]
check("a name given only ø is an optional of the type its uses give", [text(missing(held)), text(if missing(held) then 3 else held!), text(counted + #late)], ["yes", "3", "1"])
anys: list<any> = [1, 2.5, "a b", yes]
check("a list of any holds values of several types", anys.map(x => show(x)), ["1", "2.5", '"a b"', "yes"])
# `x is w`: a type's word tests the type, a predicate's word calls it (wiki keyword.md: `x = []; x is empty` is yes)
nothing_yet = []
even(n: int): bool := n % 2 == 0
check("is with a predicate word calls it", [nothing_yet is empty, "a" is empty, 4 is even, 3 is int], [yes, no, yes, yes])
# a char literal where a letter bound to text is wanted reads as that text, as where text is written
letters: list<text> = ["a", "bc"]
has_key(m: map<K, V>, key: K): bool := yes
check("a char literal for a letter bound to text", [letters.contains("a"), {a: 1}.has_key("c")], [yes, yes])
first_char(c: codepoint): char := c
check("codepoint is another name of the char type", text(first_char('a')), "a")
narrowed(n: number) := if n is int then n + 1 else 0
check("a number tested for int is an int where the test holds", [narrowed(3), narrowed(2.5)], [4, 0])
check("a value as a type is the type's function of it", (97 as codepoint as text) + (Op.Add as text) + (3 as text), "a+3")
class Q { x: int }
check("two lists and two instances are equal by their parts", [[1, 2] == [1, 2], [1, 2] == [1, 3], Q(1) == Q(1), Q(1) != Q(2)], [yes, no, yes, yes])
as_int(x: any): int := prim cast(x)
as_text(x: any): text := prim cast(x)
check("an any cast to the type it holds", [text(as_int(3) + 1), as_text("ab")], ["4", "ab"])
cs: list<char> = ["a", "b"]
read_char = ""
read_char = cs[1]
char_at(at: int) as text := cs[at]
XS = ["a", "b"]
letter_at(i: int) as text? := {
	if i > 0 { return XS#i }
	ø
}
check("a character is read as its text wherever a text is wanted", [read_char, char_at(0), letter_at(1) ?? "none", letter_at(0) ?? "none"], ["b", "a", "a", "none"])
kind_of(t: Node?) as text := if t is text then "text" else if t is symbol then text(t) else "other"
is_text(x: text) as bool := x is text
check("a kind word after is on a Node tests its case, beside a maker of that name; on a text it is the type", [kind_of(Text("b")) + kind_of(symbol("a")) + kind_of(Empty), text(is_text("a"))], ["textaother", "yes"])
optionals(x: int) as list<int?> := [x]
class C { ps: list<int?> = [] }
d: list<int?> = [1, 2]
check("a list of optionals is the type of a result, a field or a variable", [#optionals(1), #C().ps, #d], [1, 0, 2])
