# A letter the program declares is that type in the program's own code only: the types module's generic words that
# write the same letter stay generic. Its own file, since the declaration holds for every line of the file.
# Source: wiki/type.md "Foreign type names and generic letters".
use "check.wap"
enum T { tee, tea }
check("an enum T leaves the types module's list<T> generic: [1, 2].reverse()", [1, 2].reverse(), [2, 1])
check("an enum T leaves the types module's list<T> generic: [\"x\", \"y\"].join(\",\")", ["x", "y"].join(","), "x,y")
check("an enum T is that type in the program's own code: [T.tea, T.tee].reverse()#1 == T.tee", [T.tea, T.tee].reverse()#1 == T.tee, yes)
