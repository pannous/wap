# wap's typing stage (core/analyze/types.wap), the checks beside a name the types module has too (===, int, Program):
# kept apart from test_types.wap, where the types module's own ones are tested
use "check.wap"

front(xs: list<T>): T := xs#1
check("a one-letter type is generic, every T of a signature the same, the more specific overload wins: text(1 === 1)", text(1 === 1), "yes")
check("a one-letter type is generic, every T of a signature the same, the more specific overload wins: text(0 === false)", text(0 === false), "no")
check("a one-letter type is generic, every T of a signature the same, the more specific overload wins: text(\"ab\" === \"ab\")", text("ab" === "ab"), "yes")
check("a one-letter type is generic, every T of a signature the same, the more specific overload wins: text(front([7, 8]) + 1)", text(front([7, 8]) + 1), "8")
check("a one-letter type is generic, every T of a signature the same, the more specific overload wins: front([\"x\", \"y\"])", front(["x", "y"]), "x")
check("a type's word after is tests the type, even beside a function of that name", 3 is int, yes)
class Program { m: int }
p = Program(3)
check("a program's own class shadows the types module's of the same name", p.m, 3)
# wiki/function.md: a program adds to a library function for a type it declares, the library's own staying
count(program: Program) := program.m * 10
check("a program's method of a library word for its own type, beside the library's", [count(p), count([1, 2])], [30, 2])
# a program's own name shadows the types module's nat, zero, successor, recursor and int32 in every position (wiki/type.md "a program's own `class Int` shadows them", wiki/Footguns.md "Parameter shadowing", module-alias-preload: a file's own name beats the library's)
bumped(nat: int): int := nat + 1
check("a parameter named nat is the argument", bumped(1), 2)
zeroed(): int := { zero = 5; zero + 1 }
check("a local named zero is the value", zeroed(), 6)
class Pair { successor: int }
check("a field named successor is the field", Pair(3).successor, 3)
enum Step { recursor; stop }
s: Step = recursor
check("an enum case named recursor, reached bare through the expected type, is the case", text(s), "recursor")
int32 = 7
check("a global named int32 is the value", int32 + 1, 8)
