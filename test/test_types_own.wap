# wap's typing stage (core/analyze/types.wap), the checks whose program declares a name the types module has too (===,
# int, Program): kept apart from test_types.wap, where the types module's own ones are tested
use "check.wap"

===(a: T, b: T) := a == b
===(a, b) := no
first(xs: list<T>): T := xs#1
check("a one-letter type is generic, every T of a signature the same, the more specific overload wins: text(1 === 1)", text(1 === 1), "yes")
check("a one-letter type is generic, every T of a signature the same, the more specific overload wins: text(0 === false)", text(0 === false), "no")
check("a one-letter type is generic, every T of a signature the same, the more specific overload wins: text(\"ab\" === \"ab\")", text("ab" === "ab"), "yes")
check("a one-letter type is generic, every T of a signature the same, the more specific overload wins: text(first([7, 8]) + 1)", text(first([7, 8]) + 1), "8")
check("a one-letter type is generic, every T of a signature the same, the more specific overload wins: first([\"x\", \"y\"])", first(["x", "y"]), "x")
int(t: text): int := 7
check("a type's word after is tests the type, even beside a function of that name", 3 is int, yes)
class Program { m: int }
p = Program(3)
check("a program's own class shadows the types module's of the same name", p.m, 3)
