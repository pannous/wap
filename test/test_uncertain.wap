# uncertain values, lib/uncertain.wap (wiki/number.md: Uncertain values)
use uncertain
use "check.wap"

check("worst-case intervals add their radii", text((5 ± 1) + (2 ± 1)), "7.0 ± 2.0")
check("a product shows only the digits its spread justifies", text((6.0 ± 0.3) * (2.0 ± 0.2)), "12.0 ± 1.9")
check("its bounds keep a guard digit", [low_bound((6.0 ± 0.3) * (2.0 ± 0.2)), high_bound((6.0 ± 0.3) * (2.0 ± 0.2))], [10.26, 13.86])
check("an interval met twice is not correlated", text((5 ± 1) - (5 ± 1)), "0.0 ± 2.0")
check("comparisons answer yes only when certain", [(5 ± 1) > (2 ± 1), (5 ± 1) > (4 ± 1)], [yes, no])
