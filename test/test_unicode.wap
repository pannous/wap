# Unicode normalization and case folding, lib/unicode.wap (wiki/library-unicode.md)
use unicode
use "check.wap"

check("NFC composes", nfc(text_of_codepoints([101, 769])) == "é", yes)
check("NFD decomposes", codepoint_numbers(nfd("é")), [101, 769])
check("case folding is full", casefold("Straße") == casefold("STRASSE"), yes)
check("NFKC maps compatibility characters", nfkc("ﬁ ①"), "fi 1")
check("İ folds to i and a dot above, the Turkic mappings not applied", codepoint_numbers(casefold("İI")), [105, 775, 105])
check("Hangul composes and decomposes by arithmetic", [codepoint_numbers(nfd("한")), codepoint_numbers(nfc(text_of_codepoints([4370, 4449, 4523])))], [[4370, 4449, 4523], [54620]])
check("marks in canonical order", codepoint_numbers(nfd(text_of_codepoints([113, 775, 803]))), [113, 803, 775])
check("is_normalized in every form, a form named in any case", [is_normalized("é", "NFC"), is_normalized("é", "nfd"), is_normalized("ﬁ", "NFKC"), is_normalized("abc", "Nfkd")], [yes, no, no, yes])
check("an unknown form is refused", try unicode_normalize("x", "NFX") else "refused", "refused")
check("combining classes", [combining_class(769), combining_class(65)], [230, 0])
