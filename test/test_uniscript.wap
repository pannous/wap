# uniscript's full case mappings, lib/uniscript.wap (wiki/Footguns.md "Case mapping": locale-independent Unicode
# default mapping)
use uniscript
use "check.wap"

check("upper case is full and locale-independent", unicode_upper("straße ı i é"), "STRASSE I I É")
check("lower case is full", unicode_lower("İ ÀÉ Ж"), "i̇ àé ж")
