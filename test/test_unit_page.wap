# the examples of wiki/unit.md, each as the page writes it (those test_units.wap does not already hold)
use "check.wap"
use units

check("0°C is 32°F", 0°C == 32°F, yes)
check("temperatures add in one unit", text(20°C + 5°C), "25°C")
check("a degree is exact", 30° == π/6, yes)
check("a quantity prints in the unit it was written in", text(120min), "120min")
d = 3km
check("an interpolation shows the unit", "${d}", "3km")
total = 0m
for i in 1..3 { total += 5m }
check("quantities add in a loop", text(total), "10m")
p = {dist: 0m}
p.dist += 250m
check("a field keeps its unit", text(p.dist), "250m")
check("a glued unit beats a number suffix", text(2L), "2L")
