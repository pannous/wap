# the forms wiki/unit.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"
use units

check("as converts a temperature", text(40°C as °F), "104°F")
check("as picks the unit shown", text(2500m as km), "2.5km")

m = 4
check("a glued unit wins over a variable", "${3m}", "3 m")
