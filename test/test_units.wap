# quantities with units, lib/units.wap (wiki/unit.md)
use units
use math
use "check.wap"

check("a unit glued to its number, short or long", 3km + 10m == 3010meters, yes)
check("in counts a quantity in a unit", 90minutes in hours, 1.5)
check("a quantity prints in the unit it was written in", [text(2h), text(120min)], ["2h", "120min"])
check("a sum of two time units", 2h + 30min == 2.5h, yes)
check("a temperature converted", text((40°C).to(°F)), "104°F")
check("temperatures compare from their zeros", 0°C == 32°F, yes)
check("temperatures add in one unit", text(20°C + 5°C), "25°C")
check("temperatures in two units refuse to add", try text(20°C + 50°F) else "refused", "refused")
speed(d: Quantity, t: Quantity): Quantity := d / t
check("a quotient of quantities", text(speed(10km, 2h)), "5km/h")
total = 0m
for i in 1 upto 3 { total += 5m }
check("a quantity summed in a loop", text(total), "10m")
check("a quantity shown in another unit", text((2500m).to(km)), "2.5km")
check("units read from text", quantity("5 km") + quantity("500 m") in m, 5500.0)
check("a power of a unit", text(9.81m/s²), "9.81m/s²")
check("quantities of two dimensions don't add", try text(3m + 2s) else "DimensionError", "DimensionError")
check("a degree is π/180", round(sin(30°) * 1e12) / 1e12, 0.5)
