# the examples of wiki/universe.md that wap builds, each as the page writes it
use "check.wap"

identity(a: T): T := a
check("one definition serves a value", identity(3), 3)

# universe.md: Type is the universe of data types, `list<int>`, every class
check("a list type is a data type, in Type", text(type of list<int>), "Type")
class Pair<T> { first: T; second: T }
check("a generic class given its letter is a data type, in Type", text(type of Pair<int>), "Type")
