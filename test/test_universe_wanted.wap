# the forms wiki/universe.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

check("the type of a value", type of 3, int)
check("the type of a data type is Type", type of int, Type)
check("Type is no Type: it is a Type(1)", type of Type, Type(1))
check("the type of a proposition is Prop", type of (1 == 1), Prop)
check("Prop is a Type", type of Prop, Type)
check("Prop is Sort(0), Type is Sort(1)", [Sort(0), Sort(1), Sort(2)], [Prop, Type, Type(1)])
check("a function type between data is a Type", type of ((n: int) -> text), Type)
check("a function type over every type is a Type(1)", type of ((A: Type) -> A), Type(1))
check("a statement about all propositions is a proposition", type of ((A: Prop) -> A), Prop)
identity(a: T): T := a
check("one definition serves a type", identity(int), int)
check("one definition serves a universe", identity(Type), Type)
pair_type(A: Type(u), B: Type(v)): Type(max(u, v)) := Pair<A, B>
check("level letters are found by the compiler", pair_type(int, text), Pair<int, text>)
check("a pair holding a type lives a level up", type of pair_type(int, Type), Type(1))
check("a level written in brackets", [identity[1](int, 3), identity[2](Type, int)], [3, int])
check("a function type into types is a Type(1)", type of ((n: int) -> Type), Type(1))
class Spot { x: int }
check("a function type from a record is a Type", type of ((p: Spot) -> int), Type)
type Long = int
check("an alias is the type it names", Long, int)
written_identity(T: Sort(u), a: T): T := a
check("a level written in brackets gives a definition its levels", written_identity[1](text, "a"), "a")
check("the type given first is the type of the value after it", written_identity(text, "a") + "b", "ab")
check("a definition at a written level has the type of that level", text(type of written_identity[1]), "(T: Type) -> T -> T")
