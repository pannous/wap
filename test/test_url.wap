# URLs, query strings, IP addresses and e-mail addresses, lib/url.wap (wiki/library-url.md)
use url
use "check.wap"

check("percent-encoding of UTF-8 bytes", url_encode("Grüße, 100%"), "Gr%C3%BC%C3%9Fe%2C%20100%25")
check("percent-decoding, a stray % kept", [url_decode("caf%c3%a9"), url_decode("100%zz")], ["café", "100%zz"])
check("a query read as a map", query_map("a=1&b=x+y"), {a: "1", b: "x y"})
check("a map as a query", query_text({a: "1", q: "wap & wasm"}), "a=1&q=wap%20%26%20wasm")
check("a URL's parts", parse_url("https://u:p@example.com:8080/a?q=1#top").host, "example.com")
check("a URL's port", parse_url("https://u:p@example.com:8080/a?q=1#top").port, 8080)
check("a URL written back", url_text(parse_url("http://[::1]:80/x")), "http://[::1]:80/x")
check("references resolved", ["../g", "../../../g", "?y", "g;x?y#s", "//g", "./g/."].map(r => resolve_url("http://a/b/c/d;p?q", r)), ["http://a/b/g", "http://a/g", "http://a/b/c/d;p?y", "http://a/b/c/g;x?y#s", "http://g", "http://a/b/c/g/"])
check("canonical IP texts", [ip_text("2001:0db8:0000:0000:0000:0000:0000:0001"), ip_text("::ffff:1.2.3.4")], ["2001:db8::1", "::ffff:1.2.3.4"])
check("strict IPv4", [is_ipv4("01.2.3.4"), is_ipv4("1.2.3.4"), ipv4_int("10.0.0.1") == 167772161], [no, yes, yes])
check("networks", [cidr_contains("10.0.0.0/8", "10.2.3.4"), cidr_contains("10.0.0.0/8", "11.2.3.4"), cidr_contains("2001:db8::/32", "2001:db8::1")], [yes, no, yes])
check("e-mail addresses", [is_email("a.b@example.com"), is_email("a..b@example.com"), is_email("a@b")], [yes, no, no])
