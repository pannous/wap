# the examples of wiki/use.md, each as the page writes it
use "check.wap"
import math

check("import is another spelling of use", floor 2.5, 2.0)
version = 2
check("version is a plain name where no version follows", version + 1, 3)
clamp(x) := 0
check("a definition with another number of arguments adds to the module's word", clamp(5, 1, 3), 3)
# a standard module's words work without its `use`: naming hex_encode brings encoding in
check("a standard module's word works without its use", hex_encode([255, 1]), "ff01")
