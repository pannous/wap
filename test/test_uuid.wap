# random version 4 UUIDs, checking and parsing them, lib/uuid.wap (wiki/library-uuid.md)
use uuid
use "check.wap"

check("a new UUID is one", is_uuid(uuid()), yes)
check("a UUID's length", #uuid(), 36)
check("a text that is no UUID", is_uuid("not-a-uuid"), no)
check("a UUID's bytes", uuid_parsed("123e4567-e89b-12d3-a456-426614174000"), [18, 62, 69, 103, 232, 155, 18, 211, 164, 86, 66, 102, 20, 23, 64, 0])
check("a new UUID's version and variant", "${uuid()[14:15]} ${"89ab".contains(uuid()[19:20])}", "4 yes")
check("two new UUIDs differ", uuid() != uuid(), yes)
