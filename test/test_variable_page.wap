# the examples of wiki/variable.md, each as the page writes it
use "check.wap"

global total = 0
bump() := { total = total + 1 }
bump()
check("a global is written by a plain = in any function", total, 1)
x: int? = 5
check("x! unwraps an optional", x! * 2, 10)
p = {b: 4}
check("p. b reads as p.b", p. b, 4)
n = 1
hide() := { let n = 2; n }
hide()
check("let inside a function hides main's name", n, 1)
global shown = 1
change() := { shown = 2 }
change()
check("global changes main's name", shown, 2)
colors = {red: (1 0 0), green: (0 1 0)}
circle = {radius: 5, color: colors.red}
check("a path names a neighbor's value", circle.color, [1, 0, 0])
