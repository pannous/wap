# the forms wiki/variable.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "check.wap"

nested = {a: 4, b: {a: 5}}
check("a map inside a map keeps its own a", nested.b.a, 5)
xs = [3, 1, 2]
xs.sort!
check("a method's ! changes the receiver in place", xs, [1, 2, 3])
def f(n, i=2) = n + i
check("def takes a default parameter", f(3), 5)
check("twice repeats a value", twice "ab", "abab")
check("thrice repeats a value", thrice "ab", "ababab")
pair = 1, 2
check("a comma list after = is the whole value", pair, [1, 2])
y:2
check("y:2 at main level binds y", y, 2)
repeat_twice(action: block) := { action(); action() }
written = 0
repeat_twice { written += 1 }
check("a block given as an argument writes the caller's names", written, 2)
