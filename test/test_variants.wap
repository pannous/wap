# wap's enums and variants (wap/kernel/forms.wap Record; wiki/enum.md, wiki/variant.md): an enum names its cases, each a
# value of the enum's type; a case may carry fields, and match takes it apart. The checks of other enums with cases of
# the same names are in test_variants_named.wap and test_variants_shown.wap
use "check.wap"

enum Coin { Penny, Nickel, Dime }
enum Fixity { Prefix, Infix, Postfix }
enum Shape { Circle(r: int), Dot }
coin = Dime
check("a case is its own value", match coin { Dime => "dime"; _ => "other" }, "dime")
value(c: Coin): int := match c { Penny => 1; Nickel => 5; Dime => 10 }
check("match chooses by case", value(Nickel) + value(Dime), 15)
area(s: Shape): int := match s { Circle(r) => r * r; Dot => 0 }
check("a case with fields taken apart", area(Circle(3)) + area(Dot), 9)
enum Tree { Leaf(value: int), Pair(left: int, right: int), Nothing }
sum(t: Tree): int := match t { Leaf(v) => v; Pair(a, b) => a + b; Nothing => 0 }
check("cases of one, two and no fields", sum(Pair(3, 4)) + sum(Leaf(5)) + sum(Nothing), 12)
enum Word { Named(name: text), Unnamed }
check("a case with a text field", match Named("hi") { Named(n) => n; Unnamed => "none" }, "hi")
check("two cases of a plain enum differ by ==", if Prefix == Infix then "same" else "differ", "differ")
fixity = Infix
check("a case equals itself", if fixity == Infix and fixity != Postfix then "same" else "differ", "same")
circle = Circle(2)
check("is tests a case with fields by its tag", if circle is Circle then "circle" else "other", "circle")
check("a case is of its enum", if Dime is Coin then "yes" else "no", "yes")
check("cases of two enums differ", if Penny == Prefix then "same" else "differ", "differ")
enum Duo { Two(a: Shape, b: int) }
score(p: Duo): int := match p { Two(Dot, n) => n; Two(Circle(r), 0) => r; Two(Circle(r), n) => r * n }
check("a case pattern tests its fields by their own patterns", [score(Two(Dot, 3)), score(Two(Circle(5), 0)), score(Two(Circle(2), 4))], [3, 5, 8])
size(s: Shape): int := match s { Circle(1) => 10; Circle(r) => r; Dot => 0 }
check("a field's pattern may be a value", size(Circle(1)) + size(Circle(7)), 17)
check("an enum's value as text is its case's name", [text(Coin.Dime), "${Bracket.Round} ${Coin.Penny}"], ["Dime", "Round Penny"])
# a case with a spelling converts to that text and back and equals it; a case without one is spelled by its name
# (wiki/enum.md "Cases with spellings")
enum Level { Error, Warning = "warn", Hint }
check("a case is spelled by its text, or else its name", [Level.Warning as text, Level.Error as text, show("warn" as Level)], ["warn", "Error", "Warning"])
check("a case equals its spelling", Level.Warning == "warn", yes)
# a case's field may hold a function, its type written as a class field's is (wiki/variant.md)
enum Step { Run(f: (int) -> int), Skip }
stepped = Run(x => x + 1)
check("a case's field of a function type", match stepped { Run(f) => text(f(1)); Skip => "-" }, "2")
# a case named like a type or form, `Range`, is still only its enum's case
enum Reach { Range, Point }
check("a case named like a type is its enum's own", [text(Reach.Point), show(Reach.Point), text(Reach.Range)], ["Point", "Point", "Range"])
