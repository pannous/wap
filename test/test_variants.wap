# wap's enums and variants (wap/kernel/forms.wap Record; wiki/enum.md, wiki/variant.md): an enum names its cases, each a
# value of the enum's type; a case may carry fields, and match takes it apart. The checks of other enums with cases of
# the same names are in test_variants_named.wap and test_variants_shown.wap
use "check.wap"

enum Coin { Penny, Nickel, Dime }
enum Fixity { Prefix, Infix, Postfix }
enum Shape { Circle(r: int), Dot }
coin = Dime
check("a case is its own value", match coin { Dime => "dime"; _ => "other" }, "dime")
value(c: Coin): int := match c { Penny => 1; Nickel => 5; Dime => 10 }
check("match chooses by case", value(Nickel) + value(Dime), 15)
area(s: Shape): int := match s { Circle(r) => r * r; Dot => 0 }
check("a case with fields taken apart", area(Circle(3)) + area(Dot), 9)
enum Tree { Leaf(value: int), Pair(left: int, right: int), Nothing }
sum(t: Tree): int := match t { Leaf(v) => v; Pair(a, b) => a + b; Nothing => 0 }
check("cases of one, two and no fields", sum(Pair(3, 4)) + sum(Leaf(5)) + sum(Nothing), 12)
enum Word { Named(name: text), Unnamed }
check("a case with a text field", match Named("hi") { Named(n) => n; Unnamed => "none" }, "hi")
check("two cases of a plain enum differ by ==", if Prefix == Infix then "same" else "differ", "differ")
fixity = Infix
check("a case equals itself", if fixity == Infix and fixity != Postfix then "same" else "differ", "same")
circle = Circle(2)
check("is tests a case with fields by its tag", if circle is Circle then "circle" else "other", "circle")
check("a case is of its enum", if Dime is Coin then "yes" else "no", "yes")
enum Duo { Two(a: Shape, b: int) }
score(p: Duo): int := match p { Two(Dot, n) => n; Two(Circle(r), 0) => r; Two(Circle(r), n) => r * n }
check("a case pattern tests its fields by their own patterns: score(Two(Dot, 3))", score(Two(Dot, 3)), 3)
check("a case pattern tests its fields by their own patterns: score(Two(Circle(5), 0))", score(Two(Circle(5), 0)), 5)
check("a case pattern tests its fields by their own patterns: score(Two(Circle(2), 4))", score(Two(Circle(2), 4)), 8)
size(s: Shape): int := match s { Circle(1) => 10; Circle(r) => r; Dot => 0 }
check("a field's pattern may be a value", size(Circle(1)) + size(Circle(7)), 17)
check("an enum's value as text is its case's name: text(Coin.Dime)", text(Coin.Dime), "Dime")
check("an enum's value as text is its case's name: \"\${Bracket.Round} \${Coin.Penny}\"", "${Bracket.Round} ${Coin.Penny}", "Round Penny")
# a case with a spelling converts to that text and back and equals it; a case without one is spelled by its name
# (wiki/enum.md "Cases with spellings")
enum Level { Error, Warning = "warn", Hint }
check("a case is spelled by its text, or else its name: Level.Warning as text", Level.Warning as text, "warn")
check("a case is spelled by its text, or else its name: Level.Error as text", Level.Error as text, "Error")
check("a case is spelled by its text, or else its name: show(\"warn\" as Level)", show("warn" as Level), "Warning")
check("a case equals its spelling", Level.Warning == "warn", yes)
# a case's field may hold a function, its type written as a class field's is (wiki/variant.md)
enum Step { Run(f: (int) -> int), Skip }
stepped = Run(x => x + 1)
check("a case's field of a function type", match stepped { Run(f) => text(f(1)); Skip => "-" }, "2")
# a case named like a type or form, `Range`, is still only its enum's case
enum Reach { Range, Point }
check("a case named like a type is its enum's own: text(Reach.Point)", text(Reach.Point), "Point")
check("a case named like a type is its enum's own: show(Reach.Point)", show(Reach.Point), "Point")
check("a case named like a type is its enum's own: text(Reach.Range)", text(Reach.Range), "Range")
# a case compared with a Node is read as the Node it names (decision bare-kind A, 2026-11-21)
enum TypeWord { int, float }
written: Node = symbol("int")
check("a Node equals the case it names", written == TypeWord.int and written != TypeWord.float, yes)
# two enums compare as a program defines their == (the user, 2026-11-21)
enum Toss { Heads, Tails }
enum Deck { Ace, Heads }
==(a: Toss, b: Deck): bool := a == Toss.Tails and b == Deck.Ace
check("a program's own == compares two enums", Toss.Tails == Deck.Ace and not (Toss.Heads == Deck.Heads), yes)
# a case name two enums share is the expected enum's (decision enum-case-unambiguous)
enum Mark { Yes, True, No }
marked(m: Mark) as Node := match m { True => True; _ => False }
check("a case name two enums share is the expected enum's", marked(Mark.True) == Node.True, yes)
check("a plain case counts from 0 as an int: Penny as int", Penny as int, 0)
check("a plain case counts from 0 as an int: Dime as int", Dime as int, 2)
check("an int is the index of a plain enum's case", text(2 as Coin), "Dime")
# a case with fields is a type of its own: a parameter of it reads the fields by name (decision enum-case-as-type,
# wiki/variant.md "A case as a type")
radius(c: Circle) := c.r
check("a parameter of one case reads its field by name", radius(Circle(5)), 5)
check("an enum called with an int gives the case at that index", Coin(2), Coin.Dime)
