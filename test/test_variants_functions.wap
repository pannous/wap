# wap's enum cases holding functions (wiki/variant.md): a case's field may be of a function type, written as a class
# field's is. Its own program while the equality of a case with a function field is refused (any enum's == compares
# every case's fields)
use "check.wap"

enum Step { Run(f: (int) -> int), Skip }
stepped = Run(x => x + 1)
check("a case's field of a function type", match stepped { Run(f) => text(f(1)); Skip => "-" }, "2")
