# wap's enums and variants (wap/kernel/forms.wap Record; wiki/enum.md, wiki/variant.md): cases named by their enum, and
# cases compared by their fields
use "check.wap"

enum Side { Left, Right }
enum Grouping { Left, Right, Refused }
grouping = Grouping.Refused
check("a case named by its enum: match Side.Right { Right => \"right\"; _ => \"other\" }", match Side.Right { Right => "right"; _ => "other" }, "right")
check("a case named by its enum: match grouping { Left => \"left\"; Right => \"right\"; Refused => \"refused\" }", match grouping { Left => "left"; Right => "right"; Refused => "refused" }, "refused")
enum Shape { Circle(r: int), Label(name: text), Dot }
check("cases with fields are equal by their fields: if Circle(1) == Circle(2) then \"same\" else \"differ\"", if Circle(1) == Circle(2) then "same" else "differ", "differ")
check("cases with fields are equal by their fields: if Circle(1) == Circle(1) then \"same\" else \"differ\"", if Circle(1) == Circle(1) then "same" else "differ", "same")
check("cases with fields are equal by their fields: if Label(\"a\") == Label(\"a\") then \"same\" else \"differ\"", if Label("a") == Label("a") then "same" else "differ", "same")
check("cases with fields are equal by their fields: if Circle(1) != Dot then \"differ\" else \"same\"", if Circle(1) != Dot then "differ" else "same", "differ")
enum Tree { Leaf(n: int), Pair(a: Tree, b: Tree) }
check("cases holding cases compare by their parts: Pair(Leaf(1), Leaf(2)) == Pair(Leaf(1), Leaf(2))", Pair(Leaf(1), Leaf(2)) == Pair(Leaf(1), Leaf(2)), yes)
check("cases holding cases compare by their parts: Pair(Leaf(1), Leaf(2)) == Pair(Leaf(1), Leaf(3))", Pair(Leaf(1), Leaf(2)) == Pair(Leaf(1), Leaf(3)), no)
# decision enum-case-shadowing (user, 2026-11-19): a bare case is meant only where nothing else of its name is, or
# where its enum is expected; elsewhere it is written with the enum's name
class Box { n: int }
enum Kind { Box, Other }
box = Box(3)
kind: Kind = Box
check("a case named like a class is the case where its enum is expected or named, the class elsewhere", text(box.n) + " " + text(kind == Kind.Box) + " " + text(Other == Kind.Other), "3 yes yes")
