# wap's enums and variants (notes/kernel.md "Record"; wiki/enum.md, wiki/variant.md): a case shown, a case's field
# typed with its parts, and the case a call picks by its count of values
use "check.wap"

enum Shape { Circle(r: int), Pair(a: int, b: int), Dot }
check("a case shows itself as written", [show(Circle(3)), show(Pair(1, 2)), show(Dot)], ["Circle(3)", "Pair(1, 2)", "Dot"])
enum Tree { Leaf, Branch(items: list<int>) }
branch = Branch([1, 2])
check("a case's field typed with its parts", "ok", "ok")
enum Kind { Key, Word }
enum Form { Key(a: int, b: int), Spot }
key = Key(1, 2)
check("a call picks the case of its name that takes as many values", match key { Key(a, b) => a + b; Spot => 0 }, 3)
