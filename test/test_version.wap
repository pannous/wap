# the standard module version (wiki/use.md "versions"): versions compare part by part
use "check.wap"
use version

check("versions compare part by part as whole numbers", version("1.9") < version("1.10.0"), yes)
check("a missing part counts as 0", version("1.2.0") == version("1.2"), yes)
check("a leading v is no part", text(version("v1.2.3")), "1.2.3")
check("a greater version is not below a smaller", version("2.0") < version("1.10"), no)
