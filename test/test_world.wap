# the world's feeds (wiki/world.md): live public sources, read over the network
use "check.wap"
use feeds
use wikipedia
use earthquakes
use polymarket
use map

check("a wiki's changes come one at a time", #changes("enwiki").take(2), 2)
check("quakes of a magnitude have at least it", number(as_data_map(quakes(4.5).next()).mag) >= 4.5, yes)
check("the busiest markets are listed", #markets(3), 3)
check("a market's price is a probability", price(text(as_data_map(markets(1)#1).slug)) <= 1, yes)
