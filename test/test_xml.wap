# XML, lib/xml.wap (wiki/library-xml.md): reading into elements, path queries, the text and the writer
use xml
use "check.wap"

FEED := "<feed><entry><title>Hello</title></entry><entry><title>World</title></entry></feed>"
check("the first match's text", xml_text(xml_find(parse_xml(FEED), "entry/title")!), "Hello")
check("every match's attribute", xml_find_all(parse_xml("<feed><entry id='1'/><entry id='2'/></feed>"), "entry").map(e => e.attributes["id"]).join(" "), "1 2")
check("the writer round-trips", to_xml(parse_xml("<a x=\"1\"><b>t &amp; u</b></a>")), "<a x=\"1\"><b>t &amp; u</b></a>")
check("any depth, a predicate", xml_find_all(parse_xml("<r><a><b k='v'>1</b><b>2</b></a><b>3</b></r>"), "//b[@k='v']").map(xml_text).join(" "), "1")
check("a position among the matches", xml_text(xml_find(parse_xml(FEED), "entry[2]/title")!), "World")
check("comments, CDATA, character references", xml_text(parse_xml("<?xml version='1.0'?><!-- c --><a>x<![CDATA[<y>]]>&#65;&#x42;</a>")), "x<y>AB")
check("no match is ø", xml_find(parse_xml(FEED), "author") == ø, yes)
check("a mismatched tag is refused with its place", try xml_text(parse_xml("<a>\n<b></a>")) else "refused", "refused")
