# the prelude's checked types read once, and two values a quotient joins stated equal, for the tests of
use "../check.wap"
use "scripted.wap"

# the prelude's files are gone with the theory's reader: the lines that start from them go red until wap spells them
checked = ""
# the value a quotient makes of a value of its carrier, and two such values equal by the axiom quotient_sound
made(level: text, carrier: text, relation: text, value: text): text := "quotient.of[${level}](${carrier}, ${relation}, ${value})"
one_made(name: text, level: text, carrier: text, relation: text, a: text, b: text, why: text): text :=
	holds(checked, name, "Equal[${level}](quotient[${level}](${carrier}, ${relation}), ${made(level, carrier, relation, a)}, ${made(level, carrier, relation, b)})",
		"quotient_sound[${level}](${carrier}, ${relation}, ${a}, ${b}, ${why})")
