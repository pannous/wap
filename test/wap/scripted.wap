# the helpers of wap's test scripts, test/wap/test_<area>.wap: run.sh compiles each with the compiler under test and runs
# it given the wap binary, that compiler, the script's own folder in the tree's data/ (never the system's temporary
# folder) and the tree. ran: a program compiled by the compiler under test and run; formatted and format_check: what
# `wap format` prints; wap_said and wap_ran: what the wap command on the PATH says. A script uses check.wap too, for check
use file
use path
use process
use "../check.wap"
# TODO (card use-root-first) `use regex` once lib/ is searched before lib/crates/
use "../../lib/regex.wap"

class Script { wap: text, compiler: text, stage: text, tree: text }
script := Script(args[0], args[1], args[2], args[3])

# what a program printed and said on stderr, in the order said
said(words: list<text>, folder: text = "."): text := run(words, folder: folder, merged: yes).out
# the path of a program written into the script's folder under a name
written(name: text, program: text): text := {
	file = path_join(script.stage, name + ".wap")
	write(file, program + "\n")
	file
}
# a program compiled by the compiler under test and run, given these words: what the compiler said, its warnings or
# its refusal, then what the program said
ran(name: text, program: text, words: list<text> = []): text := {
	compiled = run([script.wap, script.compiler, written(name, program), module_of(name)], merged: yes)
	if compiled.status != 0 { return compiled.out }
	[compiled.out, said([script.wap, module_of(name)] + words)].filter(t => t != "").join("\n")
}
# where ran puts a program's module
module_of(name: text): text := path_join(script.stage, name + ".wasm")
# the path of a file in the script's folder
staged(name: text): text := path_join(script.stage, name)
# a program as `wap format` prints it, the compiler under test reading it, or the compiler's error
formatted(program: text): text := said([script.wap, script.compiler, "format", written("program", program)])
format_check(program: text, expected: text) := check("${program} → ${expected}", formatted(program), expected)
# the wap command on the PATH run with these words: what it said, or its status and outputs apart
wap_said(words: list<text>): text := said(["wap"] + words)
wap_ran(words: list<text>, folder: text = "."): Ran := run(["wap"] + words, folder: folder)
# how many of a text's lines hold a part, as grep -c counts them
lines_with(t: text, part: text): int := #t.split("\n").filter(line => line.contains(part))
# a file's text without its trailing line ends, as a script compares outputs
file_text(path: text): text := without_line_ends(read(path))
# each line holding a mark cut to start at its last one, as sed's s/.*mark/mark/ cuts it
from_mark(t: text, mark: text): text := t.split("\n").map(line => if line.contains(mark) then mark + line.split(mark).last else line).join("\n")
# the lines of a text a regular expression matches, as grep gives them
grepped(t: text, pattern: text): text := t.split("\n").filter(line => first_match(line, pattern) != ø).join("\n")
# every match of a regular expression in each line of a text, as grep -o gives them
matches_of(t: text, pattern: text): list<text> := t.split("\n").flat_map(line => find_all(line, pattern))
# texts each followed by a blank, as tr '\n' ' ' gives grep -o's lines
spaced(matches: list<text>): text := matches.map(m => m + " ").join("")
# C source lines built into a shared library lib<name>.dylib in the script's folder
c_library(name: text, lines: list<text>) := {
	write(staged(name + ".c"), lines.join("\n") + "\n")
	built = run(["cc", "-shared", "-o", staged("lib${name}.dylib"), staged(name + ".c")], merged: yes)
	if built.status != 0 { raise "cc ${name}.c: ${built.out}" }
}
