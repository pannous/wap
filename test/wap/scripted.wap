# the helpers of wap's test scripts, test/wap/test_<area>.wap: run.sh compiles each with the compiler under test and runs
# it given the wap binary, that compiler, the script's own folder in the tree's data/ (never the system's temporary
# folder) and the tree. ran: a program compiled by the compiler under test and run; formatted and format_check: what
# `wap format` prints; wap_said and wap_ran: what the wap command on the PATH says. A script uses check.wap too, for check
use file
use path
use process
use "../check.wap"
use "../../wap/extensions/verify/options.wap"
# TODO (card use-root-first) `use regex` once lib/ is searched before lib/crates/
use "../../lib/regex.wap"

class Script { wap: text, compiler: text, stage: text, tree: text }
script := Script(args[0], args[1], args[2], args[3])
# a program's run shows no window and opens no sound device (the user: every run of a test is headless)
HEADLESS = "--no-window"
# the words that run a compiled program
run_words(name: text): list<text> := [script.wap, HEADLESS, module_of(name)]

# what a program printed and said on stderr, in the order said; input: what it reads on its standard input
said(words: list<text>, folder: text = ".", input: text? = ø): text := run(words, folder: folder, merged: yes, input: input).out
# the path of a program written into the script's folder under a name
written(name: text, program: text): text := {
	file = path_join(script.stage, name + ".wap")
	write(file, program + "\n")
	file
}
# a program compiled by the compiler under test, or another compiler, into module_of(name)
compiled(name: text, program: text, compiler: text = script.compiler): Ran := run([script.wap, compiler, written(name, program), module_of(name)], merged: yes)
# what compiling said, its warnings or its refusal, then, where it compiled, what the next step said: sh's `compile && next`
then_ran(module: Ran, next: () -> text): text := if module.status != 0 then module.out else [module.out, next()].filter(t => t != "").join("\n")
# a program compiled and run, given these words and, input:, its standard input; compiler:, by another compiler
ran(name: text, program: text, words: list<text> = [], input: text? = ø, compiler: text = script.compiler): text := then_ran(compiled(name, program, compiler), () => said(run_words(name) + words, input: input))
# a program compiled and one of its exports called by wasmtime, the host outside wap, given these words
called_export(name: text, program: text, export: text, words: list<text>): text := then_ran(compiled(name, program), () => try { run(["wasmtime", "run", "-W", "gc=y,function-references=y,exceptions=y", "--preload", preloaded(types_module()), "--invoke", export, module_of(name)] + words).out } catch e { "no wasmtime on PATH, the host these lines call exports with" })
# the types module beside the compiler under test: the programs it compiles import it by its file name
types_module(): text := absolute_path(glob(path_join(dirname(script.compiler), "types-*.wasm"))#1)
# wasmtime's --preload of a module under the name it is imported by, its file name
preloaded(module: text): text := "${module.split("/").last}=${module}"
# the status a program's run exits with, the compiler's when it refuses the program
ran_status(name: text, program: text): int := {
	built = compiled(name, program)
	if built.status != 0 then built.status else run(run_words(name)).status
}
# where ran puts a program's module
module_of(name: text): text := path_join(script.stage, name + ".wasm")
# the path of a file in the script's folder
staged(name: text): text := path_join(script.stage, name)
# a program as `wap format` prints it, the compiler under test reading it, or the compiler's error; typing's hints
# say the readings the format spells out, so they are left out
formatted(program: text): text := said([script.wap, script.compiler, "format", written("program", program)]).split("\n").filter(line => not line.starts_with("hint: ")).join("\n")
# what `wap optimize` says of the file it writes again, the compiler under test optimizing it
optimized(file: text): text := without_line_ends(said([script.wap, script.compiler, "optimize", file]))
format_check(program: text, expected: text) := check("${program} → ${expected}", formatted(program), expected)
# the wap command on the PATH run with these words: what it said, or its status and outputs apart
wap_said(words: list<text>): text := said(["wap"] + words)
wap_ran(words: list<text>, folder: text = "."): Ran := run(["wap"] + words, folder: folder)
# how many of a text's lines hold a part, as grep -c counts them
lines_with(t: text, part: text): int := #t.split("\n").filter(line => line.contains(part))
# the rules a program was refused by, `refused by <rule>` per refusal, never the message after it (a test pins that a
# program is refused and by which rule of the type theory, wiki/universe.md … wiki/quotient.md)
refused_by(said: text): text := refusals(said).map(line => line.split(":")#1).join("\n")
# each refusal said, whole: its rule and what it names
refusals(said: text): list<text> := said.split("\n").filter(line => line.contains("refused by ")).map(line => "refused by " + line.split("refused by ").last)
# a file's text without its trailing line ends, as a script compares outputs
file_text(path: text): text := without_line_ends(read(path))
# each line holding a mark cut to start at its last one, as sed's s/.*mark/mark/ cuts it
from_mark(t: text, mark: text): text := t.split("\n").map(line => if line.contains(mark) then mark + line.split(mark).last else line).join("\n")
# the lines of a text a regular expression matches, as grep gives them
grepped(t: text, pattern: text): text := t.split("\n").filter(line => first_match(line, pattern) != ø).join("\n")
# every match of a regular expression in each line of a text, as grep -o gives them
matches_of(t: text, pattern: text): list<text> := t.split("\n").flat_map(line => find_all(line, pattern))
# texts each followed by a blank, as tr '\n' ' ' gives grep -o's lines
spaced(matches: list<text>): text := matches.map(m => m + " ").join("")
# C source lines built into a shared library lib<name>.dylib in the script's folder
c_library(name: text, lines: list<text>) := {
	write(staged(name + ".c"), lines.join("\n") + "\n")
	built = run(["cc", "-shared", "-o", staged("lib${name}.dylib"), staged(name + ".c")], merged: yes)
	if built.status != 0 { raise "cc ${name}.c: ${built.out}" }
}
# a program using a module compiled first, its `use` line naming the module's wasm, compiled and run
ran_using(module: text, source: text, name: text, program: text): text := then_ran(compiled(module, source), () => ran(name, "use \"${module_of(module)}\"\n" + program))
# what Python printed, run isolated (its warnings on stderr left out)
python_printed(code: text): text := run(["python3", "-I", "-c", code]).out
# a 16 × 8 picture file read by a picture module's reader: its size and its pixels at the left and the right half's middle
picture_read(name: text, module: text, path: text): text := ran("${module}_${name}", "use ${module}\nuse color\npicture = ${module}_picture(read_bytes(\"${path}\"))\nprint \"\${picture.width}x\${picture.height} \${picture.pixels[4 * 16 + 3]} \${picture.pixels[4 * 16 + 12]}\"")
# the theory's door (notes/theory.md "The door"), or another, the elaborator's, compiled by the compiler under test, a
# script builds it once
door_built(source: text = THEORY_DOOR): text := tree_built(source.replace("/", "_"), source)
THEORY_DOOR := "wap/extensions/theory/check.wap"
ELABORATOR_DOOR := "wap/extensions/theory/elaborate/door.wap"
# `wap verify`: the elaborator's door, then one verdict per law, theorem and axiom
VERIFY_DOOR := "wap/extensions/verify/verify.wap"
# a program of the tree compiled by the compiler under test once for the script, under a name: its module
tree_built(name: text, source: text): text := {
	built = run([script.wap, script.compiler, path_join(script.tree, source), module_of(name)], merged: yes)
	if built.status != 0 { raise "${source} does not compile: ${built.out}" }
	module_of(name)
}
# what the door says of a program: nothing for one it accepts, the type for each `type of`, else its first refusal
door(module: text, name: text, program: text): text := said([script.wap, module, TREE_OPTION, script.tree, written(name, program)], folder: script.tree)
# the doors a script built, by source, each the first time it is asked
doors_built: map<text, text> = {}
# what a door, the theory's or another, says of a program
said_of(name: text, program: text, source: text = THEORY_DOOR): text := {
	if not (source in doors_built) { doors_built[source] = door_built(source) }
	door(doors_built[source], name, program)
}
# what the door says of a law and its proof after the program's start: nothing when the proof holds
holds(start: text, name: text, statement: text, proof: text): text := said_of(name, start + "law ${name}: ${statement} := ${proof}")
# a prelude file of the theory (wap/extensions/theory/prelude/<name>.wap) as part of a program's start, without its
# layouts, which only the prelude itself may say
prelude(name: text): text := file_text(path_join(script.tree, "wap/extensions/theory/prelude/${name}.wap")).split("\n").filter(line => not line.starts_with(LAYOUT_START)).join("\n") + "\n"
LAYOUT_START := "runs("
