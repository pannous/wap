# the helpers of wap's test scripts, test/wap/test_<area>.wap: run.sh compiles each with the compiler under test and runs
# it given the wap binary, that compiler, the script's own folder in the tree's data/ (never the system's temporary
# folder) and the tree. ran: a program compiled by the compiler under test and run; formatted and format_check: what
# `wap format` prints; wap_said and wap_ran: what the wap command on the PATH says. A script uses check.wap too, for check
use file
use path
use process
use "../check.wap"

class Script { wap: text, compiler: text, stage: text, tree: text }
script := Script(args[0], args[1], args[2], args[3])

# what a program printed and said on stderr, in the order said
said(words: list<text>, folder: text = "."): text := run(words, folder: folder, merged: yes).out
# the path of a program written into the script's folder under a name
written(name: text, program: text): text := {
	file = path_join(script.stage, name + ".wap")
	write(file, program + "\n")
	file
}
# a program compiled by the compiler under test and run, what it said; the compiler's error where it refuses
ran(name: text, program: text): text := {
	module = path_join(script.stage, name + ".wasm")
	compiled = run([script.wap, script.compiler, written(name, program), module], merged: yes)
	if compiled.status != 0 then compiled.out else said([script.wap, module])
}
# a program as `wap format` prints it, the compiler under test reading it, or the compiler's error
formatted(program: text): text := said([script.wap, script.compiler, "format", written("program", program)])
format_check(program: text, expected: text) := check("${program} → ${expected}", formatted(program), expected)
# the wap command on the PATH run with these words: what it said, or its status and outputs apart
wap_said(words: list<text>): text := said(["wap"] + words)
wap_ran(words: list<text>, folder: text = "."): Ran := run(["wap"] + words, folder: folder)
# how many of a text's lines hold a part, as grep -c counts them
lines_with(t: text, part: text): int := #t.split("\n").filter(line => line.contains(part))
# a file's text without its trailing line ends, as a script compares outputs
file_text(path: text): text := without_line_ends(read(path))
