# the helpers of wap's test scripts, test/wap/test_<area>.wap: run.sh compiles each with the compiler under test and runs
# it with the wap binary and that compiler as its arguments. formatted and format_check: what `wap format` prints;
# written and wap_said: what the wap command on the PATH says. A script uses check.wap too, for check
use file
use process
use "../check.wap"

# what a program printed and said on stderr, in the order said
said(words: list<text>): text := run(words, merged: yes).out
# a program as `wap format` prints it, the compiler under test reading it, or the compiler's error
formatted(program: text): text := {
	file = written(program)
	printed = said([args[0], args[1], "format", file])
	delete_file(file)
	printed
}
format_check(program: text, expected: text) := check("${program} → ${expected}", formatted(program), expected)
# the path of a new .wap file holding a program
written(program: text): text := {
	file = fresh_temp_path() + ".wap"
	write(file, program + "\n")
	file
}
# what the wap command on the PATH said, run with these words
wap_said(words: list<text>): text := said(["wap"] + words)
