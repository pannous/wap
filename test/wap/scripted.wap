# the helpers of wap's test scripts, test/wap/test_<area>.wap: run.sh compiles each with the compiler under test and runs
# it with the wap binary and that compiler as its arguments. formatted and format_check: what `wap format` prints
use file
use process
use "../check.wap"

# what a program printed and said on stderr, as one text
said(ran: Ran): text := [ran.out, ran.err].filter(t => t != "").join("\n")
# a program as `wap format` prints it, the compiler under test reading it, or the compiler's error
formatted(program: text): text := {
	file = temp_file()
	write(file, program + "\n")
	printed = said(run([args[0], args[1], "format", file]))
	delete_file(file)
	printed
}
format_check(program: text, expected: text) := check("${program} → ${expected}", formatted(program), expected)
