# The dogfood programs of test/apps (wiki/library-dogfood-apps.md) run as plain programs and print what
# test/apps/expected/<name>.txt holds
use file
use path
use "../check.wap"
use "scripted.wap"

expected_folder = path_join(script.tree, "test/apps/expected")
for listed in list_files(expected_folder).filter(name => name.ends_with(".txt")).sorted {
	name = listed[0 .. #listed - 4]
	check("test/apps/${name}.wap prints what test/apps/expected/${name}.txt holds", ran(name, file_text(path_join(script.tree, "test/apps/${name}.wap"))), file_text(path_join(expected_folder, listed)))
}
