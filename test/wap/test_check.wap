# `wap check`, the obligations a program's types leave to the run, a line each (wiki/type.md "Proved or checked"): a
# condition the compiler finds among the facts it knows there, a parameter's own or an if's around it, is no obligation
# Source: wiki/type.md "Proved or checked"; the warning and --strict lines wiki/cli.md
use "../check.wap"
use "scripted.wap"

# what `wap check` lists for a program
checked(name: text, program: text): text := said([script.wap, "check", written(name, program)])

check("a value given where a condition is wanted is checked when the program runs", lines_with(checked("check_given", "n = 3\nx: int where it > 0 = n\nprint x"), "line 2:1: it > 0 is checked when the program runs"), 1)
check("inside an if of the condition the value needs no check", checked("check_if", "f(x: int where it > 0): int := x\nn = 3\nif n > 0 { print f(n) }"), "")
check("an assignment in the if ends what its condition found", lines_with(checked("check_assigned", "f(x: int where it > 0): int := x\nn = 3\nif n > 0 {\n\tn = n - 1\n\tprint f(n)\n}"), "line 5:8: it > 0 is checked when the program runs"), 1)
check("a parameter's condition holds in its body", lines_with(checked("check_parameter", "f(x: int where it > 0): int := g(x)\ng(y: int where it > 0): int := y * 2\nprint f(3)"), "line 1:"), 0)
# a literal argument that meets the condition is computed by the compiler (wiki/type.md "Proved or checked"): nothing is left to the run
check("a literal argument that meets the condition is no obligation", checked("check_computed", "f(x: int where it > 0): int := x\nprint f(3)"), "")
