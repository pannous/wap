# the facts wiki/type.md "Proved or checked" item 2 names that wap check does not use yet: a proved law
use "../check.wap"
use "scripted.wap"

# what `wap check` lists for a program
checked(name: text, program: text): text := said([script.wap, "check", written(name, program)])

check("a proved law is a fact: the obligation it implies is no line", checked("check_law", "law square_positive(x: int): x * x + 1 > 0\nf(y: int where it > 0): int := y\ng(x: int): int := f(x * x + 1)\nprint g(2)"), "")
