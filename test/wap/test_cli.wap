# the wap command as wiki/cli.md shows it: running a file or code, the exit status; it runs the wap on PATH
use "../check.wap"
use "scripted.wap"

app = written("app", "print \"hi\"")
check("wap runs a file", wap_ran([app]).out, "hi")
check("wap run runs a file", wap_ran(["run", app]).out, "hi")
check("wap runs code given in a file's place", wap_ran(["2+3"]).out, "5")
check("code starting with a command's name as a variable is code", wap_ran(["lower = \"abc\"; lower"]).out, "\"abc\"")
check("wap help lists the commands", lines_with(wap_ran(["help"]).out, "wap run"), 1)
check("a float result exits 0", wap_ran([written("float", "2.5")]).status, 0)
check("a failed run exits 1", wap_ran([written("failed", "x: int = \"a\"")]).status, 1)
