# the forms wiki/cli.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "../check.wap"
use "scripted.wap"

app = written("app", "print \"hi\"")
check("a build mode before the program: wap release", wap_said(["release", app]), "hi")
check("wap format check lists what would change and exits 0 when nothing would", wap_ran(["format", "check", written("formatted", "x = 1")]).status, 0)
built = wap_ran(["build", "app.wap"], folder: script.stage)
check("wap build makes an executable that runs without wap", if built.status == 0 then said(["./app"], folder: script.stage) else "", "hi")
check("--no-window runs a program", wap_said(["--no-window", app]), "hi")
check("exec runs a command and gives what it printed", wap_said(["exec(\"sh\", \"echo hi\")"]), "\"hi\\n\"")
check("wap --sandbox refuses a process", lines_with(wap_said(["--sandbox", written("exec", "exec(\"sh\", \"echo hi\")")]), "capability denied"), 1)
check("a whole-number result is the exit status", wap_ran([written("answer", "42")]).status, 42)
unformatted = written("unformatted", "x=1+2")
wap_ran(["format", unformatted])
check("wap format writes a file's canonical layout in place", read(unformatted), "x = 1 + 2\n")
# a run's value is shown as it ends (wiki/cli.md), a class value with a function in a field too
check("a run whose value is a class holding a function ends well", ran_status("function_field", "class Job { act: () -> int }\nJob(() => 1)"), 0)
