# a function's effects (wiki/effects.md): what `effects of f` names, as the page's examples write it, and the claim
# `! …` after a body, checked, the refusals naming the chain of calls
use "../check.wap"
use "scripted.wap"

# State-from-global, the page's three examples and its parameter that shadows a global
check("a function reading a main-level global has the effect State", ran("global_read", "global y = 1\nf() := y * 2\nprint(effects of f)"), "State")
check("a function naming global y in its body has the effect State", ran("global_named", "y = 3\ndef z(){ global y; y * y }\nprint(effects of z)"), "State")
check("a function reading a constant free variable is Pure", ran("constant_read", "y = 1\nf() := y * 2\nprint(effects of f)"), "Pure")
check("a parameter that shadows a global is no State read", ran("global_shadowed", "global y = 1\nf(y: int) := y * 2\nprint(effects of f)"), "Pure")
# Fail, Div, and the effects of what a function calls
check("a whole number divided by a parameter may fail, a try removes the Fail", ran("failing", "ratio(a: int, b: int): int := a ÷ b\nsafe(a: int, b: int): int := try a ÷ b else 0\nprint(effects of ratio)\nprint(effects of safe)"), "Fail\nPure")
check("a while that may run and a mutual recursion may not end: Div", ran("diverging", "spin(n: int): int := { k = n; while k > 0 { k = k - 1 }; k }\nping(n: int): int := pong(n)\npong(n: int): int := ping(n)\nprint(effects of spin)\nprint(effects of ping)"), "Div\nDiv")
check("a function has the effects of the functions it gives as values", lines_with(ran("given", "twice(f: (int) -> int, x: int): int := f(f(x))\nloud(x: int): int := { print(x); x }\ncalls_twice(x: int): int := twice(loud, x)\nprint(effects of calls_twice)"), "IO"), 1)
check("a function has the effects of the function values written in it", lines_with(ran("written", "shown(xs: list<int>) := xs.map(x => { print(x); x })\nprint(effects of shown)"), "IO"), 1)
# Limits: a claim checked, a misplaced one refused
check("! Pure claims a function only computes", ran("pure_claim", "double(x: int) := x * 2 ! Pure\nprint(double(3))\nprint(effects of double)"), "6\nPure")
check("a function past its claim is refused naming the chain", matches_of(ran("past_claim", "log_twice(t: text) := { print(t); print(t) } ! Pure\nlog_twice(\"a\")"), "log_twice is declared ! Pure but has IO via log_twice → print"), ["log_twice is declared ! Pure but has IO via log_twice → print"])
check("! on a value that is no function is a misplaced effect constraint", matches_of(ran("misplaced_claim", "answer := 42 ! IO\nprint(answer)"), "misplaced effect constraint"), ["misplaced effect constraint"])
check("a division by a whole number other than 0 written in place cannot fail", ran("literal_divisor", "half(n: int): int := n ÷ 2\nthird(n: int): int := n % 3\nbroken(n: int): int := n ÷ 0\nprint(effects of half)\nprint(effects of third)\nprint(effects of broken)"), "Pure\nPure\nFail")
check("several effects claimed are written with commas", ran("claim_several", "say(n: int): int := { print(n); n } ! IO, FFI\nsay(2)\nprint(effects of say)"), "2\nIO")
check("a reassigned parameter divides as whatever it holds then", ran("reassigned_divisor", "ratio(a: int, b: int): int := { b = b - 1; a ÷ b }\nsure(): int := ratio(8, 3)\nprint(effects of sure)"), "Fail")
check("a parameter changed in place divides as whatever it holds then", ran("changed_divisor", "ratio(a: int, b: int): int := { b -= 1; a ÷ b }\nsure(): int := ratio(8, 3)\nprint(effects of sure)"), "Fail")
check("a function calling a function value it is given is Pure: the caller giving it takes its effects", lines_with(ran("given_value", "apply(g: (int) -> int, x: int): int := g(x)\nloud(x: int): int := { print(x); x }\nprint(apply(loud, 1))\nprint(effects of apply)"), "Pure"), 1)
check("a function writing a field of what it is given has the effect State", ran("field_write", "class Counter { n: int }\nbump(c: Counter) := { c.n += 1 }\nprint(effects of bump)"), "State")
check("a whole number divided by -1 written in place may fail, the smallest int's quotient", ran("minus_one_divisor", "flipped(n: int): int := n ÷ -1\nprint(effects of flipped)"), "Fail")
check("! Pure on a function for every type is checked where it is called", ran("generic_claim", "smaller(a: T, b: T): T := (if a < b then a else b) ! Pure\nprint(smaller(3, 2))"), "2")
check("a function adding to the list it is given has the effect State", ran("list_add", "push(xs: list<int>) := xs.add(1)\nprint(effects of push)"), "State")
check("a function setting an item of the list it is given has the effect State", ran("item_write", "zeroed(xs: list<int>) := { xs#1 = 0 }\nprint(effects of zeroed)"), "State")
check("a function changing only a list it made itself is Pure", ran("own_list", "doubled(xs: list<int>): list<int> := xs.map(x => x * 2)\nbuilt(n: int): list<int> := { out: list<int> = []; out.add(n); out }\nprint(effects of doubled)\nprint(effects of built)"), "Pure\nPure")
check("a function changing what it is given through a name of its own has the effect State", ran("alias_write", "alias(xs: list<int>) := { ys = xs; ys.add(1) }\nprint(effects of alias)"), "State")
check("a compiled module's function fails only where its divisor may be 0 or -1", ran_using("dividing", "half(n: int): int := n ÷ 2\nratio(a: int, b: int): int := a ÷ b", "uses_dividing", "halved(n: int): int := half(n)\nsure(): int := ratio(8, 2)\nby_zero(): int := ratio(8, 0)\nby(k: int): int := ratio(8, k)\nprint(effects of halved)\nprint(effects of sure)\nprint(effects of by_zero)\nprint(effects of by)"), "Pure\nPure\nFail\nFail")
check("a function giving a function value that writes into its own parameter has the effect State", ran("lambda_write", "class Box { n: int }\napplied(b: Box, f: (Box) -> int): int := f(b)\nbump(b: Box): int := applied(b, x => { x.n += 1; 0 })\nprint(effects of bump)"), "State")
check("a write into what a list it made holds lands in that value: State", ran("deep_write", "class Box { n: int }\nreached(p: Box) := { ys = [p]; ys#1.n = 1 }\nprint(effects of reached)"), "State")
check("functions that call each other write what either writes, in either order", ran("round_write", "g(xs: list<int>, k: int) := if k > 0 then h(xs, k - 1) else xs.add(1)\nh(xs: list<int>, k: int) := g(xs, k)\nprint(effects of g)\nprint(effects of h)"), "(State Div)\n(State Div)")
check("functions that call each other write what either writes, the other first", ran("round_write_other", "h(xs: list<int>, k: int) := g(xs, k)\ng(xs: list<int>, k: int) := if k > 0 then h(xs, k - 1) else xs.add(1)\nprint(effects of h)\nprint(effects of g)"), "(State Div)\n(State Div)")
check("a function value adding to a list the function giving it made keeps the write inside: Pure", ran("captured_list", "seen_count(xs: list<int>): int := { seen: list<int> = []; xs.map(x => { seen.add(x); x }); #seen }\nprint(effects of seen_count)"), "Pure")
check("a function giving as a value a function that writes through a call has the effect State", ran("value_writes_through", "class Box { n: int }\nset_box(b: Box): int := { b.n = 1; 0 }\nthrough(b: Box): int := set_box(b)\napplied(b: Box, f: (Box) -> int): int := f(b)\nbump(b: Box): int := applied(b, through)\nprint(effects of bump)"), "State")
