# wap reads files (wap/types/prelude.wap read; wiki/standard-library.md): read(path) is the file's text, a path it
# cannot open stops the program naming it
use file
use process
use "../check.wap"
use "scripted.wap"

sample = staged("sample.txt")
write(sample, "line one\nline two")
check("a file's text", ran("read_file", "print read(\"${sample}\")"), "line one\nline two")
check("a file read is a text like any", ran("read_compared", "if read(\"${sample}\") == \"line one\" + \"\nline two\" then print \"same\" else print \"other\""), "same")
check("a file that cannot be read", ran("read_missing", "print read(\"${staged("missing.txt")}\")"), "cannot read ${staged("missing.txt")}")
check("the command line, the program first", ran("command_line", "for each in arguments() { print each }", words: ["a", "b c"]), "${module_of("command_line")}\na\nb c")
ran("environment", "print text(wasi_environment().contains(\"WAP_ENVIRONMENT_CHECK=seen\"))")
check("the run's environment, each entry zero-ended", said(["env", "WAP_ENVIRONMENT_CHECK=seen", script.wap, module_of("environment")]), "yes")
written_bin = staged("written.bin")
check("bytes written to a file, made or emptied first", ran("bytes_written", "write_bytes(\"${written_bin}\", [104, 105, 33])\nprint read(\"${written_bin}\")\nwrite_bytes(\"${written_bin}\", [111, 107])\nprint read(\"${written_bin}\")"), "hi!\nok")
check("args are the command line after the program's file, program its file and folder", ran("program_words", "print text(#args)\nprint args#2\nprint program.folder", words: ["a", "b c"]), "2\nb c\n${script.stage}")
check("write_bytes writes a file's bytes, read gives them back", ran("bytes_file", "write_bytes(\"${staged("out.bin")}\", [104, 105])\nprint read(\"${staged("out.bin")}\")"), "hi")
check("read_bytes gives a file's bytes back, NULs and all", ran("bytes_read", "write_bytes(\"${staged("zeros.bin")}\", [104, 0, 255])\nprint text(read_bytes(\"${staged("zeros.bin")}\"))"), "[104, 0, 255]")
check("wall_clock_ms is the wall clock's milliseconds since 1970", ran("clock", "start = wall_clock_ms()\nprint text(start > 1700000000000 and wall_clock_ms() - start < 60000)"), "yes")
ensured_folder(staged("listed"))
write(staged("listed/one.txt"), "a")
write(staged("listed/two.wap"), "b")
check("list_files names a folder's files", ran("listed", "print text(list_files(\"${staged("listed")}\").sorted)"), "[\"one.txt\", \"two.wap\"]")
ran("home_paths", "print text(exists(\"~/listed/one.txt\")) + \" \" + text(exists(\"~/nowhere\")) + \" \" + text(exists(\"\")) + \" \" + read(\"~/listed/one.txt\") + \" \" + (started_env(\"WAP_UNSET_CHECK\") ?? \"unset\")")
check("exists tests a path, a leading ~ is the home folder, started_env a variable", said(["env", "HOME=${script.stage}", script.wap, module_of("home_paths")]), "yes no no a unset")
# a path through a link to an absolute path, and a path with `..` out of the current folder, read as any other
said(["ln", "-sfn", staged("listed"), staged("linked")])
check("a file read through a link to an absolute path", ran("read_linked", "print read(\"${staged("linked/one.txt")}\")"), "a")
compiled("read_up", "print read(\"../listed/one.txt\")")
check("a file read through .. out of the current folder", said([script.wap, module_of("read_up")], folder: staged("linked")), "a")
# a WASI readlink call at places outside the program's memory, of a folder the host never opened, or of a too long
# path is refused with WASI's error, the host unharmed
check("readlink refuses places outside the memory, an unknown folder and a too long path", ran("readlink_refused", "readlink(folder: int, path_at: int, length: int, target_at: int, room: int): int := {\n\tanswer: int32 = prim foreign(\"wasi_snapshot_preview1\", \"path_readlink\", int32(folder), int32(path_at), int32(length), int32(target_at), int32(room), int32(0))\n\tint(answer)\n}\nprint text([readlink(4, 4000000000, 8, 0, 8), readlink(4, 0, 8, 0, 4000000000), readlink(9, 0, 8, 0, 8), readlink(4, 0, 5000, 0, 8)])"), "[21, 21, 8, 37]")
# clock() is the same wall clock by its library name (wiki/standard-library.md time)
check("clock() is the wall clock's milliseconds since 1970", ran("clock_word", "start = clock()\nprint text(start > 1700000000000 and clock() - start < 60000)"), "yes")
