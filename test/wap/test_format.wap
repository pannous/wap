# wap format fix: the program written again without the functions nothing calls, each removed one said
# (wiki/cli.md "Formatting"; card format-remove-unused)
use "../check.wap"
use "scripted.wap"

# what `wap format fix` says of the file, the compiler under test fixing it
fixed(file: text): text := without_line_ends(said([script.wap, script.compiler, "format", "fix", file]))

app = written("app", "used(x: int) as int := x + 1\nhelper(y: int) as int := y * 2\ncaller() := helper(3)\nprint used(1)")
check("format fix says each function nothing calls", fixed(app), "removed: helper\nremoved: caller")
check("format fix writes the program without them", file_text(app), "used(x: int) as int := x + 1\nprint used(1)")
library = written("library", "twice(x: int) as int := x * 2")
fixed(library)
check("a file of definitions only has no caller to judge by: it keeps them all", file_text(library), "twice(x: int) as int := x * 2")
shared = written("shared", "helper() := 1; print 2")
fixed(shared)
check("format fix removes only the function, never the code beside it on its line", file_text(shared), "print 2")
