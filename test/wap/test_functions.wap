# wap's emitter: functions, locals and globals (wap/kernel/forms.wap: Define, Set, Call, a name's value): the checks no
# value can make, on what an uncaught raise, a refusal or a crash prints; the value checks are
# test/test_functions_calls.wap and test/test_functions_returns.wap
use "../check.wap"
use "scripted.wap"

check("code that never finishes adds nothing to a join: an arm that returns, raises or calls a function that always raises", ran("jumps", "f(n: int) as int := if n > 0 then n else raise(\"negative\")\ng(n: int) := { if n > 2 { return n * 10 }; n }\nfail() := raise(\"always\")\ny = if f(3) > 9 then fail() else g(5) + g(1)\nprint text(y)\nh(x: int) as text := match x { 1 => \"one\"; _ => raise(\"other\") }\nprint(h(1))\nprint text(f(-1))"), "51\none\nnegative")
bad = "bad(x: int) as int := x + \"a\"\n"
worse = "worse(x: int) as int := bad(x) + 1\nalso(x: int) as text := 3\n"
check("a refused function ends only itself: its siblings are typed anyway, each caller is refused naming it, all said together", spaced(matches_of(ran("refused_alone", bad + worse + "good(x: int) as int := x * 2\nprint(text(good(21)))"), "line [0-9]*:|calls bad")), "line 1: line 2: calls bad line 3: ")
check("a program statement wap refuses still lets the functions beside it be typed: all refusals said together", spaced(matches_of(ran("refused_beside", bad + worse + "print(text(worse(21)))"), "line [0-9]*:|calls [a-z]*")), "line 1: line 2: calls bad line 3: line 4: calls worse ")
check("a library function wap refuses for the user's types: the user's line says the first reason", matches_of(grepped(ran("library_root", "class Ship { size: int }\nships = [Ship(2), Ship(1)]\nprint(ships.sorted())"), "library_root.wap line 3"), "Ship is not Comparable: sorted needs compare\\(a: Ship, b: Ship\\)").join("\n"), "Ship is not Comparable: sorted needs compare(a: Ship, b: Ship)")
# a module names its functions (wiki/wasm-representation.md: names by wasm convention), so a host's backtrace shows them
check("a crash's backtrace names the function it happened in", matches_of(ran("crash", "class P { n: int }\ng(x: int) as P? := if x > 0 then P(x) else ø\nreads(x: int) as int := g(x)!.n\nprint text(reads(0))"), "reads\\(x: int\\) → int").join("\n"), "reads(x: int) → int")
# a definition's modifiers (wiki/keyword.md Modifiers, wiki/constant.md)
check("public and global before a definition change nothing", ran("modifiers", "public pad(t: text) := t + \".\"\nglobal twice(t: text) as text := t * 2\nprint(twice(pad(\"a\")))"), "a.a.")
check("a const is a constant", ran("constants", "const z = 7\nconst tau := 2 * z\nprint(text(z + tau))"), "21")
check("a global given at the top is the program's variable", ran("top_global", "global n = 1\nbump() := {\n	global n\n	n = n + 1\n}\nbump()\nprint(text(n))"), "2")
# a program's operators (wiki/operator.md): with parameters, without them (left and right; it), `operator` alone infix
check("a program's operator is the function of its name", ran("program_operators", "infix operator divides(d: int, n: int) := n % d == 0\noperator ⇔(a: bool, b: bool) := a == b\ninfix operator times := left * right\nprefix operator ⁻ := it * -1\nprint(text(3 divides 12) + \" \" + text((1 > 0) ⇔ (2 > 0)) + \" \" + text(3 times 4) + \" \" + text(⁻5))"), "yes yes 12 -5")
# a library function written as one wasm instruction, as lib's bits.warp writes them
check("functions written as wasm's bit instructions", ran("bits", "ones(n: int): int := prim i64.popcnt(n)\nleading(n: int): int := prim i64.clz(n)\ntrailing(n: int): int := prim i64.ctz(n)\nboth(a: int, b: int): int := prim i64.and(a, b)\neither(a: int, b: int): int := prim i64.or(a, b)\ndiffer(a: int, b: int): int := prim i64.xor(a, b)\nshifted(a: int, b: int): int := prim i64.shr_u(a, b)\nleft(a: int, b: int): int := prim i64.rotl(a, b)\nright(a: int, b: int): int := prim i64.rotr(a, b)\nprint([ones(255), leading(1), trailing(8), both(12, 10), either(12, 10), differ(12, 10), shifted(-1, 60), left(1, 65), right(1, 1)].map(n => text(n)).join(\" \"))"), "8 63 3 8 14 6 15 2 -9223372036854775808")
check("a host operation given fewer operands than it takes is refused", matches_of(ran("operands", "half(a: int): int := prim i64.add(a)\nprint text(half(1))"), "line 1:22: this primitive takes 2 operands, not 1").join("\n"), "line 1:22: this primitive takes 2 operands, not 1")
# a block given where a function or a block is wanted is a function of no parameters (wiki/block.md "A block runs by a
# call")
check("a block given to a function parameter runs by its call", ran("block_function", "twice(b: () -> int) := b() + b()\nprint \"\${twice { 4 }}\""), "8")
check("a block given to a block parameter runs by its call", ran("block_parameter", "twice(body: block) := body() + body()\nprint \"\${twice { 4 }}\""), "8")
# a program adds to a function every program has only where none of its definitions takes the types already
# (wiki/function.md; own-type-overloads B, user 2026-11-23): missing(x: T?) takes an int? already
check("a function every program has, redefined for types it takes already, is refused at the definition", matches_of(ran("own_missing", "missing(x: int?) := no\nmissing(3)"), "line 1:1: missing is a function every program has").join("\n"), "line 1:1: missing is a function every program has")
# a name's first assignment in a function, of a variable the program has, stays refused with a fix-it (user 2026-11-26)
check("a function's count = count + 1 of the program's count is refused, naming let and global", matches_of(ran("count_again", "count = 1\nbump() := { count = count + 1 }\nbump()\nprint(text(count))"), "write `let count = …` for a new one").join("\n"), "write `let count = …` for a new one")
# a function type written where a value stands is refused naming the spelling of a function value (wiki/closure.md: -> writes function types, => function values)
check("a function value written with -> is refused saying => writes it", matches_of(ran("arrow_value", "add = (a, b) -> a + b\nprint(text(add(1, 2)))"), "-> writes a function type; a function value is written with =>").join("\n"), "-> writes a function type; a function value is written with =>")
