# Every job slot's command runs guarded (scripts/guarded.wap): its output and status its own, a runaway past the memory
# or time cap killed with its largest process named. Source: warp-supervisor 2026-11-22, after one runaway wap took
# 90 GB and the terminal with it
use path
use process
use "../check.wap"
use "scripted.wap"

# guarded.wap compiled where it is by the compiler under test
guarded_compiled = run([script.wap, script.compiler, path_join(script.tree, "scripts/guarded.wap"), module_of("guarded")], merged: yes)
# a command run guarded, past wap's own time cap
guarded(words: list<text>): Ran := run([script.wap, "--seconds", "86400", module_of("guarded")] + words)
# what a guarded run said on stderr, if it was killed (the cap, a process past the time cap), and its status
guarded_run(words: list<text>): text := {
	ran = guarded(words)
	(matches_of(ran.err, "past the cap of [0-9]* [GBs]*(: .*)*|runaway-input") + ["status ${ran.status}"]).join("\n")
}
# what a guarded command printed, and its status
printed_run(words: list<text>): text := {
	ran = guarded(words)
	"${ran.out}\nstatus ${ran.status}"
}

check("guarded.wap compiles", guarded_compiled.out, "")
check("a guarded command's output and status are its own", printed_run(["bash", "-c", "echo said; exit 3"]), "said\nstatus 3")
check("a command past the memory cap is killed and its input named", guarded_run(["--memory-gb", "1", "python3", "-c", "block = bytearray(2 << 30); import time; time.sleep(30)  # runaway-input"]), "past the cap of 1 GB\nrunaway-input\nstatus 124")
check("a command past the time cap is killed, its children too", guarded_run(["--seconds", "1", "bash", "-c", "sleep 30 & sleep 30"]), "past the cap of 1 s: sleep 30\nstatus 124")
check("a script of short runs may take longer than the time cap", printed_run(["--seconds", "2", "bash", "-c", "for run in 1 2 3 4; do sleep 1; done; echo done"]), "done\nstatus 0")
