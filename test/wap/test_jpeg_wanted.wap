# what lib/jpeg.wap does not build yet, each red line a to-do (the reader takes no if as an argument and no `not in`):
# it reads a baseline JPEG's pixels (its header names what it reads): pictures Python's PIL writes, gray and
# YCbCr at 4:4:4 and 4:2:0, red on the left half, blue on the right, read back as libjpeg reads them (PIL: #fe0000 and
# #0000fe)
use "../check.wap"
use "scripted.wap"

# a 16 × 8 JPEG, its left half red and right half blue, in a mode and subsampling PIL writes it with
picture_written(name: text, mode: text, subsampling: int): text := {
	path = staged(name + ".jpg")
	python_printed("from PIL import Image\npicture = Image.new('RGB', (16, 8), (255, 0, 0))\npicture.paste((0, 0, 255), (8, 0, 16, 8))\npicture.convert('${mode}').save('${path}', quality=100, subsampling=${subsampling})")
	path
}
# the picture as jpeg reads it back
read_back(name: text, mode: text, subsampling: int): text := picture_read(name, "jpeg", picture_written(name, mode, subsampling))

check("a YCbCr JPEG's size and colors", read_back("color", "RGB", 0), "16x8 #fe0000 #0000fe")
check("a JPEG sampled 4:2:0 reads each half's color", read_back("halved", "RGB", 2), "16x8 #fe0000 #0000fe")
check("a gray JPEG's pixels are grays", read_back("gray", "L", 0), "16x8 #4c4c4c #1d1d1d")
