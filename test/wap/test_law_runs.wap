# wap verify runs each law as the program runs: a closed law, laws with written binders and their `for` lines, each
# with its own verdict, Tested or FAILED with every binder's value, a law the theory refuses beside the others.
# Source: wiki/law.md "Checking a law", wiki/proof.md "Checking proofs", wiki/proposition.md
use "../check.wap"
use "scripted.wap"
use process

# what the tree's wap verify prints of a program, its verdicts (a refusal it says goes to standard error)
verdicts(name: text, program: text): text := run([script.wap, "verify", written(name, program)], folder: script.tree).out.trim()
POSITIVE := "law positive(x: int): x > 0\n"
check("a law without binders that holds is Proved by computing it", verdicts("closed", "law both: 1 < 2 and 2 < 3"), "both: Proved")
check("a law without binders that breaks is FAILED", verdicts("closed_broken", "law two: 2 + 2 == 5"), "two: FAILED")
check("a law over whole numbers is tried on them", verdicts("twice", "twice(x) := x + x\nlaw twice_doubles:\n  for x: int\n  twice(x) == 2 * x"), "twice_doubles: Tested")
check("a law over whole numbers shows the number that breaks it", verdicts("positive", POSITIVE), "positive: FAILED, counterexample x = 0")
check("a law the theory refuses leaves the other laws their verdicts", verdicts("beside_float", "law tested(x: float): x * 1.0 == x\n" + POSITIVE), "tested: Tested\npositive: FAILED, counterexample x = 0")
