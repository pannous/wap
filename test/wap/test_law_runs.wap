# wap verify runs each law as the program runs: a closed law, laws with written binders and their `for` lines, each
# with its own verdict, Tested or FAILED with every binder's value, a law the theory refuses beside the others.
# Source: wiki/law.md "Checking a law", wiki/proof.md "Checking proofs", wiki/proposition.md
use "../check.wap"
use "scripted.wap"
use process

# what the tree's wap verify prints of a program, its verdicts (a refusal it says goes to standard error)
verdicts(name: text, program: text): text := run([script.wap, "verify", written(name, program)], folder: script.tree).out.trim()
POSITIVE := "law positive(x: int): x > 0\n"
check("a law without binders that holds is Proved by computing it", verdicts("closed", "law both: 1 < 2 and 2 < 3"), "both: Proved")
check("a law without binders that breaks is FAILED", verdicts("closed_broken", "law two: 2 + 2 == 5"), "two: FAILED")
check("a law over whole numbers is tried on them", verdicts("twice", "twice(x) := x + x\nlaw twice_doubles:\n  for x: int\n  twice(x) == 2 * x"), "twice_doubles: Tested")
check("a law over whole numbers shows the number that breaks it", verdicts("positive", POSITIVE), "positive: FAILED, counterexample x = 0")
check("a law over truths shows the truth that breaks it by its word", verdicts("truth_broken", "law affirmed(b: bool): b == yes"), "affirmed: FAILED, counterexample b = no")
check("a law the theory refuses leaves the other laws their verdicts", verdicts("beside_float", "law tested(x: float): x * 1.0 == x\n" + POSITIVE), "tested: Tested\npositive: FAILED, counterexample x = 0")
# a module compiled for others carries its laws' verdicts, checked once when it was built, never again where it is
# used (the user's law stamps, wap-supervisor 2026-11-27): wap build --wasm stamps them, a plain compile stamps none
DOUBLE := "double(n: int): int := n + n\nlaw doubled(n: int): double(n) == 2 * n\n"
# what wap verify prints of a program using the module of that name
user_verdicts(module: text): text := verdicts("${module}_user", "use \"${module}.wasm\"\nprint double(2)")
run([script.wap, "build", "--wasm", written("stamped", DOUBLE)], folder: script.stage)
check("a module wap build --wasm made shows its laws' verdicts in a program that uses it", user_verdicts("stamped"), "doubled: Tested")
compiled("unstamped", DOUBLE)
check("a module compiled without its laws checked shows them Untested", user_verdicts("unstamped"), "unstamped.wasm: Untested")
# a law of a recursive function of a program's enum is proved by computing (wiki/law.md "Checking a law", wiki/proof.md "Ways to prove")
TREE := "enum Tree { leaf, node(left: Tree, right: Tree) }\nleaves(t: Tree): int := match t { leaf => 1; node(l, r) => leaves(l) + leaves(r) }\n"
check("a law of a recursive function of an enum is proved by computing", verdicts("four_leaves", TREE + "law four_leaves: leaves(node(node(leaf, leaf), node(leaf, leaf))) == 4\n"), "four_leaves: Proved")
# a law of a function matching an enum's cases is proved by computing (wiki/enum.md, notes/coc-t5b4.md)
COIN := "enum Coin { Penny, Nickel, Dime }\ncents(c: Coin): int := match c { Penny => 1; Nickel => 5; Dime => 10 }\n"
check("a law of a function matching an enum's cases is proved by computing", verdicts("dime", COIN + "law dime: cents(Dime) == 10\n"), "dime: Proved")
