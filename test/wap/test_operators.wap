# wap's operator stage (notes/backbone.md "Operators", wiki/precedence.md): a program printed back by `format` in
# canonical warp, every operator read by the table of wap/types/operators.wap.
use "../check.wap"
use "scripted.wap"

format_check("1+2 * 3", "1 + 2 * 3")
format_check("(1 + 2) * 3", "(1 + 2) * 3")
format_check("2^3^2", "2 ^ 3 ^ 2")
format_check("8 - 4 - 2", "8 - 4 - 2")
format_check("x ≤ y", "x <= y")
format_check("a plus b", "a + b")
format_check("yes and true", "yes and yes")
format_check("x += 1", "x += 1")
format_check("f = x => x", "f = x => x")
format_check("f: (int)->int", "f: (int) -> int")
format_check("x  +=1", "x += 1")
format_check("x = c?1 : 2", "x = c ? 1 : 2")
format_check("print if c then 1 else 2", "print (if c then 1 else 2)")
format_check("not a and b", "not a and b")
# the minus rule: spacing decides prefix or infix, and format spells the reading out
format_check("[a -1]", "[a, -1]")
# a number glued to a word multiplies it, the unit library's overload of * taking it; spaced they are a list, and two
# literals stay two items (wiki/significant-whitespace.md, user 2026-11-23: implicit multiplication only glued)
format_check("[1 2]", "[1 2]")
format_check("[1 -2]", "[1, -2]")
check("a number glued to a word multiplies it, spaced they are a list", ran("measure", "class U { name: text }\nclass Q { amount: int, unit: text }\n*(n: int, u: U) as Q := Q(n, u.name)\n*(q: Q, n: int) as Q := Q(q.amount * n, q.unit)\n>(a: Q, b: Q) as bool := a.amount > b.amount\nshown(q: Q) as text := text(q.amount) + q.unit\nm = U(\"m\")\nx = 2000m\ns = shown 5m\nspaced = 5 m\nprint(shown(3m * 2) + \" \" + text(x > 1500m) + \" \" + s + \" \" + text(#spaced))"), "6m yes 5m 2")
format_check("[a - 1]", "[a - 1]")
format_check("a-b", "a - b")
format_check("print -x", "print (-x)")
format_check("print 1 + 2", "print 1 + 2")
# a spaced call takes the whole expression after it (decision spaced-call-precedence): brackets keep the other reading
format_check("(square 3) * 3", "(square 3) * 3")
format_check("square(3) * 3", "square(3) * 3")
# brackets that precedence makes needless are dropped, the others kept
format_check("1 + (2 * 3)", "1 + 2 * 3")
# a program's own operators (wiki/operator.md): a declared infix binds like +, a placed one by its relation
format_check("infix operator ⊕(a, b) := a * b\n1 ⊕ (2 * 3)\n(1 ⊕ 2) * 3", "infix operator ⊕(a, b) := a * b\n1 ⊕ 2 * 3\n(1 ⊕ 2) * 3")
format_check("infix operator ⊗ := left * right\noperator ⊗ has precedence above *\n2 * (3 ⊗ 4)", "infix operator ⊗ := left * right\noperator ⊗ has precedence above *\n2 * 3 ⊗ 4")
format_check("infix operator divides(d, n) := n % d == 0\n3 divides (2 * 6)", "infix operator divides(d, n) := n % d == 0\n3 divides 2 * 6")
# the declared spelling is a name in its declaration, not the table's operator: ³ declares, never applies to `operator`
format_check("suffix operator ³ := it * it * it", "suffix operator ³ := it * it * it")
# a precedence declaration places its operator and is no code: `%` below `+` reads 1 + 7 % 4 as (1 + 7) % 4
check("a placed operator binds by its place", ran("placed", "operator % has precedence below +\nprint(text(1 + 7 % 4))"), "0")
# a suffix operator is the function of its operand `it` (wiki/keyword.md, wiki/operator.md)
check("a suffix operator doubles", ran("doubled", "suffix operator ‼ := it*2\nprint(text(3‼))"), "6")
check("a suffix operator cubes", ran("cubed", "suffix operator ³ := it * it * it\nprint(text(2³))"), "8")
# an operator with no operand after it is a name
format_check("total := fold +", "total := fold +")
# a function's result type prints after `as`, the canonical word (wiki/function.md); a typed name keeps its `:`
format_check("twice(x): int := x * 2", "twice(x) as int := x * 2")
format_check("x: int := 3", "x: int := 3")
format_check("x: int = 3", "x: int = 3")
# a case named by its enum, either way (wiki/enum.md)
format_check("Coin::Dime", "Coin.Dime")
format_check("x = p . x+1", "x = p.x + 1")
format_check("rule show { ($k: $v)... } => 1", "rule show {($k: $v)...} => 1")
# an optional's value, `x!` (wiki/optional.md), beside the prefix `!x` for not
format_check("y = x!", "y = x!")
format_check("z = !x", "z = not x")
# a word leading a rule's phrase after an infix takes the rest of the phrase, as at a phrase's start; other words stay operands
format_check("x = f(a) ?? return ø", "x = f(a) ?? (return ø)")
format_check("x = f(a) ?? return text 0", "x = f(a) ?? (return text 0)")
format_check("n = if s < 0 then 0 - s else s", "n = if s < 0 then 0 - s else s")
format_check("z = a ?? if c {1} else {2}", "z = a ?? (if c {1} else {2})")
check("a match after an assignment keeps its arms", ran("assigned_match", "x = 2\ny = match x { 1 => \"a\"; _ => \"b\" }\nprint y"), "b")
check("an if after ?? takes its blocks", ran("default_if", "f(n: int) as int? := if n > 0 then n else ø\nz = f(0) ?? if 2 > 1 {7} else {8}\nprint text(z)"), "7")
format_check("x = if c then 1\n	else 2", "x = if c then 1 else 2")
check("a line ending in then or else takes the next line, and only that one", ran("trailing_then", "chosen(n: int) as text := {\n	if n > 2 then\n	\"a\"\n	else\n	\"b\"\n}\ny = \"c\"\nprint chosen(1) + y"), "bc")
check("a word inside a rule's phrase is the program's own outside that phrase", ran("own_out", "rule tagged out $x => 1\nf(xs: list<int>): list<int> := {\n	out: list<int> = []\n	for x in xs { out.add(x) }\n	out\n}\nprint(text(f([1, 2])))"), "[1, 2]")
format_check("if c\n	print \"a\"", "if c {\n	print \"a\"\n}")
format_check("r = 2..", "r = 2 ..")
format_check("q = ..3", "q = .. 3")
format_check("x = ø", "x = ø")
check("an operator glued to brackets is a call, as f(x) is", ran("glued_operator_call", "squared(n: int) as int := n * n\nnext(n: int) as int := n + 1\nxs = [1, 2, 3]\nprint(text(-(3).squared) + \" \" + text(#(xs).next) + \" \" + text(#((xs).filter(x => x > 1))) + \" \" + text(#xs.filter(x => x > 1)))"), "9 4 2 2")
# a rule's word before an operator is an operand, as any word is
format_check("2 * no + 1", "2 * no + 1")
# a built-in operator overloaded by its operands' types, its built-in kept where they fit (wiki/operator.md "Operator
# overloading"); a declared operator's result type written as a function's
check("an operator overloaded for two texts, the built-in kept for two ints", ran("overloaded_times", "*(a: text, b: text): int := 7\nprint(text(\"a\" * \"b\"))\nprint(text(2 * 3))"), "7\n6")
check("an operator overloaded for a class", ran("class_plus", "class P { x: int }\n+(a: P, b: P): P := P{x: a.x + b.x}\nprint(text((P{x: 1} + P{x: 2}).x))"), "3")
check("a declared operator with its result type", ran("typed_operator", "infix operator ⇔(a: bool, b: bool): bool := a == b\nprint(text((1 > 0) ⇔ (2 > 0)))"), "yes")
# a glyph nobody declared is a name like any other (wiki/operator.md): a function of that name, called glued to its arguments
check("a free glyph names a function", ran("glyph_function", "⊕(a: int, b: int): int := a * 10 + b\nprint(text(⊕(4, 2)))"), "42")
# operator symbols run from U+2000 to U+2BFF; letterlike ones and ∞ ∅ € are letters; a symbol glued to a word is declared as one (wiki/operator.md)
check("a symbol glued to a word is declared as one operator", ran("glued_spelling", "infix operator ⊕s(a: int, b: int) := a * 10 + b\n∞x = 2\nprint(text(1⊕s ∞x) + \" \" + text(5 – 3) + \" it’s\")"), "12 2 it’s")
# a chain of truth values reads two ways, a chain or a comparison of a comparison (wiki/Footguns.md "Chained comparison")
check("a chain of truth values is refused naming both readings", ran("truth_chain", "p = yes\nq = yes\nr = no\nprint(p == q == r)").contains("write (p == q) == r or p == q and q == r"), yes)
