# wap optimize: the program written again without the functions and constants nothing calls, each removed one said (wiki/cli.md)
use "../check.wap"
use "scripted.wap"

app = written("app", "used(x: int) as int := x + 1\nhelper(y: int) as int := y * 2\ncaller() := helper(3)\nprint used(1)")
check("optimize says each function nothing calls", optimized(app), "removed: helper\nremoved: caller")
check("optimize writes the program without them", file_text(app), "used(x: int): int := x + 1\nprint used(1)")
library = written("library", "twice(x: int) as int := x * 2")
optimized(library)
check("a file of definitions only has no caller to judge by: it keeps them all", file_text(library), "twice(x: int): int := x * 2")
shared = written("shared", "helper() := 1; print 2")
optimized(shared)
check("optimize removes only the function, never the code beside it on its line", file_text(shared), "print 2")
constants = written("constants", "LIMIT := 3\nUNUSED := 4\nprint LIMIT")
check("optimize says each constant nothing reads", optimized(constants), "removed: UNUSED")
check("optimize writes the program without it", file_text(constants), "LIMIT := 3\nprint LIMIT")
commented = written("commented", "# doubles a count\ndoubled(x: int) as int := x * 2\nspare() := 1\nprint doubled(1)")
optimized(commented)
check("optimize keeps the comments", file_text(commented), "# doubles a count\ndoubled(x: int): int := x * 2\nprint doubled(1)")
tools = written("tools", "thrice(x: int) as int := x * 3\nprint 1")
written("user", "use \"tools.wap\"\nprint thrice(2)")
check("a function another file of the folder calls stays", optimized(tools), "")
# a sibling's comment naming a function calls nothing: only a file that uses this one and calls it keeps it
lonely = written("lonely", "spare(x: int) as int := x * 3\nprint 1")
written("mentions", "# spare is not called here\nprint 2")
check("a function a sibling only mentions is removed", optimized(lonely), "removed: spare")
