# wap optimize: the program written again without the functions nothing calls, each removed one said (wiki/cli.md)
use "../check.wap"
use "scripted.wap"

app = written("app", "used(x: int) as int := x + 1\nhelper(y: int) as int := y * 2\ncaller() := helper(3)\nprint used(1)")
check("optimize says each function nothing calls", optimized(app), "removed: helper\nremoved: caller")
check("optimize writes the program without them", file_text(app), "used(x: int) as int := x + 1\nprint used(1)")
library = written("library", "twice(x: int) as int := x * 2")
optimized(library)
check("a file of definitions only has no caller to judge by: it keeps them all", file_text(library), "twice(x: int) as int := x * 2")
shared = written("shared", "helper() := 1; print 2")
optimized(shared)
check("optimize removes only the function, never the code beside it on its line", file_text(shared), "print 2")
