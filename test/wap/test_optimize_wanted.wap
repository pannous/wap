# wap optimize strips the constants and uses nothing reaches too (wiki/cli.md)
use "../check.wap"
use "scripted.wap"

constants = written("constants", "LIMIT := 3\nUNUSED := 4\nprint LIMIT")
check("optimize says each constant nothing reads", optimized(constants), "removed: UNUSED")
check("optimize writes the program without it", file_text(constants), "LIMIT := 3\nprint LIMIT")
helper = written("helper", "twice(x: int) as int := x * 2")
uses = written("uses", "use \"helper.wap\"\nprint 1")
check("optimize says each use nothing reaches", optimized(uses), "removed: use \"helper.wap\"")
check("optimize writes the program without it", file_text(uses), "print 1")
