# wap optimize strips the uses nothing reaches too (wiki/cli.md)
use "../check.wap"
use "scripted.wap"

helper = written("helper", "twice(x: int) as int := x * 2")
uses = written("uses", "use \"helper.wap\"\nprint 1")
check("optimize says each use nothing reaches", optimized(uses), "removed: use \"helper.wap\"")
check("optimize writes the program without it", file_text(uses), "print 1")
