# the refusals wiki/function.md and wiki/overloading.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "../check.wap"
use "scripted.wap"

# both fit summed(1000000, 0): the first with c's default, the second exactly
TWO_SUMMED := "summed(a: int, b: int = 10, c: int = 100) := a + b + c\nsummed(n: int, total: int) := n + total\n"
check("a call two functions fit equally is refused as ambiguous, naming both", lines_with(ran("ambiguous", TWO_SUMMED + "print summed(1000000, 0)"), "is ambiguous"), 1)
check("a method is called beside a local of the same name", ran("local_beside_method", "positive(xs: list<int>): bool := {\n\tall = 3\n\txs.all(x => x > all - 3)\n}\nprint positive([1, 2])"), "yes")
