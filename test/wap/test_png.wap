# lib/png.wap reads a PNG's pixels and writes pictures as PNGs (its header names what it reads): pictures Python's PIL
# writes in each color type, red on the left half and blue on the right, and a PNG png writes, read back by PIL
use process
use "../check.wap"
use "scripted.wap"

# what Python printed, run isolated (its warnings on stderr left out)
python_said(code: text): text := run(["python3", "-I", "-c", code]).out
# a 16 × 8 PNG, its left half red and right half half-transparent blue, in a mode PIL writes it in
picture_written(name: text, mode: text): text := {
	path = staged(name + ".png")
	python_said("from PIL import Image\npicture = Image.new('RGBA', (16, 8), (255, 0, 0, 255))\npicture.paste((0, 0, 255, 128), (8, 0, 16, 8))\npicture.convert('${mode}').save('${path}')")
	path
}
# the picture's size and its pixels at the left and the right half's middle, as the program reads them
read_back(name: text, mode: text): text := ran("png_${name}", "use png\nuse color\npicture = png_picture(read_bytes(\"${picture_written(name, mode)}\"))\nprint \"\${picture.width}x\${picture.height} \${picture.pixels[4 * 16 + 3]} \${picture.pixels[4 * 16 + 12]}\"")

check("an RGB PNG's size and colors", read_back("rgb", "RGB"), "16x8 red blue")
check("an RGBA PNG keeps its alpha", read_back("rgba", "RGBA"), "16x8 red #0000ff80")
check("a palette PNG keeps its transparency", read_back("palette", "P"), "16x8 red #0000ff80")
check("a gray PNG's pixels are grays", read_back("gray", "L"), "16x8 #4c4c4c #1d1d1d")
check("a gray PNG with alpha", read_back("gray_alpha", "LA"), "16x8 #4c4c4c #1d1d1d80")
check("a 1-bit PNG's pixels are black and white", read_back("bit", "1"), "16x8 black black")
written_png = staged("written.png")
check("a picture written as a PNG reads back in PIL", then_ran(compiled("png_written", "use png\nuse color\nwrite_bytes(\"${written_png}\", png_bytes(Picture(2, 1, [red, with_alpha(blue, 0.5)])))"), () => [said([script.wap, module_of("png_written")]), python_said("from PIL import Image\nprint(list(Image.open('${written_png}').getdata()))")].filter(t => t != "").join("\n")), "[(255, 0, 0, 255), (0, 0, 255, 128)]")
