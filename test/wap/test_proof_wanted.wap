# the refusals and verdicts wiki/proof.md shows that wap does not build yet: each red line is a to-do, fixed by
# building the form
use "../check.wap"
use "scripted.wap"

double = "double(n: nat): nat := match n { zero => 0; successor(k) => double(k) + 2 }\nenum Even: nat -> Prop { zero: Even(0), step(e: Even(n)): Even(n + 2) }\n"
proved = double + "law double_even(n: nat): Even(double(n)) :=\n\tmatch n { zero => Even.zero; successor(k) => Even.step(double_even(k)) }\n"
check("wap verify: a law with its proof is Proved", wap_said(["verify", written("proved", proved)]), "double_even: Proved")
check("wap verify: a law nobody proved is Tested", wap_said(["verify", written("tested", "law tested(x: float): x * 1.0 == x")]), "tested: Tested")
check("wap verify: a broken law shows its counterexample", wap_said(["verify", written("broken", "law broken(n: nat): n * n > n")]), "broken: FAILED, counterexample n = 0")
check("wap verify: an assume shows as Assumed", wap_said(["verify", written("assumed", "law hard(n: nat): n * n >= n := assume")]), "hard: Assumed")
check("an axiom is reported", ran("axiom", "axiom twin_primes:\n\tfor n: nat\n\texists p: nat where p > n and prime(p) and prime(p + 2)\nprint axioms of twin_primes"), "[twin_primes]")
