# the refusals and verdicts wiki/proof.md shows that wap does not build yet: each red line is a to-do, fixed by
# building the form
use "../check.wap"
use "scripted.wap"

double = "double(n: nat): nat := match n { zero => 0; successor(k) => double(k) + 2 }\nenum Even(n: nat): Prop { zero: Even(0), step(e: Even(n)): Even(n + 2) }\n"
proved = double + "law double_even(n: nat): Even(double(n)) :=\n\tmatch n { zero => Even.zero; successor(k) => Even.step(double_even(k)) }\n"
check("wap verify: a law with its proof is Proved", wap_said(["verify", written("proved", proved)]), "double_even: Proved")
check("wap verify: a law nobody proved is Tested", wap_said(["verify", written("tested", "law tested(x: float): x * 1.0 == x")]), "tested: Tested")
check("wap verify: a broken law shows its counterexample", wap_said(["verify", written("broken", "law broken(n: nat): n * n > n")]), "broken: FAILED, counterexample n = 0")
check("wap verify: an assume shows as Assumed", wap_said(["verify", written("assumed", "law hard(n: nat): n * n >= n := assume")]), "hard: Assumed")
check("a wrong proof names both statements", from_mark(ran("wrong", double + "law wrong(n: nat): Even(double(n)) := Even.zero"), "refused"), "refused: Even.zero proves Even(0), not Even(double(n))")
check("a match that misses a case proves nothing", from_mark(ran("missing", double + "law partial(n: nat): Even(double(n)) := match n { zero => Even.zero }"), "refused"), "refused: the match misses successor")
check("a loop is no proof", from_mark(ran("loop", "loop(): False := loop()\nlaw oops: False := loop()"), "refused"), "refused: loop may not end, and a proof must")
check("a raise is no proof", from_mark(ran("raise", "law oops: False := raise \"no\""), "refused"), "refused: a proof cannot raise")
check("a tested law proves nothing", from_mark(ran("tested_used", "law guess(x: float): x * 1.0 == x\nlaw use(x: float): x * 1.0 == x := guess(x)"), "refused"), "refused: guess is only Tested, not Proved")
check("an axiom is reported", ran("axiom", "axiom twin_primes:\n\tfor n: nat\n\texists p: nat where p > n and prime(p) and prime(p + 2)\nprint axioms of twin_primes"), "[twin_primes]")
