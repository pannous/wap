# the refusals and propositions of wiki/proposition.md that a program reaches with its own enums, run as programs
use "../check.wap"
use "scripted.wap"

check("an if on a proposition an enum declares is refused", refused_by(ran("undecided_enum", "enum Holds: Prop { proof }\nif Holds { print 1 }")), "refused by undecidable condition")
check("a implies b over propositions is the function from a's proofs to b's", ran("implies_props", "enum Holds: Prop { proof }\nfollows(a: Prop, b: Prop): Prop := a implies b\nprint(type of follows(Holds, Holds))"), "Prop")
check("a proposition implies itself", ran("implies_itself", "enum Holds: Prop { proof }\nitself(a: Prop): Prop := a implies a\nprint(type of itself(Holds))"), "Prop")
