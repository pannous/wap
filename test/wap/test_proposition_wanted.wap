# the refusals and verdicts wiki/proposition.md shows that wap does not build yet: each red line is a to-do, fixed by
# building the form
use "../check.wap"
use "scripted.wap"

check("refl proves what computes to the same", wap_said(["verify", written("four", "law four: 2 + 2 == 4 := refl")]), "four: Proved")
check("refl refuses what computes to different values", refused_by(ran("five", "law five: 2 + 2 == 5 := refl")), "refused by value type")
check("an if on a proposition nobody can decide is refused", refused_by(ran("undecided", "if exists n: nat where n * n == 2 { print 1 }")), "refused by undecidable condition")
check("a while on a proposition nobody can decide is refused too", refused_by(ran("while_undecided", "use logic\nwhile exists n: nat where n * n == 2 { print 1 }")), "refused by undecidable condition")
check("a proof decides no data", refused_by(ran("which", "which(p: A or B): bool := match p { left(a) => yes; right(b) => no }")), "refused by elimination")
check("Even(3) has no proof", refused_by(ran("three_even", "enum Even: nat -> Prop { zero: Even(0), step(e: Even(n)): Even(n + 2) }\nlaw three: Even(3) := Even.step(Even.zero)")), "refused by value type")
mutual = "enum Even: nat -> Prop { zero: Even(0), next(o: Odd(n)): Even(n + 1) }\nenum Odd: nat -> Prop { next(e: Even(n)): Odd(n + 1) }\n"
check("two propositions defined together", ran("mutual", mutual + "law two: Even(2) := Even.next(Odd.next(Even.zero))\nprint 2"), "2")
check("excluded middle comes with use classical", wap_said(["verify", written("classical", "use classical\nlaw either(A: Prop): A or not A := excluded_middle(A)")]), "either: Proved, rests on excluded_middle")
