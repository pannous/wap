# the refusals and verdicts wiki/proposition.md shows that wap does not build yet: each red line is a to-do, fixed by
# building the form
use "../check.wap"
use "scripted.wap"

check("refl proves what computes to the same", wap_said(["verify", written("four", "law four: 2 + 2 == 4 := refl")]), "four: Proved")
mutual = "enum Even: nat -> Prop { zero: Even(0), next(o: Odd(n)): Even(n + 1) }\nenum Odd: nat -> Prop { next(e: Even(n)): Odd(n + 1) }\n"
check("two propositions defined together", ran("mutual", mutual + "law two: Even(2) := Even.next(Odd.next(Even.zero))\nprint 2"), "2")
check("excluded middle comes with use classical", wap_said(["verify", written("classical", "use classical\nlaw either(A: Prop): A or not A := excluded_middle(A)")]), "either: Proved, resting on excluded_middle")
