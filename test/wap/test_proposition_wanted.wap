# the refusals and verdicts wiki/proposition.md shows that wap does not build yet: each red line is a to-do, fixed by
# building the form
use "../check.wap"
use "scripted.wap"

check("refl proves what computes to the same", wap_said(["verify", written("four", "law four: 2 + 2 == 4 := refl")]), "four: Proved")
check("refl refuses what computes to different values", from_mark(ran("five", "law five: 2 + 2 == 5 := refl"), "refused"), "refused: 2 + 2 computes to 4, not 5")
check("an if on a proposition nobody can decide is refused", from_mark(ran("undecided", "if exists n: nat where n * n == 2 { print 1 }"), "refused"), "refused: wap cannot decide whether some n has n * n == 2")
check("a proof decides no data", from_mark(ran("which", "which(p: A or B): bool := match p { left(a) => yes; right(b) => no }"), "refused"), "refused: a proof cannot decide data")
check("Even(3) has no proof", from_mark(ran("three_even", "enum Even(n: nat): Prop { zero: Even(0), step(e: Even(n)): Even(n + 2) }\nlaw three: Even(3) := Even.step(Even.zero)"), "refused"), "refused: Even.step(Even.zero) proves Even(2), not Even(3)")
mutual = "enum Even(n: nat): Prop { zero: Even(0), next(o: Odd(n)): Even(n + 1) }\nenum Odd(n: nat): Prop { next(e: Even(n)): Odd(n + 1) }\n"
check("two propositions defined together", ran("mutual", mutual + "law two: Even(2) := Even.next(Odd.next(Even.zero))\nprint 2"), "2")
check("excluded middle comes with use classical", wap_said(["verify", written("classical", "use classical\nlaw either(A: Prop): A or not A := excluded_middle(A)")]), "either: Proved, resting on excluded_middle")
