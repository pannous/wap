# the refusals wiki/quotient.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "../check.wap"
use "scripted.wap"

rational = "class fraction { top: int; bottom: int where it != 0 }\nsame_value(a: fraction, b: fraction) := a.top * b.bottom == b.top * a.bottom\ntype rational = quotient(fraction, same_value)\n"
check("a function that tells joined values apart is refused", from_mark(ran("top", rational + "top(q: rational): int := q.lift(f => f.top)"), "refused"), "refused: top gives 1 for 1/2 and 2 for 2/4")
check("a function of a class with its own equals must respect it", from_mark(ran("first_letter", "class word { letters: text }\nequals(a: word, b: word) := a.letters.lower == b.letters.lower\nfirst_letter(w: word): text := w.letters#1"), "refused"), "refused: first_letter gives \"H\" for word(\"Hi\") and \"h\" for word(\"hi\")")
