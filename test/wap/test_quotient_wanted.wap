# the refusals wiki/quotient.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "../check.wap"
use "scripted.wap"

rational = "class fraction { top: int; bottom: int where it != 0 }\nsame_value(a: fraction, b: fraction) := a.top * b.bottom == b.top * a.bottom\ntype rational = quotient(fraction, same_value)\n"
check("a function that tells joined values apart is refused", refused_by(ran("top", rational + "top(q: rational): int := q.lift(f => f.top)")), "refused by unproved condition")

# i64 is the quotient of the whole numbers by multiples of 2^64 (wiki/quotient.md "Quotients in the library"): a word's
# wrapping sum is the exact sum as a value of that quotient, and a law true of ints only is no law of words
word_sum = "law word_sum(a: i64, b: i64): (quotient.of((a + b) as int) as wrapped) == quotient.of((a as int) + (b as int))\n"
check("wap verify: a word's sum is the exact sum up to multiples of 2^64", wap_said(["verify", written("word_sum", word_sum)]), "word_sum: Proved")
check("wap verify: a law of ints that fails at the largest word is never proved of i64", wap_said(["verify", written("word_up", "law up(a: i64): a + 1 > a\n")]) == "up: Proved", no)
