# wap's raise (wap/types/prelude.wap; wiki/keyword.md raise): the program stops, its message on the standard error;
# raise fits where any value is wanted, since it never gives one
use "../check.wap"
use "scripted.wap"

positive = "positive(x: int): int := if x > 0 then x else raise \"not positive\"\n"
check("raise stops the program with its message", ran("stops", "print \"before\"\nraise \"stopped\"\nprint \"after\""), "before\nstopped")
check("raise stands where a value is wanted", ran("as_value", positive + "print \"ok\"\npositive(-1)"), "ok\nnot positive")
check("the value when raise does not run", ran("not_raised", positive + "positive(5)"), "5")
check("an error line, and the program runs on", ran("error_line", "note(t: text) := eprint(t)\nnote(\"careful\")\nprint \"still running\""), "careful\nstill running")
check("a hint is a got-it line on the standard error, the program going on", ran("hinted", "hint \"write a + b\"\nprint \"out\""), "hint: write a + b\nout")
# throw, fail and panic are other names of raise (wiki/keyword.md)
check("throw is another name of raise", ran("thrown", "throw \"bad\""), "bad")
# a text that spells a number joined with an int gets its hint once a run, however often a loop joins one (wiki/string.md)
check("the hint on a text spelling a number comes once a run", lines_with(ran("digits_hinted", "for i in 1 to 3 { print(\"1\" + i) }"), "hint: "), 1)
