# wap's reader (wap/core/parse/reader.wap; wiki/syntax.md): text read as notation, data and code alike, and printed
# back by `wap format` in canonical warp. The cases are wasp's reader tests and the reader's decisions.
use "../check.wap"
use "scripted.wap"

# atoms: numbers as written, read as their value; texts in double quotes, words as written
format_check("1 3. 0xFF 1_000 1e3 1.5e-3 3.25", "1 3. 0xFF 1_000 1e3 1.5e-3 3.25")
check("numbers read as their value", [3., 0xFF, 1_000, 1e3, 1.5e-3], [3.0, 255, 1000, 1000, 0.0015])
format_check("'hi'", "\"hi\"")
format_check("\"\\x41\\u{1F600}\"", "\"A😀\"")
format_check("\"a\\nb\\tc\"", "\"a\\nb\\tc\"")
# a character prints as its one-character text, a carriage return as \r (wiki/char.md)
format_check("c = '\\r'", "c = \"\\r\"")
format_check("`hello $test`", "\"hello $test\"")
format_check("yes", "yes")
format_check("null", "ø")
# lists: brackets kept, separators cascade (the loosest splits first), trailing separators drop
format_check("1 2 3", "1 2 3")
format_check("(1,2,3)", "(1, 2, 3)")
format_check("1;2;3", "1; 2; 3")
format_check("[1 2 3]", "[1 2 3]")
format_check("[1,2,]", "[1, 2]")
format_check("a b; c d", "a b; c d")
format_check("a,b,c;d,e,f", "a, b, c; d, e, f")
format_check("{ a b , c d ; e f , g h }", "{a b, c d; e f, g h}")
# keys: `:` glued binds tight, `: ` takes the rest of the phrase, ` : ` all before it
format_check("{aa:3}", "{aa: 3}")
format_check("a:'HIO' b:3 c:{x:1}", "a:\"HIO\" b:3 c: {x: 1}")
format_check("{deep{a:3,b:4,c:{d:'hi'}}}", "{deep{a: 3, b: 4, c: {d: \"hi\"}}}")
format_check("a b:c", "a b: c")
format_check("a: b c d", "a: b c d")
format_check("a b : c", "(a b): c")
format_check("a-b:2 c-d:4 a-b", "(a - b):2 (c - d):4 a - b")
format_check("x:40;x+1", "x: 40; x + 1")
# glue: a head glued to brackets is one item, a blank makes two
format_check("a{x:1}", "a{x: 1}")
format_check("a:{x:1}", "a: {x: 1}")
format_check("a b (c)", "a b (c)")
format_check("a b(c)", "a b(c)")
format_check("div{ class:'bold' 'text'}", "div{class:\"bold\" \"text\"}")
format_check("body(style='blue'){a(link)}", "body(style = \"blue\"){a(link)}")
format_check("#[0 1 2 3]", "#[0 1 2 3]")
# a URL is one text, whatever its scheme
format_check("[http://x.com/a?b=1, file:///tmp/x]", "[\"http://x.com/a?b=1\", \"file:///tmp/x\"]")
format_check("f(x)(y) quiet()", "f(x)(y) quiet()")
format_check("1 m + 1km", "1 m + 1km")
# signs: glued to digits where an item starts a number, else an operator; operators join repeats and one `=`
format_check("1 - -3", "1 - -3")
format_check("x=-1", "x = -1")
format_check("a=1", "a = 1")
# indentation: a deeper line opens a block glued to the line before; inside brackets it means nothing
format_check("a{\n  b,c}", "a{\n	b, c\n}")
# a bracket written one item per line keeps its lines, each with its comma, and the items written on one line together
format_check("[\n\t1,\n\t2, 3 # three\n]", "[\n\t1,\n\t2, 3 # three\n]")
format_check("{\n  a: 1,\n  b: 2}", "{\n\ta: 1,\n\tb: 2\n}")
format_check("a\n  b\n  c\nd\ne", "a{\n	b\n	c\n}\nd\ne")
format_check("a:\n  b\n  c\n\nd\ne", "a: {\n	b\n	c\n}\n\nd\ne")
format_check("a\n  b\n    c\nd", "a{\n	b{\n		c\n	}\n}\nd")
format_check("  a\n    b\n  c", "a{\n	b\n}\nc")
# typed declarations and type lists
format_check("x:int=3", "x: int = 3")
format_check("xs:list<int>", "xs: list<int>")
format_check("f: map<text,(int,int)->int>", "f: map<text, (int, int) -> int>")
format_check("n: list<list<int>>", "n: list<list<int>>")
format_check("x<y and y>z", "x < y and y > z")
format_check("f(x):int:=x", "f(x) as int := x")
format_check("sample: int := 7", "sample: int := 7")
# comments are no code, and format keeps them: a block comment within a line on a line of its own
format_check("blah a b c # note\ny/* c */=0 // c", "blah a b c # note\n# c\ny = 0 # c")
# a glyph run takes the `=`s glued after it: `!==` is one operator, not `!=` then a key
format_check("1 !== 2", "1 !== 2")
# a block indented after a key at the line's end is the key's value: a definition's body on the next line
format_check("f(x: int): int :=\n	x + 1", "f(x: int) as int := {\n	x + 1\n}")
# an operator ending its line continues the phrase onto the lines indented below it
format_check("y = 1 +\n	2 +\n	3\nz = 4", "y = 1 + 2 + 3\nz = 4")
check("a comma at a line's end continues the row, a line without one starts a new row", ran("comma_rows", "xs = [\n	1, 2,\n	3, 4,\n]\nys = [1, 2\n3, 4]\nprint text(#xs) + \" \" + text(#ys)"), "4 2")
# an operator word where no operator can stand is a name: a parameter `to` ending a phrase, or glued to a member
check("a word operator as a parameter's name", ran("operator_names", "same_side(from: text, to: text) as bool := from.starts_with(\"/\") == to.starts_with(\"/\")\ndiffer(from: text, to: text) as bool := from != to\njoined(from: text, to: text) as text := \"from \" + from + \" to \" + to + \".\"\nprint text(same_side(\"/a\", \"b\")) + \" \" + text(differ(\"a\", \"b\")) + \" \" + joined(\"a\", \"b\")"), "no yes from a to b.")
# a class's fields on one `;` row, its methods on the lines after (wiki/class.md)
check("a row of fields, then a method", ran("field_row", "class Cursor { s: text; at: int\n	done() as bool := at >= 3\n}\nprint text(Cursor(\"x\", 4).done())"), "yes")
# a list of spaced values keeps its round brackets and blanks (user 2026-11-23)
format_check("x = (1 2)", "x = (1 2)")
# format keeps what a line says beside its code: comments above and after it, a run of blank lines as one, a block
# written over lines on lines of its own, a tab per depth, `/* */` as `#` lines (card format-keeps-comments)
format_check("# first\nx = 1 # one\n\n\n// second\ny = 2\n# last", "# first\nx = 1 # one\n\n# second\ny = 2\n# last")
format_check("f(a) := {\n	y = a\n	if y > 2 {\n		print y\n	}\n}", "f(a) := {\n	y = a\n	if y > 2 {\n		print y\n	}\n}")
format_check("/* a\n   b */\nx = 1", "# a\n# b\nx = 1")
format_check("if a { print y }", "if a {print y}")
# a raw word's block is written back as it was written (wiki/dsl.md)
format_check("sql(command: raw) := command\nsql {select *  from t /* all */}", "sql(command: raw) := command\nsql {select *  from t /* all */}")
# a phrase the parameter counts read prints as that reading: nested words take the result of the next (wiki/call.md)
format_check("print sin cos 0", "print(sin(cos(0)))")
# a phrase word's rest is written back as it was written (wiki/dsl.md)
format_check("sql(command: phrase) := command\nsql select *  from t where it's = 3", "sql(command: phrase) := command\nsql select *  from t where it's = 3")
# so is a word word's word, its call ending at the blank after it
format_check("v(written: word) := written\nv 1.10.0 < v(1.9)", "v(written: word) := written\nv 1.10.0 < v(1.9)")
