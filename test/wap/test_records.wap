# wap's records (wap/kernel/forms.wap Record; wiki/class.md): a class a used module declares, its constructor and fields
# there for the program (the rest is test/test_records.wap; a second module file needs a script)
use "../check.wap"
use "scripted.wap"

written("points", "class Point { x: int; y: int }")
check("a used module's class", ran("module_class", "use \"points.wap\"\np = Point(4, 5)\np.y"), "5")
# a class is told apart by its tag, its name's, never by its shape alone: two classes of one shape stay two
check("an any holding a class of another's shape shows its own class", ran("same_shape", "class P { x: int }\nshown(x: any): text := show(x)\nclass Box { n: int }\nprint(shown(Box(3)))"), "Box{n: 3}")
# a program whose first record holds a list of itself: the record's type and its list are one recursion group
check("a first record holding a list of itself", ran("first_tree", "class Tree { n: int; kids: list<Tree> }\nt = Tree(1, [Tree(2, [])])\n#t.kids"), "1")
# a field given only its default has the default's type (wiki/class.md; OK warp-interviewer 2026-11-21 field-default-type)
check("a field given only its default", ran("field_default", "class Counter { at = 0 }\nc = Counter()\nc.at += 2\nc.at + 1"), "3")
