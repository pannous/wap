# what wiki/subtype.md shows wap saying of a subtype, which a program cannot check of itself: its condition as written
use "../check.wap"
use "scripted.wap"

check("a value a parameter's condition refuses is refused naming the condition as written", lines_with(ran("refused_bracketed", "f(x: int where (it > 0)): int := x\nprint f(0 - 2)"), "refused by condition: (it > 0)"), 1)
check("a subtype's type reads as written, its brackets whole", lines_with(ran("subtype_listed", "h(x: int where it in [1, 2]): text := x"), "this gives int where it in [1, 2],"), 1)
check("a subtype's type reads as written, its texts whole", lines_with(ran("subtype_quoted", "k(x: text where it != \"a)b\"): int := x"), "this gives text where it != \"a)b\","), 1)
check("a subtype's type reads as written, no bracket added", lines_with(ran("subtype_plain", "f(x: int where it > 0): text := x"), "this gives int where it > 0,"), 1)

check("a signature names a subtype by its alias", lines_with(ran("alias_signature", "type positive = int where it > 0\ngrown(a: positive): int := a + 1\nprint grown(\"a\")"), "grown(a: positive)"), 1)
check("nat's words name nat in their signatures", lines_with(ran("nat_signature", "print successor(\"a\")"), "successor(k: nat)"), 1)
check("a type's condition reads the names where the type is declared, never a parameter's at its use", lines_with(ran("condition_scope", "LIMIT = 100\ntype Big = int where it > LIMIT\nf(LIMIT: int, x: Big): int := x\nprint f(1000, 500)"), "500"), 1)
check("a value a subtype's name refuses is refused naming the condition", lines_with(ran("made_refused", "k = 0 - 1\nprint nat(k)"), "refused by condition"), 1)
