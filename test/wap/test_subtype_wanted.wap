# the refusals wiki/subtype.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "../check.wap"
use "scripted.wap"

check("a value that does not meet the condition is refused", from_mark(ran("not_char", "d: char = \"ab\""), "refused"), "refused: \"ab\" is no char, #\"ab\" == 1 does not hold")
check("a literal argument that breaks a parameter's condition is refused", from_mark(ran("empty_initial", "initial(name: text where #it > 0): char := name#1\ninitial(\"\")"), "refused"), "refused: #\"\" > 0 does not hold")
check("a failed run-time check names the condition", from_mark(ran("as_char", "line = \"ab\"\nf = line as char\nprint f"), "\"ab\""), "\"ab\" is no char: #\"ab\" == 1 does not hold")
