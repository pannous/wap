# the refusals wiki/subtype.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "../check.wap"
use "scripted.wap"

check("a value that does not meet the condition is refused", refused_by(ran("not_char", "d: char = \"ab\"")), "refused by condition")
check("a literal argument that breaks a parameter's condition is refused", refused_by(ran("empty_initial", "initial(name: text where #it > 0): char := name#1\ninitial(\"\")")), "refused by condition")
check("a failed run-time check names the condition", lines_with(ran("as_char", "line = \"ab\"\nf = line as char\nprint f"), "#\"ab\" == 1"), 1)
