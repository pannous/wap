# the refusals wiki/subtype.md and wiki/type.md "Proved or checked" show that wap does not build yet: each red line is a to-do, fixed by building the form
use "../check.wap"
use "scripted.wap"

check("a value that does not meet the condition is refused", refused_by(ran("not_char", "d: char = \"ab\"")), "refused by condition")
check("a literal argument that breaks a parameter's condition is refused", refused_by(ran("empty_initial", "initial(name: text where #it > 0): char := name#1\ninitial(\"\")")), "refused by condition")
check("a failed run-time check names the condition", lines_with(ran("as_char", "line = \"ab\"\nf = line as char\nprint f"), "#\"ab\" == 1"), 1)

# a refusal of the whole program: the run before it never happens, so the print before the call stays unsaid
refused_run = ran("refused_before_print", "f(x: int where it > 0): int := x\nprint \"a\"\nprint f(0 - 2)")
check("a call whose computed argument breaks the condition is refused", refused_by(refused_run), "refused by condition")
check("a refused program prints nothing before the refusal", #refused_run.split("\n").filter(line => line == "a"), 0)
check("a sized list of the wrong length in a case is refused", refused_by(ran("short_node", "enum Tree2 { leaf, node(children: vector(Tree2, 2)) }\nnode([leaf])")), "refused by condition")
check("a type holds a sized list of itself", ran("sized_tree", "enum Tree2 { leaf, node(children: vector(Tree2, 2)) }\nprint \"${node([leaf, leaf]) is Tree2}\""), "true")
