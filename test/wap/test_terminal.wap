# lib/terminal.wap: clear_screen() writes ANSI's erase-display and cursor-home, so a frame redraws in place (the snake
# sample)
use "../check.wap"
use "scripted.wap"

escape = text(char(27))
check("clear_screen erases the terminal and homes the cursor", ran("clear_line", "use terminal\nclear_screen()\nprint(\"frame\")"), escape + "[2J" + escape + "[H\nframe")
