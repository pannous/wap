# programs with universes through `wap verify`'s door (wap/extensions/verify/verify.wap): each declares what it
# names and writes every argument, and the door says the type each `type of` asks for, or its first refusal.
# Source: wiki/universe.md
use "../check.wap"
use "scripted.wap"

identity := "identity(T: Sort(u), a: T): T := a\naxiom int: Type\naxiom three: int\n"

check("Prop is a Type", said_of("prop", "type of Prop"), "Type")
check("Type is a Type(1)", said_of("type", "type of Type"), "Type(1)")
check("a statement about all propositions is a proposition", said_of("all_props", "type of ((A: Prop) -> A)"), "Prop")
check("a function type over every type is a Type(1)", said_of("all_types", "type of ((A: Type) -> A)"), "Type(1)")
check("a function type between data is a Type", said_of("data_arrow", "type of ((n: int) -> text)"), "Type")
check("a universe never holds itself", refused_by(said_of("type_in_type", "bad: Type := Type")), "refused by value type")
check("levels do not include each other", refused_by(said_of("box_int", "box(T: Type(1)): Type(1) := T\naxiom int: Type\ntype of box(int)")), "refused by argument type")
check("one definition at two levels: a value", said_of("identity_value", identity + "type of identity[1](int, three)"), "int")
check("one definition at two levels: a type", said_of("identity_type", identity + "type of identity[2](Type, int)"), "Type")
check("a level parameter's type shown at a level", said_of("identity_shown", identity + "type of identity[1]"), "(T: Type) -> T -> T")
check("a definition's levels are found where it is used", said_of("identity_bare", identity + "type of identity(int, three)"), "int")
check("a function equals the function applying it", said_of("eta", "axiom f(x: Prop): Prop\naxiom P(g: Prop -> Prop): Prop\naxiom q: P(f)\neta: P((x: Prop) => f(x)) := q"), "")
check("a name is a binder or a declaration", refused_by(said_of("unknown", "type of nowhere")), "refused by unknown name")
check("an enum's case is declared under its type's name", said_of("enum_case", "enum And(a: Prop, b: Prop): Prop { intro(left: a, right: b): And(a, b) }\ntype of And.intro"), "(a: Prop) -> (b: Prop) -> a -> b -> And(a, b)")
check("enums that name each other are one block", said_of("mutual", "enum Even: nat -> Prop { zero: Even(0), next(o: Odd(n)): Even(n + 1) }\nenum Odd: nat -> Prop { next(e: Even(n)): Odd(n + 1) }\ntype of Odd.next"), "(n: nat) -> Even(n) -> Odd(n + 1)")
check("the axioms a law rests on", said_of("axioms", "axiom choice(a: Prop): a\nlaw anything(a: Prop): a := choice(a)\nlaw itself(a: Prop, h: a): a := h\naxioms of anything\naxioms of itself"), "[choice]\n[]\nchoice: Axiom\nanything: Proved, rests on choice\nitself: Proved")
STRUCTURES := "enum Equal(T: Sort(u), a: T): T -> Prop { refl: Equal(T, a, a) }\naxiom int: Type\nenum Couple(A: Type, B: Type): Type { make(first: A, second: B): Couple(A, B) }\nenum Single: Type { star: Single }\nenum bool: Type { no: bool, yes: bool }\n"
check("a structure value equals its fields put back together", said_of("structure_eta", STRUCTURES + "axiom p: Couple(int, int)\nlaw eta: Equal[1](Couple(int, int), Couple.make(int, int, projection(Couple, 1, p), projection(Couple, 2, p)), p) := Equal.refl[1](Couple(int, int), p)"), "")
check("two proofs of one proposition are equal", said_of("proofs", "axiom P: Prop\naxiom h1: P\naxiom h2: P\naxiom Q(x: P): Prop\naxiom q: Q(h1)\nirrelevant: Q(h2) := q"), "")
check("two values of a structure without fields are equal", said_of("unit_eta", STRUCTURES + "axiom u: Single\naxiom v: Single\nlaw unit: Equal[1](Single, u, v) := Equal.refl[1](Single, u)"), "")
check("yes is not no", refused_by(said_of("yes_no", STRUCTURES + "law bad: Equal[1](bool, bool.yes, bool.no) := Equal.refl[1](bool, bool.yes)")), "refused by value type")
check("two proofs of one proposition are equal under binders too", said_of("proofs_under", "irrelevant(P: Prop, Q: P -> Prop, h1: P, h2: P, q: Q(h1)): Q(h2) := q"), "")
PAIRED := STRUCTURES + "axiom a: int\naxiom b: int\naxiom p: Couple(int, int)\n"
check("a field of a made structure value is the field it was made with", said_of("projected", PAIRED + "law first: Equal[1](int, projection(Couple, 1, Couple.make(int, int, a, b)), a) := Equal.refl[1](int, a)"), "")
check("a field of a definition is the field of its value", said_of("projected_definition", PAIRED + "made: Couple(int, int) := Couple.make(int, int, a, b)\nlaw second: Equal[1](int, projection(Couple, 2, made), b) := Equal.refl[1](int, b)"), "")
check("a recursor on a structure value computes through its fields", said_of("recursed", PAIRED + "law first: Equal[1](int, Couple.recursor[1](int, int, (q: Couple(int, int)) => int, (x: int) => (y: int) => x, p), projection(Couple, 1, p)) := Equal.refl[1](int, projection(Couple, 1, p))"), "")
check("a recursor on a value of a type without cases stays as it is", said_of("no_cases", STRUCTURES + "enum False: Prop {}\naxiom h: False\nwrong: int := False.recursor[1]((x: False) => int, h)\nlaw l: Equal[1](int, wrong, False.recursor[1]((x: False) => int, h)) := Equal.refl[1](int, wrong)"), "")
check("a proof is never taken apart into data", refused_by(said_of("proof_kept", "use logic\nwhich(p: A or B): bool := match p { left(a) => yes; right(b) => no }")), "refused by value type")
