# programs with universes through `wap verify`'s door (wap/extensions/verify/verify.wap): each declares what it
# names and writes every argument, and the door says the type each `type of` asks for, or its first refusal.
# Source: wiki/universe.md
use "../check.wap"
use "scripted.wap"

identity := "identity(T: Sort(u), a: T): T := a\naxiom int: Type\naxiom three: int\n"

check("Prop is a Type", said_of("prop", "type of Prop"), "Type")
check("Type is a Type(1)", said_of("type", "type of Type"), "Type(1)")
check("a statement about all propositions is a proposition", said_of("all_props", "type of ((A: Prop) -> A)"), "Prop")
check("a function type over every type is a Type(1)", said_of("all_types", "type of ((A: Type) -> A)"), "Type(1)")
check("a function type between data is a Type", said_of("data_arrow", "axiom int: Type\naxiom text: Type\ntype of ((n: int) -> text)"), "Type")
check("a universe never holds itself", refused_by(said_of("type_in_type", "bad: Type := Type")), "refused by value type")
check("levels do not include each other", refused_by(said_of("box_int", "box(T: Type(1)): Type(1) := T\naxiom int: Type\ntype of box(int)")), "refused by argument type")
check("one definition at two levels: a value", said_of("identity_value", identity + "type of identity[1](int, three)"), "int")
check("one definition at two levels: a type", said_of("identity_type", identity + "type of identity[2](Type, int)"), "Type")
check("a definition's levels are found where it is used", said_of("identity_bare", identity + "type of identity(int, three)"), "int")
check("a name is a binder or a declaration", refused_by(said_of("unknown", "type of nothing")), "refused by unknown name")
check("an enum's case is declared under its type's name", said_of("enum_case", "enum And(a: Prop, b: Prop): Prop { intro(left: a, right: b): And(a, b) }\ntype of And.intro"), "(a: Prop) -> (b: Prop) -> a -> b -> And(a, b)")
check("enums that name each other are one block", said_of("mutual", "enum nat: Type { zero: nat, successor(n: nat): nat }\nenum Even: nat -> Prop { zero: Even(nat.zero), step(n: nat, e: Odd(n)): Even(nat.successor(n)) }\nenum Odd: nat -> Prop { step(n: nat, e: Even(n)): Odd(nat.successor(n)) }\ntype of Odd.step"), "(n: nat) -> Even(n) -> Odd(nat.successor(n))")
check("the axioms a law rests on", said_of("axioms", "axiom choice(a: Prop): a\nlaw anything(a: Prop): a := choice(a)\nlaw itself(a: Prop, h: a): a := h\naxioms of anything\naxioms of itself"), "[choice]\n[]")
STRUCTURES := "enum Equal(T: Sort(u), a: T): T -> Prop { refl: Equal(T, a, a) }\naxiom int: Type\nenum Couple(A: Type, B: Type): Type { make(first: A, second: B): Couple(A, B) }\nenum Single: Type { star: Single }\nenum bool: Type { no: bool, yes: bool }\n"
check("two proofs of one proposition are equal", said_of("proofs", "axiom P: Prop\naxiom h1: P\naxiom h2: P\naxiom Q(x: P): Prop\naxiom q: Q(h1)\nirrelevant: Q(h2) := q"), "")
check("yes is not no", refused_by(said_of("yes_no", STRUCTURES + "law bad: Equal[1](bool, bool.yes, bool.no) := Equal.refl[1](bool, bool.yes)")), "refused by value type")
check("two proofs of one proposition are equal under binders too", said_of("proofs_under", "irrelevant(P: Prop, Q: P -> Prop, h1: P, h2: P, q: Q(h1)): Q(h2) := q"), "")
PAIRED := STRUCTURES + "axiom a: int\naxiom b: int\naxiom p: Couple(int, int)\n"
check("a proof is never taken apart into data", refused_by(said_of("proof_kept", PAIRED + "enum And(a: Prop, b: Prop): Prop { intro(left: a, right: b): And(a, b) }\naxiom P: Prop\naxiom Q: Prop\naxiom h: And(P, Q)\nlaw l: Equal[1](int, And.recursor[1](P, Q, (x: And(P, Q)) => int, (l: P) => (r: Q) => a, h), a) := Equal.refl[1](int, a)")), "refused by value type")
