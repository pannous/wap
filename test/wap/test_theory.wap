# the explicit spellings through the theory's door (wap/extensions/theory/check.wap): each program declares what it
# names and writes every argument, and the door says the type each `type of` asks for, or its first refusal.
# Source: wiki/universe.md, notes/theory.md "The explicit spellings" and "The door", notes/coc-plan.md (K1)
use "../check.wap"
use "scripted.wap"

checker = door_built()
said_of(name: text, program: text): text := door(checker, name, program)
identity := "identity(T: Sort(u), a: T): T := a\naxiom int: Type\naxiom three: int\n"

check("Prop is a Type", said_of("prop", "type of Prop"), "Type")
check("Type is a Type(1)", said_of("type", "type of Type"), "Type(1)")
check("a statement about all propositions is a proposition", said_of("all_props", "type of (A: Prop) -> A"), "Prop")
check("a function type over every type is a Type(1)", said_of("all_types", "type of (A: Type) -> A"), "Type(1)")
check("a function type between data is a Type", said_of("data_arrow", "axiom int: Type\naxiom text: Type\ntype of (n: int) -> text"), "Type")
check("a universe never holds itself", refused_by(said_of("type_in_type", "bad: Type := Type")), "refused by value type")
check("levels do not include each other", refused_by(said_of("box_int", "box(T: Type(1)): Type(1) := T\naxiom int: Type\ntype of box(int)")), "refused by argument type")
check("one definition at two levels: a value", said_of("identity_value", identity + "type of identity[1](int, three)"), "int")
check("one definition at two levels: a type", said_of("identity_type", identity + "type of identity[2](Type, int)"), "Type")
check("a level parameter's type shown at a level", said_of("identity_shown", identity + "type of identity[1]"), "(T: Type) -> T -> T")
check("a definition is used at as many levels as it has", refused_by(said_of("identity_bare", identity + "type of identity(int, three)")), "refused by level count")
check("a function equals the function applying it", said_of("eta", "axiom f(x: Prop): Prop\naxiom P(g: Prop -> Prop): Prop\naxiom q: P(f)\neta: P((x: Prop) => f(x)) := q"), "")
check("a name is a binder or a declaration", refused_by(said_of("unknown", "type of nothing")), "refused by unknown name")
