# Linear arithmetic over the whole numbers through `wap verify`'s door: a law comparing sums of numbers is proved
# from its hypotheses, sums added and compared like a hand calculation.
# Source: wiki/proof.md "By the provers" (the provers find a proof), wiki/laws.md (a law with its hypotheses),
# notes/coc-plan.md P3
use "../check.wap"
use "scripted.wap"

check("a sum regrouped and reordered is Proved", verified("regrouped", "law regrouped(a: nat, b: nat): a + 1 + b == b + a + 1"), "regrouped: Proved")
check("a bound widened by one is Proved", verified("widened", "law widened(a: nat, b: nat, h: a <= b): a <= b + 1"), "widened: Proved")
check("two bounds chained are Proved", verified("chained", "law chained(a: nat, b: nat, c: nat, h: a <= b, k: b <= c): a <= c"), "chained: Proved")
check("a part of a bounded sum is bounded too, Proved", verified("part", "law part(a: nat, b: nat, c: nat, h: a + b <= c): a <= c"), "part: Proved")
check("a bound read from an equation is Proved", verified("from_equation", "law from_equation(c: nat, b: nat, k: nat, h: c == b + (k + 1)): b + 1 <= c"), "from_equation: Proved")
check("an index in its range keeps its predecessor in range, Proved", verified("predecessor", "law predecessor(i: nat, n: nat, h: 1 <= i and i <= n): i - 1 <= n"), "predecessor: Proved")

# The same prover through the elaborator's door: a condition on a value is proved from what is known where it is given
AT_LEAST_ONE := "f(i: nat where 1 <= it): nat := i\n"
check("a name's value is known while the block reads on", refused_by(elaborated("arithmetic_let", AT_LEAST_ONE + "g(n: nat): nat := { m = n + 1; f(m) }\ntype of g")), "")
check("a difference is bounded from a hypothesis", refused_by(elaborated("arithmetic_difference", AT_LEAST_ONE + "g(n: nat, m: nat, h: m + 1 <= n): nat := f(n - m)\ntype of g")), "")
check("a loop's number lies between its bounds", refused_by(elaborated("arithmetic_round", AT_LEAST_ONE + "g(n: nat): nat := { s = 0; for i in 1 to n { s = s + f(i) }; s }\ntype of g")), "")
check("an index proved in range from the loop's bounds leaves no check", refused_by(elaborated("arithmetic_index", "type index(xs: list<T>) = nat where 1 <= it and it <= #xs\nat(xs: list<nat>, i: index(xs)): nat := i\ntotal(xs: list<nat>): nat := { s = 0; for i in 1 to #xs { s = s + at(xs, i) }; s }\ntype of total")), "")
check("a bound no hypothesis gives is not Proved", verified("unbounded", "law unbounded(a: nat, b: nat): a <= b"), "unbounded: FAILED, counterexample a = nat.successor(nat.zero), b = nat.zero")
check("a strict bound is one more: n > 0 gives 1 <= n", refused_by(elaborated("arithmetic_strict", AT_LEAST_ONE + "g(n: nat, h: n > 0): nat := f(n)\ntype of g")), "")
check("a list whose type says it holds an item has an index in range", refused_by(elaborated("arithmetic_subset_count", "type index(xs: list<T>) = nat where 1 <= it and it <= #xs\nat(xs: list<nat>, i: index(xs)): nat := i\nfirst_of(xs: list<nat> where #it > 0): nat := at(xs, 1)\ntype of first_of")), "")
