# Linear arithmetic over the whole numbers through `wap verify`'s door: a law comparing sums of numbers is proved
# from its hypotheses, sums added and compared like a hand calculation.
# Source: wiki/proof.md "By the provers" (the provers find a proof), wiki/laws.md (a law with its hypotheses),
# notes/coc-plan.md P3
use "../check.wap"
use "scripted.wap"

verifier = door_built(VERIFY_DOOR)
verified(name: text, program: text): text := door(verifier, name, program)

check("a sum regrouped and reordered is Proved", verified("regrouped", "law regrouped(a: nat, b: nat): a + 1 + b == b + a + 1"), "regrouped: Proved")
check("a bound widened by one is Proved", verified("widened", "law widened(a: nat, b: nat, h: a <= b): a <= b + 1"), "widened: Proved")
check("two bounds chained are Proved", verified("chained", "law chained(a: nat, b: nat, c: nat, h: a <= b, k: b <= c): a <= c"), "chained: Proved")
check("a part of a bounded sum is bounded too, Proved", verified("part", "law part(a: nat, b: nat, c: nat, h: a + b <= c): a <= c"), "part: Proved")
check("a bound read from an equation is Proved", verified("from_equation", "law from_equation(c: nat, b: nat, k: nat, h: c == b + (k + 1)): b + 1 <= c"), "from_equation: Proved")
check("an index in its range keeps its predecessor in range, Proved", verified("predecessor", "law predecessor(i: nat, n: nat, h: 1 <= i and i <= n): i - 1 <= n"), "predecessor: Proved")
