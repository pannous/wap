# The connectives through `wap verify`'s door: `and`, `or`, `implies` and `not` in laws, a comparison among them the
# proposition that it holds; a law of them is proved by a proof of each part, of one part, or as a function from
# proofs.
# Source: wiki/proposition.md (the table of connectives, `law both`); wiki/polymorphism.md (a variant the arguments fit
# as they are wins over one they fit through a conversion); wiki/laws.md (the short form, its free names its parameters)
use "../check.wap"
use "scripted.wap"

FACT := "fact(n: nat): nat := if n == 0 then 1 else n * fact(n - 1)\n"

check("both of two comparisons hold", verified("both", "law both: 1 < 2 and 2 < 3"), "both: Proved")
check("one of two comparisons holds", verified("either", "law either: 1 < 0 or 2 < 3"), "either: Proved")
check("a proposition implies itself", verified("implied", "law implied(a: nat): a < 3 implies a < 3"), "implied: Proved")
check("a comparison that fails does not hold", verified("neither", "law neither: not (2 < 1)"), "neither: Proved")
check("both of two propositions hold, a proof of each", verified("both_equal", "law both_equal: And(Equal(nat, 1, 1), Equal(nat, 2, 2))"), "both_equal: Proved")
check("one of two propositions holds, a proof of it", verified("one_equal", "law one_equal: Or(Equal(nat, 1, 2), Equal(nat, 2, 2))"), "one_equal: Proved")
check("a law stated with implies applies to a goal it implies", verified("implied_law", "law smaller(a: nat): a < 3 implies a < 4 := assume\nlaw used(a: nat, h: a < 3): a < 4"), "smaller: Assumed\nused: Assumed")
check("a goal stated with not is proved by a law concluding False", verified("no_is_no_yes", "law no_is_no_yes: not Equal(bool, bool.no, bool.yes)"), "no_is_no_yes: Proved")
check("and joins two propositions nothing decides", verified("both_equal_and", "law both_equal_and: Equal(nat, 1, 1) and Equal(nat, 2, 2)"), "both_equal_and: Proved")
check("or joins two propositions nothing decides", verified("one_equal_or", "law one_equal_or: Equal(nat, 1, 2) or Equal(nat, 2, 2)"), "one_equal_or: Proved")
check("not of a bool is a bool", elaborated("not_bool", "type of not bool.yes"), "bool")
check("not of a proposition is a proposition", elaborated("not_prop", "type of not Equal(nat, 1, 2)"), "Prop")
check("an overload taking the value's own type wins over one reached through a conversion", elaborated("direct_fit", "f(b: bool): bool := b\nf(p: Prop): nat := 0\ntype of f(bool.yes)"), "bool")
check("a choice by a comparison is a choice of data", elaborated("data_by_comparison", "f(x: nat): bool := if x == 2 then yes else no\ntype of f"), "nat -> bool")
check("the page's square law, its x a whole number, is Proved", verified("square_page", "square(x) := x*x\nlaw square(-x) == square(x)"), "square: Proved")
