# The connectives through `wap verify`'s door: `and`, `or`, `implies` and `not` write propositions, a comparison
# among them the proposition that it holds; a law of them is proved by a proof of each part, of one part, or as a
# function from proofs.
# Source: wiki/proposition.md (the table of connectives, `law both`), wiki/laws.md:36 (the helper law of `fact(n) > 0`)
use "../check.wap"
use "scripted.wap"

verifier = door_built(VERIFY_DOOR)
verified(name: text, program: text): text := door(verifier, name, program)
FACT := "fact(n: nat): nat := if n == 0 then 1 else n * fact(n - 1)\n"

check("both of two comparisons hold", verified("both", "law both: 1 < 2 and 2 < 3"), "both: Proved")
check("one of two comparisons holds", verified("either", "law either: 1 < 0 or 2 < 3"), "either: Proved")
check("a proposition implies itself", verified("implied", "law implied(a: nat): a < 3 implies a < 3"), "implied: Proved")
check("a comparison that fails does not hold", verified("neither", "law neither: not (2 < 1)"), "neither: Proved")
check("fact(n) > 0 is proved with its helper law written with and and implies, assumed here", verified("fact_helper", FACT + "law positive_product(x: nat, y: nat): x > 0 and y > 0 implies x * y > 0 := assume\nlaw fact_positive(n: nat): fact(n) > 0"), "positive_product: Assumed\nfact_positive: Assumed")
