# the verdicts of connective laws wiki/laws.md shows that the theory's provers do not reach yet: each red line is a
# to-do, fixed by building the prover (whole-number arithmetic, notes/coc-plan.md P3) or the form.
# Source: wiki/laws.md:36-42 ("with a helper law first, both are Proved"), wiki/proposition.md (`A and B`: a proof
# of each)
use "../check.wap"
use "scripted.wap"

verifier = door_built(VERIFY_DOOR)
verified(name: text, program: text): text := door(verifier, name, program)
FACT := "fact(n: nat): nat := if n == 0 then 1 else n * fact(n - 1)\n"

check("fact(n) > 0 is Proved with its helper law first, both Proved", verified("fact_helper", FACT + "law positive_product(x: nat, y: nat): x > 0 and y > 0 implies x * y > 0\nlaw fact_positive(n: nat): fact(n) > 0"), "positive_product: Proved\nfact_positive: Proved")
check("and joins two propositions nothing decides", verified("both_equal", "law both_equal: Equal(nat, 1, 1) and Equal(nat, 2, 2)"), "both_equal: Proved")
