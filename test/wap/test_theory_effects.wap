# what a function may do beyond computing its value, through the elaborator's door: `effects of f` says it, `! Pure`
# bounds it, a recursion that may not end is Div and still declared, and a proof must be pure.
# Source: wiki/effects.md, notes/coc-plan.md 3.8 and 9.3 (E5)
use "../check.wap"
use "scripted.wap"

elaborated(name: text, program: text): text := said_of(name, program, ELABORATOR_DOOR)
LOOP := "loop(): False := loop()\n"
AWAY := "away(n: nat): nat := if equals(n, 0) then 1 else away(add(n, 1))\n"

check("a function that only computes is Pure", elaborated("effects_pure", "double(n: nat): nat := n + n\neffects of double"), "Pure")
check("a recursion that may not end is Div", elaborated("effects_div", AWAY + "effects of away"), "Div")
check("a function of False that calls itself is Div, not a proof", elaborated("effects_loop", LOOP + "effects of loop"), "Div")
check("a law whose proof may not end is refused", refused_by(elaborated("effects_law_loops", "law spin: False := spin")), "refused by effect")
check("a proof by a function that may not end is refused", refused_by(elaborated("effects_proof_loops", LOOP + "law oops: False := loop()")), "refused by effect")
check("`! Pure` holds for a function that only computes", elaborated("effects_bound", "g(n: nat): nat := n ! Pure\neffects of g"), "Pure")
check("an effect's word in any case is that effect, with a note", elaborated("effects_case", "g(n: nat): nat := n ! pure\neffects of g"), "got it: pure is Pure\nPure")
check("a word that is no effect is refused", refused_by(elaborated("effects_unknown", "g(n: nat): nat := n ! Bogus")), "refused by effect")
check("an effect bound on a value that is no function is misplaced", refused_by(elaborated("effects_misplaced", "answer := 42 ! Pure")), "refused by effect")
check("a type with effects is a type", elaborated("effects_type", "t := nat ! IO\ntype of t"), "Type")
