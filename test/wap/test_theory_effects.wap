# what a function may do beyond computing its value, through the elaborator's door: `effects of f` says it, `! IO`
# bounds it, a recursion that may not end is Div and still declared, a computation runs where its value is read, and a
# proof must be pure.
# Source: wiki/effects.md, notes/coc-plan.md 3.8 and 9.3 (E5)
use "../check.wap"
use "scripted.wap"

LOOP := "loop(): False := loop()\n"
AWAY := "away(n: nat): nat := if equals(n, 0) then 1 else away(add(n, 1))\n"

check("a function that only computes is Pure", elaborated("effects_pure", "double(n: nat): nat := n + n\neffects of double"), "Pure")
check("a recursion that may not end is Div", elaborated("effects_div", AWAY + "effects of away"), "Div")
check("a function of False that calls itself is Div, not a proof", elaborated("effects_loop", LOOP + "effects of loop"), "Div")
check("a law whose proof may not end is refused", refused_by(elaborated("effects_law_loops", "law spin: False := spin")), "refused by effect")
check("a proof by a function that may not end is refused", refused_by(elaborated("effects_proof_loops", LOOP + "law oops: False := loop()")), "refused by effect")
check("a bound of effects holds for a function that only computes", elaborated("effects_bound", "g(n: nat): nat := n ! IO\neffects of g"), "Pure")
check("an effect's word in any case is that effect, with a note", elaborated("effects_case", "g(n: nat): nat := n ! io\neffects of g"), "got it: io is IO\nPure")
check("a word that is no effect is refused", refused_by(elaborated("effects_unknown", "g(n: nat): nat := n ! Bogus")), "refused by effect")
check("an effect bound on a value that is no function is misplaced", refused_by(elaborated("effects_misplaced", "answer := 42 ! IO")), "refused by effect")
check("a function calling one that may not end may not end too", elaborated("effects_called", AWAY + "h(n: nat): nat := add(away(n), 1)\neffects of h"), "Div")
check("a function adding to what one that may not end gives may not end too", elaborated("effects_called_plus", AWAY + "h(n: nat): nat := away(n) + 1\neffects of h"), "Div")
check("a computation reading a let's name runs inside the let", elaborated("effects_let_inside", AWAY + "k(n: nat): nat := { m = 3; add(m, away(m)) }\neffects of k"), "Div")
check("a loop's round runs the computation in it", elaborated("effects_loop_round", AWAY + "s(n: nat): nat := { total = 0; for i in 1 to n { total = add(total, away(i)) }; total }\neffects of s"), "Div")
check("a law of a function into a computation type named by a definition is never proved", refused_by(elaborated("effects_law_named_type", "T := nat ! IO\nopaque g(n: nat): T := never[1](Effects.set(bool.yes, bool.no, bool.no, bool.no, bool.no, bool.no, bool.no, bool.no), nat)\nlaw l: Equal(T, g(0), g(0)) := Equal.refl(T, g(0))")), "refused by effect")
check("a law of a definition that gives nothing is never proved", refused_by(elaborated("effects_law_nothing", "f(): Unit := Unit.unit\nlaw l: Equal(Unit, f, f) := Equal.refl(Unit, f)")), "refused by effect")
check("a bound refuses a function calling one past it", refused_by(elaborated("effects_bound_called", AWAY + "h(n: nat): nat := add(away(n), 1) ! IO")), "refused by effect")
check("a value given a name runs the computation it is", elaborated("effects_let", AWAY + "k(n: nat): nat := { m = away(n); add(m, m) }\neffects of k"), "Div")
check("a computation in one branch of a choice makes the choice one", elaborated("effects_branch", AWAY + "f(b: bool): nat := if b then away(1) else 0\neffects of f"), "Div")
check("a law of a computation is never proved", refused_by(elaborated("effects_law_proved", AWAY + "law same: Equal(Eff[1](diverging, nat), away(0), away(0)) := Equal.refl(Eff[1](diverging, nat), away(0))")), "refused by effect")
check("a type with effects is a type", elaborated("effects_type", "t := nat ! IO\ntype of t"), "Type")
check("several effects are written with commas", elaborated("effects_several", "t := nat ! IO, FFI\ntype of t"), "Type")
check("a bound of several effects is written with commas", elaborated("effects_several_bound", "say(n: nat): nat := n ! IO, FFI\neffects of say"), "Pure")
check("printing is IO", elaborated("effects_print", "greet(name: text) := print \"Hello \" + name\neffects of greet"), "IO")
