# effects through the elaborator's door as wiki/effects.md writes them: a host operation is IO, and a law of a
# computation is tested by running it
# Source: wiki/effects.md, notes/coc-plan.md 3.8 and 9.3 (E5)
use "../check.wap"
use "scripted.wap"

AWAY := "away(n: nat): nat := if equals(n, 0) then 1 else away(add(n, 1))\n"

check("the other branch runs no computation: it is the computation of its value alone", verified("effects_other_branch", AWAY + "f(b: bool): nat := if b then away(1) else 0\nlaw other: Equal(Eff[1](diverging, nat), f(bool.no), pure[1](diverging, nat, 0))"), "other: Tested")
