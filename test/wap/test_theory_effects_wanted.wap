# effects through the elaborator's door as wiki/effects.md writes them: a function that calls one with effects has
# them too, a host operation is IO, and several effects are written with commas
# Source: wiki/effects.md, notes/coc-plan.md 3.8 and 9.3 (E5)
use "../check.wap"
use "scripted.wap"

elaborated(name: text, program: text): text := said_of(name, program, ELABORATOR_DOOR)
AWAY := "away(n: nat): nat := if equals(n, 0) then 1 else away(add(n, 1))\n"

check("a function calling one that may not end is Div too", elaborated("effects_called", AWAY + "h(n: nat): nat := away(n) + 1\neffects of h"), "Div")
check("`! Pure` refuses a function that calls one that may not end", refused_by(elaborated("effects_bound_called", AWAY + "h(n: nat): nat := away(n) ! Pure")), "refused by effect")
check("printing is IO", elaborated("effects_print", "greet(name: text) := print \"Hello \" + name\neffects of greet"), "IO")
check("several effects are written with commas", elaborated("effects_several", "t := nat ! IO, FFI\ntype of t"), "Type")
check("a bound of several effects is written with commas", elaborated("effects_several_bound", "say(n: nat): nat := n ! IO, FFI\neffects of say"), "Pure")
