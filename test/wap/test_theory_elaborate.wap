# enums, classes, match and recursion through the elaborator's door (wap/extensions/theory/elaborate/door.wap): a
# program as people write it, nothing found spelled out, and the door says the type each `type of` asks for, or its
# first refusal. Source: wiki/enum.md ("The recursor"), wiki/proof.md, notes/elaborate.md "Match and recursion (E2)"
use "../check.wap"
use "scripted.wap"

checker = door_built("wap/extensions/theory/elaborate/door.wap", "elaborate_door")
said_of(name: text, program: text): text := door(checker, name, program)

NAT := "enum nat { zero, successor(n: nat) }\n"
EQUAL := "enum Equal(a: T): T -> Prop { refl: Equal(a, a) }\n"
LIST := "enum list<T> { empty, item(first: T, rest: list<T>) }\n"
EVEN := "enum Even: nat -> Prop { zero: Even(nat.zero), step(e: Even(n)): Even(nat.successor(nat.successor(n))) }\n"
DOUBLE := "double(n: nat): nat := match n { zero => nat.zero; successor(k) => nat.successor(nat.successor(double(k))) }\n"
ADD := "add(n: nat, m: nat): nat := match n { zero => m; successor(k) => nat.successor(add(k, m)) }\n"
ONE := "nat.successor(nat.zero)"
TWO := "nat.successor(${ONE})"

check("an enum is a Type", said_of("enum_type", NAT + "type of nat"), "Type")
check("an enum's parameter is found from its cases", said_of("list_item", NAT + LIST + "type of list.item(nat.zero, list.empty)"), "list(nat)")
check("a proposition's letter is found", said_of("equal_type", NAT + EQUAL + "type of Equal(nat.zero)"), "nat -> Prop")
check("a class is an enum of one case", said_of("class", NAT + "class Point { x: nat; y: nat }\ntype of Point.Point(nat.zero, nat.zero)"), "Point")
check("a match gives the type wanted", said_of("match", NAT + "predecessor(n: nat): nat := match n { zero => nat.zero; successor(k) => k }\ntype of predecessor(nat.zero)"), "nat")
check("a match computes", said_of("match_computes", NAT + EQUAL + "predecessor(n: nat): nat := match n { zero => nat.zero; successor(k) => k }\nr: Equal(predecessor(${ONE}), nat.zero) := Equal.refl"), "")
check("`other` stands for the cases left out", said_of("match_other", NAT + "enum True: Prop { yes }\nenum False: Prop { }\nis_zero(n: nat): Prop := match n { zero => True; other => False }\ntype of is_zero(nat.zero)"), "Prop")
check("a match leaves no case out", refused_by(said_of("match_misses", NAT + "predecessor(n: nat): nat := match n { zero => nat.zero }")), "refused by covering")
check("a match's patterns are cases", refused_by(said_of("match_stray", NAT + "predecessor(n: nat): nat := match n { zero => nat.zero; one => nat.zero; successor(k) => k }")), "refused by pattern")
check("a pattern names each field once", refused_by(said_of("match_fields", NAT + "predecessor(n: nat): nat := match n { zero => nat.zero; successor(k, j) => k }")), "refused by pattern")
check("recursion on a field computes", said_of("double", NAT + EQUAL + DOUBLE + "r: Equal(double(${TWO}), nat.successor(nat.successor(${TWO}))) := Equal.refl"), "")
check("recursion with a parameter that stays", said_of("add", NAT + EQUAL + ADD + "r: Equal(add(${ONE}, ${ONE}), ${TWO}) := Equal.refl"), "")
check("recursion with a parameter that changes", said_of("add_changing", NAT + EQUAL + "add(n: nat, m: nat): nat := match n { zero => m; successor(k) => add(k, nat.successor(m)) }\nr: Equal(add(${TWO}, nat.zero), ${TWO}) := Equal.refl"), "")
check("recursion over a list", said_of("length", NAT + LIST + "length(l: list<T>): nat := match l { empty => nat.zero; item(first, rest) => nat.successor(length(rest)) }\ntype of length(list.item(nat.zero, list.empty))"), "nat")
check("a proof by induction", said_of("double_even", NAT + EVEN + DOUBLE + "law double_even(n: nat): Even(double(n)) := match n { zero => Even.zero; successor(k) => Even.step(double_even(k)) }\ntype of double_even(nat.zero)"), "Even(double(nat.zero))")
check("a call of itself on no field may not end", refused_by(said_of("loops", NAT + "f(n: nat): nat := match n { zero => nat.zero; successor(k) => f(n) }")), "refused by recursion")
check("a recursor called takes its motive from the type wanted", said_of("recursor", NAT + EQUAL + "double(n: nat): nat := nat.recursor(nat.zero, (k, d) => nat.successor(nat.successor(d)), n)\nr: Equal(double(${ONE}), ${TWO}) := Equal.refl"), "")
check("a recursor takes apart its own type", refused_by(said_of("recursor_other", NAT + "enum bool { no, yes }\nf(n: nat): nat := bool.recursor(nat.zero, nat.zero, n)")), "refused by pattern")
