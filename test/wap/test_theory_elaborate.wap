# programs as they are written through the elaborator's door (wap/extensions/theory/elaborate/door.wap): the arguments
# a program leaves out, a one-letter type's and its level, are found from the others, and the door says the type each
# `type of` asks for, or its first refusal.
# Source: wiki/universe.md "identity(a: T): T := a", wiki/type.md (a one-letter name nothing defines), notes/elaborate.md
use "../check.wap"
use "scripted.wap"

elaborator = door_built(ELABORATOR_DOOR)
said_of(name: text, program: text): text := door(elaborator, name, program)
identity := "axiom int: Type\nidentity(a: T): T := a\n"
functions := "axiom int: Type\naxiom zero: int\nf: (x: Type) -> Type := x => x\n"

check("a letter's type is found from the argument", said_of("identity_value", identity + "type of identity(int)"), "Type")
check("and its level too", said_of("identity_type", identity + "type of identity(Type)"), "Type(1)")
check("a letter given nothing to find it from cannot be found", refused_by(said_of("identity_bare", identity + "type of identity")), "refused by cannot find")
check("letters whose types depend on each other are found", said_of("compose", functions + "compose(g: B -> C, h: A -> B): A -> C := a => g(h(a))\ntype of compose(f, f)"), "Type -> Type")
check("a function's binder takes its type from the one wanted", said_of("twice", functions + "twice(h: A -> A, a: A): A := h(h(a))\ntype of twice((x: int) => x, zero)"), "int")
check("an overloaded name is the declaration its arguments fit", said_of("overload", "axiom int: Type\naxiom text: Type\naxiom one: int\naxiom hello: text\nsize(a: int): int := a\nsize(t: text): int := one\ntype of size(hello)\ntype of size(one)"), "int\nint")
check("a name unknown in an overloaded call's argument is refused as unknown, not taken for an argument that fits no declaration", refused_by(said_of("overload_unknown", "axiom int: Type\naxiom text: Type\nsize(a: int): int := a\nsize(t: text): text := t\ntype of size(Z)")), "refused by unknown name")
check("a level name nothing defines is a level parameter", said_of("box", "axiom int: Type\nbox(T: Type(u)): Type(u) := T\ntype of box(int)\ntype of box(Type)"), "Type\nType(1)")
check("a name neither a binder nor a declaration is unknown", refused_by(said_of("unknown", "axiom int: Type\nbad: int := Z")), "refused by unknown name")
check("a value of another type is refused", refused_by(said_of("wrong", "axiom int: Type\nwrong: int := Type")), "refused by value type")
check("a hole nothing answers cannot be found", refused_by(said_of("hole", "axiom int: Type\nhole: Type := _")), "refused by cannot find")

# enums, classes, match and structural recursion. Source: wiki/enum.md "The recursor", wiki/proof.md, notes/elaborate.md
# "Match and recursion (E2)"
NAT := "enum nat { zero, successor(n: nat) }\n"
EQUAL := "enum Equal(a: T): T -> Prop { refl: Equal(a, a) }\n"
LIST := "enum list<T> { empty, item(first: T, rest: list<T>) }\n"
EVEN := "enum Even: nat -> Prop { zero: Even(nat.zero), step(e: Even(n)): Even(nat.successor(nat.successor(n))) }\n"
DOUBLE := "double(n: nat): nat := match n { zero => nat.zero; successor(k) => nat.successor(nat.successor(double(k))) }\n"
ADD := "add(n: nat, m: nat): nat := match n { zero => m; successor(k) => nat.successor(add(k, m)) }\n"
ONE := "nat.successor(nat.zero)"
TWO := "nat.successor(${ONE})"

check("an enum is a Type", said_of("enum_type", NAT + "type of nat"), "Type")
check("an enum's parameter is found from its cases", said_of("list_item", NAT + LIST + "type of list.item(nat.zero, list.empty)"), "list(nat)")
check("a proposition's letter is found", said_of("equal_type", NAT + EQUAL + "type of Equal(nat.zero)"), "nat -> Prop")
check("a class is an enum of one case", said_of("class", NAT + "class Point { x: nat; y: nat }\ntype of Point.Point(nat.zero, nat.zero)"), "Point")
check("a match gives the type wanted", said_of("match", NAT + "predecessor(n: nat): nat := match n { zero => nat.zero; successor(k) => k }\ntype of predecessor(nat.zero)"), "nat")
check("a match computes", said_of("match_computes", NAT + EQUAL + "predecessor(n: nat): nat := match n { zero => nat.zero; successor(k) => k }\nr: Equal(predecessor(${ONE}), nat.zero) := Equal.refl"), "")
check("`other` stands for the cases left out", said_of("match_other", NAT + "enum True: Prop { yes }\nenum False: Prop { }\nis_zero(n: nat): Prop := match n { zero => True; other => False }\ntype of is_zero(nat.zero)"), "Prop")
check("a match leaves no case out", refused_by(said_of("match_misses", NAT + "predecessor(n: nat): nat := match n { zero => nat.zero }")), "refused by covering")
check("a match's patterns are cases", refused_by(said_of("match_stray", NAT + "predecessor(n: nat): nat := match n { zero => nat.zero; one => nat.zero; successor(k) => k }")), "refused by pattern")
check("a pattern names each field once", refused_by(said_of("match_fields", NAT + "predecessor(n: nat): nat := match n { zero => nat.zero; successor(k, j) => k }")), "refused by pattern")
check("recursion on a field computes", said_of("double", NAT + EQUAL + DOUBLE + "r: Equal(double(${TWO}), nat.successor(nat.successor(${TWO}))) := Equal.refl"), "")
check("recursion with a parameter that stays", said_of("add", NAT + EQUAL + ADD + "r: Equal(add(${ONE}, ${ONE}), ${TWO}) := Equal.refl"), "")
check("recursion with a parameter that changes", said_of("add_changing", NAT + EQUAL + "add(n: nat, m: nat): nat := match n { zero => m; successor(k) => add(k, nat.successor(m)) }\nr: Equal(add(${TWO}, nat.zero), ${TWO}) := Equal.refl"), "")
check("recursion over a list", said_of("length", NAT + LIST + "length(l: list<T>): nat := match l { empty => nat.zero; item(first, rest) => nat.successor(length(rest)) }\ntype of length(list.item(nat.zero, list.empty))"), "nat")
check("a proof by induction", said_of("double_even", NAT + EVEN + DOUBLE + "law double_even(n: nat): Even(double(n)) := match n { zero => Even.zero; successor(k) => Even.step(double_even(k)) }\ntype of double_even(nat.zero)"), "Even(double(nat.zero))")
check("a call of itself on no field may not end", refused_by(said_of("loops", NAT + "f(n: nat): nat := match n { zero => nat.zero; successor(k) => f(n) }")), "refused by recursion")
check("a recursor called takes its motive from the type wanted", said_of("recursor", NAT + EQUAL + "double(n: nat): nat := nat.recursor(nat.zero, (k, d) => nat.successor(nat.successor(d)), n)\nr: Equal(double(${ONE}), ${TWO}) := Equal.refl"), "")
check("a recursor takes apart its own type", refused_by(said_of("recursor_other", NAT + "enum bool { no, yes }\nf(n: nat): nat := bool.recursor(nat.zero, nat.zero, n)")), "refused by pattern")
check("a case has one arm", refused_by(said_of("match_twice", NAT + "predecessor(n: nat): nat := match n { zero => nat.zero; zero => nat.zero; successor(k) => k }")), "refused by pattern")
check("a match has one arm for the cases left out", refused_by(said_of("match_other_twice", NAT + "predecessor(n: nat): nat := match n { zero => nat.zero; other => nat.zero; _ => nat.zero }")), "refused by pattern")
check("a parameter that stays meets a result that is a function", said_of("shift", NAT + EQUAL + "shift(n: nat, m: nat): nat -> nat := match n { zero => x => m; successor(k) => x => shift(k, m)(x) }\nr: Equal(shift(${ONE}, ${ONE})(nat.zero), ${ONE}) := Equal.refl"), "")

# recursion on any value below one matched, once the products are bound. Source: wiki/enum.md, notes/elaborate.md
# "Match and recursion (E2)"
PRODUCTS := "enum Pair(A: Sort(u), B: Sort(v)): Sort(max(1, max(u, v))) { intro(first: A, second: B) }\nenum Unit: Sort(u) { unit }\nproducts(Pair, Unit)\n"
THREE := "nat.successor(${TWO})"
FIB := "fib(n: nat): nat := match n { zero => nat.zero; successor(k) => match k { zero => ${ONE}; successor(j) => add(fib(j), fib(k)) } }\n"
check("recursion on a field's field computes", said_of("fib", PRODUCTS + NAT + EQUAL + ADD + FIB + "r: Equal(fib(nat.successor(${THREE})), ${THREE}) := Equal.refl"), "")
check("recursion on a field's field with a parameter that changes", said_of("skip", PRODUCTS + NAT + EQUAL + "h(n: nat, m: nat): nat := match n { zero => m; successor(k) => match k { zero => m; successor(j) => h(j, nat.successor(m)) } }\nr: Equal(h(${THREE}, nat.zero), ${ONE}) := Equal.refl"), "")
check("recursion on a list's rest's rest", said_of("pairs", PRODUCTS + NAT + EQUAL + LIST + "pairs(l: list<T>): nat := match l { empty => nat.zero; item(a, rest) => match rest { empty => nat.zero; item(b, more) => nat.successor(pairs(more)) } }\nr: Equal(pairs(list.item(nat.zero, list.item(nat.zero, list.item(nat.zero, list.empty)))), ${ONE}) := Equal.refl"), "")
check("the products are a pair type and a unit type", refused_by(said_of("products_shape", NAT + "enum Unit: Sort(u) { unit }\nproducts(nat, Unit)")), "refused by products")
check("a call on no value below one matched is refused through the course too", refused_by(said_of("course_loops", PRODUCTS + NAT + "f(n: nat): nat := match n { zero => nat.zero; successor(k) => f(nat.successor(n)) }")), "refused by recursion")
check("a proof by induction with the products bound", said_of("course_even", PRODUCTS + NAT + EVEN + DOUBLE + "law double_even(n: nat): Even(double(n)) := match n { zero => Even.zero; successor(k) => Even.step(double_even(k)) }\ntype of double_even(nat.zero)"), "Even(double(nat.zero))")

# the prelude, loaded before the program, and a program's declaration hiding the prelude's of the same name from there
# on. Source: notes/elaborate.md "The door" and "Names"
SECOND := "add(n: nat, m: nat): nat := m\n"
check("the prelude's functions compute", said_of("prelude_divide", "law divided: Equal(nat, divide(7, 2), 3) := Equal.refl(nat, 3)"), "")
check("a program's declaration hides the prelude's of the same name", said_of("hiding", SECOND + "law second: Equal(nat, add(1, 2), 2) := Equal.refl(nat, 2)"), "")
check("the prelude's declaration stands before the program's", said_of("hiding_after", "law summed: Equal(nat, add(1, 2), 3) := Equal.refl(nat, 3)\n" + SECOND), "")
