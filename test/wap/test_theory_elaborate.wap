# programs as they are written through the elaborator's door (wap/extensions/theory/elaborate/door.wap): the arguments
# a program leaves out, a one-letter type's and its level, are found from the others, and the door says the type each
# `type of` asks for, or its first refusal.
# Source: wiki/universe.md "identity(a: T): T := a", wiki/type.md (a one-letter name nothing defines), notes/elaborate.md
use "../check.wap"
use "scripted.wap"
use "../../wap/extensions/theory/options.wap"

elaborated(name: text, program: text): text := said_of(name, program, ELABORATOR_DOOR)
identity := "axiom int: Type\nidentity(a: T): T := a\n"
functions := "axiom int: Type\naxiom zero: int\nf: (x: Type) -> Type := x => x\n"

check("a letter's type is found from the argument", elaborated("identity_value", identity + "type of identity(int)"), "Type")
check("and its level too", elaborated("identity_type", identity + "type of identity(Type)"), "Type(1)")
check("a letter given nothing to find it from cannot be found", refused_by(elaborated("identity_bare", identity + "type of identity")), "refused by cannot find")
check("letters whose types depend on each other are found", elaborated("compose", functions + "compose(g: B -> C, h: A -> B): A -> C := a => g(h(a))\ntype of compose(f, f)"), "Type -> Type")
check("a function's binder takes its type from the one wanted", elaborated("twice", functions + "twice(h: A -> A, a: A): A := h(h(a))\ntype of twice((x: int) => x, zero)"), "int")
check("an overloaded name is the declaration its arguments fit", elaborated("overload", "axiom int: Type\naxiom text: Type\naxiom one: int\naxiom hello: text\nsize(a: int): int := a\nsize(t: text): int := one\ntype of size(hello)\ntype of size(one)"), "int\nint")
check("a name unknown in an overloaded call's argument is refused as unknown, not taken for an argument that fits no declaration", refused_by(elaborated("overload_unknown", "axiom int: Type\naxiom text: Type\nsize(a: int): int := a\nsize(t: text): text := t\ntype of size(Z)")), "refused by unknown name")
check("a level name nothing defines is a level parameter", elaborated("box", "axiom int: Type\nbox(T: Type(u)): Type(u) := T\ntype of box(int)\ntype of box(Type)"), "Type\nType(1)")
check("a name neither a binder nor a declaration is unknown", refused_by(elaborated("unknown", "axiom int: Type\nbad: int := Z")), "refused by unknown name")
check("a value of another type is refused", refused_by(elaborated("wrong", "axiom int: Type\nwrong: int := Type")), "refused by value type")
check("a hole nothing answers cannot be found", refused_by(elaborated("hole", "axiom int: Type\nhole: Type := _")), "refused by cannot find")

# enums, classes, match and structural recursion. Source: wiki/enum.md "The recursor", wiki/proof.md, notes/elaborate.md
# "Match and recursion (E2)"
NAT := "enum nat { zero, successor(n: nat) }\n"
EQUAL := "enum Equal(a: T): T -> Prop { refl: Equal(a, a) }\n"
LIST := "enum list<T> { empty, item(first: T, rest: list<T>) }\n"
EVEN := "enum Even: nat -> Prop { zero: Even(nat.zero), step(e: Even(n)): Even(nat.successor(nat.successor(n))) }\n"
DOUBLE := "double(n: nat): nat := match n { zero => nat.zero; successor(k) => nat.successor(nat.successor(double(k))) }\n"
ADD := "add(n: nat, m: nat): nat := match n { zero => m; successor(k) => nat.successor(add(k, m)) }\n"
ONE := "nat.successor(nat.zero)"
TWO := "nat.successor(${ONE})"

check("an enum is a Type", elaborated("enum_type", NAT + "type of nat"), "Type")
check("an enum's parameter is found from its cases", elaborated("list_item", NAT + LIST + "type of list.item(nat.zero, list.empty)"), "list(nat)")
check("a proposition's letter is found", elaborated("equal_type", NAT + EQUAL + "type of Equal(nat.zero)"), "nat -> Prop")
check("a class is an enum of one case", elaborated("class", NAT + "class Point { x: nat; y: nat }\ntype of Point.Point(nat.zero, nat.zero)"), "Point")
check("a match gives the type wanted", elaborated("match", NAT + "predecessor(n: nat): nat := match n { zero => nat.zero; successor(k) => k }\ntype of predecessor(nat.zero)"), "nat")
check("a match computes", elaborated("match_computes", NAT + EQUAL + "predecessor(n: nat): nat := match n { zero => nat.zero; successor(k) => k }\nr: Equal(predecessor(${ONE}), nat.zero) := Equal.refl"), "")
check("`other` stands for the cases left out", elaborated("match_other", NAT + "enum True: Prop { yes }\nenum False: Prop { }\nis_zero(n: nat): Prop := match n { zero => True; other => False }\ntype of is_zero(nat.zero)"), "Prop")
check("a match leaves no case out", refused_by(elaborated("match_misses", NAT + "predecessor(n: nat): nat := match n { zero => nat.zero }")), "refused by covering")
check("a match's patterns are cases", refused_by(elaborated("match_stray", NAT + "predecessor(n: nat): nat := match n { zero => nat.zero; one => nat.zero; successor(k) => k }")), "refused by pattern")
check("a pattern names each field once", refused_by(elaborated("match_fields", NAT + "predecessor(n: nat): nat := match n { zero => nat.zero; successor(k, j) => k }")), "refused by pattern")
check("recursion on a field computes", elaborated("double", NAT + EQUAL + DOUBLE + "r: Equal(double(${TWO}), nat.successor(nat.successor(${TWO}))) := Equal.refl"), "")
check("recursion with a parameter that stays", elaborated("add", NAT + EQUAL + ADD + "r: Equal(add(${ONE}, ${ONE}), ${TWO}) := Equal.refl"), "")
check("recursion with a parameter that changes", elaborated("add_changing", NAT + EQUAL + "add(n: nat, m: nat): nat := match n { zero => m; successor(k) => add(k, nat.successor(m)) }\nr: Equal(add(${TWO}, nat.zero), ${TWO}) := Equal.refl"), "")
check("recursion over a list", elaborated("length", NAT + LIST + "length(l: list<T>): nat := match l { empty => nat.zero; item(first, rest) => nat.successor(length(rest)) }\ntype of length(list.item(nat.zero, list.empty))"), "nat")
check("a proof by induction", elaborated("double_even", NAT + EVEN + DOUBLE + "law double_even(n: nat): Even(double(n)) := match n { zero => Even.zero; successor(k) => Even.step(double_even(k)) }\ntype of double_even(nat.zero)"), "Even(double(nat.zero))")
check("a call of itself on no field may not end: Div", elaborated("loops", NAT + "f(n: nat): nat := match n { zero => nat.zero; successor(k) => f(n) }\neffects of f"), "Div")
check("a recursor called takes its motive from the type wanted", elaborated("recursor", NAT + EQUAL + "double(n: nat): nat := nat.recursor(nat.zero, (k, d) => nat.successor(nat.successor(d)), n)\nr: Equal(double(${ONE}), ${TWO}) := Equal.refl"), "")
check("a recursor takes apart its own type", refused_by(elaborated("recursor_other", NAT + "enum bool { no, yes }\nf(n: nat): nat := bool.recursor(nat.zero, nat.zero, n)")), "refused by pattern")
check("a case has one arm", refused_by(elaborated("match_twice", NAT + "predecessor(n: nat): nat := match n { zero => nat.zero; zero => nat.zero; successor(k) => k }")), "refused by pattern")
check("a match has one arm for the cases left out", refused_by(elaborated("match_other_twice", NAT + "predecessor(n: nat): nat := match n { zero => nat.zero; other => nat.zero; _ => nat.zero }")), "refused by pattern")
check("a parameter that stays meets a result that is a function", elaborated("shift", NAT + EQUAL + "shift(n: nat, m: nat): nat -> nat := match n { zero => x => m; successor(k) => x => shift(k, m)(x) }\nr: Equal(shift(${ONE}, ${ONE})(nat.zero), ${ONE}) := Equal.refl"), "")

# traits and their instances. Source: wiki/trait.md "Conforming", notes/elaborate.md "Operators, traits and conditions (E3)"
BOOL := "enum bool { no, yes }\n"
ORDERABLE := "trait Orderable { less(a: T, b: T): bool }\n"
COLOR := "enum color { red, green }\nless(a: color, b: color): bool := match a { red => match b { red => bool.no; green => bool.yes }; green => bool.no }\n"
SORT := "insert(x: T, l: list<T>): list<T> := match l { empty => list.item(x, list.empty); item(first, rest) => match less(x, first) { yes => list.item(x, list.item(first, rest)); no => list.item(first, insert(x, rest)) } }\nsort(l: list<T>): list<T> := match l { empty => list.empty; item(first, rest) => insert(first, sort(rest)) }\n"
SORTING := NAT + EQUAL + LIST + BOOL + ORDERABLE + COLOR + SORT
COLORS := "list.item(color.green, list.item(color.red, list.empty))"
check("a trait's operation at a letter's type is the definition's to be given", elaborated("sort_type", SORTING + "type of sort(${COLORS})"), "list(color)")
check("a type's own definitions are its instance, and sort computes with them", elaborated("sort_computes", SORTING + "r: Equal(sort(${COLORS}), list.item(color.red, list.item(color.green, list.empty))) := Equal.refl"), "")
check("a type without the trait's operation is refused naming the trait", refused_by(elaborated("sort_refused", SORTING + "enum shade { dark }\ntype of sort(list.item(shade.dark, list.empty))")), "refused by trait")

# choices by a condition. Source: notes/elaborate.md "Operators, traits and conditions (E3)"
LOGIC := "enum True: Prop { intro }\nenum False: Prop { }\nNot(a: Prop): Prop := a -> False\nenum Decidable(p: Prop): Type { is_false(h: Not(p)): Decidable(p), is_true(h: p): Decidable(p) }\ntrue_decided: Decidable(True) := Decidable.is_true(True.intro)\n"
CHOOSING := NAT + EQUAL + BOOL + LOGIC
check("a choice by a bool computes", elaborated("if_bool", CHOOSING + "flip(b: bool): bool := if b then bool.no else bool.yes\nr: Equal(flip(bool.yes), bool.no) := Equal.refl"), "")
check("a choice by a proposition matches its decision", elaborated("if_decided", CHOOSING + "pick(n: nat): bool := if True then bool.yes else bool.no\nr: Equal(pick(nat.zero), bool.yes) := Equal.refl"), "")
check("a decision is built from the decisions of its parts", elaborated("if_built", CHOOSING + "axiom not_decided: (p: Prop) -> (d: Decidable(p)) -> Decidable(Not(p))\npick(n: nat): bool := if Not(True) then bool.yes else bool.no\ntype of pick(nat.zero)"), "bool")
check("a choice by a proposition nothing decides is refused", refused_by(elaborated("if_undecidable", CHOOSING + "pick(n: nat): bool := if False then bool.yes else bool.no")), "refused by undecidable condition")

# recursion on any value below one matched, once the products are bound. Source: wiki/enum.md, notes/elaborate.md
# "Match and recursion (E2)"
PRODUCTS := "enum Pair(A: Sort(u), B: Sort(v)): Sort(max(1, max(u, v))) { intro(first: A, second: B) }\nenum Unit: Sort(u) { unit }\nproducts(Pair, Unit)\n"
THREE := "nat.successor(${TWO})"
FIB := "fib(n: nat): nat := match n { zero => nat.zero; successor(k) => match k { zero => ${ONE}; successor(j) => add(fib(j), fib(k)) } }\n"
check("recursion on a field's field computes", elaborated("fib", PRODUCTS + NAT + EQUAL + ADD + FIB + "r: Equal(fib(nat.successor(${THREE})), ${THREE}) := Equal.refl"), "")
check("recursion on a field's field with a parameter that changes", elaborated("skip", PRODUCTS + NAT + EQUAL + "h(n: nat, m: nat): nat := match n { zero => m; successor(k) => match k { zero => m; successor(j) => h(j, nat.successor(m)) } }\nr: Equal(h(${THREE}, nat.zero), ${ONE}) := Equal.refl"), "")
check("recursion on a list's rest's rest", elaborated("pairs", PRODUCTS + NAT + EQUAL + LIST + "pairs(l: list<T>): nat := match l { empty => nat.zero; item(a, rest) => match rest { empty => nat.zero; item(b, more) => nat.successor(pairs(more)) } }\nr: Equal(pairs(list.item(nat.zero, list.item(nat.zero, list.item(nat.zero, list.empty)))), ${ONE}) := Equal.refl"), "")
check("a call on no value below one matched may not end through the course too: Div", elaborated("course_loops", PRODUCTS + NAT + "f(n: nat): nat := match n { zero => nat.zero; successor(k) => f(nat.successor(n)) }\neffects of f"), "Div")
check("a proof by induction with the products bound", elaborated("course_even", PRODUCTS + NAT + EVEN + DOUBLE + "law double_even(n: nat): Even(double(n)) := match n { zero => Even.zero; successor(k) => Even.step(double_even(k)) }\ntype of double_even(nat.zero)"), "Even(double(nat.zero))")
check("a proposition two declarations decide is refused naming both", refusals(elaborated("if_two_decisions", CHOOSING + "again_decided: Decidable(True) := Decidable.is_true(True.intro)\npick(n: nat): bool := if True then bool.yes else bool.no")), ["refused by overload: True is decided by true_decided and again_decided: keep one"])
check("an operation two traits have is refused naming both", refusals(elaborated("two_traits", NAT + EQUAL + LIST + BOOL + ORDERABLE + "trait Ranked { less(a: T, b: T): bool }\n" + COLOR + SORT)), ["refused by trait: less is an operation of Orderable and Ranked: keep one"])
check("an operation two traits have is the declaration of its name that fits", elaborated("two_traits_fit", NAT + EQUAL + LIST + BOOL + ORDERABLE + "trait Ranked { less(a: T, b: T): bool }\n" + COLOR + "type of less(color.red, color.green)"), "bool")
check("a condition is decided by the prelude's Decidable where the program declares none, by its own where it does", elaborated("if_prelude_decided", "pick(n: nat): bool := if True then bool.yes else bool.no\nlaw picked: Equal(bool, pick(0), bool.yes) := Equal.refl(bool, bool.yes)"), "")

# the prelude, loaded before the program, and a program's declaration hiding the prelude's of the same name from there
# on. Source: notes/elaborate.md "The door" and "Names"
SECOND := "add(n: nat, m: nat): nat := m\n"
check("the prelude's functions compute", elaborated("prelude_divide", "law divided: Equal(nat, divide(7, 2), 3) := Equal.refl(nat, 3)"), "")
check("a program's declaration hides the prelude's of the same name", elaborated("hiding", SECOND + "law second: Equal(nat, add(1, 2), 2) := Equal.refl(nat, 2)"), "")
check("the prelude's declaration stands before the program's", elaborated("hiding_after", "law summed: Equal(nat, add(1, 2), 3) := Equal.refl(nat, 3)\n" + SECOND), "")
# a prelude theorem keeps the prelude's name a program has hidden: add_zero speaks of the prelude's add, which adds
check("a prelude theorem keeps the name the program hid", elaborated("hiding_theorem", SECOND + "law kept: Equal(nat, 3, 3) := add_zero(3)"), "")
check("a program's declaration of another result is an overload: the prelude's stands beside it", elaborated("hiding_result", "add(n: nat, m: nat): bool := yes\nlaw summed: Equal(nat, add(1, 2), 3) := Equal.refl(nat, 3)"), "")
check("a numeral in a case's field is read at the type an overload's parameter wants", elaborated("case_numeral", "enum boxed<T> { box(item: T) }\nsize(b: boxed<int>): int := match b { box(item) => item }\ntype of size(boxed.box(4))"), "int")
check("the elaborator's door without the wap tree says how to give it", said([script.wap, doors_built[ELABORATOR_DOOR], written("no_tree", "type of 1")], folder: script.tree).contains(TREE_OPTION), yes)
check("the wap tree may stand after the program", said([script.wap, doors_built[ELABORATOR_DOOR], written("tree_after", "type of divide(7, 2)"), TREE_OPTION, script.tree], folder: script.tree), "nat")
check("a declaration at the levels written after its name", elaborated("levels_written", "law kept: Equal[1](bool, bool.yes, bool.yes) := Equal.refl[1](bool, bool.yes)"), "")
check("two types joined by or are their union, one of the two written either way round", elaborated("union_order", "id(T: Type): Type := T\nlaw one: Equal(Type, id(nat) or bool, bool or nat) := Equal.refl(Type, nat or bool)"), "")
check("a union holds each type once", elaborated("union_once", "law once: Equal(Type, nat or bool or nat, bool or nat) := Equal.refl(Type, nat or bool)"), "")
check("a union of one type is that type", elaborated("union_one", "law one: Equal(Type, nat or nat, nat) := Equal.refl(Type, nat)"), "")
check("a union of types is a type", elaborated("union_type", "type of nat or bool"), "Type")
check("a value is held by the case of its part of the union", elaborated("union_case", "s: nat or bool := 3\nlaw held: Equal(nat or bool, s, Sum.left(nat, bool, 3)) := Equal.refl(nat or bool, s)"), "")
check("a value of no part of a union is refused", refused_by(elaborated("union_none", "s: nat or bool := Type")), "refused by value type")
check("an optional value holds a value of its type", elaborated("optional_present", "x: nat? := 3\nlaw held: Equal(optional(nat), x, present(nat, 3)) := Equal.refl(optional(nat), x)"), "")
check("ø where an optional value is wanted is the value missing", elaborated("optional_missing", "y: nat? := ø\nlaw fallback: Equal(nat, or_else(nat, y, 7), 7) := Equal.refl(nat, 7)"), "")
check("T? and T or ø are one type", elaborated("optional_union", "y: nat? := ø\nm: nat or ø := y\nk: optional(nat) := m"), "")
check("a value of no part of an optional is refused", refused_by(elaborated("optional_none", "y: nat? := bool.yes")), "refused by value type")

# operators: `a + b` the call of `+`, declared by its spelling as wap's types module does, an overload set like any
# other. Source: wiki/operator.md "Infix operators" and "Operator overloading", notes/elaborate.md "Operators, traits
# and conditions (E3)"
check("an operator is the call of its spelling", elaborated("operator_plus", "total := 2 + 3\nlaw five: Equal(nat, total, 5) := Equal.refl(nat, 5)"), "")
check("operators group as the table says", elaborated("operator_groups", "law nine: Equal(nat, 3 * 4 - 3, 9) := Equal.refl(nat, 9)"), "")
check("an equality test is a bool", elaborated("operator_equal", "type of 3 == 4"), "bool")
check("a count is a number", elaborated("operator_count", "type of #list.item(nat, 1, list.empty(nat))"), "nat")
check("a call no declaration of its operator fits is refused", refused_by(elaborated("operator_no_fit", "type of 3 + bool.yes")), "refused by no fitting overload")
check("a call no declaration fits names why each does not, a refusal inside an argument included", elaborated("operator_nested_no_fit", "type of 1 + (2 * bool.yes)").contains("* is none of"), yes)
check("a call given more arguments than its declaration takes is refused", refused_by(elaborated("too_many", "type of divide(7, 2, 1)")), "refused by not a function")

# a call on a union picks, for each value, the declaration that takes it. Source: wiki/type.md "Optional values and unions"
SIZES := "size(n: nat): nat := n\nsize(b: bool): nat := 1\nsize(o: Unit): nat := 0\n"
check("a call on a union of a number takes the number's declaration", elaborated("union_call_number", SIZES + "s: nat or bool := 3\nlaw number: Equal(nat, size(s), 3) := Equal.refl(nat, 3)"), "")
check("a call on a union of a bool takes the bool's declaration", elaborated("union_call_bool", SIZES + "s: nat or bool := bool.yes\nlaw one: Equal(nat, size(s), 1) := Equal.refl(nat, 1)"), "")
check("a call on a union of three parts takes nothing's declaration", elaborated("union_call_nothing", SIZES + "s: nat or bool or ø := ø\nlaw zero: Equal(nat, size(s), 0) := Equal.refl(nat, 0)"), "")
check("a call on a union has the type its declarations give", elaborated("union_call_type", SIZES + "s: nat or bool := 3\ntype of size(s)"), "nat")
check("a match takes apart a list of the prelude, whose type takes a universe", elaborated("prelude_list_match", "first(xs: list(nat)): nat := match xs { empty => 0; item(y, rest) => y }\nlaw two: Equal(nat, first(list.item(nat, 2, list.empty(nat))), 2) := Equal.refl(nat, 2)"), "")
PAIRS := "pair(m: nat, n: nat): nat := 1\npair(m: nat, b: bool): nat := 2\npair(a: bool, n: nat): nat := 3\npair(a: bool, b: bool): nat := 4\n"
check("a call on two unions takes the declaration of both values", elaborated("union_call_two", PAIRS + "s: nat or bool := bool.yes\nt: nat or bool := 5\nlaw three: Equal(nat, pair(s, t), 3) := Equal.refl(nat, 3)"), "")

# `any` holds every value, a list of anys included, and a match takes it apart. Source: wiki/type.md "Lists, maps and
# other types with arguments"
KINDS := "kind(a: any): nat := match a { empty => 0; truth(b) => 1; number(n) => 2; words(t) => 3; items(xs) => 4 }\n"
check("any holds a number", elaborated("any_number", KINDS + "x: any := 3\nlaw two: Equal(nat, kind(x), 2) := Equal.refl(nat, 2)"), "")
check("any holds a text", elaborated("any_text", KINDS + "x: any := \"a\"\nlaw three: Equal(nat, kind(x), 3) := Equal.refl(nat, 3)"), "")
check("any holds a list of anys", elaborated("any_list", KINDS + "x: any := list.item(any, 3, list.empty(any))\nlaw four: Equal(nat, kind(x), 4) := Equal.refl(nat, 4)"), "")
check("any holds nothing", elaborated("any_nothing", KINDS + "x: any := ø\nlaw zero: Equal(nat, kind(x), 0) := Equal.refl(nat, 0)"), "")
# a match takes apart one of two enums that name each other, recurring on fields of its own type. Source:
# wiki/proposition.md "Two such enums may name each other"
check("a match takes apart one of two enums that name each other", elaborated("mutual_match", "enum tree { leaf; node(f: forest) }\nenum forest { none; more(t: tree, rest: forest) }\nlength(f: forest): nat := match f { none => 0; more(t, rest) => length(rest) + 1 }\nlaw two: Equal(nat, length(forest.more(tree.leaf, forest.more(tree.leaf, forest.none))), 2) := Equal.refl(nat, 2)"), "")

# `[a, b]` is the list of its items, made of the list's cases where the program reads. Source: notes/elaborate.md
check("a list literal is the prelude's list of its items", elaborated("list_literal", "law counted: Equal(nat, count(nat, [1, 2, 3]), 3) := Equal.refl(nat, 3)"), "")
check("a list literal is the program's own list where it declares one", elaborated("list_literal_own", NAT + LIST + "type of [nat.zero, nat.zero]"), "list(nat)")
# Source: wiki/optional.md (`T?` is a type wherever a type is written, an argument included)
check("an optional type as a call's last argument", elaborated("optional_argument", "law same: Equal(Type, nat or ø, nat?) := Equal.refl(Type, nat?)"), "")
check("a host's operation giving a type that may be a proposition proves nothing", refused_by(elaborated("hosted_letter", "cheat(n: nat): T := prim anything(n)\nlaw wrong: 1 == 2 := cheat(1)")), "refused by hosted proposition")
check("only the language every program gets names the host's operations: a program's would be believed unproved", refused_by(elaborated("hosted_program", "greeting(t: text): text := prim anything(t)")), "refused by host's operation")
# Source: notes/theory.md "The run trust base" and the decision that a statement the theory refuses is taken back, a
# later word naming it refused with the file it is declared in and why
CENSUS := "scripts/theory-census.wap"
# what is said of a word, up to why the statement declaring it was refused
naming(said: text): text := said.split(", which the theory refused")#1
check("a word of the language every program gets whose statement the theory refused is refused naming its file", naming(elaborated("refused_types_word", "print(π)")), "refused by refused declaration: π is declared in types/numbers.wap")
check("a name declared by a later enum of a refused block is refused by name", matches_of(door(tree_built("theory_census", CENSUS), "refused_block", "enum odd_tree { leaf, node(f: even_tree -> nat) }\nenum even_tree { pair(o: odd_tree) }\ntype of even_tree.pair"), "refused by refused declaration: [a-z_]+").join("\n"), "refused by refused declaration: even_tree")
check("an item of a list is read by its place, the place proved in range from the list's type", elaborated("list_item_read", "first_of(xs: list<nat> where #it > 0): nat := xs#1\nlaw second: Equal(nat, [5, 6]#2, 6) := Equal.refl(nat, 6)"), "")
check("a list's item at a place nothing proves in range is refused", refused_by(elaborated("list_item_unproved", "first_of(xs: list<nat>): nat := xs#1")), "refused by unproved condition")
check("a text's letter is read by its place", elaborated("text_item_read", "law b: Equal(text, \"abc\"#2, \"b\") := Equal.refl(text, \"b\")"), "")
# two modules that each declare the same name, each one's uses meaning its own (notes/coc-t2.md "Acceptance")
sides_library() := written("sides_library", "enum Side { left; right }\nleftmost: Side := Side.left")
check("two modules that each declare the same name are both accepted", elaborated("sides", "use \"${sides_library()}\"\nenum Side { up; down }\ntop: Side := Side.up\ntype of top\ntype of leftmost"), "Side\nSide")
check("a value of a used module's type is no value of the program's type of the same name", refused_by(elaborated("sides_mixed", "use \"${sides_library()}\"\nenum Side { up; down }\nwrong: Side := leftmost")), "refused by value type")
