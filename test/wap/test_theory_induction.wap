# Proof by induction through `wap verify`'s door: a law over a value of an enum is proved along the enum's cases,
# the law at each case proved under the hypotheses that it holds of the case's fields.
# Source: wiki/laws.md:34 ("a recursive function is proved by induction over its own recursion"), wiki/proof.md
# "Left open" (an assumed law counts as proved for the ones after it), notes/coc-plan.md P4
use "../check.wap"
use "scripted.wap"

SUCCESSOR_EQUAL := "law successor_equal(a: nat, b: nat, h: Equal(nat, a, b)): Equal(nat, nat.successor(a), nat.successor(b)) := Equal.recursor(Equal.refl(nat, nat.successor(a)), b, h)\n"
FACT := "fact(n: nat): nat := if n == 0 then 1 else n * fact(n - 1)\n"
POSITIVE_PRODUCT := "law positive_product(x: nat, y: nat, a: x > 0, b: y > 0): x * y > 0 := assume\n"
FACT_POSITIVE := "law fact_positive(n: nat): fact(n) > 0\n"

check("a law over a number is proved by induction, its step by an earlier law and the hypothesis", verified("zero_add", SUCCESSOR_EQUAL + "law zero_add(n: nat): Equal(nat, add(0, n), n)"), "successor_equal: Proved\nzero_add: Proved")
check("fact(n) > 0 is proved along fact's own recursion with its helper law, assumed here", verified("fact_positive", FACT + POSITIVE_PRODUCT + FACT_POSITIVE), "positive_product: Assumed\nfact_positive: Assumed")
check("fact(n) > 0 alone stays Tested", verified("fact_alone", FACT + FACT_POSITIVE), "fact_positive: Tested")
check("twice(x) == 2 * x is proved along x, the sum turned by the laws of adding", verified("twice_doubles", "twice(x: nat): nat := x + x\nlaw twice_doubles(x: nat): twice(x) == 2 * x"), "twice_doubles: Proved")
check("square(-x) == square(x) is proved along the cases of an integer", verified("square_minus", "square(x: int): int := x * x\nlaw square_minus(x: int): square(-x) == square(x)"), "square_minus: Proved")
