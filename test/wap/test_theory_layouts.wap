# How the host runs what the prelude declares, its layouts: the run trust base. Only the prelude says how the host runs
# a declaration, every door refuses a program's own; the run door, which believes the layouts, refuses one of no value
# of its type once the prelude is read.
# Source: notes/theory.md "The run trust base"
use "../check.wap"
use "scripted.wap"
use "../../wap/extensions/theory/options.wap"

elaborator = door_built(ELABORATOR_DOOR)
runner = door_built(RUN_DOOR)
DOUBLE := "double(n: int): int := n + n\n"
# what the run door says of a program, one layout of its prelude's numbers written another way: the run door checks
# the layouts it believes
miswritten_said(name: text, layout: text, written_so: text, program: text): text := {
	folder = staged(name)
	said(["cp", "-R", path_join(script.tree, WAP_IN_TREE) + "/", folder])
	numbers = path_join(folder, "extensions/theory/prelude/numbers.wap")
	prelude = read(numbers)
	if not prelude.contains(layout) { raise "the prelude's numbers write no ${layout}" }
	write(numbers, prelude.replace(layout, written_so))
	said([script.wap, runner, SEED_OPTION, folder, written(name, program)], folder: script.tree)
}
# the rule of its first refusal
miswritten(name: text, layout: text, written_so: text, program: text): text := miswritten_said(name, layout, written_so, program).split(":")#1

check("a program's own runs(…) is refused: only the prelude says how the host runs", refused_by(door(elaborator, "program_runs", DOUBLE + "runs(double, n * 2)")), "refused by layout")
check("a layout of the prelude the host's types refuse is refused", miswritten("add_miswritten", "runs(add, prim i64.add(m, n))", "runs(add, prim i64.eq(m, n))", DOUBLE + "double(2)"), "refused by layout")
check("a type's layout naming no type is refused", miswritten("nat_miswritten", "runs(nat, int)", "runs(nat, 7)", DOUBLE + "double(2)"), "refused by layout")
check("the explicit door refuses a program's own runs(…) too", refused_by(said_of("explicit_runs", "axiom nat: Type\nruns(nat, int)")), "refused by layout")
check("the run door refuses a program's own runs(…)", refused_by(said_of("run_runs", DOUBLE + "runs(double, n * 2)", RUN_DOOR)), "refused by layout")
check("a layout that is a host operation of the widths its declaration runs as runs", outcome("sum_row", said_of("sum_row_terms", DOUBLE + "double(2)", RUN_DOOR)), "4\nexit 0")
check("a layout whose host operation takes another width than its declaration's values is refused, naming the operation", refusals(miswritten_said("sum_wider", "runs(sum, prim i64.add(a, b))", "runs(sum, prim f64.add(a, b))", DOUBLE + "double(2)")).join("\n"), "refused by layout: sum runs as the host's f64.add, which takes operands of other wasm types")
