# How the host runs what the types module declares, its layouts: the run trust base. Only the types module says how
# the host runs a declaration; a program's own is refused. Source: wiki/wasm-representation.md
use "../check.wap"
use "scripted.wap"

elaborator = door_built(VERIFY_DOOR)
DOUBLE := "double(n: int): int := n + n\n"
check("a program's own runs(…) is refused: only the prelude says how the host runs", refused_by(door(elaborator, "program_runs", DOUBLE + "runs(double, n * 2)")), "refused by layout")
check("the explicit door refuses a program's own runs(…) too", refused_by(said_of("explicit_runs", "axiom nat: Type\nruns(nat, int)")), "refused by layout")
