# How the host runs what the prelude declares, its layouts, through the elaborator's door: the run trust base. Only the
# prelude says how the host runs a declaration, and a layout of no value of its type is refused when the prelude is read.
# Source: notes/theory.md "The run trust base"
use "../check.wap"
use "scripted.wap"
use "../../wap/extensions/theory/options.wap"

elaborator = door_built(ELABORATOR_DOOR)
DOUBLE := "double(n: int): int := n + n\n"
# what the elaborator's door says of a program, its prelude's numbers changed so add runs as a truth value
with_add_miswritten(name: text, program: text): text := {
	folder = staged(name)
	said(["cp", "-R", path_join(script.tree, WAP_IN_TREE) + "/", folder])
	numbers = path_join(folder, "extensions/theory/prelude/numbers.wap")
	write(numbers, read(numbers).replace("runs(add, m + n)", "runs(add, m == n)"))
	said([script.wap, elaborator, SEED_OPTION, folder, written(name, program)], folder: script.tree)
}

check("a program's own runs(…) is refused: only the prelude says how the host runs", refused_by(door(elaborator, "program_runs", DOUBLE + "runs(double, n * 2)")), "refused by layout")
check("a layout of the prelude the host's types refuse is refused", with_add_miswritten("add_miswritten", DOUBLE + "double(2)").split(":")#1, "refused by layout")
