# How the host runs what the prelude declares, its layouts, through the elaborator's door: the run trust base. Only the
# prelude says how the host runs a declaration, and a layout of no value of its type is refused when the prelude is read.
# Source: notes/theory.md "The run trust base"
use "../check.wap"
use "scripted.wap"
use "../../wap/extensions/theory/options.wap"

elaborator = door_built(ELABORATOR_DOOR)
runner = door_built(RUN_DOOR)
DOUBLE := "double(n: int): int := n + n\n"
# the first refusal the run door says of a program, one layout of its prelude's numbers written another way: the run
# door checks the layouts it believes
miswritten(name: text, layout: text, written_so: text, program: text): text := {
	folder = staged(name)
	said(["cp", "-R", path_join(script.tree, WAP_IN_TREE) + "/", folder])
	numbers = path_join(folder, "extensions/theory/prelude/numbers.wap")
	write(numbers, read(numbers).replace(layout, written_so))
	said([script.wap, runner, SEED_OPTION, folder, written(name, program)], folder: script.tree).split(":")#1
}

check("a program's own runs(…) is refused: only the prelude says how the host runs", refused_by(door(elaborator, "program_runs", DOUBLE + "runs(double, n * 2)")), "refused by layout")
check("a layout of the prelude the host's types refuse is refused", miswritten("add_miswritten", "runs(add, m + n)", "runs(add, m == n)", DOUBLE + "double(2)"), "refused by layout")
check("a type's layout naming no type is refused", miswritten("nat_miswritten", "runs(nat, int)", "runs(nat, 7)", DOUBLE + "double(2)"), "refused by layout")
check("the explicit door refuses a program's own runs(…) too", refused_by(said_of("explicit_runs", "axiom nat: Type\nruns(nat, int)")), "refused by layout")
