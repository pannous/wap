# conditions lifted out of recursive types through the elaborator's door (wap/extensions/theory/elaborate/door.wap): a
# type may hold a list where a condition holds of itself; its values are the plain values whose every condition holds
# Source: notes/coc-plan.md section 7 "Where two rules of this plan meet" and milestone E8
use "../check.wap"
use "scripted.wap"
use "../../wap/extensions/theory/options.wap"

elaborated(name: text, program: text): text := said_of(name, program, ELABORATOR_DOOR)
VECTOR := "vector(T: Type, n: nat): Type := list<T> where Equal(bool, equals(count(T, it), n), bool.yes)\n"
QUAD := VECTOR + "class Quad { parts: vector(Quad, 4) }\n"

# a refusal's rule and what it says was refused, the value and the type it is no value of
refusal(said: text): text := said.split(": ").take(2).join(": ")

check("a class may hold a sized list of itself: its case takes the plain list", elaborated("quad", QUAD + "type of Quad.Quad"), "list[1](Quad) -> Quad")
# the plain value of a Quad nothing tells more of, one part of a Quad
PART := "convert(_, _, q)"
three_parts := "list.item(_, ${PART}, list.item(_, ${PART}, list.item(_, ${PART}, list.empty(_))))"
check("a value given fewer parts than its condition asks is refused", refused_by(elaborated("quad_three", QUAD + "axiom q: Quad\nthree: Quad := Quad.Quad(${three_parts})")), "refused by condition")

# a condition holds of the values inside a value too, decided as the value is made
TREE := VECTOR + "enum Tree { leaf, node(children: vector(Tree, 2)) }\n"
LEAVES := "list.item(_, Tree.leaf, list.item(_, Tree.leaf, list.empty(_)))"
check("a value whose conditions hold is a value of the type", elaborated("tree_two", TREE + "pair: Tree := Tree.node(${LEAVES})\ntype of pair"), "Tree")
check("a refused value is named with the type the program wrote", refusal(elaborated("tree_one", TREE + "one: Tree := Tree.node(list.item(_, Tree.leaf, list.empty(_)))")), "refused by condition: Tree.node(list.item[1](Tree, Tree.leaf, list.empty[1](Tree))) is no Tree")
SIZED := VECTOR + "class Sized { n: nat; items: vector(Sized, n) }\n"
check("a condition may name an earlier field", elaborated("sized_none", SIZED + "nothing_inside: Sized := Sized.Sized(0, list.empty(_))\ntype of nothing_inside"), "Sized")
check("a value breaking a condition that names an earlier field is refused", refusal(elaborated("sized_one", SIZED + "bad: Sized := Sized.Sized(1, list.empty(_))")), "refused by condition: Sized.Sized(1, list.empty[1](Sized)) is no Sized")
MUTUAL := VECTOR + "enum Odd { one, after(e: Even) }\nenum Even { zero, pair(kids: vector(Odd, 2)) }\n"
check("enums that name each other lift their conditions together", elaborated("twins", MUTUAL + "twins: Even := Even.pair(list.item(_, Odd.one, list.item(_, Odd.one, list.empty(_))))\ntype of twins"), "Even")
check("a value of one of them breaking its condition is refused", refusal(elaborated("lone", MUTUAL + "lone: Even := Even.pair(list.item(_, Odd.one, list.empty(_)))")), "refused by condition: Even.pair(list.item[1](Odd, Odd.one, list.empty[1](Odd))) is no Even")
check("a type with parameters lifts its conditions", elaborated("rose", VECTOR + "enum Rose(T: Type) { bud(label: T), twin(label: T, kids: vector(Rose(T), 2)) }\nbuds: Rose(nat) := Rose.twin(1, list.item(_, Rose.bud(2), list.item(_, Rose.bud(3), list.empty(_))))\ntype of buds"), "Rose(nat)")
