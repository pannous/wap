# conditions lifted out of recursive types through the elaborator's door (wap/extensions/theory/elaborate/door.wap): a
# type may hold a list where a condition holds of itself; its values are the plain values whose every condition holds
# Source: notes/coc-plan.md section 7 "Where two rules of this plan meet" and milestone E8
use "../check.wap"
use "scripted.wap"
use "../../wap/extensions/theory/options.wap"

elaborated(name: text, program: text): text := said_of(name, program, ELABORATOR_DOOR)
VECTOR := "vector(T: Type, n: nat): Type := list<T> where Equal(bool, equals(count(T, it), n), bool.yes)\n"
QUAD := VECTOR + "class Quad { parts: vector(Quad, 4) }\n"

check("a class may hold a sized list of itself", elaborated("quad", QUAD + "type of Quad"), "Type")
QUARTER := "convert(_, _, q)"
three_parts := "list.item(_, ${QUARTER}, list.item(_, ${QUARTER}, list.item(_, ${QUARTER}, list.empty(_))))"
check("a value given fewer parts than its condition asks is refused", refused_by(elaborated("quad_three", QUAD + "axiom q: Quad\nthree: Quad := Quad.Quad(${three_parts})")), "refused by condition")

# a condition holds of the values inside a value too, decided as the value is made
TREE := VECTOR + "enum Tree { leaf, node(children: vector(Tree, 2)) }\n"
LEAVES := "list.item(_, Tree.leaf, list.item(_, Tree.leaf, list.empty(_)))"
check("a value whose conditions hold is a value of the type", elaborated("tree_two", TREE + "pair: Tree := Tree.node(${LEAVES})\ntype of pair"), "Tree")
check("a refused value is named with the type the program wrote", elaborated("tree_one", TREE + "one: Tree := Tree.node(list.item(_, Tree.leaf, list.empty(_)))").split(": ")#2, "Tree.node(list.item[1](Tree, Tree.leaf, list.empty[1](Tree))) is no Tree")
check("a condition may name an earlier field", refused_by(elaborated("sized", VECTOR + "class Sized { n: nat; items: vector(Sized, n) }\nnone: Sized := Sized.Sized(0, list.empty(_))\nbad: Sized := Sized.Sized(1, list.empty(_))")), "refused by condition")
check("enums that name each other lift their conditions together", refused_by(elaborated("mutual", VECTOR + "enum Odd { one, after(e: Even) }\nenum Even { zero, pair(kids: vector(Odd, 2)) }\ntwins: Even := Even.pair(list.item(_, Odd.one, list.item(_, Odd.one, list.empty(_))))\nlone: Even := Even.pair(list.item(_, Odd.one, list.empty(_)))")), "refused by condition")
check("a type with parameters lifts its conditions", elaborated("rose", VECTOR + "enum Rose(T: Type) { bud(label: T), twin(label: T, kids: vector(Rose(T), 2)) }\nbuds: Rose(nat) := Rose.twin(1, list.item(_, Rose.bud(2), list.item(_, Rose.bud(3), list.empty(_))))\ntype of buds"), "Rose(nat)")
