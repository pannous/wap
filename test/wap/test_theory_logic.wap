# the forms of the logic of the types module through `wap verify`, as the plan's
# track L writes it: False, True, And, Or, Not, Equal, Exists, bool, Decidable, and laws proved by their recursors.
# Source: notes/coc-plan.md 3.5 and 7, notes/theory.md "The door", wiki/proposition.md.
use "../check.wap"
use "scripted.wap"

# the logic's own words come with `use logic` (lib/logic.wap)
logic = "use logic\n"

check("And.intro takes both proofs", said_of("and_intro", logic + "type of And.intro"), "(a: Prop) -> (b: Prop) -> a -> b -> And(a, b)")
check("Not is a function to False", said_of("not_type", logic + "type of Not(True)"), "Prop")
check("a law's statement is its type", said_of("swap_type", logic + "type of and_swap"), "(a: Prop) -> (b: Prop) -> And(a, b) -> And(b, a)")
check("Equal at a level", said_of("equal_type", logic + "type of Equal[1](bool, bool.yes, bool.no)"), "Prop")
check("Decidable is data", said_of("decidable_type", logic + "type of Decidable(True)"), "Type")
check("a recursor's computing is refl's to prove: a wrong value is refused", refused_by(said_of("wrong_value", logic + "law wrong: Equal[1](bool, negated(bool.no), bool.no) := Equal.refl[1](bool, bool.no)")), "refused by value type")
check("Or eliminates into Prop only: a motive into data is refused", refused_by(said_of("or_to_data", logic + "which(a: Prop, b: Prop, h: Or(a, b)): bool := Or.recursor(a, b, (x: Or(a, b)) => bool, (l: a) => bool.yes, (r: b) => bool.no, h)")), "refused by argument type")
check("Exists eliminates into Prop only: its witness stays inside proofs", refused_by(said_of("exists_to_data", logic + "witness(h: Exists(bool, (x: bool) => True)): bool := Exists.recursor(bool, (x: bool) => True, (e: Exists(bool, (x: bool) => True)) => bool, (w: bool) => (p: True) => w, h)")), "refused by argument type")
check("the axiom is the only door to an unproved statement", refused_by(said_of("no_proof", logic + "law anything(a: Prop): a := proposition_extensionality(a, a, (x: a) => x, (x: a) => x)")), "refused by value type")
