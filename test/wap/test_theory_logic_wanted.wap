# the forms of the logic of the types module (wap/extensions/theory/prelude/logic.wap) through the theory's door, as the plan's
# track L writes it: False, True, And, Or, Not, Equal, Exists, bool, Decidable, and laws proved by their recursors.
# Source: notes/coc-plan.md 3.5 and 7, notes/theory.md "The door", wiki/proposition.md. Red until the door and the
# kernel's inductive types (K2) are built
use "../check.wap"
use "scripted.wap"

logic = file_text(path_join(script.tree, "wap/extensions/theory/prelude/logic.wap")) + "\n"
# what the door says of a program: nothing for one it accepts, the type for each `type of`, else its refusal
door(name: text, program: text): text := said([script.wap, path_join(script.tree, "wap/extensions/theory/check.wap"), written(name, program)], folder: script.tree)

check("the logic is accepted, every law proved by its recursor", door("logic", logic), "")
check("And.intro takes both proofs", door("and_intro", logic + "type of And.intro"), "(a: Prop) -> (b: Prop) -> a -> b -> And(a, b)")
check("Not is a function to False", door("not_type", logic + "type of Not(True)"), "Prop")
check("a law's statement is its type", door("swap_type", logic + "type of and_swap"), "(a: Prop) -> (b: Prop) -> And(a, b) -> And(b, a)")
check("Equal at a level", door("equal_type", logic + "type of Equal[1](bool, bool.yes, bool.no)"), "Prop")
check("Decidable is data", door("decidable_type", logic + "type of Decidable(True)"), "Type")
check("a recursor's computing is refl's to prove: a wrong value is refused", refused_by(door("wrong_value", logic + "law wrong: Equal[1](bool, negated(bool.no), bool.no) := Equal.refl[1](bool, bool.no)")), "refused by value type")
check("Or eliminates into Prop only: a motive into data is refused", refused_by(door("or_to_data", logic + "which(a: Prop, b: Prop, h: Or(a, b)): bool := Or.recursor(a, b, (x: Or(a, b)) => bool, (l: a) => bool.yes, (r: b) => bool.no, h)")), "refused by argument type")
check("Exists eliminates into Prop only: its witness stays inside proofs", refused_by(door("exists_to_data", logic + "witness(h: Exists[1](bool, (x: bool) => True)): bool := Exists.recursor[1](bool, (x: bool) => True, (e: Exists[1](bool, (x: bool) => True)) => bool, (w: bool) => (p: True) => w, h)")), "refused by argument type")
check("the axiom is the only door to an unproved statement", refused_by(door("no_proof", logic + "law anything(a: Prop): a := proposition_extensionality(a, True, (x: a) => True.intro, (t: True) => t)")), "refused by value type")
