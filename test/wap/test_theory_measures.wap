# a recursion that moves a number toward a bound its choice guards ends, through the elaborator's door: the choice
# takes the number apart by the cases its condition waits on, so the call is on a value below the one matched.
# Source: wiki/Footguns.md "Deciding termination and exact behaviour", notes/coc-plan.md 9.3 (E6)
use "../check.wap"
use "scripted.wap"

elaborated(name: text, program: text): text := said_of(name, program, ELABORATOR_DOOR)
numbered = prelude("logic") + prelude("numbers")
FACT := "fact(n: nat): nat := if equals(n, 0) then 1 else multiply(n, fact(subtract(n, 1)))\n"
FIB := "fib(n: nat): nat := if at_most(n, 1) then n else add(fib(subtract(n, 1)), fib(subtract(n, 2)))\n"

check("a recursion moving a number down by one toward its guarded bound computes", elaborated("measures_fact", numbered + FACT + "law r: Equal[1](nat, fact(4), 24) := Equal.refl[1](nat, 24)"), "")
check("a recursion moving a number down by two toward its guarded bound computes", elaborated("measures_fib", numbered + FIB + "law r: Equal[1](nat, fib(10), 55) := Equal.refl[1](nat, 55)"), "")
check("a recursion moving a number away from its guarded bound is refused", refused_by(elaborated("measures_away", numbered + "f(n: nat): nat := if equals(n, 0) then 1 else f(add(n, 1))")), "refused by recursion")
