# a recursion that moves a number toward a bound its choice guards ends, through the elaborator's door: the choice
# takes the number apart by the cases its condition waits on, so the call is on a value below the one matched.
# Source: wiki/Footguns.md "Deciding termination and exact behaviour", notes/coc-plan.md 9.3 (E6); a measure falling,
# the parameters' sizes or one written with `decreasing`: wiki/effects.md "Div"
use "../check.wap"
use "scripted.wap"

FACT := "fact(n: nat): nat := if equals(n, 0) then 1 else multiply(n, fact(subtract(n, 1)))\n"
FIB := "fib(n: nat): nat := if at_most(n, 1) then n else add(fib(subtract(n, 1)), fib(subtract(n, 2)))\n"

check("a recursion moving a number down by one toward its guarded bound computes", elaborated("measures_fact", FACT + "law r: Equal(nat, fact(4), 24) := Equal.refl(nat, 24)"), "")
check("a recursion moving a number down by two toward its guarded bound computes", elaborated("measures_fib", FIB + "law r: Equal(nat, fib(10), 55) := Equal.refl(nat, 55)"), "")
check("a recursion moving a number away from its guarded bound may not end: Div", elaborated("measures_away", "f(n: nat): nat := if equals(n, 0) then 1 else f(add(n, 1))\neffects of f"), "Div")
check("an arm of a recursion's match reads the parameter as the value it took apart", elaborated("measures_arm_parameter", "fact(n: nat): nat := match n { zero => 1; successor(k) => multiply(n, fact(k)) }\nlaw r: Equal(nat, fact(3), 6) := Equal.refl(nat, 6)"), "")
check("a recursion choosing by an operator's comparison toward its bound computes", elaborated("measures_fib_operator", "fib(n: nat): nat := if n <= 1 then n else fib(n - 1) + fib(n - 2)\nlaw r: Equal(nat, fib(7), 13) := Equal.refl(nat, 13)"), "")

BITS := "bits(n: nat): nat := if n == 0 then 0 else 1 + bits(n ÷ 2)\n"
SWAP := "g(a: nat, b: nat): nat := if b == 0 then a else g(b, b ÷ 2)"
check("a recursion whose parameters' sizes fall at each call computes", elaborated("measures_bits", BITS + "law r: Equal(nat, bits(8), 4) := Equal.refl(nat, 4)"), "")
check("a recursion falling in the measure written after its body computes", elaborated("measures_written", SWAP + " decreasing b\nlaw r: Equal(nat, g(1, 8), 1) := Equal.refl(nat, 1)"), "")
check("a recursion whose parameters' sizes may grow, with no measure written, may not end: Div", elaborated("measures_unwritten", SWAP + "\neffects of g"), "Div")
