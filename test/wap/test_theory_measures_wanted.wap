# a recursion falling in a written measure where its body also divides by a parameter its guard keeps nonzero
# Source: wiki/effects.md "Div" (gcd with `decreasing b`)
use "../check.wap"
use "scripted.wap"

GCD := "gcd(a: nat, b: nat): nat := if b == 0 then a else gcd(b, a % b) decreasing b\n"
check("gcd falls in the measure written after its body and computes", elaborated("measures_gcd", GCD + "law r: Equal(nat, gcd(12, 8), 4) := Equal.refl(nat, 4)"), "")
