# recursions that end by a measure, wanted
# Source: wiki/effects.md "Div"
use "../check.wap"
use "scripted.wap"

# through map (notes/coc-t5c-measures.md part 7): wanted until types/lists.wap's map and fold are the kernel's
# (`@kernel(list.map)`, `@kernel(list.fold)`, after a seed refresh carries them)
TREE := "enum Tree { node(children: list<Tree>) }\n"
check("a tree's size through the map of its children ends with no measure written", elaborated("measures_map_match", TREE + "size(t: Tree): int := match t { node(children) => 1 + sum(map(children, size)) }\neffects of size"), "Pure")
check("a tree's size through its children's field ends with no measure written", elaborated("measures_map_field", TREE + "size(t: Tree): int := 1 + sum(map(t.children, size))\neffects of size"), "Pure")
check("a lambda calling the recursion through map computes", elaborated("measures_map_lambda", TREE + "leaves(t: Tree): int := match t { node(children) => if #children == 0 then 1 else sum(map(children, c => leaves(c))) }\nlaw r: Equal(int, leaves(node([node([]), node([])])), 2) := Equal.refl(int, 2)"), "")
# the kernel's list.map and the run's map give the same list: a law computes it by the kernel, the program by its loop
MAPPED := "map([3, 1, 2], x => x * 2)"
check("the kernel's map gives the list the run's map gives", elaborated("map_kernel", "law doubled: Equal(list<int>, ${MAPPED}, [6, 2, 4]) := Equal.refl(list<int>, [6, 2, 4])"), "")
check("the run's map gives the list the kernel's map gives", ran("map_run", "print(${MAPPED})"), "[6, 2, 4]")
