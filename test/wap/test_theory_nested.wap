# an enum may hold itself under another enum, like a tree its list of children: the block is made plain, checked,
# and its recursor takes a motive for the container too, through `wap verify`'s door. Source: wiki/enum.md
use "../check.wap"
use "scripted.wap"

LIST := "enum list<T> { empty, item(first: T, rest: list<T>) }\n"
TREE := "enum Equal(a: T): T -> Prop { refl: Equal(a, a) }\nenum nat { zero, successor(n: nat) }\n" + LIST + "enum Tree { node(children: list<Tree>) }\n"
COUNT := TREE + "count(t: Tree): nat := Tree.recursor[1]((t: Tree) => nat, (l: list<Tree>) => nat, (children: list<Tree>) => (n: nat) => nat.successor(n), nat.zero, (first: Tree) => (rest: list<Tree>) => (m: nat) => (n: nat) => nat.successor(n), t)\nleaf: Tree := Tree.node(list.empty(Tree))\n"
TWO := "nat.successor(nat.successor(nat.zero))"

check("a tree holding a list of trees has a recursor with a motive for the list", said_of("tree", TREE + "type of Tree.recursor[1]"), "(motive_1: Tree -> Type) -> (motive_2: list(Tree) -> Type) -> ((children: list(Tree)) -> motive_2(children) -> motive_1(Tree.node(children))) -> motive_2(list.empty(Tree)) -> ((first: Tree) -> (rest: list(Tree)) -> motive_1(first) -> motive_2(rest) -> motive_2(list.item(Tree, first, rest))) -> (t: Tree) -> motive_1(t)")
check("a nested type takes its parameters first", said_of("rose", LIST + "enum Rose<T> { leaf(value: T), branch(children: list<Rose<T>>) }\ntype of Rose.recursor[1]"), "(T: Type) -> (motive_1: Rose(T) -> Type) -> (motive_2: list(Rose(T)) -> Type) -> ((value: T) -> motive_1(Rose.leaf(T, value))) -> ((children: list(Rose(T))) -> motive_2(children) -> motive_1(Rose.branch(T, children))) -> motive_2(list.empty(Rose(T))) -> ((first: Rose(T)) -> (rest: list(Rose(T))) -> motive_1(first) -> motive_2(rest) -> motive_2(list.item(Rose(T), first, rest))) -> (t: Rose(T)) -> motive_1(t)")
check("the recursor computes through the children: a node with one leaf counts two", said_of("count", COUNT + "law two: Equal[1](nat, count(Tree.node(list.item(Tree, leaf, list.empty(Tree)))), ${TWO}) := Equal.refl[1](nat, ${TWO})"), "")
check("a container that takes its parameter negatively holds no type of the block", refused_by(said_of("negative", "enum Bad<T> { make(f: T -> Prop) }\nenum Loop { wrap(b: Bad<Loop>) }\n")), "refused by strict positivity")
# a type of a block whose own type holds the block, written or added for a container indexed by it, is refused
check("a block nested under a container whose index lies in the block is refused", refused_by(said_of("index_in_block", "enum Vec(T: Type): T -> Type { one(x: T): Vec(T, x) }\nenum Loop { stop, wrap(x: Loop, v: Vec(Loop, x)) }\n")), "refused by enum header")
# a match on a program's enum nested through the types' list (wiki/type.md "Classes and enums") reads as its recursor,
# the list's motive the list itself, so a function over it computes in a proof
check("a match on a tree of a list of trees computes in a proof", verified("nested_match", "enum Tree { leaf(value: int), branch(children: list<Tree>) }\nis_leaf(t: Tree): bool := match t { leaf(value) => yes; branch(children) => no }\ntheorem leaf_is_leaf: is_leaf(Tree.leaf(3)) == yes := refl"), "leaf_is_leaf: Proved")
# a recursion on a tree that also holds a list of trees is its course: it calls itself on the tree's own fields
check("a recursion on a tree nested through a list computes in a proof", verified("nested_course", "enum Tree { leaf(value: int), pair(left: Tree, right: Tree), branch(children: list<Tree>) }\nleaves(t: Tree): int := match t { leaf(value) => 1; pair(left, right) => leaves(left) + leaves(right); branch(children) => 0 }\ntheorem two_leaves: leaves(Tree.pair(Tree.leaf(1), Tree.leaf(2))) == 2 := refl"), "two_leaves: Proved")
