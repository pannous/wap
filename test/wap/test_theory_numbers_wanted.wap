# numbers in the theory (milestone K3) through its door: once the numbers statement names the number type, a number
# literal is a natural number, and a shortcut statement lets arithmetic on two numbers compute at once.
# Source: notes/theory.md "The declarations that bind names", notes/coc-plan.md 6.7. Red until the door reads blocks
use "../check.wap"
use "scripted.wap"

BLOCKS := "enum nat: Type { zero: nat, succ(n: nat): nat }\nenum bool: Type { no: bool, yes: bool }\nenum Equal(T: Sort(u), a: T): T -> Prop { refl: Equal(T, a, a) }\n"
WITH_NUMBERS := BLOCKS + "numbers(nat, bool.yes, Equal)\n"
ADD := WITH_NUMBERS + "add(m: nat, n: nat): nat := nat.recursor[1]((t: nat) => nat, m, (k: nat) => (sum: nat) => nat.succ(sum), n)\n"
ADD_ZERO := "law add_zero(m: nat): Equal[1](nat, add(m, nat.zero), m) := Equal.refl[1](nat, m)\n"
ADD_SUCC := "law add_succ(m: nat, n: nat): Equal[1](nat, add(m, nat.succ(n)), nat.succ(add(m, n))) := Equal.refl[1](nat, nat.succ(add(m, n)))\n"
SHORTCUT_ADD := ADD + ADD_ZERO + ADD_SUCC + "shortcut(add, add, add_zero, add_succ)\n"

check("a number has the number type", said_of("numeral", WITH_NUMBERS + "type of 42"), "nat")
check("a number needs the numbers statement", refused_by(said_of("no_numbers", BLOCKS + "type of 42")), "refused by no numbers")
check("the number type is a block like nat", refused_by(said_of("bool_numbers", BLOCKS + "numbers(bool, bool.yes, Equal)")), "refused by numbers")
check("a number is its successor applied to the number before it", said_of("three", WITH_NUMBERS + "law three: Equal[1](nat, 3, nat.succ(2)) := Equal.refl[1](nat, 3)"), "")
check("a shortcut adds two numbers at once", said_of("add", SHORTCUT_ADD + "law sum: Equal[1](nat, add(2, 1000000000), 1000000002) := Equal.refl[1](nat, 1000000002)"), "")
check("a shortcut takes only the theorems that fix its function", refused_by(said_of("wrong_theorem", ADD + ADD_ZERO + "shortcut(add, add, add_zero, add_zero)")), "refused by shortcut")
check("a theorem may write 0 for the first case", said_of("zero_written", ADD + "law add_zero(m: nat): Equal[1](nat, add(m, 0), m) := Equal.refl[1](nat, m)\n" + ADD_SUCC + "shortcut(add, add, add_zero, add_succ)"), "")
