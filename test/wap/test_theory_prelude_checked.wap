# the prelude's checked types (wap/extensions/theory/prelude/checked.wap) through the theory's door: rationals, i64,
# sets and maps as subsets and quotients of plain carriers, two values the quotient joins equal in a law. Source:
# notes/coc-plan.md 3.6 and "L, the prelude in the theory" (L5), wiki/laws.md
use "../check.wap"
use "scripted.wap"

prelude(name: text): text := file_text(path_join(script.tree, "wap/extensions/theory/prelude/${name}.wap")) + "\n"
checked = ["logic", "numbers", "data", "quotient", "checked"].map(prelude).join("")
# the door built once for the script (scripted.wap), what it says of each program
checker = door_built()
said_of(name: text, program: text): text := door(checker, name, program)
holds(name: text, statement: text, proof: text): text := said_of(name, checked + "law ${name}: ${statement} := ${proof}")
# the value a quotient makes of a value of its carrier, and two such values equal by the axiom quotient_sound
made(level: text, carrier: text, relation: text, value: text): text := "quotient.of[${level}](${carrier}, ${relation}, ${value})"
one_made(name: text, level: text, carrier: text, relation: text, a: text, b: text, why: text): text :=
	holds(name, "Equal[${level}](quotient[${level}](${carrier}, ${relation}), ${made(level, carrier, relation, a)}, ${made(level, carrier, relation, b)})",
		"quotient_sound[${level}](${carrier}, ${relation}, ${a}, ${b}, ${why})")
# a fraction written out: fraction(1, 2) is "fraction.over(1, 2 with its proof)"
fraction(top: int, bottom: int): text := "fraction.over(int.of_nat(${top}), Subset.intro[1](int, nonzero, int.of_nat(${bottom}), Equal.refl[1](bool, bool.no)))"
# a list written out: [3, 4] is items("nat", ["3", "4"])
items(T: text, xs: list<text>): text := xs.reversed.fold("list.empty[1](${T})", (rest, x) => "list.item[1](${T}, ${x}, ${rest})")
# two entries of bool keys, in either order: their keys distinct since no is not yes
ENTRY := "Pair[1, 1](bool, nat)"
entry(key: text, value: text): text := "Pair.intro[1, 1](bool, nat, bool.${key}, ${value})"
only(key: text): text := items("bool", ["bool.${key}"])
distinct_keys(first: text, second: text, apart: text): text := "And.intro(Not(member[1](bool, bool.${first}, ${only(second)})), And(Not(member[1](bool, bool.${second}, list.empty[1](bool))), True), " +
	"(h: member[1](bool, bool.${first}, ${only(second)})) => Or.recursor(Equal[1](bool, bool.${first}, bool.${second}), False, (o: Or(Equal[1](bool, bool.${first}, bool.${second}), False)) => False, ${apart}, (f: False) => f, h), " +
	"And.intro(Not(member[1](bool, bool.${second}, list.empty[1](bool))), True, (f: False) => f, True.intro))"
keyed_map(first: text, first_value: text, second: text, second_value: text, apart: text): text :=
	"Subset.intro[1](entries[1, 1](bool, nat), (xs: entries[1, 1](bool, nat)) => distinct[1](bool, keys[1, 1](bool, nat, xs)), ${items(ENTRY, [entry(first, first_value), entry(second, second_value)])}, ${distinct_keys(first, second, apart)})"

check("rationals, i64, sets and maps are accepted", said_of("checked", checked), "")
check("a rational, a set and a map are data", said_of("types", checked + "type of rational\ntype of set[1](nat)\ntype of map[1, 1](bool, nat)"), "Type\nType\nType")
check("half is two quarters: 1/2 == 2/4", one_made("half_quarters", "1", "fraction", "same_value", fraction(1, 2), fraction(2, 4), "Equal.refl[1](int, int.of_nat(4))"), "")
check("half is not two thirds: refused", refused_by(one_made("half_thirds", "1", "fraction", "same_value", fraction(1, 2), fraction(2, 3), "Equal.refl[1](int, int.of_nat(4))")), "refused by argument type")
check("a bottom of zero is refused", refused_by(said_of("zero_bottom", checked + "nothing: fraction := ${fraction(1, 0)}")), "refused by argument type")
check("a set equal to itself in another order: {1, 2} == {2, 1}", one_made("set_order", "1", "list[1](nat)", "same_members[1](nat)", items("nat", ["1", "2"]), items("nat", ["2", "1"]), "front_swapped_members[1](nat, 1, 2, list.empty[1](nat))"), "")
check("a map equal to itself in another order: {no: 1, yes: 2} == {yes: 2, no: 1}", one_made("map_order", "1", "keyed[1, 1](bool, nat)", "same_entries[1, 1](bool, nat)", keyed_map("no", "1", "yes", "2", "no_is_not_yes"), keyed_map("yes", "2", "no", "1", "yes_is_not_no"),
	"front_swapped_members[1](${ENTRY}, ${entry("no", "1")}, ${entry("yes", "2")}, list.empty[1](${ENTRY}))"), "")
