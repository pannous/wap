# the prelude's checked types past what the kernel computes: its numbers are
# i64 (notes/coc-plan.md 6.7, notes/coc-t2.md), so a law that computes 2^64 waits for the proof extension's big numbers
# (or for storage by context, T8). Source: notes/coc-plan.md "L, the prelude in the theory" (L5)
use "../check.wap"
use "scripted.wap"
use "quotients_made.wap"

SMALLEST := "int.negative_successor(9223372036854775807)"
ABOVE_LARGEST := "sum(int.of_nat(9223372036854775807), int.of_nat(1))"
check("the largest i64 plus one is the smallest", one_made("wrapping", "1", "int", "wrapped_alike", SMALLEST, ABOVE_LARGEST,
	"Exists.intro[1](int, (k: int) => Equal[1](int, sum(${SMALLEST}, minus(${ABOVE_LARGEST})), times(wrap, k)), minus(int.of_nat(1)), Equal.refl[1](int, times(wrap, minus(int.of_nat(1)))))"), "")
