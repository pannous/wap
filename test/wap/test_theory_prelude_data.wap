# the prelude's lists and optional values through `wap verify`, as the
# plan's track L writes them: list and optional with their first functions, each law proved by a recursor, and Pair's
# swap, and texts: a text literal is its code points. Source: notes/coc-plan.md "L, the prelude in the theory" (L3),
# wiki/list.md, wiki/optional.md, wiki/char.md
use "../check.wap"
use "scripted.wap"

# the lists' words are gone with the theory's prelude: these lines go red until wap spells them
data = ""
# a list of numbers written out: [3, 4] is items(["3", "4"])
items(numbers: list<text>): text := numbers.reversed.fold("list.empty[1](nat)", (rest, n) => "list.item[1](nat, ${n}, ${rest})")
lists_equal(left: text, right: text): text := "Equal[1](list[1](nat), ${left}, ${right})"

check("a list is data", said_of("list_type", data + "type of list[1](nat)"), "Type")
check("a list's count computes: #[3, 4] == 2 by refl", holds(data, "count_two", "Equal[1](nat, count[1](nat, ${items(["3", "4"])}), 2)", "Equal.refl[1](nat, 2)"), "")
check("joining computes: [1] + [2] == [1, 2] by refl", holds(data, "joined_two", lists_equal("joined[1](nat, ${items(["1"])}, ${items(["2"])})", items(["1", "2"])), "Equal.refl[1](list[1](nat), ${items(["1", "2"])})"), "")
check("mapping computes: [1, 2] mapped by successor is [2, 3]", holds(data, "mapped_up", lists_equal("mapped[1, 1](nat, nat, nat.successor, ${items(["1", "2"])})", items(["2", "3"])), "Equal.refl[1](list[1](nat), ${items(["2", "3"])})"), "")
check("a present value is what ?? gives", holds(data, "present_three", "Equal[1](nat, or_else[1](nat, present[1](nat, 3), 0), 3)", "Equal.refl[1](nat, 3)"), "")
check("joining a list with itself is no law: refused", refused_by(holds(data, "joined_self", "Equal[1](list[1](nat), joined[1](nat, ${items(["1"])}, ${items(["1"])}), ${items(["1"])})", "Equal.refl[1](list[1](nat), ${items(["1"])})")), "refused by value type")
pair(a: text, b: text): text := "Pair.intro[1, 1](nat, nat, ${a}, ${b})"
check("a pair swapped computes: (1, 2) swapped is (2, 1)", holds(data, "swapped_pair", "Equal[1](Pair[1, 1](nat, nat), swapped[1, 1](nat, nat, ${pair("1", "2")}), ${pair("2", "1")})", "Equal.refl[1](Pair[1, 1](nat, nat), ${pair("2", "1")})"), "")
points_equal(t: text, codes: list<text>): text := lists_equal("points(${t})", items(codes))
check("a text literal is its code points: \"aé\" is [97, 233]", holds(data, "text_points", points_equal("\"aé\"", ["97", "233"]), "Equal.refl[1](list[1](nat), ${items(["97", "233"])})"), "")
check("an empty text has no code points", holds(data, "empty_points", points_equal("\"\"", []), "Equal.refl[1](list[1](nat), ${items([])})"), "")
check("two different texts are not equal: refused", refused_by(holds(data, "a_is_b", "Equal[1](text, \"a\", \"b\")", "Equal.refl[1](text, \"a\")")), "refused by value type")
check("a text literal inside a case's type", said_of("text_in_case", data + "enum Named: Type { named(same: Equal[1](text, \"a\", \"a\")): Named }\n"), "")
check("a long text literal is its code points: #\"hello world\" == 11", holds(data, "long_text", "Equal[1](nat, count[1](nat, points(\"hello world\")), 11)", "Equal.refl[1](nat, 11)"), "")
