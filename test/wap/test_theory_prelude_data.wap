# the prelude's lists and optional values (wap/extensions/theory/prelude/data.wap) through the theory's door, as the
# plan's track L writes them: list and optional with their first functions, each law proved by a recursor, and Pair's
# swap. Source: notes/coc-plan.md "L, the prelude in the theory" (L3), wiki/list.md, wiki/optional.md
use "../check.wap"
use "scripted.wap"

prelude(name: text): text := file_text(path_join(script.tree, "wap/extensions/theory/prelude/${name}.wap")) + "\n"
data = prelude("logic") + prelude("numbers") + prelude("data")
# the door built once for the script (scripted.wap), what it says of each program
checker = door_built()
said_of(name: text, program: text): text := door(checker, name, program)
holds(name: text, statement: text, proof: text): text := said_of(name, data + "law ${name}: ${statement} := ${proof}")
# a list of numbers written out: [3, 4] is items(["3", "4"])
items(numbers: list<text>): text := numbers.reversed.fold("list.empty[1](nat)", (rest, n) => "list.item[1](nat, ${n}, ${rest})")
lists_equal(left: text, right: text): text := "Equal[1](list[1](nat), ${left}, ${right})"

check("lists and optional values are accepted, every law proved by its recursor", said_of("data", data), "")
check("a list is data", said_of("list_type", data + "type of list[1](nat)"), "Type")
check("a list's count computes: #[3, 4] == 2 by refl", holds("count_two", "Equal[1](nat, count[1](nat, ${items(["3", "4"])}), 2)", "Equal.refl[1](nat, 2)"), "")
check("joining computes: [1] + [2] == [1, 2] by refl", holds("joined_two", lists_equal("joined[1](nat, ${items(["1"])}, ${items(["2"])})", items(["1", "2"])), "Equal.refl[1](list[1](nat), ${items(["1", "2"])})"), "")
check("mapping computes: [1, 2] mapped by successor is [2, 3]", holds("mapped_up", lists_equal("mapped[1, 1](nat, nat, nat.successor, ${items(["1", "2"])})", items(["2", "3"])), "Equal.refl[1](list[1](nat), ${items(["2", "3"])})"), "")
check("a present value is what ?? gives", holds("present_three", "Equal[1](nat, or_else[1](nat, optional.present[1](nat, 3), 0), 3)", "Equal.refl[1](nat, 3)"), "")
check("joining a list with itself is no law: refused", refused_by(holds("joined_self", "Equal[1](list[1](nat), joined[1](nat, ${items(["1"])}, ${items(["1"])}), ${items(["1"])})", "Equal.refl[1](list[1](nat), ${items(["1"])})")), "refused by value type")
