# the prelude's effects and computation types through the theory's door:
# a host operation is an opaque constant of a computation type and rests on no axiom, and nothing about what a
# computation gives can be proved. Source: notes/coc-plan.md 9.2 and "L, the prelude in the theory" (L4),
# wiki/effects.md
use "../check.wap"
use "scripted.wap"

# the effects words are gone with the theory's prelude: these lines go red until wap spells them
effects = ""
# a program with a host operation that prints, and a computation that hands a value to it
IO_EFFECTS := "Effects.set(bool.yes, bool.no, bool.no, bool.no, bool.no, bool.no, bool.no, bool.no)"
SAID := "Eff[1](${IO_EFFECTS}, Unit[1])"
hosted = effects + "opaque say(x: bool): ${SAID} := never[1](${IO_EFFECTS}, Unit[1])\n" +
	"greeting: ${SAID} := bind[1, 1](${IO_EFFECTS}, bool, Unit[1], pure[1](${IO_EFFECTS}, bool, bool.yes), (b: bool) => say(b))\n"
PURE_BOOLS := "Eff[1](pure_effects, bool)"

check("a computation type is data", said_of("eff_type", effects + "type of ${PURE_BOOLS}"), "Type")
check("a host operation and a computation using it rest on no axiom", said_of("host_axioms", hosted + "axioms of say\naxioms of greeting"), "[]\n[]")
check("what a computation gives is hidden: pure(yes) is not provably the one that never returns", refused_by(said_of("hidden", effects + "law hidden: Equal[1](${PURE_BOOLS}, pure[1](pure_effects, bool, bool.yes), never[1](pure_effects, bool)) := Equal.refl[1](${PURE_BOOLS}, never[1](pure_effects, bool))")), "refused by value type")
check("a value that did not fail gives itself: (yes or Error) or else no is yes", said_of("recovered", effects + "law recovered: Equal[1](bool, Fallible.recursor[1, 1](bool, (f: Fallible[1](bool)) => bool, (v: bool) => v, (e: Error) => bool.no, Fallible.value[1](bool, bool.yes)), bool.yes) := Equal.refl[1](bool, bool.yes)"), "")
