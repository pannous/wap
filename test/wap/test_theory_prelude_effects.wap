# the prelude's effects and computation types (wap/extensions/theory/prelude/effects.wap) through the theory's door:
# a host operation is an opaque constant of a computation type and rests on no axiom, and nothing about what a
# computation gives can be proved. Source: notes/coc-plan.md 9.2 and "L, the prelude in the theory" (L4),
# wiki/effects.md
use "../check.wap"
use "scripted.wap"

prelude(name: text): text := file_text(path_join(script.tree, "wap/extensions/theory/prelude/${name}.wap")) + "\n"
effects = prelude("logic") + prelude("effects")
# the door built once for the script (scripted.wap), what it says of each program
checker = door_built()
said_of(name: text, program: text): text := door(checker, name, program)
# a program with a host operation that prints, and a computation that hands a value to it
IO_EFFECTS := "Effects.set(bool.yes, bool.no, bool.no, bool.no, bool.no, bool.no, bool.no, bool.no)"
SAID := "Eff[0](${IO_EFFECTS}, Unit[1])"
hosted = effects + "opaque say(x: bool): ${SAID} := never[0](${IO_EFFECTS}, Unit[1])\n" +
	"greeting: ${SAID} := bind[0, 0](${IO_EFFECTS}, bool, Unit[1], pure[0](${IO_EFFECTS}, bool, bool.yes), (b: bool) => say(b))\n"
PURE_BOOLS := "Eff[0](pure_effects, bool)"

check("the effects and computation types are accepted", said_of("effects", effects), "")
check("a computation type is data", said_of("eff_type", effects + "type of ${PURE_BOOLS}"), "Type")
check("a host operation and a computation using it rest on no axiom", said_of("host_axioms", hosted + "axioms of say\naxioms of greeting"), "[]\n[]")
check("what a computation gives is hidden: pure(yes) is not provably the one that never returns", refused_by(said_of("hidden", effects + "law hidden: Equal[1](${PURE_BOOLS}, pure[0](pure_effects, bool, bool.yes), never[0](pure_effects, bool)) := Equal.refl[1](${PURE_BOOLS}, never[0](pure_effects, bool))")), "refused by value type")
