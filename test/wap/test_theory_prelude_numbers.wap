# the prelude's numbers (wap/extensions/theory/prelude/numbers.wap) through the theory's door, as the plan's track L
# writes them: nat with the numbers statement, its arithmetic and comparisons with the theorems that license their
# shortcuts, and int. Source: wiki/number.md, notes/coc-plan.md "L, the prelude in the theory" (L2), notes/theory.md "The declarations
# that bind names"
use "../check.wap"
use "scripted.wap"

numbered = prelude("logic") + prelude("numbers")

check("the numbers are accepted", said_of("numbers", numbered), "")
check("2 + 2 == 4 by refl in the prelude's own nat", holds(numbered, "four", "Equal[1](nat, add(2, 2), 4)", "Equal.refl[1](nat, 4)"), "")
check("a big product computes at once", holds(numbered, "product", "Equal[1](nat, multiply(1000000, 1000000), 1000000000000)", "Equal.refl[1](nat, 1000000000000)"), "")
check("a natural number stops at zero", holds(numbered, "stops", "Equal[1](nat, subtract(3, 7), 0)", "Equal.refl[1](nat, 0)"), "")
check("the comparisons answer with a bool", holds(numbered, "comparison", "Equal[1](bool, at_most(7, 3), equals(5, 6))", "Equal.refl[1](bool, bool.no)"), "")
check("a big quotient and its remainder compute at once", holds(numbered, "quotient", "Equal[1](nat, add(divide(1000000000001, 1000), remainder(1000000000001, 1000)), 1000000001)", "Equal.refl[1](nat, 1000000001)"), "")
check("dividing by zero gives zero and leaves the number as the remainder", holds(numbered, "by_zero", "Equal[1](nat, add(divide(7, 0), remainder(7, 0)), 7)", "Equal.refl[1](nat, 7)"), "")
check("a wrong sum is refused", refused_by(holds(numbered, "five", "Equal[1](nat, add(2, 2), 5)", "Equal.refl[1](nat, 4)")), "refused by value type")
check("a theorem of a shortcut rests on no axiom", said_of("subtract_axioms", numbered + "axioms of subtract_successors"), "[]")
DIVISION_THEOREMS := ["divide_and_remainder", "divide_by_zero", "remainder_below"]
check("division's theorems rest on no axiom", said_of("divide_axioms", numbered + DIVISION_THEOREMS.map(name => "axioms of " + name).join("\n")), DIVISION_THEOREMS.map(name => "[]").join("\n"))
check("an integer sum crosses zero", holds(numbered, "across", "Equal[1](int, sum(minus(int.of_nat(3)), int.of_nat(5)), int.of_nat(2))", "Equal.refl[1](int, int.of_nat(2))"), "")
check("an integer below zero is the negative number before minus it", holds(numbered, "below", "Equal[1](int, sum(int.of_nat(2), minus(int.of_nat(5))), int.negative_successor(2))", "Equal.refl[1](int, int.negative_successor(2))"), "")
check("a number written as zero or a successor computes at once", holds(numbered, "written", "Equal[1](nat, add(nat.zero, nat.successor(4294967296)), 4294967297)", "Equal.refl[1](nat, 4294967297)"), "")
# a shortcut computes on i64 below 2^63 (notes/coc-plan.md 6.7), and past it on a Large, exactly
check("a sum just below 2^63 computes at once", holds(numbered, "largest", "Equal[1](nat, add(9223372036854775806, 1), 9223372036854775807)", "Equal.refl[1](nat, 9223372036854775807)"), "")
# a count past 2^63 is a literal of its own, computed through magnitude's arithmetic
check("a product past 2^63 computes exactly", holds(numbered, "exact_product", "Equal[1](nat, divide(multiply(4294967296, 4294967296), 4294967296), 4294967296)", "Equal.refl[1](nat, 4294967296)"), "")
check("two counts past 2^63 computed alike are equal", holds(numbered, "exact_equal", "Equal[1](nat, multiply(4294967296, 4294967296), multiply(65536, multiply(65536, 4294967296)))", "Equal.refl[1](nat, multiply(4294967296, 4294967296))"), "")
check("the successor of the largest i64 is a count", holds(numbered, "past_largest", "Equal[1](nat, subtract(nat.successor(9223372036854775807), 1), 9223372036854775807)", "Equal.refl[1](nat, 9223372036854775807)"), "")
