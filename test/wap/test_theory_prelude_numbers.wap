# the arithmetic and comparisons of the types module's numbers through `wap verify`'s door: laws that hold by computing.
# Source: wiki/number.md, wiki/proof.md "By computing"
use "../check.wap"
use "scripted.wap"

verified(name: text, program: text): text := said_of(name, program, VERIFY_DOOR)

check("2 + 2 == 4 by computing", verified("four", "law four: 2 + 2 == 4"), "four: Proved")
check("a big product computes at once", verified("product", "law product: 1000000 * 1000000 == 1000000000000"), "product: Proved")
check("the comparisons answer with a bool", verified("comparison", "law comparison: (7 <= 3) == (5 == 6)"), "comparison: Proved")
check("a big quotient and its remainder compute at once", verified("quotient", "law quotient: 1000000000001 ÷ 1000 + 1000000000001 % 1000 == 1000000001"), "quotient: Proved")
check("an integer sum crosses zero", verified("across", "law across: -3 + 5 == 2"), "across: Proved")
check("an integer below zero is the negative number before minus it", verified("below", "law below: 2 - 5 == -3"), "below: Proved")
check("a sum just below 2^63 computes at once", verified("largest", "law largest: 9223372036854775806 + 1 == 9223372036854775807"), "largest: Proved")
check("a wrong sum is reported FAILED", verified("five", "law five: 2 + 2 == 5"), "five: FAILED")
# a row past 2^63 gives no value (kernel/compute.wap row_step, kernel/numbers.wap LARGEST): the product is exact once int's definition computes it
check("a product past 2^63 is exact", verified("big", "law big: 4294967296 * 4294967296 == 18446744073709551616"), "big: Proved")
