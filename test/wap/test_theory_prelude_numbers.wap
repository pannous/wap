# the prelude's numbers (wap/extensions/theory/prelude/numbers.wap) through the theory's door, as the plan's track L
# writes them: nat with the numbers statement, its arithmetic and comparisons with the theorems that license their
# shortcuts, and int. Source: notes/coc-plan.md "L, the prelude in the theory" (L2), notes/theory.md "The declarations
# that bind names"
use "../check.wap"
use "scripted.wap"

prelude(name: text): text := file_text(path_join(script.tree, "wap/extensions/theory/prelude/${name}.wap")) + "\n"
numbered = prelude("logic") + prelude("numbers")
# the door built once for the script (scripted.wap), what it says of each program
checker = door_built()
said_of(name: text, program: text): text := door(checker, name, program)
holds(name: text, statement: text, proof: text): text := said_of(name, numbered + "law ${name}: ${statement} := ${proof}")

check("the numbers are accepted", said_of("numbers", numbered), "")
check("2 + 2 == 4 by refl in the prelude's own nat", holds("four", "Equal[1](nat, add(2, 2), 4)", "Equal.refl[1](nat, 4)"), "")
check("a big product computes at once", holds("product", "Equal[1](nat, multiply(1000000, 1000000), 1000000000000)", "Equal.refl[1](nat, 1000000000000)"), "")
check("a natural number stops at zero", holds("stops", "Equal[1](nat, subtract(3, 7), 0)", "Equal.refl[1](nat, 0)"), "")
check("the comparisons answer with a bool", holds("comparison", "Equal[1](bool, at_most(7, 3), equals(5, 6))", "Equal.refl[1](bool, bool.no)"), "")
check("a big quotient and its remainder compute at once", holds("quotient", "Equal[1](nat, add(divide(1000000000001, 1000), remainder(1000000000001, 1000)), 1000000001)", "Equal.refl[1](nat, 1000000001)"), "")
check("dividing by zero gives zero and leaves the number as the remainder", holds("by_zero", "Equal[1](nat, add(divide(7, 0), remainder(7, 0)), 7)", "Equal.refl[1](nat, 7)"), "")
check("a wrong sum is refused", refused_by(holds("five", "Equal[1](nat, add(2, 2), 5)", "Equal.refl[1](nat, 4)")), "refused by value type")
check("a theorem of a shortcut rests on no axiom", said_of("subtract_axioms", numbered + "axioms of subtract_successors"), "[]")
DIVISION_THEOREMS := ["divide_and_remainder", "divide_by_zero", "remainder_below"]
check("division's theorems rest on no axiom", said_of("divide_axioms", numbered + DIVISION_THEOREMS.map(name => "axioms of " + name).join("\n")), DIVISION_THEOREMS.map(name => "[]").join("\n"))
check("an integer sum crosses zero", holds("across", "Equal[1](int, sum(minus(int.of_nat(3)), int.of_nat(5)), int.of_nat(2))", "Equal.refl[1](int, int.of_nat(2))"), "")
check("an integer below zero is the negative number before minus it", holds("below", "Equal[1](int, sum(int.of_nat(2), minus(int.of_nat(5))), int.negative_successor(2))", "Equal.refl[1](int, int.negative_successor(2))"), "")
