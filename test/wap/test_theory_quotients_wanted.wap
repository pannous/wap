# quotient types through `wap verify`: the statement `quotients(Equal)`, lift computing on a made value, and
# function extensionality proved from the prelude's axiom.
# Source: notes/coc-plan.md 6.4, 6.6 and 13.2, notes/theory.md "The declarations that bind names",
# wiki/proposition.md. Red until the door reads the logic's enums
use "../check.wap"
use "scripted.wap"

# the logic and quotient words are gone with the theory's prelude: these lines go red until wap spells them
logic = ""
quotiented = ""
# bool up to equality, and negated respecting it
SAME := "(a: bool) => (b: bool) => Equal[1](bool, a, b)"
RESPECTS := "(a: bool) => (b: bool) => (h: Equal[1](bool, a, b)) => equal_congruent[1, 1](bool, bool, negated, a, b, h)"

check("induct proves a property of every value from the made ones", said_of("induct_type", quotiented + "type of quotient.induct[1]"), "(T: Type) -> (r: T -> T -> Prop) -> (motive: quotient[1](T, r) -> Prop) -> ((a: T) -> motive(quotient.of[1](T, r, a))) -> (q: quotient[1](T, r)) -> motive(q)")
check("lift on a made value computes: refl proves it", said_of("lift", quotiented + "law lifted: Equal[1](bool, quotient.lift[1, 1](bool, ${SAME}, bool, negated, ${RESPECTS}, quotient.of[1](bool, ${SAME}, bool.no)), bool.yes) := Equal.refl[1](bool, bool.yes)"), "")
check("the quotients are declared once", refused_by(said_of("twice", quotiented + "quotients(Equal)")), "refused by quotients")
check("the quotients are made with equality, never another type", refused_by(said_of("by_bool", logic + "quotients(bool)")), "refused by quotients")
