# every inductive type gets its recursor, and a recursor on a case computes (milestone K2), through the theory's
# door in its explicit spellings. Source: notes/coc-plan.md 7 and 11, notes/theory.md "The explicit spellings",
# wiki/proposition.md. Red until the door is built
use "../check.wap"
use "scripted.wap"

NAT := "enum nat: Type { zero: nat, succ(n: nat): nat }\n"
EQUAL := "enum Equal(T: Sort(u), a: T): T -> Prop { refl: Equal(T, a, a) }\n"
ADD := NAT + EQUAL + "add(m: nat, n: nat): nat := nat.recursor[1]((t: nat) => nat, m, (k: nat) => (sum: nat) => nat.succ(sum), n)\n"
LIST := "enum list(T: Type): Type { empty: list(T), item(first: T, rest: list(T)): list(T) }\n"
VECTOR := NAT + "enum vector(T: Type): nat -> Type { empty: vector(T, nat.zero), push(n: nat, head: T, tail: vector(T, n)): vector(T, nat.succ(n)) }\n"
EVEN_ODD := NAT + "enum Even: nat -> Prop { zero: Even(nat.zero), step(n: nat, h: Odd(n)): Even(nat.succ(n)) }\nenum Odd: nat -> Prop { step(n: nat, h: Even(n)): Odd(nat.succ(n)) }\n"

check("nat is accepted with its recursor", said_of("nat", NAT + "type of nat.recursor[1]"), "(motive: nat -> Type) -> motive(nat.zero) -> ((n: nat) -> motive(n) -> motive(nat.succ(n))) -> (t: nat) -> motive(t)")
check("a recursor on a case computes: two and two make four by refl", said_of("add", ADD + "law four: Equal[1](nat, add(nat.succ(nat.succ(nat.zero)), nat.succ(nat.succ(nat.zero))), nat.succ(nat.succ(nat.succ(nat.succ(nat.zero))))) := Equal.refl[1](nat, nat.succ(nat.succ(nat.succ(nat.succ(nat.zero)))))"), "")
check("list's recursor takes the parameter first", said_of("list", LIST + "type of list.recursor[1]"), "(T: Type) -> (motive: list(T) -> Type) -> motive(list.empty(T)) -> ((first: T) -> (rest: list(T)) -> motive(rest) -> motive(list.item(T, first, rest))) -> (t: list(T)) -> motive(t)")
check("vector is accepted: its recursor takes the index before the value", said_of("vector", VECTOR), "")
check("Even and Odd name each other: one block, each recursor taking both motives", said_of("even_odd", EVEN_ODD), "")
check("False, And, Or and Exists are accepted with their recursors", said_of("logic", "enum False: Prop {}\nenum And(a: Prop, b: Prop): Prop { intro(left: a, right: b): And(a, b) }\nenum Or(a: Prop, b: Prop): Prop { left(h: a): Or(a, b), right(h: b): Or(a, b) }\nenum Exists(T: Sort(u), p: T -> Prop): Prop { intro(w: T, h: p(w)): Exists(T, p) }\n"), "")
check("a proof of Equal computes by K", said_of("k", ADD + "zero_again(h: Equal[1](nat, nat.zero, nat.zero)): nat := Equal.recursor[1, 1](nat, nat.zero, (b: nat) => (e: Equal[1](nat, nat.zero, b)) => nat, nat.zero, nat.zero, h)\nlaw k(h: Equal[1](nat, nat.zero, nat.zero)): Equal[1](nat, zero_again(h), nat.zero) := Equal.refl[1](nat, nat.zero)"), "")
