# Programs run from their erased terms (wap/extensions/theory/run/door.wap): the elaborator reads a program, erase
# keeps what it runs, and the run door writes that as plain wap. Each line runs a program both ways, compiled as it is
# and compiled from its terms, and checks they print the same and end with the same status, and what they print.
# Source: notes/coc-plan.md S2 "running from terms" and 9.7 "What runs", wiki/function.md (`f(x) := x * 2; f(3)` is 6)
use "../check.wap"
use "scripted.wap"

DOUBLE := "double(n: int): int := n + n\n"

check("a function's value runs from its terms", both_ways("double", DOUBLE + "double(3)"), "6\nexit 0")
check("the program shows its last value", both_ways("last", DOUBLE + "double(1)\ndouble(4)"), "8\nexit 0")
check("a function calls another", both_ways("calls", DOUBLE + "quadruple(n: int): int := double(double(n))\nquadruple(5)"), "20\nexit 0")
check("a constant runs as its value", both_ways("constant", "answer: int := 6 * 7\nanswer"), "42\nexit 0")
check("a comparison runs as a truth value", both_ways("compare", DOUBLE + "yes_no(b: bool): int := if b then 1 else 0\nyes_no(double(2) == 4)"), "1\nexit 0")
check("a test of a number runs as the host's comparison", both_ways("sign", "sign(n: int): int := if n == 0 then 0 else 1\nsign(0) + sign(5)"), "1\nexit 0")
check("a block's variable runs as a variable", both_ways("block", "f(n: int): int := { m = n + 1; m * m }\nf(2)"), "9\nexit 0")
check("a recursion runs by its body as written", both_ways("factorial", "factorial(n: int): int := if n == 0 then 1 else n * factorial(n - 1)\nfactorial(5)"), "120\nexit 0")
check("a call of itself in last place runs deep without overflow", both_ways("count", "count(n: int, total: int): int := if n == 0 then total else count(n - 1, total + 1)\ncount(1000000, 0)"), "1000000\nexit 0")
check("a block returns early", both_ways("early", "first_big(a: int, b: int): int := { if a > 10 { return a }; b }\nfirst_big(20, 3) + first_big(1, 3)"), "23\nexit 0")
check("a truth value written runs as itself", both_ways("truths", "yes_no(b: bool): int := if b then 1 else 0\nyes_no(yes) + yes_no(no)"), "1\nexit 0")
check("an order of numbers runs as the host's", both_ways("larger", "larger(a: int, b: int): int := if a >= b { a } else { b }\nlarger(3, 5) + larger(4, 2)"), "9\nexit 0")
check("a negative number runs as itself", both_ways("negative", "same(n: int): int := n\nsame(-3)"), "-3\nexit 0")
check("a function that hides a prelude name runs under its own", both_ways("hiding", "turned(n: int): int := n + 1\nturned(2)"), "3\nexit 0")
check("the answer to a question is no part of what runs from its terms", outcome("question", said_of("question_terms", "double(n: int): int := n + n\ntype of double\ndouble(2)", RUN_DOOR)), "4\nexit 0")
check("a function value runs as the host's", both_ways("function_value", "twice(f: int -> int, n: int): int := f(f(n))\ntwice((n: int) => n + 1, 3)"), "5\nexit 0")
check("a function of the language every program gets with a body of its own runs that body", both_ways("language_body", "abs(-3)"), "3\nexit 0")
check("a number is read at the type its place wants: a whole number given where an int is wanted is subtracted as an int", both_ways("literal_place", "abs(0 - 3)"), "3\nexit 0")
check("a list's count runs as the host's", both_ways("list_count", "size(xs: list<int>): int := #xs\nsize([4, 5, 6])"), "3\nexit 0")
check("a list written in parentheses is read at the type its place wants", both_ways("list_count_grouped", "size(xs: list<int>): int := #xs\nsize(([4, 5]))"), "2\nexit 0")
check("a list taken apart by a match runs as the host's list", outcome("list_match", said_of("list_match_terms", "total(xs: list<int>): int := match xs { empty => 0; item(y, rest) => y + total(rest) }\ntotal([1, 2, 3])", RUN_DOOR)), "6\nexit 0")
check("a list's item at a place its type proves runs as the host's", outcome("list_item", said_of("list_item_terms", "first_of(xs: list<int> where #it > 0): int := xs#1\nsome: list<int> = [7, 8]\nfirst_of(some)", RUN_DOOR)), "7\nexit 0")
