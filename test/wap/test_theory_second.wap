# the second checker (wap/extensions/theory/second/) reads what the theory's door exports and checks every statement
# again by its own rules, with nothing of the kernel: it accepts the preludes and refuses an export changed after the
# door wrote it. Source: notes/theory.md "A second opinion", wiki/universe.md
use "../check.wap"
use "scripted.wap"
use path

SECOND_CHECKER := "wap/extensions/theory/second/check.wap"
prelude(name: text): text := file_text(path_join(script.tree, "wap/extensions/theory/prelude/${name}.wap")) + "\n"
preludes = prelude("logic") + prelude("numbers") + prelude("quotient")
door_module = door_built()
second = tree_built("second", SECOND_CHECKER)
# what the second checker says of the export the door writes of a program
exported(name: text, program: text): text := {
	file = staged(name + ".ndjson")
	door(door_module, name, program + "export(\"${file}\")")
	file
}
second_said(file: text): text := said([script.wap, second, file])

accepted = exported("preludes", preludes + "law four: Equal[1](nat, add(2, 2), 4) := Equal.refl[1](nat, 4)\n")
check("the second checker accepts the logic, numbers and quotient preludes", second_said(accepted), "")
# the export's last theorem given its own statement as its proof
lines = file_text(accepted).split("\n")
last = lines.last
proof = last.split("\"value\":")#2.split("}")#1
statement = last.split("\"type\":")#2.split(",")#1
forged = staged("forged.ndjson")
write(forged, (lines.take(#lines - 1) + [last.replace("\"value\":${proof}", "\"value\":${statement}")]).join("\n") + "\n")
check("a theorem whose proof was changed in the export is refused", second_said(forged), "four's value does not have its type")
