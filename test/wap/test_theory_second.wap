# the second checker (wap/extensions/theory/second/) reads what the theory's door exports and checks every statement
# again by its own rules, with nothing of the kernel: it accepts the preludes and refuses an export changed after the
# door wrote it. Source: notes/theory.md "A second opinion", wiki/universe.md
use "../check.wap"
use "scripted.wap"
use path

SECOND_CHECKER := "wap/extensions/theory/second/check.wap"
prelude(name: text): text := file_text(path_join(script.tree, "wap/extensions/theory/prelude/${name}.wap")) + "\n"
preludes = prelude("logic") + prelude("numbers") + prelude("quotient")
door_module = door_built()
second = tree_built("second", SECOND_CHECKER)
# the export a door writes of a program it accepts
exported(name: text, program: text, module: text = door_module): text := {
	file = staged(name + ".ndjson")
	refusal = door(module, name, program + "export(\"${file}\")")
	if refusal != "" { raise "the door refuses ${name}: ${refusal}" }
	file
}
second_said(file: text): text := said([script.wap, second, file])

accepted = exported("preludes", preludes + "law four: Equal[1](nat, add(2, 2), 4) := Equal.refl[1](nat, 4)\n")
check("the second checker accepts the logic, numbers and quotient preludes", second_said(accepted), "")
# the export's last theorem given its own statement as its proof
lines = file_text(accepted).split("\n")
last = lines.last
proof = last.split("\"value\":")#2.split("}")#1
statement = last.split("\"type\":")#2.split(",")#1
forged = staged("forged.ndjson")
write(forged, (lines.take(#lines - 1) + [last.replace("\"value\":${proof}", "\"value\":${statement}")]).join("\n") + "\n")
check("a theorem whose proof was changed in the export is refused", second_said(forged), "four's value does not have its type")

# the axioms a name rests on, as the door and the second checker each say them: each list's names in order
axioms_sorted(said: text): text := said.split("\n").map(line => line.replace("[", "").replace("]", "").split(", ").sorted().join(", ")).join("\n")
AXIOMS_ASKED := ["four", "quotient_sound", "function_extensionality"]
door_axioms = door(door_module, "preludes_axioms", preludes + "law four: Equal[1](nat, add(2, 2), 4) := Equal.refl[1](nat, 4)\n" + AXIOMS_ASKED.map(name => "axioms of " + name).join("\n"))
check("the second checker finds the axioms the door finds", axioms_sorted(said([script.wap, second, accepted] + AXIOMS_ASKED)), axioms_sorted(door_axioms))

# blocks of every shape: mutual and indexed, a family recursive at a level parameter, a structure taken apart
BLOCKS := "enum Equal(T: Sort(u), a: T): T -> Prop { refl: Equal(T, a, a) }\naxiom int: Type\naxiom a: int\naxiom b: int\nenum nat: Type { zero: nat, successor(n: nat): nat }\nenum Even: nat -> Prop { zero: Even(nat.zero), step(n: nat, e: Odd(n)): Even(nat.successor(n)) }\nenum Odd: nat -> Prop { step(n: nat, e: Even(n)): Odd(nat.successor(n)) }\nlaw two: Even(nat.successor(nat.successor(nat.zero))) := Even.step(nat.successor(nat.zero), Odd.step(nat.zero, Even.zero))\nenum Pair(A: Type, B: Type): Type { make(first: A, second: B): Pair(A, B) }\nlaw first: Equal[1](int, projection(Pair, 1, Pair.make(int, int, a, b)), a) := Equal.refl[1](int, a)\nenum List(T: Type(u)): Type(u) { nil: List(T), cons(head: T, tail: List(T)): List(T) }\nlaw head: Equal[1](int, List.recursor[1, 0](int, (l: List[0](int)) => int, b, (h: int) => (t: List[0](int)) => (r: int) => h, List.cons[0](int, a, List.nil[0](int))), a) := Equal.refl[1](int, a)\n"
check("the second checker accepts mutual, indexed and level-polymorphic recursive blocks and a projection", second_said(exported("blocks", BLOCKS)), "")
check("an export of the elaborator's door is checked too", said([script.wap, second, exported("elaborated", "axiom int: Type\nidentity(a: T): T := a\ncompose(g: B -> C, h: A -> B): A -> C := x => g(h(x))\n", module: tree_built("elaborator", ELABORATOR_DOOR))]), "")

# exports written by hand that no door would write: each refused for what is wrong with it
forged_said(name: text, records: list<text>): text := {
	file = staged(name + ".ndjson")
	write(file, records.join("\n") + "\n")
	second_said(file)
}
check("a block holding itself left of an arrow is refused", forged_said("negative", ["{\"in\":1,\"str\":{\"pre\":0,\"str\":\"bad\"}}", "{\"in\":2,\"str\":{\"pre\":1,\"str\":\"make\"}}", "{\"il\":1,\"succ\":0}", "{\"ie\":0,\"sort\":1}", "{\"ie\":1,\"const\":{\"name\":1,\"us\":[]}}", "{\"ie\":2,\"forallE\":{\"type\":1,\"body\":1}}", "{\"ie\":3,\"forallE\":{\"type\":2,\"body\":1}}", "{\"inductive\":{\"levelParams\":[],\"numParams\":0,\"types\":[{\"name\":1,\"type\":0,\"ctors\":[{\"name\":2,\"type\":3}]}]}}"]), "a field holds its block where only its result may")
check("a block holding a universe as large as itself is refused", forged_said("too_small", ["{\"in\":1,\"str\":{\"pre\":0,\"str\":\"big\"}}", "{\"in\":2,\"str\":{\"pre\":1,\"str\":\"make\"}}", "{\"il\":1,\"succ\":0}", "{\"ie\":0,\"sort\":1}", "{\"ie\":1,\"const\":{\"name\":1,\"us\":[]}}", "{\"ie\":2,\"forallE\":{\"type\":0,\"body\":1}}", "{\"inductive\":{\"levelParams\":[],\"numParams\":0,\"types\":[{\"name\":1,\"type\":0,\"ctors\":[{\"name\":2,\"type\":2}]}]}}"]), "big.make has a field above its block's universe")
check("data projected out of a proof is refused", forged_said("leak", ["{\"in\":1,\"str\":{\"pre\":0,\"str\":\"nat\"}}", "{\"in\":2,\"str\":{\"pre\":0,\"str\":\"wrap\"}}", "{\"in\":3,\"str\":{\"pre\":2,\"str\":\"make\"}}", "{\"in\":4,\"str\":{\"pre\":0,\"str\":\"w\"}}", "{\"in\":5,\"str\":{\"pre\":0,\"str\":\"leak\"}}", "{\"il\":1,\"succ\":0}", "{\"ie\":0,\"sort\":1}", "{\"ie\":1,\"sort\":0}", "{\"ie\":2,\"const\":{\"name\":1,\"us\":[]}}", "{\"ie\":3,\"const\":{\"name\":2,\"us\":[]}}", "{\"ie\":4,\"forallE\":{\"type\":2,\"body\":3}}", "{\"ie\":5,\"const\":{\"name\":4,\"us\":[]}}", "{\"ie\":6,\"proj\":{\"typeName\":2,\"idx\":1,\"struct\":5}}", "{\"axiom\":{\"name\":1,\"levelParams\":[],\"type\":0}}", "{\"inductive\":{\"levelParams\":[],\"numParams\":0,\"types\":[{\"name\":2,\"type\":1,\"ctors\":[{\"name\":3,\"type\":4}]}]}}", "{\"axiom\":{\"name\":4,\"levelParams\":[],\"type\":3}}", "{\"def\":{\"name\":5,\"levelParams\":[],\"type\":2,\"value\":6}}"]), "data is taken out of a proof")
check("a case named by the anonymous name is refused", forged_said("anonymous", ["{\"in\":1,\"str\":{\"pre\":0,\"str\":\"bool\"}}", "{\"il\":1,\"succ\":0}", "{\"ie\":0,\"sort\":1}", "{\"ie\":1,\"const\":{\"name\":1,\"us\":[]}}", "{\"inductive\":{\"levelParams\":[],\"numParams\":0,\"types\":[{\"name\":1,\"type\":0,\"ctors\":[{\"name\":0,\"type\":1}]}]}}"]), "the export names something by the anonymous name")
# the accepted export with one record changed
changed_said(name: text, change: (text) -> text): text := {
	file = staged(name + ".ndjson")
	write(file, change(file_text(accepted)))
	second_said(file)
}
# the first record of one kind written as another
relabelled(export: text, from: text, to: text): text := {
	parts = export.split(from)
	parts#1 + to + parts.drop(1).join(from)
}
shortcut_swapped(export: text): text := {
	line = export.split("\n").filter(l => l.contains("\"word\":\"shortcut\""))#1
	names = line.split("\"names\":[")#2.split("]")#1.split(",")
	swapped = names.take(#names - 2) + [names.last, names#(#names - 1)]
	export.replace(line, line.replace(names.join(","), swapped.join(",")))
}
check("a shortcut given its theorems in another order is refused", changed_said("shortcut", shortcut_swapped), "add_successor states no add theorem 1")
check("a definition of data relabelled a theorem is refused", changed_said("relabelled", export => relabelled(export, "{\"def\":", "{\"thm\":")), "Not is a theorem of no proposition")
