# statements read as terms through the elaborator's door (wap/extensions/theory/elaborate/statements.wap): a block's
# statements in order, a value given to a name a new binding of it whose type may change, a return the block's value.
# Source: coc-plan 3.8 and 9.5 (notes/elaborate.md "Statements"), wiki/effects.md
use "../check.wap"
use "scripted.wap"

elaborated(name: text, program: text): text := said_of(name, program, ELABORATOR_DOOR)

check("a block's names are lets", elaborated("statements_let", "f(n: nat): nat := { s = n; s }\ntype of f"), "nat -> nat")
check("a let computes", elaborated("statements_computes", "f(n: nat): nat := { n = add(n, 2); n = add(n, 3); n }\nlaw r: Equal(nat, f(1), 6) := Equal.refl(nat, 6)"), "")
check("a name given a value of another type holds that type from there on", elaborated("statements_retyped", "f(n: nat): bool := { s = add(n, 1); s = is_zero(s); s }\nlaw r: Equal(bool, f(0), bool.no) := Equal.refl(bool, bool.no)"), "")
check("a name written with its type holds a value of it", elaborated("statements_typed", "f(n: nat): nat := { s: nat = n; nat.successor(s) }\ntype of f"), "nat -> nat")
check("a value before the last statement is lost", refused_by(elaborated("statements_lost", "f(n: nat): nat := { n; n }")), "refused by statement")
check("a block ending with a value given to a name gives no value", refused_by(elaborated("statements_set_last", "f(n: nat): nat := { s = n }")), "refused by statement")
