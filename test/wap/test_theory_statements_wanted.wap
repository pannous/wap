# a part of a value written with a type is never given a value as if it were a name: the elaborator's door reads
# `s#1: nat = n` as something it accepts.
# Source: coc-plan 9.5 (notes/elaborate.md "Statements and effects"), wiki/effects.md
use "../check.wap"
use "scripted.wap"

check("a part of a value written with a type is never given a value as if it were a name", refused_by(elaborated("statements_part_typed", "f(n: nat): nat := {\n s = n\n s#1: nat = n\n s\n}")), "refused by statement")
