# choices and returns in a block read as terms through the elaborator's door: the rest of the block after a choice
# read once and joined from each part, a return the block's value at once, a part of a value never given a value.
# Source: coc-plan 9.5 (notes/elaborate.md "Statements and effects"), wiki/effects.md. Red until the door reads with
# the tree's rules (E3), which write `if` and `return` as kernel forms
use "../check.wap"
use "scripted.wap"

elaborated(name: text, program: text): text := said_of(name, program, ELABORATOR_DOOR)

check("a choice's parts join again for the rest of the block", elaborated("statements_join", "f(n: nat): nat := {\n s = n\n if is_zero(n) { s = 5 } else { s = 7 }\n add(s, 1)\n}\nlaw a: Equal[1](nat, f(0), 6) := Equal.refl[1](nat, 6)\nlaw b: Equal[1](nat, f(3), 8) := Equal.refl[1](nat, 8)"), "")
check("a choice without an else keeps the name's value", elaborated("statements_one_part", "f(n: nat): nat := {\n s = n\n if is_zero(n) { s = 5 }\n add(s, 1)\n}\nlaw a: Equal[1](nat, f(0), 6) := Equal.refl[1](nat, 6)\nlaw b: Equal[1](nat, f(3), 4) := Equal.refl[1](nat, 4)"), "")
check("a return in a part skips the rest of the block", elaborated("statements_return", "f(n: nat): nat := {\n if is_zero(n) { return 9 }\n add(n, 1)\n}\nlaw a: Equal[1](nat, f(0), 9) := Equal.refl[1](nat, 9)\nlaw b: Equal[1](nat, f(3), 4) := Equal.refl[1](nat, 4)"), "")
check("a name both parts give is seen after the choice", elaborated("statements_both", "f(n: nat): nat := {\n if is_zero(n) { t = 2 } else { t = 3 }\n t\n}\nlaw a: Equal[1](nat, f(0), 2) := Equal.refl[1](nat, 2)\nlaw b: Equal[1](nat, f(1), 3) := Equal.refl[1](nat, 3)"), "")
check("choices in a row each see the one before", elaborated("statements_in_a_row", "f(n: nat): nat := {\n s = n\n if is_zero(s) { s = 1 }\n if is_zero(s) { s = 2 }\n if is_zero(s) { s = 3 }\n s\n}\nlaw a: Equal[1](nat, f(0), 1) := Equal.refl[1](nat, 1)"), "")
check("a choice inside a choice joins too", elaborated("statements_nested", "f(n: nat): nat := {\n s = 1\n if is_zero(n) { if is_zero(s) { s = 2 } else { s = 3 } }\n add(s, 1)\n}\nlaw a: Equal[1](nat, f(0), 4) := Equal.refl[1](nat, 4)\nlaw b: Equal[1](nat, f(5), 2) := Equal.refl[1](nat, 2)"), "")
check("a wrong value after a choice is refused", refused_by(elaborated("statements_join_wrong", "f(n: nat): nat := {\n s = n\n if is_zero(n) { s = 5 }\n s\n}\nlaw a: Equal[1](nat, f(0), 0) := Equal.refl[1](nat, 0)")), "refused by value type")
check("a part of a value is never given a value as if it were a name", refused_by(elaborated("statements_part", "f(n: nat): nat := {\n s = n\n s#1 = n\n s\n}")), "refused by statement")
check("a part of a value written with a type is never given a value as if it were a name", refused_by(elaborated("statements_part_typed", "f(n: nat): nat := {\n s = n\n s#1: nat = n\n s\n}")), "refused by statement")
