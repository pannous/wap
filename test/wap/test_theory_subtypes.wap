# subtypes through the elaborator's door (wap/extensions/theory/elaborate/door.wap): `T where p` is the type of the
# values of T that meet p, a value of it is a value with its proof
# Source: wiki/subtype.md, notes/elaborate.md "Subtypes and obligations (E4)"
use "../check.wap"
use "scripted.wap"
use "../../wap/extensions/theory/options.wap"

elaborated(name: text, program: text): text := said_of(name, program, ELABORATOR_DOOR)
ONE := "(n: nat) => Equal(nat, n, 1)"

check("a type where a condition holds is a type", elaborated("where", "type of (nat where Equal(nat, it, 1))"), "Type")
check("a definition's type may be one where a condition holds of its parameters", elaborated("sized", "sized(T: Type, n: nat): Type := list<T> where Equal(nat, count(T, it), n)\ntype of sized(nat, 2)"), "Type")
check("a value of a subtype is the value with its proof", elaborated("subset_value", "type of Subset.intro(nat, ${ONE}, 1, Equal.refl(nat, 1))"), "Subset[1](nat, (n: nat) => Equal[1](nat, n, 1))")

# conversions. Source: wiki/subtype.md (a value of a subtype is a value of its parent), notes/elaborate.md "Subtypes and
# obligations (E4)" Conversions
ONE_VALUE := "Subset.intro(nat, ${ONE}, 1, Equal.refl(nat, 1))"
CELSIUS := "enum celsius { degrees(n: nat) }\nconvert(c: celsius): nat := nat.zero\n"
check("a value of a subtype is a value of its parent where the parent is wanted", elaborated("subset_up", "type of nat.successor(${ONE_VALUE})"), "nat")
check("a program's own conversion is put in where its type is wanted", elaborated("own_conversion", CELSIUS + "type of nat.successor(celsius.degrees(1))"), "nat")
check("two conversions between the same types are refused naming both", refused_by(elaborated("two_conversions", CELSIUS + "convert(c: celsius): nat := 1\ntype of nat.successor(celsius.degrees(1))")), "refused by conversion")

# going down: a value where a subtype is wanted, with the proof of its condition. Source: wiki/subtype.md (a value is
# checked where the subtype is wanted, `if #line == 1 { e: char = line }`), notes/elaborate.md "Subtypes and
# obligations (E4)" Going down
ONLY_ONE := "only_one(n: nat where Equal(nat, it, 1)): nat := n\n"
DECIDED_ONE := "one_decided: Decidable(Equal(nat, 1, 1)) := Decidable.is_true(Equal(nat, 1, 1), Equal.refl(nat, 1))\n"
check("a condition whose decision computes to yes proves itself", elaborated("down_computed", ONLY_ONE + DECIDED_ONE + "type of only_one(1)"), "nat")
check("a condition whose decision computes to no is refused", refused_by(elaborated("down_false", ONLY_ONE + "axiom two_not_one: Not(Equal(nat, 2, 1))\ntwo_decided: Decidable(Equal(nat, 2, 1)) := Decidable.is_false(Equal(nat, 2, 1), two_not_one)\ntype of only_one(2)")), "refused by condition")
check("a binder whose type is the condition proves it", elaborated("down_binder", ONLY_ONE + "f(n: nat, h: Equal(nat, n, 1)): nat := only_one(n)\ntype of f"), "(n: nat) -> Equal[1](nat, n, 1) -> nat")
check("the proof a subtype's value carries proves its condition again", elaborated("down_carried", ONLY_ONE + "same(n: nat): nat := n\ng(s: nat where Equal(nat, it, 1)): nat := only_one(same(s))\ntype of g"), "filter[1](nat, (it: nat) => Equal[1](nat, it, 1)) -> nat")
check("a condition nothing proves is refused", refused_by(elaborated("down_unproved", ONLY_ONE + "f(n: nat): nat := only_one(n)")), "refused by unproved condition")
