# subtypes through the elaborator's door (wap/extensions/theory/elaborate/door.wap): `T where p` is the type of the
# values of T that meet p, a value of it is a value with its proof
# Source: wiki/subtype.md, notes/elaborate.md "Subtypes and obligations (E4)"
use "../check.wap"
use "scripted.wap"
use "../../wap/extensions/theory/options.wap"

elaborated(name: text, program: text): text := said_of(name, program, ELABORATOR_DOOR)
ONE := "(n: nat) => Equal(nat, n, 1)"

check("a type where a condition holds is a type", elaborated("where", "type of (nat where Equal(nat, it, 1))"), "Type")
check("a definition's type may be one where a condition holds of its parameters", elaborated("sized", "sized(T: Type, n: nat): Type := list<T> where Equal(nat, count(T, it), n)\ntype of sized(nat, 2)"), "Type")
check("a value of a subtype is the value with its proof", elaborated("subset_value", "type of Subset.intro(nat, ${ONE}, 1, Equal.refl(nat, 1))"), "Subset[1](nat, (n: nat) => Equal[1](nat, n, 1))")

# conversions. Source: wiki/subtype.md (a value of a subtype is a value of its parent), notes/elaborate.md "Subtypes and
# obligations (E4)" Conversions
ONE_VALUE := "Subset.intro(nat, ${ONE}, 1, Equal.refl(nat, 1))"
CELSIUS := "enum celsius { degrees(n: nat) }\nconvert(c: celsius): nat := nat.zero\n"
check("a value of a subtype is a value of its parent where the parent is wanted", elaborated("subset_up", "type of nat.successor(${ONE_VALUE})"), "nat")
check("a program's own conversion is put in where its type is wanted", elaborated("own_conversion", CELSIUS + "type of nat.successor(celsius.degrees(1))"), "nat")
check("two conversions between the same types are refused naming both", refused_by(elaborated("two_conversions", CELSIUS + "convert(c: celsius): nat := 1\ntype of nat.successor(celsius.degrees(1))")), "refused by conversion")

# going down: a value where a subtype is wanted, with the proof of its condition. Source: wiki/subtype.md (a value is
# checked where the subtype is wanted, `if #line == 1 { e: char = line }`), notes/elaborate.md "Subtypes and
# obligations (E4)" Going down
ONLY_ONE := "only_one(n: nat where Equal(nat, it, 1)): nat := n\n"
DECIDED_ONE := "one_decided: Decidable(Equal(nat, 1, 1)) := Decidable.is_true(Equal(nat, 1, 1), Equal.refl(nat, 1))\n"
DECIDED_TWO := "axiom two_not_one: Not(Equal(nat, 2, 1))\ntwo_decided: Decidable(Equal(nat, 2, 1)) := Decidable.is_false(Equal(nat, 2, 1), two_not_one)\n"
check("a condition whose decision computes to yes proves itself", elaborated("down_computed", ONLY_ONE + DECIDED_ONE + "type of only_one(1)"), "nat")
check("a condition whose decision computes to no is refused", refused_by(elaborated("down_false", ONLY_ONE + DECIDED_TWO + "type of only_one(2)")), "refused by condition")
check("a binder whose type is the condition proves it", elaborated("down_binder", ONLY_ONE + "f(n: nat, h: Equal(nat, n, 1)): nat := only_one(n)\ntype of f"), "(n: nat) -> Equal[1](nat, n, 1) -> nat")
check("the proof a subtype's value carries proves its condition again", elaborated("down_carried", ONLY_ONE + "same(n: nat): nat := n\ng(s: nat where Equal(nat, it, 1)): nat := only_one(same(s))\ntype of g"), "where[1](nat, (it: nat) => Equal[1](nat, it, 1)) -> nat")
check("a condition nothing proves is refused", refused_by(elaborated("down_unproved", ONLY_ONE + "f(n: nat): nat := only_one(n)")), "refused by unproved condition")

# testing a value. Source: notes/elaborate.md "Subtypes and obligations (E4)": `x is S` is the decision of the
# condition at x, a bool
ONE_ONLY := "one_only := nat where Equal(nat, it, 1)\n"
IS_COMPUTED := "law one_is: (1 is one_only) == yes := refl\nlaw two_is_not: (2 is one_only) == no := refl\n"
check("a definition whose condition names it is a type", elaborated("where_definition", ONE_ONLY + "type of one_only"), "Type")
check("a value tested against a subtype is a bool, yes where the condition holds and no where it fails", elaborated("is_value", ONE_ONLY + DECIDED_ONE + DECIDED_TWO + IS_COMPUTED + "type of 1 is one_only"), "bool")
check("a value tested against a condition nothing decides is refused", refused_by(elaborated("is_undecided", ONE_ONLY + "type of 3 is one_only")), "refused by undecidable condition")
check("a binder giving a subtype's value is no fact about its argument", refused_by(elaborated("down_function_binder", ONLY_ONE + "h(make: nat -> (nat where Equal(nat, it, 1)), n: nat): nat := only_one(n)")), "refused by unproved condition")
check("an overload whose condition computes to no does not fit", elaborated("overload_condition", DECIDED_TWO + "pick(n: nat where Equal(nat, it, 1)): bool := bool.yes\npick(n: nat): nat := n\ntype of pick(2)"), "nat")
check("a value tested against a type without a condition is refused", refused_by(elaborated("is_no_subtype", "type of 2 is nat")), "refused by not a subtype")

# subtypes written with operators and named by `type`. Source: wiki/subtype.md (char, vector, index), plan 3.2 and 3.3
check("a condition written with operators", elaborated("where_operators", "type of (nat where it == 1)"), "Type")
check("a type with parameters", elaborated("vector", "type vector(T, n: nat) = list<T> where #it == n\ntype of vector(nat, 2)"), "Type")
CHAR := "type char = text where #it == 1\n"
check("a text of one character is a char", elaborated("char_one", CHAR + "c: char := \"a\"\ntype of c"), "char")
check("a text of two characters is no char", refused_by(elaborated("char_two", CHAR + "d: char := \"ab\"")), "refused by condition")
check("a char is a text where a text is wanted", elaborated("char_text", CHAR + "c: char := \"a\"\nshout(t: text): text := t + \"!\"\ntype of shout(c)"), "text")
VECTOR := "type vector(T, n: nat) = list<T> where #it == n\n"
check("a list of three is a vector of three", elaborated("vector_three", VECTOR + "three: vector(nat, 3) := [1, 2, 3]\ntype of three"), "vector[1](nat, 3)")
check("a list of two is no vector of three", refused_by(elaborated("vector_two", VECTOR + "three: vector(nat, 3) := [1, 2]")), "refused by condition")
INDEX := "type index(xs: list<T>) = nat where 1 <= it and it <= #xs\n"
check("a place inside a list is an index of it", elaborated("index_in", INDEX + "i: index([5, 6]) := 2\ntype of i"), "index[1](nat, list.item[1](nat, 5, list.item[1](nat, 6, list.empty[1](nat))))")
check("a place past a list's end is no index of it", refused_by(elaborated("index_past", INDEX + "j: index([5, 6]) := 3")), "refused by condition")
# Source: notes/elaborate.md "Subtypes and obligations (E4)" Conversions: one that fits only by waiting on a hole is
# none. The condition's `==` gives a bool where a proposition is wanted, while T's level is still to be found: the
# bool's conversion fits, a subset's only by a level left waiting, so the bool's is the one
check("a conversion that fits only by a level left waiting is no fit", elaborated("open_level", "sized(T, n: nat) := list<T> where #it == n"), "")
# Source: notes/elaborate.md "Reading an expression": `[a, b]` is written by the list's cases where the program reads
check("a list written where the program's list has no cases for it is refused", refused_by(elaborated("own_list", "enum list(T: Type) { nothing }\nxs: list(nat) := [1]")), "refused by unknown name")
check("a value of the program's type is given where it is named, at the top of the program", elaborated("char_given", CHAR + "c: char = \"a\"\ntype of c"), "char")
check("a name the program sets a second time is no constant", refused_by(elaborated("set_again", "n = 1\nn = 2\nm: nat := n")), "refused by set again")
check("a name a function's body sets is no constant, a set inside a branch too", refused_by(elaborated("set_in_function", "total = 0\nadd(k: nat) := { if k == 0 { total = k } }\nnow: nat := total")), "refused by set again")
check("two sets on one line are two places", refused_by(elaborated("set_twice_on_a_line", "n = 1; n = 2")), "refused by set again")
check("a name only the language's own functions set as their variable is the program's constant", elaborated("set_by_language", "joined = 1 + 2\nm: nat := joined"), "")
