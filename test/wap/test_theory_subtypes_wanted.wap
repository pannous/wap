# subtypes through the elaborator's door, as wiki/subtype.md writes them: with operators
# Source: wiki/subtype.md, wiki/type.md "Proved or checked"
use "../check.wap"
use "scripted.wap"
use "../../wap/extensions/proof/verify/options.wap"

CHAR := "type char = text where #it == 1\n"
VECTOR := "type vector(T, n: nat) = list<T> where #it == n\n"
check("a parameter's condition proves the value made of it", elaborated("initial", CHAR + "initial(name: text where #it > 0): char := name#1\ntype of initial"), "(name: text where #it > 0) -> char")
DOT := VECTOR + "dot(a: vector(nat, n), b: vector(nat, n)): nat := sum(a .* b)\n"
check("two vectors of one length", elaborated("dot", DOT + "law dot_is: dot([1, 2, 3], [4, 5, 6]) == 32 := refl"), "")
check("two vectors of two lengths are refused", refused_by(elaborated("dot_lengths", DOT + "x := dot([1, 2, 3], [4, 5])")), "refused by condition")
INDEXED := "type index(xs: list<T>) = nat where 1 <= it and it <= #xs\nat(xs: list<nat>, i: index(xs)): nat := i\n"
check("an index proved in range from the loop's bounds leaves no check", elaborated("loop_index", INDEXED + "total(xs: list<nat>): nat := { s = 0; for i in 1 to #xs { s = s + at(xs, i) }; s }\nlaw total_is: total([5, 6]) == 3 := refl"), "")
check("an index one past the loop's own is proved from its bounds", elaborated("loop_index_next", INDEXED + "steps(xs: list<nat>): nat := { s = 0; for i in 1 to #xs - 1 { s = s + at(xs, i + 1) }; s }\nlaw steps_is: steps([5, 6, 7]) == 5 := refl"), "")
