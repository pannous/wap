# untyped parameters through the elaborator's doors: a parameter written without a type takes it from the body, else
# from each call, one version per kind of argument; a law's `for` line is one of its parameters
# Source: wiki/function.md:24 ("infers x's type from the body and the calls"), wiki/function.md:33 ("one version per
# kind"), wiki/proposition.md:34 ("`for n: nat` before a statement is the same as a parameter"), wiki/laws.md:4
use "../check.wap"
use "scripted.wap"
use "../../wap/extensions/verify/options.wap"

check("an untyped function's type is found from its call", elaborated("square_call", "square(x) := x*x\ntype of square(3)"), "nat")
check("an untyped function called with two kinds is one version per kind", elaborated("twice_kinds", "twice(x) := x + x\ntype of twice(2)\ntype of twice(\"a\")"), "nat\ntext")
check("a law's for line is its parameter", verified("for_doubled", "law doubled:\n  for n: nat\n  n + n == 2 * n"), "doubled: Proved")
check("a whole number is an integer where one is wanted", elaborated("int_plus", "k(x: int): int := x + 1\ntype of k"), "int -> int")
