# function values in laws through the elaborator's door: `x => e` is the kernel's λ x. e, a function's name as a value
# its function, and a call through a function-typed parameter the value applied, so a law computes through them
# Source: wiki/law.md (a law computes its sides), notes/coc-t5c-measures.md part 7
use "../check.wap"
use "scripted.wap"

TWICE := "twice(f: (int) -> int, x: int): int := f(f(x))\n"
check("a law computes a function given a lambda", elaborated("values_lambda", TWICE + "law t: Equal(int, twice(y => y + 1, 3), 5) := Equal.refl(int, 5)"), "")
check("a law computes a function given a function's name", elaborated("values_named", TWICE + "inc(y: int): int := y + 1\nlaw t: Equal(int, twice(inc, 3), 5) := Equal.refl(int, 5)"), "")
