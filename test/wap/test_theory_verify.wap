# `wap verify` through its door (wap/extensions/verify/verify.wap): a program elaborated, then one verdict
# per law, theorem and axiom; an `assume` leaves a gap that every report names.
# Source: wiki/proof.md "Checking proofs" and "What a proof rests on", notes/coc-plan.md P1
use "../check.wap"
use "scripted.wap"

NAT := "enum nat { zero, successor(n: nat) }\n"
EVEN := "enum Even: nat -> Prop { zero: Even(nat.zero), step(e: Even(n)): Even(nat.successor(nat.successor(n))) }\n"
DOUBLE := "double(n: nat): nat := match n { zero => nat.zero; successor(k) => nat.successor(nat.successor(double(k))) }\n"
DOUBLE_EVEN := "law double_even(n: nat): Even(double(n)) := match n { zero => Even.zero; successor(k) => Even.step(double_even(k)) }\n"
HARD := "law hard(n: nat): Even(n) := assume\n"
evens = NAT + EVEN + DOUBLE

check("a law with its proof is Proved", verified("proved", evens + DOUBLE_EVEN), "double_even: Proved")
check("an assume shows as Assumed, and so does a law resting on it", verified("assumed", evens + HARD + "law uses_hard(n: nat): Even(nat.successor(nat.successor(n))) := Even.step(hard(n))"), "hard: Assumed\nuses_hard: Assumed")
check("an axiom is taken as true", verified("axiom", "axiom choice: Prop"), "choice: Axiom")
check("axioms of lists the assume a law rests on", verified("axioms_of", evens + DOUBLE_EVEN + HARD + "axioms of double_even\naxioms of hard"), "[]\n[hard]\ndouble_even: Proved\nhard: Assumed")
check("a wrong proof is refused", refused_by(verified("wrong", evens + "law wrong(n: nat): Even(double(n)) := Even.zero")), "refused by value type")
EQUAL := "enum Equal(a: T): T -> Prop { refl: Equal(a, a) }\n"
ADD := "add(n: nat, m: nat): nat := match n { zero => m; successor(k) => nat.successor(add(k, m)) }\n"
sums = NAT + EQUAL + ADD
check("a law nobody proved, every tried value holding it, is Tested", verified("tested", sums + "law add_zero(n: nat): Equal(add(n, nat.zero), n)"), "add_zero: Tested")
check("a broken law shows its counterexample", verified("broken", sums + "law wrong_add(n: nat): Equal(add(n, n), n)"), "wrong_add: FAILED, counterexample n = nat.successor(nat.zero)")
check("a law the values cannot decide is Untested", verified("untested", evens + "law any_even(n: nat): Even(n)"), "any_even: Untested")
check("a proof that uses an axiom is Proved and names what it rests on", verified("rests_on", "axiom fact: Prop\naxiom given: fact\nlaw uses_given: fact := given"), "fact: Axiom\ngiven: Axiom\nuses_given: Proved, rests on fact, given")
# the provers (wiki/proof.md "Ways to prove", notes/coc-plan.md P2), here with the prelude's nat, whose add counts down its second number
check("a law whose two sides compute to the same is Proved without a proof", verified("computed", "law four: Equal(nat, add(2, 2), 4)"), "four: Proved")
check("a law whose sides compute to the same for every value of its parameters is Proved", verified("computed_for_all", "law add_zero_right(n: nat): Equal(nat, add(n, 0), n)"), "add_zero_right: Proved")
check("a law the provers proved proves the laws after it", verified("prover_used", "law add_zero_right(n: nat): Equal(nat, add(n, 0), n)\nlaw twice_zero(m: nat): Equal(nat, add(add(m, 0), 0), m) := add_zero_right(add(m, 0))"), "add_zero_right: Proved\ntwice_zero: Proved")
check("a law that is one of its hypotheses is proved", verified("by_hypothesis", "law same_as_given(a: nat, b: nat, h: Equal(nat, a, b)): Equal(nat, a, b)\n"), "same_as_given: Proved")
check("a law the prelude's symmetry concludes from a hypothesis is proved", verified("by_earlier_law", "law flipped(a: nat, b: nat, h: Equal(nat, add(a, b), b)): Equal(nat, b, add(a, b))\n"), "flipped: Proved")
check("a law is proved by rewriting both sides with earlier laws that shrink them", verified("by_rewriting", "law multiply_one_left(n: nat): Equal(nat, multiply(1, n), n) := match n { zero => Equal.refl(nat, 0); successor(k) => equal_congruent(nat, nat, nat.successor, multiply(1, k), k, multiply_one_left(k)) }\nlaw both(m: nat, n: nat): Equal(nat, add(m, add(0, multiply(1, n))), add(m, n))\n"), "multiply_one_left: Proved\nboth: Proved")
# `by` names the laws a proof needs (wiki/proof.md "By other laws"); a named law rewrites even where it does not shrink the term, once at each place
check("a theorem is proved by the law its `by` names", verified("by_named", "theorem turned(a: nat, b: nat): Equal(nat, add(a, b), add(b, a)) := by add_commutative\n"), "turned: Proved")
check("a theorem is proved by the laws its `by` names, one after the other", verified("by_named_laws", "theorem swap(a: nat, b: nat): Equal(nat, add(add(a, b), 0), add(b, a)) := by add_zero, add_commutative\n"), "swap: Proved")
# a law `by` names that rewrites without end is refused, naming it (wap-supervisor's decision on the provers)
check("laws `by` names that rewrite without end are refused", refused_by(verified("by_endless", "same(n: nat): nat := n\nlaw grow(n: nat): Equal(nat, same(n), same(same(n)))\nlaw looping(a: nat): Equal(nat, same(a), add(a, 1)) := by grow\n")), "refused by endless rewriting")
check("a theorem is proved by the laws `by` names in parentheses", verified("by_called", "theorem swap(a: nat, b: nat): Equal(nat, add(add(a, b), 0), add(b, a)) := by(add_zero, add_commutative)\n"), "swap: Proved")
# a program that uses a compiled module is checked with the module's declarations, as it is compiled (wiki/use.md)
compiled("tripled", "triple(n: int): int := n * 3")
check("a program using a compiled module gets its laws' verdicts", verified("tripled_user", "use \"tripled.wasm\"\nlaw small: 1 < 2"), "small: Proved")
check("a law over a subtype is proved through its condition", verified("nonnegative", "type natural = int where it >= 0\nlaw nonnegative(a: natural): a >= 0"), "nonnegative: Proved")
check("a law of negative whole numbers computes to its verdict", verified("negative_sum", "law balanced: -3 + 5 == 2"), "balanced: Proved")
check("a law of whole numbers that computes to no fails", verified("wrong_sum", "law wrong: 2 + 2 == 5"), "wrong: FAILED")
check("a law over a subtype is proved by linear arithmetic over its condition", verified("up", "type natural = int where it >= 0\nlaw up(a: natural): a + 1 > 0"), "up: Proved")
# Source: wiki/proof.md (a hypothesis is a parameter naming what holds of the others)
check("a law is proved from a hypothesis parameter", verified("below", "law below(a: int, h: a <= 3): a < 4"), "below: Proved")
check("a law from a hypothesis parameter, as the wiki shows it", verified("widened", "law widened(a: int, b: int, h: a <= b): a <= b + 1"), "widened: Proved")
# Source: wiki/law.md (wap proves a law by computing it), wiki/class.md (a class's value is its fields)
check("a law over a program's enum cases computes to Proved", verified("enum_case", "enum figure { circle(r: int), dot }\nclass tagged {shape: figure; count: int}\nlaw counted: tagged(circle(3), 2).count == 2\nlaw bare: tagged(dot, 5).count == 5"), "counted: Proved\nbare: Proved")
check("a law over a class's field computes to Proved", verified("class_field", "class point {x: int; y: int}\nlaw first: point(1, 2).x == 1\nlaw literal: point{x: 3, y: 4}.y == 4"), "first: Proved\nliteral: Proved")
check("a law over a class with a function field stays Tested", verified("function_field", "class rule {apply: (int) -> int; weight: int}\nlaw weighed: rule((n: int) => n, 2).weight == 2"), "weighed: Tested")
check("a law over a class with text and class fields computes to Proved", verified("rich_fields", "class point {x: int; y: int}\nclass entry {label: text; at: point}\nlaw labelled: entry(\"a\", point(1, 2)).at.x == 1"), "labelled: Proved")
