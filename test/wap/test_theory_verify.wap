# `wap verify` through its door (wap/extensions/verify/verify.wap): a program elaborated, then one verdict
# per law, theorem and axiom; an `assume` leaves a gap that every report names.
# Source: wiki/proof.md "Checking proofs" and "What a proof rests on", notes/coc-plan.md P1
use "../check.wap"
use "scripted.wap"

# nat is `int where it >= 0` (user 2026-11-27), with `zero` and `successor` as its words; the enum is spelled out only where
# a law's point is its cases, under the name peano
EVEN := "enum Even: nat -> Prop { zero: Even(0), step(e: Even(n)): Even(n + 2) }\n"
DOUBLE := "double(n: nat): nat := match n { zero => 0; successor(k) => double(k) + 2 }\n"
PEANO := "enum peano { origin, after(n: peano) }\n"
DOUBLE_EVEN := "law double_even(n: nat): Even(double(n)) := match n { zero => Even.zero; successor(k) => Even.step(double_even(k)) }\n"
HARD := "law hard(n: nat): Even(n) := assume\n"
evens = EVEN + DOUBLE

check("a law with its proof is Proved", verified("proved", evens + DOUBLE_EVEN), "double_even: Proved")
check("an assume shows as Assumed, and so does a law resting on it", verified("assumed", evens + HARD + "law uses_hard(n: nat): Even(n + 2) := Even.step(hard(n))"), "hard: Assumed\nuses_hard: Assumed")
check("an axiom is taken as true", verified("axiom", "axiom choice: Prop"), "choice: Axiom")
check("axioms of lists the assume a law rests on", verified("axioms_of", evens + DOUBLE_EVEN + HARD + "axioms of double_even\naxioms of hard"), "[]\n[hard]\ndouble_even: Proved\nhard: Assumed")
check("a wrong proof is refused", refused_by(verified("wrong", evens + "law wrong(n: nat): Even(double(n)) := Even.zero")), "refused by value type")
EQUAL := "enum Equal(a: T): T -> Prop { refl: Equal(a, a) }\n"
ADD := "add(n: peano, m: peano): peano := match n { origin => m; after(k) => peano.after(add(k, m)) }\n"
sums = PEANO + EQUAL + ADD
check("a law nobody proved, every tried value holding it, is Tested", verified("tested", sums + "law add_zero(n: peano): Equal(add(n, peano.origin), n)"), "add_zero: Tested")
check("a broken law shows its counterexample", verified("broken", sums + "law wrong_add(n: peano): Equal(add(n, n), n)"), "wrong_add: FAILED, counterexample n = peano.after(peano.origin)")
check("a law the values cannot decide is Untested", verified("untested", evens + "law any_even(n: nat): Even(n)"), "any_even: Untested")
check("a proof that uses an axiom is Proved and names what it rests on", verified("rests_on", "axiom fact: Prop\naxiom given: fact\nlaw uses_given: fact := given"), "fact: Axiom\ngiven: Axiom\nuses_given: Proved, rests on fact, given")
# the provers (wiki/proof.md "Ways to prove", notes/coc-plan.md P2), here over nat
check("a law whose two sides compute to the same is Proved without a proof", verified("computed", "law four: 2 + 2 == 4"), "four: Proved")
check("a law whose sides compute to the same for every value of its parameters is Proved", verified("computed_for_all", "law add_zero_right(n: nat): n + 0 == n"), "add_zero_right: Proved")
check("a law the provers proved proves the laws after it", verified("prover_used", "law add_zero_right(n: nat): n + 0 == n\nlaw twice_zero(m: nat): m + 0 + 0 == m := add_zero_right(m + 0)"), "add_zero_right: Proved\ntwice_zero: Proved")
check("a law that is one of its hypotheses is proved", verified("by_hypothesis", "law same_as_given(a: nat, b: nat, h: a == b): a == b\n"), "same_as_given: Proved")
check("a law the prelude's symmetry concludes from a hypothesis is proved", verified("by_earlier_law", "law flipped(a: nat, b: nat, h: a + b == b): b == a + b\n"), "flipped: Proved")
check("a law is proved by rewriting both sides with earlier laws that shrink them", verified("by_rewriting", "law multiply_one_left(n: nat): 1 * n == n := match n { zero => Equal.refl(nat, 0); successor(k) => equal_congruent(nat, nat, successor, 1 * k, k, multiply_one_left(k)) }\nlaw both(m: nat, n: nat): m + (0 + 1 * n) == m + n\n"), "multiply_one_left: Proved\nboth: Proved")
# `by` names the laws a proof needs (wiki/proof.md "By other laws"); a named law rewrites even where it does not shrink the term, once at each place
check("a theorem is proved by the law its `by` names", verified("by_named", "theorem turned(a: nat, b: nat): a + b == b + a := by add_commutative\n"), "turned: Proved")
check("a theorem is proved by the laws its `by` names, one after the other", verified("by_named_laws", "theorem swap(a: nat, b: nat): a + b + 0 == b + a := by add_zero, add_commutative\n"), "swap: Proved")
# a law `by` names that rewrites without end is refused, naming it (wap-supervisor's decision on the provers)
check("laws `by` names that rewrite without end are refused", refused_by(verified("by_endless", "same(n: nat): nat := n\nlaw grow(n: nat): same(n) == same(same(n))\nlaw looping(a: nat): same(a) == a + 1 := by grow\n")), "refused by endless rewriting")
check("a theorem is proved by the laws `by` names in parentheses", verified("by_called", "theorem swap(a: nat, b: nat): a + b + 0 == b + a := by(add_zero, add_commutative)\n"), "swap: Proved")
# a program that uses a compiled module is checked with the module's declarations, as it is compiled (wiki/use.md)
compiled("tripled", "triple(n: int): int := n * 3")
check("a program using a compiled module gets its laws' verdicts", verified("tripled_user", "use \"tripled.wasm\"\nlaw small: 1 < 2"), "small: Proved")
check("a law over a subtype is proved through its condition", verified("nonnegative", "type natural = int where it >= 0\nlaw nonnegative(a: natural): a >= 0"), "nonnegative: Proved")
check("a law of negative whole numbers computes to its verdict", verified("negative_sum", "law balanced: -3 + 5 == 2"), "balanced: Proved")
check("a law of whole numbers that computes to no fails", verified("wrong_sum", "law wrong: 2 + 2 == 5"), "wrong: FAILED")
check("a law over a subtype is proved by linear arithmetic over its condition", verified("up", "type natural = int where it >= 0\nlaw up(a: natural): a + 1 > 0"), "up: Proved")
# Source: wiki/proof.md (a hypothesis is a parameter naming what holds of the others)
check("a law is proved from a hypothesis parameter", verified("below", "law below(a: int, h: a <= 3): a < 4"), "below: Proved")
check("a law from a hypothesis parameter, as the wiki shows it", verified("widened", "law widened(a: int, b: int, h: a <= b): a <= b + 1"), "widened: Proved")
# a proof written after the statement (wiki/proof.md "Ways to prove"): refl by computing, by with the laws it follows from
check("a theorem proved by computing its two sides is Proved", verified("refl_computed", "theorem four: 2 + 2 == 4 := refl\ndouble(n: int): int := n * 2\ntheorem double_three: double(3) == 6 := refl"), "four: Proved\ndouble_three: Proved")
check("refl of two sides that compute apart is refused", refused_by(verified("refl_apart", "theorem five: 2 + 2 == 5 := refl")), "refused by value type")
check("by hands the statement to the provers with the laws it names", verified("by_named", "law add_zero(a: int): a + 0 == a\ntheorem again(a: int): a + 0 + 0 == a := by add_zero"), "add_zero: Proved\nagain: Proved")
# an assume takes the statement as an axiom; a proof of no form is refused, its statement in wap's spelling
check("a law := assume is Assumed", verified("assumed_statement", "law c: 1 == 2 := assume"), "c: Assumed")
check("a law whose proof is of no form verify reads is refused", refused_by(verified("no_form", "law w: 1 == 2 := Equal.refl")), "refused by proof")
# what a proof rests on (wiki/proof.md "What a proof rests on"): a law proved from an assumed one is Assumed too
check("a law proved by an assumed law is Assumed", verified("rests_on_assume", "law hard(n: int): n * n >= n := assume\ntheorem uses_hard(n: int): n * n >= n := by hard"), "hard: Assumed\nuses_hard: Assumed")
# `axiom name: statement` adds an axiom (wiki/proof.md); a proof using it rests on it
check("an axiom is reported, and a proof using it rests on it", verified("axiom_rests", "axiom square_positive(n: int): n * n >= 0\ntheorem square_again(n: int): n * n >= 0 := by square_positive"), "square_positive: Axiom\nsquare_again: Proved, rests on square_positive")
# a parameter whose type is a statement is a hypothesis, a proof of it the law may use (wiki/proof.md "A parameter whose type is a statement")
check("a hypothesis is a proof of its statement", verified("kept_bound", "law kept_bound(a: nat, b: nat, h: a <= b): a <= b := h"), "kept_bound: Proved")
check("a law whose typing is refused takes its place with the reason and fails the run", door_ran(door_module(), "refused_typing", "law bad(n: int): n + \"a\" == 3").status, 1)
