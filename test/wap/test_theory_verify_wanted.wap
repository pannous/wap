# `wap verify` verdicts the kernel does not give yet: each red line is a to-do, turned green by the provers over int
# (notes/unify-provers.md, linear.wap over int).
# Source: wiki/law.md "Checking a law"
use "../check.wap"
use "scripted.wap"

verifier = door_built(VERIFY_DOOR)
verified(name: text, program: text): text := door(verifier, name, program)
check("a law over a subtype is proved by reckoning on its condition", verified("up", "type natural = int where it >= 0\nlaw up(a: natural): a + 1 > 0"), "up: Proved")
