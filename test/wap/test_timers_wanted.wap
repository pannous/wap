# the forms of the standard module timers (wiki/signal.md "Signals from outside") that wap does not build yet: what a
# run prints once main is over; red while a block giving no value does not fit a `() -> any` parameter
use "../check.wap"
use "scripted.wap"

check("a timer runs its block at each period once main is over, until the run ends", ran("every", "use timers\nuse units\nticks = []\non every(20ms) { ticks.add(1); print \"tick \${#ticks}\"; if #ticks == 3 { exit(0) } }\nprint \"main\""), "main\ntick 1\ntick 2\ntick 3")
check("two timers keep their own beats", ran("beats", "use timers\nuse units\nseen = []\non every(50ms) { seen.add(\"slow\") }\non every(20ms) { seen.add(\"fast\"); if #seen == 4 { print seen.join(\" \"); exit(0) } }"), "fast fast slow fast")
check("exit in a timer's block ends the run with its status", ran_status("exit_status", "use timers\nuse units\non every(20ms) { exit(3) }"), 3)
