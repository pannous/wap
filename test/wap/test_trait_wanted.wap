# the form of wiki/trait.md "Constraints" that wap does not build yet: a parameter asking for values of a trait,
# each a program of its own so the red line leaves the others green
use "../check.wap"
use "scripted.wap"

AGED := "class aged {name: text; age: int}\ncompare(a: aged, b: aged) := a.age - b.age\n"
check("a parameter asks for a list of values that conform to a trait", ran("smallest", AGED + "smallest(xs: Comparable list) := (sort xs)#1\nprint smallest([aged(\"Ann\", 3), aged(\"Bo\", 1)]).name"), "Bo")
