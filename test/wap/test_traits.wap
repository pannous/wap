# the refusals wiki/trait.md "Conforming" shows: a value that does not conform is refused naming the trait and the
# definition to write
use "../check.wap"
use "scripted.wap"

DOT := "class dot{x:int}\n"
check("a sort of values that are not Comparable names the trait and the word to define", ran("unsorted", DOT + "print sort [dot(2), dot(1)]").contains("line 2:7: dot is not Comparable: sorted needs compare(a: dot, b: dot); define compare(a: dot, b: dot) := …"), yes)
check("a claim of a trait is refused until its word is defined", lines_with(ran("claimed", "class dot: Comparable {x:int}\nprint dot(1).x"), "dot is not Comparable") > 0, yes)
# a trial that fails takes back what it found, its retyping hints too (wiki/trait.md "Conforming")
FLICKER := "trait lit { glow() }\nglow(x: T) := {\n\tlevel = 1\n\tfor step in 1 to 2 { level = \"bright\" }\n\tx.brightness\n}\nclass stone {weight: int}\nprint stone(1) is lit"
check("a type a generic word's trial cannot type does not do the trait, and the trial leaves no hint", ran("failed_trial", FLICKER), "no")
