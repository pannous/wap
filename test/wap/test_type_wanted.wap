# the refusals and reports wiki/type.md shows that wap does not build yet: each red line is a to-do, fixed by building
# the form
use "../check.wap"
use "scripted.wap"

check("two vectors of different lengths", refused_by(ran("dot_lengths", "dot(a: vector(number, n), b: vector(number, n)): number := sum(a .* b)\ndot([1, 2, 3], [4, 5])")), "refused by argument type")
check("a unit mismatch is found when compiling", refused_by(ran("units", "use units\n3m + 2s")), "refused by argument type")
check("a type depends only on values computed without acting", refused_by(ran("world_type", "v: vector(int, read_number()) = []")), "refused by effect")
check("a list is no int or text", refused_by(ran("union_refuses", "p: int | text = [1]")), "refused by value type")
check("wap check lists the obligations left to the run", wap_said(["check", written("obligations", "line = read_line()\nf = line as char")]), "line 2: line as char: #line == 1 is checked when the program runs")
check("wap check --strict refuses what is not proved", refused_by(wap_said(["check", "--strict", written("strict", "line = read_line()\nf = line as char")])), "refused by unproved condition")
