# the refusals and reports wiki/type.md shows that wap does not build yet: each red line is a to-do, fixed by building
# the form
use "../check.wap"
use "scripted.wap"

check("a name keeps the type of its first value", from_mark(ran("retyped_refused", "x = 1\nx = \"a\""), "refused"), "refused: x holds an int; write x: int or text")
check("two vectors of different lengths", from_mark(ran("dot_lengths", "dot(a: vector(number, n), b: vector(number, n)): number := sum(a .* b)\ndot([1, 2, 3], [4, 5])"), "refused"), "refused: dot takes two vectors of one length")
check("a unit mismatch is found when compiling", from_mark(ran("units", "use units\n3m + 2s"), "refused"), "refused: m and s are no same unit")
check("a type depends only on values computed without acting", from_mark(ran("world_type", "v: vector(int, read_number()) = []"), "refused"), "refused: a type may not depend on read_number, which reads input")
check("a list is no int or text", from_mark(ran("union_refuses", "p: int | text = [1]"), "refused"), "refused: a list is no int or text")
check("wap check lists the obligations left to the run", wap_said(["check", written("obligations", "line = read_line()\nf = line as char")]), "line 2: line as char: #line == 1 is checked when the program runs")
check("wap check --strict refuses what is not proved", from_mark(wap_said(["check", "--strict", written("strict", "line = read_line()\nf = line as char")]), "refused"), "refused: #line == 1 is not proved")
