# wap's typing stage (core/analyze/types.wap): every value's type, and the function each call means. A call picks
# among a name's definitions by its arguments' types, then by the type wanted; a parameter without a type makes one
# version of the function per tuple of argument types. Source: the lead's typing interface (notes/backbone.md)
use "../check.wap"
use "scripted.wap"

# the rest is test/test_types.wap and test/test_types_own.wap; this check fails there, beside class P { x: int }: an
# any holding Box(3) shows as P{x: 3}, the first class of the same fields
check("a value in an any shows itself by its own type's show", ran("shown_any", "s(x: any): text := show(x)\nclass Box { n: int }\nprint s(1) + \" \" + s(2.5) + \" \" + s(\"ab\") + \" \" + s(yes) + \" \" + s(Box(3))"), "1 2.5 \"ab\" yes Box{n: 3}")
# a call typed only once a map's item type settles names the instance it gets: `!` of a value whose type settles to
# text? (warp-wap-reader's `a ?? b` report)
check("a call deferred till its unknowns settle", ran("deferred_settled", "m = {}\nmaybe(s: text) as text? := if s == \"a\" then \"yes\" else ø\nh(b: bool) := if b then maybe(\"a\") else m.get(\"a\")!\nprint(h(yes) ?? \"x\")"), "yes")
check("an int given a float holds the float, said nothing", ran("widened", "y = 2\ny = 2.5\nprint \"\${y * 2}\""), "5")
# a map's value type that would hold itself settles as any, so untyped nested maps work (decision untyped-nested-maps)
nested = "out = {}\nsection = out\nsection = {}\nout[\"a\"] = section\nsection[\"k\"] = \"v\"\n"
check("a map holding a map of its own type holds any", ran("nested_maps", nested + "print \"\${out.keys} \${out[\"a\"] is map}\""), "[\"a\"] yes")
# a word a blank parts from the map after it is two items, said with the glued call (decision spaced-is-two,
# wiki/significant-whitespace.md)
check("a word spaced from a map is two items, with a warning", from_mark(ran("parted", "pair = [1, 2]\nx = pair {a: 1}\nprint \"\${#x}\""), "a blank"), "a blank parts pair from the map after it, so these are two items: write pair{…} for the call: x = pair {a: 1}\n2")
# an any holding a list or a map is used as its own type: shown by its items, read by its keys (warp's notes/first_principles.md
# "dynamic where we can't infer the type", "any list fits a bare list")
check("an any holding a list is shown by its items", ran("any_list", "a: any = [1, 2]\nprint \"\${a}\""), "[1, 2]")
check("an entry of a map held in an any is read by its key", ran("any_map", nested + "print text(out[\"a\"][\"k\"])"), "v")
check("an any holding a list is counted as a list", ran("any_count", "xs: any = [5, 6, 7]\nprint \"\${#xs}\""), "3")
