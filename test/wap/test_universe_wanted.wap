# the refusals wiki/universe.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "../check.wap"
use "scripted.wap"

check("levels do not include each other", from_mark(ran("box_int", "box(T: Type(1)) := T\nbox(int)"), "refused"), "refused: int is a Type, and box takes a Type(1)")
check("a universe never holds itself", from_mark(ran("type_in_type", "bad: Type := Type"), "refused"), "refused: Type is a Type(1), not a Type")
