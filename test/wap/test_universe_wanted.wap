# the refusals wiki/universe.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "../check.wap"
use "scripted.wap"

check("levels do not include each other", refused_by(ran("box_int", "box(T: Type(1)) := T\nbox(int)")), "refused by argument type")
check("a universe never holds itself", refused_by(ran("type_in_type", "bad: Type := Type")), "refused by value type")
