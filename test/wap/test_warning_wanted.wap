# the forms wiki/warning.md shows that wap does not build yet: each red line is a to-do, fixed by building the form
use "../check.wap"
use "scripted.wap"

careful = written("warn \"careful\"; 1")
check("warn prints a warning and the program runs on", wap_said([careful]), "warning: careful\n1")
check("--warnings=severe shows only severe warnings", wap_said(["--warnings=severe", careful]), "1")
check("--no-hints shows warnings from weak up", wap_said(["--no-hints", written("one plus two")]), "3")
