#!/usr/bin/env warp
# wap, the new compiler: a program's source in, a wasm module out (the plan: notes/backbone.md; the files and their
# owners: notes/agents/wap-owner.md).
#
#   warp wap/compiler.wap hello.wap hello.wasm      compile
#   warp hello.wasm                                  run it
#   warp wap/compiler.wap format hello.wap           print it in canonical warp spelling
#
# Its stages, each with one job and a declared input and output; a form outside a stage's input is refused, naming it:
#   read      text → notation       core/parse/reader.wap
#   operators notation → operated   core/parse/operators.wap, by the table in types/operators.wap
#   shape     operated → surface    core/rules/stages.wap, the rules of kernel/forms.wap, sugar/ and the program
#   declare   operated → declared   core/analyze/declarations.wap, the names the top level defines, as facts
#   declared rules declared → declared  core/rules/declared.wap, rules whose holes ask the declarations
#   lower     declared → kernel     core/rules/lowering.wap, the forms no rule writes yet
#   bind      kernel → bound        core/analyze/scope.wap, what each name refers to, as facts
#   type      bound → typed         core/analyze/types.wap, each value's type and the function each call means, as facts
#   typed rules typed → typed       core/rules/typed.wap, rules with holes of value types, typed again after each round
#   emit      kernel → module       core/emit/emitter.wap, one case per kernel form
#   encode    module → bytes        core/emit/wasm.wap, the wasm binary format (its codes: core/emit/opcodes.wap)
# Every stage runs through one walker, core/stage.wap: a node a stage builds takes the position of the node it rewrote.
# DEBT: A used module's functions are emitted even when nothing calls them (a module's bound statements go first in
#   the program's Block), while the types module's uncalled definitions are left out (bends "smaller and faster"): a
#   module is code whose statements must run, so it joins whole. Paid off when typing leaves out the module
#   definitions nothing calls.
use "core/pipeline.wap"
use "core/parse/operators.wap"
use "core/rules/stages.wap"
use "core/format.wap"
use "core/emit/wasm.wap"
use "core/emit/emitter.wap"
use "core/language.wap"
use "extensions/wasm/modules.wap"
use "extensions/c/functions.wap"
use "extensions/wasm/library.wap"
use "core/stage.wap"
use "core/analyze/types.wap"

language = base_language()
# the extensions this compiler is built with: a compiled module read as the source it stands for; C functions as lib
# writes them
language.readers[".wasm"] = wasm_source
rules_loaded(language, operated_file(language, in_folder(program.folder, C_FUNCTION_RULES)))
if #args < 2 { raise "usage: warp wap/compiler.wap <program> <module.wasm>, or format <program>" }
library = library_file(program.folder, args#1)
types = language_loaded(language, program.folder, library)
# a module: its functions compiled once each and exported, the rest of its code as wap source in its wap section
compiled(file: text) as list := {
	modules = declared_modules(language, file)
	typed = typed_modules(language, modules, types)
	own = modules.last
	travelling = travelling_words(own)
	exported = compiled_once(own, added_records(Records(), statements_in(typed)), travelling)
	m = emitted(library_code(program.folder, file, typed, travelling), file, exported.map(signature => export_key(signature.definer)), raise_module(program.folder, library))
	m.header = header_source(file, own, exported)
	library_stamped(program.folder, file, c_described(m, module_bytes(m)))
}

# (the native `wap` compiles as the native warp does: the program's folder, its lib/ and runtime follow, unread here)
if args#1 == "format" { code = read_notation(language, args#2); words_known(language, code); print formatted(language, groupings_written(language, operated_program(language, code))) } else { write_bytes(args#2, compiled(args#1)) }
