#!/usr/bin/env wap
# wap, the new compiler: a program's source in, a wasm module out (the plan: notes/backbone.md; the files and their
# owners: notes/agents/wap-owner.md).
#
#   wap wap.wasm hello.wap hello.wasm                compile (wap.wasm: this file compiled, as the seed is)
#   wap hello.wasm                                   run it
#   wap format hello.wap                             print it in canonical wap spelling
#   wap wap.wasm optimize hello.wap                  write it again without the functions nothing calls
#
# Its stages, each with one job and a declared input and output; a form outside a stage's input is refused, naming it:
#   read      text → notation       core/parse/reader.wap
#   operators notation → operated   core/parse/operators.wap, by the table in types/operators.wap
#   shape     operated → surface    core/rules/stages.wap, the rules of kernel/forms.wap, sugar/ and the program
#   declare   operated → declared   core/analyze/declarations.wap, the names the top level defines, as facts
#   declared rules declared → declared  core/rules/declared.wap, rules whose holes ask the declarations
#   lower     declared → kernel     core/rules/lowering.wap, the forms no rule writes yet
#   bind      kernel → bound        core/analyze/scope.wap, what each name refers to, as facts
#   type      bound → typed         core/analyze/types.wap, each value's type and the function each call means, as facts
#   typed rules typed → typed       core/rules/typed.wap, rules with holes of value types, typed again after each round
#   emit      kernel → module       core/emit/emitter.wap, one case per kernel form
#   encode    module → bytes        core/emit/wasm.wap, the wasm binary format (its codes: kernel/opcodes.wap)
# Every stage runs through one walker, core/stage.wap: a node a stage builds takes the position of the node it rewrote.
use "core/pipeline.wap"
use "core/parse/cascade.wap"
use "core/parse/atoms.wap"
use "core/analyze/declarations.wap"
use "core/analyze/variables.wap"
use "core/parse/operators.wap"
use "core/rules/stages.wap"
use "core/format.wap"
use "core/emit/wasm.wap"
use "core/emit/emitter.wap"
use "core/emit/functions.wap"
use "core/language.wap"
use "extensions/wasm/modules.wap"
use "extensions/c/functions.wap"
use "extensions/wasm/library.wap"
use "core/stage.wap"
use "core/analyze/types.wap"
use "core/analyze/dispatch.wap"
use "core/bindings.wap"
use "core/paths.wap"
use "extensions/warm.wap"
use "extensions/native/memory.wap"

# the warm state this compiler was built with (extensions/warm.wap): every file it reads before a program, operated
# already, so it reads no source; `--sources` reads them instead, as a compiler built without one does (empty)
WARM_STATE := embedded("warm.packed")
# the library compiled once this compiler was built with (extensions/wasm/library.wap), held so no file can drift from it
LIBRARY := embedded("types.wasm")
SOURCES_OPTION = "--sources"
WARM_COMMAND = "warm"
FORMAT_COMMAND = "format"
CHECK_COMMAND = "check"
OPTIMIZE_COMMAND = "optimize"
NATIVE_COMMAND = "native"
# `laws <program> <module.wasm> [<rules>]`: the program with each law a function wap verify runs
# (extensions/verify_rules.wap), the rules wap verify wrote for its laws with hypotheses loaded too
LAWS_COMMAND = "laws"
LAW_RULES = "extensions/verify_rules.wap"
WAP_EXTENSION = ".wap"
from_sources = #args > 0 and args#1 == SOURCES_OPTION
given = if from_sources then args[1 ..] else args
warm = not from_sources and WARM_STATE != ""

language = base_language()
# the extensions this compiler is built with: a compiled module brought in as its code; C functions as lib writes them
modules_bringable(language)
# a native build reads its own library files (memory.wap files) from the start, the warm state's entries of them too
if given#1 == NATIVE_COMMAND {
	language.build.memory = NATIVE_MEMORY
	placed_files.update(NATIVE_MEMORY.files)
}
if warm { warm_brought(language, program.folder, WARM_STATE) } else { language.build.standard = standard_words(language, program.folder) }
language.build.use_free_modules = USE_FREE_MODULES
rules_files_loaded(language, program.folder)
rules_files_loaded(language, program.folder, if given#1 == LAWS_COMMAND then LAW_RULES else BUILD_RULES)
if given#1 == LAWS_COMMAND and #given > 3 { based(language, given#4) }
if warm { rules_checked(language) }
if #given < 2 { raise "usage: wap <compiler.wasm> [--sources] <program> <module.wasm>, format <program>, optimize <program>, warm <state file>, laws <program> <module.wasm>, or native <program> <module.wasm>" }
# the library a compile reads: the module held where the compiler holds one; the warm state, written for the compiler
# built next, holds the module beside it, the one that compiler holds; from sources, as the compilers bootstrap, and in
# a native build (whose texts are not the GC ones the module holds), the types module's files, operated in the warm state
library_held(program.folder, if given#1 == WARM_COMMAND then read(in_folder(program.folder, LIBRARY_MODULE)) else if from_sources or given#1 == NATIVE_COMMAND then "" else LIBRARY)
library = library_file(program.folder, given#1)
types = types_declared(language, program.folder, library)
# a module: its functions compiled once each and exported, the rest of its code, as read, in its wap section
compiled(file: text, module: text) as list := {
	modules = declared_modules(language, file)
	typed = typed_modules(language, modules, types, file)
	own = modules.last
	exported = compiled_once(own, added_records(Records(), statements_in(typed)))
	m = emitted(typed, file, (exported + library_exports(modules)).map(signature => export_key(signature.definer)), language.build.memory, raise_module(program.folder, library), is_library(program.folder, file))
	carried = library_carried(program.folder, file)
	m.header = module_section(language, file, own, exported, module_exports(m), carried)
	c_described(m, module_bytes(m)) + (if shares_library(m) then library_section(program.folder) else [])
}

# (the native `wap` compiles as the native warp does: the program's folder, its lib/ and runtime follow, unread here)
# `native <program> <module.wasm>`: for a native build (wap/extensions/native/build.sh), each text in the memory
# `format <program>`: the program in canonical warp, each reading typing decided spelled out (core/format.wap); code
# typing refuses, a fragment or data, as it reads, in its own grammar. Without the definitions of the signatures gone
formatted(file: text, gone: list<Signature> = []) as text := {
	try { typed_modules(language, declared_modules(language, file), types, file) } else ø
	code = read_notation(language, file)
	read_in(language, file, () => {
		words_known(language, code)
		statements_text(language, [groupings_written(language, without_definitions(operated_program(language, code, aliases_kept: yes), gone))], Bracket.None)
	})
}
# the program's own functions nothing calls: typed only once called, as a used module's are, typing leaves them out.
# A file of definitions only, a library, has no caller to judge by: none of its functions is uncalled
uncalled(modules: list<Module>) as list<Signature> := {
	if not runs_statements(modules.last.code) { return [] }
	typed = typed_names(modules)
	modules.last.signatures.filter(signature => signature.kind == DefinitionKind.Function and not typed.contains(signature.name))
}
# the functions typing reaches in a program and the modules it uses
typed_names(modules: list<Module>) as list<text> := statements_in(typed_modules(language, modules, types, "")).filter(statement => statement is Define).map(define => text(defined_name(define)))
# a program without the statements defining these signatures, each written where its name is; the others stay, those
# on their lines too
without_definitions(program: Node, gone: list<Signature>) as Node := if gone is empty then program else with_facts_of(List(top_level_statements(program).filter(statement => not gone.any(signature => same_place(statement, signature.definer))), Bracket.None, Separator.Newline), program)
# the functions the other wap files of a file's folder call of it: those typing reaches in each file that uses it
called_beside(file: text) as list<text> := {
	folder = folder_of(file)
	users = list_files(folder).filter(name => name.ends_with(WAP_EXTENSION) and name != file_name(file)).map(name => in_folder(folder, name)).filter(user => used_files(read_notation(language, user)).contains(in_folder(folder, file_name(file))))
	users.flat_map(user => typed_names(declared_modules(language, user)))
}
# `optimize <program>`: the file written again without the functions nothing calls, there or beside it, each said
optimized(file: text) := {
	beside = called_beside(file)
	gone = uncalled(declared_modules(language, file)).filter(signature => not beside.contains(signature.name))
	write(file, formatted(file, gone))
	for signature in gone { print "removed: ${signature.name}" }
}
if given#1 == FORMAT_COMMAND { print formatted(given#2) }
# `check <program>`: the obligations its types leave to the run, a line each (wiki/type.md "Proved or checked")
else if given#1 == CHECK_COMMAND { typed_modules(language, declared_modules(language, given#2), types, given#2); for line in obligations { print line } }
else if given#1 == OPTIMIZE_COMMAND { optimized(given#2) }
else if given#1 == WARM_COMMAND {
	# and the types module's files as a native build reads them, which differ where they include one of its own
	common = language.operated.keys
	placed_files.update(NATIVE_MEMORY.files)
	operated_file(language, in_folder(program.folder, TYPES_FILE))
	for end in NATIVE_MEMORY.files.keys { placed_files.remove(end) }
	write_bytes(given#2, bytes(warm_state(language, program.folder, types, language.operated.keys.filter(file => not (file in common)))))
}
else if given#1 in [NATIVE_COMMAND, LAWS_COMMAND] { write_bytes(given#3, compiled(given#2, given#3)) }
else {
	write_bytes(given#2, compiled(given#1, given#2))
	held_written()
}
