# The bounds of an int's value that compiling knows (kernel/scalars.wap), so a row on ints that stays within the scalars
# runs as its instruction (dispatch.wap row_fitted, terms.wap obligation_entered). Known are: a literal's; a count a
# row of the machine gives, below 2^32 (`#xs`, a text's bytes); a sum, difference or product of known ones; a For
# counter's, from 1 up to its count's (a body cannot name it: a `for i` gives i the counter's value); a local's given a
# value at one place only, the hull of what it is given there in each instance; any value whose subtype's condition
# bounds both ends (type_bounds). Bounds are facts beside the type, never the type: `type of` an int is int (wiki/type.md). The ends are
# combined only where the compiler's own ints hold them on a machine that wraps (the seed's): sums of ends within
# ±2^62, products of ends within ±2^31.
use folder
use "../errors.wap"
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"
use "../../kernel/scalars.wap"

BOUNDS = "bounds"
class Bounds { lo: int; hi: int }
SUMMED_END := 4611686018427387904
FACTOR_END := 2147483648
# the word joining two conditions of a subtype
CONJUNCTION = "and"

# the machine row a definition is, its body a single primitive; ø for any other
row_of(definition: Signature, s: TypingState) as text? := {
	body = match s.defines.get(definition.key) { Define(name, parameters, body) => body; _ => return ø }
	match body { Prim(operation, arguments) => text(operation); _ => ø }
}
# a call of an int function that is a row giving a word of known bounds, those bounds noted
counted_noted(typed: Node, meant: Signature, s: TypingState) as Node := {
	if meant.result != INT_TERM { return typed }
	known = ROW_BOUNDS.get(row_of(meant, s) ?? return typed) ?? return typed
	with_fact(typed, BOUNDS, data_list(known.map(end => Number(end))))
}
# a local given a value at a place, the place kept, so one given a value at one place only has that value's bounds; a
# place typed again (an instance) is the same place, its values each kept, and an assignment without a place counts as
# many
assignment_counted(key: text, value: Node, site: text, s: TypingState) := {
	if site == "" or (s.assigned_at.has(key) and s.assigned_at[key] != site) { s.assigned_at[key] = ø; return }
	s.assigned_at[key] = site
	s.assigned_values[key] = (s.assigned_values.get(key) ?? []) + [value]
}
# the bounds of a typed int's value, ø where compiling knows none; read once typing is done, when every local's
# assignments are found
bounds_of(n: Node, s: TypingState) as Bounds? := match n {
	Number(value) => if value is int then Bounds(value, value) else ø
	Symbol(name) => (if is_bound(n, DefinitionKind.Local) then variable_bounds(place_key(fact_of(n, DEFINED_AT) ?? return ø), s) else ø) ?? type_bounds(value_type(n))
	Call(called, arguments) => noted_bounds(n) ?? row_bounds(n, arguments, s)
	_ => ø
}
noted_bounds(n: Node) as Bounds? := {
	ends = fact_items(n, BOUNDS).map(end => match end { Number(value) => value; _ => 0 })
	if #ends == 2 then Bounds(ends#1, ends#2) else ø
}
# a local's: its one place's values' hull, a For counter's from 1 up to its count's; each found once
variable_bounds(key: text, s: TypingState) as Bounds? := {
	if s.bounds_found.has(key) { return s.bounds_found[key] }
	s.bounds_found[key] = ø
	count = s.counters.get(key)
	found = if count != ø then counter_bounds(bounds_of(count!, s)) else if s.assigned_at.get(key) != ø then hull(s.assigned_values[key].map(value => bounds_of(value, s))) else ø
	s.bounds_found[key] = found
	found
}
# The bounds a value's type gives it, its subtype's condition (a parameter's `n: small`, a finding's narrowing, a
# range's type): each side of an `and` a comparison of `it` with a numeral; ø where it bounds not both ends
type_bounds(type: Term?) as Bounds? := {
	ends = condition_ends(condition_of(subset_condition(type) ?? return ø))
	if ends.lo == ø or ends.hi == ø then ø else Bounds(ends.lo!, ends.hi!)
}
class Ends { lo: int?; hi: int? }
# the ends `it >= 0`, `it < 1000` and their `and` set; a bound on one side of `it`, the numeral on the other
condition_ends(condition: Node) as Ends := match condition {
	Call(called, parts) => {
		if #parts != 2 { return Ends(ø, ø) }
		if text(called) == CONJUNCTION { return joined_ends(condition_ends(parts#1), condition_ends(parts#2)) }
		limit = match parts#2 { Number(value) => if value is int and text(parts#1) == IT_WORD then value else return Ends(ø, ø); _ => return Ends(ø, ø) }
		match text(called) { ">=" => Ends(limit, ø); ">" => Ends(limit + 1, ø); "<=" => Ends(ø, limit); "<" => Ends(ø, limit - 1); _ => Ends(ø, ø) }
	}
	_ => Ends(ø, ø)
}
joined_ends(a: Ends, b: Ends) as Ends := Ends(a.lo ?? b.lo, a.hi ?? b.hi)
# the bounds holding each of these, ø where one is unknown
hull(each: list<Bounds?>) as Bounds? := {
	if each.any(bounds => bounds == ø) { return ø }
	Bounds(min(each.map(bounds => bounds!.lo)), max(each.map(bounds => bounds!.hi)))
}
counter_bounds(count: Bounds?) as Bounds? := if count == ø then ø else Bounds(1, max(1, count!.hi))
# a row on ints' bounds from its operands'
row_bounds(n: Node, arguments: list, s: TypingState) as Bounds? := {
	row = obligation_places(n).map(at => s.obligations#at).find(obligation => obligation.row != ø) ?? return ø
	if #arguments != 2 { return ø }
	a = bounds_of(arguments#1, s) ?? return ø
	b = bounds_of(arguments#2, s) ?? return ø
	match row.row! {
		"i64.add" => if within(a, SUMMED_END) and within(b, SUMMED_END) then Bounds(a.lo + b.lo, a.hi + b.hi) else ø
		"i64.sub" => if within(a, SUMMED_END) and within(b, SUMMED_END) then Bounds(a.lo - b.hi, a.hi - b.lo) else ø
		"i64.mul" => {
			if not within(a, FACTOR_END) or not within(b, FACTOR_END) { return ø }
			ends = [a.lo * b.lo, a.lo * b.hi, a.hi * b.lo, a.hi * b.hi]
			Bounds(min(ends), max(ends))
		}
		_ => ø
	}
}
within(b: Bounds, end: int): bool := b.lo >= 0 - end and b.hi <= end
