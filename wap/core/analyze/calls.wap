# Calls in the typing stage (core/analyze/types.wap): a call's arguments arranged and typed, its definition reached
# and chosen among a name's overloads (core/analyze/overloads.wap), and the function typed for the arguments' types
# (core/analyze/instances.wap); a part read of a typed value; a word called by name.

# DEBT: This file still names two types words, `#` (PLACE_WORD) and `!` (REQUIRED_WORD): typing writes a call of `#`
#   for an item or entry read from a value that is no list (analyze/data.wap) and of `!` where a condition found an
#   optional present (places.wap as_found); `!` has no source spelling to rewrite and a typed hole can't ask for "not a
#   list". Paid off when a typed hole can ask for "not this type" and narrowing marks a found read a types rule
#   rewrites.

use folder
use "../errors.wap"
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"
use "../parse/operator_table.wap"

# the word an item taken by its place calls on a value that is no list, `r#2` is `#(r, 2)`
PLACE_WORD = "#"
# the word that gives a list's item or a map's entry its value, `set(at, of: xs, to: v)`
SET_WORD = "set"
# the word of an optional value known present, `x!` (named required): its value, raising when it is missing
REQUIRED_WORD = "!"
# the fact of a call of a function whose result is not known yet, its body calling itself: what to write instead
RESULT_UNKNOWN = "result_unknown"
# the word making an enum's value the Node of its text where a Node is wanted (nodes.wap), and the case it builds
SYMBOL_WORD = "symbol"
SYMBOL_CASE = "Symbol"

# A call: its arguments typed, each expecting its parameter's written type when only one definition takes that many
# arguments; then the function it means, typed for these argument types
call_typed(n: Node, called: Node, arguments: list, s: TypingState, f: TypeFrame, expected: Node?) as Node := {
	if is_bound(called, DefinitionKind.Case) { return case_call_typed(n, called, arguments, s, f) }
	if called is symbol and text(called) == TYPE_TEST_WORD and fact_of(called, BINDING) == ø { return type_test_typed(n, arguments, s, f) }
	if rest_named(n) != ø { refused(n, "a list's items spread, `...xs`, stand only in a list, `[...xs, 4]`") }
	if holds_value(called) { return value_call_typed(n, called, arguments, s, f, expected) }
	scopes = scoped_definitions(called, s)
	candidates = scopes.flat_map(scope => scope)
	placed = spread_alone(if arguments.any(is_named) then arranged_arguments(n, called, arguments, candidates, s) else arguments, candidates, s)
	by_count = candidates.filter(definition => takes_count(definition, #placed, s))
	receiver = fact_of(called, RECEIVER)
	held = if by_count is empty and receiver != ø then value_type(typed_form(receiver, s, f, ø)) else ø
	if held != ø and candidates.any(definition => takes_count(definition, #placed + 1, s) and same_type(definition.parameters#1 ?? EMPTY_SYMBOL, held)) { return typed_form(refitted(Call(called, [receiver!] + placed), n), s, f, expected) }
	# a word whose parameterless definition gives a function, called with arguments, calls that function: `double := n =>
	# n*2; double(3)`, `root_sum := sum | sqrt` (wiki/charged.md)
	if by_count is empty and candidates.any(definition => takes_count(definition, 0, s)) { return value_call_typed(n, called, arguments, s, f, expected) }
	hints = if #by_count == 1 then by_count#1.parameters.map(type => if has_letters(type, s.records) then ø else type) else (1 to #placed).map(at => result_wanted(placed#at, at, by_count, s))
	given = (1 to #placed).map(at => typed_form(placed#at, s, f, hints#at))
	# an argument that never finishes ends the call there, the code after it never runs: `pick(a, return 7)` is
	# `{ a; return 7 }`
	jumped = (1 to #given).filter(at => jumps(given#at))
	if jumped { return jumping(refitted(Block(given.take(jumped#1)), n)) }
	# a type's own words are innermost, so the program's own Op's text beats the library's Op's in library code too
	own = own_words(called, given, s)
	scopes = [own] + scopes.map(scope => scope.filter(definition => not own.any(word => word.key == definition.key)))
	made = made_from_map(n, called, candidates, given, s)
	if made != ø { return typed_form(made, s, f, expected) }
	call_chosen(n, called, scopes, given, expected, s, f)
}
# A call of the definition chosen among these scopes for typed arguments, each fitted as its parameter takes it, a
# left-out one given its default; a call made without a frame, word_called, types its defaults on their own
call_chosen(n: Node, called: Node, scopes: list, given: list, expected: Node?, s: TypingState, f: TypeFrame?) as Node := {
	meant = chosen_definition(n, called, scopes, given, expected, s)
	taken = arguments_fitted(meant, given, s) + defaults_given(meant, #given, s, f ?? TypeFrame())
	chosen = function_typed(meant, taken.map(argument => value_type(argument)), s, n)
	if f != ø { called_reads(chosen, n, s, f!) }
	result_of(refitted(Call(calling(called, chosen, s), taken), n), chosen)
}
# a list literal given alone where no definition takes one argument, its items the arguments: `no_comma (1, 2)` is
# no_comma(1, 2) (wiki/function.md); a map `{…}` stays one argument
spread_alone(arguments: list, candidates: list<Signature>, s: TypingState) as list := if #arguments != 1 or candidates.any(definition => takes_count(definition, 1, s)) then arguments else match arguments#1 { List(items, bracket, separator) => if bracket == Bracket.Curly then arguments else items; _ => arguments }
# A word with several results gives the one that is wanted (wiki/conversion.md "declared type via as"): an argument
# whose definitions differ by their result, `int(hi())` beside hi() as int and hi() as text, is wanted as the parameter
# type of the outer definition that one of its results is; T(x) of an x that can be a T takes it as a T, int(n: int)
# before int(t: text); ø where no single type is left
result_wanted(argument: Node, at: int, outer: list<Signature>, s: TypingState) as Node? := {
	results = results_written(argument, s)
	if #results < 2 { return ø }
	taking = outer.filter(definition => results.any(result => wants_at(definition, at, result)))
	giving = taking.filter(definition => wants_at(definition, at, definition.result))
	chosen = if #giving == 1 then giving else taking
	if #chosen == 1 then parameter_type_at(chosen#1, at) else ø
}
# whether a definition's parameter at a place is written as this type; no where either is missing
wants_at(definition: Signature, at: int, type: Node?) as bool := {
	wanted = parameter_type_at(definition, at) ?? return no
	type != ø and same_type(type, wanted)
}
# the types an argument may be read as: the results a call's definitions write, of those taking as many arguments; a
# one-character literal a char or a text, a list of them a list of either
results_written(argument: Node, s: TypingState) as list<Node> := match argument {
	List(items, Bracket.Square, separator) => if items is empty then [] else results_written(items#1, s).map(list_type)
	Call(called, parts) => if fact_of(called, CANDIDATES) == ø and fact_of(called, DEFINED_AT) == ø or holds_value(called) then [] else candidate_scopes(called).flat_map(scope => scope).map(definer => definition_at(definer, s)).filter(definition => takes_count(definition, #parts, s)).map(definition => definition.result).compact()
	_ => []
}
parameter_type_at(definition: Signature, at: int) as Node? := if #definition.parameters < at then ø else definition.parameters#at
# A call's arguments with the named ones, `f(b: 1, a: 5)`, put in their parameters' places, a left-out parameter
# given its default: the same places for every definition the name may mean, else refused
arranged_arguments(n: Node, called: Node, arguments: list, candidates: list<Signature>, s: TypingState) as list := {
	arrangements = candidates.map(definition => arranged(definition, arguments, s)).compact()
	if arrangements is empty { refused(n, "no ${called} has parameters of these names: ${candidates_text(candidates, s)}") }
	if arrangements.any(each => each != arrangements#1) { refused(n, "the names put the arguments in different places for ${candidates_text(candidates, s)}; give them in order") }
	arrangements#1
}
# the arguments in a definition's parameter order, ø when a name is none of its parameters or a parameter gets none
arranged(definition: Signature, arguments: list, s: TypingState) as list? := {
	parameters = parameters_in(definition, s)
	positional = arguments.filter(argument => not is_named(argument))
	named = arguments.filter(is_named)
	if #positional > #parameters or not named.all(argument => parameters.drop(#positional).any(parameter => text(declared_name(parameter)) == text(declared_name(argument)))) { return ø }
	placed = positional
	for parameter in parameters.drop(#positional) {
		given = named.filter(argument => text(declared_name(argument)) == text(declared_name(parameter)))
		placed = placed + [if given then named_value(given#1) else if defaulted(parameter) then parameter_default(parameter) else return ø]
	}
	placed
}
named_value(argument: Node) as Node := match argument { Key(name, Op.Colon, value) => value; _ => refused(argument, "a named argument is written name: value") }
# whether a definition takes this many arguments: one for each parameter, those with defaults at the end left out or not
takes_count(definition: Signature, count: int, s: TypingState) as bool := {
	parameters = parameters_in(definition, s)
	count <= #parameters and parameters.drop(count).all(defaulted)
}
defaulted(parameter: Node) as bool := has_fact(parameter, DEFAULT)
# a parameter's default value, `= ø` the fact Empty; a call leaves out only parameters with one (takes_count)
parameter_default(parameter: Node) as Node := fact_of(parameter, DEFAULT) ?? refused(parameter, "a call leaves out this parameter, which has no default")
# the defaults of the parameters a call leaves out, after the given ones, each typed as its parameter's type wants
defaults_given(definition: Signature, count: int, s: TypingState, f: TypeFrame) as list := {
	parameters_in(definition, s).drop(count).map(parameter => typed_form(parameter_default(parameter), s, f, type_given(parameter)))
}
# a map's own word, `m.keys`, beside its entries, `m.name`: a function of that name taking a map alone (wiki/map.md)
map_word(key: Node, s: TypingState) as bool := definitions_named(text(key), s).any(definition => takes_count(definition, 1, s) and takes_map(parameters_in(definition, s)#1))
takes_map(parameter: Node) as bool := {
	type = type_given(parameter) ?? return no
	type_word(type) == MAP_TYPE
}
# A value's part by a text key, `x.f`: a field of x's record type, a hole of x's declared pattern, else a call of the
# function f that takes x alone, `f(x)`; a map's value by its key (core/analyze/data.wap); on an any, the field
# of whichever record holds it (core/analyze/dispatch.wap)
part_typed(n: Node, typed: Node, key: Node, s: TypingState, f: TypeFrame, expected: Node?) as Node := {
	if key_type(value_type(typed)) != ø and not map_word(key, s) { return entry_read_typed(n, typed, key, TEXT_SYMBOL, s, f) }
	reader = if value_type(typed) == ANY_SYMBOL then field_dispatching(key, s) else ø
	if reader != ø { return typed_form(named_call(reader.name, [reader], [typed], n, s), s, f, expected) }
	record = record_named(s.records, value_type(typed))
	field = if record == ø then ø else field_named(record, key)
	if field != ø { return as_found(n, with_type_of(refitted(Get(typed, key), n), declared_type(field)), s, f) }
	part = pattern_part(n, typed, key, s)
	if part != ø { return typed_form(part, s, f, expected) }
	# a word nothing else defines read as its alias's word, `xs.length` count(xs)
	word = if definitions_named(text(key), s) is empty then refitted(symbol(word_aliased(text(key))), key) else key
	named = definitions_named(text(word), s)
	if named is empty { refused(n, "nothing defines ${key}, neither as a function nor as a field of ${value_type(typed) ?? "none"}") }
	# a call of a function only a module this file does not use defines: name that module
	if fact_of(n, WRITTEN_CALL) != ø { refused(n, "${key} is defined in ${named#1.module}, which this file does not use: add use \"${named#1.module}\"") }
	# the value taken as a call takes its argument: converted, `[1, 2].f` boxing the list where f takes any
	call_chosen(n, refitted(symbol(text(key)), n), word_scopes(text(word), s), [typed], expected, s, f)
}
# a value where the type it reads as is wanted, by that type's word: a written character where a text is wanted is
# its text, any other value the call text(c), a range list(r), an atom Node('a')
as_read(n: Node, wanted: Node, s: TypingState) as Node := {
	given = value_type(n)
	# a list whose items read as the wanted list's: a written one item by item, any other by the list word, list(cs)
	if item_type(given) != ø and item_type(wanted) != ø and reads_as(item_type(wanted)!, item_type(given)!, s.records) { return if (match n { List(items, Bracket.Square, separator) => yes; _ => no }) then with_type_of(refitted(with_items(n, items_of(n).map(item => converted(item, item_type(wanted)!, s, item, "the list holds"))), n), wanted) else word_called(n, type_word(wanted), [n], ø, s) }
	read = read_type(given, wanted, s.records) ?? refused(n, "this value reads as no other type")
	if n is Char and read == TEXT_SYMBOL { return char_text(n) }
	# an enum's case where a Node is wanted is the Symbol of its text: `n == int`, `n: Node = TypeWord.int`
	if read == NODE_SYMBOL and not text(given) in ATOM_TYPES { return case_as_node(n, s) }
	word_called(n, type_word(read), [n], ø, s)
}
# a literal case is its Symbol built where it is typed, a constant; any other value of an enum the Symbol of its text
case_as_node(n: Node, s: TypingState) as Node := {
	if not is_bound(n, DefinitionKind.Case) { return word_called(n, SYMBOL_WORD, [word_called(n, TEXT_TYPE, [n], ø, s)], ø, s) }
	spelled = with_type(refitted(Text(case_text(case_declaring(s.records, n))), n), TEXT_TYPE)
	case_typed_as(n, case_bound(symbol(SYMBOL_CASE), NODE_SYMBOL, s), [spelled], s)
}
char_text(character: Node) as Node := with_type(refitted(Text(text(character)), character), TEXT_TYPE)
# a call's typed arguments as their parameters (their letters bound by the call) have them: a char read as its text,
# a plain value boxed for an any or an optional
arguments_fitted(definition: Signature, given: list, s: TypingState) as list := {
	letters = letters_bound(definition, given.map(value_type), s) ?? []
	wanted = definition.parameters.map(type => substituted(type, letters))
	(1 to #given).map(at => as_wanted(given#at, wanted#at, s))
}
# the call of a word with these typed arguments, the definition chosen among all of the word's
word_called(n: Node, word: text, given: list, expected: Node?, s: TypingState) as Node := call_chosen(n, symbol(word), word_scopes(word, s), given, expected, s, ø)
# a word's definitions layer by layer, as a call written at the program's top finds them, the program's hiding the
# library's; then those typing wrote itself
word_scopes(word: text, s: TypingState) as list := {
	layers = (if s.kind_rules == ø then Scope() else s.kind_rules!.scope).layers.map(layer => named_in(Scope([layer]), word).filter(definition => is_function(definition)).map(definition => definition_at(definition.definer, s)))
	with_last_scope(layers.filter(layer => not layer is empty), definitions_named(word, s))
}
# the scopes with the extra definitions none of them holds as a last scope
with_last_scope(scopes: list, extra: list) as list := {
	known = scopes.flat_map(scope => scope).map(definition => definition.key)
	scopes + [extra.filter(definition => not known.contains(definition.key))]
}
# the definitions of functions of this name the typing stage holds
definitions_named(name: text, s: TypingState) as list<Signature> := items_named(s.definition_names, s.definitions, name, definition => definition.name)
# a definition as typing reaches it: shaped, and bound if it is the library's (core/analyze/shapes.wap shaped_once),
# kept in its place so it is shaped once
reached(definition: Signature, s: TypingState) as Signature := {
	if definition.shaped { return definition }
	shaped = shaped_once(definition, s)
	# the key's places indexed up to now, the list grown since included
	items_named(s.definition_keys, s.definitions, definition.key, keyed => keyed.key)
	for place in s.definition_keys.places[definition.key] { s.definitions[place] = shaped }
	shaped
}
# a call's function, or a Get that calls one, marked with the function it calls
calling(called: Node, chosen: TypedFunction, s: TypingState) as Node := with_fact(with_binding(called, DefinitionKind.Function), DEFINED_AT, declared_name(signed_name(chosen, s)))
# a class's maker given one map that none of its definitions takes, `person({name: "Ann"})`: the instance made from it
# field by field (core/analyze/data.wap instance_from_map); ø for any other call
made_from_map(n: Node, called: Node, candidates: list<Signature>, given: list, s: TypingState) as Node? := {
	record = record_named(s.records, called)
	if record == ø or #given != 1 or key_type(value_type(given#1)) == ø or candidates.any(definition => takes_fitting(definition, given, s)) { return ø }
	instance_from_map(n, record, given#1, s)
}
# A type's own words travel with it: the definitions of a called name that the module of an argument's record declares
# taking a value of that record, so a library's `show(xs#at)` finds a program's show(p: P), innermost
own_words(called: Node, given: list, s: TypingState) as list := {
	records = given.map(argument => record_named(s.records, base_or_self(value_type(argument)))).compact()
	definitions_named(text(called), s).filter(definition => records.any(record => definition.module == (file_of(record) ?? "") and definition.parameters.any(type => takes_record(type, record))))
}
takes_record(type: Node?, record: Node) as bool := type != ø and text(base_or_self(type)) == record_name(record)
# the definitions a called name may mean, one list per scope, innermost first: the one it was bound or typed to, else
# its candidates
candidate_scopes(called: Node) as list := if fact_of(called, DEFINED_AT) != ø then [[defined_at(called)]] else match fact_of(called, CANDIDATES) {
	List(scopes, bracket, separator) => scopes.map(scope => match scope { List(items, inner, between) => items; _ => refused(scope, "a name's candidates are a list of definitions") })
	_ => [[defined_at(called)]]
}
# the definitions a called name may mean, scope by scope, innermost first
scoped_definitions(called: Node, s: TypingState) as list := candidate_scopes(called).map(scope => scope.map(definer => definition_at(definer, s)))
# the definition a defining name means: its own, or, for the name of a function typed already (a call typed again),
# the definition that typed function came from, so typing a typed form again changes nothing
definition_at(definer: Node, s: TypingState) as Signature := definition_keyed(place_key(definer), s) ?? definition_keyed(typed_from(place_key(definer), s), s) ?? refused(definer, "the typing stage found no definition here")
typed_from(key: text, s: TypingState) as text := {
	for typed in s.functions { if place_key(declared_name(signed_name(typed, s))) == key { return typed.function.key } }
	""
}
# the one definition of a key, ø when none has it: a key names one definition, so two of one key are refused
definition_keyed(key: text, s: TypingState) as Signature? := {
	keyed = items_named(s.definition_keys, s.definitions, key, definition => definition.key)
	if #keyed > 1 { refused(symbol(key), "two definitions share the key ${key}") }
	if keyed is empty then ø else reached(keyed#1, s)
}

