# Calls in the typing stage (core/analyze/types.wap): which definition a call means, among a name's overloads, by the
# number and types of its arguments and the type expected; and a function typed once for each tuple of argument
# types it is called with, a Define of its own.

# DEBT: This file still names two types words, `#` (PLACE_WORD) and `!` (REQUIRED_WORD): typing writes a call of `#`
#   for an item or entry read from a value that is no list (analyze/data.wap) and of `!` where a condition found an
#   optional present (types.wap as_found); `!` has no source spelling to rewrite and a typed hole can't ask for "not a
#   list". Paid off when a typed hole can ask for "not this type" and narrowing marks a found read a types rule
#   rewrites.

use folder
use "../errors.wap"
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../../kernel/environment.wap"
use "../../kernel/forms.wap"
use "../../kernel/surface.wap"
use "../../kernel/levels.wap"
use "../../kernel/terms.wap"
use "../../kernel/equality.wap"
use "../parse/operator_table.wap"

# the word an item taken by its place calls on a value that is no list, `r#2` is `#(r, 2)`
PLACE_WORD = "#"
# the word that gives a list's item or a map's entry its value, `set(v, of: xs, at: i)`: the value is worked out first, then the subject and the place, as written right to left
SET_WORD = "set"
# the word a class reads its value through where no definition takes the value itself, `get(of: Signal): any`
GETTER_WORD = "get"
# the word of an optional value known present, `x!` (named required): its value, raising when it is missing; with two
# operands, after a function's body, the effects it claims, `f(x) := x * 2 ! Pure` (core/analyze/effects.wap)
REQUIRED_WORD = "!"
# the fact of a call of a function whose result is not known yet, its body calling itself: what to write instead
RESULT_UNKNOWN = "result_unknown"
# the word making an enum's value the Node of its text where a Node is wanted (nodes.wap), and the case it builds
SYMBOL_WORD = "symbol"
SYMBOL_CASE = "Symbol"
# the annotation the class rule writes on a protocol's record (sugar/records.wap)
PROTOCOL_ANNOTATION = "protocol"

# the compiler's answer to a question by one of its own words (stage.wap QUESTION_WORDS): `type of x` the static type
# of x, `effects of f` what f may do (core/analyze/effects.wap)
answered(n: Node, word: text, of: Node, s: TypingState, f: TypeFrame) as Node := if word == TYPE_OF_WORD then type_of_typed(n, of, s, f) else effects_of_typed(n, of, s, f)
# whether a call claims the effects of the body it follows, `x * 2 ! Pure`
claims_effects(called: Node, arguments: list) as bool := text(called) == REQUIRED_WORD and #arguments == 2
# a call at a level written in brackets glued to the function's name, `identity[1](int, 3)` (wiki/universe.md): the
# name, the level its fact; ø for other code, a list's item called among it, `fs[1](3)`
level_written_call(called: Node) as Node? := match called {
	Item(subject, key) => if names_function(subject) and key is number then with_fact(subject, LEVEL_WRITTEN, key) else ø
	_ => ø
}
# a proof's word, `by f` or `refl`, is of the statement wanted, which it makes hold (wiki/proof.md)
proof_typed(n: Node, word: text, expected: Term?) as Node := with_type_of(n, expected ?? refused(n, "${word} proves the statement wanted here: write the statement"))
# A statement in a type's place is the truth it holds, read in this reading of the parameters (wiki/proof.md): in the
# result's, `swap(a: int, b: int): a + b == b + a := …`, what the body proves; in a parameter's, `h: a <= b`, a
# hypothesis, a proof of it; ø for a type
statement_held(written: Node?, typed: TypedFunction, reading: Entering, s: TypingState) as Term? := {
	if not is_statement_written(written) { return ø }
	statement_term(written!, typed, reading, s) ?? refused(written!, "a statement is computed without acting, so a proof can state it")
}
# a statement's proposition where the functions it calls are entered already; while typing, before they are, ø: the
# kernel reads it as it enters the function (terms.wap kernel_result)
statement_term(written: Node, typed: TypedFunction, reading: Entering, s: TypingState) as Term? := proposition_of(TYPES.environment, term_of(typed_form(written, s, reading_frame(typed), BOOL_TERM), reading) ?? return ø)
# A call: its arguments typed, each expecting its parameter's written type when only one definition takes that many
# arguments; then the function it means, typed for these argument types
call_typed(n: Node, called: Node, arguments: list, s: TypingState, f: TypeFrame, expected: Term?) as Node := {
	if is_bound(called, DefinitionKind.Case) { return case_call_typed(n, called, arguments, s, f) }
	if question_word(called, TYPE_TEST_WORD) { return type_test_typed(n, arguments, s, f) }
	if QUESTION_WORDS.any(word => question_word(called, word)) { return answered(n, text(called), arguments#1, s, f) }
	# a proof's `by f, g` is of the statement wanted, which its laws make hold (wiki/proof.md)
	if question_word(called, BY_WORD) { return proof_typed(n, BY_WORD, expected) }
	if claims_effects(called, arguments) { return claim_typed(n, arguments, s, f, expected) }
	if rest_named(n) != ø { refused(n, "a list's items spread, `...xs`, stand only in a list, `[...xs, 4]`") }
	levelled = level_written_call(called)
	if levelled != ø { return call_typed(n, levelled!, arguments, s, f, expected) }
	if holds_value(called) { return value_call_typed(n, called, arguments, s, f, expected) }
	scopes = scoped_definitions(called, s)
	candidates = scopes.flat_map(scope => scope)
	placed = spread_alone(if arguments.any(is_named) then arranged_arguments(n, called, arguments, candidates, s) else arguments, candidates, s)
	by_count = candidates.filter(definition => takes_count(definition, #placed, s))
	# a function's name among arguments no definition takes takes the rest, `sin cos 0` is sin(cos(0)) (wiki/call.md)
	# (a call writing a level gives its arguments as written, the types of letters among them: implicit_typed)
	reading = if fact_of(called, LEVEL_WRITTEN) == ø then nested_read(n, called, placed, candidates, s) else ø
	if reading != ø { hint(warning_of(n, "the parameter counts read it as ${call_shown(reading!)}")); typed_readings[reading_key(called)] = reading!; return typed_form(reading!, s, f, expected) }
	receiver = fact_of(called, RECEIVER)
	held = if by_count is empty and receiver != ø then value_type(typed_form(receiver, s, f, ø)) else ø
	if held != ø and candidates.any(definition => takes_count(definition, #placed + 1, s) and (definition.parameters#1 ?? EMPTY_TERM) == held) { return typed_form(refitted(Call(called, [receiver!] + placed), n), s, f, expected) }
	# a word whose parameterless definition gives a function, called with arguments, calls that function: `double := n =>
	# n*2; double(3)`, `root_sum := sum | sqrt` (wiki/charged.md)
	if by_count is empty and candidates.any(definition => takes_count(definition, 0, s)) { return value_call_typed(n, called, arguments, s, f, expected) }
	hints = if #by_count == 1 then by_count#1.parameters.map(type => if has_letters(type) then ø else type) else (1 to #placed).map(at => result_wanted(placed#at, at, by_count, s))
	given = (1 to #placed).map(at => empty_given(typed_form(placed#at, s, f, hints#at)))
	# an argument that never finishes ends the call there, the code after it never runs: `pick(a, return 7)` is
	# `{ a; return 7 }`
	jumped = (1 to #given).filter(at => jumps(given#at))
	if jumped { return jumping(refitted(Block(given.take(jumped#1)), n)) }
	# a type's own words are innermost, so the program's own Op's text beats the library's Op's in library code too; a
	# compound assignment's own operator before them, `xs += [5]` growing xs in place where a type declares one
	own = own_words(called, given, s)
	scopes = [own] + scopes.map(scope => scope.filter(definition => not own.any(word => word.key == definition.key)))
	if fact_of(n, COMPOUND) != ø { scopes = [definitions_named(text(fact_of(n, COMPOUND)!), s)] + scopes }
	made = made_from_map(n, called, candidates, given, s)
	if made != ø { return typed_form(made, s, f, expected) }
	written = fact_of(called, LEVEL_WRITTEN)
	if written == ø { return call_chosen(n, called, scopes, given, expected, s, f) }
	# the level the call writes is its definitions' level letters' (letters.wap level_letters) while the call chooses
	# among them, and no other call's; where none has a level letter, the brackets read two ways
	if candidates.all(definition => level_names(definition) is empty) { return implicit_typed(n, called, given, written!, candidates, s, f, expected) ?? refused(n, "${called}[${written!}](…) reads as a level written to ${called}, which has no level letter like the u of Sort(u), or as the item of a list ${called}, which is a function: give ${called} a level letter, or write the item's call as (${called}[${written!}])(…)") }
	call_chosen(n, called, scopes, given, expected, s, f, [level_written(written!, 0) ?? refused(written!, "a level is a whole number from 0, Sort(0) Prop")])
}
# A call at a written level giving the types of a definition's letters first, `identity[1](int, 3)` of `identity(a:
# T)`: each letter an implicit parameter `T: Sort(u)` in front (wiki/universe.md), given a type at that level, and the
# call that of the rest with each letter bound to its type; ø where no definition has letters and these arguments
implicit_typed(n: Node, called: Node, given: list, written: Node, candidates: list<Signature>, s: TypingState, f: TypeFrame, expected: Term?) as Node? := {
	level = level_written(written, 0) ?? return ø
	fitting = candidates.filter(one => not letters_written(one) is empty and takes_count(one, #given - #letters_written(one), s))
	if fitting is empty { return ø }
	if #fitting > 1 { refused(n, "${called}[${written}](…) gives the types of the letters of each of ${candidates_text(fitting, s)}; write the arguments' types") }
	definition = fitting#1
	letters = letters_written(definition)
	types = (1 to #letters).map(at => fact_type(fact_of(given#at, DENOTES)) ?? refused(given#at, "${called}[${written}] takes the type of ${letters#at} here, and this is no type"))
	for at in 1 to #letters {
		universe = universe_of(types#at!)
		if not levels_equal(universe_level(universe)!, level) { refused(given#at, "${called}[${written}] takes ${letters#at} at level ${written}, and ${type_text(types#at!)} is a ${type_text(universe)}") }
	}
	call_chosen(n, called, [[definition]], given.drop(#letters), expected, s, f, [], (1 to #letters).map(at => Binding(letters#at, types#at!)))
}
# the letters a definition's parameters write, each once, in the order they first appear
letters_written(definition: Signature) as list<text> := definition.parameters.flat_map(type => letters_in(type)).unique()
# where no definition takes them all, a function's name among the arguments takes the rest, in turn: `print sin cos 0`
# is print(sin(cos(0))) (wiki/call.md), said whole in one note
nested_read(n: Node, called: Node, placed: list, candidates: list<Signature>, s: TypingState) as Node? := {
	at = (1 to #placed - 1).find(at => names_function(placed#at) and candidates.any(definition => takes_count(definition, at, s))) ?? return ø
	rest = refitted(Call(placed#at, placed[at ..]), placed#at)
	if candidates.any(definition => takes_count(definition, #placed, s)) then ø else refitted(Call(called, placed.take(at - 1) + [nested_read(rest, placed#at, placed[at ..], scoped_definitions(placed#at, s).flat_map(scope => scope), s) ?? rest]), n)
}
# the readings typing decided, by the word that leads the code they read: `wap format` prints them (format.wap)
typed_readings: map<text, Node> = {}
reading_key(head: Node) as text := place_of(head) + "${head}"
# a call as it is written with parentheses, `sin(cos(0))`
call_shown(n: Node) as text := match n { Call(called, arguments) => "${called}(${arguments.map(call_shown).join(", ")})"; _ => "${n}" }
# A call of the definition chosen among these scopes for typed arguments, each fitted as its parameter takes it, a
# left-out one given its default; a call made without a frame, word_called, types its defaults on their own
# (the levels the call writes and the types it gives its letters, `identity[1](text, "a")`, are its definitions' only
# while it chooses among them and fits its arguments, never the body's calls: letters.wap letters_bound)
call_chosen(n: Node, called: Node, scopes: list, given: list, expected: Term?, s: TypingState, f: TypeFrame?, levels: list<Level> = [], letters: list<Binding> = []) as Node := {
	s.levels_written[text(called)] = levels
	s.letters_given[text(called)] = letters
	# where no definition takes the arguments, one whose class has a get is read through it, `x > 5` of a signal
	if given.any(argument => got_from(argument, s)) and not (try { chosen_definition(n, called, scopes, given, expected, s); yes } catch e { no }) { given = given.map(argument => got(argument, s)) }
	meant = chosen_definition(n, called, scopes, given, expected, s)
	taken = arguments_fitted(meant, given, s) + defaults_given(meant, #given, s, f ?? TypeFrame())
	s.levels_written.remove(text(called))
	s.letters_given.remove(text(called))
	chosen = function_typed(meant, taken.map(argument => value_type(argument)), s, n)
	if f != ø { called_reads(chosen, n, s, f!) }
	result_of(refitted(Call(calling(called, chosen, s), taken), n), chosen)
}
# whether a value is of a record its class reads through `get(of: Signal)`
got_from(argument: Node, s: TypingState) as bool := record_named(s.records, value_type(argument)) != ø and definitions_named(GETTER_WORD, s).any(definition => #definition.parameters == 1 and (definition.parameters#1 ?? ANY_TERM) == value_type(argument)!)
# a value read through its class's get where it has one, `get(of: x)`, else as it is
got(argument: Node, s: TypingState) as Node := if got_from(argument, s) then word_called(argument, GETTER_WORD, [argument], ø, s) else argument
# a list literal given alone where no definition takes one argument, its items the arguments: `no_comma (1, 2)` is
# no_comma(1, 2) (wiki/function.md); a map `{…}` stays one argument, as does a form, `(Call f 3)`, which is no list
spread_alone(arguments: list, candidates: list<Signature>, s: TypingState) as list := if #arguments != 1 or candidates.any(definition => takes_count(definition, 1, s)) then arguments else match arguments#1 { List(items, bracket, separator) => if bracket == Bracket.Square or bracket == Bracket.Round and separator == Separator.Comma then items else arguments; _ => arguments }
# A word with several results gives the one that is wanted (wiki/conversion.md "declared type via as"): an argument
# whose definitions differ by their result, `int(hi())` beside hi() as int and hi() as text, is wanted as the parameter
# type of the outer definition that one of its results is; T(x) of an x that can be a T takes it as a T, int(n: int)
# before int(t: text); ø where no single type is left
result_wanted(argument: Node, at: int, outer: list<Signature>, s: TypingState) as Term? := {
	# a name of a case of the one enum a definition takes there is that case: `f(red, t)` beside another f, red also a function
	enums = outer.map(definition => parameter_type_at(definition, at)).compact().filter(type => names_function(argument) and case_named(type, argument, s) != ø)
	if #enums == 1 { return enums#1 }
	results = results_written(argument, s)
	if #results < 2 { return ø }
	taking = outer.filter(definition => results.any(result => wants_at(definition, at, result)))
	giving = taking.filter(definition => wants_at(definition, at, definition.result))
	chosen = if #giving == 1 then giving else taking
	if #chosen == 1 then parameter_type_at(chosen#1, at) else ø
}
# the type wanted of a value with several results, where one of them is it: `hi() is int` and `x = hi()` where an int
# is wanted take the int hi(); ø for any other value
result_chosen(value: Node, wanted: Term?, s: TypingState) as Term? := if wanted != ø and results_written(value, s).any(result => result == wanted!) then wanted else ø
# whether a definition's parameter at a place is written as this type; no where either is missing
wants_at(definition: Signature, at: int, type: Term?) as bool := {
	wanted = parameter_type_at(definition, at) ?? return no
	type != ø and type == wanted
}
# the types an argument may be read as: the results a call's definitions write, of those taking as many arguments; a
# one-character literal a char or a text, a list of them a list of either
results_written(argument: Node, s: TypingState) as list<Term> := match argument {
	List(items, Bracket.Square, separator) => if items is empty then [] else results_written(items#1, s).map(list_type)
	Set(place, value) => results_written(value, s)
	Call(called, parts) => if fact_of(called, CANDIDATES) == ø and fact_of(called, DEFINED_AT) == ø or holds_value(called) then [] else scoped_definitions(called, s).flat_map(scope => scope).filter(definition => takes_count(definition, #parts, s)).map(definition => definition.result).compact()
	_ => []
}
parameter_type_at(definition: Signature, at: int) as Term? := if #definition.parameters < at then ø else definition.parameters#at
# A call's arguments with the named ones, `f(b: 1, a: 5)`, put in their parameters' places, a left-out parameter
# given its default: the same places for every definition the name may mean, else refused
arranged_arguments(n: Node, called: Node, arguments: list, candidates: list<Signature>, s: TypingState) as list := {
	arrangements = candidates.map(definition => arranged(definition, arguments, s)).compact()
	if arrangements is empty { refused(n, "no ${called} has parameters of these names: ${candidates_text(candidates, s)}") }
	if arrangements.any(each => each != arrangements#1) { refused(n, "the names put the arguments in different places for ${candidates_text(candidates, s)}; give them in order") }
	arrangements#1
}
# the arguments in a definition's parameter order, or a case's field order, ø when a name is none of its parameters
# or a parameter gets none
arranged(definition: Signature, arguments: list, s: TypingState) as list? := arranged_in(parameters_in(definition, s), arguments)
arranged_in(parameters: list<Node>, arguments: list) as list? := {
	positional = arguments.filter(argument => not is_named(argument))
	named = arguments.filter(is_named)
	if #positional > #parameters or not named.all(argument => parameters.drop(#positional).any(parameter => same_name(parameter, argument))) { return ø }
	placed = positional
	for parameter in parameters.drop(#positional) {
		given = named.filter(argument => same_name(argument, parameter))
		placed += [if given then named_value(given#1) else if defaulted(parameter) then parameter_default(parameter) else return ø]
	}
	placed
}
named_value(argument: Node) as Node := match argument { Key(name, Op.Colon, value) => value; _ => refused(argument, "a named argument is written name: value") }
# whether a definition takes this many arguments: one for each parameter, those with defaults at the end left out or not
takes_count(definition: Signature, count: int, s: TypingState) as bool := {
	parameters = parameters_in(definition, s)
	count <= #parameters and parameters.drop(count).all(defaulted)
}
defaulted(parameter: Node) as bool := has_fact(parameter, DEFAULT)
# a parameter's default value, `= ø` the fact Empty; a call leaves out only parameters with one (takes_count)
parameter_default(parameter: Node) as Node := fact_of(parameter, DEFAULT) ?? refused(parameter, "a call leaves out this parameter, which has no default")
# the defaults of the parameters a call leaves out, after the given ones, each typed as its parameter's type wants
defaults_given(definition: Signature, count: int, s: TypingState, f: TypeFrame) as list := {
	parameters_in(definition, s).drop(count).map(parameter => typed_form(parameter_default(parameter), s, f, type_given(parameter)))
}
# a map's own word, `m.keys`, beside its entries, `m.name`: a function of that name taking a map alone (wiki/map.md)
map_word(key: Node, s: TypingState) as bool := definitions_named(text(key), s).any(definition => takes_count(definition, 1, s) and takes_map(parameters_in(definition, s)#1))
takes_map(parameter: Node) as bool := {
	type = type_given(parameter) ?? return no
	type_word(type) == MAP_TYPE
}
# A value's part by a text key, `x.f`: a field of x's record type, a hole of x's declared pattern, else a call of the
# function f that takes x alone, `f(x)`; a map's value by its key (core/analyze/data.wap); on an any or a union, the
# field of whichever record holds it (core/analyze/dispatch.wap)
part_typed(n: Node, typed: Node, key: Node, s: TypingState, f: TypeFrame, expected: Term?) as Node := {
	if key_type(value_type(typed)) != ø and not map_word(key, s) { return entry_read_typed(n, typed, key, TEXT_TERM, s, f) }
	reader = if value_type(typed) == ANY_TERM or union_field(value_type(typed), key, s) then field_dispatching(key, s) else ø
	if reader != ø { return typed_form(named_call(reader.name, [reader], [typed], n, s), s, f, expected) }
	record = record_named(s.records, value_type(typed))
	field = if record == ø then ø else field_named(record, key)
	if field != ø { return as_found(n, with_type_of(refitted(Get(typed, key), n), written_type(declared_type(field))), s, f) }
	part = pattern_part(n, typed, key, s)
	if part != ø { return typed_form(part, s, f, expected) }
	# a word nothing else defines read as its alias's word, `xs.length` count(xs)
	word = if definitions_named(text(key), s) is empty then refitted(symbol(word_aliased(text(key))), key) else key
	named = definitions_named(text(word), s)
	if named is empty { refused(n, "nothing defines ${key}, neither as a function nor as a field of ${type_text(value_type(typed))}") }
	# a call of a function only a module this file does not use defines: name that module
	if fact_of(n, WRITTEN_CALL) != ø { refused(n, unused_module_said(text(key), named#1.module, file_of(n) ?? ".")) }
	# the value taken as a call takes its argument: converted, `[1, 2].f` boxing the list where f takes any
	call_chosen(n, refitted(symbol(text(key)), n), word_scopes(text(word), s), [typed], expected, s, f)
}
# whether a union has a part whose record holds a field of that name, read as an any's is, the part met at run time
union_field(type: Term?, key: Node, s: TypingState) as bool := is_union(type) and union_parts(type!).any(part => record_named(s.records, part) != ø and field_named(record_named(s.records, part)!, key) != ø)
# a value where the type it reads as is wanted, by that type's word: a written character where a text is wanted is
# its text, any other value the call text(c), a range list(r), an atom Node('a')
as_read(n: Node, wanted: Term, s: TypingState) as Node := {
	given = value_type(n)
	# a list whose items read as the wanted list's: a written one item by item, any other by the list word, list(cs)
	if item_type(given) != ø and item_type(wanted) != ø and reads_as(item_type(wanted)!, item_type(given)!, s.records) { return if (match n { List(items, Bracket.Square, separator) => yes; _ => no }) then with_type_of(refitted(with_items(n, items_of(n).map(item => converted(item, item_type(wanted)!, s, item, "the list holds"))), n), wanted) else word_called(n, type_word(wanted), [n], ø, s) }
	read = read_type(given, wanted, s.records) ?? refused(n, "this value reads as no other type")
	if n is Char and read == TEXT_TERM { return char_text(n) }
	# an enum's case where a Node is wanted is the Symbol of its text: `n == int`, `n: Node = TypeWord.int`
	if read == NODE_TERM and not type_text(given) in ATOM_TYPES { return case_as_node(n, s) }
	word_called(n, type_word(read), [n], ø, s)
}
# a literal case is its Symbol built where it is typed, a constant; any other value of an enum the Symbol of its text
case_as_node(n: Node, s: TypingState) as Node := {
	if not is_bound(n, DefinitionKind.Case) { return word_called(n, SYMBOL_WORD, [word_called(n, TEXT_TYPE, [n], ø, s)], ø, s) }
	spelled = with_type(refitted(Text(case_text(case_declaring(s.records, n))), n), TEXT_TYPE)
	case_typed_as(n, case_bound(symbol(SYMBOL_CASE), NODE_TERM, s), [spelled], s)
}
char_text(character: Node) as Node := with_type(refitted(Text(text(character)), character), TEXT_TYPE)
# a call's typed arguments as their parameters (their letters bound by the call) have them: a char read as its text,
# a plain value boxed for an any or an optional
arguments_fitted(definition: Signature, given: list, s: TypingState) as list := {
	letters = (letters_bound(definition, given.map(value_type), s, denoted_types(given)) ?? NOTHING_CALLED).letters
	wanted = definition.parameters.map(type => substituted(type, letters))
	(1 to #given).map(at => if counted(value_type(given#at), wanted#at) then with_type_of(placed_like(Prim(symbol(COUNTING), [given#at]), given#at), wanted#at) else as_wanted(given#at, wanted#at, s))
}
# the call of a word with these typed arguments, the definition chosen among all of the word's
word_called(n: Node, word: text, given: list, expected: Term?, s: TypingState) as Node := call_chosen(n, symbol(word), word_scopes(word, s), given, expected, s, ø)
# a word's definitions layer by layer, as a call written at the program's top finds them, the program's hiding the
# library's; then those typing wrote itself
word_scopes(word: text, s: TypingState) as list<list<Signature>> := {
	layers = (if s.kind_rules == ø then Scope() else s.kind_rules!.scope).layers.map(layer => named_in(Scope([layer]), word).filter(definition => is_function(definition)).map(definition => definition_at(definition.definer, s)))
	with_last_scope(layers.filter(layer => not layer is empty), definitions_named(word, s))
}
# the scopes with the extra definitions none of them holds as a last scope
with_last_scope(scopes: list, extra: list) as list := {
	known = scopes.flat_map(scope => scope).map(definition => definition.key)
	scopes + [extra.filter(definition => not known.contains(definition.key))]
}
# the definitions of functions of this name the typing stage holds
definitions_named(name: text, s: TypingState) as list<Signature> := items_named(s.definition_names, s.definitions, name, definition => definition.name)
# the definitions of one key the typing stage holds
definitions_keyed(key: text, s: TypingState) as list<Signature> := items_named(s.definition_keys, s.definitions, key, definition => definition.key)
# a definition as typing reaches it: shaped, and bound if it is the library's (core/analyze/shapes.wap shaped_once),
# kept in its place so it is shaped once
reached(definition: Signature, s: TypingState) as Signature := {
	if definition.shaped { return definition }
	shaped = shaped_once(definition, s)
	# the key's places indexed up to now, the list grown since included
	definitions_keyed(definition.key, s)
	for place in s.definition_keys.places[definition.key] { s.definitions[place] = shaped }
	shaped
}
# a call's function, or a Get that calls one, marked with the function it calls
calling(called: Node, chosen: TypedFunction, s: TypingState) as Node := with_fact(with_binding(called, DefinitionKind.Function), DEFINED_AT, declared_name(signed_name(chosen, s)))
# a class's maker given one map that none of its definitions takes, `person({name: "Ann"})`: the instance made from it
# field by field (core/analyze/data.wap instance_from_map); ø for any other call
made_from_map(n: Node, called: Node, candidates: list<Signature>, given: list, s: TypingState) as Node? := {
	record = record_named(s.records, type_term(called))
	if record == ø or #given != 1 or key_type(value_type(given#1)) == ø and value_type(given#1) != ANY_TERM or candidates.any(definition => takes_fitting(definition, given, s)) { return ø }
	instance_from_map(n, record, given#1, s)
}
# A type's own words travel with it: the definitions of a called name that the module of an argument's record declares
# taking a value of that record, so a library's `show(xs#at)` finds a program's show(p: P), innermost
own_words(called: Node, given: list, s: TypingState) as list := {
	records = given.map(argument => record_named(s.records, base_or_self(value_type(argument)))).compact()
	definitions_named(text(called), s).filter(definition => records.any(record => definition.module == (file_of(record) ?? "") and definition.parameters.any(type => takes_record(type, record))))
}
takes_record(type: Term?, record: Node) as bool := type != ø and type_text(base_or_self(type)) == record_name(record)
# the definitions a called name may mean, one list per scope, innermost first: the one it was bound or typed to, else
# its candidates
candidate_scopes(called: Node) as list := if fact_of(called, DEFINED_AT) != ø then [[defined_at(called)]] else match fact_of(called, CANDIDATES) {
	List(scopes, bracket, separator) => scopes.map(scope => match scope { List(items, inner, between) => items; _ => refused(scope, "a name's candidates are a list of definitions") })
	_ => [[defined_at(called)]]
}
# the definitions a called name may mean, scope by scope, innermost first
scoped_definitions(called: Node, s: TypingState) as list<list<Signature>> := candidate_scopes(called).map(scope => scope.map(definer => definition_at(definer, s)))
# the definition a defining name means: its own, or, for the name of a function typed already (a call typed again),
# the definition that typed function came from, so typing a typed form again changes nothing
definition_at(definer: Node, s: TypingState) as Signature := definition_keyed(place_key(definer), s) ?? definition_keyed(typed_from(place_key(definer), s), s) ?? refused(definer, "the typing stage found no definition here")
typed_from(key: text, s: TypingState) as text := {
	for typed in s.functions { if place_key(declared_name(signed_name(typed, s))) == key { return typed.function.key } }
	""
}
# the one definition of a key, ø when none has it: a key names one definition, so two of one key are refused
definition_keyed(key: text, s: TypingState) as Signature? := {
	keyed = definitions_keyed(key, s)
	if #keyed > 1 { refused(symbol(key), "two definitions share the key ${key}") }
	if keyed is empty then ø else reached(keyed#1, s)
}

# The one definition that takes these typed arguments, by their types, then by the type expected; none or several
# refused. A literal that reads both ways fits either: `"!"` a char or a text parameter.
chosen_definition(n: Node, called: Node, scopes: list, given: list, expected: Term?, s: TypingState) as Signature := {
	candidates = scopes.flat_map(scope => scope).map(definition => reached(definition, s))
	# a word called through a type takes only the definitions with a parameter of exactly that type
	owner = text_of(fact_of(called, OWNER))
	if owner != ø { candidates = candidates.filter(definition => definition.parameters.any(parameter => type_text(parameter) == owner!)) }
	types = given.map(argument => value_of(argument, "to pass"))
	dispatcher = dispatching(called, candidates, given, types, s)
	if dispatcher != ø { return dispatcher }
	fitting = candidates.filter(definition => takes_fitting(definition, given, s) and not reads_all_nodes(definition, given, s))
	if #fitting > 1 { fitting = most_specific(fitting, types, s) }
	if #fitting > 1 { fitting = innermost(fitting, scopes) }
	if #fitting > 1 and wants_value(expected) { fitting = fitting.filter(definition => definition.result != ø and (definition.result) == expected!) }
	if fitting is empty {
		lacking = words_missing(candidates, types, s)
		why = if lacking is empty then "no ${called} takes (${types_text(types)}): ${candidates_text(candidates, s)}; define ${called}(${parameters_proposed(types)}) to take them" else lacks_text(lacking, "${called}")
		s.lacked = Lacked(why, lacking)
		refused(n, why)
	}
	if #fitting > 1 { refused(n, "this reads as a call of each of ${candidates_text(fitting, s)}; write the arguments' types or the type wanted") }
	fitting#1
}
# the types the arguments are where they are types, `int` of `identity(int, 3)`; ø for other values
denoted_types(given: list) as list<Term?> := given.map(argument => fact_type(fact_of(argument, DENOTES)))
# whether a definition takes these arguments, each one fitting its parameter
# (a parameter typed by generic letters takes an argument whose type binds them alike, and one of a function type a
# function value whose function gives that type's result for its parameters, see letters_bound); the arguments known
# whole where no letter is wanted are fitted first, so a function value is never typed for a definition that takes
# none of the other arguments (`items.map(item => named(item))` is no map over a Range)
takes(definition: Signature, given: list, s: TypingState, fit: function) as bool := {
	parameters = parameters_in(definition, s)
	if not takes_count(definition, #given, s) { return no }
	plain = (1 to #given).filter(at => not has_letters(definition.parameters#at) and not has_unknowns(value_type(given#at)))
	if not plain.all(at => argument_taken(given#at, parameters#at, NOTHING_CALLED, s, fit)) { return no }
	called = letters_bound(definition, given.map(value_type), s, denoted_types(given)) ?? return no
	(1 to #given).all(at => argument_taken(given#at, parameters#at, called, s, fit))
}
# whether a definition takes these arguments, each one fitting its parameter by fits
takes_fitting(definition: Signature, given: list, s: TypingState) as bool := takes(definition, given, s, (argument, wanted) => fits(argument, wanted, s))
argument_taken(argument: Node, parameter: Node, called: Called, s: TypingState, fit: function) as bool := {
	wanted = substituted(type_given(parameter), called.letters)
	function_parts(wanted) != ø or conforms(value_type(argument), type_given(parameter), s) or fit(with_answers(argument, called.answers), wanted)
}
# an argument of the type the call's answers give it, `xs` of a list<α1> the call settles as a list<int>
with_answers(argument: Node, answers: list<Answer>) as Node := {
	given = value_type(argument) ?? return argument
	type = answered(given, answers)
	if type == given then argument else with_type_of(argument, type)
}
# Among several definitions that fit, the most specific (notes/coc-t3.md "Numbers through the kernel"): one that
# takes these arguments as they are where the other converts one (`text(c: char)` before `text(t: text)` for a char,
# `contains(xs: list<T>, item: T)` before `contains(xs: list<T>, item: T?)` for an item that is no optional); else
# one whose parameter types each convert into the other's and not all of the other's back (`empty(xs: list)` before
# `empty(x: T)`, `==(a: T?, b: T?)` before `==(a: T, b: T)`, a written type before a letter or none); else the
# program's before a rule's; several equally specific are left for the caller to refuse
most_specific(definitions: list<Signature>, types: list, s: TypingState) as list<Signature> := {
	candidates = candidates_of(definitions, types, s)
	candidates.filter(one => not candidates.any(other => more_specific(other, one, s))).map(one => one.definition)
}
# a definition with the places where it converts an argument, its letters as the call binds them
class Candidate { definition: Signature; converted: list<int> }
candidates_of(definitions: list<Signature>, types: list, s: TypingState) as list<Candidate> := definitions.map(definition => {
	called = letters_bound(definition, types, s) ?? NOTHING_CALLED
	Candidate(definition, (1 to #types).filter(at => converted_at(parameter_type_at(definition, at), called, types#at, s)))
})
# an argument converted to its parameter's type: wrapped where the parameter is written as an optional or becomes one
# as the call binds its letters (`==(a: T, b: T)` of a Node? and a Node wraps the Node), else converted to a type
# that writes no letters as bound (an int to a float, an enum's value to a Node)
converted_at(written: Term?, called: Called, given: Term?, s: TypingState) as bool := {
	if wraps(written, given) { return yes }
	wanted = substituted(written, called.letters) ?? return no
	# a function value is typed for a function type, a value for a protocol its type does: neither is converted
	if function_parts(wanted) != ø or protocol_named(s.records, wanted) != ø { return no }
	if has_letters(wanted) or has_unknowns(wanted) then wraps(wanted, given) else conversion(given, wanted, s) != Conversion.Same
}
more_specific(one: Candidate, other: Candidate, s: TypingState) as bool := {
	mine = one.definition.parameters
	theirs = other.definition.parameters
	decided(one.converted.all(at => at in other.converted), other.converted.all(at => at in one.converted)) ?? decided(converts_into(mine, theirs, s), converts_into(theirs, mine, s)) ?? (derived(other.definition, s) > derived(one.definition, s))
}
# what a relation holding one way says: yes where it holds forward only, no where back only, ø where both or neither
decided(forward: bool, back: bool) as bool? := if forward == back then ø else forward
# whether each of these parameter types converts into the other's at its place
converts_into(given: list<Term?>, wanted: list<Term?>, s: TypingState) as bool := #given == #wanted and (1 to #given).all(at => type_converts(given#at, wanted#at, s))
# whether a parameter type converts into another: none takes every type and is taken only by none, a letter and a hole
# take every type, a protocol every written type but not a letter, which takes more; a type that writes letters takes
# those whose parts convert into its parts, read as such where they read so (a Range as a list<int>), an optional the
# type of its value too
type_converts(given: Term?, wanted: Term?, s: TypingState) as bool := {
	if wanted == ø or given == ø { return wanted == ø }
	if is_letter(wanted) or is_unknown(wanted) { return yes }
	if is_letter(given) or is_unknown(given) { return no }
	if protocol_named(s.records, wanted) != ø { return yes }
	if not has_letters(wanted) and not has_unknowns(wanted) { return conversion(given, wanted, s) in STATIC_CONVERSIONS }
	if wraps(wanted, given) { return type_converts(given, base_of_optional(wanted), s) }
	given_parts = type_parts(read_type(given, wanted, s.records) ?? given) ?? return no
	wanted_parts = type_parts(wanted) ?? return no
	#given_parts == #wanted_parts and (1 to #given_parts).all(at => type_converts(given_parts#at, wanted_parts#at, s))
}
# The one ranking of a word's definitions for these argument types, the most specific first, by how many are more
# specific: the static choice takes its first that fits, a dynamic call (core/analyze/dispatch.wap) tests them in
# this order
ranked(definitions: list<Signature>, types: list, s: TypingState) as list<Signature> := {
	candidates = candidates_of(definitions, types, s)
	above = candidates.map(one => #candidates.filter(other => more_specific(other, one, s)))
	(1 to #candidates).sorted(by: at => above#at).map(at => definitions#at)
}
derived(definition: Signature, s: TypingState) as int := if has_fact(defined_name(define_of(definition, s)), DERIVED) then 1 else 0
# of equally specific definitions, those of the innermost scope: a program's `===(a: T, b: T)` hides the library's
innermost(definitions: list<Signature>, scopes: list) as list<Signature> := {
	for scope in scopes {
		inner = definitions.filter(definition => scope.any(candidate => candidate.key == definition.key))
		if inner { return inner }
	}
	definitions
}

# Protocols (wiki/trait.md): a class of required words, members without a body, `class shape { area() }`, its record
# annotated `@protocol` by the class rule (sugar/records.wap), each field a word whose function type takes the protocol
# first. A value fits one when for each word a function of that name takes the value's type first and the word's
# parameters after; a function of a protocol parameter is typed for each type given, so `area(s)` in its body is the
# given type's own area.
protocol_named(records: Records, type: Term?) as Node? := {
	record = record_named(records, type)
	if record == ø or annotation(record, PROTOCOL_ANNOTATION) == ø { return ø }
	record
}
# whether a value of the given type fits the protocol wanted: no protocol wanted, or every word of it done for the type
# DEBT: Protocols fit structurally, by specialisation only: a function of a protocol parameter is typed anew for each
#   type given, so a list of mixed protocol values (run-time dispatch), a protocol's default bodies, `x is shape` and
#   a class's field counting as a word are not there. Paid off by function references in core/emit/ and the typing of
#   defaults here; `map default ListMap` waits for its declaration rule.
conforms(given: Term?, wanted: Term?, s: TypingState) as bool := {
	protocol = protocol_named(s.records, wanted) ?? return no
	if given == ø { return no }
	key = "${type_text(given, yes)} ${type_text(wanted, yes)}"
	if not s.conforming.has(key) { s.conforming[key] = fields_of(protocol).all(word => does_word(given, word, s)) }
	s.conforming[key]
}
# A program adds to a function every program has only where none of its definitions takes these types already
# (wiki/function.md): `+(n: int, t: Ship)` adds one, `round(x)` and `missing(x: int?)` are taken; a function taking a
# class or an enum of the program or a module it uses is its own, a class's maker belongs to the class, a rule's
# function to its form; a module the program uses may replace one (test_modules.sh)
overloads_checked(defined: list<Signature>, declared: list<Signature>, library: list<Signature>, s: TypingState) := {
	words: map<text, list<Signature>> = {}
	for word in library.filter(word => word.kind == DefinitionKind.Function) { words[word.name] = (words.get(word.name) ?? []) + [word] }
	own = declared.filter(signature => signature.kind == DefinitionKind.Record).map(signature => signature.name)
	for signature in defined {
		if signature.kind == DefinitionKind.Function and words.has(signature.name) and not (own.contains(signature.name) or has_fact(signature.definer, DERIVED) or signature.parameters.any(type => mentions_type(type, own))) and words[signature.name].any(word => taken_alike(word, signature, s)) { refused(signature.definer, "${signature.name} is a function every program has, which takes these types already: give this one another name, or take a type the program declares, `${signature.name}(s: Ship) := …`") }
	}
}
# whether two definitions take the same values: as many parameters, a value reaching both of each pair
taken_alike(word: Signature, signature: Signature, s: TypingState) as bool := {
	if #word.parameters != #signature.parameters { return no }
	words = parameters_holed(word, s)
	signatures = parameters_holed(signature, s)
	(1 to #words).all(at => either_takes(words#at, signatures#at, s))
}
# whether a value reaches parameters of both types: one untyped, or one taking the other's values as a call fits them
# (as they are, boxed or wrapped, a letter binding it, a protocol it does)
either_takes(a: Term?, b: Term?, s: TypingState) as bool := a == ø or b == ø or [[a!, b!], [b!, a!]].any(pair => conversion(pair#2, pair#1, s) in STATIC_CONVERSIONS or unified(pair#1, pair#2, [], s) != ø or conforms(pair#2, pair#1, s))
# whether a written type names one of these types, inside list<…>, an optional or a function type too
mentions_type(type: Term?, names: list<text>) as bool := type != ø and (names.contains(type_text(type!)) or (type_parts(type) ?? []).any(part => mentions_type(part, names)))
# the protocol words these types lack for these definitions' protocol parameters, each once
words_missing(definitions: list<Signature>, types: list, s: TypingState) as list<Lack> := {
	lacking = []
	for definition in definitions {
		if #definition.parameters == #types {
			for at in 1 to #types {
				protocol = protocol_named(s.records, definition.parameters#at)
				if protocol != ø { lacking += words_lacking(types#at, protocol, s) }
			}
		}
	}
	lacking.unique
}
# a function named as a protocol is its conversion, `x as shape`, and a class's claim of it, `class square: shape {…}`:
# it takes a typed value whose type does the protocol's words
claim_checked(claim: Signature, s: TypingState) := {
	protocol = if #claim.parameters == 1 then protocol_named(s.records, word_term(claim.name)) else ø
	given = if protocol == ø then ø else claim.parameters#1 ?? refused(claim.definer, "a function named as the protocol ${claim.name} takes a type doing it: `${claim.name}(x: square)`")
	lacking = if given == ø then [] else words_lacking(given!, protocol!, s)
	if lacking is not empty { refused(claim.definer, lacks_text(lacking, claim.name)) }
}
# the required words of a protocol a type does not do
words_lacking(given: Term, protocol: Record, s: TypingState) as list<Lack> := fields_of(protocol).filter(word => not does_word(given, word, s)).map(word => Lack(type_text(given), record_name(protocol), "${declared_name(word)}(${parameters_proposed((1 to parameter_count(word)).map(_ => given))})"))
# the lacking words as wiki/trait.md "Conforming" says what a caller needs, each with the fix-it defining it:
# `dot is not Comparable: < needs compare(a: dot, b: dot); define compare(a: dot, b: dot) := …`
lacks_text(lacking: list<Lack>, caller: text) as text := lacking.map(lack => "${lack.type} is not ${lack.protocol}: ${caller} needs ${lack.word}; define ${lack.word} := …").join("; ")
# the parameters a fix-it proposes for values of these types, `a: dot, b: dot`
parameters_proposed(types: list) as text := (1 to #types).map(at => "${PARAMETER_NAMES#at}: ${type_text(types#at)}").join(", ")
does_word(given: Term, word: Node, s: TypingState) as bool := definitions_named(text(declared_name(word)), s).any(definition => does_as(definition, shaped(given, s), parameter_count(word), s))
# how many parameters a protocol's required word takes, the value's own first
parameter_count(word: Node) as int := #((function_parts(written_type(declared_type(word))) ?? refused(word, "a protocol's word is a function type")).parameters)
# whether a definition takes a value of this type first, then as many parameters as a protocol's word: untyped or a
# letter, it takes every type's, `equals(a: T, b: T)` making every value Equatable
does_as(definition: Signature, given: Term, arity: int, s: TypingState) as bool := {
	types = definition.parameters
	#types == arity and (types#1 == ø or is_letter(types#1!) or shaped(types#1!, s) == given)
}

# whether the Nodes a definition takes, two or more, are all values read as one: values that are no Nodes never meet as
# Nodes, `Side.Left == Grouping.Left` is refused; `n == TypeWord.int` of a Node n compares Nodes, `graded(Grade.pass)`
# reads the case as one
reads_all_nodes(definition: Signature, given: list, s: TypingState) as bool := {
	nodes = (1 to #given).filter(at => parameter_type_at(definition, at) == NODE_TERM)
	#nodes > 1 and nodes.all(at => conversion(value_type(given#at), NODE_TERM, s) == Conversion.Read)
}
# the names a fix-it gives the parameters of a definition it proposes
PARAMETER_NAMES = "abcdefghijklmnopqrstuvwxyz"
# whether an argument fits a parameter, exactly or by a static conversion (core/analyze/fits.wap conversion)
fits(argument: Node, wanted: Term?, s: TypingState) as bool := wanted == ø or conversion(value_type(argument), wanted, s) in STATIC_CONVERSIONS or counted(value_type(argument), wanted)
# the bare words of a kind, which every value of the kind fits (core/analyze/fits.wap bare_fit)
BARE_KINDS = [LIST_TYPE, MAP_TYPE, FUNCTION_WORD, ENUM_TYPE]
# the bare kinds of containers, whose item types a call may leave unknown: all but function
CONTAINER_KINDS = BARE_KINDS.filter(kind => kind != FUNCTION_WORD)
# a kind's bare word, or an optional of one: `list`, `enum?`
names_bare_kind(type: Term?) as bool := {
	word = base_or_self(type)
	word != ø and is_bare_kind(word!)
}
# whether a type is a kind's bare word itself, by its word, never by its spelling: a function value's own type is
# spelled function too
is_bare_kind(type: Term) as bool := BARE_KIND_TERMS.any(kind => type == kind)
BARE_KIND_TERMS = BARE_KINDS.map(kind => core_word(kind))
# the type a refusal asks to write in full: `list<…>` for a bare list, else an example
full_type_hint(written: Term?) as text := if names_bare_kind(written) then type_text(base_or_self(written)) + "<…>" else "int"
# types as a message names them, `int, text?`
candidates_text(definitions: list<Signature>, s: TypingState) as text := definitions.map(definition => "${signature_text(defined_name(define_of(definition, s)), parameters_in(definition, s), definition.result, RESULT_WORD)}, ${written_at(definition, s)}").join("; ")
# where a function is written, as a message names it: `line 18 of equality.wap`
written_at(definition: Signature, s: TypingState) as text := "line ${line_of(define_of(definition, s))} of ${definition.module.split("/").last}"
# a function as a refusal names it, its place telling apart the functions of one name and the function values, each a λ
called_name(definition: Signature, s: TypingState) as text := "${definition.name} (${written_at(definition, s)})"

# a call of a function wap refuses: a library function refused for a word a type lacks says that its caller needs
# it, the program's own call named, `< needs compare(a: dot, b: dot)`; else the call names the function and,
# for the library's, the first reason
callee_refused(at: Node, definition: Signature, refusal: Refusal, library: bool, s: TypingState) := if library and refusal.lacking is not empty then refused(at, lacks_text(refusal.lacking, definition.name)) else calling_refused(at, called_name(definition, s), refusal.first, library)
# A function typed for these argument types, its written types' shapes known first, so it types alike however it is
# reached: from a block, a call, or alone
# It ends alone when wap refuses it: refused once, and each caller is refused naming it
function_typed(definition: Signature, argument_types: list, s: TypingState, at: Node) as TypedFunction := {
	key = definition.key
	library = has_fact(define_of(definition, s), UNBOUND)
	known = s.refusals.find(each => each.key == key)
	if known != ø { callee_refused(at, definition, known!, library, s) }
	before = #s.refusals
	try shaped_typed(shaped_once(definition, s), argument_types, s, at) catch e {
		inner = if #s.refusals > before then s.refusals#(before + 1) else Refusal(key, e.message, e.message, if e.message.contains(s.lacked.why) then s.lacked.lacking else [])
		refusal = Refusal(key, e.message, inner.first, inner.lacking)
		s.refusals += [refusal]
		callee_refused(at, definition, refusal, library, s)
	}
}
# A function typed for these argument types, once per tuple: its parameters, then its body, its result the written
# one, which the body's type fits, or else the body's type. A call inside its own body finds it typed but without a result unless one is written.
# what a function's body and returns give back, all of one type
result_given(body: Node, frame: TypeFrame, name: Node, s: TypingState) as Term? := {
	# a written result is the result, which each returned value fits: `return x` of an int in a function giving int?;
	# else the body's and the returns' types joined as an if's arms are, `return ø` beside a Node a Node?, never any
	finishing = (if jumps(body) then [] else [value_type(body)]) + frame.returns
	joined = joined_all(finishing, s)
	result = frame.result ?? (if joined == ANY_TERM then finishing#1 else joined)
	# `return ø` in a function that gives nothing back is a bare return
	for returned in frame.returns { if not (returned == result or result == ø and returned == EMPTY_TERM or conversion(returned, result, s) in STATIC_CONVERSIONS) { refused(name, "this function gives back values of different types") } }
	result
}
A_DEFINE = "a function's definition is a Define"
shaped_typed(definition: Signature, argument_types: list, s: TypingState, at: Node) as TypedFunction := match define_of(definition, s) { Define(name, parameters, body) => {
	key = definition.key
	called = letters_bound(definition, argument_types, s) ?? NOTHING_CALLED
	settled_by(called.answers, s)
	letters = called.letters
	types = (1 to #argument_types).map(place => parameter_type(definition.parameters#place, answered(argument_types#place ?? refused(at, "an argument reached typing without its type"), called.answers), letters, s.records))
	if (1 to #types).any(place => has_unknowns(types#place) and not takes_any_item(definition.parameters#place)) { return deferred_typed(definition, types, letters, s, at) }
	for typed in instances_of(key, s) {
		if same_instance(typed, key, types, s) {
			# a call of itself before its result is known gives no value; a function giving one is typed again below
			typed.called_unknown = typed.called_unknown or not typed.done and typed.result == ø
			return typed
		}
	}
	typed = TypedFunction(definition, types)
	typed.written = declared_type(name)
	stated = if is_statement_written(typed.written) then statement_term(typed.written!, typed, parameters_reading(typed, {}, s), s) else ø
	written = stated ?? substituted(written_type(typed.written), letters)
	# a bare `list` (or `list?`) written takes the body's own type, as a bare list parameter takes its argument's
	typed.jumps = written == NEVER_TERM
	typed.result = if names_bare_kind(written) or typed.jumps then ø else written
	typed.unknown_result = "a function that calls itself and gives a value needs its full result type: write `${declared_name(name)}(…): ${full_type_hint(written_type(declared_type(name)))} := …`"
	instance_added(typed, s)
	# typed again where its calls of itself took no result, each such call then taking the result its other arms give
	retyping = yes
	while retyping {
		typed.called_unknown = no
		body_typed(typed, definition, name, parameters, body, letters, written, s)
		retyping = typed.called_unknown and valued(typed.result) and not typed.jumps
	}
	typed.done = yes
	typed
}; _ => refused(define_of(definition, s), A_DEFINE) }
# an instance's parameters and body typed, its result the written one, else what the body gives
body_typed(typed: TypedFunction, definition: Signature, name: Node, parameters: Node, body: Node, letters: list<Binding>, written: Term?, s: TypingState) := {
	frame = TypeFrame()
	frame.present = (s.found_in.get(definition.key) ?? []).copy()
	frame.result = typed.result
	frame.letters = letters
	frame.function = declared_name(name)
	frame.typed_function = typed
	typed_parameters = (1 to #typed.arguments).map(at => parameter_typed(items_of(parameters)#at, typed.arguments#at, frame))
	frame.variables += captured_by(define_of(definition, s), typed.arguments)
	enclosing = s.within
	s.within = function_key(define_of(definition, s))
	typed_body = typed_form(body, s, frame, typed.result)
	given = result_given(typed_body, frame, name, s)
	# a written result stays the result, `show(x: any): text := raise(…)`; one that writes none and never returns jumps
	typed.jumps = typed.jumps or written == ø and jumps(typed_body) and frame.returns is empty
	# the body gives the result, the one written or the body's and the returns' types joined: an int beside `return` an int?
	result = written ?? given
	if result != ø and not typed.jumps { typed_body = converted(typed_body, result!, s, body, FUNCTION_GIVES) }
	typed.result = typed.result ?? (if given != ø and given != EMPTY_TERM and base_of_optional(written) != ø then optional_type(given) else given)
	typed.define = refitted(Define(signed_name(typed, s), with_items(parameters, typed_parameters), typed_body), define_of(definition, s))
	typed.late = frame.late
	s.within = enclosing
}
# a call typed by the function it calls: of its result, or jumping when that never returns
result_of(n: Node, chosen: TypedFunction) as Node := if chosen.jumps then jumping(n) else if chosen.result == ø and not chosen.done then with_fact(n, RESULT_UNKNOWN, Text(chosen.unknown_result)) else with_type_of(n, value_bearing(chosen.result))
# A parameter is of its written type, its letters bound, whatever an argument gives: `f(x: int?)` takes 3 and ø as an
# int?; none written, or one that takes its argument's own type, it is of the argument's type
parameter_type(written: Term?, given: Term, letters: list<Binding>, records: Records) as Term := if written == ø or takes_own_type(written, records) then given else type_substituted(written, letters)
# whether a parameter of this written type is typed anew for each type given: a bare `list`, `enum` or `function`,
# which take any list, enum or function value, a function type, whose function values each type it, and a protocol
takes_own_type(written: Term, records: Records) as bool := is_bare_kind(written) or function_parts(written) != ø or protocol_named(records, written) != ø
parameter_typed(parameter: Node, type: Term, frame: TypeFrame) as Node := {
	frame.variables += [Binding(place_key(declared_name(parameter)), type)]
	with_name_fact(parameter, TYPE, type_fact(type))
}
# a typed function's name with its signature, `(int, text) -> int`: its argument types and its result, `()` for no
# parameters or no value known, `never` for one that never returns, as a built-in writes it, which the emitter lays out
signed_name(typed: TypedFunction, s: TypingState) as Node := with_name_fact(written_name(define_of(typed.function, s)), SIGNATURE, type_fact(instance_type(typed)))
instance_type(typed: TypedFunction) as Term := function_type_of(typed.arguments, if typed.jumps then NEVER_TERM else typed.result ?? EMPTY_TERM)

# the parts of a Define, its parameters as a list of none or more
written_name(definition: Define) as Node := match definition { Define(name, parameters, body) => name }
parameters_in(definition: Signature, s: TypingState) as list := match define_of(definition, s) { Define(name, parameters, body) => items_of(parameters) }
# a definition's record as the typing stage holds it, its written types read once
function_of(definition: Define) as Signature := match definition { Define(name, parameters, body) => signature_from(declared_name(name), items_of(parameters), declared_type(name)) }
# whether a definition's parameters all have their types, none a generic letter or a function type, whose function
# values each type it anew: typed even when nothing calls it
all_typed(definition: Signature, records: Records) as bool := definition.parameters.all(type => once_typed(type, records))
# a written type that types its parameter once for every call: none missing, no generic letter, none typed anew
once_typed(type: Term?, records: Records) as bool := type != ø and not has_letters(type) and not takes_own_type(type, records)
# `type of x`: x's static type as a value, x itself never run; a type's type is its universe; a function at a
# written level, `type of identity[1]`, is its definition's type at that level
type_of_typed(n: Node, of: Node, s: TypingState, f: TypeFrame) as Node := {
	levelled = level_written_call(of)
	if levelled != ø { return type_value(levelled_type(levelled!, s) ?? refused(of, "no ${levelled} has the levels ${fact_of(levelled!, LEVEL_WRITTEN)}"), n) }
	type_value(if names_type(of, s) then universe_of(type_term(of)) else value_type(typed_form(of, s, f, ø))!, n)
}
# A definition's type at the level written to its name, `(T: Type) -> T -> T` of `identity[1]` with identity(T:
# Sort(u), a: T): T: each parameter a binder the ones after it may name, each letter no parameter names an implicit
# parameter in front at that level (wiki/universe.md); ø where no definition has as many level letters
levelled_type(called: Node, s: TypingState) as Term? := {
	written = [level_written(fact_of(called, LEVEL_WRITTEN)!, 0) ?? return ø]
	fitting = scoped_definitions(called, s).flat_map(scope => scope).filter(one => #level_names(one) == #written or level_names(one) is empty and not letters_written(one) is empty)
	if fitting is empty { return ø }
	if #fitting > 1 { refused(called, "${called} at a level reads as each of ${candidates_text(fitting, s)}; write the call's arguments") }
	definition = fitting#1
	if definition.parameters.any(type => type == ø) { refused(called, "${called}'s type at a level takes the type of each of its parameters: give each one its type") }
	names = level_names(definition)
	bound = levels_bound(names, written)
	named = parameters_in(definition, s).map(parameter => text(declared_name(parameter)))
	binders = letters_written(definition).filter(letter => not named.has(letter)).map(letter => Binding(letter, universe(written#1))) + (1 to #named).map(at => Binding(named#at, definition.parameters#at!))
	c = checker(TYPES.environment, [])
	variables: list<Term> = []
	for binder in binders {
		variables.add(hypothesis(c, binder.key, type_substituted(binder.type, bound)))
		bound.add(Binding(binder.key, variables.last!))
	}
	closed_over(c, type_substituted(definition.result ?? return ø, bound), variables, no)
}
