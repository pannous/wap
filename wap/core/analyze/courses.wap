# The values below a value, and recursion on any of them (notes/coc-t5c.md T5c2, notes/theory.md "The declarations
# that bind names"): core declares the products, a pair type and a unit type, and from then on each enum that may be
# taken apart into any universe gets two definitions, made from its recursor the first time a recursion asks for them.
# `nat.below(motive, n)` is the type of the motive's values at every value below n, a pair for each recursive field
# and its own values below, ending in Unit; `nat.course(motive, step, n)` is the motive at n, where step makes it
# from n and those values: `nat.below(motive, successor(successor(j)))` computes to
# `Pair(Pair(motive(successor(j)), Pair(Pair(motive(j), …), Unit)), Unit)`, so a recursion may call itself on j there.
# Both are checked by the kernel like any definition.

use "../../kernel/terms.wap"
use "../../kernel/levels.wap"
use "../../kernel/environment.wap"
use "../../kernel/typing.wap"
use "../../kernel/inductive.wap"
use "../../kernel/recursors.wap"

# the products' names, marked `·` so no program's word meets them, and their level parameters, and the suffixes of the
# two definitions' names: `nat·below`, `nat·course`
PAIR_WORD = "·Pair"
UNIT_WORD = "·Unit"
FIRST_LEVEL = "u"
SECOND_LEVEL = "v"
BELOW_SUFFIX := "·below"
COURSE := "·course"
# the binders of course's step and of the values below
STEP := "step"
BELOW_VALUE := "below"

# the products as core declares them, two blocks every environment of a compile holds, under these names:
# `enum Pair(A: Sort(u), B: Sort(v)): Sort(max(1, max(u, v))) { intro(first: A, second: B) }` and
# `enum Unit: Sort(u) { unit }`, each case written over its block's type
products_declared(e: Environment, pair_word: text = PAIR_WORD, unit_word: text = UNIT_WORD) := {
	u = Parameter(FIRST_LEVEL)
	v = Parameter(SECOND_LEVEL)
	sorts = (inner: Term) => pi("A", universe(u), pi("B", universe(v), inner))
	pair_header = sorts(universe(Max(Successor(Zero), Max(u, v))))
	intro = pi(pair_word, pair_header, sorts(pi("first", bound(1), pi("second", bound(1), apply_all(bound(4), [bound(3), bound(2)])))))
	pairs = inductive_declared(e, InductiveBlock([FIRST_LEVEL, SECOND_LEVEL], 2, [BlockType(pair_word, pair_header, [WrittenCase("${pair_word}.intro", intro)])]))
	units = inductive_declared(e, InductiveBlock([FIRST_LEVEL], 0, [BlockType(unit_word, universe(u), [WrittenCase("${unit_word}.unit", pi(unit_word, universe(u), bound(0)))])]))
	pair = pairs.types#1
	unit = units.types#1
	e.products = Products(pair, block_case(pairs, pair, 1), unit, block_case(units, unit, 1))
}

# How a match on a type's values reaches the values below them: through its course, declared with its below the
# first time it is asked for, or without one, and why: the type is no enum of one type taken apart into any universe, or a field holds a function into it. A `below` or `course` the program declared
# itself is refused as a name declared twice
enum Way { Through(course: text), Without(reason: text) }
course_of(e: Environment, type: text): Way := {
	products = e.products!
	name = type + COURSE
	if place(e, name) in e.courses { return Through(name) }
	facts = match (declaration(e, type) ?? return Without("${type} is no enum")).kind {
		Inductive(facts) => facts
		_ => return Without("${type} is no enum")
	}
	if not facts.any_motive { return Without("${type} is taken apart only into Prop") }
	if #facts.block.types != 1 { return Without("${type} is one of several enums that name each other") }
	m = making(e, facts)
	if m.cases#1.any(case => case.inductions.any(induction => induction.binders is not empty)) { return Without("a field of ${type} is a function into it") }
	b = Built(type, m, products, Parameter(MOTIVE_LEVEL), Max(Successor(Zero), Parameter(MOTIVE_LEVEL)))
	major = major_entered(b)
	declared(e, below_made(b, major))
	b.below = constant_of(e, type + BELOW_SUFFIX, m.levels.map(level => Parameter(level)))
	declared(e, course_made(b, major))
	e.courses += [place(e, name)]
	Through(name)
}

# What both are built of: the type, the recursor's binders, the products, the level of the motive's values and the
# level of the pairs, which is never Prop; once it is declared, below at its own levels, which course names
class Built { type: text; m: Making; products: Products; values: Level; pairs: Level; below: Term = PROP }
pair_type(b: Built, first: Level, second: Level, a: Term, c: Term): Term := apply_all(at_levels(b.products.pair, [first, second]), [a, c])
# the unit type at the pairs' level, and its one value
unit_of(b: Built): Term := at_levels(b.products.unit, [b.pairs])
one_of(b: Built): Term := at_levels(b.products.one, [b.pairs])
# a pair of a value of `a` and one of `c`, two types at the pairs' level
pair_made(b: Built, a: Term, c: Term, first: Term, second: Term): Term := apply_all(at_levels(b.products.intro, [b.pairs, b.pairs]), [a, c, first, second])
the_motive(b: Built): Term := b.m.motives#1.variable
motive_at(b: Built, indices: list<Term>, value: Term): Term := motive_applied(b.m, 1, indices, value)
# the type a recursion's step gets at a value: the motive there, and the values below it
course_value_type(b: Built, indices: list<Term>, value: Term): Term := pair_type(b, b.values, b.pairs, motive_at(b, indices, value), below_at(b, indices, value))
below_at(b: Built, indices: list<Term>, value: Term): Term := apply_all(b.below, variables(b.m.parameters) + [the_motive(b)] + indices + [value])
# the type's recursor into the motives given, the type's first and then each container's it nests in (Node's
# list<Node>), applied to the parameters, the minor premises, the indices and the value
recursor_into(b: Built, level: Level, motives: list<Term>, minors: list<Term>, major: Major): Term := {
	levels = [level] + b.m.facts.block.levels.map(name => Parameter(name))
	apply_all(constant_of(b.m.c.environment, recursor_name(b.type), levels), variables(b.m.parameters) + motives + minors + variables(major_binders(major)))
}
# The containers the type nests in carry no values below for it: each container's motive gives one constant type, and
# each of its cases that type's one value, a hypothesis at a field of the type itself of the type the first motive gives
# there; so a recursion reaches the values below only through fields of the type itself
container_motives(b: Built, type: Term): list<Term> := (2 to #b.m.block.types).list().map(at => {
	indices = indices_entered(b.m, at)
	lambdas(indices + [major_local(b.m, at, indices)], type)
})
container_minors(b: Built, own: (Induction) -> Term, type: Term, value: Term): list<Term> := (2 to #b.m.block.types).list().flat_map(at => b.m.cases#at.map(case => lambdas(case.fields + hypotheses_of(b, case, own, type), value)))
# a case's hypotheses, at a field of the type itself of the type own gives, at a container's of the constant one
hypotheses_of(b: Built, case: CaseMade, own: (Induction) -> Term, type: Term): list<Local> := case.inductions.map(induction => entered(b.m.c, INDUCTION, if induction.of == 1 then own(induction) else type))
# the places of a case's hypotheses at fields of the type itself, whose values below it holds
own_places(case: CaseMade): list<int> := (1 to #case.inductions).list().filter(at => case.inductions#at.of == 1)
# the binders a definition takes after the parameters and the motive: the indices and the value
class Major { indices: list<Local>; value: Local }
major_entered(b: Built): Major := {
	indices = indices_entered(b.m, 1)
	Major(indices, entered(b.m.c, MAJOR, type_applied(b.m, 1, variables(indices))))
}
major_binders(major: Major): list<Local> := major.indices + [major.value]
# the definition of a type's below or course: a function of the parameters, the motive, what it takes next, the
# indices and the value
made_of_binders(b: Built, suffix: text, taken: list<Local>, major: Major, type: Term, value: Term): Declaration := {
	binders = b.m.parameters + [b.m.motives#1] + taken + major_binders(major)
	Declaration(b.type + suffix, b.m.levels, contained(b.m, pis(binders, type)), Defined(contained(b.m, lambdas(binders, value))))
}

# `below(parameters, motive, indices, t)`: the recursor into types, each case's minor premise the pairs of its
# recursive fields' motive and their below, its hypothesis
below_made(b: Built, major: Major): Declaration := {
	sort = universe(b.pairs)
	unit = unit_of(b)
	minors = b.m.cases#1.map(case => {
		hypotheses = hypotheses_of(b, case, induction => sort, sort)
		chain = own_places(case).reverse().fold(unit, (rest, at) => {
			induction = case.inductions#at
			pair_type(b, b.pairs, b.pairs, pair_type(b, b.values, b.pairs, motive_at(b, induction.indices, induction.field), hypotheses#at.variable), rest)
		})
		lambdas(case.fields + hypotheses, chain)
	})
	value = recursor_into(b, Successor(b.pairs), [lambdas(major_binders(major), sort)] + container_motives(b, sort), minors + container_minors(b, induction => sort, sort, unit), major)
	made_of_binders(b, BELOW_SUFFIX, [], major, sort, value)
}

# `course(parameters, motive, step, indices, t)`: the first of the recursor's pair of the motive's value and the
# values below, each case's minor premise the step at the case given the values below it, paired with them
course_made(b: Built, major: Major): Declaration := {
	indices = variables(major.indices)
	at = major.value.variable
	values = entered(b.m.c, BELOW_VALUE, below_at(b, indices, at))
	step = entered(b.m.c, STEP, pis(major_binders(major) + [values], motive_at(b, indices, at)))
	unit = unit_of(b)
	own = (induction: Induction) => course_value_type(b, induction.indices, induction.field)
	minors = b.m.cases#1.map(case => {
		hypotheses = hypotheses_of(b, case, own, unit)
		below_value = own_places(case).reverse().fold(Chain(one_of(b), unit), (rest, at) => {
			induction = case.inductions#at
			first = course_value_type(b, induction.indices, induction.field)
			Chain(pair_made(b, first, rest.type, hypotheses#at.variable, rest.value), pair_type(b, b.pairs, b.pairs, first, rest.type))
		})
		made = apply_all(step.variable, case.indices + [case.value, below_value.value])
		pair = apply_all(at_levels(b.products.intro, [b.values, b.pairs]), [motive_at(b, case.indices, case.value), below_at(b, case.indices, case.value), made, below_value.value])
		lambdas(case.fields + hypotheses, pair)
	})
	motives = [lambdas(major_binders(major), course_value_type(b, indices, at))] + container_motives(b, unit)
	value = projection(b.products.pair, 1, recursor_into(b, b.pairs, motives, minors + container_minors(b, own, unit, one_of(b)), major))
	made_of_binders(b, COURSE, [step], major, motive_at(b, indices, at), value)
}
# the values below a case's value, and their type
class Chain { value: Term; type: Term }
