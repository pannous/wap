# The typing of data written as code (notes/backbone.md "Stage languages"): a list's items, an instance's fields and a
# map's entries, each given the type its place wants; called from the typing stage's dispatch (core/analyze/types.wap typed_form).

use folder
use "../errors.wap"
use "../stage.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"
use "../../kernel/surface.wap"

# the counting from 0 that `x[k]` writes, as the place k + 1
PLUS = "+"
# a range as an item key takes the items in it, `xs[1 .. 3]`, `xs[2 ..]`: the types module's slice
SLICE = "slice"
# the function that makes a record's instance from a map, `from_map(person)`, written once for each record
FROM_MAP_WORD = "from_map"

# An instance written as data, `Point{x: 1, y: 2}`: each field of its record given a value of the field's type; its
# type is the record's name
instance_typed(n: Node, head: Node, items: list, separator: Separator, s: TypingState, f: TypeFrame) as Node := {
	record = record_named(s.records, type_term(head)) ?? refused(head, "no class has this name")
	written = items.map(item => field_typed(item, record, s, f))
	# a field left out is given the default its constructor's parameter gives it, `indented: bool = no` (kernel/forms.wap
	# Record: the constructor is a Define); one without is refused
	left = fields_of(record).filter(field => not items.any(item => same_name(item, field)))
	defaults = left.map(field => field_typed(placed_like(Key(declared_name(field), Op.Colon, parameter_default(defaulting(record, field, s) ?? refused(n, "this ${head} gives no value to its field ${declared_name(field)}"))), n), record, s, f))
	given = written + defaults
	with_type_of(refitted(Key(head, Op.None, List(given, Bracket.Curly, separator)), n), record_term(record))
}
# A list in the memory (wap/types/memory_lists.wap), its literal the calls that make it: the reserving word's with room
# for its items, then the step word's for each item in turn, given its arguments, each call of the list's type
built_in_memory(n: Node, words: list<text>, steps: list<list<Node>>, type: Term, s: TypingState, f: TypeFrame) as Node := steps.fold(with_type_of(word_called(n, words#1, [counted(#steps, n, s, f)], ø, s), type), (made, arguments) => with_type_of(word_called(n, words#2, [made] + arguments, ø, s), type))
counted(count: int, at: Node, s: TypingState, f: TypeFrame) as Node := typed_form(placed_like(Number(count), at), s, f, ø)
# how the build lays out and emits the program's values (core/emit/strategy.wap)
strategy_of(s: TypingState) as Strategy := if s.kind_rules == ø then GC_STRATEGY else s.kind_rules!.language.build.strategy
# An instance made from a map, built field by field, each field made into its type (wiki/conversion.md "Made from a
# map"): `person({name: "Ann", age: "40"})` calls the function the typing stage writes once for the record,
# from_map(person)(m) := person{name: text(m["name"]), age: int(m["age"])}, so the map is read once, each field its
# entry, `keys` too
# DEBT: A local named like a method shadows it: a parameter `map` made `fields_of(record).map(...)` call the Node, so
#   the map is named `source` here. Paid off when `xs.map(...)` finds the list's method past a local of that name: the
#   parameter is `map` again.
instance_from_map(n: Node, record: Node, source: Node, s: TypingState) as Node := {
	name = name_once("${FROM_MAP_WORD}(${record_name(record)})", n, s)
	if definitions_named(text(name), s) is empty {
		reads = parameters_of(name, [value_type(source)])
		fields = fields_of(record).map(field => placed_like(Key(declared_name(field), Op.Colon, field_made(field, placed_like(Item(reads#1, Text(text(declared_name(field)))), n), s)), n))
		dispatcher_made(name, reads, placed_like(Key(record_type(record), Op.None, List(fields, Bracket.Curly, Separator.Comma)), n), [record_term(record)], s)
	}
	word_called(n, text(name), [source], record_term(record), s)
}
# a field's value made into the field's type by that type's maker, `int(m["age"])`
field_made(field: Node, value: Node, s: TypingState) as Node := {
	# a field of no written type holds the value as it is, its type the value's
	type = written_type(declared_type(field)) ?? return value
	maker = type_word(type)
	named_call(maker, definitions_named(maker, s), [value], value, s)
}
# the constructor's parameter that gives a field its default, ø when none does
defaulting(record: Node, field: Node, s: TypingState) as Node? := {
	definitions_named(record_name(record), s).flat_map(definition => parameters_in(definition, s)).find(parameter => same_name(parameter, field) and defaulted(parameter))
}
field_typed(item: Node, record: Node, s: TypingState, f: TypeFrame) as Node := match item { Key(name, Op.Colon, value) => {
	field = field_named(record, name) ?? refused(name, "${record_name(record)} has no field of this name")
	typed = typed_form(value, s, f, written_type(declared_type(field)))
	refitted(Key(name, Op.Colon, field_checked(typed, field, value, s)), item)
}; _ => refused(item, NOT_A_FIELD) }

# A list's items, each expected of the item type its place wants; all of one type T, the list is a list<T>, or all
# fitting the item type its place wants, `[1, "a"]` a list<any>. An empty list takes the type its place wants, else an
# unknown item type the first use that adds to it settles.
list_typed(n: Node, items: list, separator: Separator, s: TypingState, f: TypeFrame, expected: Term?) as Node := {
	if items.any(item => rest_named(item) != ø) { return spread_typed(n, items, separator, s, f, expected) }
	# an unknown item type wanted, `xs: list = [1, "a"]`, takes the type the items share rather than the first's
	wanted = if is_unknown(item_type(base_or_self(expected))) then ø else item_type(base_or_self(expected))
	typed = items.map(item => typed_form(item, s, f, wanted))
	item = if items is empty then wanted ?? unknown_type(s) else common_type(typed, wanted, s)
	# items all ø are of an optional the list's uses settle, as a name given only ø holds one: `[ø]` added to a list<int?>
	if item == EMPTY_TERM { item = optional_type(unknown_type(s)) }
	if item == ø or not all_fit(typed, item, s) { refused(n, "a list's items are of one type") }
	values = typed.map(value => read_as(value, item, s))
	words = strategy_of(s).built_by.get("list")
	if words != ø { return built_in_memory(n, words!, values.map(value => [value]), list_type(item), s, f) }
	with_type_of(refitted(List(values, Bracket.Square, separator), n), list_type(item))
}

# A list with the items of other lists spread in it, `[...xs, 4]`: its runs of items as lists, joined with the spread
# lists in order by +
spread_typed(n: Node, items: list, separator: Separator, s: TypingState, f: TypeFrame, expected: Term?) as Node := {
	parts = []
	run = []
	listed = (values: list) => if values then [placed_like(List(values, Bracket.Square, separator), n)] else []
	for item in items {
		spread = rest_named(item)
		if spread == ø { run += [item] } else {
			parts += listed(run) + [spread]
			run = []
		}
	}
	parts += listed(run)
	typed = parts.map(part => typed_form(part, s, f, expected))
	typed[1 ..].fold(typed#1, (joined, part) => word_called(n, PLUS, [joined, part], ø, s))
}
# the type that typed values share: the wanted one when each fits it, else the first of theirs each fits, a char read
# as its text beside texts, `["ab", "c"]` a list<text>; a settled type is tried before one an unknown still holds, so
# `[[1], []]` is a list<list<int>> and settles the empty list's item type
common_type(values: list, wanted: Term?, s: TypingState) as Term? := {
	if wanted != ø and all_fit(values, wanted, s) { return wanted }
	types = values.map(value_type).compact()
	for type in types.filter(type => not has_unknowns(type)) + types.filter(has_unknowns) { if all_fit(values, type, s) { return type } }
	# joined_type gives ø only where a type is missing, and none of these is
	if types is empty then ø else types.drop(1).fold(types#1, (a, b) => joined_type(a, b, s) ?? a)
}
# a value as the type its place holds reads it: a char beside texts its text, a function value where a function type is
read_as(value: Node, type: Term, s: TypingState) as Node := converted(value, type, s, value, "the others are of type")
# each value fits the wanted type, settling the unknowns it holds: `[]` fits list<int>
all_fit(values: list, wanted: Term, s: TypingState) as bool := values.all(value => conversion(value_type(value), wanted, s) in STATIC_CONVERSIONS + [Conversion.Settled, Conversion.Adapted])

# A map written as data, `{yes: 1, no: 0}`: its keys words, so texts, its values each expected of the value type its
# place wants; all of one type V, or all fitting the value type its place wants, the map is a map<text, V>. `{}`
# holds the keys and values its place wants, else text keys and an unknown type its first entry settles, as `[]` does
map_typed(n: Node, items: list, separator: Separator, s: TypingState, f: TypeFrame, expected: Term?) as Node := {
	wanted = held_type(base_or_self(expected))
	typed = items.map(item => entry_typed(item, wanted, s, f))
	values = typed.map(entry_value)
	held = if items is empty then wanted ?? ANY_TERM else common_type(values, wanted, s)
	if held == ø or not all_fit(values, held, s) { refused(n, "a map's values are of one type") }
	read = typed.map(entry => match entry { Key(key, Op.Colon, value) => refitted(Key(key, Op.Colon, read_as(value, held, s)), entry); _ => refused(entry, NOT_AN_ENTRY) })
	keys = if items is empty then key_type(base_or_self(expected)) ?? ANY_TERM else TEXT_TERM
	words = strategy_of(s).built_by.get("map")
	if words != ø { return built_in_memory(n, words!, read.map(entry_parts), map_type(keys, held), s, f) }
	with_type_of(refitted(List(read, Bracket.Curly, separator), n), map_type(keys, held))
}
entry_typed(entry: Node, expected: Term?, s: TypingState, f: TypeFrame) as Node := match entry { Key(key, Op.Colon, value) => refitted(Key(entry_key(key, s, f), Op.Colon, typed_form(value, s, f, expected)), entry); _ => refused(entry, NOT_AN_ENTRY) }
# a map's key: a text, a word its spelling, any other key the text it gives, `'a'` a text too
entry_key(key: Node, s: TypingState, f: TypeFrame) as Node := {
	typed = typed_form(if key is symbol then placed_like(Text(text(key)), key) else key, s, f, TEXT_TERM)
	if not fits_type(typed, TEXT_TERM) { refused(key, "a map's keys are words or texts") }
	typed
}
entry_value(entry: Key) as Node := match entry { Key(key, op, value) => value }
entry_parts(entry: Key) as list<Node> := match entry { Key(key, op, value) => [key, value] }
# a map's value by its key, `m["a"]` or `m.a`: the types module's `#` of the map and the key, typed as the map's keys
entry_read_typed(n: Node, map: Node, key: Node, key_type: Term, s: TypingState, f: TypeFrame) as Node := {
	word_called(n, PLACE_WORD, [map, typed_form(key, s, f, key_type)], ø, s)
}

# A list's item by its place, `xs#i`, an int counting from 1: of the list's item type; on a value that is no list,
# the call `#(x, i)`, as a Range answers it
get_typed(n: Node, held: Node, key: Node, s: TypingState, f: TypeFrame) as Node := as_found(n, item_got(n, held, typed_form(key, s, f, INT_TERM), s), s, f)
# the item of a typed subject at a typed place: the call of `#` its type defines, a list's, a range's, a text's
item_got(n: Node, held: Node, place: Node, s: TypingState) as Node := word_called(n, PLACE_WORD, [held, place], ø, s)

# `x[k]` by the subject's type: a map's entry of that key, else the item counted from 0, at place k + 1 (a list's or a
# text's, or what the type's own `#` gives); an any's by its key's type
item_typed(n: Node, subject: Node, key: Node, s: TypingState, f: TypeFrame) as Node := {
	held = typed_form(subject, s, f, ø)
	map_key = key_type(value_type(held))
	if map_key != ø { return entry_read_typed(n, held, key, map_key, s, f) }
	range = typed_form(key, s, f, ø)
	if fits_type(range, RANGE_TERM) { return word_called(n, SLICE, [held, range], ø, s) }
	# a key that is no number reaches the subject's own # as written: `store["a"]` is #(store, "a"), an any's the entry of
	# that key, chosen when the program runs
	if not fits_type(range, INT_TERM) { return word_called(n, PLACE_WORD, [held, range], ø, s) }
	one = with_type(placed_like(Number(1), key), INT_TYPE)
	item_got(n, held, word_called(key, PLUS, [typed_form(key, s, f, INT_TERM), one], ø, s), s)
}
