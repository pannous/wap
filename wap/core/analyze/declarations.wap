# The declaration prescan: surface → declared (notes/backbone.md "Stage languages").
#
# Before any phrase is decided (it reads operated code), the program's interface is known: the names its top level defines, each with its
# signature. Signature rules (stage 2) ask it (`$f takes value`), a phrase is read by it (`print x` is a call because
# print is a function), and so does a module that `use`s this one. It learns facts only, the program keeps its shape:
#   declares        on each top-level definition: name: signature
#   declarations    on the program: the list of them, in the order written
#   uses            on the program: the files its `use "path"` statements name, the path taken from its own folder
#
#   x := 3                  x: ø               a value
#   f(a: int, b) := a       f: [a: int, b]     a function and its parameters, as written
#   g() := 1                g: []              a function of no parameters
#   n := 1                  n: []              a constant, a function of no parameters as the kernel reads it
#
# Only the top level declares: names inside a function belong to its scopes, which the binding analysis resolves
# (core/analyze/scope.wap). A statement that defines nothing declares nothing.

use "../errors.wap"
use "../rules/lowering.wap"
use "../stage.wap"
use "../bindings.wap"
use "definers.wap"
use "../../kernel/forms.wap"
use "../../kernel/surface.wap"
use "../parse/cascade.wap"

use "../paths.wap"
use "../type_notation.wap"

USE_WORD = "use"
INCLUDE_WORD = "include"
EXPORT_WORD = "export"
# on a program, the names it defines with `export`, each a Text (a used module's, the program exports them too)
EXPORTS = "exports"
# `use folder`: the source files beside the using file, by their endings; `use name`: the module of that name beside
# the using file, else in the standard library's folder beside the compiler, its source, else the module compiled from
# it (a seed folder holds no source)
FOLDER_WORD = "folder"
SOURCE_ENDINGS = [".wap", ".warp"]
MODULE_ENDINGS = SOURCE_ENDINGS + [".wasm"]
# the scopes wiki/use.md names that are not built yet
UNBUILT_SCOPES = ["package", "project"]
# what a top-level statement that declares nothing is told
NO_DECLARATION = "a module declares a name with its signature, or a type"

declared_program(written: Node) as Node := {
	program = refitted(rebuilt_statements(written, top_level_statements(written).map(statement => unexported(statement) ?? statement)), written)
	ids = definers_of(program)
	statements = top_level_statements(program).map(statement => names_identified(statement, ids))
	declared = with_fact(refitted(rebuilt_statements(program, statements), program), EXPORTS, data_list(exported_names(written)))
	with_definers(with_fact(declared, USES, data_list(used_files(program).map(file => Text(file)))), ids)
}
# `export f(…) := …`: the definition, which a program using its module exports too, under its plain name (wiki
# keyword.md); ø for any other statement
unexported(statement: Node) as Node? := match statement {
	Call(called, arguments) => if text(called) == ":=" then refitted(Call(called, [export_stripped(arguments#1) ?? return ø, arguments#2]), statement) else ø
	_ => ø
}
export_stripped(head: Node) as Node? := match head {
	List(items, Bracket.None, Separator.Space) => if #items == 2 and items#1 == symbol(EXPORT_WORD) then items#2 else ø
	Key(left, op, right) => Key(export_stripped(left) ?? return ø, op, right)
	_ => ø
}
exported_names(program: Node) as list<Node> := top_level_statements(program).map(unexported).filter(statement => statement != ø).map(statement => Text(text(declaration_name(declaration_of(statement!)!))))
# the files a program's `use` lines name, each once however often named, resolved against its own folder: plain
# notation, readable before any stage
used_files(program: Node) as list := files_named(program, USE_WORD).unique
# the files a program's statements `word "path"` name, in order, each resolved against the folder of its statement
files_named(program: Node, word: text) as list<text> := {
	files = []
	for statement in top_level_statements(program) {
		file = file_of(statement) ?? file_of(program) ?? "."
		named = phrase_part(statement, word)
		if named is text { files += [beside(file, text(named))] }
		if named is symbol { files += words_named(text(named), statement, file) }
	}
	files
}
# the files a word after `use` names: `use folder` every source file beside the using one, `use os` the module os
words_named(word: text, statement: Node, file: text) as list<text> := {
	if UNBUILT_SCOPES.contains(word) { refused(statement, "use ${word} is not built yet: write use folder, or use \"path\"") }
	if word == FOLDER_WORD then folder_sources(file) else [module_named(word, statement, file)]
}
# every source file beside a file, by name, that file and hidden ones left out (wiki/use.md "folder, package and
# project scope"); a file of inline code stands in the working folder
folder_sources(file: text) as list<text> := names_beside(file).filter(name => not name.starts_with(".") and SOURCE_ENDINGS.any(ending => name.ends_with(ending))).map(name => beside(file, name)).filter(source => source != normalized_path(file))
# the module a bare name names, `use os`: os.wap, else os.warp, beside the using file, else in the standard library
# beside the compiler or a folder right in it (wiki/use.md "Library folders"), a name found in two of those refused
module_named(name: text, statement: Node, file: text) as text := {
	found = modules_found(name, file)
	library = library_of(program.folder)
	if #found != 1 { refused(statement, if not exists(library) then "no standard library: no folder ${LIBRARY_FOLDER} beside ${program.folder} or above it" else if found is empty then "no module ${name}: neither ${name}.wap nor ${name}.warp beside the program or in ${library} and its folders" else "two modules ${name}: ${found.join(" and ")}; use one by its path") }
	found#1
}
# the modules `use name` could mean from a file, the nearest place holding one
modules_found(name: text, file: text) as list<text> := {
	beside = sources_named(name, folder_of(file))
	if beside is not empty { return [beside#1] }
	library = library_of(program.folder)
	# the library's own modules first, its folders only for a name it has none of (wiki/use.md "Library folders")
	at_root = sources_named(name, library)
	if at_root is not empty { return [at_root#1] }
	listed_in(library).filter(entry => not entry.contains(".")).flat_map(entry => sources_named(name, library + "/" + entry))
}
# the modules of that name in a folder, the first ending first; of the names listed in it, when they are known
sources_named(name: text, folder: text) as list<text> := named_in(name, folder, listed_in(folder))
named_in(name: text, folder: text, listed: list<text>) as list<text> := MODULE_ENDINGS.filter(ending => listed.contains(name + ending)).map(ending => normalized_path(folder + "/" + name + ending)).take(1)

# `use "path"`: a statement that brings in a module, no code
is_use(statement: Node) as bool := phrase_part(statement, USE_WORD) != ø
# whether code runs a statement of its own, beside its declarations and uses: a file that runs none is a library
runs_statements(code: Node) as bool := top_level_statements(code).any(statement => declaration_of(statement) == ø and not is_use(statement))
# what follows the word of a phrase `word "text"` or `word name`: a use's path or name, an include's path, a rule's
# refusal; ø for any other code
phrase_part(phrase: Node, word: text) as Node? := match phrase {
	List(items, Bracket.None, Separator.Space) => if #items == 2 and items#1 == symbol(word) and (items#2 is text or items#2 is symbol) then items#2 else ø
	_ => ø
}
phrase_text(phrase: Node, word: text) as text? := if phrase_part(phrase, word) is text then text(phrase_part(phrase, word)!) else ø
# the files a declared program uses, in the order written
uses_of(program: Node) as list<text> := fact_items(program, USES).map(item => text(item))

# The modules a program uses, each file read once by read_file (text to operated code), the modules they use too,
# every module after the ones it uses, so their rules are loaded before it is shaped. Modules may use each other: a
# cycle is cut where it closes, so of two such modules the one reached first runs last, and a statement of the other
# reading its value, itself or through a function, is refused as any read before a value is (core/analyze/types.wap).
class Reached { codes: list<Node>; files: list<text> }
modules_used(program: Node, read_file: function) as list<Node> := {
	reached = Reached([], [normalized_path(file_of(program) ?? ".")])
	modules_reached(program, read_file, reached)
	reached.codes
}
modules_reached(code: Node, read_file: function, reached: Reached) := {
	for file in used_files(code) {
		if not reached.files.contains(file) {
			reached.files += [file]
			module = read_file(file)
			modules_reached(module, read_file, reached)
			reached.codes += [module]
		}
	}
}
# A declared module: its file, its code, the files its `use` lines name and the records of what it declares; the words
# of standard modules it names without their `use`, which alone it sees of them (core/pipeline.wap standard_brought)
class Module { file: text; code: Node; uses: list<text>; signatures: list<Signature> = []; named: list<Node> = [] }
# a declared program as a module
module_declared(code: Node) as Module := Module(file_of(code) ?? "", code, uses_of(code), signatures_of(code))

# the record of what a top-level statement declares: a function `f(a, b) := …`, a value `x = 1`, a class or an enum
signature_declared(declaration: Node) as Signature := match declaration {
	Record(name, fields, variants) => Signature(text(name), place_key(name), DefinitionKind.Record, name, module: file_of(name) ?? "", record: fields_once(declaration))
	Key(name, Op.Colon, parts) => if declares_function(declaration) then signature_from(name, declared_parameters(declaration), declared_result(declaration)) else Signature(text(name), place_key(name), DefinitionKind.Global, name, module: file_of(name) ?? "")
	_ => refused(declaration, NO_DECLARATION)
}
# a record names each field once, wherever its fields come from: `class B extends A { x: text }` where A has x
fields_once(record: Node) as Node := {
	for field in fields_of(record) {
		twins = fields_of(record).filter(other => same_name(other, field))
		if #twins > 1 { refused(twins#2, "${record_declared(record)} has the field ${declared_name(field)} twice, ${twins.map(twin => "`${twin}`").join(" and ")}: rename or drop one") }
	}
	record
}
# the records of what a declared program's top level declares, in the order written
signatures_of(program: Node) as list<Signature> := top_level_statements(program).map(statement => declaration_of(statement)).filter(declaration => declaration != ø).map(declaration => signature_declared(declaration!))
# whether a record is a function's
is_function(signature: Signature) as bool := signature.kind == DefinitionKind.Function
is_value(signature: Signature) as bool := signature.kind == DefinitionKind.Global
# the top-level statement of a program that defines what a record describes
defining_statement(program: Node, signature: Signature) as Node? := top_level_statements(program).find(statement => declaration_of(statement) != ø and place_key(declaration_name(declaration_of(statement)!)) == signature.key)
# the name a declaration declares
declaration_name(declaration: Node) as Node := match declaration {
	Key(name, Op.Colon, signature) => name
	Record(name, fields, variants) => name
	_ => refused(declaration, NO_DECLARATION)
}
# the module of that file among the declared ones; a used file of no code, a compiled module exporting no function,
# declares nothing
module_of(file: text, modules: list<Module>) as Module := modules.find(module => module.file == file) ?? Module(file, Empty, [])


# name: signature of a definition, ø of any other statement: `f(a, b) := …`, `n := 1`, `x = 1` as operated code reads
# them, (Call := f(a, b) …), (Call = x 1); a class or an enum declares itself, its cases as lowering writes them
declaration_of(statement: Node) as Node? := match statement {
	Record(name, fields, variants) => with_facts_of(Record(name, fields, cases_lowered(variants)), statement)
	Call(called, arguments) => if text(called) == ":=" then type_named(signature_of(arguments#1) ?? return ø, arguments#2) else if text(called) == "=" then value_named(arguments#1) else ø
	_ => ø
}
# a definition giving a type, `nat: Type := int where it >= 0` (sugar/definitions.wap `type nat = …`): its name holds
# the type, which a type written by that name is (analyze/scope.wap type_bound)
type_named(signature: Node, body: Node) as Node := match signature {
	Key(name, op, parts) => if universe_written(fact_of(signature, WRITTEN_RESULT) ?? return signature) == ø then signature else with_facts_of(Key(with_fact(name, TYPE_NAMED, type_named_value(parts, body)), op, parts), signature)
	_ => signature
}
# what a type's name holds: the type, or for a name with parameters, `vector(T, n: nat)`, the function of them whose
# body each use writes its arguments into (analyze/scope.wap applied_type)
type_named_value(parameters: Node, body: Node) as Node := if items_of(parameters) is empty then body else Fn(parameters, body)
# a Record's cases as lowering writes them, each case's fields as written, `Run(f: (int) -> int)` a function type
cases_lowered(variants: Node) as Node := match variants { List(cases, bracket, separator) => List(cases.map(case_lowered), bracket, separator); _ => variants }
# an enum's case as lowering writes it: `Leaf(value: int)` a call of its name with its fields, `Empty = "ø"` its name
# keeping its spelling, a bare name as it is
case_lowered(case: Node) as Node := match case {
	Key(name, Op.None, group) => Call(name, arguments_of(group))
	# GUESS (T6a3's indices): a case written with the type it gives, `step(k: nat): Even(k + 2)`, lowers its shape (stage.wap case_shape)
	Key(shape, Op.Colon, result) => if is_spelling(result) then with_fact(shape, SPELLING, result) else Key(case_lowered(shape), Op.Colon, result)
	_ => case
}
# what `f(a, b)` or `n` before := declares: a function with its parameters, or a value, with the result type written
# after `:` or `as` (`f(a): bool`, `f(a) as bool`, one form here) as its fact WRITTEN_RESULT
signature_of(head: Node) as Node? := match head {
	Key(name, Op.Colon, type) => with_fact(signature_of(name) ?? return ø, WRITTEN_RESULT, type)
	Key(name, Op.None, group) => match name { Symbol(word) => Key(name, Op.Colon, data_list(arguments_of(group))); _ => ø }
	Symbol(name) => Key(head, Op.Colon, data_list([]))
	_ => ø
}
WRITTEN_RESULT = "written result"
# on a definition's name, the type it gives, where it gives a type: `nat: Type := int where it >= 0`
TYPE_NAMED = "type named"
# a declaration's parameters as written, none of a value's; its written result type, ø where none is written
declared_parameters(declaration: Node) as list<Node> := match declaration { Key(name, Op.Colon, List(items, bracket, separator)) => items; _ => [] }
declared_result(declaration: Node) as Node? := fact_of(declaration, WRITTEN_RESULT)
# whether a declaration is a function's, `f() :=` too, not a value's
declares_function(declaration: Node) as bool := match declaration { Key(name, Op.Colon, List(items, bracket, separator)) => yes; _ => no }
# the value a name before = declares, also of `let x` and `global x`
value_named(place: Node) as Node? := match place {
	Symbol(name) => Key(place, Op.Colon, Empty)
	List(items, Bracket.None, Separator.Space) => if #items == 2 then value_named(items#2) else ø
	Key(name, Op.Colon, type) => value_named(name)
	Variable(name, kind) => value_named(name)
	_ => ø
}

# the program put back from its statements (kernel/forms.wap top_level_statements)
rebuilt_statements(program: Node, statements: list) as Node := match program {
	List(items, Bracket.None, separator) => if is_run(separator) then List(statements, Bracket.None, separator) else statements#1
	_ => statements#1
}
