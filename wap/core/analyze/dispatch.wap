# Calls on dynamic values (notes/first_principles.md "dynamic where we can't infer the type"): code the typing stage
# writes once, as ordinary code, a dispatching function, where a value is an any (or a number, an int or a float).
# - A call whose arguments hold such a value, where a definition of its word wants another type there (from the static
#   choice, core/analyze/calls.wap chosen_definition): a chain of `is` tests over the definitions in the one ranking
#   the static choice uses, most specific first, each passing the tested values on as their types (core/analyze/
#   conditions.wap found); then the definition that takes the values as they are, else a raise naming the word.
# - A field read on an any, `xs#1.name` (calls.wap part_typed): a chain of `is` tests over the records that have the
#   field, in the order they are declared, each reading its field, else a raise.

use folder
use "../errors.wap"
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"
use "../../kernel/primitives.wap"
use "../../kernel/scalars.wap"

# the name of a dispatching function's parameters, numbered: x1, x2 …
PARAMETER_WORD = "x"
RAISE_WORD = "raise"
# a field read's dispatching function is named after the field, `.name(any)`, apart from a function of that name
FIELD_MARK = "."
# the function that narrows a value to a shape is named after it, `narrowed(Record)`
NARROWING_WORD = "narrowed"
UNFAILED_WORD = "unfailed"
# the obligations left to the run, as `wap check` lists them (wiki/type.md "Proved or checked"): the warning line, the
# argument and the type it must fit, and the key of the function it sits in, ø at the top level. An obligation is a law of
# that function: for every value of its parameters the condition holds of the argument. Its statement, `function_type`
# and `value` (the function of the parameters giving the condition at the argument), is entered with the functions
# (core/analyze/terms.wap obligations_entered); ø where the argument or the type has no kernel term. A proof a call
# leaves to the provers, its `by` at the place of a parameter's statement, is one too: the call and the place, no
# argument or type, its statement the kernel's goal there (core/analyze/calls.wap
# proofs_held). `check` is the code that checks it when the program runs, ø for one only a proof decides. `verdict` is
# its condition computed while compiling, yes or no, ø where it does not compute (terms.wap obligation_entered); `choice`
# the place among a dispatcher's choices of the definition it tests for (types.wap decided_code), CHOICE_UNDECIDED for a
# dispatcher's the placing does not decide, 0 for a narrowing's, which alone a no refuses. `compared` is the other type of
# an `==` of two type values, `type` the first (terms.wap comparison_decided); `reads` the reads of the variables its
# condition reads, as the narrowing passes them (terms.wap condition_reads). `row` is the machine row an int's sum,
# difference or product is, its obligation to give a scalar (row_fitted), `folded` its value where compiling
# computed it
class Obligation { line: text; argument: Node?; type: Term?; within: text?; function_type: Term? = ø; value: Term? = ø; call: Node? = ø; place: int = 0; statement: Term? = ø; check: Node? = ø; choice: int = 0; verdict: bool? = ø; holds: text? = ø; compared: Term? = ø; reads: list<Node> = []; row: text? = ø; folded: int? = ø }
# (the program's: those of the pass of typing that completed it, core/analyze/types.wap typed_among)
obligations: list<Obligation> = []
CHOICE_UNDECIDED = -1
OBLIGATION_LEFT = "is checked when the program runs"
PROOF_LEFT = "needs a proof, which the run cannot check"

# The dispatching function a call of these definitions with arguments of these types means; ø when no argument is an
# any or a number that some definition wants of a type it may hold
dispatching(called: Node, candidates: list<Signature>, arguments: list<Node>, types: list, s: TypingState) as Signature? := {
	counted = candidates.filter(definition => takes_count(definition, #types, s))
	if not counted.any(definition => tested_places(definition, types, s) != [] or generic_place(definition, types, s) != ø) { return ø }
	for at in 1 to #types { untaken_part(called, counted, types#at, at, s) }
	name = dispatcher_name(called, counted, types, s)
	made = dispatching_named(name, called, counted, types, s)
	choices = s.choices.get(place_key(name)) ?? []
	s.dispatched = counted.flat_map(definition => choice_obliged(called, definition, arguments, types, choices, s))
	made
}
# A value of a parent given where a definition wants its narrowing is tested when the program runs, an obligation for
# each place; a choice whose every test is a subtype's condition is one the placing may decide, by its place among the
# dispatcher's choices (core/analyze/types.wap decided_code); gives the places of those the placing may decide
choice_obliged(called: Node, definition: Signature, arguments: list<Node>, types: list, choices: list<Signature>, s: TypingState) as list<int> := {
	places = tested_places(definition, types, s)
	wanted = (at: int) => definition.parameters#at!
	narrowed = places.filter(at => conversion(types#at, wanted(at), s) == Conversion.Narrowed)
	conditions = narrowed.map(at => subset_condition(wanted(at)))
	choice = if #narrowed == #places and conditions.all(condition => condition != ø) and definition in choices then choices.index_of(definition) else CHOICE_UNDECIDED
	kept = (1 to #narrowed).map(at => obliged(called, arguments#(narrowed#at), wanted(narrowed#at), conditions#at, s, choice: choice))
	if choice > 0 then kept else []
}
# a union given where no definition takes one of its parts is refused when compiling, naming the part (wiki/type.md
# "Optional values and unions")
untaken_part(called: Node, counted: list<Signature>, type: Term, at: int, s: TypingState) := {
	if not is_union(type) { return }
	untaken = union_parts(type).find(part => not counted.any(definition => has_letters(definition.parameters#at) or conversion(part, definition.parameters#at, s) in STATIC_CONVERSIONS))
	if untaken != ø { refused(called, "this may be given ${type_text(untaken)}, which no ${called} takes: define ${called} for ${type_text(untaken)}") }
}
dispatcher_name(called: Node, counted: list<Signature>, types: list, s: TypingState) as Node := name_for("${called}(${types_text(types)})", defined_name(define_of(counted#1, s)), called)
# the dispatching function of that name over the definitions that take the arguments' count
dispatching_named(name: Node, called: Node, counted: list<Signature>, types: list, s: TypingState) as Signature := {
	known = definition_keyed(place_key(name), s)
	if known != ø { return known }
	reads = parameters_of(name, types)
	order = ranked(counted, types, s)
	dispatch = Dispatch(called, name, order, types, reads, taking_of(order, reads, types, s))
	generic = order.filter(definition => generic_place(definition, types, s) != ø)
	made = dispatcher_made(name, reads, dispatch_body(dispatch, s), dispatch_results(dispatch, s), s)
	if generic is not empty { s.dispatches.add(dispatch) }
	made
}
# The dispatchers a module exports under the plain words its own definitions overload (wiki/wasm-representation.md
# "Export names"): for a word's overloads of one count of parameters, the dispatcher of as many any values, typed as a
# call would type it though only the host calls it, its name EXPORTED_AS the word; none for a word taking a shape of
# Node, `kind(d: Duo)`, which no value a host gives is, and none in a build keeping values in the memory, which has no any
# DEBT: A word with a generic list or map overload exports no dispatcher: its choice for each boxed type is typed even
#   where the instance refuses, `≈(list<T>)` for a list of a type without ≈. Paid off when generic_choices leaves
#   out the boxed types whose instance refuses.
# DEBT: A dispatcher links the types module (its refusal of a type no overload takes, a char read as a text), so a
#   host calling a module's export without the types module beside it traps at instantiation. Paid off when a
#   dispatcher's refusal and reads are the module's own code.
exported_dispatchers(defined: list<Signature>, s: TypingState) := {
	own = defined.filter(definition => is_function(definition))
	for word in own.map(definition => definition.name).unique {
		overloads = own.filter(definition => definition.name == word)
		types = overloads#1.parameters.map(type => ANY_TERM)
		if #overloads > 1 and overloads.all(each => #each.parameters == #types) and overloads.any(definition => tested_places(definition, types, s) != []) and overloads.all(definition => generic_place(definition, types, s) == ø and definition.parameters.all(type => type == ø or narrowed_type(shaped(type!, s)) == ø)) {
			made = dispatching_named(with_fact(dispatcher_name(symbol(word), overloads, types, s), EXPORTED_AS, Text(word)), symbol(word), overloads, types, s)
			function_typed(made, made.parameters, s, made.definer)
		}
	}
}
# A dispatch as typing writes it: the word called, the dispatcher's name, the definitions in their ranking, the
# argument types and the parameters that read them; how many of the boxed types its choices cover
# argument types and the parameters that read them, the definitions that take the values once their tests pass; how
# many of the boxed types its choices cover
class Dispatch { called: Node; name: Node; order: list<Signature>; types: list<Term>; reads: list<Node>; taking: list<Signature>; covered: int = 0 }
# A dispatcher's body: the definitions whose tests pass, in their ranking, then a generic one for each list or map type
# a value was boxed into an any as, `x is list<int>` for text(xs: list<T>), then the one that takes the values as they
# are, else a raise naming the word
dispatch_body(dispatch: Dispatch, s: TypingState) as Node := {
	dispatch.covered = #boxed_known(s)
	reads = dispatch.reads
	types = dispatch.types
	untested = dispatch.taking.filter(definition => not is_tested(definition, types, s))
	tested = dispatch.taking.filter(definition => is_tested(definition, types, s))
	# the choices a call's obligations name by their places (choice_obliged)
	s.choices[place_key(dispatch.name)] = tested
	last = if untested is empty then raised("${dispatch.called}: ${refusal(dispatch, tested, s)}", dispatch.name, s) else named_call(text(dispatch.called), untested, reads, dispatch.name, s)
	tried = tested.map(definition => Choice(tests_of(definition, reads, types, s, dispatch.name), named_call(definition.name, [definition], reads, dispatch.name, s)))
	chained(tried + dispatch.order.flat_map(definition => generic_choices(definition, dispatch, s)), last, dispatch.name)
}
# why no definition took the values: the one place tested, `initial("")` refused by its parameter's condition, wanted
# at the definition (a dispatcher serves every call of its types), else that none takes their types
refusal(dispatch: Dispatch, tested: list<Signature>, s: TypingState) as text := {
	places = if #tested == 1 then tested_places(tested#1, dispatch.types, s) else []
	if #places == 1 then other_shape(tested#1.parameters#(places#1)!, tested#1.definer, s) else "no definition takes these values' types"
}
# the definitions that take the values once their tests pass
taking_of(order: list<Signature>, reads: list, types: list, s: TypingState) as list<Signature> := order.filter(definition => takes_fitting(definition, tested_reads(definition, reads, types, s), s))
# whether a dispatcher tries a definition by its tests, in turn, before the one that takes the values untested
is_tested(definition: Signature, types: list, s: TypingState) as bool := tested_places(definition, types, s) != []
# the place where a definition takes a list or a map of its own letters, `xs: list<T>`, or any list or map, `xs: list`,
# that an any or a union is given at; ø where it takes none
generic_place(definition: Signature, types: list, s: TypingState) as int? := (1 to #types).find(at => {
	wanted = definition.parameters#at
	held_boxed(types#at) and (has_letters(wanted) or names_bare_kind(wanted)) and type_word(wanted ?? ANY_TERM) in COLLECTION_WORDS
})
# whether a value of the type is held boxed, of a type known when the program runs: an any's or a union's
held_boxed(type: Term?) as bool := type == ANY_TERM or is_union(type)
# a generic definition's choices: one for each boxed type its parameter takes, tested and passed on as that type
generic_choices(definition: Signature, dispatch: Dispatch, s: TypingState) as list<Choice> := {
	at = generic_place(definition, dispatch.types, s) ?? return []
	# every place an any or a union is given at whose parameter is that one's type, `ys: list<T>` beside `xs: list<T>`
	places = (1 to #dispatch.reads).filter(place => held_boxed(dispatch.types#place) and (definition.parameters#place ?? ANY_TERM) == (definition.parameters#at ?? ANY_TERM))
	read_as = type => (1 to #dispatch.reads).map(place => if place in places then with_type_of(dispatch.reads#place, type) else dispatch.reads#place)
	taking = taken(definition, at, boxed_known(s), s).filter(type => takes_fitting(definition, read_as(type), s))
	taking.map(type => Choice(places.map(place => test_of(dispatch.reads#place, type, dispatch.name, s)), named_call(definition.name, [definition], read_as(type), dispatch.name, s)))
}
# what each choice gives: a definition's written result, a generic one's for each boxed type it takes, `list<text>`
# of keys(m: map<K, V>) for a map<text, int>; ø where its letters stay open
dispatch_results(dispatch: Dispatch, s: TypingState) as list<Term?> := {
	plain = dispatch.taking.filter(definition => generic_place(definition, dispatch.types, s) == ø)
	plain.map(definition => if has_letters(definition.result) then ø else definition.result) + dispatch.order.flat_map(definition => generic_results(definition, dispatch, s))
}
generic_results(definition: Signature, dispatch: Dispatch, s: TypingState) as list<Term?> := {
	at = generic_place(definition, dispatch.types, s) ?? return []
	taken(definition, at, boxed_known(s), s).map(type => generic_result(definition, at, type, s))
}
generic_result(definition: Signature, at: int, type: Term, s: TypingState) as Term? := {
	bound = unified(parameters_holed(definition, s)#at ?? return ø, type, [], s) ?? return ø
	result = answered(substituted(definition.result, letter_holes(definition, s)) ?? return ø, bound)
	if has_letter_holes(result, s) then ø else result
}
# the boxed types a definition's generic parameter takes
taken(definition: Signature, at: int, boxed: list<Term>, s: TypingState) as list<Term> := {
	wanted = parameters_holed(definition, s)#at ?? ANY_TERM
	boxed.filter(type => bare_fit(type, wanted, s.records) or unified(wanted, type, [], s) != ø)
}
# Each generic dispatch given the choices of the types boxed after it was written, round by round, until no new type
# is boxed: a later statement may box a type an earlier dispatch meets. A round looks only at the types boxed since
# the one before, and types a dispatcher again only when one of them fits a generic definition of its word; a round
# that boxes a type holding one the round before boxed nests without end, and is refused
# DEBT: A dispatcher compiled once into a module (types.wasm, a library compiled once) knows only the types boxed when
#   it was compiled: a program's list<Foo> in an any, handed to such a module's function that calls text(x), raises
#   "no definition takes these values' types" when it runs. Paid off when a program's boxed types reach the dispatchers
#   of the modules it uses, or such a call is refused at compile time naming the module's function.
dispatches_completed(s: TypingState) as bool := {
	before: list<Term> = []
	grown = no
	while s.dispatches.any(dispatch => dispatch.covered < #boxed_known(s)) {
		known = boxed_known(s)
		retyped = s.dispatches.filter(dispatch => dispatch.covered < #known and known[dispatch.covered ..].any(type => fits_generic(dispatch, type, s)))
		for dispatch in s.dispatches { if not retyped.contains(dispatch) { dispatch.covered = #known } }
		for dispatch in retyped { grown = dispatcher_retyped(dispatch, s) or grown }
		fresh = boxed_known(s)[#known ..]
		deeper = deeper_type(fresh, before)
		if deeper != ø { refused(retyped#1.name, "${retyped#1.called} with an any boxes ever deeper types, ${type_text(deeper!)}: say the type the any holds where it is used") }
		before = fresh
	}
	grown
}
# a type of these that holds one of those, ø for none
deeper_type(fresh: list<Term>, before: list<Term>) as Term? := fresh.find(type => before.any(old => holds_type(type, old)))
# whether a boxed type fits a generic definition of a dispatch's word
fits_generic(dispatch: Dispatch, type: Term, s: TypingState) as bool := dispatch.order.any(definition => {
	at = generic_place(definition, dispatch.types, s)
	at != ø and taken(definition, at!, [type], s) is not empty
})
# the boxed types as far as their unknowns have settled, each once; one an unknown still holds waits
boxed_known(s: TypingState) as list<Term> := {
	known: list<Term> = []
	for type in s.boxed.map(each => settled_type(each, s)) { if not has_unknowns(type) and not known.any(other => other == type) { known.add(type) } }
	known
}
# whether its result changed: the callers typed before took the old one
dispatcher_retyped(dispatch: Dispatch, s: TypingState) as bool := {
	key = place_key(dispatch.name)
	define = define_of(definition_keyed(key, s) ?? refused(dispatch.name, "a dispatcher is held"), s)
	retyped: Define = match define { Define(name, parameters, body) => refitted(Define(name, parameters, dispatch_body(dispatch, s)), define) }
	s.defines[key] = retyped
	s.dispatchers = s.dispatchers.map(each => if function_key(each) == key then retyped else each)
	typed = instances_of(key, s)
	s.functions = s.functions.filter(each => each.function.key != key)
	s.instances[key] = []
	# each instance retyped, so map, not any
	typed.map(instance => (function_typed(instance.function, instance.arguments, s, dispatch.name).result ?? ANY_TERM) != (instance.result ?? ANY_TERM)).contains(yes)
}
# The dispatching function a read of this field on an any means, `.name(any)`; ø when no record has the field
field_dispatching(key: Node, s: TypingState) as Signature? := {
	holders = s.records.items.filter(record => cases_of(record) is empty and field_named(record, key) != ø)
	if holders is empty { return ø }
	held = held_field(holders#1, key)
	name = name_for("${FIELD_MARK}${key}(${ANY_TYPE})", declared_name(held))
	known = definition_keyed(place_key(name), s)
	if known != ø { return known }
	read = parameters_of(name, [ANY_TERM])#1
	tried = holders.map(record => Choice([test_of(read, record_term(record), name, s)], placed_like(Get(read, key), name)))
	dispatcher_made(name, [read], chained(tried, raised("${key}: no record of this value's type has this field", name, s), name), holders.map(record => written_type(declared_type(held_field(record, key)))), s)
}
held_field(record: Node, key: Node) as Node := field_named(record, key) ?? refused(key, "the record holding this field has none")

# a dispatching function's parameters, x1 …, one of each type, as its body reads them
parameters_of(name: Node, types: list) as list<Node> := (1 to #types).map(at => {
	parameter = name_for(PARAMETER_WORD + text(at), name)
	with_type_of(with_fact(with_binding(parameter, DefinitionKind.Parameter), DEFINED_AT, parameter), types#at)
})
# The dispatching function, kept with the typing stage's definitions and placed with the program's functions; its
# result written when every choice writes its own, so a choice calling back through the dispatch finds it
dispatcher_made(name: Node, reads: list, body: Node, results: list<Term?>, s: TypingState) as Signature := {
	dispatcher = placed_like(Define(dispatcher_written(name, reads, results, s), List(reads.map(read => Key(read, Op.Colon, written_of(value_of(read, "for a dispatcher's parameter")))), Bracket.Round, Separator.Comma), body), name)
	s.dispatchers += [dispatcher]
	function_added(dispatcher, s)
}
# a function typing writes once by its name, of parameters of these types, its body made of their reads: a narrowing,
# an unfailing, a statement's check (core/analyze/calls.wap statement_checker)
written_once(name: Node, types: list, body: (list<Node>) -> Node, result: Term, s: TypingState) := {
	if definitions_named(text(name), s) is not empty { return }
	reads = parameters_of(name, types)
	dispatcher_made(name, reads, placed_like(body(reads), name), [result], s)
}
# a dispatcher's name with its result written where every choice writes one: joined_type is ø where either is. A
# choice among an any's types gives an any where the choices give unlike types, or where no type it takes is boxed
# yet: its result stays as written while later boxed types add choices
dispatcher_written(name: Node, reads: list, results: list<Term?>, s: TypingState) as Node := {
	reads_any = reads.any(read => value_type(read) == ANY_TERM)
	joined = if results is empty then (if reads_any then ANY_TERM else ø) else results.drop(1).fold(results#1, (a, b) => held_joined(a, b, s))
	result = if is_union(joined) and reads_any then ANY_TERM else joined
	if result == ø then name else Key(name, Op.Colon, written_of(result!))
}
# the results of choices made when the program runs, each kept as it is: an int's and a float's a number, not a float
held_joined(a: Term?, b: Term?, s: TypingState) as Term? := if a != ø and b != ø and a != b and boxed_fit(a!, NUMBER_TERM) and boxed_fit(b!, NUMBER_TERM) then NUMBER_TERM else joined_type(a, b, s)
# a dispatch's choice: its tests, and the code that runs once they all pass
class Choice { tests: list<Node>; code: Node }
# the choices tried in order: the first whose tests all pass runs, else the last
chained(choices: list<Choice>, last: Node, at: Node) as Node := choices.reverse.fold(last, (chain, choice) => placed_like(If(all_passing(choice.tests, at), choice.code, chain), at))
# the test that passes once all of these pass, each tried only after the ones before it
all_passing(tests: list<Node>, at: Node) as Node := tests.drop(1).fold(tests#1, (both, test) => placed_like(If(both, test, False), at))
# the places where a definition wants a type the any or number its argument gives may box, or a shape of its
# argument's type: an `is` test there chooses it
# a parameter's type a test chooses by: written, no any, no generic letter, none that takes its argument's own type
dispatchable(type: Term?, records: Records) as bool := once_typed(type, records) and type != ANY_TERM
tested_places(definition: Signature, types: list, s: TypingState) as list<int> := (1 to #types).filter(at => {
	wanted = definition.parameters#at
	wanted != ø and dispatchable(wanted, s.records) and tested_fit(wanted, types#at, s)
})
# a part of a union, or the type a shape among its parts narrows, `Node` of an `int or Error`, is tested for
tested_fit(wanted: Term, given: Term, s: TypingState) as bool := wanted != given and (tested_when_run(wanted, given, s.records) or is_union(given) and union_parts(given).any(part => narrowed_type(part) == wanted)) or conversion(given, wanted, s) == Conversion.Narrowed
# the arguments as a definition's call reads them once its tests pass: each tested one of its parameter's type
tested_reads(definition: Signature, reads: list, types: list, s: TypingState) as list := {
	places = tested_places(definition, types, s)
	(1 to #reads).map(at => if at in places then with_type_of(reads#at, definition.parameters#at) else reads#at)
}
tests_of(definition: Signature, reads: list, types: list, s: TypingState, at: Node) as list<Node> := tested_places(definition, types, s).map(place => test_of(reads#place, definition.parameters#place ?? refused(at, "a tested parameter has its type"), at, s))
# whether an any's value is of the type, `x is int`, or a value of a shape (core/analyze/shapes.wap)
test_of(read: Node, type: Term, at: Node, s: TypingState) as Node := if narrowed_type(type) != ø then narrowing_test(read, type, at, s) else with_fact(with_type_of(placed_like(Prim(symbol(BOXED_TEST), [read]), at), BOOL_TERM), TESTED, type_fact(type))
# a call of one of these definitions, chosen among them as any call is
named_call(word: text, definitions: list<Signature>, arguments: list, at: Node, s: TypingState) as Node := {
	called = with_fact(with_binding(placed_like(symbol(word), at), DefinitionKind.Function), CANDIDATES, data_list([data_list(definitions.map(definition => defined_name(define_of(definition, s))))]))
	placed_like(Call(called, arguments), at)
}
raised(message: text, at: Node, s: TypingState) as Node := raising(Text(message), at, s)
raising(raised: Node, at: Node, s: TypingState) as Node := named_call(RAISE_WORD, definitions_named(RAISE_WORD, s), [raised], at, s)

# A value where a narrowing of its type is wanted, `Record` where a Node is given (core/analyze/shapes.wap) or a
# subtype where its parent is, as a call of the function the typing stage writes once for it: the value when it is of
# the narrowing, else a raise naming the place that wanted it. A condition reading the parameters of the function around, `#it == k`, takes their values
# as further arguments, so one function serves each such type, its names' types in its name
narrowed_call(n: Node, wanted: Term, at: Node, s: TypingState) as Node := {
	values = condition_reads(wanted, at, s)
	types = values.map(value => value_type(value)!)
	name = name_once("${NARROWING_WORD}(${([type_text(wanted, yes)] + types.map(type => type_text(type, yes))).join(", ")})", n, s)
	# one for each shape, wherever it is wanted
	written_once(name, [narrowed_type(wanted) ?? NODE_TERM, TEXT_TERM] + types, reads => If(narrowing_test(reads#1, wanted, name, s, values, reads.drop(2)), reads#1, raising(reads#2, name, s)), wanted, s)
	obligation = obliged(at, n, wanted, subset_condition(wanted), s)
	kept = s.obligations#obligation
	kept.reads = values
	obligations_noted(word_called(n, text(name), [n, message_given(other_shape(wanted, at, s), at)] + values, wanted, s), [obligation])
}
# A value of a union holding an Error where a type is wanted that holds none: the Error raised, any other value checked
# as an any's is (wiki/Error.md: no other variable holds an Error), one function for each pair of types
unfailed_call(n: Node, given: Term, wanted: Term, s: TypingState) as Node := {
	name = name_once("${UNFAILED_WORD}(${type_text(given, yes)}, ${type_text(wanted, yes)})", n, s)
	written_once(name, [given], reads => {
		error = error_part(given)!
		cast = type => with_type_of(placed_like(Prim(symbol(CHECKED_CAST), reads), name), type)
		If(narrowing_test(reads#1, error, name, s), raising(cast(error), name, s), cast(wanted))
	}, wanted, s)
	word_called(n, text(name), [n], wanted, s)
}
error_part(type: Term) as Term? := union_parts(type).find(is_error)
is_error(type: Term) as bool := narrowed_type(type) == NODE_TERM and type_text(type) == ERROR_CASE
# a narrowing at a place, each one its own obligation with its own verdict, its warning a subtype's condition as written,
# a shape by its name (two at one place share the line)
obliged(at: Node, argument: Node, type: Term, condition: Node?, s: TypingState, choice: int = 0) as int := {
	line = warning_of(at, "${if condition == ø then type_text(type) else condition_shown(condition!)} ${OBLIGATION_LEFT}")
	obligation_kept(Obligation(line, argument, type, s.within, choice: choice), "${place_of(argument)}${argument}${type_text(type)} ${choice}", s)
}
# A sum, difference or product of two ints whose definition is a row of the machine, `prim i64.add(a, b)`, obliged to
# give a scalar (kernel/scalars.wap; wiki/number.md "Whole numbers": an int never overflows): decided yes it runs as
# the row (core/analyze/types.wap decided_code), else as the row carried past the scalars; never refused, never left
# to `wap check`
row_fitted(typed: Node, meant: Signature, s: TypingState) as list<int> := {
	if meant.result != INT_TERM or not meant.parameters.all(type => type == INT_TERM) { return [] }
	body = match s.defines.get(meant.key) { Define(name, parameters, body) => body; _ => return [] }
	row = match body { Prim(operation, arguments) => text(operation); _ => return [] }
	if not FOLDED_ARITHMETIC.contains(row) { return [] }
	# one for each instance of the function around, whose operands' types differ
	[obligation_kept(Obligation("", typed, word_term(SCALAR_WORD), s.within, row: row), "${place_of(typed)}${row} ${s.within ?? ""} ${TYPES.instance}", s)]
}
# An obligation kept once for its key, wherever typing meets its code again (a body typed again, a choice tried): its
# place in the obligations. The key is its own code's place, so two obligations at one place keep their own verdicts
obligation_kept(obligation: Obligation, key: text, s: TypingState) as int := {
	known = s.obligation_keys.get(key)
	if known != ø { return known! }
	s.obligations.add(obligation)
	s.obligation_keys[key] = #s.obligations
	#s.obligations
}
# a run's error message as an argument of the code that raises it
message_given(message: text, at: Node) as Node := with_type(placed_like(Text(message), at), TEXT_TYPE)
