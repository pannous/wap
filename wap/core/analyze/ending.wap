# Whether a function that calls itself ends (wiki/effects.md "Div", notes/coc-t5c.md T5c1): a recursion is no Div when
# it is structural, every call of itself on a part a case of its matched parameter took apart, or when it shrinks toward
# a guarded bound, every call of itself in the arm of an `if` where a whole-number parameter is above a literal, on that
# parameter less a literal above 0. Any other self-call, a function used as a value, keeps Div and still runs.

use "../stage.wap"
use "../bindings.wap"
use "../../kernel/forms.wap"
use "../../nodes.wap"

SUBTRACT_WORDS = ["-", "subtract"]
# the comparisons of a parameter with a literal, and the arm of the `if` (1 the then part, 2 the else part) where the
# parameter is above the literal
ARM_ABOVE = {"<=": 2, "<": 2, ">": 1, ">=": 1}

# a function (its key, its parameters' keys, its body) that calls itself and only so, and ends
ends(typed: TypedFunction, key: text, parameters: list<text>, body: Node, s: TypingState) as bool := {
	calls = self_calls(key, body)
	named = nodes_in(body).filter(n => n is symbol and definer_key(n) == key)
	calls is not empty and #named == #calls and (structural(typed, parameters, calls, body, s) or bounded(typed, parameters, calls, body, s))
}
# the calls of the function in a body
self_calls(key: text, body: Node) as list<Node> := nodes_in(body).filter(n => match n { Call(called, arguments) => definer_key(called) == key; _ => no })
definer_key(n: Node) as text := match fact_of(n, REBOUND) ?? fact_of(n, DEFINED_AT) { ø => ""; definer => place_key(definer!) }
spelled(n: Node) as text := text(fact_of(n, SPELLING) ?? n)
argument_at(call: Node, place: int) as Node := match call { Call(called, arguments) => arguments#place; _ => Empty }

# the body takes a parameter of a program's enum apart by a match (an enum's cases are values, never changed in place), and every call has at that parameter's place a field of a case of it, or
# of a case of such a field
structural(typed: TypedFunction, parameters: list<text>, calls: list<Node>, body: Node, s: TypingState) as bool := match unwrapped(body) {
	Case(subject, arms) => {
		place = parameters.index_of(definer_key(subject))
		below = below_of(body, [definer_key(subject)])
		place > 0 and TYPES.enums.get(word_id(kernel_settled(typed.arguments#place, s))) == ENUM_DEFINED and calls.all(call => below.contains(definer_key(argument_at(call, place))))
	}
	_ => no
}
# the keys held, and those of the fields every match inside n on one of them names
below_of(n: Node, held: list<text>) as list<text> := nodes_in(n).fold(held, (found, part) => match part {
	Case(subject, arms) => if found.contains(definer_key(subject)) then found + arms.flat_map(arm => case_fields(match arm { Arm(pattern, result) => pattern }).filter(field => field is symbol).map(field => place_key(field))) else found
	_ => found
})

# the body is an `if` comparing an int parameter (a float stops shrinking past 2^53) with a literal, and every call lies in the arm where it is above, with the
# parameter less a literal above 0 at the parameter's place
bounded(typed: TypedFunction, parameters: list<text>, calls: list<Node>, body: Node, s: TypingState) as bool := match unwrapped(body) {
	If(condition, then_part, else_part) => {
		compared = match condition { Call(called, arguments) => if #arguments == 2 and arguments#2 is Number and ARM_ABOVE.has(spelled(called)) then [spelled(called), definer_key(arguments#1)] else []; _ => [] }
		place = if compared is empty then 0 else parameters.index_of(compared#2)
		arm = if place > 0 then [then_part, else_part]#(ARM_ABOVE[compared#1]) else Empty
		place > 0 and kernel_settled(typed.arguments#place, s) == INT_TERM and #calls == #self_calls_in(calls, arm) and calls.all(call => shrinks(argument_at(call, place), compared#2))
	}
	_ => no
}
# the calls of those given that lie in a node
self_calls_in(calls: list<Node>, arm: Node) as list<Node> := calls.filter(call => nodes_in(arm).contains(call))
# `parameter - k`, k a literal above 0
shrinks(argument: Node, parameter: text) as bool := match argument {
	Call(called, arguments) => SUBTRACT_WORDS.contains(spelled(called)) and #arguments == 2 and definer_key(arguments#1) == parameter and (match arguments#2 { Number(value) => value > 0; _ => no })
	_ => no
}
