# How types meet (core/analyze/types.wap; wiki/conversion.md "Fitting" and "Repacking"): whether a value of one type
# may stand where another is wanted, two types written alike, and the type that holds the values of two.

use folder
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"
use "../errors.wap"
use "../../kernel/terms.wap"
use "../../kernel/primitives.wap"
use "../rules/typed.wap"

# DONE (1c61026ce9): Get rid of all this REVIEW CLUTTER and ONLY Link to the wiki specification. If absent, bring it to the interviewer!
# DONE (68479de8ad): what is symbol(NEVER_TYPE) ?? We don't have this ugly thing in Warp. Wap must be a more beautiful compiler 
# DONE (bd6311b8df): link conversion(given, wanted) to explicit function convert(a,b) and cast(a,b)  ≈  a as b := {...} 
# the type that holds both, an unknown in either settled by the other, `if missing(x) then 3 else x!` an int
joined_settling(a: Term?, b: Term?, s: TypingState) as Term? := {
	given = value_bearing(a)
	wanted = value_bearing(b)
	if given != ø and wanted != ø { settles(given, wanted, s) }
	joined_type(settled_optional(a, s), settled_optional(b, s), s)
}
# Code of which one part runs, an if's or a match's arms: of the type joining those that finish, jumping when all jump
joined_of(n: Node, parts: list, s: TypingState, expected: Term? = ø) as Node := if parts.all(jumps) then jumping(n) else with_type_of(n, parts_type(parts, s, expected))
# the type joining the parts that finish; none where no value is wanted, a statement's whose value is dropped; a call
# of the function being typed, its result not known yet, gives it none (calls.wap shaped_typed)
# of a wanted type that every part gets to as it is, that type: an int's and a float's arm each boxed where a number is
parts_type(parts: list, s: TypingState, expected: Term? = ø) as Term? := {
	finished = parts.filter(part => not jumps(part) and fact_of(part, RESULT_UNKNOWN) == ø).map(value_type)
	if expected == EMPTY_TERM or wants_value(expected) and finished.all(type => type != ø and (type! == expected! or boxed_fit(type!, expected!))) then expected else joined_all(finished, s)
}
# whether a place wants a value: neither unknown nor a dropped statement's
wants_value(expected: Term?) as bool := expected != ø and expected != EMPTY_TERM
# the parts that finish each as their joined type has it: `1` of `if c then 1 else ø` boxed as an int?
parts_fitted(parts: list, s: TypingState, expected: Term? = ø) as list := {
	type = parts_type(parts, s, expected)
	parts.map(part => as_wanted(part, type, s))
}
# the type that holds all of these, ø for none: two at a time, or where two only meet in any or a union, the one of
# them that holds every other, whatever their order: `"one"`, `2` and a Symbol meet in Node
joined_all(types: list, s: TypingState) as Term? := {
	if types is empty { return ø }
	folded = types.drop(1).fold(types#1, (a, b) => joined_settling(a, b, s))
	if folded != ANY_TERM and not is_union(folded) { return folded }
	types.find(holder => types.all(type => conversion(type, holder, s) in STATIC_CONVERSIONS)) ?? folded
}
# the type that holds both: either when they are one, `T?` for a T and ø (or a T?), the type two shapes of it narrow,
# the wider where one fits the other, else any, the dynamic type: `["a", 1]` is a list<any>; ø when either has none
joined_type(a: Term?, b: Term?, s: TypingState) as Term? := {
	if a == ø or b == ø { return ø }
	if a == b { return a }
	if a == EMPTY_TERM { return optional_type(b) }
	if b == EMPTY_TERM { return optional_type(a) }
	joined = functions_joined(a, b, s) ?? functions_joined(b, a, s)
	if joined != ø { return joined }
	shared = shape_base(a) ?? return wider(a, b, s)
	if shared != (shape_base(b) ?? return wider(a, b, s)) { return wider(a, b, s) }
	# two shapes of one type join as that type, `Define` and `Fn?` as a Node?
	if base_of_optional(a) != ø or base_of_optional(b) != ø then optional_type(shared) else shared
}
# whether a list or a map is as it is where one of its word is wanted whose parts its own parts are as they are:
# `[Call(…)]` where a list<Node> is, `{a: 1, b: "x"}` where a map<text, any> is; never a part with a condition where
# its parent is (lists change: a list<int where it > 0> given where a list<int> is would take any int)
parts_as_they_are(given: Term, wanted: Term, s: TypingState) as bool := {
	if not type_word(given) in COLLECTION_WORDS or type_word(given) != type_word(wanted) { return no }
	own = parts_of(given)
	wanted_parts = parts_of(wanted)
	#own == #wanted_parts and (1 to #own).all(at => conversion(own#at, wanted_parts#at, s) == Conversion.Same and (own#at == wanted_parts#at or unrefined(own#at) == own#at))
}
# a list of a refinement where its parent's list is wanted: a copy of it, never the same list (lists change)
copied_refinement(given: Term, wanted: Term, s: TypingState) as bool := {
	if type_word(given) != LIST_TYPE or type_word(wanted) != LIST_TYPE or unrefined(given) == given { return no }
	conversion(item_type(given), item_type(wanted), s) == Conversion.Same
}
# a list of a parent where its refinement's list is wanted: a copy of it whose items are all checked
checked_refinement(given: Term, wanted: Term, s: TypingState) as bool := {
	if type_word(given) != LIST_TYPE or type_word(wanted) != LIST_TYPE or not checkable(wanted) { return no }
	conversion(item_type(given), item_type(wanted), s) in [Conversion.Narrowed, Conversion.Copied]
}
# the type of two where one fits the other: the wider, else their union; any while a type is still unknown
wider(a: Term, b: Term, s: TypingState) as Term := if conversion(b, a, s) in STATIC_CONVERSIONS then a else if conversion(a, b, s) in STATIC_CONVERSIONS then b else if has_unknowns(a) or has_unknowns(b) then ANY_TERM else union_type([a, b])
# the type a shape narrows, `Node` of `Define` or of `Fn?`; ø for any other type
shape_base(type: Term) as Term? := narrowed_type(base_of_optional(type) ?? type)

# Whether a typed node's value is of the type a typed rule's hole wants (a stage-3 rule, decision hole-types:
# `$xs: list<int>`, `$f: (float) -> float`): its TYPE, or a function name's SIGNATURE, written as the hole writes it.
# A node not typed yet fits nothing, so a typed rule fires only on settled types; a rest hole asks it of each item.
# A generic's bare name takes it with any parts: `$m: map` any map<K, V>, `$xs: list` any list.
fits_type(n: Node, wanted: Term) as bool := held_fits(type_held(n), wanted)
# a subtype fits where the type it narrows does: a nat where an int is wanted
held_fits(held: Term?, wanted: Term) as bool := held != ø and (held == wanted or is_word(wanted) and parts_of_type(word_of(wanted)!, held) != ø or held_fits(narrowed_type(held), wanted))
type_held(n: Node) as Term? := fact_type(fact_of(n, TYPE)) ?? fact_type(fact_of(fact_of(n, DEFINED_AT) ?? return ø, SIGNATURE))
# a field's type, which every field writes
field_type(field: Node) as Term := written_type(declared_type(field)) ?? refused(field, "a field has a type")
# a field's type in a value of its record's type, the record's letters all filled at once by the type's parts:
# `item: T` of a Boxed<int> is an int
# (ø for a field of no written type)
field_type_in(field: Node, holder: Term, record: Node) as Term? := substituted(written_type(declared_type(field)), letters_filled(record, holder))
letters_filled(record: Node, holder: Term) as list<Binding> := {
	letters = record_letters(record_declared(record))
	parts = parts_of(holder)
	if #parts != #letters then [] else (1 to #letters).map(at => Binding(text(letters#at), parts#at))
}
# the type of a record a value of it has: its letters as given, each one not given an unknown its later uses settle
holder_of(record: Node, given: list<Binding>, s: TypingState) as Term := {
	letters = record_letters(record_declared(record))
	if letters is empty then record_term(record) else applied(head_of(record_term(record)), letters.map(letter => type_keyed(text(letter), given) ?? unknown_type(s)))
}
# the type of a record its values make, its letters bound by them as a call binds a definition's (letters.wap
# letters_bound), each made under a key of its own
holder_made(record: Node, fields: list<Node>, typed: list<Node>, key: text, called: Node, s: TypingState) as Term := {
	if record_letters(record_declared(record)) is empty { return record_term(record) }
	made = Signature(text(called), key, DefinitionKind.Case, called, fields.map(field => written_type(declared_type(field))), record_term(record))
	holder_of(record, (letters_bound(made, typed.map(value_type), s) ?? refused(called, "${called}'s values give one letter two types")).letters, s)
}
# the type a field's value is typed for before its holder is known: its own, ø where it names a letter
field_wanted(field: Node) as Term? := { type = written_type(declared_type(field)); if has_letters(type) then ø else type }
# a value given to a field as the field's type has it in its holder, refused when it cannot get there; value is the
# code that gave it
field_checked(given: Node, field: Node, holder: Term, record: Node, value: Node, s: TypingState) as Node := converted(given, field_type_in(field, holder, record) ?? field_type(field), s, value, "the field holds")
# What `x as T` does where nothing is written (wiki/conversion.md "Fitting" and "Repacking"): checked is the cast,
# every other way repacks; written, `x as T` is the maker T(x) ("Making").
# How a value of the given type gets where the wanted one is: as it is, of that type, a list where a bare `list` is, a
# function value where a bare `function` is, an enum where a bare `enum` is, or code that never finishes; boxed, into
# any or a number; widened, an int where a float is (wiki/type.md); read, a character as its text, where a text or a text? is (wiki/char.md, 'a' == "a"); wrapped, a T
# or ø where T? is; subtyped, a subtype's base where the subtype is, as it is, an int given a Color's place by `as` or
# a declared type (wiki/alias.md), never by an overload's choice; narrowed, a value of the type a shape narrows where
# the shape is (core/analyze/shapes.wap), raising there when it is of another shape; settled, the unknowns of either becoming the other's types, `[]` where a
# list<int> is; checked, an any's value where another type is, raising there when it holds another; ø when it cannot.
# The conversions a choice of overloads asks for, the static ones, never check: an any argument, or a Node where a
# shape is wanted, is chosen for at run time (core/analyze/dispatch.wap).
enum Conversion { Same, Boxed, Widened, Read, Wrapped, Subtyped, Narrowed, Settled, Checked, Adapted, Copied }
STATIC_CONVERSIONS = [Conversion.Same, Conversion.Boxed, Conversion.Widened, Conversion.Read, Conversion.Wrapped]
# the library function copying a list
COPY_WORD = "copy"
# the primitive that widens an int to a float
WIDENING = "f64.convert_i64_s"
# a bool counted as 1 or 0 where a call's argument is an int, `true + true` 2, never where an int is declared
# (wiki/Footguns.md "Booleans count as 1/0"), and the primitive that counts it
COUNTING = "i64.extend_i32_u"
counted(given: Term?, wanted: Term?) as bool := given == BOOL_TERM and wanted == INT_TERM
conversion(given: Term?, wanted: Term?, s: TypingState) as Conversion? := {
	if given == ø or wanted == ø { return ø }
	if given == wanted or bare_fit(given, wanted, s.records) or extends_class(given, wanted, s.records) or subtype_base(given, s.records) == wanted { return Conversion.Same }
	# a function value of its own type where a function type is wanted, or an unknown holding function values
	if function_value_parts(given) != ø and (s.members.has(variable_id(wanted)) or adapted_name(given, wanted, s) != ø) { return Conversion.Adapted }
	# a shape's value is a value of the type it narrows: a Record where a Node is
	narrows = narrowed_type(given)
	if narrows != ø and conversion(narrows, wanted, s) == Conversion.Same { return Conversion.Same }
	# a list of a shape's values is a list of the type it narrows, its items those values as they are, and so a map's
	given_item = item_type(given)
	wanted_item = item_type(wanted)
	if parts_as_they_are(given, wanted, s) { return Conversion.Same }
	if copied_refinement(given, wanted, s) { return Conversion.Read }
	if checked_refinement(given, wanted, s) { return Conversion.Copied }
	# a union's value is held as an any's is, so it is as it is where an any is, a wider union, or where each of its
# parts is
	if is_union(given) and (wanted == ANY_TERM or is_union(wanted) and boxed_fit(given, wanted) or union_parts(given).all(part => conversion(part, wanted, s) == Conversion.Same)) { return Conversion.Same }
	# a value of what a narrowing narrows, or of what narrows to that, is narrowed: an int to an index through nat
	narrowing = narrowed_type(wanted)
	if narrowing != ø and conversion(given, narrowing!, s) in [Conversion.Same, Conversion.Narrowed] { return Conversion.Narrowed }
	if boxed_fit(given, wanted) { return Conversion.Boxed }
	if subtype_base(wanted, s.records) == given { return Conversion.Subtyped }
	if narrowed_part(given, wanted, s) != ø { return Conversion.Narrowed }
	if given == INT_TERM and wanted == FLOAT_TERM { return Conversion.Widened }
	optional = base_of_optional(wanted)
	if reads_as(optional ?? wanted, given, s.records) { return Conversion.Read }
	# a list whose items read as the wanted items, `["x", "n"]` of chars where a list<text> is
	if given_item != ø and wanted_item != ø and reads_as(wanted_item!, given_item!, s.records) { return Conversion.Read }
	# an optional where one is wanted whose value is as it is: a list<int>? where a list? is
	if optional != ø and base_of_optional(given) != ø and conversion(base_of_optional(given), optional, s) == Conversion.Same { return Conversion.Same }
	if optional != ø and (given == EMPTY_TERM or conversion(given, optional, s) == Conversion.Same) { return Conversion.Wrapped }
	if (has_unknowns(given) or has_unknowns(wanted)) and unified(wanted, given, [], s) != ø { return Conversion.Settled }
	# out of an any, or of a union to a part of it, the way is a check when the program runs
	if given == ANY_TERM or is_union(given) and union_parts(given).any(part => part in passing_types(wanted)) then Conversion.Checked else ø
}
# typed code as the wanted type has its value, its conversion written: an unknown settled, a character read as its
# text, an any's value checked by `prim cast`, typed the wanted type, at the code's place; refused at `at` when it
# cannot get there, naming the place that wants it, `the field holds a`
converted(n: Node, wanted: Term, s: TypingState, at: Node, place: text) as Node := {
	# code that never finishes gives nothing to convert
	if jumps(n) { return n }
	# where ø is wanted no value is: a value given is dropped, `f(): ø := { x = 2 }`, code giving none is as it is
	if wanted == EMPTY_TERM { return if valued(value_type(n)) then placed_like(Block([n, Block([])]), n) else n }
	if value_type(n) == ø and not has_fact(n, RESULT_UNKNOWN) { return converted(empty_given(n), wanted, s, at, place) }
	given = value_type(n) ?? refused(at, "this gives no value, ${place} ${type_text(wanted)}")
	# a function value converts by its function, typed for the wanted function type
	way = conversion(given, wanted, s) ?? refused(at, "this gives ${type_text(given)}, ${place} ${type_text(wanted)}" + (if counted(given, wanted) then ": a bool counts as 1 or 0 only in a call, write it `as int`" else ""))
	if way == Conversion.Settled { settles(given, wanted, s) }
	if way == Conversion.Read and copied_refinement(given, wanted, s) { return copied(n, wanted, at, s) }
	if way == Conversion.Copied { return copy_checked(n, wanted, at, s) }
	if way == Conversion.Narrowed and word_by_row(n, wanted) { return with_type_of(n, wanted) }
	if way == Conversion.Narrowed { return if narrowed_part(given, wanted, s) == ø then narrowed_call(n, wanted, at, s) else converted(narrowed_call(n, narrowed_part(given, wanted, s)!, at, s), wanted, s, at, place) }
	if way == Conversion.Checked and error_part(given) != ø and error_part(wanted) == ø { return unfailed_call(n, given, wanted, s) }
	if way == Conversion.Checked and type_word(wanted) == LIST_TYPE and checkable(wanted) { return copy_checked(with_type_of(placed_like(Prim(symbol(CHECKED_CAST), [n]), n), unrefined(wanted)), wanted, at, s) }
	if way == Conversion.Checked then with_type_of(placed_like(Prim(symbol(CHECKED_CAST), [n]), n), wanted) else repacked(n, way, wanted, s)
}
# a list given where its refinement's parent list is wanted: a copy of a literal, any other list (a named place, a
# call's result, which may be a list the program holds) is copied only where written (`xs as list<int>`, its block),
# as a callee changing the copy would leave the list unchanged
# a list written out, or the block `as` writes round a value (sugar/types.wap): the copy it asks for
is_new_list(n: Node) as bool := match n { List(items, bracket, separator) => yes; _ => no }
copied(n: Node, wanted: Term, at: Node, s: TypingState) as Node := {
	if not is_new_list(n) { refused(at, "${n} is a list of its own: write `${n} as ${type_text(wanted)}` where a copy of it is wanted") }
	with_type_of(word_called(n, COPY_WORD, [n], ø, s), wanted)
}
# whether a list's items have a condition, or are lists whose items do
checkable(wanted: Term) as bool := type_word(wanted) == LIST_TYPE and (subset_condition(item_type(wanted)) != ø or item_type(wanted) != ø and checkable(item_type(wanted)!))
# the function telling whether all the items of a list of this type meet its item type's condition, written once for
# each type: a list of lists asks that of each item by the function of the item's type
items_hold(wanted: Term, n: Node, s: TypingState) as Node := {
	name = name_once("holds(${type_text(wanted, yes)})", n, s)
	item = item_type(wanted)!
	check = if subset_condition(item) != ø then written_bound(subset_condition(item)!, s) else items_hold(item, n, s)
	written_once(name, [unrefined(wanted)], reads => Call(symbol("all"), [reads#1, check]), BOOL_TERM, s)
	name
}
# a list of items given where a list of a refinement is wanted: the items all checked by its condition, else a raise
# naming the place, then the copy; one function for each type
copy_checked(n: Node, wanted: Term, at: Node, s: TypingState) as Node := {
	name = name_once("${COPY_WORD}(${type_text(wanted, yes)})", n, s)
	written_once(name, [unrefined(wanted), TEXT_TERM], reads => If(Call(items_hold(wanted, n, s), [reads#1]), with_type_of(Call(symbol(COPY_WORD), [reads#1]), wanted), raising(reads#2, name, s)), wanted, s)
	word_called(n, text(name), [n, message_given(other_shape(wanted, at, s), at)], wanted, s)
}
# whether a wasm row on whole numbers is the code, its result a word wherever the word is wanted
word_by_row(n: Node, wanted: Term) as bool := match n { Prim(operation, arguments) => WORD_ROWS.contains(text(operation)) and type_text(wanted) == ROW_WORD; _ => no }
# code giving no value gives ø wherever a value is wanted, `answer(f())` and `y: int? = f()` of an f giving nothing;
# a call whose result is not known yet waits
empty_given(code: Node) as Node := if value_type(code) != ø or jumps(code) or has_fact(code, RESULT_UNKNOWN) then code else with_type_of(placed_like(Block([code, with_type_of(Empty, EMPTY_TERM)]), code), EMPTY_TERM)
# a value converted the static way it gets where the wanted type is: read, boxed or wrapped, widened; an ø wrapped
# into an optional is of the optional, whatever form gives it: `if c then ø else ø` an int? where one is wanted
repacked(n: Node, way: Conversion, wanted: Term, s: TypingState) as Node := match way {
	Conversion.Read => as_read(n, base_of(wanted), s)
	Conversion.Boxed => boxed(boxing_noted(n, wanted, s), wanted)
	Conversion.Wrapped => if value_type(n) == EMPTY_TERM then with_type_of(n, wanted) else boxed(n, wanted)
	Conversion.Widened => with_type_of(placed_like(Prim(symbol(WIDENING), [n]), n), wanted)
	Conversion.Adapted => function_converted(n, wanted, s)
	_ => n
}
# a list or a map put into an any or a union, its type kept for the dispatches that choose among generic definitions by it
boxing_noted(n: Node, wanted: Term, s: TypingState) as Node := {
	given = value_type(n) ?? return n
	# a list of a refinement is boxed as a copy of its parent's list: the box holds no list the program changes under its condition
	if (wanted == ANY_TERM or is_union(wanted)) and type_word(given) == LIST_TYPE and unrefined(given) != given { return with_type_of(word_called(n, COPY_WORD, [n], ø, s), unrefined(given)) }
	if wanted == ANY_TERM or is_union(wanted) { for part in union_parts(given) { if type_word(part) in COLLECTION_WORDS and not s.boxed.any(type => type == part) { s.boxed.add(part) } } }
	n
}
# a plain value put where a reference is wanted, an any, a number or an optional, in its box: `prim box(3)`; any
# other value as it is, a reference already
boxed(n: Node, wanted: Term) as Node := if is_plain(value_type(n)) then with_type_of(placed_like(Prim(symbol(BOXED_VALUE), [n]), n), wanted) else n
# the value a box holds, any other value as it is
unboxed(n: Node) as Node := match n {
	Prim(name, arguments) => if name == symbol(BOXED_VALUE) then arguments#1 else n
	_ => n
}
# a value as the type wanted has it, where it needs no check: a character where a text is wanted read as its text,
# `if c then 'a' else ""`, an empty `{}` where a map is wanted that map, `m.get(k) ?? {}`, a plain value where a
# reference is wanted boxed, any other value as it is
as_wanted(n: Node, wanted: Term?, s: TypingState) as Node := {
	if wanted == ø or jumps(n) { return n }
	if key_type(wanted) != ø and empty_map_written(n) { return with_type_of(n, wanted) }
	repacked(n, conversion(value_type(n), wanted, s) ?? return n, wanted, s)
}
empty_map_written(n: Node) as bool := match n { List(items, Bracket.Curly, separator) => items is empty; _ => no }
# a value of a kind where its bare kind's word is wanted: `list`, `function` (a function value or a written function
# type, `(int) -> int`), `enum`
bare_fit(given: Term, wanted: Term, records: Records) as bool := {
	if wanted in [LIST_TERM, MAP_TERM] { return parts_of_type(type_text(wanted), given) != ø }
	if wanted == FUNCTION_TERM { return function_value_parts(given) != ø or function_parts(given) != ø }
	if wanted != ENUM_TERM { return no }
	record = record_named(records, given) ?? return no
	not cases_of(record) is empty
}
# whether a value is tested for a type when the program runs: an any or a number boxing it, or a class's value that
# may be one of its extensions, a place typed by a class holding those too (notes/coc-plan.md "extends")
tested_when_run(wanted: Term, given: Term, records: Records) as bool := boxed_fit(wanted, given) or extends_class(wanted, given, records)
# a class's value where a class it extends is wanted, as it is: its fields begin with those of the class it extends
# (wap/sugar/records.wap writes `@extends(A)` on its name), and so on up, `class C extends B` where B extends A
extends_class(given: Term, wanted: Term, records: Records) as bool := {
	if not records.extending.contains(word_of(given) ?? return no) { return no }
	base = record_term(record_named(records, type_term(class_extended(record_named(records, given) ?? return no) ?? return no)) ?? return no)
	base == wanted or extends_class(base, wanted, records)
}
# the part of a union wanted that a value given narrows to, a Node to the Error of an `int or Error`; ø for none
narrowed_part(given: Term, wanted: Term, s: TypingState) as Term? := if is_union(wanted) then union_parts(wanted).find(part => conversion(given, part, s) == Conversion.Narrowed) else ø
# any value where any is wanted, an int or a float where a number is, a part of a union, or a narrower union, where it is:
# every value passing as the given type passes as the wanted one, a number's where a union holds int and float
boxed_fit(given: Term, wanted: Term) as bool := wanted == ANY_TERM or (wanted == NUMBER_TERM or is_union(wanted)) and union_parts(given).flat_map(passing_types).all(part => part in passing_types(wanted))
# whether a type's values are held as they are, not by reference: put where a reference is wanted, each goes in its box
is_plain(type: Term?) as bool := is_word(type) and type_text(type) in [INT_TYPE, FLOAT_TYPE, BOOL_TYPE, CHAR_TYPE]
