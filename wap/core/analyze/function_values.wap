# Signature values in the typing stage (core/analyze/types.wap): `x => x + 1` and a function's name as values. Each
# has a type of its own, its function's word applied to its capture types (core/type_notation.wap function_value_type), naming the function a call of
# the value calls, so that call is a direct call, typed for its arguments like any other (core/analyze/calls.wap).
# A function value's own function, its λ, takes the value as its first parameter, a struct of what it captures.

use folder
use "../errors.wap"
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"
use "../rules/typed.wap"
use "../rules/stages.wap"
use "../../kernel/terms.wap"

# the names of a function value's own function and of its first parameter, the value itself
LAMBDA_NAME = "λ"
CLOSURE_NAME = "closure"

# A function value, `x => x + 1`: a function of its own, typed when a call of the value reaches it, whose first
# parameter is the value itself, holding the captures: the variables of the functions around it that it reads. Its
# type is its own, naming that function and the captures' types here, so a call of the value is a call of it; where
# it meets other function values it is a value of their signature (functions_joined).
# DEBT: Function values that meet settle their signature only by a call through them in the same function or a written
#   function type: given to a function without a written result first, `apply(fs[0], 3)`, they are refused as
#   unsettled. Captures are copied when a value is made, so a later change of one is refused. Paid off when a
#   deferred call settles an unknown holding function values by typing them for its argument types.
function_value_typed(n: Node, parameters: Node, body: Node, s: TypingState, f: TypeFrame) as Node := {
	lambda = lambda_of(n, parameters, body, s)
	captures = captures_of(n).map(definer => type_keyed(place_key(definer), f.variables + s.globals) ?? refused(definer, "a function value reads this before any value is given to it"))
	s.captured += captures_of(n).map(place_key)
	s.found_in[lambda.key] = f.present.filter(known => captures_of(n).any(definer => within(known.key, place_key(definer))))
	type = function_value_type(lambda.key, captures, f.letters.flat_map(letter => [letter.key, type_text(letter.type, yes)]))
	s.carried[word_id(head_of(type))] = f.letters
	with_type_of(n, type)
}
# the letters a function's body sees beyond its own: a function value's function's, given itself as its first
# argument, those of the function it is written in, as a letter is the function's whose parameters write it
letters_carried(key: text, types: list, s: TypingState) as list<Binding> := if types is empty or function_value_key(types#1) != key then [] else s.carried.get(word_id(head_of(types#1!))) ?? []
# the function of a function value, made once: named and placed where the value is written
lambda_of(n: Node, parameters: Node, body: Node, s: TypingState) as Signature := {
	name = name_for(LAMBDA_NAME, n)
	definition_keyed(place_key(name), s) ?? lambda_made(name, n, parameters, body, s)
}
lambda_made(name: Node, n: Node, parameters: Node, body: Node, s: TypingState) as Signature := {
	lambda = refitted(Define(name, with_items(parameters, [name_for(CLOSURE_NAME, n)] + items_of(parameters)), body), n)
	s.lambdas[place_key(name)] = lambda
	function_added(lambda, s)
}
# The captures a function value's function reads, each [key, type], from its first parameter, the value; none for a
# function of no function value
captured_by(definition: Node, types: list) as list<Binding> := {
	parts = if types is empty then ø else function_value_parts(types#1)
	captures = captures_of(definition)
	if parts == ø or function_value_key(types#1) != function_key(definition) or captures is empty { return [] }
	(1 to #captures).map(at => Binding(place_key(captures#at), parts!#at))
}
# A call of a function value, `f(x)` where f holds `y => y + 1` or a function's name: a call of the value's function,
# a function value's own one taking the value as its first argument
value_call_typed(n: Node, called: Node, arguments: list, s: TypingState, f: TypeFrame, expected: Term?) as Node := {
	offered = word_call_offered(n, called, arguments, s, f, expected)
	if offered != ø { return offered }
	typed_called = typed_form(called, s, f, ø)
	type = settled_type(value_type(typed_called) ?? refused(called, "this gives no value to call"), s)
	if s.members.has(variable_id(type)) { return members_called(n, typed_called, arguments, type, s, f) }
	through = function_parts(type)
	if through != ø { return typed_call_through(n, typed_called, arguments, through, s, f) }
	# a phrase headed by a value that is no function lists its items, `x -1` is [x, -1]
	if fact_of(n, PHRASED) != ø and function_value_parts(type) == ø { return typed_form(refitted(List([called] + arguments, Bracket.Square, Separator.Space), n), s, f, expected) }
	key = function_value_key(type) ?? return called_beyond(n, called, type, arguments, s, f, expected)
	definition = definition_keyed(key, s) ?? refused(called, "the typing stage found no function of this value")
	name = defined_name(define_of(definition, s))
	given = if is_lambda_key(key, s) then [called] + arguments else arguments
	call_typed(n, with_fact(with_binding(name, DefinitionKind.Function), DEFINED_AT, name), given, s, f, expected)
}
# a call of a word nothing defines on a value, `twice 3` read `3.twice()` (core/analyze/scope.wap field_called): its
# value and arguments typed once, offered to the typed rules first (`rule twice $x: int => $x + $x`), else the field's
word_call_offered(n: Node, called: Node, arguments: list, s: TypingState, f: TypeFrame, expected: Term?) as Node? := match called {
	Get(subject, key) => if not key is text or fact_of(subject, TYPED_HOLE) != ø or not definitions_named(text(key), s) is empty then ø else {
		held = ([subject] + arguments).map(part => marked_typed(typed_form(part, s, f, ø)))
		offered = refitted(Call(refitted(symbol(text(key)), called), held), n)
		fired = kind_rewritten(offered, s, f, expected)
		if fired != offered then fired else value_call_typed(n, refitted(Get(held#1, key), called), held.drop(1), s, f, expected)
	}
	_ => ø
}
# A call of a value of a function type, `helpers#1(x)` of a list<(int) -> int>: a call of whichever function it holds,
# at run time, each argument of the type's parameter type, giving its result type
typed_call_through(n: Node, called: Node, arguments: list, parts: FunctionType, s: TypingState, f: TypeFrame) as Node := {
	if #arguments != #parts.parameters { refused(n, "${type_text(value_type(called))} takes ${#parts.parameters} arguments") }
	typed = (1 to #arguments).map(at => {
		given = typed_form(arguments#at, s, f, parts.parameters#at)
		converted(given, parts.parameters#at, s, arguments#at, "the function takes")
	})
	with_type_of(refitted(Call(called, typed), n), parts.result)
}
# the name of the instance a function value of its own type takes for a function type, `inc` where `(int) -> int` is:
# its function typed for the type's parameters, giving the type's result, a function giving nothing gives ø (`go { hi() }`
# where a `() -> any` is); ø when it takes or gives others, or its result or the wanted one is not known yet
adapted_name(own: Term, wanted: Term, s: TypingState) as Node? := {
	parts = function_parts(wanted) ?? return ø
	# the name signs the type for good, so a type whose unknowns are still open waits till they settle (member_settled)
	if has_unknowns(wanted) { return ø }
	typed = value_function_typed(parts.parameters, own, s) ?? return ø
	# named by a value, its body runs wherever the value is called (types.wap site_reached)
	s.valued_functions.add(typed.function.key)
	# a function that gives nothing fits a type giving ø, `back: () -> ø = () => print("x")`
	way = conversion(result_given(typed) ?? return ø, parts.result, s)
	if not way in STATIC_CONVERSIONS { return ø }
	adapting = if way == Conversion.Same and (typed.arguments[#typed.arguments - #parts.parameters ..]) == (parts.parameters) then typed else shape_taking(typed, parts, s)
	declared_name(signed_name(adapting, s))
}
# Function values that meet where one type holds them, `[x => x + 1, x => x * 2]` or the arms of an if: their own types
# held by an unknown until a call through it or a written type settles it to a signature, each value then taking its
# instance for that signature; two of their own types join as such an unknown, which takes in each further one
functions_joined(a: Term, b: Term, s: TypingState) as Term? := {
	if function_value_parts(b) == ø { return ø }
	if function_value_parts(a) != ø { return member_added(member_added(unknown_type(s), a, s), b, s) }
	if s.members.has(variable_id(a)) then member_added(a, b, s) else ø
}
member_added(member: Term, own: Term, s: TypingState) as Term := {
	held = s.members.get(variable_id(member)) ?? []
	if not held.any(type => type == own) { s.members[variable_id(member)] = held + [own] }
	member
}
# A function value of its own type where a function type is wanted: of that type, naming the instance it takes for it;
# where an unknown holding function values is wanted, joined to them and of the unknown till it settles (member_settled)
function_converted(n: Node, wanted: Term, s: TypingState) as Node := {
	# a block's value is its last statement's, which converts: `h(n: int): (int) -> int := { x => x + n }`
	match n { Block(statements) => return with_type_of(refitted(Block(statements.take(#statements - 1) + [function_converted(statements.last, wanted, s)]), n), settled_type(wanted, s)); _ => ø }
	own = value_type(n)!
	type = settled_type(wanted, s)
	if s.members.has(variable_id(type)) { return with_fact(with_type_of(n, member_added(type, own, s)), FUNCTION_VALUE, type_fact(own)) }
	adapted = adapted_name(own, type, s) ?? refused(n, "a function value of ${type_text(own)} is used as ${type_text(type)}, which it does not take")
	with_fact(with_fact(with_type_of(n, type), FUNCTION_VALUE, type_fact(own)), ADAPTED, adapted)
}
# a function value an unknown held, as the unknown settled: of the signature, naming its instance for it; of its own
# type where the unknown holds any
member_settled(n: Node, s: TypingState) as Node := {
	own = fact_type(fact_of(n, FUNCTION_VALUE)) ?? return n
	type = value_type(n) ?? return n
	if fact_of(n, ADAPTED) != ø { return n }
	if type == ANY_TERM then with_type_of(n, own) else function_converted(with_type_of(n, own), type, s)
}
# A call of a value an unknown holding function values types, `fs[0](3)`: the unknown settled to the signature of the
# arguments' types and the result the values give for them, then called through it
members_called(n: Node, called: Node, arguments: list, member: Term, s: TypingState, f: TypeFrame) as Node := {
	given = arguments.map(argument => marked_typed(typed_form(argument, s, f, ø)))
	types = given.map(argument => value_of(argument, "to pass"))
	results = s.members[variable_id(member)].map(own => (value_function_typed(types, own, s) ?? refused(n, "a function value of ${type_text(own)} takes no (${types_text(types)})")).result)
	settled_by([Answer(variable_id(member), function_type_of(types, joined_all(results, s) ?? refused(n, "this function value's result is not known here: write its result type")))], s)
	typed_call_through(n, called, given, function_parts(settled_type(member, s))!, s, f)
}
# A function taking shapes where one taking their types is wanted, `pair_name(pair: Pair)` where `(Node) -> text` is, or
# giving a value the type's result holds converted, `x => 1` where `(any) -> any` is: a function the typing stage
# writes once, taking the function value's closure if it has one and those types, calling it and giving the type's
# result, so each shape is checked where the value is called, as a direct call checks it
# DEBT: An overloaded function is not a value yet: `parts.map(text)` types only as `parts.map(each => text(each))`,
#   since a value of a name with several definitions is refused until a written function type picks one. Paid off when
#   the expected `(Node) -> text` picks the overload: this goes back to `.map(text)`.
shape_taking(typed: TypedFunction, parts: FunctionType, s: TypingState) as TypedFunction := {
	definition = typed.function
	word = definition.name
	taken = typed.arguments[.. #typed.arguments - #parts.parameters] + parts.parameters
	name = name_once("${word}(${types_text(taken, yes)}) ${type_text(parts.result, yes)}", definition.definer, s)
	made = definitions_named(text(name), s)
	reads = parameters_of(name, taken)
	taking = if made is empty then dispatcher_made(name, reads, named_call(word, [definition], reads, name, s), [parts.result], s) else made#1
	function_typed(taking, taken, s, taking.definer)
}
# a value that is no function leaves its call to the functions of its name further out, said in a note
called_beyond(n: Node, called: Node, type: Term, arguments: list, s: TypingState, f: TypeFrame, expected: Term?) as Node := {
	beyond = fact_of(called, FUNCTIONS_BEYOND) ?? refused(called, "${called}: ${type_text(type)} is no function to call")
	hint(warning_of(n, "${called} here calls the function: the nearer ${called} is a ${type_text(type)}"))
	call_typed(n, with_fact(with_binding(placed_like(symbol(text(called)), called), DefinitionKind.Function), CANDIDATES, data_list([beyond])), arguments, s, f, expected)
}
# A function's name as a value, `apply(inc, 2)`: of a type of its own like a function value's, capturing nothing, so a
# call of the value is a call of that function; a name of several functions is the one the function type expected
# takes, `g: (int) -> text = quoted`
function_named_typed(n: Node, expected: Term?, s: TypingState) as Node := {
	named = if fact_of(n, CANDIDATES) == ø then n else overload_meant(n, expected, s)
	with_type_of(named, function_value_type(place_key(defined_at(named)), []))
}
# the one of a name's definitions that takes the parameters of the function type expected and gives its result
overload_meant(n: Node, expected: Term?, s: TypingState) as Node := {
	parts = function_parts(expected) ?? refused(n, "several functions have this name: write the function type wanted, `f: (int) -> text = ${n}`")
	chosen = chosen_definition(n, n, scoped_definitions(n, s), parts.parameters.map(type => with_type_of(placed_like(symbol(PARAMETER_WORD), n), type)), parts.result, s)
	with_fact(with_binding(placed_like(symbol(text(n)), n), DefinitionKind.Function), DEFINED_AT, defined_name(define_of(chosen, s)))
}
# whether what a call calls is a value, a name holding one or any other code giving one, `make(1)(2)`, rather than a
# function's name
holds_value(called: Node) as bool := not called is symbol or fact_of(called, BINDING) != ø and not names_function(called)
# whether a value given to a name changes a variable a function value has captured
changes_capture(name: Node, s: TypingState) as bool := {
	place_key(defined_at(name)) in s.captured and not is_definer(name)
}
