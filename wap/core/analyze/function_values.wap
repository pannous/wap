# Signature values in the typing stage (core/analyze/types.wap): `x => x + 1` and a function's name as values. Each
# has a type of its own, fn<key, capture types…> (core/stage.wap function_value_type), naming the function a call of
# the value calls, so that call is a direct call, typed for its arguments like any other (core/analyze/calls.wap).
# A function value's own function, its λ, takes the value as its first parameter, a struct of what it captures.

use "types.wap"
use "calls.wap"
use "letters.wap"
use "../errors.wap"
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"
use "fits.wap"
use "dispatch.wap"
use "declarations.wap"
use "../rules/typed.wap"
use "../rules/stages.wap"

# the names of a function value's own function and of its first parameter, the value itself
LAMBDA_NAME = "λ"
CLOSURE_NAME = "closure"

# A function value, `x => x + 1`: a function of its own, typed when a call of the value reaches it, whose first
# parameter is the value itself, holding the captures: the variables of the functions around it that it reads. Its
# type is its own, naming that function and the captures' types here, so a call of the value is a call of it.
# DEBT: Each function value is a type of its own: a call of a value calls its one function directly, so a variable or
#   parameter holds one `x => ...` only, an `if` choosing between two function values gives none, and a function's
#   name is a value the same way (one of several overloads not yet). Captures are copied when it is made, so a later
#   change of one is refused. Paid off by function references (a funcref beside the captures, call_ref).
function_value_typed(n: Node, parameters: Node, body: Node, s: TypingState, f: TypeFrame) as Node := {
	lambda = lambda_of(n, parameters, body, s)
	captures = captures_of(n).map(definer => type_keyed(place_key(definer), f.variables) ?? refused(definer, "a function value reads this before any value is given to it"))
	s.captured += captures_of(n).map(place_key)
	s.found_in[lambda.key] = f.present.filter(known => captures_of(n).any(definer => within(known.key, place_key(definer))))
	with_type_of(n, function_value_type(lambda.key, captures))
}
# the function of a function value, made once: named and placed where the value is written
lambda_of(n: Node, parameters: Node, body: Node, s: TypingState) as Signature := {
	name = name_for(LAMBDA_NAME, n)
	definition_keyed(place_key(name), s) ?? lambda_made(name, n, parameters, body, s)
}
lambda_made(name: Node, n: Node, parameters: Node, body: Node, s: TypingState) as Signature := {
	lambda = refitted(Define(name, with_items(parameters, [name_for(CLOSURE_NAME, n)] + items_of(parameters)), body), n)
	s.lambdas += [lambda]
	function_added(lambda, s)
}
# The captures a function value's function reads, each [key, type], from its first parameter, the value; none for a
# function of no function value
captured_by(definition: Node, types: list) as list<Binding> := {
	parts = if types is empty then ø else function_value_parts(types#1)
	captures = captures_of(definition)
	if parts == ø or text(parts#1) != function_key_of(definition) or captures is empty { return [] }
	(1 to #captures).map(at => Binding(place_key(captures#at), parts#(at + 1)))
}
# A call of a function value, `f(x)` where f holds `y => y + 1` or a function's name: a call of the value's function,
# a function value's own one taking the value as its first argument
value_call_typed(n: Node, called: Node, arguments: list, s: TypingState, f: TypeFrame, expected: Node?) as Node := {
	offered = word_call_offered(n, called, arguments, s, f, expected)
	if offered != ø { return offered }
	typed_called = typed_form(called, s, f, ø)
	type = value_type(typed_called)
	through = function_parts(type)
	if through != ø { return typed_call_through(n, typed_called, arguments, through, s, f) }
	parts = function_value_parts(type) ?? refused(called, "${called}: ${type_text(type)} is no function to call")
	key = text(parts#1)
	definition = definition_keyed(key, s) ?? refused(called, "the typing stage found no function of this value")
	name = declared_name(written_name(define_of(definition, s)))
	given = if is_lambda_key(key, s) then [called] + arguments else arguments
	call_typed(n, with_fact(with_binding(name, DefinitionKind.Function), DEFINED_AT, name), given, s, f, expected)
}
# a call of a word nothing defines on a value, `twice 3` read `3.twice()` (core/analyze/scope.wap field_called): its
# value and arguments typed once, offered to the typed rules first (`rule twice $x: int => $x + $x`), else the field's
word_call_offered(n: Node, called: Node, arguments: list, s: TypingState, f: TypeFrame, expected: Node?) as Node? := match called {
	Get(subject, key) => if not key is text or fact_of(subject, TYPED_HOLE) != ø or not definitions_named(text(key), s) is empty then ø else {
		held = ([subject] + arguments).map(part => marked_typed(typed_form(part, s, f, ø)))
		offered = refitted(Call(refitted(symbol(text(key)), called), held), n)
		fired = kind_rewritten(offered, s, f, expected)
		if fired != offered then fired else value_call_typed(n, refitted(Get(held#1, key), called), held.drop(1), s, f, expected)
	}
	_ => ø
}
# A call of a value of a function type, `helpers#1(x)` of a list<(int) -> int>: a call of whichever function it holds,
# at run time, each argument of the type's parameter type, giving its result type
typed_call_through(n: Node, called: Node, arguments: list, parts: FunctionType, s: TypingState, f: TypeFrame) as Node := {
	if #arguments != #parts.parameters { refused(n, "${type_text(value_type(called))} takes ${#parts.parameters} arguments") }
	typed = (1 to #arguments).map(at => {
		given = typed_form(arguments#at, s, f, parts.parameters#at)
		converted(given, parts.parameters#at, s, arguments#at, "the function takes")
	})
	with_type_of(refitted(Call(called, typed), n), parts.result)
}
# A function value where a function type is wanted, `inc` where `(int) -> int` is: its function typed for the type's
# parameters, giving the type's result, the value then of that type (core/stage.wap FUNCTION_VALUE); ø when its
# function takes or gives others
as_function_type(value: Node, wanted: Node, s: TypingState) as Node? := {
	parts = function_parts(wanted) ?? return ø
	own = value_type(value) ?? return ø
	typed = value_function_typed(parts.parameters, own, s) ?? return ø
	way = conversion(typed.result, parts.result, s)
	if not way in STATIC_CONVERSIONS { return ø }
	adapting = if way == Conversion.Same and same_types(typed.arguments[#typed.arguments - #parts.parameters ..], parts.parameters) then typed else shape_taking(typed, parts, s)
	with_fact(with_fact(with_type_of(value, wanted), FUNCTION_VALUE, own), ADAPTED, declared_name(signed_name(adapting, s)))
}
# A function taking shapes where one taking their types is wanted, `pair_name(pair: Pair)` where `(Node) -> text` is, or
# giving a value the type's result holds converted, `x => 1` where `(any) -> any` is: a function the typing stage
# writes once, taking the function value's closure if it has one and those types, calling it and giving the type's
# result, so each shape is checked where the value is called, as a direct call checks it
# DEBT: An overloaded function is not a value yet: `parts.map(text)` types only as `parts.map(each => text(each))`,
#   since a value of a name with several definitions is refused until a written function type picks one. Paid off when
#   the expected `(Node) -> text` picks the overload: this goes back to `.map(text)`.
shape_taking(typed: TypedFunction, parts: FunctionType, s: TypingState) as TypedFunction := {
	definition = typed.function
	word = definition.name
	taken = typed.arguments[.. #typed.arguments - #parts.parameters] + parts.parameters
	name = name_once("${word}(${taken.map(each => text(each)).join(", ")}) ${type_text(parts.result)}", definition.definer, s)
	made = definitions_named(text(name), s)
	reads = parameters_of(name, taken)
	taking = if made is empty then dispatcher_made(name, reads, named_call(word, [definition], reads, name, s), [parts.result], s) else made#1
	function_typed(taking, taken, s, taking.definer)
}
# the function type a function value's written signature gives, `(int) -> int` of `inc(a: int) as int`: ø unless
# its function writes each parameter's type and its result
written_function_type(type: Node?, s: TypingState) as Node? := {
	key = text((function_value_parts(type) ?? return ø)#1)
	definition = definition_keyed(key, s) ?? return ø
	taken = parameters_in(define_of(definition, s))[(if is_lambda_key(key, s) then 1 else 0) ..]
	result = definition.result ?? return ø
	types: list<Node> = []
	for parameter in taken {
		given = type_given(parameter) ?? return ø
		if has_letters(given, s.records) { return ø }
		types += [given]
	}
	function_type_of(types, result)
}
# A function's name as a value, `apply(inc, 2)`: of a type of its own like a function value's, capturing nothing, so a
# call of the value is a call of that function; a name of several functions is one only for a written function type
function_named_typed(n: Node) as Node := {
	if fact_of(n, CANDIDATES) != ø { refused(n, "several functions have this name; a value of one of them comes with written function types, not yet") }
	with_type_of(n, function_value_type(place_key(defined_at(n)), []))
}
# whether what a call calls is a value, a name holding one or any other code giving one, `make(1)(2)`, rather than a
# function's name
holds_value(called: Node) as bool := not called is symbol or fact_of(called, BINDING) != ø and not names_function(called)
# whether a value given to a name changes a variable a function value has captured
changes_capture(name: Node, s: TypingState) as bool := {
	place_key(defined_at(name)) in s.captured and not is_definer(name)
}
