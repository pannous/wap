# The groups of a graph whose members reach each other, its strongly connected components (Tarjan's walk): enums that
# name each other are one block (core/analyze/inductives.wap), functions that call each other share their effects.
# Each group comes once, after every group it reaches, so what a group reaches is always found before it.

# the walk so far: each key's place in the order it was met, the lowest place it reaches back to, the keys met on the
# way not yet grouped, and the groups found
class Walk { order: map<text, int> = {}; low: map<text, int> = {}; way: list<text> = []; on_way: map<text, bool> = {}; groups: list<list<text>> = [] }
# the groups of the keys, each key's next the keys it reaches in one step
groups_of(keys: list<text>, next: (text) -> list<text>) as list<list<text>> := {
	walk = Walk()
	for key in keys { if not walk.order.has(key) { walked(key, next, walk) } }
	walk.groups
}
# one key reached: the keys it reaches first; where none of them reaches back past it, it and the keys on the way
# after it are one group
walked(key: text, next: (text) -> list<text>, w: Walk) := {
	w.order[key] = #w.order
	w.low[key] = w.order[key]
	w.way += [key]
	w.on_way[key] = yes
	for other in next(key) {
		if not w.order.has(other) {
			walked(other, next, w)
			w.low[key] = min(w.low[key], w.low[other])
		} else if w.on_way.has(other) { w.low[key] = min(w.low[key], w.order[other]) }
	}
	if w.low[key] == w.order[key] {
		group = w.way.drop(w.way.index_of(key) - 1)
		w.way = w.way.take(w.way.index_of(key) - 1)
		for member in group { w.on_way.remove(member) }
		w.groups += [group]
	}
}
