# Enums as kernel inductive blocks (notes/coc-t5b.md "Enums as inductive blocks"): at the end of typing every enum
# the program and its library declare becomes a block of the compile's environment, its cases the block's
# constructors, and its word, the axiom every typed node already names, is filled by it (kernel/environment.wap
# declared_together): no typed node changes. Enums that name each other are one block. An enum stays the axiom it is
# where a field's type is open (a bare field, a letter) or where the kernel refuses its block (a field of the enum
# inside another type's parts), each counted by why.

use folder
use "../stage.wap"
use "../errors.wap"
use "../type_notation.wap"
use "../../kernel/terms.wap"
use "../../kernel/environment.wap"
use "../../kernel/inductive.wap"

# what became of an enum, by its word's id (TYPES.enums), as the census counts it
ENUM_DEFINED = "defined"
ENUM_OPEN = "open"
ENUM_REFUSED = "refused"
# a constructor's name: its enum's key, this mark and the case's name
CASE_MARK = "."

# every enum not met before entered, each with the enums it names that name it back, in the order of reading
enums_entered(records: list<Node>) := {
	enums = records.filter(record => cases_of(record) is not empty and not TYPES.enums.has(word_id(record_term(record))) and assumed_word(record_term(record)))
	words = enums.map(enum => word_id(record_term(enum)))
	named = enums.map(enum => enum_cases(enum).flat_map(case => case.fields).flat_map(field => constants_in(field ?? DATA_TERM).map(word => words.index_of(constant_id(word))).filter(at => at > 0)))
	reached = (1 to #enums).list().map(at => reached_from(at, named))
	for at in 1 to #enums {
		if not TYPES.enums.has(words#at) { block_entered((1 to #enums).list().filter(other => reached#at.contains(other) and reached#other.contains(at)).map(other => enums#other)) }
	}
}
# whether a word is still the axiom core declared it as, not yet filled by a block (bool is core's own)
assumed_word(word: Term) as bool := match declared_at(TYPES.environment, word_id(word))!.kind {
	Axiom => yes
	_ => no
}
# the places of the enums one reaches through its fields' types, its own first
reached_from(at: int, named: list<list<int>>) as list<int> := {
	seen = [at]
	waiting = named#at
	while waiting is not empty {
		next = waiting#1
		waiting = waiting.drop(1)
		if not seen.contains(next) {
			seen += [next]
			waiting += named#next
		}
	}
	seen
}
# an enum's case as the kernel reads it: its name and its fields' types, ø for a field whose type is open
class CaseTyped { name: text; binders: list<text>; fields: list<Term?> }
enum_cases(enum: Node) as list<CaseTyped> := cases_of(enum).map(case => CaseTyped(text(case_name(case)), case_fields(case).map(field => text(declared_name(field))), case_fields(case).map(field => closed_type(written_type(declared_type(field))))))
closed_type(type: Term?) as Term? := if type == ø or has_letters(type) or has_unknowns(type) then ø else type
# a case's constructor by its name: a core word's enum names its cases as core names its words, alone, so `enum bool {
# no, yes }` fills the truths core declared; any other's after its key, as two enums may each have a case so named
constructor_name(key: text, case: text) as text := if core_place(key) != ø then case else "${key}${CASE_MARK}${case}"
# One block of enums declared, filling their words, or each left the axiom it is, counted by why
block_entered(enums: list<Node>) := {
	words = enums.map(enum => record_term(enum))
	ids = words.map(word => word_id(word))
	keys = ids.map(id => declared_at(TYPES.environment, id)!.name)
	cases = enums.map(enum_cases)
	if cases.flat_map(each => each).any(case => case.fields.any(field => field == ø)) { return enums_counted(ids, ENUM_OPEN) }
	types = (1 to #enums).list().map(at => BlockType(keys#at, DATA_TERM, cases#at.map(case => WrittenCase(constructor_name(keys#at, case.name), case_type(case, words#at, ids, keys)))))
	try {
		inductive_declared(TYPES.environment, InductiveBlock([], 0, types))
		enums_counted(ids, ENUM_DEFINED)
	} catch refusal {
		refusal_only(refusal)
		hint(warning_of(enums#1, "the kernel refuses ${keys.join(", ")} as a block, so their cases have no recursor and a law over them is only tested: ${refusal.message}"))
		enums_counted(ids, ENUM_REFUSED)
	}
}
enums_counted(ids: list<int>, why: text) := for id in ids { TYPES.enums[id] = why }
# a case's type as a block writes it: a function of its fields giving its enum, under a binder for each type of the
# block, which stands where a field names one
case_type(case: CaseTyped, enum: Term, ids: list<int>, keys: list<text>) as Term := {
	fields = (1 to #case.fields).list().reverse.fold(enum, (body, at) => pi(case.binders#at, case.fields#at!, body))
	keys.reverse.fold(block_named(fields, ids, 0), (body, key) => pi(key, DATA_TERM, body))
}
# a term with each type of the block, named by its word's id, the binder standing for it this deep
block_named(t: Term, ids: list<int>, depth: int) as Term := match t.shape {
	Constant(name, levels, id) => if ids.contains(id) then bound(depth + #ids - ids.index_of(id)) else t
	Apply(function, argument) => apply(block_named(function, ids, depth), block_named(argument, ids, depth))
	Pi(binder, domain, body) => pi(binder, block_named(domain, ids, depth), block_named(body, ids, depth + 1))
	_ => t
}

# A case's value as a term: the constructor of its case applied to its fields, where its enum is a block and each
# field is given a value of its own type
case_term(n: Node, called: Node, arguments: list, x: Entering) as Term? := {
	definer = place_key(fact_of(called, DEFINED_AT) ?? return ø)
	enum = x.s.records.items.find(record => cases_of(record).any(case => place_key(case_name(case)) == definer)) ?? return ø
	word = record_term(enum)
	if value_type(n) != word or TYPES.enums.get(word_id(word)) != ENUM_DEFINED { return ø }
	name = constructor_name(declared_at(TYPES.environment, word_id(word))!.name, text(called))
	id = named_id(TYPES.environment, name) ?? return ø
	if not fields_given(declared_at(TYPES.environment, id)!.type, arguments) { return ø }
	terms_applied(constant(id, name, []), arguments, x)
}
# whether the values given are the fields a constructor's type takes, each of its field's own type
fields_given(type: Term, arguments: list) as bool := match type.shape {
	Pi(binder, domain, body) => arguments is not empty and value_type(arguments#1) == domain and fields_given(body, arguments.drop(1))
	_ => arguments is empty
}
# the enums met so far by what became of them, as the census prints them, the assumed ones named
enums_shown() as text := "${enums_were(ENUM_DEFINED)} enums defined in the kernel, ${enums_were(ENUM_OPEN) + enums_were(ENUM_REFUSED)} assumed: ${enums_were(ENUM_OPEN)} with a field of an open type, ${enums_were(ENUM_REFUSED)} refused${enums_named(ENUM_OPEN)}${enums_named(ENUM_REFUSED)}"
enums_were(why: text) as int := #TYPES.enums.values().filter(each => each == why)
enums_named(why: text) as text := TYPES.enums.keys().filter(id => TYPES.enums[id] == why).map(id => "; ${why}: ${declared_at(TYPES.environment, id)!.name}").join("")
