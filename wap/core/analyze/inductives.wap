# Enums as kernel inductive blocks (notes/coc-t5b.md "Enums as inductive blocks"): at the end of typing every enum
# the program and its library declare becomes a block of the compile's environment, its cases the block's
# constructors, and its word, the axiom every typed node already names, is filled by it (kernel/environment.wap
# declared_together): no typed node changes. Enums that name each other are one block. An enum stays the axiom it is
# where a field's type is open (a bare field, a letter), where its sort has indices, or where the kernel refuses its
# block (a field of the enum inside another type's parts), each counted by why.

use folder
use "../stage.wap"
use "../type_notation.wap"
use "../../kernel/terms.wap"
use "../../kernel/environment.wap"
use "../../kernel/inductive.wap"
use "groups.wap"
use "../../kernel/counting.wap"

# what became of an enum, by its word's id (TYPES.enums), as the census counts it
ENUM_DEFINED = "defined"
ENUM_OPEN = "open"
ENUM_REFUSED = "refused"

# an enum as a block reads it: its word, its type as its cases give it (the word applied to its letters, the block's
# parameters), its key in the environment, its sort, the indices' types first for a family (`enum Even: nat -> Prop`),
# ø for a sort not understood, and its cases
class EnumRead { word: Term; whole: Term; key: text; sort: Term?; cases: list<CaseTyped> }
# every enum not met before entered, each with the enums it names that name it back, the ones it names first
enums_entered(records: list<Node>, s: TypingState) := {
	enums: map<text, EnumRead> = {}
	for record in records.filter(record => cases_of(record) is not empty) {
		enum = enum_read(record, s)
		if not TYPES.enums.has(word_id(enum.word)) and assumed_word(enum.word) { enums[enum.key] = enum }
	}
	keys = enums.keys
	named = (key: text) => enums[key].cases.flat_map(case => case.fields).flat_map(field => constants_in(field ?? DATA_TERM).map(word => word_key(constant_id(word)))).filter(other => keys.contains(other))
	for group in groups_of(keys, named) { block_entered(group.map(key => enums[key])) }
}
enum_read(record: Node, s: TypingState) as EnumRead := {
	whole = record_term(record)
	word = head_of(whole)
	EnumRead(word, whole, word_key(word_id(word)), record_sort(record_declared(record)), enum_cases(record, parts_of(whole), s))
}
# a word's key, the name the environment declares it by
word_key(id: int) as text := declared_at(TYPES.environment, id)!.name
# whether a word is still the axiom core declared it as, not yet filled by a block (bool is core's own)
assumed_word(word: Term) as bool := match declared_at(TYPES.environment, word_id(word))!.kind {
	Axiom => yes
	_ => no
}
# an enum's case as the kernel reads it: its name, its definer's place, its fields' names and types, ø for a field
# whose type is open, the letters it finds (T6a3: a one-letter name its types write that is none of the enum's, an
# implicit binder in front of its fields) and the family member it gives, ø where it gives the enum itself
class CaseTyped { name: text; definer: text; binders: list<text>; fields: list<Term?>; found: list<Found> = []; result: Term? = ø; result_open: bool = no }
# marks a binder of a letter a case finds, so a call of the constructor can tell them from its fields
FOUND_MARK = "·"
# a letter a case finds: its word, standing for it in the types until the binders name it, and the type it has
class Found { word: Term; domain: Term }
enum_cases(enum: Node, letters: list<Term>, s: TypingState) as list<CaseTyped> := cases_of(enum).map(case => {
	found = found_distinct(found_written(case, letters), text(case_name(case)))
	allowed = letters + found.map(each => each.word)
	written = case_result(case)
	result = if written == ø then ø else closed_type(case_read(written, case, found, s), allowed)
	CaseTyped(text(case_name(case)), place_key(case_name(case)), case_fields(case).map(field => text(declared_name(field))), case_fields(case).map(field => closed_type(case_read(declared_type(field), case, found, s), allowed)), found, result, written != ø and result == ø)
})
# the letters a case's field types and result write, in the order written
# (a case's own field names are no letters it finds: `m` of `pair(m: nat, e: Even(m))` is a field)
found_written(case: Node, own: list<Term>) as list<Found> := {
	named = own + case_fields(case).map(field => word_term(text(declared_name(field))))
	(case_fields(case).map(field => declared_type(field)) + [case_result(case)]).flat_map(written => if written == ø then [] else found_in(written!, named))
}
# a one-letter name the program defines nowhere and the enum does not take
is_found_name(n: Node, own: list<Term>) as bool := n is symbol and #text(n) == 1 and fact_of(n, DEFINED_AT) == ø and not own.any(letter => type_text(letter) == text(n))
# the letters found in a written type: an argument of a family takes the family's header's type at its place, any
# other letter is a type
found_in(n: Node, own: list<Term>) as list<Found> := match n {
	Call(head, items) => {
		domains = domains_of(family_type(head) ?? DATA_TERM)
		(1 to #items).list().flat_map(at => if is_found_name(items#at, own) then [Found(word_term(text(items#at)), if at <= #domains then domains#at else DATA_TERM)] else found_in(items#at, own))
	}
	_ => if is_found_name(n, own) then [Found(word_term(text(n)), DATA_TERM)] else []
}
found_distinct(all: list<Found>, case: text) as list<Found> := all.fold([], (kept, each) => {
	same = kept.find(other => other.word == each.word)
	if same != ø and same!.domain != each.domain { raise("${case} writes ${type_text(each.word)} as a ${shown(same!.domain)} and as a ${shown(each.domain)}") }
	if same != ø then kept else kept + [each]
})
# a type a case writes as the kernel holds it: a family applied to values reads each value, any other type as written
case_read(written: Node?, case: Node, found: list<Found>, s: TypingState) as Term? := {
	if written == ø { return ø }
	match written! {
		Call(head, items) => if is_type_former(family_type(head)) then type_built(family_word(head), items.map(item => index_read(item, case, found, s))) else written_type(written)
		_ => written_type(written)
	}
}
# a value in a family's argument place read as a function's result is (terms.wap family_read): typed under the letters
# the case finds, each a parameter named by the case, then as a term, the letters its constants again (T6a3; GUESS: unbuilt)
index_read(item: Node, case: Node, found: list<Found>, s: TypingState) as Term := {
	letters = found.filter(each => each.domain != DATA_TERM)
	definers = letters.map(each => found_definer(each, case))
	written = (1 to #letters).list().fold(item, (body, at) => substituted(body, type_text(letters#at.word), definers#at))
	if not is_value_written(written) { return type_term(item) }
	frame = TypeFrame()
	for at in 1 to #letters { frame.variables += [Binding(place_key(definers#at), letters#at.domain)] }
	c = checker(TYPES.environment, [])
	locals = letters.map(each => entered(c, type_text(each.word), each.domain))
	reading = fresh_reading(c, instances_keyed(s.functions), s).under(locals, definers.map(definer => place_key(definer)))
	read = term_of(typed_form(written, s, frame, ø), reading) ?? refused(item, "an index may depend only on values the program computes without acting")
	(1 to #letters).list().fold(read, (body, at) => replaced_by(body, variable_id(locals#at.variable), letters#at.word))
}
# the parameter a letter a case finds is for the typing of its indices, named as the case's name is
found_definer(each: Found, case: Node) as Node := {
	bare = name_for(type_text(each.word), case_name(case))
	with_fact(with_binding(bare, DefinitionKind.Parameter), DEFINED_AT, bare)
}
# One block of enums declared, filling their words, each case's definer then naming its constructor, or each left the
# axiom it is, counted by why
block_entered(enums: list<EnumRead>) := {
	ids = enums.map(enum => word_id(enum.word))
	keys = enums.map(enum => enum.key)
	if enums.any(enum => enum.sort == ø or enum.cases.any(case => case.result_open or case.fields.any(field => field == ø))) { return enums_counted(ids, ENUM_OPEN) }
	headers = enums.map(header_of)
	try {
		types = enums.map(enum => BlockType(enum.key, header_of(enum), enum.cases.map(case => WrittenCase(case_constructed(enum.key, case.name), case_type(case, enum, ids, keys, headers)))))
		inductive_declared(TYPES.environment, InductiveBlock([], #parts_of(enums#1.whole), types))
	} catch refusal {
		refusal_only(refusal)
		# a refused enum is counted by the census, and a law over it says Tested, never Proved
		# TODO (card nested-inductive) the kernel takes an enum holding a list of itself, wap/nodes.wap's Node
		return enums_counted(ids, ENUM_REFUSED)
	}
	enums_counted(ids, ENUM_DEFINED)
	for enum in enums { for case in enum.cases { TYPES.constructors[case.definer] = named_id(TYPES.environment, case_constructed(enum.key, case.name))! } }
}
# an enum's header, the type its word was declared at: a function of its letters' types giving its sort
header_of(enum: EnumRead) as Term := declared_at(TYPES.environment, word_id(enum.word))!.type
domains_of(type: Term) as list<Term> := match type.shape {
	Pi(binder, domain, body) => [domain] + domains_of(body)
	_ => []
}
enums_counted(ids: list<int>, why: text) := for id in ids { TYPES.enums[id] = why }
# a case's type as a block writes it: a function of its fields giving its enum, under a binder for each of the enum's
# parameters, of the type its header gives it, under one for each type of the block; each binder stands where a field
# names its type
case_type(case: CaseTyped, enum: EnumRead, ids: list<int>, keys: list<text>, headers: list<Term>) as Term := {
	result = case.result ?? enum.whole
	if head_of(result) != head_of(enum.whole) { raise("${case.name} gives ${shown(result)}, and a case of ${enum.key} gives a ${enum.key}") }
	fields = (1 to #case.fields).list().reverse.fold(result, (body, at) => pi(case.binders#at, case.fields#at!, body))
	letters = parts_of(enum.whole)
	domains = domains_of(header_of(enum))
	outer = ids + letters.map(letter => word_id(letter))
	named = outer + case.found.map(each => word_id(each.word))
	found = (1 to #case.found).list().reverse.fold(block_named(fields, named, 0), (body, at) => pi(FOUND_MARK + type_text(case.found#at.word), block_named(case.found#at.domain, outer + case.found.take(at - 1).map(each => word_id(each.word)), 0), body))
	parameters = (1 to #letters).list().reverse.fold(found, (body, at) => pi(type_text(letters#at), domains#at, body))
	(1 to #keys).list().reverse.fold(parameters, (body, at) => pi(keys#at, headers#at, body))
}

# A case's value as a term: the constructor of the case it names applied to its enum's parameters, read off the
# value's type, and to its fields, where its enum is a block,
# each field given a value of its own type and the whole of the type the node has
case_term(n: Node, called: Node, arguments: list, x: Entering) as Term? := {
	id = TYPES.constructors.get(place_key(fact_of(called, DEFINED_AT) ?? return ø)) ?? return ø
	constructor = declared_constructor(id)
	parameters = parts_of(value_type(n) ?? return ø)
	if parameters.any(part => has_letters(part) or has_unknowns(part)) { return ø }
	opened = parameters.fold(constructor.type, (type, part) => match type.shape { Pi(binder, domain, body) => instantiated(body, part); _ => type })
	if found_count(opened) > 0 { return found_applied(id, constructor, parameters, opened, arguments, n, x) }
	if fields_given(opened, arguments) != value_type(n) { return ø }
	terms_applied(apply_all(constant(id, constructor.name, []), parameters), arguments, x)
}
# how many letters a case finds, the binders in front of its fields
found_count(type: Term) as int := match type.shape {
	Pi(binder, domain, body) => if binder.starts_with(FOUND_MARK) then 1 + found_count(body) else 0
	_ => 0
}
# A call of a case that finds letters (T6a3): each letter a hole, solved from the kernel's type of each argument given
# where a field's type writes it (`Even.step(Even.zero)` takes n from `Even(0)`), then from the type wanted where only
# the result writes it, and the call refused where neither tells which; the result is not unified with the type wanted
# when the arguments gave every letter, the kernel's conversion compares `Even(0 + 2 + 2)` with `Even(4)` (GUESS: unbuilt)
found_applied(id: int, constructor: Declaration, parameters: list<Term>, opened: Term, arguments: list, n: Node, x: Entering) as Term? := elaborated_over(x.c, el => {
	holes: list<Term> = []
	names: list<text> = []
	type = opened
	for at in 1 to found_count(opened) {
		match type.shape {
			Pi(binder, domain, body) => {
				made = hole(el, binder, domain)
				holes += [made]
				names += [binder.split(FOUND_MARK).last]
				type = instantiated(body, made)
			}
			_ => ø
		}
	}
	given = arguments.map(argument => term_of(argument, x))
	if given.any(term => term == ø) { return ø }
	for term in given {
		match type.shape {
			Pi(binder, domain, body) => {
				if not unified(el, domain, type_of(el.c, term!)) { return ø }
				type = instantiated(body, term!)
			}
			_ => return ø
		}
	}
	wanted = kernel_value(n)
	if holes.any(made => is_hole(el, filled(el, made))) and wanted != ø { unified(el, type, wanted!) }
	if not problems_retried(el) { return ø }
	solved = holes.map(made => filled(el, made))
	open = (1 to #solved).list().filter(at => is_hole(el, solved#at)).map(at => names#at)
	if open is not empty { raise("${constructor.name} cannot tell which ${open.join(", ")} it means: write the type wanted, or an argument that has it") }
	apply_all(apply_all(constant(id, constructor.name, []), parameters + solved), given.map(term => term!))
})
# whether a case finds letters, a marked binder anywhere in its type
finds_letters(type: Term) as bool := match type.shape {
	Pi(binder, domain, body) => binder.starts_with(FOUND_MARK) or finds_letters(body)
	_ => no
}
# the type a constructor gives for these values, each of its field's own type; ø where they are other values
fields_given(type: Term, arguments: list) as Term? := match type.shape {
	Pi(binder, domain, body) => if arguments is not empty and value_type(arguments#1) == domain then fields_given(body, arguments.drop(1)) else ø
	_ => if arguments is empty then type else ø
}
# the enums met so far by what became of them, as the census prints them, the assumed ones named
enums_shown() as text := "${enums_were(ENUM_DEFINED)} enums defined in the kernel, ${enums_were(ENUM_OPEN) + enums_were(ENUM_REFUSED)} assumed: ${enums_were(ENUM_OPEN)} with a field of an open type, ${enums_were(ENUM_REFUSED)} refused${enums_named(ENUM_OPEN)}${enums_named(ENUM_REFUSED)}"
enums_were(why: text) as int := #TYPES.enums.values().filter(each => each == why)
enums_named(why: text) as text := TYPES.enums.keys().filter(id => TYPES.enums[id] == why).map(id => "; ${why}: ${word_key(id)}").join("")
