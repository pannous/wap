# Generic letters and unknown item types in the typing stage (core/analyze/calls.wap): what a call binds a definition's
# letters to, and the item type of an empty list that a later use settles.

use folder
use "../errors.wap"
use "../stage.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"
use "../../kernel/terms.wap"
use "../bindings.wap"

# Generic letters (wiki/type.md "Foreign type names and generic letters"): a one-letter type name, `f(x: T)`, stands
# for the type its argument gives, every T of one signature the same; `list<T>` takes a list of any one item type. A
# letter the program declares as a class or an enum is that type.
LETTERS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
is_letter(type: Term?) as bool := is_word(type) and #type_text(type) == 1 and LETTERS.contains(type_text(type)) and declared_by(type) == ø
# (a level letter, the u of Sort(u), is one too)
has_letters(type: Term?) as bool := is_letter(type) or type != ø and type!.holds_parameter or (type_parts(type) ?? []).any(part => has_letters(part))
# An empty list's item type before a use settles it, α1, α2 … (data.wap list_typed): a hole of the typing state's
# elaboration (holes.wap), bound like a letter by the calls that use the list and answered so, `xs + [1]` settles it
# to int; filled in everywhere once the program is typed, any where nothing answered it
UNSETTLED = "this value's type is not settled yet where a function without a written result type takes it: write its type, `xs: list<int> = []`"
unknown_type(s: TypingState) as Term := {
	unknown_hole = hole(s.el, UNKNOWN_MARK, DATA_TERM)
	s.unknowns[variable_id(unknown_hole)] = unknown_hole
	unknown_hole
}
is_unknown(type: Term?) as bool := type != ø and variable_id(type!) != 0
holds_type(type: Term, part: Term) as bool := type == part or (type_parts(type) ?? []).any(each => holds_type(each, part))
has_unknowns(type: Term?) as bool := type != ø and type!.holds_free
# a parameter of a bare `list` or `enum` takes any list or enum alike, so an unknown item type it is given forces no
# instance of its own: `#[]` is 0 (a typed instance found again once its unknowns settle)
takes_any_item(written: Term?) as bool := is_word(written) and CONTAINER_KINDS.contains(type_text(written!))
# whether a given type fits a wanted one by settling unknowns, settling them
settles(given: Term, wanted: Term, s: TypingState) as bool := {
	if not has_unknowns(given) and not has_unknowns(wanted) { return no }
	bound = unified(wanted, given, [], s) ?? return no
	settled_by(bound, s)
	yes
}
# the unknowns a call's answers settled, remembered for every later use
settled_by(answers: list<Answer>, s: TypingState) := {
	for answer in answers {
		unknown_hole = s.unknowns.get(answer.hole)
		if unknown_hole != ø and is_unknown(filled(s.el, unknown_hole!)) { unknown_settled(unknown_hole!, answered(answer.type, answers), s) }
	}
}
# an unknown settled to a type, remembered for every later use; one holding function values takes a further one in
# instead, and settles only to their signature (core/analyze/function_values.wap member_settled)
unknown_settled(unknown_hole: Term, type: Term, s: TypingState) := {
	if functions_joined(unknown_hole, type, s) != ø { return }
	key = variable_id(unknown_hole)
	# each value it holds typed for the signature now, while typing still settles what the instance asks
	if s.members.has(key) and function_parts(type) != ø { for own in s.members[key] { adapted_name(own, type, s) } }
	# a call's letter holes are reused by every call of its definition, so no answer may hold one
	if has_letter_holes(type, s) or not unified(s.el, unknown_hole, type) { raise("the unknown item type ${type_text(unknown_hole)} settles to ${type_text(type)}, which it cannot hold") }
}
# A call of a function for types an unknown still holds: typed once the unknowns settle, so no instance is made for a
# guess; meanwhile of its written result type, which a function typed later must write
deferred_typed(definition: Signature, types: list, letters: list<Binding>, s: TypingState, at: Node) as TypedFunction := {
	typed = TypedFunction(definition, types)
	typed.result = type_substituted(definition.result ?? refused(at, UNSETTLED), letters)
	s.deferred += [Deferred(definition, types, at, typed)]
	typed
}
# every unknown settled, one nothing settled as any (it held no item that mattered), then the deferred calls' functions
# typed for the settled types; a function's own deferred calls are typed in turn
all_settled(s: TypingState) := {
	while s.deferred or s.unknowns.values().any(unknown_hole => is_unknown(filled(s.el, unknown_hole))) {
		for hole in s.unknowns.keys() { settled_by([Answer(hole, ANY_TERM)], s) }
		waiting = s.deferred
		s.deferred = []
		for call in waiting {
			settled = function_typed(call.definition, call.types.map(type => settled_type(type, s)), s, call.at)
			s.settled_calls[called_key(call.given, s)] = declared_name(signed_name(settled, s))
		}
	}
}
# the key of the instance a call names, its unknowns settled
called_key(typed: TypedFunction, s: TypingState) as text := place_key(facts_settled(declared_name(signed_name(typed, s)), s))
# instances of a function its unknowns settled alike are one, the first kept: `empty` typed for a list<α7> and then
# for the list<Definition> α7 settles to
distinct_instances(functions: list<TypedFunction>, s: TypingState) as list<TypedFunction> := {
	s.functions = []
	s.instances = {}
	# each instance's settled argument types, found once per instance, by its function's key
	kept: map<text, list<list<Term>>> = {}
	for typed in functions {
		key = typed.function.key
		types = settled_arguments(typed, s)
		alike = kept.get(key) ?? []
		if not alike.any(other => other == types) {
			kept[key] = alike + [types]
			instance_added(typed, s)
		}
	}
	s.functions
}
# whether a typed function is the instance of this key for these settled argument types
same_instance(typed: TypedFunction, key: text, types: list<Term>, s: TypingState) as bool := typed.function.key == key and settled_arguments(typed, s) == types
settled_arguments(typed: TypedFunction, s: TypingState) as list<Term> := typed.arguments.map(type => settled_type(type, s))
# typed code with every unknown settled, the names its calls name too
settled_everywhere(n: Node, s: TypingState) as Node := {
	whole = facts_settled(refitted(with_parts(n, part => settled_everywhere(part, s)), n), s)
	definer = fact_of(whole, DEFINED_AT) ?? return whole
	settled = facts_settled(definer, s)
	with_fact(whole, DEFINED_AT, s.settled_calls.get(place_key(settled)) ?? settled)
}
# a node whose type and signature hold no unknown
facts_settled(n: Node, s: TypingState) as Node := {
	for fact in [TYPE, SIGNATURE] {
		type = fact_type(fact_of(n, fact))
		if type != ø and has_unknowns(type) { n = with_fact(n, fact, type_fact(settled_type(type!, s))) }
	}
	member_settled(n, s)
}

# What a call binds: its definition's letters by name, for the types the definition writes, and the answers it finds
# for the unknowns its argument types hold, by the hole's id
class Called { letters: list<Binding>; answers: list<Answer> }
# an answer for a hole, a letter's or an unknown's, by the hole's id
class Answer { hole: int; type: Term }
answer_of(hole: int, answers: list<Answer>) as Term? := {
	for answer in answers { if answer.hole == hole { return answer.type } }
	ø
}
NOTHING_CALLED = Called([], [])
# What a definition's parameters bind for these argument types; ø when the arguments don't fit them (a T bound to two
# types). Signature types come last: a function value's function is typed for parameter types the other parameters
# bound, `map(xs: list<T>, f: (T) -> U)` binds U by typing f for T.
letters_bound(definition: Signature, types: list, s: TypingState, denoted: list<Term?> = []) as Called? := {
	bound: list<Answer> = []
	levels = level_letters(definition, s) ?? return ø
	letters = letter_holes(definition, s) + levels
	# a parameter named by a letter, the T of `identity(T: Sort(u), a: T)`, binds it to the type it is given
	for at in 1 to #denoted { if denoted#at != ø { bound = letter_named(definition, at, s, letters, denoted#at!, bound) ?? return ø } }
	# and a letter the call gives a type in front, `identity[1](text, "a")` (calls.wap implicit_typed)
	for given in s.letters_given.get(definition.name) ?? [] { bound = unified(type_keyed(given.key, letters)!, given.type, bound, s) ?? return ø }
	written = parameters_holed(definition, s).map(type => substituted(type, levels))
	in_order = (1 to #types).filter(at => function_parts(written#at) == ø) + (1 to #types).filter(at => function_parts(written#at) != ø)
	for at in in_order {
		wanted = written#at
		# a letter an earlier argument bound, wanted of a value that wraps into it, is checked by conversion as the call
		# fits its arguments, not unified again: `add(xs, 3)` of a list<int?> takes the 3 as an int?. Other bound letters
		# are unified again, which settles unknown item types
		held = if is_unknown(wanted) then answer_of(variable_id(wanted!), bound) else ø
		wraps = held != ø and conversion(types#at, held, s) == Conversion.Wrapped
		if wanted != ø and not wraps and (has_letter_holes(wanted, s) or wanted!.holds_parameter or function_parts(wanted) != ø or has_unknowns(types#at) and not takes_own_type(wanted, s.records)) { bound = unified(wanted, types#at, bound, s) ?? return ø }
	}
	called_as(letters, bound, s)
}
# each letter as its hole is answered, one answered by nothing left out, and the unknowns answered, for the call to
# settle
called_as(letters: list<Binding>, bound: list<Answer>, s: TypingState) as Called := {
	held = letters.map(letter => Binding(letter.key, levels_filled(answered(letter.type, bound), s))).filter(letter => not is_unknown(letter.type) or s.unknowns.has(variable_id(letter.type)))
	Called(held, bound.filter(answer => s.unknowns.has(answer.hole)).map(answer => Answer(answer.hole, answered(answer.type, bound))))
}
# a type with the levels found so far in it, `Sort(1)` of a `Sort(u)` whose u a call found 1
levels_filled(type: Term, s: TypingState) as Term := if type.holds_parameter then filled(s.el, type) else type
# the level letters a definition's parameters write, in the order they first appear
level_names(definition: Signature) as list<text> := definition.parameters.flat_map(type => if type == ø then [] else term_levels(type!)).unique().filter(name => not is_level_hole(name))
# the letter a definition's parameter at that place is named by, bound to the type it is given; as bound where it is
# named otherwise
letter_named(definition: Signature, at: int, s: TypingState, letters: list<Binding>, given: Term, bound: list<Answer>) as list<Answer>? := {
	hole = type_keyed(text(declared_name(parameters_in(definition, s)#at)), letters) ?? return bound
	unified(hole, given, bound, s)
}
# the level letters a definition's parameters write, `u` of `T: Sort(u)`, each a level hole of the call's own (two
# calls find two levels) or the level it writes; ø where it writes another count
level_letters(definition: Signature, s: TypingState) as list<Binding>? := {
	names = level_names(definition)
	# levels the call writes, `identity[1](…)`, are the letters' in the order they first appear, as many as there are
	written = s.levels_written.get(definition.name) ?? []
	if written is empty { return names.map(name => Binding(name, universe(level_hole(s.el)))) }
	if #written != #names { return ø }
	levels_bound(names, written)
}
# level letters bound to the universes of these levels, in order
levels_bound(names: list<text>, levels: list<Level>) as list<Binding> := (1 to #names).map(at => Binding(names#at, universe(levels#at)))
# The letters a definition's parameters write, each a hole of the definition's own, by its letter. A call binds them
# in a list of its own, so two calls of `first(xs: list<T>)` bind two Ts, and the holes are made once
letter_holes(definition: Signature, s: TypingState) as list<Binding> := {
	made = s.letter_holes.get(definition.key)
	if made != ø { return made! }
	holes: list<Binding> = []
	# a record's parameters are its case's letters, `a` of `enum And(a: Prop, b: Prop)` too
	named = if definition.record == ø then [] else record_letters(record_declared(definition.record!)).map(letter => text(letter)) + found_names(definition)
	for letter in named + definition.parameters.flat_map(type => letters_in(type)) { if type_keyed(letter, holes) == ø { holes += [Binding(letter, hole(s.el, letter, DATA_TERM))] } }
	s.letter_holes[definition.key] = holes
	holes
}
# a definition's parameter types with its letters as their holes, as a call binds them
parameters_holed(definition: Signature, s: TypingState) as list<Term?> := definition.parameters.map(type => substituted(type, letter_holes(definition, s)))
# the letters a case of a family finds, T6a3 (inductives.wap found_written)
found_names(definition: Signature) as list<text> := if definition.member != ø then found_written(definition.member!, record_letters(record_declared(definition.record!))).map(each => type_text(each.word)) else []
letters_in(type: Term?) as list<text> := if is_letter(type) then [type_text(type)] else (type_parts(type) ?? []).flat_map(part => letters_in(part))
# whether a type holds the hole of a call's letter, not an unknown item type
has_letter_holes(type: Term?, s: TypingState) as bool := is_unknown(type) and not s.unknowns.has(variable_id(type!)) or (type_parts(type) ?? []).any(part => has_letter_holes(part, s))
# the letters bound so far with those a wanted type binds against a given one, ø when they don't fit; code that never
# gives a value, `return 0`, binds none
unified(wanted: Term, given: Term?, bound: list<Answer>, s: TypingState) as list<Answer>? := {
	if given == ø { return ø }
	# a bare ø binds as the optional of a type its uses settle, as a name given only ø holds one
	if given == EMPTY_TERM { return unified(wanted, optional_type(unknown_type(s)), bound, s) }
	if is_unknown(wanted) { return bound_as(wanted, given, bound, s) }
	if is_unknown(given) { return bound_as(given, wanted, bound, s) }
	# a value binds an optional's type as its own, `T?` given an int binds T to int, given an any or ø binds T to any
	if wraps(wanted, given) { return unified(base_of_optional(wanted)!, given, bound, s) }
	wanted_function = function_parts(wanted)
	if wanted_function != ø and function_value_parts(given) != ø { return function_value_bound(wanted_function, given, bound, s) }
	# a value binds as the type it reads as, a range's `T` of a list<T> an int
	read = read_type(given, wanted, s.records)
	if read != ø and type_parts(read) != ø and type_parts(wanted) != ø { return unified(wanted, read, bound, s) }
	# two universes are one where their levels are, `Sort(u)` given a `Sort(1)` finds u
	wanted_level = universe_level(wanted)
	given_level = universe_level(given)
	if wanted_level != ø and given_level != ø { return if levels_unified(s.el, wanted_level!, given_level!) then bound else ø }
	wanted_parts = type_parts(wanted)
	given_parts = type_parts(given)
	# a type that fits as it is binds nothing: a shape's value where its type is wanted, a Call where a Node is
	if wanted_parts == ø or given_parts == ø or #wanted_parts != #given_parts { return if given == wanted or (narrowed_type(given) ?? given) == wanted then bound else ø }
	for at in 1 to #wanted_parts { bound = unified(wanted_parts#at, given_parts#at, bound, s) ?? return ø }
	bound
}
# whether a value not written as an optional is given where the written type is one: wrapped into it, never taken as it is, an
# any too, whose optional is itself
wraps(written: Term?, given: Term?) as bool := base_of_optional(written) != ø and base_of_optional(given) == ø
# the letters bound with a letter or an unknown bound to a type: as it is bound already, or bound now
bound_as(letter: Term, type: Term, bound: list<Answer>, s: TypingState) as list<Answer>? := {
	hole = variable_id(letter)
	held = answer_of(hole, bound)
	if held == ø { return if type == letter then bound else if holds_type(answered(type, bound), letter) then itself_bound(letter, bound, s) else bound + [Answer(hole, type)] }
	# a letter bound to any, or to number, takes each value that boxes into it: a map as a map<text, any>'s value
	if held == type or conversion(type, held, s) == Conversion.Read or boxed_fit(type, held) { return bound }
	if has_unknowns(held) or has_unknowns(type) { return unified(held, type, bound, s) }
	# a letter bound to a function type takes a function value of that type: `xs.add(a => f(a))`
	if function_parts(held) != ø and function_value_parts(type) != ø { return unified(held, type, bound, s) }
	# bound to a type and to one it reads as, boxes into or is as it is, the letter is that one: `same(["/"], paths)` of
	# chars and texts, `m["a"] = 7` of a map<any, any>, `check(v: T, e: T)` of a list<bool or char> and a list<bool or
	# text>
	if boxed_fit(held, type) or conversion(held, type, s) in [Conversion.Same, Conversion.Read] { return bound.filter(answer => answer.hole != hole) + [Answer(hole, type)] }
	# bound to a shape and to the type it narrows, the letter is that type: `[Call(…)] + inner` of a list<Node> adds
	# two list<Node>s
	if conversion(type, held, s) == Conversion.Same { return bound }
	ø
}
# a type holding the letter itself, `α1` for map<text, α1>: no type is that, so a generic letter binds none, while an
# unknown, a value's type a use settles, settles as any: `out = {}; section = out; section = {}; out["a"] = section`
# makes out a map<text, any>, as untyped nested maps are (decision untyped-nested-maps)
itself_bound(letter: Term, bound: list<Answer>, s: TypingState) as list<Answer>? := if s.unknowns.has(variable_id(letter)) then bound + [Answer(variable_id(letter), ANY_TERM)] else ø
# the type a value of the given type reads as where the wanted one is, by that type's word (calls.wap as_read): an
# atom as its case where a Node is (nodes.wap Node(…)), an enum's case as the Symbol of its text, a char as its text, a range as its list of ints
# (wiki/conversion.md "a range is a list of its numbers"); ø for others
read_type(given: Term?, wanted: Term?, records: Records) as Term? := {
	if wanted == NODE_TERM and given != ø and (type_text(given) in ATOM_TYPES or given != NODE_TERM and bare_fit(given, ENUM_TERM, records)) { return wanted }
	read_of(given)
}
# whether a value of the given type is read as one of the held type: an atom as a Node, a char as its text, a range as
# a list
reads_as(held: Term, given: Term, records: Records) as bool := {
	read = read_type(given, held, records) ?? return no
	held == read or held == (word_term(type_word(read)))
}
# the letters bound with those a function value binds against a function type, [parameter types, result type]: its
# function typed for the parameter types, its result the type's result; ø when it takes others or gives another
function_value_bound(wanted: FunctionType, value: Term, bound: list<Answer>, s: TypingState) as list<Answer>? := {
	# a letter only the value's written parameter types bind, `f: (A) -> B` given double_it(x: int), bound so first; a
	# letter bound already stays, `(value: any)` where `(T)` of a list<text> is takes texts
	own = written_parameters(value, #wanted.parameters, s)
	known = (1 to #own).fold(bound, (held, at) => if own#at == ø or not has_letter_holes(answered(wanted.parameters#at, held), s) then held else unified(wanted.parameters#at, own#at!, held, s) ?? held)
	parameters = wanted.parameters.map(type => answered(type, known))
	if parameters.any(type => has_letter_holes(type, s)) { return ø }
	result = result_given(value_function_typed(parameters, value, s) ?? return ø) ?? return ø
	unified(wanted.result, result, known, s) ?? (if conversion(result, wanted.result, s) in STATIC_CONVERSIONS then known else ø)
}
# the parameter types a function value's definition writes, the last count of them (a function value's own takes its
# value first), ø where one is untyped or holds a letter; none for a value taking fewer, which takes others
written_parameters(value: Term, count: int, s: TypingState) as list<Term?> := {
	definition = definition_keyed(function_value_key(value) ?? return [], s) ?? return []
	if #definition.parameters < count { return [] }
	definition.parameters.drop(#definition.parameters - count).map(type => if type == ø or has_letters(type!) then ø else type)
}
# the function of a value of this type, typed for these parameter types, a function value's own one taking the value
# first; ø when its parameters take others
value_function_typed(parameters: list<Term>, type: Term?, s: TypingState) as TypedFunction? := {
	given = type ?? return ø
	key = function_value_key(given) ?? return ø
	definition = definition_keyed(key, s) ?? return ø
	closure = if is_lambda_key(key, s) then [given] else []
	if #definition.parameters != #closure + #parameters { return ø }
	typed = function_typed(definition, closure + parameters, s, define_of(definition, s))
	# its parameters take the wanted ones as a call would: converted, `(x: float)` where `(int)` is, `(value: any)` where
	# `(text)` is, or a shape of it, `(pair: Pair)` where `(Node)` is; the adapter (adapted_name) makes the call
	taken = typed.arguments[#closure ..]
	if (1 to #parameters).all(at => conversion(parameters#at, taken#at, s) in STATIC_CONVERSIONS + [Conversion.Narrowed]) then typed else ø
}
is_lambda_key(key: text, s: TypingState) as bool := s.lambdas.has(key)
# a written type with its letters replaced by the types they are bound to, none where none is given
substituted(type: Term?, bound: list<Binding>) as Term? := if type == ø then ø else type_substituted(type, bound)
# a type with the unknowns it holds settled: only a type holding one looks them up
settled_type(type: Term, s: TypingState) as Term := if has_unknowns(type) then filled(s.el, type) else type
settled_optional(type: Term?, s: TypingState) as Term? := if type == ø then ø else settled_type(type, s)
type_substituted(type: Term, bound: list<Binding>) as Term := {
	if bound is empty { return type }
	# the level letters a call bound, each to the universe of its level
	levels = bound.filter(letter => universe_level(letter.type) != ø)
	if type.holds_parameter and not levels is empty { type = with_levels(type, levels.map(letter => letter.key), levels.map(letter => universe_level(letter.type)!)) }
	if universe_level(type) != ø { return universe_plain(universe_level(type)!) }
	# a word the program declared is its own type, never a letter of the same name
	if is_word(type) and declared_by(type) == ø {
		held = type_keyed(type_text(type), bound) ?? return type
		return if held == type then type else type_substituted(held, bound)
	}
	parts = type_parts(type) ?? return type
	type_built(parts#1, (2 to #parts).map(at => type_substituted(parts#at, bound)))
}
# a type with the holes it holds replaced by their answers
answered(type: Term, answers: list<Answer>) as Term := {
	if answers is empty or not type.holds_free { return type }
	hole = variable_id(type)
	if hole != 0 {
		held = answer_of(hole, answers) ?? return type
		return if held == type then type else answered(held, answers)
	}
	parts = type_parts(type) ?? return type
	type_built(parts#1, (2 to #parts).map(at => answered(parts#at, answers)))
}
