# Generic letters and unknown item types in the typing stage (core/analyze/calls.wap): what a call binds a definition's
# letters to, and the item type of an empty list that a later use settles.

use folder
use "../errors.wap"
use "../stage.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"
use "../bindings.wap"

# Generic letters (wiki/type.md "Foreign type names and generic letters"): a one-letter type name, `f(x: T)`, stands
# for the type its argument gives, every T of one signature the same; `list<T>` takes a list of any one item type. A
# letter the program declares as a class or an enum is that type.
LETTERS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
is_letter(type: Node?, records: Records) as bool := type is symbol and #text(type) == 1 and LETTERS.contains(text(type)) and record_named(records, type) == ø
has_letters(type: Node?, records: Records) as bool := is_letter(type, records) or (type_parts(type) ?? []).any(part => has_letters(part, records))
# An empty list's item type before a use settles it, α1, α2 … (data.wap list_typed): bound like a letter by the calls
# that use the list, `xs + [1]` settles it to int; settled everywhere once the program is typed, any where none did
UNKNOWN_MARK = "α"
UNSETTLED = "this value's type is not settled yet where a function without a written result type takes it: write its type, `xs: list<int> = []`"
unknown_type(s: TypingState) as Node := {
	s.unknowns += 1
	symbol(UNKNOWN_MARK + text(s.unknowns))
}
is_unknown(type: Node?) as bool := type is symbol and text(type).starts_with(UNKNOWN_MARK)
holds_type(type: Node, part: Node) as bool := type == part or (type_parts(type) ?? []).any(each => holds_type(each, part))
has_unknowns(type: Node?) as bool := is_unknown(type) or (type_parts(type) ?? []).any(has_unknowns)
# a parameter of a bare `list` or `enum` takes any list or enum alike, so an unknown item type it is given forces no
# instance of its own: `#[]` is 0 (a typed instance found again once its unknowns settle)
takes_any_item(written: Node?) as bool := written is symbol and CONTAINER_KINDS.contains(text(written))
# whether a given type fits a wanted one by settling unknowns, settling them
settles(given: Node, wanted: Node, s: TypingState) as bool := {
	if not has_unknowns(given) and not has_unknowns(wanted) { return no }
	bound = unified(wanted, given, [], s) ?? return no
	settled_by(bound, s)
	yes
}
# the unknowns a call's binding settled, remembered for every later use
settled_by(bound: list<Binding>, s: TypingState) := {
	for binding in bound { if is_unknown(symbol(binding.key)) and type_keyed(binding.key, s.settled) == ø { unknown_settled(binding.key, type_substituted(binding.type, bound), s) } }
}
# an unknown settled to a type, remembered for every later use; one holding function values takes a further one in
# instead, and settles only to their signature (core/analyze/function_values.wap member_settled)
unknown_settled(key: text, type: Node, s: TypingState) := {
	if functions_joined(symbol(key), type, s) != ø { return }
	# each value it holds typed for the signature now, while typing still settles what the instance asks
	if s.members.has(key) and function_parts(type) != ø { for own in s.members[key] { adapted_name(own, type, s) } }
	s.settled += [Binding(key, type)]
}
# A call of a function for types an unknown still holds: typed once the unknowns settle, so no instance is made for a
# guess; meanwhile of its written result type, which a function typed later must write
deferred_typed(definition: Signature, types: list, letters: list<Binding>, s: TypingState, at: Node) as TypedFunction := {
	typed = TypedFunction(definition, types)
	typed.result = type_substituted(definition.result ?? refused(at, UNSETTLED), letters)
	s.deferred += [Deferred(definition, types, at, typed)]
	typed
}
# every unknown settled, one nothing settled as any (it held no item that mattered), then the deferred calls' functions
# typed for the settled types; a function's own deferred calls are typed in turn
all_settled(s: TypingState) := {
	while s.deferred or #s.settled < s.unknowns {
		for at in 1 to s.unknowns { settled_by([Binding(UNKNOWN_MARK + text(at), ANY_SYMBOL)], s) }
		waiting = s.deferred
		s.deferred = []
		for call in waiting {
			settled = function_typed(call.definition, call.types.map(type => settled_type(type, s)), s, call.at)
			s.settled_calls[called_key(call.given, s)] = declared_name(signed_name(settled, s))
		}
	}
}
# the key of the instance a call names, its unknowns settled
called_key(typed: TypedFunction, s: TypingState) as text := place_key(facts_settled(declared_name(signed_name(typed, s)), s))
# instances of a function its unknowns settled alike are one, the first kept: `empty` typed for a list<α7> and then
# for the list<Definition> α7 settles to
distinct_instances(functions: list<TypedFunction>, s: TypingState) as list<TypedFunction> := {
	s.functions = []
	s.instances = {}
	# each instance's settled argument types, found once per instance, by its function's key
	kept: map<text, list<list<Node>>> = {}
	for typed in functions {
		key = typed.function.key
		types = settled_arguments(typed, s)
		alike = if kept.has(key) then kept[key] else []
		if not alike.any(other => same_types(other, types)) {
			kept[key] = alike + [types]
			instance_added(typed, s)
		}
	}
	s.functions
}
# whether a typed function is the instance of this key for these settled argument types
same_instance(typed: TypedFunction, key: text, types: list<Node>, s: TypingState) as bool := typed.function.key == key and same_types(settled_arguments(typed, s), types)
settled_arguments(typed: TypedFunction, s: TypingState) as list<Node> := typed.arguments.map(type => settled_type(type, s))
# typed code with every unknown settled, the names its calls name too
settled_everywhere(n: Node, s: TypingState) as Node := {
	whole = facts_settled(refitted(with_parts(n, part => settled_everywhere(part, s)), n), s)
	definer = fact_of(whole, DEFINED_AT)
	if definer == ø { return whole }
	settled = facts_settled(definer, s)
	with_fact(whole, DEFINED_AT, if s.settled_calls.has(place_key(settled)) then s.settled_calls[place_key(settled)] else settled)
}
# a node whose type and signature hold no unknown
facts_settled(n: Node, s: TypingState) as Node := {
	for fact in [TYPE, SIGNATURE] {
		type = fact_of(n, fact)
		if type != ø and has_unknowns(type) { n = with_fact(n, fact, settled_type(type, s)) }
	}
	member_settled(n, s)
}

# The letters a definition's parameters bind for these argument types, each [letter, type]; ø when the arguments don't
# fit them (a T bound to two types). Signature types come last: a function value's function is typed for parameter
# types the other parameters bound, `map(xs: list<T>, f: (T) -> U)` binds U by typing f for T.
letters_bound(definition: Signature, types: list, s: TypingState) as list<Binding>? := {
	bound = []
	written = definition.parameters
	in_order = (1 to #types).filter(at => function_parts(written#at) == ø) + (1 to #types).filter(at => function_parts(written#at) != ø)
	for at in in_order {
		wanted = written#at
		# a letter an earlier argument bound, wanted of a value that wraps into it, is checked by conversion as the call
		# fits its arguments, not unified again: `add(xs, 3)` of a list<int?> takes the 3 as an int?. Other bound letters
		# are unified again, which settles unknown item types
		held = if is_letter(wanted, s.records) then type_keyed(text(wanted), bound) else ø
		wraps = held != ø and conversion(types#at, held, s) == Conversion.Wrapped
		if wanted != ø and not wraps and (has_letters(wanted, s.records) or function_parts(wanted) != ø or has_unknowns(types#at) and not takes_own_type(wanted, s.records)) { bound = unified(wanted, types#at, bound, s) ?? return ø }
	}
	bound
}
# the letters bound so far with those a wanted type binds against a given one, ø when they don't fit; code that never
# gives a value, `return 0`, binds none
unified(wanted: Node, given: Node?, bound: list<Binding>, s: TypingState) as list<Binding>? := {
	if given == ø { return ø }
	# a bare ø binds as the optional of a type its uses settle, as a name given only ø holds one
	if given == EMPTY_SYMBOL { return unified(wanted, optional_type(unknown_type(s)), bound, s) }
	records = s.records
	if is_letter(wanted, records) or is_unknown(wanted) { return bound_as(wanted, given, bound, s) }
	if is_unknown(given) { return bound_as(given, wanted, bound, s) }
	# a value binds an optional's type as its own, `T?` given an int binds T to int, given an any or ø binds T to any
	if wraps(wanted, given) { return unified(base_of_optional(wanted)!, given, bound, s) }
	wanted_function = function_parts(wanted)
	if wanted_function != ø and function_value_parts(given) != ø { return function_value_bound(wanted_function, given, bound, s) }
	# a value binds as the type it reads as, a range's `T` of a list<T> an int
	read = read_type(given, wanted, s.records)
	if read != ø and type_parts(read) != ø and type_parts(wanted) != ø { return unified(wanted, read, bound, s) }
	wanted_parts = type_parts(wanted)
	given_parts = type_parts(given)
	# a type that fits as it is binds nothing: a shape's value where its type is wanted, a Call where a Node is
	if wanted_parts == ø or given_parts == ø or #wanted_parts != #given_parts { return if same_type(given, wanted) or same_type(narrowed_type(given) ?? given, wanted) then bound else ø }
	for at in 1 to #wanted_parts { bound = unified(wanted_parts#at, given_parts#at, bound, s) ?? return ø }
	bound
}
# whether a value not written as an optional is given where the written type is one: wrapped into it, never taken as it is, an
# any too, whose optional is itself
wraps(written: Node?, given: Node?) as bool := base_of_optional(written) != ø and base_of_optional(given) == ø
# the letters bound with a letter or an unknown bound to a type: as it is bound already, or bound now
bound_as(letter: Node, type: Node, bound: list<Binding>, s: TypingState) as list<Binding>? := {
	held = type_keyed(text(letter), bound)
	if held == ø { return if type == letter then bound else if holds_type(type_substituted(type, bound), letter) then itself_bound(letter, bound) else bound + [Binding(text(letter), type)] }
	# a letter bound to any, or to number, takes each value that boxes into it: a map as a map<text, any>'s value
	if same_type(held, type) or reads_as(held, type, s.records) or boxed_fit(type, held) { return bound }
	if has_unknowns(held) or has_unknowns(type) { return unified(held, type, bound, s) }
	# a letter bound to a function type takes a function value of that type: `xs.add(a => f(a))`
	if function_parts(held) != ø and function_value_parts(type) != ø { return unified(held, type, bound, s) }
	# bound to a shape and to the type it narrows, the letter is that type: `[Call(…)] + inner` of a list<Node> adds
	# two list<Node>s
	if same_type(narrowed_type(type) ?? type, held) { return bound }
	if same_type(narrowed_type(held) ?? held, type) { return bound.filter(binding => binding.key != text(letter)) + [Binding(text(letter), type)] }
	ø
}
# a type holding the letter itself, `α1` for map<text, α1>: no type is that, so a generic letter binds none, while an
# unknown, a value's type a use settles, settles as any: `out = {}; section = out; section = {}; out["a"] = section`
# makes out a map<text, any>, as untyped nested maps are (decision untyped-nested-maps)
itself_bound(letter: Node, bound: list<Binding>) as list<Binding>? := if is_unknown(letter) then bound + [Binding(text(letter), ANY_SYMBOL)] else ø
# the type a value of the given type reads as where the wanted one is, by that type's word (calls.wap as_read): an
# atom as its case where a Node is (nodes.wap Node(…)), an enum's case as the Symbol of its text, a char as its text, a range as its list of ints
# (wiki/conversion.md "a range is a list of its numbers"); ø for others
read_type(given: Node?, wanted: Node?, records: Records) as Node? := {
	if wanted == NODE_SYMBOL and given != ø and (text(given) in ATOM_TYPES or given != NODE_SYMBOL and bare_fit(given, ENUM_SYMBOL, records)) { return wanted }
	if given == symbol(CHAR_TYPE) then TEXT_SYMBOL else if given == RANGE_SYMBOL then list_type(INT_SYMBOL) else ø
}
# whether a value of the given type is read as one of the held type: an atom as a Node, a char as its text, a range as
# a list
reads_as(held: Node, given: Node, records: Records) as bool := {
	read = read_type(given, held, records) ?? return no
	same_type(held, read) or same_type(held, symbol(type_word(read)))
}
# the letters bound with those a function value binds against a function type, [parameter types, result type]: its
# function typed for the parameter types, its result the type's result; ø when it takes others or gives another
function_value_bound(wanted: FunctionType, value: Node, bound: list<Binding>, s: TypingState) as list<Binding>? := {
	parameters = wanted.parameters.map(type => type_substituted(type, bound))
	if parameters.any(type => has_letters(type, s.records)) { return ø }
	result = (value_function_typed(parameters, value, s) ?? return ø).result ?? return ø
	unified(wanted.result, result, bound, s) ?? (if conversion(result, wanted.result, s) in STATIC_CONVERSIONS then bound else ø)
}
# the function of a value of this type, fn<key, capture types…>, typed for these parameter types, a function value's
# own one taking the value first; ø when its parameters take others
value_function_typed(parameters: list<Node>, type: Node?, s: TypingState) as TypedFunction? := {
	given = type ?? return ø
	key = text((function_value_parts(given) ?? return ø)#1)
	definition = definition_keyed(key, s) ?? return ø
	closure = if is_lambda_key(key, s) then [given] else []
	if #definition.parameters != #closure + #parameters { return ø }
	typed = function_typed(definition, closure + parameters, s, define_of(definition, s))
	# its parameters take the wanted ones as a call would: converted, `(x: float)` where `(int)` is, `(value: any)` where
	# `(text)` is, or a shape of it, `(pair: Pair)` where `(Node)` is; the adapter (adapted_name) makes the call
	taken = typed.arguments[#closure ..]
	if (1 to #parameters).all(at => conversion(parameters#at, taken#at, s) in STATIC_CONVERSIONS + [Conversion.Narrowed]) then typed else ø
}
is_lambda_key(key: text, s: TypingState) as bool := s.lambdas.any(lambda => function_key_of(lambda) == key)
# a type with its letters replaced by the types they are bound to, none where none is given
substituted(type: Node?, bound: list<Binding>) as Node? := if type == ø then ø else type_substituted(type, bound)
# a type with the unknowns it holds settled: only a type holding one looks them up
settled_type(type: Node, s: TypingState) as Node := if has_unknowns(type) then type_substituted(type, s.settled) else type
settled_optional(type: Node?, s: TypingState) as Node? := if type == ø then ø else settled_type(type, s)
type_substituted(type: Node, bound: list<Binding>) as Node := {
	if bound is empty { return type }
	if type is symbol {
		held = type_keyed(text(type), bound) ?? return type
		return if held == type then type else type_substituted(held, bound)
	}
	parts = type_parts(type) ?? return type
	type_built(text(parts#1), (2 to #parts).map(at => type_substituted(parts#at, bound)))
}
