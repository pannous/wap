# The library a program is bound in (core/pipeline.wap library_code_of): the types module bound but for its functions,
# each bound when typing first reaches one, so a program binds only the library functions it calls. Input: the
# types lowered; output: its statements, the functions unbound (UNBOUND), and the scope they bind in.
use folder
use "../stage.wap"
use "../bindings.wap"
use "../../kernel/forms.wap"

class Library { code: Block; scopes: map<text, Scope>; signatures: list<Signature> = [] }
# a module of the library bound but for its functions, each bound in the module's scope once typing reaches it: the
# scope is kept for each file its statements come from, those it includes too
library_bound(library: Block, modules: list<Module>, types: list<Signature> = []) as Library := {
	known = identified_program(library, types, modules)
	scopes: map<text, Scope> = {}
	for statement in known.statements { scopes[file_of(statement) ?? ""] = known.scope }
	Library(finished(known, known.statements.filter(statement => not defines_type(statement)).map(statement => if statement is Define then with_fact(statement, UNBOUND, True) else bound(statement, known.scope, PROGRAM_DEPTH))), scopes)
}
# a program's statements, their defining names identified, and the scope they bind in
class Identified { code: Node; statements: list<Node>; scope: Scope; ids: Definers }
identified_program(program: Block, types: list<Signature>, modules: list<Module>, standard: map<text, list<text>> = {}) as Identified := {
	clashes_refused(modules)
	ids = definers_of(program)
	identified = definers_identified(program, ids)
	statements = statements_in(identified)
	Identified(identified, statements, block_scope(identified, statements, scope_around(types, modules, standard), PROGRAM_DEPTH), ids)
}
# the program of these statements, its late reads checked, its definers counted
finished(known: Identified, statements: list<Node>) as Node := with_definers(late_reads_checked(refitted(Block(statements), known.code)), known.ids)
# a library function bound once typing reaches it, in the library's scope; any other definition as it is
reached_bound(define: Node, scopes: map<text, Scope>) as Node := if fact_of(define, UNBOUND) == True then bound(with_fact(define, UNBOUND, False), (scopes.get(file_of(define)!) ?? raise "no scope for ${file_of(define)!} among ${scopes.keys.join(', ')}"), PROGRAM_DEPTH) else define
