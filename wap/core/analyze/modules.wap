# The modules a program uses, as the binding analysis sees them (core/analyze/scope.wap): each by its file's name,
# two defining one name refused naming both, and a module's word named by the module, `a.twice`. Languages: bound.

use "../errors.wap"
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"
use folder

# the words of the modules a program uses, each module named too; a word an earlier module defines identically is
# that module's, one word
modules_scope(modules: list<Module>) as list<Definition> := (1 to #modules).flat_map(at => [Definition(module_name(modules#at.code), DefinitionKind.Module, modules#at.code, MODULE_DEPTH)] + modules#at.signatures.filter(signature => not modules.take(at - 1).any(earlier => defines_identically(earlier, modules#at, signature))).flat_map(signature => library_words(signature, MODULE_DEPTH)))
# a module's name, its file's without the folder and the extension
module_name(module: Node) as text := (file_of(module) ?? "").split("/").last.split(".")#1
# the names a module declares itself: its functions, variables and types, not their fields or cases
module_names(module: Node) as list := signatures_of(module).map(signature => signature.definer)
# Two used modules defining one word alike, refused naming both, even where nothing calls it: the same name taking the
# same parameter types, or one type's or variable's name, unless both definitions are identical; words of one name
# taking other types are one word's overloads
clashes_refused(modules: list<Module>) := for later in 2 to #modules {
	for earlier in modules.take(later - 1) {
		for signature in modules#later.signatures {
			for other in earlier.signatures { if alike(other, signature) and not defines_identically(earlier, modules#later, signature) { refused(signature.definer, "${module_name(earlier.code)}.wap line ${line_of(other.definer)} and ${module_name(modules#later.code)}.wap line ${line_of(signature.definer)} both define ${described(signature)}: rename one") } }
		}
	}
}
# whether an earlier module defines a module's word identically: alike, and its code read alike
defines_identically(earlier: Module, module: Module, signature: Signature) as bool := earlier.signatures.any(other => alike(other, signature) and definition_text(earlier.code, other) == definition_text(module.code, signature))
# a module's definition of a word as code reads, without its places: two identical ones read alike
definition_text(module: Node, signature: Signature) as text := text(defining_statement(module, signature) ?? signature.definer)
# whether two modules may not both define these words: one name, both functions taking the same parameter types, or
# neither a function
alike(one: Signature, other: Signature) as bool := one.name == other.name and is_function(one) == is_function(other) and (not is_function(one) or same_types(parameter_types(one), parameter_types(other)))
# a function's parameter types, an untyped one Empty
parameter_types(signature: Signature) as list<Node> := signature.parameters.map(type => type ?? Empty)
# a word as two modules may not both write it: `twice(int)`, a type's or a variable's bare name
described(signature: Signature) as text := if is_function(signature) then "${signature.name}(${signature.parameters.map(type => text(type ?? "")).join(", ")})" else signature.name
# A used module's word named by the module, `a.twice(3)`, read as twice(a, 3) is: the definitions of
# that name the module declares, bound as the bare name would be were they the only ones; ø where the subject names no
# module, or names something nearer, a variable `a`
module_word(n: Node, subject: Node, key: text, scope: Scope) as Node? := {
	if not subject is symbol or definitions_meant(text(subject), scope) { return ø }
	for definition in named_in(scope, text(subject)) {
		if definition.kind == DefinitionKind.Module {
			named = module_names(definition.definer).filter(name => text(name) == key)
			if named is empty { refused(n, "${subject}.wap defines no ${key}") }
			found = with_binding(placed_like(symbol(key), n), DefinitionKind.Library)
			return if #named == 1 then with_fact(found, DEFINED_AT, named#1) else with_fact(found, CANDIDATES, data_list([data_list(named)]))
		}
	}
	ø
}
# a call of a used module's word, `a.twice(3)`, its other arguments bound; ø for any other call
module_call(n: Node, called: Node, arguments: list, scope: Scope, depth: int) as Node? := {
	if not called is symbol or arguments is empty { return ø }
	word = module_word(called, arguments#1, text(called), scope) ?? return ø
	refitted(Call(word, all_bound(arguments.drop(1), scope, depth)), n)
}
# A program adds to a function every program has only for a type it declares (wiki/function.md): its function of such
# a name takes a class or an enum of the program; a class's maker belongs to the class, a rule's function to its form
overloads_checked(modules: list<Module>, library: Scope) := {
	signatures = modules.flat_map(module => module.signatures)
	own = signatures.filter(signature => signature.kind == DefinitionKind.Record).map(signature => signature.name)
	for signature in signatures {
		if signature.kind == DefinitionKind.Function and named_in(library, signature.name).any(definition => definition.depth == PROGRAM_DEPTH and is_function(definition)) and not (own.contains(signature.name) or has_fact(signature.definer, DERIVED) or signature.parameters.any(type => names_type(type, own))) { refused(signature.definer, "${signature.name} is a function every program has: a program adds to it only for a type it declares, `${signature.name}(s: Ship) := …`; give this one another name") }
	}
}
# whether a written type names one of these types, inside list<…>, an optional or a function type too
names_type(type: Node?, names: list<text>) as bool := type != ø and (names.contains(text(type!)) or (type_parts(type) ?? []).any(part => names_type(part, names)))
