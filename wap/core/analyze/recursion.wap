# A structural recursion enters the kernel (notes/coc-t5c3.md): a function matching a parameter of a program's enum
# and calling itself on that value's fields is the enum's course, `Tree·course(motive, step, t)`. The motive gives the
# other parameters' function type, so a call may change them; the step is the match on the value, the values below it
# riding the match, and a call on a field of the case is the field's hypothesis in them (courses.wap).

use folder
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../../kernel/terms.wap"
use "../../kernel/environment.wap"
use "../../kernel/inductive.wap"
use "courses.wap"
use "terms.wap"

# the function being read and the place of the parameter matched
class Recursion { key: text; place: int; fields: list<text> = [] }
# (fields: the keys of the case's fields that hold values below, in the order of those values)
# the binder of the values below the case's value, which the match rides
BELOW_BINDER = "·below"

# a function whose body matches one of its parameters, as the course of that parameter's enum; ø for any other
# (x: the reading under the function's parameters)
course_defined(typed: TypedFunction, body: Node, x: Entering) as Term? := match body {
	Case(subject, arms) => {
		place = x.binders.index_of(place_key(fact_of(subject, DEFINED_AT) ?? return ø))
		if place <= 0 { return ø }
		domain = kernel_settled(typed.arguments#place, x.s)
		if TYPES.enums.get(word_id(domain)) != ENUM_DEFINED or block_of(TYPES.environment, domain, "course").block.parameters != 0 { return ø }
		match course_of(TYPES.environment, constant_name(domain)) {
			Through(name) => course_applied(typed, place, domain, arms, x)
			Without(reason) => ø
		}
	}
	_ => ø
}
course_applied(typed: TypedFunction, place: int, domain: Term, arms: list, x: Entering) as Term? := {
	s = x.s
	result = kernel_settled(typed.result ?? return ø, s)
	others = (1 to #x.binders).list().filter(at => at != place)
	motive = lambda("x", domain, others.reverse.fold(result, (body, at) => pi("_", kernel_settled(typed.arguments#at, s), body)))
	below_of = (value: Term) => apply_all(constant_of(TYPES.environment, constant_name(domain) + BELOW_SUFFIX, [TYPE_LEVEL]), [motive, value])
	riding_value = entered(x.c, "y", domain)
	riding = lambdas([riding_value], pi("below", below_of(riding_value.variable), result))
	step_value = entered(x.c, "x", domain)
	step_below = entered(x.c, "below", below_of(step_value.variable))
	step_others = others.map(at => entered(x.c, "_", kernel_settled(typed.arguments#at, s)))
	step_locals = [step_value, step_below] + step_others
	inside = Entering([x.binders#place, NO_BINDER] + others.map(at => x.binders#at), variables(step_locals), x.c, x.by_key, s, Recursion(instance_key(typed), place))
	minors = block_of(TYPES.environment, domain, "course").block.types#1.cases.map(case => case_minor(named_id(TYPES.environment, case.name)!, arms, domain, riding, value => below_of(value), inside))
	if minors.any(minor => minor == ø) { return ø }
	step = lambdas(step_locals, apply(recursor_applied(domain, riding, minors.map(minor => minor!) + [step_value.variable]), step_below.variable))
	course = apply_all(constant_of(TYPES.environment, constant_name(domain) + COURSE, [TYPE_LEVEL]), [motive, step, x.variables#place])
	apply_all(course, others.map(at => x.variables#at))
}
# a call of the function being read on a field of the case matched: that field's hypothesis in the values below, given
# the other arguments; ø for any other call
recursive_called(called: Node, arguments: list, x: Entering) as Term? := {
	r = x.recursion ?? return ø
	if place_key(fact_of(called, DEFINED_AT) ?? return ø) != r.key or #arguments < r.place { return ø }
	field = arguments#(r.place)
	at = r.fields.index_of(place_key(fact_of(field, REBOUND) ?? fact_of(field, DEFINED_AT) ?? return ø))
	if at <= 0 { return ø }
	pair = TYPES.environment.products!.pair
	rest = (2 to at).list().fold(x.variables#(x.binders.index_of(BELOW_BINDER)), (path, step) => projection(pair, 2, path))
	terms_applied(projection(pair, 1, projection(pair, 1, rest)), arguments.take(r.place - 1) + arguments.drop(r.place), x)
}
