# A structural recursion enters the kernel (notes/coc-t5c3.md): a function matching a parameter of a program's enum
# and calling itself on that value's fields is the enum's course, `Tree·course(motive, step, t)`. The motive gives the
# other parameters' function type, so a call may change them; the step is the match on the value, the values below it
# riding the match, and a call on a field of the case is the field's hypothesis in them (courses.wap).

use folder
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"
use "../../kernel/terms.wap"
use "../../kernel/environment.wap"
use "../../kernel/inductive.wap"
use "../../kernel/typing.wap"
use "../../kernel/compute.wap"
use "../../kernel/equal.wap"
use "../../kernel/recursors.wap"
use "../../kernel/counting.wap"
use "../../kernel/logic.wap"
use "../../kernel/equality.wap"
use "courses.wap"
use "sizes.wap"
use "terms.wap"

# the function being read, the place of the parameter its recursion takes apart, and inside a course's step that
# parameter's value `held` with the step's variable `of` standing for the value taken apart, and the parameter's
# values at the fields of the case whose values below hold hypotheses, in the order of those values, and the checker
# its reading computes by the count's equations with, one per recursion (kernel equating)
# (a recursion that ends by a measure reads the calls by measured, its place 0)
class Recursion { key: text; place: int; held: Term? = ø; of: Term? = ø; fields: list<Term> = []; equating: Checker? = ø; measured: Measured? = ø }
# the binder of the values below the case's value, which the match rides
BELOW_BINDER = "·below"
# how many times a choice may take values apart before its condition decides
GUARD_DEPTH = 4
# the checker a recursion's reading computes by the count's equations with: the recursion's own, made once, so its
# budget and memories serve the whole reading
equations_checker(x: Entering) as Checker := (x.recursion ?? return equating(x.c)).equating ?? equating(x.c)

# a function whose body matches one of its parameters, or chooses by a condition that waits on one, as the course of
# that parameter's enum; ø for any other (x: the reading under the function's parameters)
course_defined(typed: TypedFunction, body: Node, x: Entering) as Term? := match body {
	Case(subject, arms) => {
		place = x.binders.index_of(place_key(fact_of(subject, DEFINED_AT) ?? return ø))
		if place <= 0 { return ø }
		domain = kernel_settled(typed.arguments#place, x.s)
		if TYPES.enums.get(word_id(domain)) != ENUM_DEFINED or block_of(TYPES.environment, domain, "course").block.parameters != 0 or not one_motive(domain) { return ø }
		match course_of(TYPES.environment, constant_name(domain)) {
			Through(name) => course_applied(typed, place, x.variables#place, domain, (id, riding, below, inside) => arm_minor(id, arms, Recursed([domain], [riding]), below, inside), x)
			Without(reason) => ø
		}
	}
	If(condition, then_part, else_part) => {
		by_equations = equations_checker(x)
		waiting = waiting_on(by_equations, computed(by_equations, term_of(condition, x) ?? return ø)) ?? return ø
		place = x.variables.index_where(variable => same(variable, waiting))
		if place <= 0 { return ø }
		guard_read(body, condition, then_part, else_part, reread(x, x.binders, x.variables, Recursion(instance_key(typed), place, equating: by_equations)))
	}
	_ => ø
}
# A choice inside a recursion: where the condition computes, the part chosen; where it waits on a free variable, that
# variable's type taken apart with the choice again in every case, until the condition computes (wiki/Footguns.md
# "Deciding termination"). So `if n <= 0 then 1 else n * f(n - 1)` on a whole number reads the call where n is
# natural(successor(c)), n - 1 computing to natural(c), the hypothesis for c. The reading computes by the count's
# equations too (kernel equating): Lean's m - 1 waits on m where its equations give the count before
guard_read(n: Node, condition: Node, then_part: Node, else_part: Node, x: Entering, depth: int = 0) as Term? := {
	by_equations = equations_checker(x)
	value = computed(by_equations, term_of(condition, x) ?? return ø)
	verdict = truth_value(TYPES.environment, value)
	if verdict != ø { return term_of(if verdict! then then_part else else_part, x) }
	if depth >= GUARD_DEPTH { return ø }
	variable = waiting_on(by_equations, value) ?? return ø
	split_read(variable, kernel_value(n) ?? return ø, x, inside => guard_read(n, condition, then_part, else_part, inside, depth + 1))
}
# a free variable's type taken apart, read in each case: by its recursor, or by its course where the type holds itself
# and the variable lies in the parameter recursed on (and no course is open already)
split_read(variable: Term, result: Term, x: Entering, read: (Entering) -> Term?) as Term? := {
	r = x.recursion ?? return ø
	domain = kernel_type(type_of(x.c, variable)) ?? return ø
	if not taken_apart(domain) { return ø }
	if not recursive_enum(domain) { return plain_split(variable, domain, result, x, read) }
	typed = x.by_key.get(r.key) ?? return ø
	if r.held != ø or not holds_variable(x.variables#(r.place), variable) { return ø }
	match course_of(TYPES.environment, constant_name(domain)) {
		Through(name) => course_applied(typed, r.place, variable, domain, (id, riding, below, inside) => minor_of(id, ø, Recursed([domain], [riding]), below, inside, (taken, value) => read(valued(taken, inside.recursion!.of!, value))), x)
		Without(reason) => ø
	}
}
plain_split(variable: Term, domain: Term, result: Term, x: Entering, read: (Entering) -> Term?) as Term? := taken_apart_into(domain, lambda("_", domain, result), (id, r) => minor_of(id, ø, r, value => ø, x, (inside, value) => read(valued(inside, variable, value))), variable, x)
# whether a type is one enum of one type that may be taken apart into any universe, and whether a case holds itself
taken_apart(domain: Term) as bool := match (declaration(TYPES.environment, constant_name(domain)) ?? return no).kind {
	Inductive(facts) => facts.any_motive and #facts.plain.types == 1
	_ => no
}
recursive_enum(domain: Term) as bool := block_of(TYPES.environment, domain, "match").block.types#1.cases.any(case => parameter_types(declared_at(TYPES.environment, named_id(TYPES.environment, case.name)!)!.type).contains(domain))
holds_variable(t: Term, variable: Term) as bool := not same(abstracted(t, variable_id(variable)), t)
# The free variable a term's computing waits on: the value its recursor takes apart, or what that value waits on; ø
# for a term that waits on none
waiting_on(c: Checker, t: Term) as Term? := {
	stuck = computed(c, t)
	match head(stuck).shape {
		Free(id) => if arguments(stuck) is empty then stuck else ø
		Constant(name, levels, id) => match (declared_at(c.environment, id) ?? return ø).kind {
			Recursor(facts) => if #arguments(stuck) <= before_major(facts) then ø else waiting_on(c, arguments(stuck)#(before_major(facts) + 1))
			_ => ø
		}
		_ => ø
	}
}
# the course of the variable's type, its step the choice or match read in each of the type's cases (minor_for makes
# one case's minor premise); the parameters other than the one recursed on ride as the step's own binders
course_applied(typed: TypedFunction, place: int, variable: Term, domain: Term, minor_for: (int, Term, (Term) -> Term?, Entering) -> Term?, x: Entering) as Term? := {
	s = x.s
	result = kernel_result(typed, x.by_key, s) ?? return ø
	others = (1 to #typed.arguments).list().filter(at => at != place)
	# GUESS (item 4): the motive and the step's binders read the others' types with the recursed parameter taken for the step's own
	locals = parameters_locals(typed, s, x.by_key)
	recursed_id = variable_id(locals#place.variable)
	motive_value = entered(x.c, "x", domain)
	taking = (term: Term) => replaced_by(term, recursed_id, motive_value.variable)
	motive = lambdas([motive_value], pis(others.map(at => Local(locals#at.binder, taking(locals#at.domain), locals#at.variable)), taking(result)))
	below_of = (value: Term) => apply_all(constant_of(TYPES.environment, constant_name(domain) + BELOW_SUFFIX, [TYPE_LEVEL]), [motive, value])
	riding_value = entered(x.c, "y", domain)
	riding = lambdas([riding_value], pi("below", below_of(riding_value.variable), apply(motive, riding_value.variable)))
	step_value = entered(x.c, "x", domain)
	step_below = entered(x.c, "below", below_of(step_value.variable))
	step_others = others.map(at => entered(x.c, "_", replaced_by(locals#at.domain, recursed_id, step_value.variable)))
	step_locals = [step_value, step_below] + step_others
	held = replaced_by(x.variables#place, variable_id(variable), step_value.variable)
	inside = reread(x, [x.binders#place, NO_BINDER] + others.map(at => x.binders#at), [held, step_below.variable] + variables(step_others), Recursion(instance_key(typed), place, held, step_value.variable, equating: equations_checker(x)))
	minors = block_of(TYPES.environment, domain, "course").block.types#1.cases.map(case => minor_for(named_id(TYPES.environment, case.name)!, riding, value => below_of(value), inside))
	if minors.any(minor => minor == ø) { return ø }
	step = lambdas(step_locals, apply(recursor_applied(domain, riding, minors.map(minor => minor!) + [step_value.variable]), step_below.variable))
	course = apply_all(constant_of(TYPES.environment, constant_name(domain) + COURSE, [TYPE_LEVEL]), [motive, step, variable])
	apply_all(course, others.map(at => x.variables#at))
}
# a call of the function being read on the parameter's value at a field of the case taken apart: that field's
# hypothesis in the values below, given the other arguments, the field found by computing with the count's equations
# too; ø for any other call
recursive_called(called: Node, arguments: list, x: Entering) as Term? := {
	r = x.recursion ?? return ø
	if place_key(fact_of(called, DEFINED_AT) ?? return ø) != r.key or #arguments < r.place { return ø }
	if r.measured != ø { return measured_called(arguments, r.measured!, x) }
	given = term_of(arguments#(r.place), x) ?? return ø
	by_equations = equations_checker(x)
	at = r.fields.index_where(field => equal(by_equations, given, field))
	if at <= 0 { return ø }
	pair = TYPES.environment.products!.pair
	rest = (2 to at).list().fold(x.variables#(x.binders.index_of(BELOW_BINDER)), (path, step) => projection(pair, 2, path))
	terms_applied(projection(pair, 1, projection(pair, 1, rest)), arguments.take(r.place - 1) + arguments.drop(r.place), x)
}

# A recursion that ends by a measure (notes/coc-t5c-measures.md): a function whose every call of itself has a smaller
# measure than its own, the sum of its parameters' sizes, is the count's recursor on a bound above its measure. At
# zero no measure is below the bound; at a successor the body is read with each call of itself the recursion one
# below, given that the call's measure is below the bound, from the provers' proof that it is below the function's.
# Inside it is the measure as a function of the parameters, the parameters, the recursion below, the bound and the
# premise that the function's measure is below the bound's successor, and the result as a function of the parameters;
# ø where a call's proof is not found
class Measured { measure: Term; parameters: list<Term>; below: Term; bound: Term; premise: Term; result: Term; locals: list<Local> }
measured_defined(typed: TypedFunction, body: Node, x: Entering) as Term? := {
	if x.recursion != ø or not calls_itself(body, instance_key(typed)) { return ø }
	result = kernel_result(typed, x.by_key, x.s) ?? return ø
	locals = typed.locals
	# a loop's measure is the loop's (loops.wap)
	written = nodes_in(body).find(part => has_fact(part, MEASURE) and not unwrapped(part) is While)
	sizes = if written == ø then sizes_known(TYPES.environment, locals) else [measure_written(fact_of(written!, MEASURE)!, x) ?? return ø]
	if sizes is empty { return ø }
	measure = lambdas(locals, summed(TYPES.environment, sizes))
	start = successor_of(TYPES.environment, summed(TYPES.environment, sizes))
	# the function at every value whose measure is below k, given that it is
	bounded = (k: Term) => pis(locals + [entered(x.c, MEASURE_PREMISE, at_most_yes(start, k))], result)
	count = named_constant(COUNT)
	k = entered(x.c, "k", count)
	zero_premise = entered(x.c, MEASURE_PREMISE, at_most_yes(start, named_constant(COUNT_ZERO)))
	at_zero = lambdas(locals + [zero_premise], apply_all(named_constant(FALSE_ELIM, [level_of(x.c, result)]), [result, apply(named_constant(NO_IS_NOT_YES), zero_premise.variable)]))
	bound = entered(x.c, "k", count)
	below = entered(x.c, "below", bounded(bound.variable))
	premise = entered(x.c, MEASURE_PREMISE, at_most_yes(start, successor_of(TYPES.environment, bound.variable)))
	inside = reread(x, x.binders, x.variables, Recursion(instance_key(typed), 0, equating: equations_checker(x), measured: Measured(measure, variables(locals), below.variable, bound.variable, premise.variable, lambdas(locals, result), locals)))
	at_step = lambdas([bound, below] + locals + [premise], term_of(body, inside) ?? return ø)
	# the levels the result and the recursion's motive live at, so a proof or a function of types is read too
	recursion = apply_all(named_constant(recursor_name(COUNT), [level_of(x.c, bounded(k.variable))]), [lambdas([k], bounded(k.variable)), at_zero, at_step, start])
	apply_all(recursion, variables(locals) + [apply(named_constant(AT_MOST_SAME), start)])
}
# a measure written after the body, a count or the size of a value of an enum (an int's), read under the parameters
measure_written(n: Node, x: Entering) as Term? := value_size(TYPES.environment, kernel_value(n) ?? return ø, term_of(n, x) ?? return ø)
# A match inside a measured recursion on a variable the parameters' values hold (a parameter, or a field of one taken
# apart before): taken apart with the premise along (the motive a function of the value, of the premise at it), so
# each arm reads the variable, the measure and the result at the case's value, `μ(node(cs))` computing to the sizes
# of cs; ø for a match on any other value
measured_match(subject: Node, arms: list, domain: Term, m: Measured, x: Entering) as Term? := {
	variable = term_of(subject, x) ?? return ø
	if variable_id(variable) == 0 or not m.parameters.any(parameter => holds_variable(parameter, variable)) { return ø }
	at = (value: Term) => m.parameters.map(parameter => replaced_by(parameter, variable_id(variable), value))
	premised = (value: Term) => at_most_yes(successor_of(TYPES.environment, beta(m.measure, at(value))), successor_of(TYPES.environment, m.bound))
	v = entered(x.c, "v", domain)
	motive = lambdas([v], pis([entered(x.c, MEASURE_PREMISE, premised(v.variable))], beta(m.result, at(v.variable))))
	within = (inside: Entering, value: Term, read: (Entering) -> Term?) => {
		h = entered(inside.c, MEASURE_PREMISE, premised(value))
		taken = valued(inside, variable, value)
		measured = Recursion(inside.recursion!.key, 0, equating: inside.recursion!.equating, measured: Measured(m.measure, at(value), m.below, m.bound, h.variable, m.result, m.locals))
		body = read(reread(taken, taken.binders, taken.variables, measured))
		if body == ø then ø else lambdas([h], body!)
	}
	apply(taken_apart_into(domain, motive, (id, r) => arm_minor(id, arms, r, value => ø, x, within), variable, x) ?? return ø, m.premise)
}
# the binder of the premise that a measure is below a bound
MEASURE_PREMISE = "·measured"
# a call of the function inside its measured recursion: the recursion below the bound at the call's arguments, given
# that the call's measure is below the bound, chained from the provers' proof that it is below the function's
measured_called(arguments: list, m: Measured, x: Entering) as Term? := {
	read = arguments.map(argument => term_of(argument, x))
	if read.any(term => term == ø) then ø else measured_applied(read.map(term => term!), m, x)
}
measured_applied(given: list<Term>, m: Measured, x: Entering) as Term? := {
	smaller = successor_of(TYPES.environment, beta(m.measure, given))
	whole = beta(m.measure, m.parameters)
	falls = hole_term([], at_most_yes(smaller, whole), x, yes) ?? return ø
	apply_all(m.below, given + [apply_all(named_constant(AT_MOST_TRANS), [smaller, whole, m.bound, falls, m.premise])])
}
# the function being read as a value inside its measured recursion: a function of fresh parameters, each call of it
# the recursion below (its premise found where it is applied, so only an argument the provers see smaller passes)
# GUESS: a parameter's type naming one before it keeps the original's variable
measured_value(m: Measured, x: Entering) as Term? := {
	fresh = m.locals.map(local => entered(x.c, local.binder, local.domain))
	lambdas(fresh, measured_applied(variables(fresh), m, x.under(fresh, fresh.map(local => NO_BINDER))) ?? return ø)
}
# `at_most(m, n) == yes`
at_most_yes(m: Term, n: Term) as Term := truths_equal(TYPES.environment, apply_all(named_constant(AT_MOST), [m, n]), TYPES.environment.literals!.yes_case)
# whether a body calls the function of this key
calls_itself(body: Node, key: text) as bool := nodes_in(body).any(n => match n {
	Call(called, arguments) => fact_of(called, DEFINED_AT) != ø and place_key(fact_of(called, DEFINED_AT)!) == key
	_ => no
})

# A call inside a measured recursion of a kernel definition given a function that calls the recursion, `map(cs, c =>
# count(c))` (notes/coc-t5c-measures.md part 7): read through the definition, a recursor on a value the parameters
# hold, the motive taking along that the value's size is at most the whole's, so each case reads the function at its
# fields with what the provers need to see each call's measure smaller. The size of the value is what the measure
# computes to there, the nested recursion of Tree·size at a list of trees (theory-plan: found by computing, so its
# equality with list·size is never needed), else the value's own size; ø for any other call
read_through(d: Declaration, typed: TypedFunction, arguments: list, x: Entering, wanted: Term?, proved: (int, list<Node>, Term) -> Term?) as Term? := {
	r = x.recursion ?? return ø
	m = r.measured ?? return ø
	if not (d.kind is Defined) { return ø }
	at = (1 to #arguments).list().find(place => calls_recursion(arguments#place, r.key, x)) ?? return ø
	through = entered(x.c, "·through", kernel_headed(kernel_value(arguments#at) ?? return ø, x.c, x.s))
	unfolded = computed(x.c, kernel_called(d, typed, arguments, x, wanted, proved, {at: through.variable}) ?? return ø)
	facts = match (declared_at(TYPES.environment, constant_id(head(unfolded))) ?? return ø).kind {
		Recursor(facts) => facts
		_ => return ø
	}
	given = arguments(unfolded)
	if #given <= before_major(facts) or facts.motives != 1 or facts.indices != 0 { return ø }
	major = given#(before_major(facts) + 1)
	size = size_within(computed(x.c, beta(m.measure, m.parameters)), major, x.c) ?? sized_function(major, x) ?? return ø
	bounded = (value: Term) => at_most_yes(beta(size, [value]), beta(size, [major]))
	motive = given#(facts.parameters + 1)
	value = entered(x.c, "l", type_of(x.c, major))
	premised = lambdas([value], pis([entered(x.c, MEASURE_PREMISE, bounded(value.variable))], beta(motive, [value.variable])))
	parameters = given.take(facts.parameters)
	minors = (1 to facts.minors).list().map(place => minor_through(given#(facts.parameters + 1 + place), apply_all(facts.cases#place, parameters), facts.fields#place, head(type_of(x.c, major)), Through(motive, bounded, variable_id(through.variable), arguments#at), x))
	if minors.any(minor => minor == ø) { return ø }
	recursion = apply_all(head(unfolded), parameters + [premised] + minors.map(minor => minor!) + [major])
	apply_all(recursion, [apply(named_constant(AT_MOST_SAME), beta(size, [major]))] + given.drop(before_major(facts) + 1))
}
# what each case read through needs: the motive, the premise at a value, the function's stand-in and what it is
class Through { motive: Term; bounded: (Term) -> Term; stand_in: int; function: Node }
# A case's minor premise read through: its fields, a hypothesis taking the premise for each recursive field, and the
# premise at the case's value; the old minor's body with each hypothesis given its premise and the function read at
# each call of its stand-in, all proved by the provers under the fields and the premise
minor_through(minor: Term, case: Term, field_count: int, type: Term, t: Through, x: Entering) as Term? := {
	fields = lambdas_opened(x.c, minor, field_count) ?? return ø
	# a field ending in the type has a hypothesis, a function field's taken under its arguments
	recursive = fields.locals.filter(field => is_constant(head(ending(field.domain)), type))
	old = lambdas_opened(x.c, fields.body, #recursive) ?? return ø
	# each hypothesis opened is the motive at its field, so a function field's gives ø
	if (1 to #recursive).list().any(place => not same(old.locals#place.domain, beta(t.motive, [recursive#place.variable]))) { return ø }
	hypotheses = recursive.map(field => entered(x.c, INDUCTION, pis([entered(x.c, MEASURE_PREMISE, t.bounded(field.variable))], beta(t.motive, [field.variable]))))
	premise = entered(x.c, MEASURE_PREMISE, t.bounded(apply_all(case, variables(fields.locals))))
	binders = fields.locals + hypotheses + [premise]
	inside = x.under(binders, binders.map(binder => NO_BINDER))
	body = old.body
	for place in 1 to #recursive {
		proof = hole_term([], t.bounded(recursive#place.variable), inside, yes) ?? return ø
		body = replaced_by(body, variable_id(old.locals#place.variable), apply(hypotheses#place.variable, proof))
	}
	lambdas(binders, calls_replaced(body, t.stand_in, given => through_call(t.function, given, inside), x.c) ?? return ø)
}
# what a type gives after all its binders, their variables loose
ending(t: Term) as Term := match t.shape {
	Pi(binder, domain, body) => ending(body)
	_ => t
}
# a function argument read at a call's arguments: the recursion itself named as a value, or a lambda's body there
through_call(function: Node, given: list<Term>, x: Entering) as Term? := {
	m = x.recursion!.measured!
	if function_value_key(value_type(function)) == x.recursion!.key then measured_applied(given, m, x) else lambda_at(function, given, x)
}
# whether a function argument calls the recursion being read: its name, or a lambda whose body calls it
calls_recursion(n: Node, key: text, x: Entering) as bool := function_value_key(value_type(n)) == key or calls_itself(n, key) or (lambda_instance(n, x) != ø and calls_itself(body_of(lambda_instance(n, x)!), key))
# The function a measure computes to at a value it holds, `N(cs)` in `succ(N(cs))`: the first application ending in
# the value, the value made its binder; ø where the measure ends in it nowhere
size_within(t: Term, value: Term, c: Checker) as Term? := {
	if variable_id(value) == 0 or not holds_variable(t, value) { return ø }
	if arguments(t) is not empty and same(arguments(t).last, value) { return lambda("l", type_of(c, value), abstracted(t, variable_id(value))) }
	match t.shape {
		Apply(function, argument) => size_within(argument, value, c) ?? size_within(function, value, c)
		_ => ø
	}
}
# a value's own size as a function of values of its type
sized_function(value: Term, x: Entering) as Term? := {
	l = entered(x.c, "l", type_of(x.c, value))
	lambdas([l], value_size(TYPES.environment, l.domain, l.variable) ?? return ø)
}
# a term with each application of a variable replaced by what `at` makes of its arguments
calls_replaced(t: Term, id: int, at: (list<Term>) -> Term?, c: Checker) as Term? := {
	if not free_variables(t).contains(id) { return t }
	if variable_id(head(t)) == id {
		given = arguments(t).map(argument => calls_replaced(argument, id, at, c))
		return if given.any(argument => argument == ø) then ø else at(given.map(argument => argument!))
	}
	match t.shape {
		Apply(function, argument) => apply(calls_replaced(function, id, at, c) ?? return ø, calls_replaced(argument, id, at, c) ?? return ø)
		Lambda(binder, domain, body) => {
			if free_variables(domain).contains(id) { return ø }
			inside = entered(c, binder, domain)
			lambda(binder, domain, abstracted(calls_replaced(instantiated(body, inside.variable), id, at, c) ?? return ø, variable_id(inside.variable)))
		}
		_ => ø
	}
}
