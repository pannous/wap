# Binding analysis: kernel → bound kernel (first principles 15, notes/backbone.md "Stage languages").
#
# Scopes, shadowing, captures and globals are resolved here, once. Every name of the program gets two facts in its
# metadata (core/stage.wap with_fact), which every later stage reads instead of looking the name up again:
#   binding      what the name refers to: local, parameter, capture, global, function or library
#   defined_at   the name where that was defined, positioned, so an error can say where (ø for a library word)
#
#   x = 1                       x: global
#   f(y) := { z = x + y         z: local, x: global, y: parameter
#             g() := z          z: capture (g reads its enclosing function's local)
#             print z }         print: library
#
# Scopes: a Block opens one; a function (Define, Fn) opens one that also starts a new depth. A name a Block's
# statements give a value to, or define, belongs to that Block unless the same function sees it already; so a local
# never reaches another function, whatever its name (a local `push` in f leaves g's `xs.push` the library's). A
# definition is seen by its whole Block, before and after it, so functions may call each other.
# The stage only learns facts: every node keeps its shape and its own metadata.

use "../errors.wap"
use "../stage.wap"
use folder
use "../bindings.wap"
use "../type_notation.wap"
use "../parse/operator_table.wap"
use "../../types/operators.wap"
use "../../kernel/forms.wap"
use "../../kernel/surface.wap"
use "../rules/patterns.wap"

# depth of the program's own statements: names defined there are globals and top-level functions
PROGRAM_DEPTH = 0
# depth of the words of the modules the program uses, around it, and of the types module's declarations, around those
# (core/analyze/declarations.wap): a name means the innermost, local > parameter > program > used module > types
MODULE_DEPTH = -1
TYPES_DEPTH = -2

# the program bound inside the modules it uses and the types module, whose declarations (`name: signature`) it may use;
# two modules defining one name are refused, used or not
bound_program(program: Block, types: list<Signature>, modules: list<Module>, standard: map<text, list<text>>) as Block := {
	known = identified_program(program, types, modules, standard)
	finished(known, known.statements.map(statement => bound(statement, known.scope, PROGRAM_DEPTH)))
}
# the words around a program: the modules it uses, then the types module's, outermost, and the standard library's
# beyond them
scope_around(types: list<Signature>, modules: list<Module>, standard: map<text, list<text>> = {}) as Scope := Scope([Layer(modules_scope(modules) + types_scope(types))], no, standard)
# the types module's words, outermost
types_scope(types: list<Signature>) as list<Definition> := types.flat_map(signature => library_words(signature, TYPES_DEPTH))
# a library's words: a function of the types module or of a used module, or a used module's variable, `x = 1`, or a
# class or an enum it declares, its cases and its fields for methods, as the program's own
library_words(signature: Signature, depth: int) as list<Definition> := match signature.kind {
	DefinitionKind.Record => definitions_made_by(signature.record!, Scope(), depth)
	DefinitionKind.Function => [Definition(signature.name, DefinitionKind.Library, signature.definer, depth)]
	_ => [Definition(signature.name, signature.kind, signature.definer, depth)]
}

# n with the facts on every name it holds; scope lists the definitions visible, the innermost first
# code bound inside a scope; a typed rule's hole holds code bound and typed already, which stays as it is
bound(n: Node, scope: Scope, depth: int) as Node := if fact_of(n, TYPED_HOLE) != ø then n else form_bound(n, scope, depth)
form_bound(n: Node, scope: Scope, depth: int) as Node := match n {
	Symbol(name) => resolved(n, scope, depth)
	Block(statements) => refitted(Block(all_bound(statements, block_scope(n, statements, scope, depth), depth)), n)
	Define(name, parameters, body) => with_captures(refitted(Define(bound(name, scope, depth), parameters_bound(parameters, scope, depth), body_bound(parameters, body, scope, depth)), n), scope, depth)
	Fn(parameters, body) => with_captures(refitted(Fn(parameters_bound(parameters, scope, depth), body_bound(parameters, body, scope, depth)), n), scope, depth)
	Set(place, value) => refitted(Set(bound(place, if declares_global(n) then program_scope(scope) else scope, depth), bound(value, declaring(scope, declared_name(place)), depth)), n)
	# a function type where a value stands, `(a, b) -> a + b`, is no value: types are written after a colon
	Call(called, arguments) => if text(called) == FUNCTION_ARROW then refused(n, "-> writes a function type; a function value is written with =>: `(a, b) => a + b`") else module_call(n, called, arguments, scope, depth) ?? if core_word(called, BY_WORD, scope) then refitted(Call(called, all_bound(arguments, scope, depth)), n) else if core_word(called, TYPE_TEST_WORD, scope) then type_test_bound(n, called, arguments, scope, depth) else if QUESTION_WORDS.any(word => core_word(called, word, scope)) then refitted(Call(called, arguments.map(of => if names_value(of, scope) then bound(of, scope, depth) else of)), n) else if claims_effects(called, arguments) then refitted(Call(called, all_bound(arguments.take(1), scope, depth) + arguments.drop(1)), n) else if rest_named(n) != ø then refitted(Call(called, all_bound(arguments, scope, depth)), n) else field_called(n, called, arguments, scope, depth) ?? refitted(Call(called_bound(with_receiver(called, scope, depth), #arguments, scope, depth), arguments_bound(arguments, scope, depth)), n)
	Prim(operation, arguments) => refitted(Prim(operation, all_bound(arguments, scope, depth)), n)
	If(condition, then_part, else_part) => refitted(If(bound(condition, scope, depth), bound(then_part, scope, depth), bound(else_part, scope, depth)), n)
	While(condition, body) => refitted(While(bound(condition, scope, depth), bound(body, looped_scope(scope, depth), depth)), n)
	For(place, count, body) => for_bound(n, place, count, body, scope, depth)
	Try(body, handler) => refitted(Try(bound(body, scope, depth), handler_bound(handler, scope, depth)), n)
	Case(subject, arms) => refitted(Case(bound(subject, scope, depth), arms.map(arm => arm_bound(arm, scope, depth))), n)
	Return(value) => refitted(Return(bound(value, scope, depth)), n)
	Break() => n
	Continue() => n
	Get(subject, key) => qualified_case(n, subject, key, scope) ?? refitted(Get(bound(subject, scope, depth), bound(key, scope, depth)), n)
	Item(subject, key) => refitted(Item(bound(subject, scope, depth), bound(key, scope, depth)), n)
	List(items, Bracket.Square, separator) => refitted(List(all_bound(items, scope, depth), Bracket.Square, separator), n)
	Key(name, Op.Colon, type) => refitted(Key(bound(name, scope, depth), Op.Colon, type_bound(type, scope)), n)
	# a function's name glued to a map calls it with the map, `style{a: 1}` style({a: 1}) (wiki/significant-whitespace.md)
	Key(head, Op.None, List(items, Bracket.Curly, separator)) => if names_function_in(head, scope) then bound(refitted(Call(head, [refitted(List(items, Bracket.Curly, separator), n)]), n), scope, depth) else refitted(Key(type_bound(head, scope), Op.None, List(items.map(field => field_bound(field, scope, depth)), Bracket.Curly, separator)), n)
	List(items, Bracket.Curly, separator) => refitted(List(items.map(field => field_bound(field, scope, depth)), Bracket.Curly, separator), n)
	Record(name, fields, variants) => refitted(Record(name, with_items(fields, items_of(fields).map(field => field_bound(field, scope))), with_items(variants, items_of(variants).map(variant => field_bound(variant, scope)))), n)
	Number(value) => n
	Text(value) => n
	Char(value) => n
	True => n
	False => n
	Empty => n
	# a type with parts where a value stands, `x := list<byte>`, is no value: types are written after a colon
	Key(head, Op.None, List(items, Bracket.Less, separator)) => refused(n, "a type with parts is no value: write it as the type of one, after a colon, `x: ${n}`")
	_ => refused(n, "the binding analysis reads only kernel forms; the lowering should have removed this")
}
# A written type with each record name in it bound to the Record its scope sees, `Box` of `b: Box` or `list<Box>?`
# whether a name in scope names functions and no class, whose constructor is a function too
names_function_in(name: Node, scope: Scope) as bool := {
	meant = definitions_meant(text(name), scope)
	meant is not empty and is_function(meant#1) and record_meant(scope, text(name)) == ø
}
# the class a name means in a scope, ø where it means none
record_meant(scope: Scope, name: text) as Definition? := named_in(scope, name).find(definition => definition.kind == DefinitionKind.Record)
# the enum a case word written as a type is a shape of, where the scope sees one case with fields of that name,
# `radius(c: Circle)`
case_owner(scope: Scope, name: text) as Definition? := {
	cases = named_in(scope, name).filter(definition => definition.kind == DefinitionKind.Case and definition.fields > 0)
	if #cases == 1 then record_meant(scope, cases#1.owner) else ø
}
# a record's field, or a case with fields, its written types bound as a parameter's are
field_bound(field: Node, scope: Scope) as Node := match field {
	Key(name, Op.Colon, type) => refitted(Key(name, Op.Colon, type_bound(type, scope)), field)
	Set(place, value) => refitted(Set(field_bound(place, scope), value), field)
	Call(called, fields) => refitted(Call(called, fields.map(each => field_bound(each, scope))), field)
	_ => field
}
type_bound(type: Node, scope: Scope) as Node := match type {
	Symbol(name) => {
		record = record_meant(scope, name)
		# a case word narrows the enum its scope sees, whatever other enums hold a case so named
		if record == ø { return with_fact(type, NARROWS, type_bound(symbol((case_owner(scope, name) ?? return type).name), scope)) }
		with_fact(type, DECLARED_BY, record_declared(record!.definer))
	}
	List(items, bracket, separator) => refitted(List(items.map(item => type_bound(item, scope)), bracket, separator), type)
	Call(called, arguments) => refitted(Call(called, arguments.map(argument => type_bound(argument, scope))), type)
	Key(name, op, parts) => refitted(Key(type_bound(name, scope), op, type_bound(parts, scope)), type)
	_ => type
}
# An arm: the name its pattern holds a new variable of the arm, which its result sees; `_` and literals name none
arm_bound(arm: Arm, scope: Scope, depth: int) as Node := match arm {
	Arm(pattern, result) => {
		inner = within(scope, pattern_variables(pattern, scope, depth))
		refitted(Arm(pattern_bound(pattern, inner, depth), bound(result, inner, depth)), arm)
	}
}
# a pattern's names bound: a case, `Dot`, or a case with the variables its fields fill, `Circle(r)`; `_` names none
pattern_bound(pattern: Node, scope: Scope, depth: int) as Node := match named_pattern(pattern, scope) {
	Symbol(name) => if name == WILDCARD then pattern else pattern_name_bound(pattern, scope, depth)
	Call(called, fields) => if shape_called(called, scope) then with_fact(pattern_bound(pattern_shape(called, fields, scope), scope, depth), SHAPE_OF, called) else refitted(Call(if rest_named(pattern) == ø then pattern_name_bound(called, scope, depth) else called, fields.map(field => pattern_bound(field, scope, depth))), pattern)
	List(items, Bracket.Square, separator) => refitted(List(items.map(item => pattern_bound(item, scope, depth)), Bracket.Square, separator), pattern)
	Get(subject, key) => bound(pattern, scope, depth)
	_ => pattern
}
# A name in a pattern: a case binds as one even when two enums have a case of that name, as the subject's enum picks
# among them (core/analyze/types.wap pattern_typed); any other name as anywhere
pattern_name_bound(name: Node, scope: Scope, depth: int) as Node := {
	if not names_case(name, scope) { return resolved(name, scope, depth) }
	with_fact(with_binding(name, DefinitionKind.Case), DEFINED_AT, definitions_meant(text(name), scope)#1.definer)
}
# the shape a declared pattern's call stands for, `Pair(a, b)` as its builder takes it apart
pattern_shape(called: Node, fields: list, scope: Scope) as Node := pattern_taken(called, fields, pattern_builder_meant(called, scope) ?? refused(called, "no declared pattern builds this shape"))
# a declared pattern's bare name, `Tagged`, is its call naming each hole by the hole's own name, `Tagged(label)`, each
# name's id the bare name's and the hole's
named_pattern(pattern: Node, scope: Scope) as Node := {
	builder = (if pattern is symbol then pattern_builder_meant(pattern, scope) else ø) ?? return pattern
	placed_like(Call(pattern, fact_items(builder, PATTERN_HOLES).map(hole => with_fact(placed_like(symbol(text(hole)), pattern), DEFINER, Text("${definer_id(pattern)} ${hole}")))), pattern)
}
# whether an arm's call is a declared pattern's, `Call(f, args)` of a pattern Call: its builder the name means, no case
shape_called(called: Node, scope: Scope) as bool := pattern_builder_meant(called, scope) != ø
# the name of the pattern builder a call means, which carries the pattern (core/rules/patterns.wap pattern_builder)
pattern_builder_meant(called: Node, scope: Scope) as Node? := {
	if not called is symbol or names_case(called, scope) { return ø }
	meant = definitions_meant(text(called), scope)
	if meant is empty or fact_of(meant#1.definer, PATTERN_TAKEN) == ø { return ø }
	meant#1.definer
}
# whether a name means a case of an enum where it stands
names_case(name: Node, scope: Scope) as bool := definitions_meant(text(name), scope).take(1).any(meant => meant.kind == DefinitionKind.Case)
arm_result(arm: Arm) as Node := match arm { Arm(pattern, result) => result }
pattern_variables(pattern: Node, scope: Scope, depth: int) as list<Definition> := match named_pattern(pattern, scope) {
	Symbol(name) => if name == WILDCARD or names_case(pattern, scope) then [] else [Definition(name, local_kind(depth), pattern, depth)]
	Call(called, fields) => if shape_called(called, scope) then pattern_variables(pattern_shape(called, fields, scope), scope, depth) else fields.flat_map(field => pattern_variables(field, scope, depth))
	List(items, Bracket.Square, separator) => items.flat_map(item => pattern_variables(item, scope, depth))
	Get(subject, key) => []
	Number(value) => []
	Text(value) => []
	Char(value) => []
	True => []
	False => []
	Empty => []
	_ => refused(pattern, "wap matches literals, names and _ so far")
}

# A type test, `x is T`: its value bound, its type a case, which binds as one, or a type's name, which stays a name as
# in `x: int`; the word stays unbound, so typing reads the test (core/analyze/types.wap). A predicate's word, `xs is
# empty`, and `a is not b` are rules of their own (sugar/types.wap)
core_word(called: Node, word: text, scope: Scope) as bool := called is symbol and text(called) == word and definitions_meant(word, scope) is empty
type_test_bound(n: Node, called: Node, arguments: list, scope: Scope, depth: int) as Node := {
	tested = arguments#2
	if names_value(tested, scope) { return bound(refitted(Call(symbol(EQUALITY_WORD), arguments), n), scope, depth) }
	type = if tested is symbol and names_case(tested, scope) then resolved(tested, scope, depth) else tested
	refitted(Call(called, [bound(arguments#1, scope, depth), type]), n)
}
# a call's argument: a named one, `by: f`, its value bound and its name the parameter's word
argument_bound(argument: Node, scope: Scope, depth: int) as Node := if is_named(argument) then field_bound(argument, scope, depth) else bound(argument, scope, depth)
arguments_bound(arguments: list, scope: Scope, depth: int) as list := arguments.map(argument => argument_bound(argument, scope, depth))
is_named(argument: Node) as bool := match argument { Key(name, Op.Colon, value) => name is symbol; _ => no }
# an instance's field or a map's entry, `x: 1`: its value bound, its name a word, no variable
# a field's name is a name; a key written as a value, `"${file}": x`, is read as any value is
field_bound(field: Node, scope: Scope, depth: int) as Node := match field { Key(name, Op.Colon, value) => refitted(Key(if name is symbol then name else bound(name, scope, depth), Op.Colon, bound(value, scope, depth)), field); _ => refused(field, NOT_A_FIELD) }
# the scope inside a loop's body, which runs again: a variable the program set before is read as it is now
looped_scope(scope: Scope, depth: int) as Scope := Scope(scope.layers, scope.looped or depth == PROGRAM_DEPTH, scope.standard, scope.declaring)
# a counted loop, its place a variable of its body
for_bound(n: Node, place: Node, count: Node, body: Node, scope: Scope, depth: int) as Node := {
	inner = within(looped_scope(scope, depth), assigned_variables(n, place, scope, depth))
	refitted(For(bound(place, inner, depth), bound(count, scope, depth), bound(body, inner, depth)), n)
}
# the scope inside a block: its variables, then what its statements define, innermost
block_scope(block: Node, statements: list, scope: Scope, depth: int) as Scope := {
	variables = within(scope, named_variables(block, scope, depth))
	within(variables, defined_in(statements, variables, depth))
}
all_bound(forms: list, scope: Scope, depth: int) as list := forms.map(form => bound(form, scope, depth))
# the scope an assignment's value is read in: the variable it gives its first value does not exist yet, so
# `make = m.make()` calls m's field make and `twice = n.twice()` the function twice
declaring(scope: Scope, place: Node) as Scope := Scope(scope.layers, scope.looped, scope.standard, scope.declaring + [place])


# A function's parameters and body, one depth further in than the function's definition, the body seeing the
# parameters before the names around it
parameters_bound(parameters: List, scope: Scope, depth: int) as Node := match parameters {
	List(items, bracket, separator) => with_items(parameters, items.map(p => default_bound(bound(p, within(scope, parameter_definitions(parameters, depth + 1)), depth + 1), scope, depth)))
}
# a parameter's default value, `y: int = k`, bound where the function is defined
default_bound(parameter: Node, scope: Scope, depth: int) as Node := {
	given = fact_of(parameter, DEFAULT)
	if given == ø then parameter else with_fact(parameter, DEFAULT, bound(given, scope, depth))
}
body_bound(parameters: List, body: Node, scope: Scope, depth: int) as Node := bound(body, within(scope, parameter_definitions(parameters, depth + 1) + receiver_fields(parameters, scope, depth + 1)), depth + 1)
# A Try's handler, run in place: its parameter, the caught Error, one more of the function around it, which its body
# reads and returns from as its own
handler_bound(handler: Fn, scope: Scope, depth: int) as Node := match handler { Fn(parameters, body) => {
	inner = within(scope, parameter_definitions(parameters, depth))
	refitted(Fn(with_items(parameters, all_bound(items_of(parameters), inner, depth)), bound(body, inner, depth)), handler)
} }
# A method's receiver fields: in a function whose first parameter is `self` of a class, each field of the class by its
# bare name, `c` for `self.c`, read and set; the function's parameters and locals hide them
# DEBT: A method's bare field names come from the classes of its Block only: a method of a types or used module's
#   class still writes `self.c`, and a function value inside a method that reads a bare field is not given self as a
#   capture. Paid off when binding sees the library's Records beside its declarations and a field's capture captures
#   its receiver.
receiver_fields(parameters: List, scope: Scope, depth: int) as list<Definition> := {
	receiver = match parameters { List(items, bracket, separator) => if items is empty then ø else items#1 }
	if receiver == ø { return [] }
	type = declared_type(receiver) ?? return []
	self_name = parameter_name(receiver)
	if text(self_name) != SELF_WORD { return [] }
	record = record_meant(scope, text(type)) ?? return []
	fields_of(record.definer).map(field => Definition(text(declared_name(field)), DefinitionKind.Field, self_name, depth))
}
parameter_definitions(parameters: List, depth: int) as list<Definition> := match parameters {
	List(items, bracket, separator) => items.map(p => Definition(text(parameter_name(p)), DefinitionKind.Parameter, parameter_name(p), depth))
}

# A function with the fact `captures`: the names of the functions around it that its body reads, a nested function's
# reads included (the function passes them on), each defining name once in the order first read; [] when it captures
# nothing. A closure is built from them (core/emit/closures.wap).
with_captures(function: Node, scope: Scope, depth: int) as Node := {
	captured: list<Node> = []
	for definer in captured_definers(function) {
		if from_enclosing_function(definer, scope, depth) and not captured.any(other => same_definer(other, definer)) { captured += [definer] }
	}
	with_fact(function, CAPTURES, data_list(captured))
}
# the defining names of the captures read anywhere in n
captured_definers(n: Node) as list<Node> := match n {
	Symbol(name) => if is_bound(n, DefinitionKind.Capture) then [defined_at(n)] else []
	_ => direct_parts(n).flat_map(captured_definers)
}
# whether a defining name belongs to a function around the one at depth, not to the program or the library
from_enclosing_function(definer: Node, scope: Scope, depth: int) as bool := {
	for definition in every_definition(scope) { if same_definer(definition.definer, definer) { return (definition.depth > PROGRAM_DEPTH or scope.looped and definition.depth == PROGRAM_DEPTH) and definition.depth <= depth } }
	no
}

# a call of a word nothing defines on a value, `h.act(2)`, read `act(h, 2)`: a call of what the value's field of that
# name holds, `h.act` given 2
field_called(n: Node, called: Node, arguments: list, scope: Scope, depth: int) as Node? := if called is symbol and #arguments > 0 and field_meant(text(called), scope) then bound(refitted(Call(with_fact(refitted(Get(arguments#1, Text(text(called))), called), WRITTEN_CALL, True), arguments.drop(1)), n), scope, depth) else ø
# in a method, a call's receiver, for a sibling method called bare, `range_field(at, 0)` as its fields are read
# (wiki/class.md): typing passes it first when no function takes the arguments alone and a method of the receiver's type takes it
with_receiver(called: Node, scope: Scope, depth: int) as Node := if called is symbol and named_in(scope, SELF_WORD).any(definition => definition.kind == DefinitionKind.Parameter) then with_fact(called, RECEIVER, bound(placed_like(symbol(SELF_WORD), called), scope, depth)) else called
# the name a parameter defines: `x`, or the x of `x: int`
parameter_name(parameter: Node) as Node := if declared_name(parameter) is symbol then declared_name(parameter) else refused(parameter, "a parameter is a name, or a name and its type")

# A name with what it refers to, as seen from depth: its own function's names as they were defined, the program's
# globals and functions and the library's words as such, an enclosing function's names as captures; a name nothing
# defines is refused
resolved(name: Node, scope: Scope, depth: int) as Node := resolved_taking(name, ø, scope, depth)
# a called name resolved by how many values the call gives, which picks among cases of one name
called_bound(called: Node, given: int, scope: Scope, depth: int) as Node := if called is symbol then resolved_taking(called, given, scope, depth) else bound(called, scope, depth)
resolved_taking(name: Node, given: int?, scope: Scope, depth: int) as Node := {
	meant = if has_fact(name, DERIVED) then rule_word_meant(text(name), scope) else definitions_meant(text(name), scope)
	# a name nothing defines is read as the word its alias gives, `length` count (types/operators.wap word_aliases),
	# else as a standard module's word
	if meant is empty {
		# a universe, `Prop`, and a proof's words, `refl`, are the language's own: typing reads them (types.wap
		# names_type_value, proof_typed)
		if universe_written(name) != ø or PROOF_WORDS.contains(text(name)) { return name }
		alias = word_aliased(text(name))
		if alias != text(name) and (not definitions_meant(alias, scope) is empty or scope.standard.has(alias)) { return resolved_taking(refitted(symbol(alias), name), given, scope, depth) }
		return standard_word_bound(name, scope)
	}
	innermost = if meant#1.kind == DefinitionKind.Case then unambiguous_case(name, meant#1, given, scope) else meant#1
	# a name a rule read as a function binds to a function, never to a variable of that name in its way
	if fact_of(name, READ_WITH) != ø and not is_function(innermost) { refused(name, "a rule reads ${name} as the function ${fact_of(name, READ_WITH)}, but a variable of that name hides it: rename the variable") }
	kind = if not loop_captured(innermost, scope, depth) and (innermost.depth == depth or innermost.depth <= PROGRAM_DEPTH or innermost.kind == DefinitionKind.Global) then innermost.kind else DefinitionKind.Capture
	# a field read in a function inside its method is the receiver's, captured: `xs` in `i => xs[i]` is self.xs
	if innermost.kind == DefinitionKind.Field and kind == DefinitionKind.Capture { return form_bound(placed_like(Get(placed_like(symbol(SELF_WORD), name), Text(text(name))), name), scope, depth) }
	bound = with_functions_beyond(with_binding(name, kind), given, innermost, scope)
	if #meant == 1 then with_fact(bound, DEFINED_AT, innermost.definer) else with_fact(without_attribute(bound, DEFINED_AT), CANDIDATES, data_list(depths_of(meant).map(depth => data_list(meant.filter(definition => definition.depth == depth).map(definition => definition.definer)))))
}
# the depths of these definitions, each once, innermost first as they come
depths_of(definitions: list) as list := definitions.map(definition => definition.depth).unique()
# A case named by its enum, `Side.Right`: that enum's case, bound as the bare name `Right` would be, even where a case
# of another enum has the enum's name (LexemeKind.Separator beside the enum Separator) or a function does (the case a
# text spells, `"error" as Level`); ø for any other part of a value
qualified_case(n: Node, subject: Node, key: Node, scope: Scope) as Node? := {
	if not subject is symbol or not key is text or not definitions_meant(text(subject), scope).all(definition => definition.kind in [DefinitionKind.Case, DefinitionKind.Function, DefinitionKind.Library]) { return ø }
	for definition in named_in(scope, text(key)) {
		if definition.kind == DefinitionKind.Case and definition.owner == text(subject) {
			return with_fact(with_binding(placed_like(symbol(text(key)), n), DefinitionKind.Case), DEFINED_AT, definition.definer)
		}
	}
	ø
}
# a call through a type, `nat.recursor(3)`: the word, its definitions to be those taking that type (calls.wap
# chosen_definition); ø where the subject is no type
type_word(called: Node, subject: Node, scope: Scope, given: int, depth: int) as Node? := {
	if not subject is symbol { return ø }
	meant = definitions_meant(text(subject), scope)
	if meant is empty or not meant.all(definition => definition.kind == DefinitionKind.Record) { return ø }
	with_fact(resolved_taking(called, given, scope, depth), OWNER, Text(text(subject)))
}
# A case name enums share: of the cases taking as many values as a call gives the innermost, `Key(k, op, v)` the types
# module's Node.Key beside a used module's fieldless LexemeKind.Key; with none taking them the innermost of the name;
# two such of one depth read two ways and are refused naming both
unambiguous_case(name: Node, meant: Definition, given: int?, scope: Scope) as Definition := {
	named = named_in(scope, text(name)).filter(definition => definition.kind == DefinitionKind.Case)
	taking = named.filter(definition => definition.fields == given)
	depth = if taking is empty then meant.depth else taking.map(definition => definition.depth).max
	cases = (if taking is empty then named else taking).filter(definition => definition.depth == depth)
	if #cases == 1 { return cases#1 }
	owners = cases.map(definition => definition.owner)
	refused(name, "${name} is a case of each of ${owners.join(", ")}: write ${owners.map(owner => owner + "." + text(name)).join(" or ")}")
}
