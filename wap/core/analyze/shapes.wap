# Shapes as types (wiki/pattern-matching.md "Named patterns as types"): a case of an enum, `List` of Node, or a declared
# pattern, `Record` (wap/kernel/forms.wap), names the values of a type that have its shape. Written as a type, its
# symbol carries the type it narrows as a fact, so every stage reads it without a lookup: a value of the shape is a
# value of that type (core/analyze/fits.wap conversion, Same), the emitter lays it out as one; a value of that type
# where the shape is wanted is narrowed (Narrowed), its shape tested where a match takes it apart; and a match that
# names the shape fits every value of it (core/analyze/matching.wap missing).

# DEBT: This file reaches rules/ (typed.wap) through a `use`, because a subtype's condition is read with its type, by
#   declare, before the lower stage, so its check lowers it where it is written. Paid off when a type's condition is
#   lowered with the program: the lower stage then hands its function to the type it belongs to.
use folder
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../errors.wap"
use "../../kernel/forms.wap"
use "../parse/operator_table.wap"
use "../rules/typed.wap"

# the raise where a value is not of the shape a place wants, and where it does not meet the condition of its subtype
OTHER_SHAPE = "this value is of another shape than the"
REFUSED_BY_CONDITION = "refused by condition:"

# the type a shape narrows, refused for any other type
shape_narrows(type: Term, s: TypingState) as Term := narrowed_type(type) ?? raise("${type_text(type)} narrows no type")
# A written type with its shape known: a declared pattern's name narrows Node, the name of a case with fields of one
# enum that enum (`Define` is a pattern, though Op has a case of that name; a case without fields is a value, no type,
# so LexemeKind's Key leaves `Key` Node's); a record's name its record's own word; any other type as written
shaped(type: Term, s: TypingState) as Term := {
	# a compound type's parts known alike: the Triple of a map<text, Triple> narrows Node too
	parts = type_parts(type)
	if parts != ø { return type_built(parts#1, parts.drop(1).map(part => shaped(part, s))) }
	if not is_word(type) or narrowed_type(type) != ø or is_letter(type) { return type }
	# a record's name is its record's own word, the one the typing state means where it was written without its declaration
	record = record_named(s.records, type)
	if record != ø { return record_term(record!) }
	word = word_of(type)!
	# a type word nothing defines is its word alias's, `raw` a text
	aliased = word_aliased(word)
	if aliased != word { return shaped(word_term(aliased), s) }
	# a block parameter takes a function of its own type, as a bare `function` does
	if word == BLOCK_WORD { return FUNCTION_TERM }
	if form_named(word, s) != ø { return narrowing(type, NODE_TERM) }
	holders = s.records.items.filter(record => cases_of(record).any(case => text(case_name(case)) == word and case_fields(case) is not empty))
	if #holders == 1 then case_shape(word, holders#1) else type
}
# a case's word as a shape of its enum: its own word, named by the enum's declaration, so two enums' cases of one
# name narrow each its own enum
case_shape(name: text, enum: Record) as Term := narrowing(word_keyed(name, "${name} ${declaration_place(record_declared(enum))}"), record_term(enum))
# definitions with the shapes their written types name, each shaped once
shaped_once(definition: Signature, s: TypingState) as Signature := {
	if definition.shaped { return definition }
	shaped = shaped_definition(reached_bound(define_of(definition, s), s.library_scopes), s)
	s.defines[definition.key] = shaped
	known = function_of(shaped)
	known.shaped = yes
	known
}
# a definition with the shapes its parameters' and its result's written types name
shaped_definition(definition: Node, s: TypingState) as Define := match definition {
	Define(name, parameters, body) => refitted(Define(shaped_key(name, s), with_items(parameters, items_of(parameters).map(parameter => shaped_key(parameter, s))), body), definition)
	_ => definition
}
shaped_key(n: Node, s: TypingState) as Node := match n {
	Key(name, Op.Colon, type) => refitted(Key(name, Op.Colon, written_of(shaped(type_term(type), s))), n)
	Call(called, arguments) => if is_default_given(n) then refitted(Call(called, [shaped_key(arguments#1, s), arguments#2]), n) else n
	Set(place, value) => refitted(Set(shaped_key(default_typed(place, value, s), s), value), n)
	_ => n
}
# a field given only its default, `at = 0`, has the default's type, as a parameter does (wiki/class.md)
default_typed(name: Node, default: Node, s: TypingState) as Node := if declared_type(name) != ø then name else refitted(Key(name, Op.Colon, written_of(value_of(typed_form(default, s, TypeFrame(), ø), "to give the field"))), name)

# The builder of a declared pattern of this name, which its taken shape and holes mark (core/rules/patterns.wap
# pattern_builder); ø for any other name
form_named(type: text, s: TypingState) as Signature? := {
	# a pattern's builder is always a written Define, held before any type is shaped: a definition not held yet, an
	# enum's generated text(), is never one (define_of refuses a lost definition on purpose)
	definitions_named(type, s).find(definition => s.defines.has(definition.key) and fact_of(defined_name(define_of(definition, s)), PATTERN_TAKEN) != ø)
}
# the shape a declared pattern takes values apart by, its holes `$name`
form_taken(form: Signature, s: TypingState) as Node := fact_of(defined_name(define_of(form, s)), PATTERN_TAKEN) ?? refused(define_of(form, s), "a pattern's builder carries its shape")
# the types of a declared pattern's holes, in order, their shapes known: its builder's parameters' types
hole_types(form: Signature, s: TypingState) as list := form.parameters.map(type => shaped(type ?? NODE_TERM, s))
# The patterns an arm's pattern has at the holes of a form's shape, in order; ø when it is not of that shape
form_parts(taken: Node, pattern: Node) as list<Node>? := {
	if taken is symbol and text(taken).starts_with(HOLE_SIGN) { return [pattern] }
	match taken {
		Get(subject, key) => if literal_text(taken) == literal_text(pattern) then [] else ø
		Call(called, arguments) => match pattern { Call(given, parts) => if text(given) == text(called) then zipped_parts(arguments, parts) else ø; _ => ø }
		List(items, bracket, separator) => match pattern { List(parts, given_bracket, given_separator) => zipped_parts(items, parts); _ => ø }
		_ => if literal_text(taken) == literal_text(pattern) then [] else ø
	}
}
# a literal part of a shape as an arm writes it: a case read from its enum, `Bracket.Round` (the taken shape's
# spelling), is the case, `Round` (the arm's, bound)
literal_text(n: Node) as text := match n { Get(subject, key) => text(key); _ => text(n) }
zipped_parts(shapes: list<Node>, patterns: list<Node>) as list<Node>? := {
	if #shapes != #patterns { return ø }
	parts: list<Node> = []
	for at in 1 to #shapes { parts += (form_parts(shapes#at, patterns#at) ?? return ø) }
	parts
}

# A part of a shape's value by its hole's name, `r.a` of `r: Pair`, `d.size` of `d: Dot`: the match its shape writes,
# `match r { Pair(a, _) => a }`, that hole a variable of its own; ø where the type is no shape or has no such hole
pattern_part(n: Node, typed: Node, key: Node, s: TypingState) as Node? := {
	type = value_type(typed) ?? return ø
	taken = shape_taken(type, s) ?? return ø
	if not (form_parts(taken, taken) ?? []).contains(symbol(HOLE_SIGN + text(key))) { return ø }
	# the variable's id is the read's place: typing counts no definers
	definer = with_fact(placed_like(symbol(text(key)), n), DEFINER, Text("${file_of(n)}@${line_of(n)}:${column_of(n)}"))
	part = with_fact(with_binding(definer, DefinitionKind.Local), DEFINED_AT, definer)
	placed_like(Case(typed, [Arm(shape_marked(bound_shape(with_part(taken, HOLE_SIGN + text(key), part), shape_narrows(type, s), s), type, s), part)]), n)
}
# the shape a shape's values are taken apart by, its holes `$name`: a declared pattern's, or a case's, each field a
# hole of its name, `Dot($size)` (wiki/variant.md "A case as a type"); ø for a type that is no shape
shape_taken(type: Term, s: TypingState) as Node? := {
	form = form_named(type_text(type), s)
	if form != ø { return form_taken(form, s) }
	if narrowed_type(type) == ø { return ø }
	case = case_declaring(s.records, case_bound(symbol(type_text(type)), shape_narrows(type, s), s))
	Call(symbol(type_text(type)), case_fields(case).map(field => symbol(HOLE_SIGN + text(declared_name(field)))))
}
# a pattern of a shape, marked with the declared pattern it names, whose holes an arm's names then hold
shape_marked(pattern: Node, type: Term, s: TypingState) as Node := if form_named(type_text(type), s) == ø then pattern else with_fact(pattern, SHAPE_OF, symbol(type_text(type)))
# a shape with one hole written as the variable that takes it
with_part(taken: Node, hole: text, part: Node) as Node := if taken is symbol and text(taken) == hole then part else match taken {
	Call(called, arguments) => Call(called, arguments.map(argument => with_part(argument, hole, part)))
	List(items, bracket, separator) => List(items.map(item => with_part(item, hole, part)), bracket, separator)
	_ => taken
}

# A shape as a pattern fitting each of its values, the cases it names bound to their enums: a case's name with `_` for
# each field, `List(_, _, _)`; a declared pattern's taken shape with `_` at its holes
shape_pattern(type: Term, s: TypingState) as Node := shape_marked(bound_shape(shape_taken(type, s) ?? raise("${type_text(type)} narrows no type"), shape_narrows(type, s), s), type, s)
bound_shape(taken: Node, enum: Term, s: TypingState) as Node := {
	if taken is symbol and text(taken).starts_with(HOLE_SIGN) { return symbol(WILDCARD) }
	match taken {
		Get(subject, key) => case_bound(symbol(text(key)), type_term(subject), s)
		# a rest hole, `...$arguments`, takes any rest, into the variable a part read puts there
		Call(called, arguments) => Call(if rest_named(taken) != ø then called else case_bound(called, enum, s), arguments.map(argument => bound_shape(argument, enum, s)))
		List(items, bracket, separator) => List(items.map(item => bound_shape(item, enum, s)), bracket, separator)
		_ => taken
	}
}
case_bound(name: Node, enum: Term, s: TypingState) as Node := with_binding(in_enum(name, enum, s), DefinitionKind.Case)
# A kind word after `is` on a value of an enum, `n is symbol` on a Node: the enum's case of that name in lower case,
# as a shape (wiki/Footguns.md "Tiny surprises"); ø where the value is of no enum or no case is named so
kind_named(word: Node, type: Term?, s: TypingState) as Term? := {
	enum = record_named(s.records, base_or_self(type)) ?? return ø
	named = cases_of(enum).filter(case => lower(text(case_name(case))) == text(word))
	if named is empty then ø else case_shape(text(case_name(named#1)), enum)
}
# whether a value is of a narrowing of its type, as code: of a shape `match x { List(_, _, _) => yes; _ => no }`, of a
# subtype its condition's function called on it
narrowing_test(read: Node, type: Term, at: Node, s: TypingState) as Node := with_fact(placed_like(narrowing_tested(read, type, s), at), TESTED, type_fact(type))
narrowing_tested(read: Node, type: Term, s: TypingState) as Node := {
	condition = subset_condition(type)
	if condition != ø { return Call(written_bound(condition!, s), [read]) }
	arms = [Arm(shape_pattern(type, s), True), Arm(symbol(WILDCARD), False)]
	# a union's value is of the shape where it holds the type the shape narrows and fits the shape's pattern
	parent = narrowed_type(type)
	if parent == ø or not is_union(value_type(read)) { return Case(read, arms) }
	If(boxed_tested(read, parent!, read), Case(with_type_of(placed_like(Prim(symbol(CHECKED_CAST), [read]), read), parent!), arms), False)
}
# the raise where a value is not of the narrowing wanted, naming the place that wanted it: of a shape, or the condition
# a subtype's value does not meet
other_shape(type: Term, at: Node, s: TypingState) as text := {
	place = "wanted at ${file_of(at)}:${line_of(at)}:${column_of(at)}"
	condition = subset_condition(type)
	if condition == ø then "${OTHER_SHAPE} ${type_text(type)} ${place}" else "${REFUSED_BY_CONDITION} ${condition_shown(condition!)}, ${place}"
}
