# The size of a value, the count a measured recursion falls in (notes/coc-t5c-measures.md): each enum that may be
# taken apart into any universe gets `E·size(parameters, indices, v): ·count`, made from its recursor the first time a
# measure asks, as courses.wap makes below and course. A case's value is one plus the sizes of its fields: a field of
# a type of the block by the recursor's hypothesis (a container's items through the nested motives, so a tree's
# children count), a field of another enum by that enum's size, any other field and a function field zero:
# `size(node(t))` computes to `successor(size(t))`, so a call on a field falls by `at_most_same`. A number's size is
# the kernel's (kernel/counting.wap): a count's itself, an int's the sum of its two counts.

use "../../kernel/terms.wap"
use "../../kernel/levels.wap"
use "../../kernel/environment.wap"
use "../../kernel/typing.wap"
use "../../kernel/inductive.wap"
use "../../kernel/recursors.wap"
use "../../kernel/counting.wap"

# the name of a type's size, declared with the sizes of its block's other types the first time it is asked for; ø
# where the type is no enum taken apart into any universe
size_of(e: Environment, type: text): text? := {
	name = type + SIZE
	if declaration(e, name) is not ø { return name }
	facts = match (declaration(e, type) ?? return ø).kind {
		Inductive(facts) => facts
		_ => return ø
	}
	if not facts.any_motive { return ø }
	m = making(e, facts)
	count = constant_of(e, COUNT, [])
	motives = (1 to #m.block.types).list().map(at => {
		indices = indices_entered(m, at)
		lambdas(indices + [major_local(m, at, indices)], count)
	})
	minors = m.cases.flat_map(cases => cases.map(case => {
		hypotheses = case.inductions.map(induction => entered(m.c, INDUCTION, pis(induction.binders, count)))
		lambdas(case.fields + hypotheses, successor_of(e, summed(e, fields_sized(e, case, hypotheses))))
	}))
	levels = [TYPE_LEVEL] + facts.block.levels.map(level => Parameter(level))
	for at in 1 to #facts.block.types {
		indices = indices_entered(m, at)
		binders = m.parameters + indices + [major_local(m, at, indices)]
		recursor = constant_of(e, recursor_name(facts.block.types#at.name), levels)
		value = apply_all(recursor, variables(m.parameters) + motives + minors + variables(binders.drop(#m.parameters)))
		declared(e, Declaration(facts.block.types#at.name + SIZE, facts.block.levels, contained(m, pis(binders, count)), Defined(contained(m, lambdas(binders, value)))))
	}
	name
}

# the sizes a case's fields count: each recursive field's hypothesis, unless the field is a function, and each other
# field of an enum its size
fields_sized(e: Environment, case: CaseMade, hypotheses: list<Local>): list<Term> := {
	recursive = (1 to #case.inductions).list().filter(at => case.inductions#at.binders is empty).map(at => hypotheses#at.variable)
	others = case.fields.filter(field => not case.inductions.any(induction => induction.field == field.variable))
	recursive + sizes_known(e, others)
}
# the sizes of the values of these binders whose types are enums'
sizes_known(e: Environment, values: list<Local>): list<Term> := values.map(value => value_size(e, value.domain, value.variable)).filter(size => size is not ø).map(size => size!)
# a value's size where its type is an enum's: the enum's size at the type's levels, parameters and indices
value_size(e: Environment, type: Term, value: Term): Term? := {
	enum = head(type)
	if constant_id(enum) == 0 { return ø }
	name = size_of(e, constant_name(enum)) ?? return ø
	apply_all(constant_of(e, name, constant_levels(enum)), arguments(type) + [value])
}
# counts added, the first alone, none zero: a case of one field has the field's size plus one, which computes
summed(e: Environment, counts: list<Term>): Term := if counts is empty then constant_of(e, COUNT_ZERO, []) else counts.drop(1).fold(counts#1, (sum, next) => apply_all(constant_of(e, ADD, []), [sum, next]))
successor_of(e: Environment, t: Term): Term := apply(constant_of(e, COUNT_SUCCESSOR, []), t)
