# Statements read as terms (notes/coc-plan.md 9.5): a local variable, a choice made as a statement, a loop and an exit
# are ways to write a function, no action on the world. A block is read in order, each statement binding what the
# rest reads: an assignment is a let of its name, its name known equal to its value. A statement of several paths (an
# if, a loop) before the rest of the block reads the rest once, as the join, a function of the names bound before
# it that it assigns, and each path ends by calling it; a return gives the function's value instead. A `for` is the
# count's recursor walking down the rounds left, each round ending by calling the walk of the rounds after it with
# the names it gives, a continue there and then, a break the join. A `while` walks down a bound above its measure,
# each round carrying the proof that the measure fell (measured_walk). A write into a part of a value, a capture's or
# a global's write and a statement that gives nothing the rest reads give no term, and so does a function that
# changes a value in place or calls one that may (changes_in_place): the function is then no definition the kernel
# holds.

use folder
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../rules/lowering.wap"
use "../../kernel/forms.wap"
use "../../kernel/terms.wap"
use "../../kernel/environment.wap"
use "../../kernel/typing.wap"
use "../../kernel/counting.wap"
use "../../kernel/numbers.wap"
use "../../kernel/recursors.wap"
use "../../kernel/equality.wap"
use "../../kernel/logic.wap"
use "../../kernel/compute.wap"
use "../../kernel/equal.wap"
use "../../types/effects.wap"

# the binders of a join, of the rounds left and of the walk of the rounds after a round, ones no program writes
JOIN_BINDER = "·join"
ROUNDS_BINDER = "·rounds"
WALK_BINDER = "·walk"

# where a block's paths go: the type of the value it gives, whether a return gives it (the function's own body), and
# what a break and a continue call, ø outside a loop
class Flow { result: Term; returns: bool; exit: ((Entering) -> Term?)? = ø; next: ((Entering) -> Term?)? = ø }
# the names a statement assigns that are bound before it, each its binding's key, its name and its type now
class Given { keys: list<text>; names: list<text>; types: list<Term> }

# a function's body: a block whose return gives the function's value, any other body its term
body_term(body: Node, x: Entering, result: Term) as Term? := match unwrapped(body) {
	Block(statements) => block_term(statements, x, Flow(result, yes), ø)
	_ => term_of(body, x)
}
# A block's statements read in order, each under the bindings the ones before it leave. The block ends by calling
# `ending` with the bindings it leaves; where there is none, its last statement gives the block's value
block_term(statements: list, x: Entering, flow: Flow, ending: ((Entering) -> Term?)?) as Term? := {
	if statements is empty { return if ending == ø then ø else ending!(x) }
	rest = statements.drop(1)
	statement = unwrapped(statements#1)
	match statement {
		Empty => block_term(rest, x, flow, ending)
		Return(value) => if flow.returns then term_of(value, x) else ø
		Break() => if flow.exit == ø then ø else flow.exit!(x)
		Continue() => if flow.next == ø then ø else flow.next!(x)
		Block(inner) => block_term(inner + rest, x, flow, ending)
		Set(place, value) => if assignable(place, x) then let_read(x, place, kernel_value(value) ?? return ø, term_of(value, x) ?? return ø, inside => block_term(rest, inside, flow, ending)) else ø
		If(condition, then_part, else_part) => joined(statement, rest, x, flow, ending, (inside, after) => chosen(condition, then_part, else_part, inside, flow, after))
		For(place, count, body) => joined(statement, rest, x, flow, ending, (inside, after) => walked(statement, place, count, body, inside, flow, after))
		While(condition, body) => joined(statement, rest, x, flow, ending, (inside, after) => measured_walk(statement, condition, body, inside, flow, after))
		_ => if rest is empty and ending == ø then term_of(statement, x) else ø
	}
}
# whether an assignment gives a name of this reading a new binding: a new local, or a parameter or local bound before;
# a capture's or a global's is a write to a cell, State
assignable(place: Node, x: Entering) as bool := place is Symbol and not is_bound(place, DefinitionKind.Capture) and not is_bound(place, DefinitionKind.Global) and (fact_of(place, DEFINER) != ø or binder_place(x, binding_key(place)) > 0)

# A statement of several paths and the rest of the block: the rest read once as the join, a function of the names
# given, let-bound, and each path ending by calling it with the names as it leaves them; the last statement's paths
# end as the block does
joined(statement: Node, rest: list, x: Entering, flow: Flow, ending: ((Entering) -> Term?)?, split: (Entering, ((Entering) -> Term?)?) -> Term?) as Term? := {
	if rest is empty { return split(x, ending) }
	given = given_of(statement, x) ?? return ø
	named = given_locals(given, x.c)
	join = lambdas(named, block_term(rest, x.under(named, given.keys), flow, ending) ?? return ø)
	let_keyed(x, JOIN_BINDER, JOIN_BINDER, pis(named, flow.result), join, inside => {
		called = inside.variables#(binder_place(inside, JOIN_BINDER))
		split(inside, at => given_to(called, given, at))
	})
}
# the names a statement assigns that are bound before it, of their types now; ø where it assigns a part of a value or
# a name a binding of another type (flow.wap REBOUND), or a name that is no new binding
given_of(statement: Node, x: Entering) as Given? := {
	given = Given([], [], [])
	for part in nodes_in(statement) {
		place = set_place(part)
		if place != ø {
			if not unwrapped(place!) is Symbol or fact_of(place!, REBOUND) != ø or not assignable(place!, x) { return ø }
			key = binding_key(place!)
			at = binder_place(x, key)
			if at > 0 and not given.keys.contains(key) {
				given.keys += [key]
				given.names += [text(place!)]
				given.types += [type_of(x.c, x.variables#at)]
			}
		}
	}
	given
}
given_locals(given: Given, c: Checker) as list<Local> := (1 to #given.keys).list().map(at => entered(c, given.names#at, given.types#at))
# a function of the names given applied to them as a reading holds them now
given_to(function: Term, given: Given, x: Entering) as Term := apply_all(function, given.keys.map(key => x.variables#(binder_place(x, key))))

# a choice's two parts by bool's recursor, each ending as given
chosen(condition: Node, then_part: Node, else_part: Node, x: Entering, flow: Flow, ending: ((Entering) -> Term?)?) as Term? := {
	held = term_of(condition, x) ?? return ø
	parts = [else_part, then_part].map(part => block_term(statements_of(unwrapped(part)), x, flow, ending))
	if parts.any(part => part == ø) then ø else recursor_applied(BOOL_TERM, lambda("_", BOOL_TERM, flow.result), parts.map(part => part!) + [held])
}

# A for, For(at, n, body): the count's recursor walking down the rounds left from ups(n), the walk a function of the
# names the body gives and of the premise that the rounds left are at most ups(n), at the start at_most_same. With
# none left it ends as the block goes on; with l + 1 left its round is at = ups(n) - l, read with what the provers
# show of its range from the premise, and ends by calling the walk of the l after it, its premise chained through
# l <= l + 1; a break ends as the loop does
walked(loop: Node, place: Node, count: Node, body: Node, x: Entering, flow: Flow, ending: ((Entering) -> Term?)?) as Term? := {
	after = ending ?? return ø
	given = given_of(loop, x) ?? return ø
	place_type = kernel_value(place) ?? return ø
	counted = term_of(count, x) ?? return ø
	total = apply(named_constant(UPS), counted)
	c = x.c
	walk = (k: Term) => pis(given_locals(given, c) + [entered(c, MEASURE_PREMISE, at_most_yes(k, total))], flow.result)
	at_none = given_locals(given, c) + [entered(c, MEASURE_PREMISE, at_most_yes(named_constant(COUNT_ZERO), total))]
	left = entered(c, ROUNDS_BINDER, named_constant(COUNT))
	below = entered(c, WALK_BINDER, walk(left.variable))
	round_named = given_locals(given, c)
	premise = entered(c, MEASURE_PREMISE, at_most_yes(successor_of(TYPES.environment, left.variable), total))
	round = x.under([left, below] + round_named + [premise], [ROUNDS_BINDER, WALK_BINDER] + given.keys + [MEASURE_PREMISE])
	still = apply_all(named_constant(AT_MOST_TRANS), [left.variable, successor_of(TYPES.environment, left.variable), total, at_most_successor(left.variable, c), premise.variable])
	next = (at: Entering) => apply(given_to(below.variable, given, at), still)
	place_value = apply(TYPES.environment.integers!.natural, apply_all(named_constant(SUBTRACT), [total, left.variable]))
	ran = let_read(round, place, place_type, place_value, at => ranged(at, place, counted, inside => block_term(statements_of(unwrapped(body)), inside, Flow(flow.result, flow.returns, after, next), next))) ?? return ø
	none = lambdas(at_none, after(x.under(at_none.take(#given.keys), given.keys)) ?? return ø)
	k = entered(c, ROUNDS_BINDER, named_constant(COUNT))
	recursor = named_constant(recursor_name(COUNT), [level_of(c, walk(k.variable))])
	apply(given_to(apply_all(recursor, [lambdas([k], walk(k.variable)), none, lambdas([left, below] + round_named + [premise], ran), total]), given, x), apply(named_constant(AT_MOST_SAME), total))
}
# a round read with its place's range, 1 <= at <= n, as premises, each where the provers prove it from the rounds
# left; one not proved is left out, so an obligation it would prove stays checked when the program runs
ranged(x: Entering, place: Node, count: Term, read: (Entering) -> Term?) as Term? := {
	e = TYPES.environment
	at = x.variables#(binder_place(x, binding_key(place)))
	facts = [apply_all(named_constant(NOT_ABOVE), [int_numeral(e, 1), at]), apply_all(named_constant(NOT_ABOVE), [at, count])].map(fact => truth_stated(e, fact))
	proofs = facts.map(fact => hole_term([], fact, x, yes))
	kept = (1 to #facts).list().filter(fact_at => proofs#fact_at != ø)
	premises = kept.map(fact_at => entered(x.c, NO_BINDER, facts#fact_at))
	body = read(x.under(premises, premises.map(premise => NO_BINDER))) ?? return ø
	apply_all(lambdas(premises, body), kept.map(fact_at => proofs#fact_at!))
}
# the proof that a count is at most its successor, by the count's recursor: at zero at_most computes to yes, at a
# successor to the count before's
at_most_successor(n: Term, c: Checker) as Term := {
	e = TYPES.environment
	k = entered(c, ROUNDS_BINDER, named_constant(COUNT))
	stated = (m: Term) => at_most_yes(m, successor_of(e, m))
	before = entered(c, MEASURE_PREMISE, stated(k.variable))
	recursor_applied(named_constant(COUNT), lambdas([k], stated(k.variable)), [reflexive(e, TYPE_LEVEL, BOOL_TERM, e.literals!.yes_case), lambdas([k, before], before.variable), n], level_of(c, stated(k.variable)))
}

# A while as measured_defined reads a recursion (coc-plan 9.3): the count's recursor on a bound k, the walk a function
# of the names the body gives and of the proof that their measure is below k. Where the condition fails it ends as
# the block goes on. Where it holds: at zero there is no such round, the measure at least 0 and below 0; at k + 1 the
# body runs, and its end, or a continue, calls the walk below k with the proof that the measure fell below k. The
# provers show each, so a measure loops.wap reads wrongly gives no term, never a wrong one. The walk starts at one
# more than the measure's whole part (ups)
measured_walk(loop: Node, condition: Node, body: Node, x: Entering, flow: Flow, ending: ((Entering) -> Term?)?) as Term? := {
	after = ending ?? return ø
	if loop_measured(loop, x.by_key, x.s) == ø { return ø }
	given = given_of(loop, x) ?? return ø
	c = x.c
	named = given_locals(given, c)
	inner = x.under(named, given.keys)
	held = term_of(condition, inner) ?? return ø
	m = Walking(given, named, held, counted_measure(c, held) ?? return ø, body, flow, after, c)
	k = entered(c, ROUNDS_BINDER, named_constant(COUNT))
	below = entered(c, WALK_BINDER, bounded(m, k.variable))
	at_zero = walk_round(m, named_constant(COUNT_ZERO), ø, x) ?? return ø
	at_step = lambdas([k, below], walk_round(m, successor_of(TYPES.environment, k.variable), below.variable, x.under([k, below], [ROUNDS_BINDER, WALK_BINDER])) ?? return ø)
	now = given.keys.map(key => x.variables#(binder_place(x, key)))
	start = successor_of(TYPES.environment, apply(named_constant(UPS), measure_at(m, now)))
	started = hole_term([], measure_below(m, now, start), x, yes) ?? return ø
	recursor = named_constant(recursor_name(COUNT), [level_of(c, bounded(m, k.variable))])
	apply_all(recursor, [lambdas([k], bounded(m, k.variable)), at_zero, at_step, start] + now + [started])
}
# a while read over the names it gives as variables: its condition and measure, and where it goes
class Walking { given: Given; named: list<Local>; held: Term; measure: Term; body: Node; flow: Flow; after: (Entering) -> Term?; c: Checker }
# a term of the given names taken at these values of them
at_values(t: Term, m: Walking, values: list<Term>) as Term := (1 to #m.named).list().fold(t, (term, at) => replaced_by(term, variable_id(m.named#at.variable), values#at))
measure_at(m: Walking, values: list<Term>) as Term := at_values(m.measure, m, values)
# `measure < bound`, the bound a count read as an int
measure_below(m: Walking, values: list<Term>, bound: Term) as Term := truth_stated(TYPES.environment, apply_all(named_constant(BELOW), [measure_at(m, values), apply(TYPES.environment.integers!.natural, bound)]))
# the walk at a bound: a function of the names and of the proof that their measure is below the bound
bounded(m: Walking, bound: Term) as Term := pis(m.named + [entered(m.c, MEASURE_PREMISE, measure_below(m, variables(m.named), bound))], m.flow.result)
# a round at a bound, of the names and the premise: where the condition fails it ends as the loop does; where it
# holds, at zero the provers' proof that no such round is, else the body, ending by the walk below
walk_round(m: Walking, bound: Term, below: Term?, x: Entering) as Term? := {
	e = TYPES.environment
	c = m.c
	named = given_locals(m.given, c)
	values = variables(named)
	premise = entered(c, MEASURE_PREMISE, measure_below(m, values, bound))
	inside = x.under(named + [premise], m.given.keys + [MEASURE_PREMISE])
	condition = at_values(m.held, m, values)
	holds = entered(c, CASE_PREMISE, truths_equal(e, condition, e.literals!.yes_case))
	fails = entered(c, CASE_PREMISE, truths_equal(e, condition, e.literals!.no_case))
	running = inside.under([holds], [CASE_PREMISE])
	at_yes = if below == ø then {
		absurd = hole_term([], truths_equal(e, e.literals!.no_case, e.literals!.yes_case), running, yes) ?? return ø
		apply_all(named_constant(FALSE_ELIM, [level_of(c, m.flow.result)]), [m.flow.result, apply(named_constant(NO_IS_NOT_YES), absurd)])
	} else {
		next = (at: Entering) => fallen(m, below!, predecessor_of(bound), at)
		block_term(statements_of(unwrapped(m.body)), running, Flow(m.flow.result, m.flow.returns, m.after, next), next) ?? return ø
	}
	at_no = m.after(inside.under([fails], [CASE_PREMISE])) ?? return ø
	b = entered(c, "b", BOOL_TERM)
	motive = lambdas([b], pis([entered(c, CASE_PREMISE, truths_equal(e, condition, b.variable))], m.flow.result))
	lambdas(named + [premise], apply(recursor_applied(BOOL_TERM, motive, [lambdas([fails], at_no), lambdas([holds], at_yes), condition]), reflexive(e, TYPE_LEVEL, BOOL_TERM, condition)))
}
# the walk below a bound called with the names as a round leaves them, and the provers' proof that their measure fell
# below what is left
fallen(m: Walking, below: Term, left: Term, x: Entering) as Term? := {
	now = m.given.keys.map(key => x.variables#(binder_place(x, key)))
	proof = hole_term([], measure_below(m, now, left), x, yes) ?? return ø
	apply_all(below, now + [proof])
}
# the count a successor was made of, k of k + 1
predecessor_of(bound: Term) as Term := arguments(bound)#1

# A value checked against a condition when the program runs, `narrowed(i, message, …)` (dispatch.wap narrowed_call),
# read as the value itself where the provers show the condition here from what is known here (wiki/type.md "Proved or
# checked"): the lets' values, a round's range, a while's condition, the parameters' conditions. Its obligations are
# then proved, and the run checks nothing; else the call is read as it is. A let's fact holds only where nothing
# changes in place, so a function that may (changes_in_place) and the
# program's own statements prove nothing here, `n = #xs; xs.pop(); at(xs, n)` keeps its check
obliged_term(n: Node, arguments: list, x: Entering) as Term? := {
	places = obligation_places(n)
	if places is empty or #arguments < 2 or TYPES.prove == ø { return ø }
	records = places.map(at => x.s.obligations#at)
	if not records.all(record => record.choice == 0 and record.row == ø and record.compared == ø and record.call == ø and record.type != ø) { return ø }
	if records.any(record => record.within == ø or changes_in_place(record.within!, effects_joined(x.s), [])) { return ø }
	value = term_of(arguments#1, x) ?? return ø
	read = arguments.drop(2).map(argument => term_of(argument, x))
	if read.any(term => term == ø) { return ø }
	given = read.map(term => term!) + [value]
	if not records.all(record => condition_proved(record, given, x)) { return ø }
	for record in records { record.verdict = yes }
	value
}
# whether the provers prove an obligation's condition at these values, its other names' first, then the value: their
# proof checked by the kernel under the facts as hypotheses, since a wrong one would drop a check the run needs
condition_proved(record: Obligation, given: list<Term>, x: Entering) as bool := {
	condition = named_id(TYPES.environment, record.holds ?? condition_name(TYPES.environment, record.type!) ?? return no) ?? return no
	held = match declared_at(TYPES.environment, condition)!.kind { Defined(value) => value; _ => return no }
	goal = truth_stated(TYPES.environment, beta(held, given))
	proof = hole_term([], goal, x, yes) ?? return no
	proved = try type_of(x.c, proof) catch e { return no }
	equal(x.c, proved, goal)
}

# whether a function changes a value in place, itself or through what it calls, or has State, or calls a function
# value, which may: a name let-bound to a value would then be read as unchanged where the run changes it,
# `k = grown(xs); #xs`, `k = g(xs); #xs`
changes_in_place(key: text, x: Joining, seen: list<text>) as bool := {
	# one met again is counted by its own body; one not typed is not known to change nothing
	if seen.contains(key) { return no }
	if not x.by_key.has(key) { return yes }
	own = own_of(key, x)
	own.in_place or (x.found.get(key) ?? []).contains(Effect.State) or nodes_in(body_of(x.by_key[key])).any(value_called) or own.calls.any(call => changes_in_place(call.key, x, seen + [key]))
}
