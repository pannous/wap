# Typed functions as kernel declarations (notes/coc-t5.md T5a): a function whose body is a pure expression enters the
# compile's environment as a definition, its body a term the kernel checks and computes with; any other stays an
# opaque constant of its signature, an assumption. Pure is: whole numbers, texts and truths, the parameters and the
# names a block lets, a call of a function the kernel took in already, giving each parameter its own type, a host
# operation on whole numbers (kernel/primitives.wap), an `if` on a bool and a block of lets ending in a value. A
# function that calls itself, before its own declaration, stays opaque (T5c).

use folder
use "../errors.wap"
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../rules/typed.wap"
use "../rules/lowering.wap"
use "calls.wap"
use "function_values.wap"
use "../../kernel/terms.wap"
use "../../kernel/environment.wap"
use "../../kernel/typing.wap"
use "../../kernel/forms.wap"
use "../../kernel/primitives.wap"
use "../../kernel/show.wap"
use "../../kernel/counting.wap"
use "../../kernel/numbers.wap"
use "../../kernel/recursors.wap"
use "../../kernel/inductive.wap"
use "../../kernel/levels.wap"

ROW_MARK = "prim"
# the rule a match refuses by that takes a proposition apart into data (wiki/proposition.md "a proof decides no data")
ELIMINATION = "elimination"

# the typed functions entered, callees before their callers: each by its key, once
instances_entered(functions: list<TypedFunction>, s: TypingState) as map<text, TypedFunction> := {
	by_key = instances_keyed(functions)
	for typed in by_key.values() { instance_entered(typed, by_key, s) }
	by_key
}
# the typed functions by their keys; a function value of no Define is no declaration of its own
instances_keyed(functions: list<TypedFunction>) as map<text, TypedFunction> := {
	by_key: map<text, TypedFunction> = {}
	for typed in functions.filter(typed => typed.define is Define) { by_key[instance_key(typed)] = typed }
	by_key
}
instance_key(typed: TypedFunction) as text := function_key(typed.define)
# a typed function's constant, entered the first time: defined where its body is pure and the kernel takes it, else
# assumed. While it is being entered its name is taken, so a call back to it finds no constant and leaves it opaque
instance_entered(typed: TypedFunction, by_key: map<text, TypedFunction>, s: TypingState) as Term? := {
	name = instance_key(typed)
	known = named_id(TYPES.environment, name)
	if known != ø { return constant(known!, name, []) }
	if s.entering.has(name) { return ø }
	s.entering[name] = yes
	type = kernel_settled(instance_type(typed), s)
	value = definition_of(typed, by_key, s)
	kind = if value == ø then DeclarationKind.Axiom else Defined(value!)
	signature = kernel_signature(typed, s)
	if value != ø and signature != ø {
		try declared(TYPES.environment, Declaration(name, [], signature!, kind)) catch e { refused(written_name(typed.define), "the kernel refuses what typing made of this function: ${e.message}") }
		TYPES.defined += 1
	} else {
		axiom_added(TYPES.environment, name, signature ?? type)
		TYPES.assumed += 1
	}
	constant(named_id(TYPES.environment, name)!, name, [])
}
# a function's type as the kernel reads it, a function of its parameters' types: ø where one is open or it never
# returns
kernel_signature(typed: TypedFunction, s: TypingState) as Term? := {
	if typed.jumps { return ø }
	# a parameter keeps its subtype, the parent by definition, so a law reads its binders' conditions
	parameters = typed.arguments.map(type => settled_type(type, s))
	result = kernel_settled(typed.result ?? return ø, s)
	if (parameters + [result]).any(type => has_letters(type) or has_unknowns(type)) { return ø }
	parameters.reverse.fold(result, (body, parameter) => pi(WILDCARD, parameter, body))
}
# a pure function's value, the function of its parameters its body computes; ø for any other
definition_of(typed: TypedFunction, by_key: map<text, TypedFunction>, s: TypingState) as Term? := match typed.define {
	Define(name, parameters, body) => {
		# a body converted to the result, an int given where an int? is, is no term yet
		if kernel_value(body) != kernel_settled(typed.result ?? return ø, s) { return ø }
		names = items_of(parameters).map(parameter => declared_name(parameter))
		value = term_of(body, Entering(names.map(place_key), by_key, s)) ?? return ø
		(1 to #names).reverse.fold(value, (inner, at) => lambda(text(names#at), settled_type(typed.arguments#at, s), inner))
	}
	_ => ø
}
# what a body is read in: the binders around it by their keys, the innermost last
class Entering { binders: list<text>; by_key: map<text, TypedFunction>; s: TypingState }
# a typed node's term, ø where it is not pure
term_of(n: Node, x: Entering) as Term? := match n {
	Number(value) => if value is int and kernel_value(n) == INT_TERM then int_numeral(TYPES.environment, value) else ø
	Text(value) => quoted(value)
	True => TYPES.environment.literals!.yes_case
	False => TYPES.environment.literals!.no_case
	Symbol(name) => binder_term(n, x) ?? case_term(n, n, [], x)
	Call(called, arguments) => called_term(n, called, arguments, x) ?? case_term(n, called, arguments, x)
	Prim(operation, arguments) => row_term(n, text(operation), arguments, x)
	If(condition, then_part, else_part) => choice_term(n, condition, then_part, else_part, x)
	Case(subject, arms) => match_term(n, subject, arms, x)
	Block(statements) => lets_term(statements, x)
	_ => ø
}
# a name a binder around it holds, by its distance to it
binder_term(n: Node, x: Entering) as Term? := {
	definer = fact_of(n, REBOUND) ?? fact_of(n, DEFINED_AT) ?? return ø
	at = x.binders.index_of(place_key(definer))
	if at <= 0 then ø else bound(#x.binders - at)
}
# a call of a typed function the kernel took in, each argument of its parameter's own type, giving its own result
called_term(n: Node, called: Node, arguments: list, x: Entering) as Term? := {
	definer = fact_of(called, DEFINED_AT) ?? return ø
	typed = x.by_key.get(place_key(definer)) ?? return ø
	if kernel_value(n) != kernel_settled(typed.result ?? return ø, x.s) or #arguments != #typed.arguments or (1 to #arguments).any(at => kernel_value(arguments#at) != kernel_settled(typed.arguments#at, x.s)) { return ø }
	function = instance_entered(typed, x.by_key, x.s) ?? return ø
	terms_applied(function, arguments, x)
}
# a host operation on whole numbers, its row's constant of the operands' types
row_term(n: Node, operation: text, arguments: list, x: Entering) as Term? := {
	if not FOLDED_ROWS.contains(operation) { return ø }
	types = (arguments + [n]).map(part => kernel_value(part))
	if types.any(type => type == ø) { return ø }
	terms_applied(row_constant(operation, types), arguments, x)
}
# a host operation's constant of the types it takes and gives, declared once
row_constant(operation: text, types: list<Term?>) as Term := {
	type = types.take(#types - 1).reverse.fold(types.last!, (body, parameter) => pi(WILDCARD, parameter!, body))
	name = row_name(operation, type)
	meaning = if types.take(2).all(part => part == INT_TERM) then int_meaning(TYPES.environment, operation) else ø
	if named_id(TYPES.environment, name) == ø { added(TYPES.environment, Declaration(name, [], type, if meaning == ø then Row(operation) else Defined(meaning!))) }
	constant(named_id(TYPES.environment, name)!, name, [])
}
# the name a row's constant takes: its operation and the types it takes and gives, `prim i64.add int -> int -> int`
row_name(operation: text, type: Term) as text := "${ROW_MARK} ${operation} ${arrow_parts(type).map(part => shown(part)).join(" -> ")}"
# a function type's parameter types and its result
arrow_parts(type: Term) as list<Term> := match type.shape {
	Pi(binder, domain, body) => [domain] + arrow_parts(body)
	_ => [type]
}
# an `if` on a bool: bool's recursor into the type both arms give, the arm at no before the arm at yes
choice_term(n: Node, condition: Node, then_part: Node, else_part: Node, x: Entering) as Term? := {
	type = kernel_value(n) ?? return ø
	if kernel_value(condition) != BOOL_TERM or kernel_value(then_part) != type or kernel_value(else_part) != type { return ø }
	terms = [else_part, then_part, condition].map(part => term_of(part, x))
	if terms.any(term => term == ø) then ø else recursor_applied(BOOL_TERM, type, terms.map(term => term!))
}
# a type's recursor into a constant motive, the result type, at the result's level, applied to its minor premises and
# then the major premise; a proposition's enum, which its recursor takes apart only into propositions (And, Or,
# Exists), refused where the result is data
recursor_applied(type: Term, result: Term, arguments: list<Term>) as Term := {
	name = recursor_name(constant_name(type))
	recursor = named_id(TYPES.environment, name) ?? refused(ELIMINATION, "${constant_name(type)} has no recursor")
	level = simplified(level_of(checker(TYPES.environment, []), result))
	any_motive = block_of(TYPES.environment, type, ELIMINATION).any_motive
	if not any_motive and not is_zero(level) { refused(ELIMINATION, "${constant_name(type)} is a proposition, taken apart only into a proposition, never into ${shown(result)}") }
	apply_all(apply(constant(recursor, name, if any_motive then [level] else []), lambda(WILDCARD, type, result)), arguments)
}
# a `match` with every arm's result of its type: on a defined enum, a minor premise for each case of its recursor, on
# whole numbers a chain of choices (guards and nested patterns give no term)
match_term(n: Node, subject: Node, arms: list, x: Entering) as Term? := {
	type = kernel_value(n) ?? return ø
	domain = kernel_value(subject) ?? return ø
	if arms is empty or arms.any(arm => kernel_value(arm_result(arm)) != type) { return ø }
	if domain == INT_TERM { return literals_term(subject, arms, type, x) }
	if TYPES.enums.get(word_id(domain)) != ENUM_DEFINED { return ø }
	block = block_of(TYPES.environment, domain, "match").block
	if #block.types != 1 { return ø }
	minors = block.types#1.cases.map(case => case_minor(named_id(TYPES.environment, case.name)!, arms, domain, type, x))
	major = term_of(subject, x) ?? return ø
	if minors.any(minor => minor == ø) then ø else recursor_applied(domain, type, minors.map(minor => minor!) + [major])
}
# the constructor a pattern names, ø for a name or `_`
pattern_constructor(pattern: Node) as int? := TYPES.constructors.get(place_key(fact_of(case_name(pattern), DEFINED_AT) ?? return ø))
# a case's minor premise: the fields, then a hypothesis for each field of the enum itself, under the first arm that names
# the case or fits any value, a name there holding the case's value
case_minor(id: int, arms: list, domain: Term, type: Term, x: Entering) as Term? := {
	constructor = declared_at(TYPES.environment, id)!
	fields = arrow_parts(constructor.type).take(#arrow_parts(constructor.type) - 1)
	arm = arms.find(arm => [id, ø].contains(pattern_constructor(pattern_of(arm)))) ?? return ø
	pattern = pattern_of(arm)
	named = pattern_constructor(pattern) == id
	names = if named then case_fields(pattern) else fields.map(field => symbol(WILDCARD))
	if #names != #fields or names.any(name => not name is symbol) { return ø }
	hypotheses = fields.filter(field => field == domain).map(field => type)
	keys = names.map(name => place_key(name)) + hypotheses.map(hypothesis => WILDCARD)
	inner = Entering(x.binders + keys, x.by_key, x.s)
	body = if named or pattern == symbol(WILDCARD) then term_of(arm_result(arm), inner) else let_in(text(pattern), domain, apply_all(constant(id, constructor.name, []), (1 to #fields).list().map(at => bound(#keys - at))), term_of(arm_result(arm), Entering(inner.binders + [place_key(pattern)], x.by_key, x.s)))
	binders = fields + hypotheses
	if body == ø then ø else (1 to #binders).reverse.fold(body!, (inner_term, at) => lambda(if at <= #names then text(names#at) else WILDCARD, binders#at, inner_term))
}
# whole-number arms, `0 => a; 1 => b; _ => c`, as chained choices on their equality, the last arm fitting any value;
# an arm of any other pattern, a name binding the value or a nested pattern, gives no term, and the match is left to
# the run
literals_term(subject: Node, arms: list, type: Term, x: Entering) as Term? := {
	if arms is empty { return ø }
	pattern = pattern_of(arms#1)
	result = term_of(arm_result(arms#1), x) ?? return ø
	if #arms == 1 { return if pattern == symbol(WILDCARD) then result else ø }
	if not pattern is Number { return ø }
	literal = term_of(pattern, x) ?? return ø
	rest = literals_term(subject, arms.drop(1), type, x) ?? return ø
	given = term_of(subject, x) ?? return ø
	recursor_applied(BOOL_TERM, type, [rest, result, apply_all(row_constant("i64.eq", [INT_TERM, INT_TERM, BOOL_TERM]), [given, literal])])
}
# a block of lets, each a name new to it given its value, ending in the value it gives
lets_term(statements: list, x: Entering) as Term? := {
	if statements is empty { return ø }
	match statements#1 {
		Set(place, value) => {
			if #statements == 1 or not place is Symbol or fact_of(place, DEFINER) == ø or x.binders.contains(place_key(place)) { return ø }
			type = kernel_value(value) ?? return ø
			given = term_of(value, x) ?? return ø
			rest = lets_term(statements.drop(1), Entering(x.binders + [place_key(place)], x.by_key, x.s)) ?? return ø
			let_in(text(place), type, given, rest)
		}
		_ => if #statements == 1 then term_of(statements#1, x) else ø
	}
}
terms_applied(function: Term, arguments: list, x: Entering) as Term? := {
	terms = arguments.map(argument => term_of(argument, x))
	if terms.any(term => term == ø) then ø else apply_all(function, terms.map(term => term!))
}
# a type as the kernel reads a value's: a subtype by condition is its parent's
kernel_type(type: Term?) as Term? := if type != ø and subset_condition(type) != ø then kernel_type(narrowed_type(type)) else type
kernel_settled(type: Term, s: TypingState) as Term := kernel_type(settled_type(type, s))!
kernel_value(n: Node) as Term? := kernel_type(value_type(n))

# Each subtype's condition, a definition of the parent's values named after the subtype, `int where it >= 0 holds`:
# typed as the function value it is with the program's functions, then its body read with `it` its one binder
CONDITION_HOLDS = " holds"
class Condition { type: Term; typed: TypedFunction }
conditions_typed(s: TypingState) as list<Condition> := {
	conditions: list<Condition> = []
	for type in TYPES.subsets {
		written = written_bound(subset_condition(type)!, s)
		match written {
			Fn(parameters, body) => {
				function = lambda_of(written, parameters, body, s)
				conditions += [Condition(type, shaped_typed(function, [function_value_type(function.key, []), narrowed_type(type)!], s, written))]
			}
			_ => raise "a subtype's condition is a function value"
		}
	}
	conditions
}
# a condition the kernel cannot hold, one calling what it only assumes, is left out: a law over its subtype is refused
# for it (extensions/verify/laws.wap)
conditions_entered(conditions: list<Condition>, by_key: map<text, TypedFunction>, s: TypingState) := for condition in conditions { condition_entered(condition, by_key, s) }
condition_entered(condition: Condition, by_key: map<text, TypedFunction>, s: TypingState) := match condition.typed.define {
	Define(name, parameters, body) => {
		keys = items_of(parameters).map(parameter => place_key(declared_name(parameter)))
		value = term_of(body, Entering(keys, by_key, s)) ?? return
		parent = narrowed_type(condition.type)!
		added(TYPES.environment, Declaration(condition_name(TYPES.environment, condition.type)!, [], pi("_", parent, BOOL_TERM), Defined(lambda(IT_WORD, parent, value))))
	}
	_ => ø
}
# the name of a subtype's condition: its word's name and "holds"
condition_name(e: Environment, type: Term) as text? := (declared_at(e, word_id(type)) ?? return ø).name + CONDITION_HOLDS
