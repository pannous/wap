# The typing stage: bound kernel → typed kernel (notes/backbone.md "Stage languages").
#
# Every value learns its type, a fact TYPE, and every function its signature, a fact SIGNATURE on its name
# (core/stage.wap), so the emitter reads a type instead of learning it by emitting the code. Types are written as a
# program writes them: int, float, text, char, bool, ø; a signature `(int, text) -> int`. Code that gives no value has
# no TYPE.
#
# Typing is local and runs both ways: a call's arguments are typed first, then the call picks the function it means
# among the definitions its name may mean (core/analyze/scope.wap CANDIDATES): by the number of arguments, then their
# types, then the type the call is expected to give. None left, or several, is refused naming them, never a guess.
# A literal takes the type its place expects where it reads both ways: `"a"` is a char, or a text where one is wanted.
#
#   f(x: int) := x          f: (int) -> int
#   f(x: text) := 1         f: (text) -> int
#   f "a"                   the second f
#   g(x) := x               a parameter without a type: g is typed once for each tuple of argument types it is
#   g 1; g "ab"             called with, g: (int) -> int and g: (text) -> text, each a Define of its own
#
# A function is typed when a call reaches it, with that call's argument types; one whose parameters all have their
# types is typed even when nothing calls it, so its errors show. A function that calls itself needs its result type
# written: `f(n: int): int := …`. The result is the program, the types module's functions it calls first.

# DEBT: Boxed `any` in wap's own source: a value whose type typing can't name yet is boxed as `any` and checked where
#   it enters a typed place, though the compiler's source should stay fully typed (first_principles.md). Only this
#   file decides what is boxed, the emitter never infers it; each boxed spot is one entry of
#   test/wap/guardrails_allowed.txt, which may only shrink. Paid off when that list is empty (milestone 2 requires
#   it).
# DEBT: This file reaches rules/ (typed.wap) through a `use`, because wap cannot call a function value read from a
#   field (`this holds a function, no function to call`). Paid off when a field's function value can be called: it
#   becomes a function value on TypingState.

use folder
use "../errors.wap"
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"
use "../../kernel/surface.wap"
use "../../kernel/primitives.wap"
use "../../kernel/terms.wap"
use "../../kernel/levels.wap"
use "../rules/typed.wap"
use "flow.wap"

# what a conversion refused at a function's result says the function promised
FUNCTION_GIVES = "the function says it gives"
# the operator a signature is written with: `(int, text) -> int`

# The type a key has: a variable's by its place's key, a generic letter's, an unknown's (α1) once settled
class Binding { key: text; type: Term }
# A call of a function typed only once its unknowns settle: the definition, the argument types, the call, and the
# instance it was given till then
class Deferred { definition: Signature; types: list<Term>; at: Node; given: TypedFunction }
# What the stage knows of the whole program: the definitions seen so far, the functions typed, the globals' types
class TypingState {
	definitions: list<Signature> = []
	# the typed functions being entered into the kernel (terms.wap), by key
	entering: map<text, bool> = {}
	# each definition as it is now, by its record's key: shaped, bound, lifted (define_of)
	defines: map<text, Define> = {}
	# the definitions' places by name, for definitions_named, and by the key of the place each is written at, for
	# definition_keyed (core/analyze/calls.wap)
	definition_names: NameIndex = NameIndex()
	definition_keys: NameIndex = NameIndex()
	records: Records = Records()
	functions: list<TypedFunction> = []
	# the same typed functions by their function's key, where a call finds the instance it reuses
	instances: map<text, list<TypedFunction>> = {}
	globals: list<Binding> = []
	# the keys of the globals functions read before the statements that give them their values, until those statements
	unset: list<text> = []
	# the types the library's globals are declared with, `c_handles: map<int, int> = {}`, which a function reads before
	declared: list<Binding> = []
	# the functions of the function values met, by their keys, and the keys of the variables they capture
	lambdas: map<text, Node> = {}
	# the functions dynamic calls dispatch through (core/analyze/dispatch.wap)
	dispatchers: list<Node> = []
	# the typed functions' effects as last joined (core/analyze/effects.wap)
	joined: Joining? = ø
	captured: list<text> = []
	# what the conditions around a function value find of the variables it captures, by its function's key: the
	# captures are copied when the value is made, so its body reads them as found there (core/analyze/function_values.wap)
	found_in: map<text, list<Finding>> = {}
	# the empty lists' item types a use has to settle, α1, α2 …, holes of the elaboration that answers them, by id
	unknowns: map<int, Term> = {}
	el: Elaboration = elaboration(TYPES.environment, [])
	# the holes each definition's letters stand for in its calls, by the definition's key (letters.wap letter_holes)
	letter_holes: map<text, list<Binding>> = {}
	# the levels a call writes in brackets glued to the name it calls, by that name (calls.wap level_written_call)
	levels_written: map<text, list<Level>> = {}
	# the types a call at a written level gives its definition's letters, by the name it calls (calls.wap implicit_typed)
	letters_given: map<text, list<Binding>> = {}
	# the calls of functions typed only once their unknowns settle
	deferred: list<Deferred> = []
	# the instance each deferred call got once its unknowns settled, by the key of the one it was given till then: the
	# two differ where settling collapses an optional, `!` of a β? whose β settles to text? gives text (letters.wap)
	settled_calls: map<text, Node> = {}
	# the functions wap refuses, each ended alone: its siblings are typed anyway, and its callers refused naming it
	refusals: list<Refusal> = []
	# the ids of the names typing writes once for the whole program (core/stage.wap DEFINER)
	ids: Definers = Definers(".")
	# the typed rules, which fire on each node as typing writes it (core/rules/typed.wap)
	kind_rules: KindRules? = ø
	# the scope the library's functions bind in, each once typing reaches it (core/analyze/scope.wap library_bound)
	library_scopes: map<text, Scope> = {}
	# the list and map types values were boxed into an any as, and the dispatches that choose among generic definitions
	# by them (core/analyze/dispatch.wap)
	boxed: list<Term> = []
	dispatches: list<Dispatch> = []
	# the own types of the function values that meet where one type holds them, by the unknown holding them until a
	# call or a written type settles it to a signature (core/analyze/function_values.wap functions_joined)
	members: map<int, list<Term>> = {}
	# what the names holding any where paths meet said (core/analyze/flow.wap); the variables a let or a written type
	# keeps at their type, by key (wiki/type.md "Writing a type")
	retypings: list<text> = []
	fixed: list<text> = []
	# the globals the program gives values of other types, by key, and the functions' reads of globals
	rebound_globals: list<text> = []
	function_globals: list<Node> = []
}
# a function's typed instances so far, and one more
instances_of(key: text, s: TypingState) as list<TypedFunction> := s.instances.get(key) ?? []
instance_added(typed: TypedFunction, s: TypingState) := {
	s.functions += [typed]
	instance_indexed(typed, s)
}
instance_indexed(typed: TypedFunction, s: TypingState) := s.instances[typed.function.key] = instances_of(typed.function.key, s) + [typed]
# A name typing writes for a definer, with that definer's id: a λ its Fn's, a dispatcher its first candidate's, a
# dispatcher's parameters its own; the name tells it from the definer and its siblings
name_for(word: text, definer: Node, at: Node? = ø) as Node := with_fact(placed_like(symbol(word), at ?? definer), DEFINER, fact_of(definer, DEFINER) ?? refused(definer, "a definer without an id"))
# a name typing writes once for the whole program, wherever it is wanted, with an id of its own
name_once(word: text, at: Node, s: TypingState) as Node := identified(placed_like(symbol(word), at), s.ids)
# a function wap refuses: its key, why, and the first reason of its chain, a function it calls refused first
class Refusal {
	key: text
	message: text
	first: text
}
# A function typed for one tuple of argument types: the function, its argument types, its result's type (ø until its
# body gives it) and the Define it became
class TypedFunction {
	function: Signature
	arguments: list<Term>
	result: Term? = ø
	define: Node = ø
	done: bool = no
	# the globals it reads, itself or through the functions it calls, before the statements that give them their values
	late: list<Node> = []
	# whether it never returns: its result written `never`, or its body jumps and nothing returns
	jumps: bool = no
	# whether its body calls it before its result is known: such a call gives no value, so the body is typed again with
	# the result its other arms give (calls.wap shaped_typed); and what to write where a value is wanted of such a call
	called_unknown: bool = no
	unknown_result: text = ""
}
# the type a typed function gives: ø's own when it gives nothing, `T` of `-> T` bound to ø; none while its result is not
# known yet
result_given(typed: TypedFunction) as Term? := typed.result ?? (if typed.done then EMPTY_TERM else ø)
# What a condition finds of a variable: its key, the arm it holds in (1 then, 2 else), the type it reads as there
class Finding { key: text; arm: int; type: Term }
# what a variable that holds a condition finds, `present = x != ø`, as the condition itself would: an If over the
# variable finds it, until the variable or a path the findings name is given a new value
class HeldCondition { key: text; findings: list<Finding> }
# The function whose body is being typed: its variables' types and its written result type
class TypeFrame {
	variables: list<Binding> = []
	result: Term? = ø
	# the types its returns give, ø for a bare return
	returns: list<Term?> = []
	# the generic letters its parameters bound (core/analyze/calls.wap)
	letters: list<Binding> = []
	# what the conditions around find of their variables: an optional one present, read as its value; one any or a
	# number holds, of the type tested, read as that (core/analyze/conditions.wap if_typed)
	present: list<Finding> = []
	held: list<HeldCondition> = []
	# the name of the function typed, ø for the program
	function: Node? = ø
	# the globals it reads before the statements that give them their values (TypedFunction late)
	late: list<Node> = []
	# whether what is typed is a typed rule's output, on which the typed rules do not fire (core/rules/typed.wap)
	rewritten: bool = no
	# the names this path gives a binding of their own, and the loop's around it as its round began (core/analyze/flow.wap)
	bound: list<Bound> = []
	loop_entry: list<Bound> = []
}

# the program typed, after the types module's functions it calls, the typed rules firing as it is typed; its definitions
# first checked against the functions every program has (words): those its own file writes, beside the types every
# module it uses declares
typed_program(program: Block, library: Library, rules: KindRules, signatures: list<Signature>, words: list<Signature>, written: list<Signature>) as Block := typed_among(program, statements_in(library.code), rules, library.scopes, library.signatures + signatures, TypingState(), written, words, signatures)
# the program typed, after the library's records and those of its definitions it calls, each definition shaped and
# bound when typing first reaches it (core/analyze/calls.wap reached)
typed_among(program: Block, library: list, rules: KindRules, library_scopes: map<text, Scope>, signatures: list<Signature>, before: TypingState = TypingState(), defined: list<Signature> = [], words: list<Signature> = [], declared: list<Signature> = []) as Block := {
	s = TypingState()
	# shared with the round before: the unknowns types may name and the function values those hold
	s.unknowns = before.unknowns
	s.el = before.el
	back_to(s.el, Found({}, {}, [], [], []))
	s.members = before.members
	s.boxed = before.boxed.drop(0)
	s.kind_rules = rules
	s.library_scopes = library_scopes
	s.ids = definers_of(program)
	defines = defines_in(library)
	# the records declare wrote, then those of the definitions lowering wrote beside them
	s.definitions = signatures.filter(signature => is_function(signature))
	definitions_held(defines, s)
	records_added(library, s)
	globals_declared(library, s)
	overloads_checked(defined, declared, words, s)
	runtime_typed(defines, s)
	library_typed = library_values(library).map(value => typed_form(value, s, TypeFrame(), ø))
	typed = try typed_form(program, s, TypeFrame(), ø) catch e { refused_all(s, [e.message]) }
	global_reads_checked(s)
	conditions = conditions_typed(s)
	if s.refusals { refusals_kept(s) }
	for retyping in s.retypings { hint(retyping) }
	statements = library_typed + statements_in(typed)
	if memory_of(s) == ø { exported_dispatchers(defined, s) }
	if s.unknowns is not empty { all_settled(s) }
	if dispatches_completed(s) { return typed_among(program, library, rules, library_scopes, signatures, s) }
	s.functions = distinct_instances(s.functions, s)
	s.instances = {}
	for instance in s.functions { instance_indexed(instance, s) }
	enums_entered(s.records.items)
	conditions_entered(conditions, instances_entered(s.functions, s), s)
	effects_written(s)
	written = defines + s.lambdas.values() + s.dispatchers
	# the records stand first, shaped: the program's own leave the statements
	placed = statements_in(instances_placed(refitted(Block(statements), typed), s)).filter(statement => not statement is Record)
	whole = refitted(Block(s.records.items + functions_typed_from(written, s) + placed), typed)
	if s.unknowns is not empty then settled_everywhere(whole, s) else whole
}
# the library's functions the emitter calls itself (kernel/primitives.wap RUNTIME_WORDS), typed as a call would
runtime_typed(library: list, s: TypingState) := for definition in library.filter(define => runtime_named(text(defined_name(define)))).map(define => held_function(define, s)).filter(held => runtime_word(held.name, held.parameters) != ø) { function_typed(definition, definition.parameters, s, define_of(definition, s)) }
# the values a compiled library takes from its module, each `c_outs: int = prim foreign(…)`: typed before the program
# and its first statements, so the program imports each as it imports a used module's, and they hold before it reads one
library_values(library: list) as list := library.filter(statement => match statement { Set(place, value) => value is Prim and declared_type(place) != ø; _ => no })
# the names that came to hold any, then every function wap refuses and what else stopped the program, said together
refusals_kept(s: TypingState) := {
	kept = TYPES.refused ?? refused_all(s, [])
	for each in s.refusals { kept[each.key] = each.message }
	TYPES.refused = kept
}
refused_all(s: TypingState, more: list) := raise (s.retypings + s.refusals.map(each => each.message) + more).join("\n")
# whether a typed form gives a value: not none, not a jump that never comes back
gives_value(n: Node) as bool := fact_of(n, TYPE) != ø and not jumps(n) and valued(value_type(n))
# whether a type is one of a value: not none, not ø alone
# a typed form's value type, refused where it gives none, saying where the value is wanted: "to pass", "to test" …; a
# call of a function whose result is not known yet says what to write
value_of(n: Node, wanted: text) as Term := value_type(n) ?? refused(n, text_of(fact_of(n, RESULT_UNKNOWN)) ?? "this gives no value ${wanted}")
# a fact's text, ø for none
text_of(fact: Node?) as text? := match fact { Text(value) => value; _ => ø }
valued(type: Term?) as bool := value_bearing(type) != ø
# a type that holds a value, ø for none or ø's own
value_bearing(type: Term?) as Term? := if type == EMPTY_TERM then ø else type
jumps(n: Node) as bool := has_fact(n, JUMPS)
jumping(n: Node) as Node := with_fact(n, JUMPS, True)
# n typed as the code it gives the value of: of its type, or jumping with it, `{ x = 1; return x }`, or a call of a
# function whose result is not known yet with it
typed_like(n: Node, source: Node) as Node := if jumps(source) then jumping(n) else if has_fact(source, RESULT_UNKNOWN) then with_fact(n, RESULT_UNKNOWN, fact_of(source, RESULT_UNKNOWN)!) else with_type_of(n, value_type(source))

# a kernel form with the types it learned, expected the type its place wants, ø for any, then rewritten by a typed rule
# that fits it (core/rules/typed.wap); the code a typed rule's hole took as it is
typed_form(n: Node, s: TypingState, f: TypeFrame, expected: Term?) as Node := if fact_of(n, TYPED_HOLE) != ø then n else kind_rewritten(form_typed(n, s, f, expected), s, f, expected)
form_typed(n: Node, s: TypingState, f: TypeFrame, expected: Term?) as Node := match n {
	Block(statements) => block_typed(n, statements, s, f, expected)
	Define(name, parameters, body) => n
	Set(place, value) => set_typed(n, place, value, s, f, expected)
	Call(called, arguments) => call_typed(n, called, arguments, s, f, expected)
	Prim(operation, arguments) => prim_typed(n, operation, arguments, s, f, expected)
	If(condition, then_part, else_part) => if_typed(n, condition, then_part, else_part, s, f, expected)
	While(condition, body) => refitted(While(condition_typed(condition, s, f), looped(body, s, f)), n)
	For(place, count, body) => for_typed(n, place, typed_form(count, s, f, INT_TERM), body, s, f)
	# the body's value, or the otherwise part's where the body raises (wiki/Error.md "try"): joined as an if's arms
	Try(body, handler) => try_typed(n, body, handler, s, f, expected)
	Case(subject, arms) => case_typed(n, typed_form(subject, s, f, ø), arms, s, f, expected)
	Return(value) => return_typed(n, value, s, f)
	Break() => { jump_checked(n, f); jumping(n) }
	Continue() => { jump_checked(n, f); jumping(n) }
	Record(name, fields, variants) => s.records.items.find(record => place_key(record_declared(record)) == place_key(name)) ?? refused(n, "typing holds no record declared here: the pipeline lost it")
	Key(head, Op.None, List(items, Bracket.Curly, separator)) => instance_typed(n, head, items, separator, s, f)
	Get(subject, key) => part_got(n, typed_form(subject, s, f, ø), key, s, f, expected)
	List(items, Bracket.Square, separator) => parted_rewritten(list_typed(n, items, separator, s, f, expected), n, s, f, expected)
	List(items, Bracket.Curly, separator) => map_typed(n, items, separator, s, f, expected)
	Item(subject, key) => item_typed(n, subject, key, s, f)
	Fn(parameters, body) => function_value_typed(n, parameters, body, s, f)
	Symbol(name) => name_typed(n, s, f, expected)
	Char(value) => if expected == TEXT_TERM then char_text(n) else with_type(n, CHAR_TYPE)
	Number(value) => with_type(n, if value is int then whole_type(n, value, expected) else FLOAT_TYPE)
	Text(value) => with_type(n, TEXT_TYPE)
	True => with_type(n, BOOL_TYPE)
	False => with_type(n, BOOL_TYPE)
	Empty => n
	_ => refused(n, "the typing stage reads only kernel forms")
}
with_type(n: Node, type: text) as Node := with_type_of(n, word_term(type))
# a whole numeral's type: the whole word wanted, `x: i32 = 5`, else int; refused where it does not fit the word's bits
whole_type(n: Node, value: int, expected: Term?) as text := {
	word = if expected != ø and WHOLE_BITS.has(type_text(expected)) then type_text(expected) else INT_TYPE
	if WHOLE_BITS[word] < WHOLE_BITS[INT_TYPE] and (value >= 2 ^ (WHOLE_BITS[word] - 1) or value < -(2 ^ (WHOLE_BITS[word] - 1))) { refused(n, "${value} does not fit an ${word}, a machine word of ${WHOLE_BITS[word]} bits") }
	word
}
# the type of a typed form's value, ø when it gives none
value_type(n: Node) as Term? := if n is Empty then EMPTY_TERM else fact_type(fact_of(n, TYPE))
with_type_of(n: Node, type: Term?) as Node := if type == ø then n else with_fact(n, TYPE, type_fact(type!))
# a type as a value (wiki/universe.md): of its universe, held as the text that shows it
type_value(type: Term, at: Node) as Node := with_fact(with_type_of(placed_like(Text(type_text(type)), at), universe_of(type)), DENOTES, type_fact(type))
# whether a name in value position is the type it names: a universe, or a type word where no function type is wanted
# (a function of its name is then meant) and no case of the enum wanted
names_type_value(n: Node, expected: Term?, s: TypingState) as bool := universe_written(n) != ø or function_parts(expected) == ø and (fact_of(n, BINDING) == ø or names_function(n)) and names_type(n, s) and expected_case(n, expected, s) == ø

# Statements typed in order, the last one expected the block's type. A function it defines stays as written until the
# whole program is typed (instances_placed); one whose parameters all have their types is typed even when nothing
# calls it, unless it is TYPED_WHEN_CALLED.
block_typed(n: Node, written: list, s: TypingState, f: TypeFrame, expected: Term?) as Node := {
	definitions_held(defines_in(written), s)
	records_added(written, s)
	for definition in defines_in(written) { claim_checked(held_function(definition, s), s) }
	# each definition as the typing stage keeps it, its written types' shapes known once all are: a pattern's builder
	# may come after a definition naming its type
	statements = written.map(statement => if statement is Define then define_of(held_function(statement, s), s) else statement)
	# a statement wap refuses still lets the definitions beside it be typed, so their refusals are said with its own
	typed = try (1 to #statements).map(at => typed_form(statements#at, s, f, if at == #statements then expected else EMPTY_TERM)) catch e {
		typed_alone(statements, s)
		raise e.message
	}
	typed_alone(statements, s)
	block = refitted(Block(typed), n)
	if typed is empty then block else typed_like(block, typed.last)
}
# each definition whose parameters all have their types typed, even when nothing calls it, unless TYPED_WHEN_CALLED; a
# proof at its letters too, so its claim to do nothing but compute is checked (other code at letters is typed where it
# is called); one wap refuses ends alone. The catch is empty because function_typed has already kept its refusal for the
# end: only what function_typed raises may reach it, never a raise that skips that record
typed_alone(statements: list, s: TypingState) := for statement in statements {
	if statement is Define and fact_of(statement, TYPED_WHEN_CALLED) == ø {
		held = held_function(statement, s)
		types = if all_typed(held, s.records) then held.parameters else if annotation(statement, PROOF_ANNOTATION) != ø then letters_fixed(held) else ø
		if types != ø { try function_typed(held, types!, s, statement) catch e { } }
	}
}
# the mark of a law's or a theorem's proof (extensions/laws.wap)
PROOF_ANNOTATION = "proof"
# A definition's parameter types for every letter at once: each level letter at Type, each type letter a type of its
# own that nothing else is, so what holds of it holds for each (a proof's binders, wiki/proof.md); ø where a parameter
# has no type
letters_fixed(definition: Signature) as list<Term?>? := {
	if definition.parameters.any(type => type == ø) { return ø }
	levels = level_names(definition)
	fixed = levels_bound(levels, levels.map(name => level_above(Zero, 1))) + letters_written(definition).map(letter => Binding(letter, word_keyed(letter, "${definition.key} ${letter}")))
	definition.parameters.map(type => type_substituted(type!, fixed))
}
# a definition as the typing stage holds it
held_function(definition: Node, s: TypingState) as Signature := definition_keyed(function_key(definition), s) ?? function_of(definition)
# a definition's Define as it is now, found by its record's key; a record whose Define typing never saw is the
# pipeline's bug, never skipped
define_of(definition: Signature, s: TypingState) as Define := s.defines.get(definition.key) ?? refused(Text(definition.key), "typing holds no definition for this record: the pipeline lost it")
# the library globals' written types, shaped, which its functions read before the statements that give the values
globals_declared(statements: list, s: TypingState) := { s.declared += statements.filter(statement => statement is Set and declared_type(statement) != ø).map(statement => Binding(place_key(declared_name(statement)), shaped(type_term(declared_type(statement)!), s))) }
# the records among statements added to those typing knows, their fields' written types shaped once all are known, as
# a definition's are: a field of a pattern's type holds a Node
records_added(statements: list, s: TypingState) := {
	s.records = added_records(s.records, statements)
	if statements.any(statement => statement is Record) { s.records = Records(s.records.items.map(record => record_shaped(record, s)), s.records.names, s.records.extending) }
}
record_shaped(record: Node, s: TypingState) as Node := match record {
	Record(name, fields, variants) => refitted(Record(name, with_items(fields, items_of(fields).map(callable_held).map(field => if names_bare_kind(written_type(declared_type(field))) then refused(field, "a field writes its full type, list<int> rather than list: a bare kind takes the type of the value given, which a field has none of") else shaped_key(field, s))), variants), record)
	_ => record
}
# a field written `block` or a bare `function` holds one function value of one layout: one called as () -> any
callable_held(field: Node) as Node := match field { Set(place, value) => refitted(Set(callable_held(place), value), field); _ => if text(declared_type(field) ?? Empty) in [BLOCK_WORD, FUNCTION_WORD] then refitted(Key(declared_name(field), Op.Colon, written_of(function_type_of([], ANY_TERM))), field) else field }
# the definitions among statements
defines_in(statements: list) as list<Define> := statements.flat_map(statement => if statement is Define then [statement] else [])
# Defines typing now holds, each by its record's key unless it holds one already: the record declare wrote, else one
# made of it; a block typed again, a typed rule's code around it, adds only what typing does not hold yet
definitions_held(defines: list<Define>, s: TypingState) := for define in defines {
	key = function_key(define)
	if not s.defines.has(key) { s.defines[key] = define }
	# a record not reached yet, so the library's definitions are bound only once typing reaches them
	if definitions_keyed(key, s) is empty { s.definitions += [function_of(define)] }
}
# a function the typing stage writes itself, held with the written ones
function_added(definition: Define, s: TypingState) as Signature := {
	definitions_held([definition], s)
	definition_keyed(function_key(definition), s)!
}
# The typed program with each definition it writes standing where it was written as the functions it became, once
# every unknown settled: instances one settling made alike are one (letters.wap distinct_instances)
instances_placed(n: Node, s: TypingState) as Node := match n {
	Block(statements) => refitted(Block(statements.flat_map(statement => if statement is Define then functions_typed_from([statement], s).map(define => instances_placed(define, s)) else [instances_placed(statement, s)])), n)
	_ => refitted(with_parts(n, part => instances_placed(part, s)), n)
}
# the Defines each of these definitions became, each definition's in the order typed
functions_typed_from(definitions: list, s: TypingState) as list := definitions.flat_map(definition => instances_of(function_key(definition), s).map(typed => typed.define))

# a Try typed: its body, and its handler in place, in the function around it, its parameter the caught Error, a Node;
# its value the two joined; where no type is wanted, a body that gives nothing beside a handler that gives a value is
# refused
try_typed(n: Node, written: Node, handler: Fn, s: TypingState, f: TypeFrame, expected: Term?) as Node := match handler { Fn(parameters, handling) => {
	entry = f.bound
	body = present_typed(written, [], s, f, expected)
	try_checked(n, entry, f)
	caught = items_of(parameters).map(parameter => parameter_typed(parameter, NODE_TERM, f))
	handled = present_typed(handling, [], s, f, expected)
	if expected == ø and value_type(body) == ø and not jumps(body) and value_bearing(value_type(handled)) != ø { refused(n, "the try gives nothing when it succeeds, only its catch gives a value: give it one, `try { g(3); \"ok\" } catch e { … }`") }
	parts = parts_fitted([body, handled], s, expected)
	joined_of(refitted(Try(parts#1, refitted(Fn(with_items(parameters, caught), parts#2), handler)), n), parts, s, expected)
} }
# The function left with a value, expected the function's written result type; the code after it never runs
return_typed(n: Node, value: Node, s: TypingState, f: TypeFrame) as Node := {
	typed = typed_form(value, s, f, f.result)
	# a value returned is of the written result, as the body's is: `return ø` a P? of a function giving P?
	given = if f.result == ø then typed else converted(typed, f.result, s, value, FUNCTION_GIVES)
	# a value that never finishes, `return refused(n, …)`, gives nothing back
	if not jumps(given) { f.returns += [value_type(given)] }
	jumping(refitted(Return(given), n))
}

# a typed subject's part, `x.f` by a text key, `xs#i` by an int place
part_got(n: Node, held: Node, key: Node, s: TypingState, f: TypeFrame, expected: Term?) as Node := if key is text then part_typed(n, held, key, s, f, expected) else get_typed(n, held, key, s, f)
# a property given a value, `canvas.width = 12`, where the subject's record has no field of that name: its setter
# width(canvas, 12) (decision setter-calls); ø for a field or anything else
setter_called(n: Node, held: Node, key: Node, value: Node, s: TypingState, f: TypeFrame) as Node? := {
	record = record_named(s.records, value_type(held)) ?? return ø
	if not key is text or field_named(record, key) != ø { return ø }
	word_called(n, text(key), [held, typed_form(value, s, f, ø)], ø, s)
}
# A value given to a name: its type the one the name holds, written or given before; the value expected it
set_typed(n: Node, place: Node, value: Node, s: TypingState, f: TypeFrame, expected: Term?) as Node := match place {
	Get(subject, key) => {
		forgotten(path_key(place) ?? "", f)
		held = typed_form(subject, s, f, ø)
		setter_called(n, held, key, value, s, f) ?? item_set_typed(n, part_got(place, held, key, s, f, ø), value, s, f)
	}
	Item(subject, key) => item_set_typed(n, typed_form(place, s, f, ø), value, s, f)
	_ => if is_bound(place, DefinitionKind.Field) then item_set_typed(n, typed_form(receiver_field(place), s, f, ø), value, s, f) else name_set_typed(n, place, value, s, f, expected)
}
# a receiver's field named bare in a method, `c`, as the Get `self.c` (core/analyze/scope.wap receiver_fields)
receiver_field(name: Node) as Node := {
	receiver = with_fact(with_binding(symbol(SELF_WORD), DefinitionKind.Parameter), DEFINED_AT, fact_of(name, DEFINED_AT) ?? refused(name, "a receiver's field is bound"))
	placed_like(Get(receiver, Text(text(name))), name)
}
name_set_typed(n: Node, place: Node, value: Node, s: TypingState, f: TypeFrame, expected: Term?) as Node := {
	name = declared_name(place)
	# a name written `any` holds the type of what it is given (a later other type retypes it)
	written = opened(substituted(written_type(declared_type(place)), f.letters), s)
	declared = if written != ø and shaped(written, s) == ANY_TERM then ø else written
	key = place_key(defined_at(name))
	if declared != ø or is_kind_word(fact_of(n, ASSIGNS), DefinitionKind.Local) { s.fixed.add(key) }
	wanted = if declared != ø then shaped(declared, s) else variable_type(name, s, f)
	given = empty_given(typed_form(value, s, f, wanted ?? result_chosen(value, expected, s)))
	# a global functions read before it is set from here on
	s.unset = s.unset.filter(unset => unset != key)
	type = value_of(given, "to set")
	# a name given only ø so far holds an optional of a type its uses settle; one written `any` holds any, which holds ø
	if type == EMPTY_TERM and wanted == ø { type = if written == ø then optional_type(unknown_type(s)) else ANY_TERM }
	# a value the name's type does not hold is read through its class's get, or given to it by that type's set,
	# `set(to: 5, of: x)`, else is a binding of its own (core/analyze/flow.wap), unless the name keeps its type
	fitted = if wanted == ø then given else try converted(given, wanted, s, n, NAME_HOLDS) catch e { try converted(got(given, s), wanted, s, n, NAME_HOLDS) catch unread { try return word_called(n, SET_WORD, [given, typed_form(name, s, f, ø)], ø, s) catch unset {
		if key in s.fixed { raise e.message }
		rebound(name, s, f)
		ø
	} } }
	if changes_capture(name, s) { refused(n, "a function value made before reads ${name}, which this changes") }
	# the name keeps the type it holds, `found: Node? = ø` a Node? whatever it is given
	held = if fitted == ø then type else wanted ?? type
	findings = if value_type(given) == BOOL_TERM then found(value, given, s, f) else []
	remembered(name, held, s, f)
	if findings is not empty { f.held = f.held + [HeldCondition(key, findings)] }
	with_type_of(refitted(Set(with_name_fact(bound_place(place, name, f), TYPE, type_fact(held)), fitted ?? given), n), held)
}

# a counted loop, its place an int in the body
for_typed(n: Node, place: Node, count: Node, body: Node, s: TypingState, f: TypeFrame) as Node := {
	remembered(place, INT_TERM, s, f)
	refitted(For(with_type(place, INT_TYPE), count, looped(body, s, f)), n)
}

# a variable's bare container kind as its open type, `a: map` a map<α1, α2> and `a: list` a list<α1>, as `{}` and `[]`
# are: their uses settle the unknowns (wiki/map.md)
opened(type: Term?, s: TypingState) as Term? := if type == LIST_TERM then list_type(unknown_type(s)) else if type == MAP_TERM then map_type(unknown_type(s), unknown_type(s)) else type
NAME_HOLDS = "the name holds"
# a list's item or a record's field given a value of its type; the Set itself gives none
item_set_typed(n: Node, place: Node, value: Node, s: TypingState, f: TypeFrame) as Node := {
	wanted = value_of(place, "as a place")
	given = converted(typed_form(value, s, f, wanted), wanted, s, n, "the place holds")
	# an item or an entry, read by a call of `#`, `xs[0]`, `m["a"]`, is given its value by its subject's set
	match place { Call(called, arguments) => if text(called) == PLACE_WORD then return word_called(n, SET_WORD, [given, arguments#1, arguments#2], ø, s); _ => ø }
	refitted(Set(place, given), n)
}

# A call's function known by its caller: a function calls the globals its callee reads late too; the program's call
# runs it now, so one of those globals not given its value yet is refused
# DEBT: A program-level call through a function value can read a global before its statement: `H = {"a": f};
#   H["a"](2); X = 1` reads X's default, since a value's possible functions' late reads are not known at the call.
#   Paid off by refusing such a call when its functions read late, or by a run-time check, when code meets it.
called_reads(chosen: TypedFunction, at: Node, s: TypingState, f: TypeFrame) := {
	if f.function != ø {
		f.late += chosen.late
		return
	}
	pending = chosen.late.filter(name => place_key(defined_at(name)) in s.unset)
	if pending { refused(at, "this call runs code that reads ${pending#1} before the statement that gives it its value: give ${pending#1} its value before this call runs") }
}
# the case a name names of the enum expected, `k: Kind = Box` beside a class Box; ø where no enum is expected or it
# has no case of that name
expected_case(n: Node, expected: Term?, s: TypingState) as Node? := {
	enum = base_or_self(expected) ?? return ø
	if case_named(enum, n, s) != ø then case_bound(n, enum, s) else ø
}
# a name's value: a parameter, local or global, of the type given to it
name_typed(n: Node, s: TypingState, f: TypeFrame, expected: Term?) as Node := {
	# a case name of two enums is the expected enum's, `True` where a Node is wanted Node.True (decision enum-case-unambiguous)
	if is_bound(n, DefinitionKind.Case) {
		case = expected_case(n, expected, s) ?? n
		return case_call_typed(case, case, [], s, f)
	}
	if is_bound(n, DefinitionKind.Field) { return typed_form(receiver_field(n), s, f, ø) }
	if names_type_value(n, expected, s) { return type_value(type_term(n), n) }
	if names_function(n) {
		case = expected_case(n, expected, s)
		if case != ø { return case_call_typed(case, case, [], s, f) }
		return if names_constant(n, expected, s) then call_typed(n, n, [], s, f, expected) else function_named_typed(n, expected, s)
	}
	type = variable_type(n, s, f) ?? read_before_given(n, s, f)
	if is_bound(n, DefinitionKind.Global) and f.function != ø {
		s.function_globals += [n]
		if place_key(defined_at(n)) in s.unset { f.late += [n] }
	}
	n = read_bound(n, f)
	if type == ø and is_bound(n, DefinitionKind.Capture) { refused(n, "a named function inside a function reads the variables around it with closures, not yet; a function value `x => …` can") }
	as_found(n, with_type_of(n, type ?? refused(n, "this name is read before any value is given to it")), s, f)
}
# a global a function reads before the statement that gives it its value is read when the function is called
# (wiki/Footguns.md: free variables are read at call time): of a type its statement settles
read_before_given(n: Node, s: TypingState, f: TypeFrame) as Term? := {
	if not is_bound(n, DefinitionKind.Global) or f.function == ø { return ø }
	type = type_keyed(place_key(defined_at(n)), s.declared) ?? unknown_type(s)
	remembered(n, type, s, f)
	s.unset += [place_key(defined_at(n))]
	type
}
# A path's read as a condition around finds it: an optional's value where it is known present, `x!`, a boxed value of
# the type it is known to hold (both, for an int?? known an int), a value of a type read as that one read so, `text(c)` of a char found a text; as it is
# where nothing finds it
as_found(n: Node, read: Node, s: TypingState, f: TypeFrame) as Node := {
	known = found_type(path_key(n) ?? return read, f.present) ?? return read
	held = base_of_optional(value_type(read))
	present = if held == ø then read else with_type_of(word_called(n, REQUIRED_WORD, [read], ø, s), held!)
	if value_type(present) == known { return present }
	readers = passing_types(known).filter(given => given != known and read_of(given) != ø)
	readers.fold(unboxed(present, known, n), (otherwise, given) => with_type_of(placed_like(If(boxed_tested(present, given, n), as_read(unboxed(present, given, n), known, s), otherwise), n), known))
}
unboxed(read: Node, type: Term, at: Node) as Node := with_type_of(placed_like(Prim(symbol(OPTIONAL_VALUE), [read]), at), type)
# A path a condition may find, its key: a variable's own, `x`, a field of a path, `m.pattern`, and an item of a path at
# a written place, `types#1`, and the place a condition gives its value, `(x = v) is int`; ø for any other form. A path
# is found until something gives it, or a path it is part of, a new value.
path_key(n: Node) as text? := match n {
	Symbol(name) => if is_variable(n) then place_key(defined_at(n)) else ø
	Get(subject, key) => "${path_key(subject) ?? return ø}${path_step(key) ?? return ø}"
	Set(place, value) => path_key(place)
	_ => ø
}
# the step from a path into one of its parts: `.field`, or `#place` for a written place
path_step(key: Node) as text? := match key {
	Number(value) => if value is int then "${ITEM_STEP}${text(key)}" else ø
	_ => if key is text then "${FIELD_STEP}${text(key)}" else ø
}
FIELD_STEP = "."
ITEM_STEP = "#"
# whether a path is this one or part of it, `x.inner` and `x#1` within `x`
within(key: text, path: text) as bool := key == path or [FIELD_STEP, ITEM_STEP].any(step => key.starts_with(path + step))
# what conditions found, without this path and the paths within it, which a new value changes
forgotten(key: text, f: TypeFrame) := {
	f.present = f.present.filter(known => not within(known.key, key))
	f.held = f.held.filter(held => not within(held.key, key) and not held.findings.any(known => within(known.key, key)))
}
# whether a function's name, where no function is wanted, is a call: it names a definition without parameters, `n := 5`
names_constant(n: Node, expected: Term?, s: TypingState) as bool := function_parts(expected) == ø and scoped_definitions(n, s).flat_map(scope => scope).any(definition => #definition.parameters == 0)
# the variables a name's binding keeps: the program's globals, or the frame's locals and parameters
variables_of(name: Node, s: TypingState, f: TypeFrame) as list<Binding> := if is_bound(name, DefinitionKind.Global) then s.globals else f.variables
remembered(name: Node, type: Term, s: TypingState, f: TypeFrame) := {
	first = place_key(defined_at(name))
	forgotten(first, f)
	definer = rebound_definer(name, f.bound)
	variables_added(name, Binding(if definer == ø then first else place_key(definer!), type), s, f)
}
variables_added(name: Node, variable: Binding, s: TypingState, f: TypeFrame) := if is_bound(name, DefinitionKind.Global) { s.globals += [variable] } else { f.variables += [variable] }
# a variable's type: its binding's on this path (core/analyze/flow.wap)
variable_type(name: Node, s: TypingState, f: TypeFrame) as Term? := settled_optional(type_keyed(place_key(definer_in(name, f.bound)), variables_of(name, s, f)), s)
# the type of this key among these bindings
type_keyed(key: text, bindings: list<Binding>) as Term? := {
	for binding in bindings { if binding.key == key { return binding.type } }
	ø
}
# the type a condition around finds a variable of, ø where none finds it
found_type(key: text, present: list<Finding>) as Term? := type_keyed(key, present.map(finding => Binding(finding.key, finding.type)))
defined_at(name: Node) as Node := fact_of(name, DEFINED_AT) ?? refused(name, "this name reached the typing stage unbound")
# whether a name is the one that defines its variable, its first value rather than a change
is_definer(name: Node) as bool := place_key(name) == place_key(defined_at(name))

# A case of an enum, `Dime`, or a case given its fields' values, `Circle(3)`: a value of the enum's type
case_call_typed(n: Node, called: Node, arguments: list<Node>, s: TypingState, f: TypeFrame) as Node := {
	fields = case_fields(case_declaring(s.records, called))
	values = arranged_in(fields, arguments) ?? refused(n, "${called} takes a value for each of its fields: ${field_names(fields)}")
	given = (1 to #values).map(at => field_checked(typed_form(values#at, s, f, written_type(declared_type(fields#at))), fields#at, values#at, s))
	case_typed_as(n, called, given, s)
}
case_typed_as(n: Node, called: Node, given: list, s: TypingState) as Node := {
	typed = if given is empty and n === called then n else refitted(Call(called, given), n)
	with_type_of(typed, record_term(enum_declaring(s.records, called)))
}
# a primitive's value is of the type its built-in's definition writes, or its place expects (`x: int = prim …`, a
# value of another module), none when neither says one
prim_typed(n: Node, operation: Node, arguments: list, s: TypingState, f: TypeFrame, expected: Term?) as Node := {
	# a primitive the typing stage wrote, a test or a checked cast, keeps its type
	with_type_of(refitted(Prim(operation, arguments.map(argument => typed_form(argument, s, f, ø))), n), value_type(n) ?? (if wants_value(expected) then expected else ø))
}
