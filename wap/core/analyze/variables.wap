# The variables of the binding analysis (core/analyze/scope.wap): which variable each assignment gives a value to, a
# new one of its block or one it already sees, in the order the code is written, and the late reads of the program's
# variables a function must declare.

use folder
use "../errors.wap"
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"

# The variables a Block names without a value (VARIABLES, core/rules/lowering.wap): `let x` a new one of the block,
# `global x` the program's x, which the block then reads and changes as its own
named_variables(block: Node, scope: Scope, depth: int) as list<Definition> := fact_items(block, VARIABLES).map(naming => named_variable(naming, scope, depth))
named_variable(naming: Node, scope: Scope, depth: int) as Definition := match naming {
	Key(name, Op.Colon, kind) => if is_kind_word(kind, DefinitionKind.Global) then Definition(text(name), DefinitionKind.Global, program_variable(name, scope).definer, depth) else Definition(text(name), local_kind(depth), name, depth)
	_ => refused(naming, "a variable is named name: kind")
}
program_variable(name: Node, scope: Scope) as Definition := named_in(scope, text(name)).find(definition => definition.depth <= PROGRAM_DEPTH and definition.kind == DefinitionKind.Global) ?? refused(name, "the program has no variable of this name")

# the definitions of the program and the library, the ones `global x = …` sees
program_scope(scope: Scope) as Scope := scope_of(every_definition(scope).filter(definition => definition.depth <= PROGRAM_DEPTH))

# The definitions a Block makes: each function it defines, and each name it gives a value to that this function does
# not see yet. Nested Blocks and functions keep theirs; a Set inside another form (an If's branch) is the Block's.
defined_in(statements: list, scope: Scope, depth: int) as list<Definition> := {
	made = []
	for statement in statements { made += definitions_made_by(statement, within(scope, made), depth) }
	made
}
definitions_made_by(n: Node, scope: Scope, depth: int) as list<Definition> := match n {
	Define(name, parameters, body) => [Definition(text(declared_name(name)), DefinitionKind.Function, type_definer(n, declared_name(name)), depth, types: universe_written(declared_type(name) ?? Empty) != ø)]
	Record(name, fields, variants) => [Definition(text(name), DefinitionKind.Record, n, depth)] + cases_of(n).map(case => Definition(text(case_name(case)), DefinitionKind.Case, case_name(case), depth, text(name), #case_fields(case)))
	Set(place, value) => assigned_variables(n, declared_name(place), scope, depth) + definitions_made_by(value, scope, depth)
	Block(statements) => []
	Fn(parameters, body) => []
	Call(called, arguments) => defined_in(arguments, scope, depth)
	Prim(operation, arguments) => defined_in(arguments, scope, depth)
	If(condition, then_part, else_part) => defined_in([condition, then_part, else_part], scope, depth)
	While(condition, body) => defined_in([condition, body], scope, depth)
	For(place, count, body) => defined_in([count, body], scope, depth)
	Case(subject, arms) => defined_in([subject] + arms.map(arm_result), scope, depth)
	Return(value) => defined_in([value], scope, depth)
	Get(subject, key) => defined_in([subject, key], scope, depth)
	List(items, Bracket.Square, separator) => defined_in(items, scope, depth)
	_ => []
}
# The variable an assignment makes: a new one for `let x = …` and for a name its function sees no variable of;
# none for `global x = …`, the program's, for a variable its function has, or for one its file declared `global x`. A name that is a variable of the
# program or of a function around, defined before it, reads two ways, so the assignment is refused naming both; one
# defined only later is no variable yet, so the assignment makes its own.
assigned_variables(set: Node, place: Node, scope: Scope, depth: int) as list<Definition> := {
	declared = declares_global(set)
	if not place is symbol or (declared and depth != PROGRAM_DEPTH) { return [] }
	name = text(place)
	if not is_kind_word(fact_of(set, ASSIGNS), DefinitionKind.Local) {
		if seen_in_function(name, scope, depth) { return [] }
		outer = outer_variable(name, scope, depth)
		# a variable the program declared `global x` is written by a plain `x = …` in any function of its file
		if outer != ø and has_fact(outer.definer, ASSIGNS) and file_of(outer.definer) == file_of(place) { return [] }
		if outer != ø and written_before(outer.definer, place) { refused(place, "this could change the ${outer.kind} ${name} (line ${line_of(outer.definer)}:${column_of(outer.definer)}) or make a new variable here: write `let ${name} = …` for a new one" + global_reading(outer, name)) }
	}
	[Definition(name, local_kind(depth), if declared then with_fact(place, ASSIGNS, fact_of(set, ASSIGNS)!) else place, depth)]
}
# whether an assignment says `global x = …`
declares_global(set: Node) as bool := is_kind_word(fact_of(set, ASSIGNS), DefinitionKind.Global)
# whether code was written before other code of its file, ø positions counting as before
written_before(earlier: Node, later: Node) as bool := {
	a = position_of(earlier) ?? return yes
	b = position_of(later) ?? return yes
	a.line < b.line or a.line == b.line and a.column < b.column
}
global_reading(outer: Definition, name: text) as text := if outer.kind == DefinitionKind.Global then ", `global ${name} = …` for the program's" else ""
# the variable of that name the program or a function around the one at depth defines, ø when the name is none
outer_variable(name: text, scope: Scope, depth: int) as Definition? := {
	named = named_in(scope, name)
	if named is empty { return ø }
	nearest = named#1
	if nearest.depth >= PROGRAM_DEPTH and nearest.depth < depth and nearest.kind != DefinitionKind.Function then nearest else ø
}
local_kind(depth: int) as DefinitionKind := if depth == PROGRAM_DEPTH then DefinitionKind.Global else DefinitionKind.Local
# whether a function made in a loop of the program's statements reads this program variable as a capture, as it is
# then (wiki/charged.md "Loop variables need no declaration"), as one made in a function takes that function's
loop_captured(innermost: Definition, scope: Scope, depth: int) as bool := scope.looped and innermost.depth == PROGRAM_DEPTH and innermost.kind == DefinitionKind.Global and depth > PROGRAM_DEPTH
# whether the function at depth has a variable of that name; the program also has those of the modules it uses
seen_in_function(name: text, scope: Scope, depth: int) as bool := named_in(scope, name).any(definition => definition.depth == depth or depth == PROGRAM_DEPTH and definition.depth == MODULE_DEPTH and definition.kind == DefinitionKind.Global)

# Late reads (wiki/Footguns.md "Closures capturing loop variables"): a function reads a program variable when it is
# called, so where the program changes the variable after the function's definition, the function declares it,
# `global x`, and the reader sees that it reads the variable as it is then. An undeclared read of such a variable is
# refused where it is written. The program's first value of a variable is its definition, no change.
late_reads_checked(program: Node) as Node := {
	changes = global_changes(program, no)
	match program {
		Block(statements) => {
			# a variable the program declared `global x` its functions read as it is when called
			declared = statements.flat_map(statement => match statement { Set(place, value) => if declares_global(statement) then [text(declared_name(place))] else []; _ => [] })
			for statement in statements {
				function = function_defined_by(statement)
				if function != ø { late_reads_of(function, line_of(statement) ?? refused(statement, "a definition has its line"), declared, changes) }
			}
		}
		_ => ø
	}
	program
}
# the function a top-level statement defines: `f(x) := …`, or `f = x => …`; a getter, `z := y*y`, reads the variables
# as they are at each use, which its definition says (wiki/charged.md "Getters are the exception")
function_defined_by(statement: Node) as Node? := match statement {
	Define(name, List(items, Bracket.None, separator), body) => if body is Block or body is Fn then statement else ø
	Define(name, parameters, body) => statement
	Set(place, value) => if value is Fn then value else ø
	_ => ø
}
# Each change of a program variable: where the program writes it, or anytime for a change inside a function, which
# runs whenever the function is called
class Change { name: text; line: int; anytime: bool }
global_changes(n: Node, in_function: bool) as list<Change> := match n {
	Set(place, value) => (if is_change(place) then [Change(text(place), line_of(place) ?? refused(place, "a change without a position"), in_function)] else []) + global_changes(value, in_function)
	Define(name, parameters, body) => global_changes(body, yes)
	Fn(parameters, body) => global_changes(body, yes)
	_ => direct_parts(n).flat_map(part => global_changes(part, in_function))
}
# whether a place given a value is a program variable given another value than its first
is_change(place: Node) as bool := is_bound(place, DefinitionKind.Global) and not same_place(place, defined_at(place))
same_place(a: Node, b: Node) as bool := line_of(a) == line_of(b) and column_of(a) == column_of(b)

# the reads in a function, defined at line, of program variables that change after it, refused unless declared
late_reads_of(n: Node, line: int, declared: list, changes: list) := match n {
	Symbol(name) => if is_bound(n, DefinitionKind.Global) and not declared.contains(name) and changes_after(name, line, changes) { refused(n, "the program changes ${name} after this function is defined: write `global ${name}` in the function, so it reads ${name} as it is when called") }
	Set(place, value) => late_reads_of(value, line, declared, changes)
	Block(statements) => for statement in statements { late_reads_of(statement, line, declared + globals_named(n), changes) }
	Key(left, op, right) => { late_reads_of(left, line, declared, changes); late_reads_of(right, line, declared, changes) }
	List(items, bracket, separator) => for item in items { late_reads_of(item, line, declared, changes) }
	_ => ø
}
changes_after(name: text, line: int, changes: list) as bool := {
	for change in changes { if change.name == name and (change.anytime or change.line > line) { return yes } }
	no
}
# the names a Block declares the program's, `global x` or `global x = …`
globals_named(block: Node) as list<text> := fact_items(block, VARIABLES).flat_map(naming => match naming {
	Key(name, Op.Colon, kind) => if is_kind_word(kind, DefinitionKind.Global) then [text(name)] else []
	_ => []
}) + direct_parts(block).flat_map(statement => match statement { Set(place, value) => if declares_global(statement) then [text(declared_name(place))] else []; _ => [] })
