# The facts the binding analysis (core/analyze/scope.wap) learns of the names a program writes, read by every later
# stage: what a name refers to, what an assignment assigns, the variables a block declares, a name's overloads, a
# function's captures. Input and output: facts on Nodes. And the one record of each top-level declaration (Signature),
# which declare builds and typing holds; a function's export name, read from its definition.

use folder
use "../kernel/forms.wap"

# READ_WITH on a name a declaration rule read (stage 2, core/rules/matcher.wap): the name of the declaration it was read
# as, the definition the name must bind to
READ_WITH = "read with"
# TYPED_HOLE on the code a typed rule's hole took (stage 3, core/rules/typed.wap): bound already, so binding keeps it as
# it is, and typed already unless an If's arm, which its rule takes before the arms are typed
TYPED_HOLE = "typed hole"
# PARTED on the two items a blank parts, a word and a map, `style {a: 1}`: the phrase as written, which a typed rule may
# take as the call of the word (core/rules/typed.wap parted_rewritten)
PARTED = "parted"
# PHRASED on a call a phrase wrote, `x -1`: a list of its items where the word holds a value that is no function
# (core/analyze/function_values.wap value_call_typed, wiki/list.md)
PHRASED = "phrased"
# UNBOUND on a library function not bound yet: binding waits until typing reaches it (core/analyze/scope.wap
# library_bound)
UNBOUND = "unbound"

# BINDING on a bound name: what it refers to, the word of its DefinitionKind as a Symbol (DEFINED_AT, the name that
# defined it, is in core/stage.wap, which records read too)
BINDING = "binding"
# What a definition is, and so what a name bound to it refers to: a block's or the program's variable, a parameter, a
# variable of the function around (captured), a function of the program or of the library (the types module's or a used
# module's), a case of an enum (`Dime`, its Record defines it), a field of a method's receiver named bare (`c` for
# `self.c` inside `inc(self: Counter)`, DEFINED_AT the self parameter), a type's record (a class or an enum), a used
# module, a word of a standard module the code does not use (its DEFINED_AT the module's file: naming it brings the
# module in, wiki/use.md "Library folders"). On a name its BINDING fact is the kind's word, `local`, `global` …
enum DefinitionKind { Local, Parameter, Capture, Global, Function, Library, Case, Field, Record, Module, Standard }
kind_word(kind: DefinitionKind) as text := lower(text(kind))
is_kind_word(word: Node?, kind: DefinitionKind) as bool := word == symbol(kind_word(kind))
with_binding(n: Node, kind: DefinitionKind) as Node := with_fact(n, BINDING, symbol(kind_word(kind)))
is_bound(n: Node, kind: DefinitionKind) as bool := is_kind_word(fact_of(n, BINDING), kind)
# whether a name names a function, the program's or the library's
names_function(n: Node) as bool := is_bound(n, DefinitionKind.Function) or is_bound(n, DefinitionKind.Library)
# on an assignment, the variable it ASSIGNS when the program said so: a local, a new one in its block (`let x = 1`),
# a global, the program's (`global x = 1`); without it, the variable the function sees, or a new one
ASSIGNS = "assigns"
# EXPORTED_AS on a dispatcher's name: the plain word a module exports it under, `add` (core/analyze/dispatch.wap)
EXPORTED_AS = "exported_as"
# on a Block, the VARIABLES its statements name without a value, each `name: binding word`: `global x` says x is the
# program's in the whole block, `let x` a new one of the block's
VARIABLES = "variables"
# on a called name whose nearest definition is a value, the functions of that name further out
FUNCTIONS_BEYOND = "functions_beyond"
# a name of several overloads gets CANDIDATES, their defining names in a list per scope, innermost first, instead of
# DEFINED_AT; the typing stage picks one and sets DEFINED_AT
CANDIDATES = "candidates"
# a function's CAPTURES: the defining names of what it reads from the functions around it (a closure's fields)
CAPTURES = "captures"
# a function value read as a function type, `inc` in a list<(int) -> int>, keeps its own type, its function's word applied to its capture types,
# as its FUNCTION_VALUE, and names the function typed for that type with ADAPTED
FUNCTION_VALUE = "function_value"
ADAPTED = "adapted"
captures_of(function: Node) as list<Node> := fact_items(function, CAPTURES)

# the arrow an export's name writes its result after, where a program writes `as`
EXPORT_ARROW = "→"
# the word a declaration writes before its result, `f(x: int) as int` (wiki/function.md)
RESULT_WORD = "as"

# What a program's top level declares, as every stage after declare knows it, its one record: its name, the key of its
# place, its kind (a function, a value or a record), the name that defines it, its parameters' types, its written
# result, its module's file, and whether typing has shaped its types. It holds no body: a stage finds the definition as
# it is now by the key (core/analyze/types.wap define_of). record: a record's own Record node, held only because its
# readers take its fields and cases from it today, never a second copy of its code
class Signature { name: text; key: text; kind: DefinitionKind; definer: Node; parameters: list<Term?> = []; result: Term? = ø; module: text = ""; record: Node? = ø; shaped: bool = no }
# the record of a function named, with its parameters' types and its written result
signature_from(name: Node, parameters: list<Node>, result: Node?) as Signature := Signature(text(name), place_key(name), DefinitionKind.Function, name, parameters.map(type_given), written_type(result), file_of(name) ?? "")
# the name a definition declares, `f` of `f(x) := …`
defined_name(form: Define) as Node := match form { Define(name, parameters, body) => declared_name(name) }
function_key(form: Define) as text := place_key(defined_name(form))
statements_in(block: Block) as list := match block { Block(statements) => statements }
# a list pattern's items but its rest
fixed_items(items: list) as list := items.filter(item => rest_named(item) == ø)
# A function's header line as its export is named (wiki/wasm-representation.md "Export names"):
# `add(a: int, b: int = 1) → int`, each parameter by name, type and default, the result after the arrow unless none
signature_text(name: Node, parameters: list<Node>, result: Term?, arrow: text) as text := "${name}(${parameters.map(parameter_text).join(", ")})${if result == ø then "" else " ${arrow} ${type_text(result)}"}"
parameter_text(parameter: Node) as text := {
	type = type_given(parameter)
	default = fact_of(parameter, DEFAULT)
	text(declared_name(parameter)) + (if type == ø then "" else ": " + type_text(type)) + (if default == ø then "" else " = " + code(default!))
}
# a parameter's type, given by an earlier typing, else written: a generic function's instance takes its own types, and
# typing a typed program again changes nothing
type_given(parameter: Node) as Term? := fact_type(fact_of(declared_name(parameter), TYPE)) ?? written_type(declared_type(parameter))
