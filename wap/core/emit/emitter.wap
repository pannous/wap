# Kernel forms to a wasm module (wap/kernel/forms.wap): one case per form, any other node refused.
#
# read wasm-representation.md (todo: even copy it here?) :
# names, exports, imports, class shapes and source positions come by convention from wasm’s standard sections. 
# Everything wasm erases (real types, defaults, overloads, enums, rules, generic bodies, version stamp) goes into the wap section as warp declaration data

# Input: the kernel (wap/kernel/forms.wap and the literals); output: a WasmModule (core/emit/wasm.wap). The emitter
# never sees a surface spelling, and it decides nothing a rule could decide: it translates. Which wasm type holds a
# value is core/emit/values.wap's; the bytes are wasm.wap's.
#
# Names arrive bound (core/analyze/scope.wap): each carries what it refers to and the name that defined it, so the
# emitter never looks a name up by its spelling; a call's name refers to the one typed function it means
# (core/analyze/types.wap). A function is placed by the signature typing gave it, at the start of its block, and its
# body emitted where its definition stands; a global a body reads before its statement sets it takes its type from
# typing too.
#
# The emitter knows no library word: the types module's functions the program calls (wap/types/prelude.wap) come before
# the program's statements, emitted like its own functions, and a built-in's body is a Prim
# (core/emit/primitives.wap). Functions and calls are core/emit/functions.wap's, matching patterns.wap's, and where
# values live places.wap's.

# DEBT: The emitter learns a value's type by emitting it, though the typing stage gives each one: an `if` still joins
#   its arms' types and a primitive takes its operands' emitted layouts (bends "meaning is typed"). Paid off when the
#   emitter reads each form's `type` fact.

use folder
use "../../kernel/opcodes.wap"
use "../errors.wap"
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"
use "../../kernel/primitives.wap"

# the layout of never (core/type_notation.wap NEVER_TYPE), a byte no wasm value type has, so a layout list holds it
# as it holds the others
NEVER_LAYOUT = 0x00
NEVER = [NEVER_LAYOUT]
# the labels wasm's structured instructions open, so a jump can count how far out its target is
# the labels code is emitted inside: a loop's exit and next run, a try's catch (a call inside it returns to it), others
enum Label { Exit, Next, Caught, Other }
# the bindings whose variables live in the function's frame
FRAME_BINDINGS = [DefinitionKind.Local, DefinitionKind.Parameter, DefinitionKind.Capture]

# The module of a program: its statements but the value shown become `warp/start`, which a host runs once for a
# module a program uses, and `main`, which the host runs for the program, runs it, then shows the value: the script
# rule made the program print it, `prim shown(print(show(it)))` (sugar/calls.wap), so main gives nothing back. The
# functions the program's file defines at the top level are exported (core/emit/functions.wap).
# DEBT: A program's value is shown only when it is an int (bends "refuse, never guess" mildly: any other value is
#   dropped). An int is the one value the host shows as warp does (main's i64 result); a float would show the host's
#   digits (0.1 as 0.10000000000000001), a char or yes/no as a number. Paid off when values show through the runtime's
#   show words, boxed into a $Node.
# (tag_shared: the module defines and exports its raise tag though it may raise nothing, as the library does, whose
# users share it, library.wap raise_module)
emitted(program: Block, file: text, exports: list<text> = [], memory: MemoryLayout? = ø, tag_module: text = "", tag_shared: bool = no) as WasmModule := {
	m = WasmModule()
	m.memory = memory
	m.tag_module = tag_module
	p = Emission(m, file)
	statements = statements_in(program)
	for name in host_calls(program) { p.host[name] = imported(m, WASI, name, PRIMITIVES[name].takes, PRIMITIVES[name].gives) }
	p.records = added_records(Records(), statements)
	foreign = foreign_calls(program)
	for call in foreign { foreign_imported(call, foreign, p) }
	foreign_values_imported(statements, p)
	# a call into a compiled module may raise by the library's tag, so that tag is the program's and main catches a
	# raise left uncaught
	if tag_shared or tag_module and m.imported_functions.any(function => function.module.ends_with(MODULE_ENDING)) { raised_tag(p) }
	shown = statements.drop(#statements - 1).filter(statement => match statement { Prim(operation, given) => text(operation) == SHOWN_VALUE; _ => no })
	run = Frame()
	init = function_of(m, [], Code([], dropped(code(Block(statements.take(#statements - #shown)), p, run))), run)
	exported(m, INIT_EXPORT, FUNCTION_KIND, init)
	f = Frame()
	body = instruction(CALL, [init]) + dropped(code(Block(shown), p, f))
	exported(m, MAIN_EXPORT, FUNCTION_KIND, function_of(m, [], Code([], if #m.tags + #m.tag_imports == 0 then body else uncaught_ended(body, p)), f))
	functions_exported(statements, exports, p)
	values_exported(program, exports, p)
	exported(m, MEMORY_EXPORT, MEMORY_KIND, 0)
	exported(m, TABLE_EXPORT, TABLE_KIND, 0)
	slots_taken(m)
	if m.tags { exported(m, RAISED_EXPORT, TAG_KIND, RAISED_TAG) }
	m
}

# the host functions the primitives of a program call, each once, in the order met
host_calls(program: Node) as list<text> := (RAISING_CALLS + primitives_in(program).filter(operation => PRIMITIVES.has(operation) and is_imported(PRIMITIVES[operation]))).unique
primitives_in(n: Node) as list<text> := match n {
	Prim(operation, arguments) => [text(operation)] + arguments.flat_map(primitives_in)
	_ => direct_parts(n).flat_map(primitives_in)
}

# What the emitter knows of the whole program: the module, the host functions it imported, and the functions and
# globals emitted so far, each a Placed
class Emission {
	m: WasmModule
	# the program's own file, whose functions are emitted, so never kept in place
	source: text = ""
	# the host functions imported: name → index
	host: map<text, int> = {}
	functions: map<text, Placed> = {}
	globals: map<text, Placed> = {}
	# the values of other modules, each imported once code reads or sets it (host.wap foreign_placed)
	foreign_values: list<Node> = []
	# the functions whose calls compile to their primitive in place, by their function key
	in_place: map<text, Node> = {}
	# the helper functions primitives call: operation → index
	helpers: map<text, int> = {}
	# the globals built once of constant instructions, by those instructions
	constants: map<text, int> = {}
	# the Records the program declares, which lay out their instances
	records: Records = Records()
}
# the layout of a type the program lays out, refused where it has none
known_layout(type: Term, p: Emission, at: Node? = ø) as list<int> := known_layout(type, p.m, p.records, at)
# a constant value read from the global it starts, one global for equal instructions
constant_global(value: Code, p: Emission) as Code := {
	key = "${value.instructions}"
	if not p.constants.has(key) { p.constants[key] = added_global(p.m, value.type, IMMUTABLE, value.instructions) }
	Code(value.type, instruction(GLOBAL_GET, [p.constants[key]]))
}
# The function being emitted: its parameters, then its locals, each a Placed numbered as wasm numbers them
class Frame {
	slots: list<Placed> = []
	parameter_count: int = 0
	# a function's frame takes returns, the program's does not; the types of the values returned so far
	function: bool = no
	returns: list<list<int>> = []
	# the layout of the function's result as its signature says, which a returned value is made to fit
	signed: list<int> = []
	# the labels open around the code being emitted, the innermost last
	labels: list<Label> = []
	# the next form emitted is in the function's last place: its value is the function's, so a call there reuses
	# the caller's frame (wasm return_call) and a function calling itself last runs in constant stack
	last_place: bool = no
}
# A definition where wasm keeps it: its index, the type of its value (a function's result) and, for a function,
# its parameters' types. Its key is where it was defined: file, line and column.
class Placed {
	key: text
	index: int
	type: list<int>
	parameters: list<list<int>> = []
	# a variable of the frame (wasm's locals) rather than of the module
	local: bool = no
}

# the code of a kernel form
code(form: Node, p: Emission, f: Frame) as Code := {
	last = f.last_place
	f.last_place = no
	match form {
		Block(statements) => block_code(statements, p, f, last)
		Define(name, parameters, body) => if p.in_place.has(function_key(form)) then Code() else { function_bodied(form, p); Code() }
		Set(place, value) => if is_foreign_value(form) then Code() else assigned_code(form, place, value, p, f)
		Call(called, arguments) => call_code(form, called, arguments, p, f, last)
		Try(body, handler) => try_code(form, body, handler, p, f)
		If(condition, then_part, else_part) => if_code(form, code(condition, p, f), arm_code(form, then_part, p, f, last), arm_code(form, else_part, p, f, last), p)
		While(condition, body) => while_code(form, condition, body, p, f)
		For(place, count, body) => for_code(form, place, count, body, p, f)
		Case(subject, arms) => case_code(form, code(subject, p, f), arms, p, f)
		Return(value) => return_code(form, value, p, f)
		Break() => Code(NEVER, instruction(BRANCH, [jump(form, f, Exit)]))
		Continue() => Code(NEVER, instruction(BRANCH, [jump(form, f, Next)]))
		List(entries, Bracket.Curly, separator) => map_code(form, entries, p, f)
		List(items, Bracket.Square, separator) => {
			item = list_item(type_of(form))
			Code(layout(form, p), list_made(item, items_fitted(item, items, p, f), p))
		}
		Get(subject, key) => read_code(layout(form, p), place_of(subject, key, p, f))
		Record(name, fields, variants) => Code([], [])
		Key(head, Op.None, List(items, Bracket.Curly, separator)) => instance_code(form, record_named(p.records, type_term(head)) ?? refused(head, "an instance of a type the program declares no record for"), items, p, f)
		Prim(operation, arguments) => if text(operation) == FOREIGN then foreign_code(form, p, f) else if text(operation) == DATA_ADDRESS_PRIM then data_code(form, p) else primitive_code(form, operation, arguments.map(argument => code(argument, p, f)), p)
		Fn(parameters, body) => function_value_code(form, p, f)
		Symbol(name) => name_code(form, p, f)
		_ => literal(form, p.m) ?? refused(form, "not a kernel form")
	}
}

# Statements run in order, the value the last one's, every other value dropped. The functions the block defines are
# placed at its start, so a call before a definition's line finds it; a definition emits its body and leaves no value.
block_code(statements: list<Node>, p: Emission, f: Frame, last: bool = no) as Code := {
	for definition in statements.filter(s => s is Define) { if is_in_place(definition) and file_of(defined_name(definition)) != p.source then p.in_place[function_key(definition)] = definition else function_placed(definition, p) }
	codes = (1 to #statements).map(at => code_at(at == #statements and last, statements#at, p, f))
	if codes is empty { return Code() }
	Code(codes.last.type, codes[.. #codes - 1].flat_map(dropped) + codes.last.instructions)
}

# A choice by a condition, yes or no (an i32), of the type typing gives it: with none, each part's value is dropped, as
# a missing else part's ø is.
if_code(form: Node, condition: Code, then_part: Code, else_part: Code, p: Emission) as Code := {
	checked_condition(form, condition)
	type = typed_layout(form, p)
	Code(type, condition.instructions + IF + block_type(type) + kept(then_part, type) + ELSE + kept(else_part, type) + END)
}
# The body's value, or the handler's when a raise in the body is thrown (kernel-try): the handler's body runs in
# place, no closure made, its parameter a local of the frame holding the raise as a Node, Error(Text(text))
#   block (done)  block (caught: text)  try_table (raise → caught)  body  end  br done  end  call error_node
#   local.set error  handler  end
try_code(form: Node, body: Node, handler: Node, p: Emission, f: Frame) as Code := match handler {
	Fn(parameters, handling) => {
		tried = choice_fitted(form, labelled(f, [Other, Other, Caught], () => code(body, p, f)), body, p)
		error = slotted(f, place_key(declared_name(items_of(parameters)#1)), known_layout(NODE_TERM, p))
		instead = arm_code(form, handling, p, f)
		type = typed_layout(form, p)
		caught = BLOCK + text_layout(p.m) + try_table(block_type(type), raised_tag(p), 0, kept(tried, type)) + instruction(BRANCH, [1]) + END
		Code(type, BLOCK + block_type(type) + caught + helper_call(p, "error_node", error_node_function) + local_set(error.index) + kept(instead, type) + END)
	}
	_ => refused(handler, "a Try's handler is a function written in place, `error => …`")
}
# the program's code, a raise no Try caught written and the program ended
uncaught_ended(body: list<int>, p: Emission) as list<int> := BLOCK + text_layout(p.m) + try_table(VOID_BLOCK, raised_tag(p), 0, body) + RETURN + END + uncaught(p)
# a structured instruction's type: the value it leaves, or none
block_type(type: list<int>) as list<int> := if valued(type) then type else VOID_BLOCK
# a part's code where its choice has the type: its value kept, or dropped when the choice has none
kept(part: Code, type: list<int>) as list<int> := if valued(type) then part.instructions else dropped(part)
arm_code(choice: Node, part: Node, p: Emission, f: Frame, last: bool = no) as Code := choice_fitted(choice, labelled(f, [Other], () => code_at(last, part, p, f)), part, p)
# the code of a form, in the function's last place or not
code_at(last: bool, form: Node, p: Emission, f: Frame) as Code := {
	f.last_place = last
	code(form, p, f)
}
# a part's value made to fit its choice's type, an If's or a Case's
choice_fitted(choice: Node, given: Code, part: Node, p: Emission) as Code := {
	wanted = typed_layout(choice, p)
	if valued(wanted) then fitted(given, wanted, part, p) else given
}
valued(type: list<int>) as bool := not type is empty and type != NEVER
checked_condition(form: Node, condition: Code) := if condition.type != I32 { refused(form, "a condition is yes or no") }

# A loop: its condition tested before each run of its body, the loop left when it is no. It has no value.
#   block (exit)  loop (next)  condition, not, br_if exit; body; br next  end  end
while_code(form: Node, condition: Node, body: Node, p: Emission, f: Frame) as Code := {
	inner = labelled(f, [Exit, Next], () => {
		test = code(condition, p, f)
		checked_condition(form, test)
		Code([], test.instructions + I32_EQZ + instruction(BRANCH_IF, [jump(form, f, Exit)]) + dropped(code(body, p, f)) + instruction(BRANCH, [jump(form, f, Next)]))
	})
	Code([], looped(inner.instructions))
}

# A counted loop: the count held in the frame, the place counted up before the body, so `continue` moves on; it has no
# value
for_code(form: Node, place: Node, count: Node, body: Node, p: Emission, f: Frame) as Code := {
	last = slotted(f, "${place_of_code(form)} count", I64)
	at = variable_of(place, p, f) ?? added_variable(place, I64, p, f)
	inner = labelled(f, [Exit, Next], () => Code([], fetched(at) + local_get(last.index) + I64_GE_S + instruction(BRANCH_IF, [jump(form, f, Exit)]) + fetched(at) + i64_const(1) + I64_ADD + kept(at) + DROP + dropped(code(body, p, f)) + instruction(BRANCH, [jump(form, f, Next)])))
	Code([], code(count, p, f).instructions + local_set(last.index) + i64_const(0) + kept(at) + DROP + looped(inner.instructions))
}

# The function left with a value, or with none for a bare return of a function that gives nothing (`return ø` of a
# function giving P? gives its ø); the code after it never runs
return_code(form: Node, value: Node, p: Emission, f: Frame) as Code := {
	if not f.function { refused(form, "a return leaves a function; the program has none to leave") }
	given = if value is Empty and not valued(f.signed) then Code() else signed_fit(code_at(not f.labels.has(Caught), value, p, f), value, f, p)
	# a value that never finishes, `return refused(n, …)`, gives nothing back
	if given.type != NEVER { f.returns += [given.type] }
	Code(NEVER, given.instructions + RETURN)
}

# the code of items made to fit the type a list or a map holds
# DEBT: a second answer to "does it fit", on wasm layouts, beside typing's conversion (core/analyze/fits.wap). Paid off
#   when typing writes every conversion into the kernel and the emitter only emits the one it is handed: this goes.
# DONE: the boxing, typing's `prim box` (wap-box-kernel).
# A value given where a type is wanted, made to fit it: any reference taken as itself where `any` is wanted, an `any`
# cast to the wanted reference type (checked_cast); a reference where another is wanted as it is, for wasm to check as
# its subtype; any other value refused, never written as invalid wasm. A plain value arrives boxed already, by typing's
# `prim box`. `form` is the value's code, the place a failed cast names.
fitted(given: Code, wanted: list<int>, form: Node, p: Emission) as Code := {
	if given.type == wanted { return given }
	if wanted == ANYREF and is_reference(given.type) { return Code(wanted, given.instructions) }
	if given.type == ANYREF and is_reference(wanted) { return Code(wanted, given.instructions + cast_called(wanted, "one", form, p)) }
	if supertype_passes(given.type, wanted, p.m) { return Code(wanted, given.instructions) }
	if given.type == NEVER or is_reference(given.type) and is_reference(wanted) { return given }
	refused(form, "this value's type does not fit where it is given")
}
# The helper casting an `any` to a type: the value when it holds one of that type, a plain value taken out of its box,
# a reference type taking ø too; else a raise naming the type and the place that wanted it. `form` is the code
# wanting it, whose type names a plain value's box; `name` the type's name. Its locals: 0 the value, 1 the place.
ANY_OF_ANOTHER_TYPE = "this any holds a value of another type than the"
checked_cast(p: Emission, wanted: list<int>, name: text, form: Node) as int := {
	plain = wanted in PLAIN_VALUES
	box = if plain then box_index(p.m, plain_word(form)) else 0
	test = if plain then heap_instruction(REF_TEST, box) else REF_TEST_NULL + heap_of(wanted)
	taken = if plain then heap_instruction(REF_CAST, box) + instruction(STRUCT_GET, [box, 0]) else REF_CAST_NULL + heap_of(wanted)
	fits = local_get(0) + test + if_block(local_get(0) + taken + RETURN)
	added_function(p.m, [ANYREF, text_layout(p.m)], [wanted], [], fits + raised_with("${ANY_OF_ANOTHER_TYPE} ${name} wanted at ", local_get(1), p))
}
# a casting helper's call given the place, one helper for each type, the type's name for the raise
cast_called(wanted: list<int>, name: text, form: Node, p: Emission) as list<int> := text_literal(place_of_code(form), p.m).instructions + helper_call(p, "cast to ${wanted} ${name}", q => checked_cast(q, wanted, name, form))
# where code was written, file:line:column
place_of_code(form: Node) as text := "${file_of(form)}:${line_of(form)}:${column_of(form)}"
items_fitted(type: Term, items: list<Node>, p: Emission, f: Frame) as list<Code> := items.map(item => fitted(code(item, p, f), layout_of(type, p.m, p.records) ?? refused(item, "the emitter has no value layout for this type yet"), item, p))
# a function's value made to fit its signed result, a frame without one leaving it as it is
signed_fit(given: Code, form: Node, f: Frame, p: Emission) as Code := if valued(f.signed) then fitted(given, f.signed, form, p) else given
# code emitted inside wasm's structured instructions, which open these labels
labelled(f: Frame, labels: list<Label>, emit: function) as Code := {
	f.labels += labels
	emitted_code = emit()
	f.labels = f.labels[.. #f.labels - #labels]
	emitted_code
}
# how many labels out the innermost label of that kind is, as br counts
jump(form: Node, f: Frame, label: Label) as int := {
	out = f.labels.reverse.index_of(label)
	if out == 0 { refused(form, "this jumps out of a loop, and no loop is around it") }
	out - 1
}

# the instructions of code whose value nobody takes
# (ø, the value of an If's missing else, dropped is no code: a module that never uses ø holds no reference type)
dropped(c: Code) as list<int> := if c.instructions == null_of(ANY_HEAP) then [] else c.instructions + (if valued(c.type) then DROP else [])

# code that never finishes ends unreachable, so wasm types what follows as any
finished(c: Code) as Code := if c.type == NEVER then Code(NEVER, c.instructions + UNREACHABLE) else c
