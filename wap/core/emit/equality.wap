# Equality: whether two values of one type are equal, as `==` and a map's search for a key ask. Plain values, texts
# and the values of `any` by their own comparison; cases, records, lists and optionals by their parts, in helpers that
# may reach themselves through a part of their own type, a Node holding Nodes, so each takes its place in the module
# before its code is written.

use folder
use "../../kernel/opcodes.wap"
use "../../kernel/primitives.wap"
use "../errors.wap"
use "../stage.wap"
use "../type_notation.wap"

# the instructions that compare two values of a type on the stack, giving yes or no
type_equality(type: Term, p: Emission) as list<int> := {
	by_parts = (key, compared) => parts_compared(p, key, known_layout(type, p), compared)
	if base_of_optional(type) != ø { return by_parts("optional_equal ${type_text(type, yes)}", optionals_compared(type, p)) }
	if item_type(type) != ø { return parts_compared(p, "list_equal ${type_text(type, yes)}", list_layout(type, p), lists_compared(type, p)) }
	record = record_named(p.records, type)
	if type_text(type) == ENUM_TYPE or record != ø and cases_of(record) is not empty { return if plain_enums(p.m) then equality(I32, p) else parts_compared(p, "tag_equal", nullable(enum_base(p.m)), cases_compared(p)) }
	if record != ø { return by_parts("record_equal ${place_key(record_declared(record!))}", records_compared(record, p)) }
	equality(known_layout(type, p), p)
}
# the instructions that compare two values of a wasm type: an int, float, yes/no or character, a text, an `any`; any
# other reference, a function value, only to itself
equality(type: list<int>, p: Emission) as list<int> := {
	if type == I64 { return I64_EQ }
	if type == F64 { return F64_EQ }
	if type == F32 { return F32_EQ }
	if type == I32 { return I32_EQ }
	if type == text_layout(p.m) { return runtime_call(p, TEXT_EQUALITY) }
	if type == ANYREF { return helper_call(p, "any_equal", any_equality_function) }
	if is_reference(type) { return REF_EQ }
	refused(Text("${type}"), "wap compares ints, floats, yes/no, characters and texts so far")
}
# A call of the helper comparing two values of one layout by their parts, its locals after the two values; the helper
# takes its place before its code is written, so its code may call it again
class Compared { locals: list<list<int>>; code: list<int> }
parts_compared(p: Emission, key: text, layout: list<int>, compared: function) as list<int> := {
	if p.helpers.has(key) { return instruction(CALL, [p.helpers[key]]) }
	index = reserved_function(p.m, [layout, layout], [I32])
	p.helpers[key] = index
	made = compared()
	bodied(p.m, index, made.locals, made.code + i32_const(1))
	instruction(CALL, [index])
}
# what a read of locals 0 and 1 gives, compared: no unless equal
pair_compared(read: function, compare: list<int>) as list<int> := read(0) + read(1) + compare + NO_UNLESS_YES

# Two cases: one tag and, for a case with fields, equal fields. Tags count the cases of every enum, so one helper
# serves them all. Its locals: 0 and 1 the cases.
cases_compared(p: Emission) as function := () => Compared([], pair_compared(local => tag_in(local, p), I32_EQ) + p.records.items.flat_map(record => cases_of(record).filter(case => case_fields(case) is not empty).flat_map(case => fields_compared(record, case, p))))
tag_in(local: int, p: Emission) as list<int> := local_get(local) + tagged(p.m)
# When both cases are this one, each of its fields of the two compared by the field's equality
fields_compared(record: Record, case: Node, p: Emission) as list<int> := {
	cast = case_struct_of(record, case, p.m, p.records)
	field = (local, at) => local_get(local) + case_field_read(cast, record, at)
	fields = case_fields(case)
	compared = (1 to #fields).flat_map(at => pair_compared(local => field(local, at), type_equality(field_declared(fields#at, record), p)))
	tag_in(0, p) + i32_const(declared_tag(case, p)) + I32_EQ + if_block(compared)
}
# Two instances of a class: each field equal. Its locals: 0 and 1 the instances.
records_compared(record: Record, p: Emission) as function := () => {
	at = [struct_of(record, p.m, p.records)]
	# field 0 the class's tag: two classes of one shape share a struct type
	Compared([], (0 to #fields_of(record)).flat_map(field => pair_compared(local => local_get(local) + instruction(STRUCT_GET, at + [field]), if field == 0 then I32_EQ else type_equality(field_declared(fields_of(record)#field, record), p))))
}
# Two lists: one count and equal items in order. Its locals: 0 and 1 the lists, 2 a count.
lists_compared(type: Term, p: Emission) as function := () => {
	item = local => item_read(type, local, local_get(2), p)
	Compared([I32], pair_compared(local => count_in(type, local, p), I32_EQ) + counted(2, count_in(type, 0, p), pair_compared(item, type_equality(list_item(type), p))))
}
# Two optionals: both ø, or both there and their values equal. Its locals: 0 and 1 the optionals.
optionals_compared(type: Term, p: Emission) as function := () => {
	base = base_of_optional(type) ?? refused_type(type, "this is no optional type")
	boxed = type_text(base) in BOXED_WORDS
	held = local => local_get(local) + (if boxed then box_opened(type_text(base), p) else [])
	Compared([], missing_compared(p.m) + pair_compared(held, type_equality(base, p)))
}

# when either of locals 0 and 1 is ø: yes when both are, else no
missing_compared(m: WasmModule) as list<int> := local_get(0) + missing_tested(m) + if_block(local_get(1) + missing_tested(m) + RETURN) + local_get(1) + missing_tested(m) + if_block(i32_const(0) + RETURN)

# The helper of equality of two values of `any` or `number`: two ø are equal; two plain values of one type in their
# boxes and two texts by their values; any other two references only when they are the same one. Its locals: 0 and 1
# the values.
any_equality_function(p: Emission) as int := {
	boxed = BOXED_WORDS.flat_map(word => compared_as(box_index(p.m, word), instruction(STRUCT_GET, [box_index(p.m, word), 0]), equality(WORD_LAYOUTS[word], p)))
	texts = compared_as(text_type(p.m), [], equality(text_layout(p.m), p))
	instances = p.records.items.filter(record => cases_of(record) is empty and subtype_base(record_term(record), p.records) == ø).flat_map(record => compared_as(struct_of(record, p.m, p.records), [], type_equality(record_term(record), p)))
	same = local_get(0) + REF_CAST + EQ_HEAP + local_get(1) + REF_CAST + EQ_HEAP + REF_EQ
	added_function(p.m, [ANYREF, ANYREF], [I32], [], missing_compared(p.m) + boxed + texts + instances + same)
}
# when the value in local 0 is of a type: no unless local 1 is too, else both taken out and compared
compared_as(type: int, taken: list<int>, compare: list<int>) as list<int> := {
	both = local_get(0) + heap_instruction(REF_CAST, type) + taken + local_get(1) + heap_instruction(REF_CAST, type) + taken
	local_get(0) + heap_instruction(REF_TEST, type) + if_block(local_get(1) + heap_instruction(REF_TEST, type) + NO_UNLESS_YES + both + compare + RETURN)
}
