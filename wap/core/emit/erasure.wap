# Erasure (wiki/proof.md): a proof has no run-time form. Code whose value is a proof, its type a law's statement or a
# proposition, leaves the program before emission: a statement or a definition giving one, a parameter taking one, an
# argument passing one. The kernel checked each as typing entered it.
use "../stage.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"

erased_code(n: Node) as Node := match n {
	Block(statements) => refitted(Block(statements.filter(statement => not proves(statement)).map(erased_code)), n)
	Define(name, parameters, body) => refitted(Define(name, with_items(parameters, items_of(parameters).filter(parameter => not proves(declared_name(parameter)))), erased_code(body)), n)
	Call(called, arguments) => refitted(Call(called, arguments.filter(argument => not proves(argument)).map(erased_code)), n)
	_ => if direct_parts(n) is empty then n else refitted(with_parts(n, erased_code), n)
}
# whether code gives a proof: a definition by its result's type, anything else by its value's
proves(n: Node) as bool := match n {
	Define(name, parameters, body) => is_proposition_type((function_parts(fact_type(fact_of(declared_name(name), SIGNATURE))) ?? return no).result)
	_ => is_proposition_type(fact_type(fact_of(n, TYPE)))
}
