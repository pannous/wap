# Function values: `x => x + 1` and a function's name as values, what they capture, and calls of them. A value of a
# type of its own calls its one function directly (functions.wap); a value of a signature, `(int) -> int`, is chosen at
# run time and called by its function's reference.

use folder
use "../../kernel/opcodes.wap"
use "../errors.wap"
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"

# A function value's function starts by taking its captures out of its first parameter, the value, into variables of
# its own, which its body reads as any local; a function that captures nothing takes none
captures_loaded(form: Define, parameters: list<Node>, p: Emission, f: Frame) as list<int> := {
	captures = captures_of(form)
	if captures is empty or parameters is empty { return [] }
	value = declared_name(parameters#1)
	parts = function_value_parts(type_of(value))
	if parts == ø { return [] }
	layouts = captured_layouts(parts, p)
	loads = []
	for at in 1 to #captures {
		slot = slotted(f, place_key(captures#at), layouts#at).index
		read = field_read(local_get(0), layouts, at, () => [closure_of(value, p), at - 1], p)
		loads += read + local_set(slot)
	}
	loads
}
captured_layouts(parts: list<Term>, p: Emission) as list<list<int>> := parts.map(capture => known_layout(capture, p))
# A function value: of a signature, `(int) -> int`, chosen at run time, a reference to its function beside what it
# captures; else of a type of its own, a struct of what it captures, its function called directly. A function's name
# as a value captures nothing.
function_value_code(form: Node, p: Emission, f: Frame) as Code := {
	if function_parts(type_of(form)) != ø { return signature_value_code(form, p, f) }
	Code(layout(form, p), captures_made(form, type_of(form), p, f))
}
# what a function value captures, in a new struct of its own type's, in the memory at a new address
captures_made(form: Node, own: Term, p: Emission, f: Frame) as list<int> := captures_code(form, p, f) + struct_made(() => captured_layouts(function_value_parts(own)!, p), () => closure_of_type(own, form, p), p)
# A function value of a signature: its function's adapter referred to, then its captures, the struct of them a λ
# builds or a variable holds, ø for a function's name. FUNCTION_VALUE, from the typing stage, is the value's own type, naming its function
# and its captures' types.
signature_value_code(form: Node, p: Emission, f: Frame) as Code := {
	own = fact_type(fact_of(form, FUNCTION_VALUE)) ?? refused(form, "this function value reached the emitter without the function it is")
	captures = if form is Fn then captures_made(form, own, p, f) else if names_function(form) then p.m.strategy.missing.instructions else variable_code(form, p, f).instructions
	adapter = helper(p, "adapter ${adapted_key(form)} ${type_text(type_of(form), yes)}", q => adapting_function(form, own, q))
	made = struct_made(() => SIGNATURE_MEMORY, () => signature_struct(p.m), p)
	Code(layout(form, p), function_reference(p.m, adapter) + captures + made)
}
# the key of the function typed for the signature, which the adapter calls
adapted_key(form: Node) as text := place_key(fact_of(form, ADAPTED) ?? refused(form, "this function value reached the emitter without the function it adapts"))
# a function value's signature, which its type is
value_signature(value: Node) as FunctionType := function_parts(type_of(value)) ?? refused(value, "this function value's type is no function type")
# The function every value of a signature calls: its captures, then its parameters, given to the value's own function,
# the one its ADAPTED names, typed for the signature; a function taking more than the signature, a λ's, takes the
# value's captures first, cast to their struct, a named function none, whether its name or a variable holds it
adapting_function(form: Node, own: Term, p: Emission) as int := {
	function = placed_by_key(p.functions, adapted_key(form)) ?? in_place_function(adapted_key(form), p) ?? refused(form, "the typing stage typed no function for this value")
	parts = value_signature(form)
	parameters = signature_parameters(parts, p.m, p.records)
	captures = if #function.parameters == #parameters then [] else local_get(0) + (p.m.strategy.captures_cast)(own, form, p)
	added_function(p.m, [p.m.strategy.captures_layout] + parameters, signature_results(parts, p.m, p.records), [], captures + (1 to #parameters).flat_map(local_get) + instruction(CALL, [function.index]))
}
# A call of a function value of a signature: the value kept in a slot of its own, then its captures, the arguments and
# its function's reference, called by call_ref
value_call_code(form: Node, called: Node, arguments: list<Node>, p: Emission, f: Frame) as Code := {
	parts = value_signature(called)
	value = code(called, p, f)
	slot = slotted(f, "value called from slot ${#f.slots}", value.type).index
	held = local_get(slot)
	taken = signature_parameters(parts, p.m, p.records)
	if #arguments != #taken { refused(form, "the call gives ${#arguments} arguments, the function value takes ${#taken}") }
	given = (1 to #arguments).flat_map(at => fitted(code(arguments#at, p, f), taken#at, arguments#at, p).instructions)
	results = signature_results(parts, p.m, p.records)
	called_by = instruction(CALL_INDIRECT, [signature_function_index(parts, p.m, p.records), 0])
	finished(Code(if results is empty then [] else results#1, value.instructions + local_set(slot) + signature_part(held, VALUE_CAPTURES_AT, p) + given + signature_part(held, VALUE_FUNCTION_AT, p) + called_by))
}
# A value of a signature in the memory: its function's slot in the module's table, then the address of its captures
SIGNATURE_MEMORY = [I32, I32]
# a part of a value of a signature, from 0: its function or its captures
signature_part(value: list<int>, part: int, p: Emission) as list<int> := field_read(value, SIGNATURE_MEMORY, part + 1, () => [signature_struct(p.m), part], p)
# the values a function value captures, read from the variables they are where it is made, the program's globals too
captures_code(form: Node, p: Emission, f: Frame) as list<int> := {
	captures_of(form).flat_map(definer => fetched(captured_variable(definer, p, f)))
}
captured_variable(definer: Node, p: Emission, f: Frame) as Placed := {
	placed_by_key(f.slots, place_key(definer)) ?? placed_by_key(p.globals, place_key(definer)) ?? refused(definer, "this capture reached the emitter before its value")
}
# the GC struct of a typed function value
closure_of(n: Node, p: Emission) as int := closure_of_type(type_of(n), n, p)
closure_of_type(type: Term, n: Node, p: Emission) as int := function_value_index(type, p.m, p.records) ?? refused(n, "this is no function value")
