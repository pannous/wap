# Functions: each a block defines is placed at the block's start, its body emitted where its definition stands;
# function values and their captures; calls.

use folder
use "../../kernel/opcodes.wap"
use "../../kernel/primitives.wap"
use "../errors.wap"
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"

# the exports every module has beside its functions
MAIN_EXPORT = "main"
RAISED_EXPORT = "raised"
# the top level but the value shown, which a host runs once for a module a program uses (the name warp's hosts run
# it by: core/native/driver.warp, web/playground/host.js); main runs it, then shows
INIT_EXPORT = "warp/start"
# `prim shown(print(show(x)))`: the statement a script shows its value by, its code that of the print
SHOWN_VALUE = "shown"

# what a module exports a definition by: its id and its word, as a dispatching function placed like a definition
# shares its id, not its word
export_key(definer: Node) as text := "${definer_id(definer)} ${definer}"

# a parameter given the frame's next slot, of a type
slotted(f: Frame, key: text, type: list<int>) as Placed := {
	f.slots += [Placed(key, #f.slots, type, [], yes)]
	f.slots.last
}
# A function placed by its signature, as the typing stage gives it, so any call finds it before its body is emitted
function_placed(form: Define, p: Emission) as Placed := match form { Define(name, parameters, body) => {
	types = items_of(parameters).map(parameter => parameter_type(parameter, declared_name(name), p))
	signed = signed_result(declared_name(name), p)
	if placed_by_key(p.functions, place_key(declared_name(name))) != ø { refused(name, "the typing stage wrote two definitions of this function for one type") }
	placed = filed(p.functions, Placed(place_key(declared_name(name)), reserved_function(p.m, types, if valued(signed) then [signed] else []), signed, types))
	named_function(p.m, placed.index, header_line(form))
	word = runtime_word(text(declared_name(name)), items_of(parameters).map(type_given))
	if word != ø { p.helpers[word!] = placed.index }
	placed
} }
# A function's body: its parameters the first slots of a new frame, its body's value its result
function_bodied(form: Define, p: Emission) := match form { Define(name, parameters, body) => {
	placed = placed_by_key(p.functions, function_key(form)) ?? refused(name, "this function was never placed")
	f = Frame(function: yes)
	for at in 1 to #placed.parameters { slotted(f, place_key(declared_name(items_of(parameters)#at)), placed.parameters#at) }
	f.parameter_count = #f.slots
	signed = placed.type
	f.signed = signed
	loaded = captures_loaded(form, items_of(parameters), p, f)
	value = signed_fit(code_at(yes, body, p, f), body, f, p)
	given = result_type(name, value, f)
	if valued(signed) and given != signed and given != NEVER { refused(name, "this function's body gives another type than its signature says") }
	finished_body = if valued(signed) or given == NEVER then value.instructions else dropped(value)
	bodied(p.m, placed.index, f.slots[f.parameter_count ..].map(slot => slot.type), loaded + finished_body)
} }
# a function kept in place, emitted only where it is taken as a value
in_place_function(key: text, p: Emission) as Placed? := {
	if not p.in_place.has(key) { return ø }
	definition = p.in_place[key]
	placed = function_placed(definition, p)
	function_bodied(definition, p)
	placed
}
# The layout of a function's result as its signature, which the typing stage writes on its name, says: none for ø
SIGNATURE_LESS = "this function reached the emitter without its signature"
# a typed function's parameter and result types, as typing signed it
signed_parts(name: Node) as FunctionType := function_parts(fact_type(fact_of(name, SIGNATURE))) ?? refused(name, SIGNATURE_LESS)
signed_result(name: Node, p: Emission) as list<int> := result_layout(signed_parts(name).result, p, name)
# A value of a type where any holds it: the GC type it is held as, a plain value's box or its own reference type, and
# the instructions that take the value out once cast
class Held { type_index: int, taken: list<int> }
# at is the code that asks
held_in_any(type: Term, at: Node, p: Emission) as Held := {
	if type == FUNCTION_TERM { return Held(function_base(p.m), []) }
	if type_text(type) in BOXED_WORDS {
		box = box_index(p.m, type_text(type))
		return Held(box, instruction(STRUCT_GET, [box, 0]))
	}
	Held(referenced(layout_of(type, p.m, p.records) ?? []) ?? refused(at, "a value any holds is tested for references and plain values, not this type"), [])
}
# a value any holds, known of a type: cast to it, a plain one taken out of its box
held_value(type: Term, at: Node, p: Emission) as list<int> := {
	held = held_in_any(type, at, p)
	heap_instruction(REF_CAST, held.type_index) + held.taken
}
# The type a function gives back: its body's value and every return's, all of one type
result_type(name: Node, body: Code, f: Frame) as list<int> := {
	result = if body.type == NEVER then (if f.returns is empty then NEVER else f.returns#1) else body.type
	for returned in f.returns { if returned != result { refused(name, "this function gives back values of different types") } }
	result
}
# the wasm function of a frame and its body, its value the result: its index
function_of(m: WasmModule, parameters: list<list<int>>, body: Code, f: Frame) as int := {
	results = if valued(body.type) then [body.type] else []
	added_function(m, parameters, results, f.slots[f.parameter_count ..].map(slot => slot.type), body.instructions)
}

# a parameter's type, as the typing stage gives it
parameter_type(parameter: Node, function: Node, p: Emission) as list<int> := known_layout(type_of(declared_name(parameter)), p, function)
# A call of a function the program or the types module defined, its arguments of its parameters' types
call_code(form: Node, called: Node, arguments: list<Node>, p: Emission, f: Frame, last: bool = no) as Code := {
	if is_case(called) { return case_value_code(form, called, arguments, p, f) }
	if (not called is symbol or not names_function(called)) and function_parts(fact_type(fact_of(called, TYPE))) != ø { return value_call_code(form, called, arguments, p, f) }
	kept = if names_function(called) and p.in_place.has(defining_key(called)) then in_place_body(p.in_place[defining_key(called)]) else ø
	if kept is Prim { return in_place_code(kept, arguments, p, f) }
	function = called_function(form, called, p)
	if #arguments != #function.parameters { refused(form, "the call gives ${#arguments} arguments, the function takes ${#function.parameters}") }
	given = (1 to #arguments).map(at => fitted(code(arguments#at, p, f), function.parameters#at, arguments#at, p))
	if not (1 to #given).all(at => passes(given#at.type, function.parameters#at, p.m)) { refused(form, "the arguments are not of the parameters' types: given ${given.map(each => each.type)}, wanted ${function.parameters}") }
	passed = given.flat_map(argument => argument.instructions)
	if last and function.type == f.signed { return Code(NEVER, passed + instruction(RETURN_CALL, [function.index])) }
	finished(Code(function.type, passed + instruction(CALL, [function.index])))
}
# A function whose body is only a primitive of its parameters in their order, `byte_at(t, at) := prim array.get_u(t,
# at)`: a call compiles to its arguments, fitted to the primitive's operands, then the primitive in place, as a
# built-in's header line keeps its body for an importer (wiki/wasm-representation.md); the function itself is emitted
# only as a function value.
is_in_place(definition: Define) as bool := match definition { Define(name, parameters, body) => match body {
	Prim(operation, given) => given.all(each => each is symbol) and given.map(each => text(each)) == items_of(parameters).map(parameter => text(declared_name(parameter)))
	_ => no
} }
# a call of a function kept in place: its arguments, fitted to the primitive's operands, then the primitive
in_place_code(kept: Prim, arguments: list<Node>, p: Emission, f: Frame) as Code := match kept { Prim(operation, given) => primitive_code(kept, operation, (1 to #arguments).map(at => fitted(code(arguments#at, p, f), layout(given#at, p), arguments#at, p)), p) }
# its primitive, typed as the function's signature says (a generic body's own type is its type variable)
in_place_body(definition: Define) as Node := match definition { Define(name, parameters, body) => {
	result = signed_parts(declared_name(name)).result
	if result == EMPTY_TERM then body else with_fact(body, TYPE, type_fact(result))
} }
# whether a value of one wasm type may be passed where another is taken: the same type, code that never finishes, or a
# list where any list is taken (a list<T> given to a `list` parameter, its type extending the list base)
passes(given: list<int>, taken: list<int>, m: WasmModule) as bool := given == taken or given == NEVER or (taken == nullable(list_base(m)) and given#1 == NULLABLE_REFERENCE) or supertype_passes(given, taken, m)
# a reference to a struct passes where one to its supertype is taken, a class's instance where the class it extends is
supertype_passes(given: list<int>, taken: list<int>, m: WasmModule) as bool := {
	sub = m.supertypes.keys.find(at => given.drop(1) == signed(at)) ?? return no
	passes([given#1] + signed(m.supertypes[sub]), taken, m)
}
called_function(form: Node, called: Node, p: Emission) as Placed := {
	if not names_function(called) { refused(form, "the emitter calls functions, not a ${binding_of(called)} yet") }
	placed_for(p.functions, called) ?? refused(form, "this function was never placed")
}
# A module's exports (wiki/wasm-representation.md "Export names"): each function compiled once, by its export key, under its
# header line written as wap, `add(a: int, b: int = 1) → int`, which tells overloads apart, and under its plain word
# too where it is the word's one definition in the file or among the exports (a used module's `export`); a dispatcher
# (core/analyze/dispatch.wap) only under the plain word it dispatches
functions_exported(statements: list<Node>, exports: list<text>, p: Emission) := {
	own = statements.filter(s => is_exported(s, exports) or s is Define and file_of(defined_name(s)) == p.source)
	for definition in statements.filter(s => is_exported(s, exports)) {
		placed = placed_by_key(p.functions, function_key(definition)) ?? refused(definition, "this function was never placed")
		# the header line last, the name a backtrace shows
		for name in export_names(definition, own) { exported(p.m, name, FUNCTION_KIND, placed.index) }
	}
}
is_exported(statement: Node, exports: list<text>) as bool := statement is Define and (exports.contains(export_key(defined_name(statement))) or has_fact(defined_name(statement), EXPORTED_AS))
export_names(definition: Define, own: list<Node>) as list<text> := {
	name = plain_word(definition)
	if has_fact(defined_name(definition), EXPORTED_AS) { return [name] }
	alone = #own.filter(other => plain_word(other) == name) == 1 and not [MAIN_EXPORT, INIT_EXPORT, MEMORY_EXPORT].contains(name)
	(if alone then [name] else []) + [header_line(definition)]
}
# the word a definition is exported under alone: its name, a dispatcher's the word it dispatches
plain_word(definition: Define) as text := text(fact_of(defined_name(definition), EXPORTED_AS) ?? defined_name(definition))
# each value compiled once, the program's own global, under its header line `x: int`: a module using it shares it,
# exported once however often it is assigned
values_exported(program: Node, exports: list<text>, p: Emission) := {
	globals: map<text, int> = {}
	for name in defined_values(program).filter(name => exports.contains(export_key(name))) {
		globals[value_header(name)] = (placed_for(p.globals, name) ?? refused(name, "this value was never placed")).index
	}
	for header in globals.keys { exported(p.m, header, GLOBAL_KIND, globals[header]) }
}
# the names that define the program's globals, wherever their assignment stands (the last statement's in the print
# of its value)
defined_values(n: Node) as list<Node> := match n {
	Set(place, value) => (if not is_foreign_value(n) and is_bound(declared_name(place), DefinitionKind.Global) and fact_of(declared_name(place), DEFINER) != ø then [declared_name(place)] else []) + defined_values(value)
	_ => direct_parts(n).flat_map(defined_values)
}
# the header line of a value, `x: int`
value_header(name: Node) as text := "${name}: ${type_text(type_of(name))}"
# the header line of a function's instance, with the types typing gave it
header_line(definition: Define) as text := match definition { Define(name, parameters, body) => {
	result = signed_parts(declared_name(name)).result
	signature_text(declared_name(name), items_of(parameters), if result == EMPTY_TERM then ø else result, EXPORT_ARROW)
} }
