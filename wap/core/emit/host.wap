# The primitives that ask the host (WASI): printing, raising, reading and writing files, the command line. Each is a
# helper function of the module, built here from WASI's calls on the module's memory; primitives.wap names them.

use folder
use "../../kernel/opcodes.wap"
use "../../kernel/primitives.wap"
use "../../kernel/scalars.wap"
use "../errors.wap"
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"

# A text is written through WASI's fd_write(fd, iovecs, count, written), which the native warp and the browser both
# answer (types/host.wap write). Its memory: the iovec [address, length] at 0, the count written at 8, the text's bytes
# from 16.
STDERR = 2
# the status a program that raised exits with
RAISED_STATUS = 1
# the module's one exception tag, a raise's, carrying its text, added at the first raise or catch: a module raising
# nothing has none (a native build's wasm2c takes no tag); a program reading a compiled library imports the library's
# tag instead, which its exports name `raised`
RAISED_TAG = 0
raised_tag(p: Emission) as int := {
	if #p.m.tags + #p.m.tag_imports == 0 { if p.m.tag_module is empty then added_tag(p.m, [text_layout(p.m)]) else imported_tag(p.m, p.m.tag_module, RAISED_EXPORT, [text_layout(p.m)]) }
	RAISED_TAG
}
NEWLINE = 10
IOVEC_ADDRESS = 0
WRITTEN_ADDRESS = 8
BYTES_ADDRESS = 16
# the bytes of the widest value in the memory, an int's or a float's, which every address taken is a multiple of
WIDEST_BYTES = 8

# The host's functions (WASI) a module imports, before any function of its own: fd_write and proc_exit, which print
# and every helper that raises call, into every module, first; the others only for the primitives that call them, a
# primitive of a host function's own name (wap/types/host.wap), its types by its row (kernel/primitives.wap)
RAISING_CALLS = ["fd_write", "proc_exit"]
# A function of another module, wasm's import, `strlen(s: int32): int := prim foreign("c", "strlen", s)`:
# Prim(foreign, [module, name, arguments…]), its module and name texts the emitter reads, never code; its types those
# of its arguments and value (kernel/primitives.wap FOREIGN). Imported before any function of the module's own, as
# the host functions are
foreign_calls(n: Node) as list<Node> := if is_foreign_value(n) then [] else match n {
	Prim(operation, arguments) => (if text(operation) == FOREIGN then [n] else []) + arguments.flat_map(foreign_calls)
	_ => direct_parts(n).flat_map(foreign_calls)
}
written_text(call: Node, at: int) as text := match foreign_parts(call)#at { Text(value) => value; Char(value) => text(value); _ => refused(call, "this primitive takes its texts written in place") }
foreign_parts(call: Node) as list<Node> := match call { Prim(operation, arguments) => arguments; _ => refused(call, "a foreign call is a primitive") }
foreign_arguments(call: Node) as list<Node> := foreign_parts(call).drop(2)
# one import per module and name: a declaration of it with other types than the first is refused
foreign_imported(call: Node, calls: list<Node>, p: Emission) := {
	shape = foreign_shape(call, p)
	for other in calls { if foreign_key(other) == foreign_key(call) and foreign_shape(other, p) != shape { refused(call, "this declares ${foreign_key(call)} with other types than ${place_of_code(other)} does: one import, one declaration") } }
	if not p.host.has(foreign_key(call)) { p.host[foreign_key(call)] = imported(p.m, written_text(call, 1), written_text(call, 2), shape#1, shape#2) }
}
# a foreign call's parameter layouts and its result's, none where it gives nothing
foreign_shape(call: Node, p: Emission) as list<list<list<int>>> := [foreign_arguments(call).map(argument => layout(argument, p)), if typed_layout(call, p) is empty then [] else [typed_layout(call, p)]]
# an int crosses as its word: one past the scalars is refused, a word given back is widened (kernel/scalars.wap)
foreign_code(call: Node, p: Emission, f: Frame) as Code := Code(typed_layout(call, p), foreign_arguments(call).flat_map(argument => code(argument, p, f).instructions + (if is_int(argument) then plain_checked(p) else [])) + instruction(CALL, [p.host[foreign_key(call)]]) + (if is_int(call) then runtime_call(p, WIDENING) else []))
is_int(n: Node) as bool := fact_of(n, TYPE) != ø and type_text(type_of(n)) == INT_TYPE
# A value of another module, `x: int = prim foreign("m.wasm", "x: int")`, is its global, imported mutable before the
# module's own and shared: a global a foreign primitive gives is that module's
is_foreign_value(statement: Node) as bool := match statement { Set(place, value) => is_bound(declared_name(place), DefinitionKind.Global) and (match value { Prim(operation, given) => text(operation) == FOREIGN; _ => no }); _ => no }
# each one code reads or sets imported before any global of the module's own is added, as wasm numbers the imported
# globals first; so a module imports only the values it uses and runs alone when it uses none
foreign_values_imported(statements: list<Node>, p: Emission) := {
	p.foreign_values = statements.filter(is_foreign_value)
	for name in globals_named(statements.filter(statement => not is_foreign_value(statement))) { imported_once(name, p) }
}
# the names of globals in the code, each time it names one: the one walk of the module for its foreign values
globals_named(code: list<Node>) as list<Node> := code.flat_map(each => if each is symbol then (if is_bound(each, DefinitionKind.Global) then [each] else []) else globals_named(direct_parts(each)))
# a foreign value a name refers to imported, unless it was
imported_once(name: Node, p: Emission) := placed_for(p.globals, name) ?? foreign_placed(name, p)
# the value of another module a name refers to; ø where it names none
foreign_placed(name: Node, p: Emission) as Placed? := {
	set = p.foreign_values.find(each => defining_key(declared_name(each)) == defining_key(name)) ?? return ø
	value = match set { Set(place, given) => given; _ => refused(set, "a foreign value is a Set") }
	type = layout(declared_name(set), p)
	filed(p.globals, Placed(defining_key(name), imported_global(p.m, written_text(value, 1), written_text(value, 2), type), type))
}
foreign_key(call: Node) as text := written_text(call, 1) + "." + written_text(call, 2)
# data_address("Hello"): the address of the text's bytes in the module's data, its text written in place
DATA_ADDRESS_PRIM = "data_address"
data_code(form: Node, p: Emission) as Code := {
	address = data_placed(p.m, written_text(form, 1).bytes)
	Code(typed_layout(form, p), if typed_layout(form, p) == I32 then i32_const(address) else i64_const(address))
}
# the index of a host function the module imported
host(p: Emission, name: text) as int := p.host[name] ?? refused(Text(name), "the module did not import this host function")

# a raise: its text thrown, for the innermost Try around it to catch (kernel-try); in the memory, where no Try catches,
# its text and a line end written to stderr and the program ended
raising_function(p: Emission) as int := added_function(p.m, [text_layout(p.m)], [], [], (p.m.strategy.raised)(p))
# a raise no Try caught, its text on the stack: written to stderr and a line end, the program ended
uncaught(p: Emission) as list<int> := i64_const(STDERR) + i32_const(1) + runtime_call(p, TEXT_WRITING) + i32_const(RAISED_STATUS) + instruction(CALL, [host(p, "proc_exit")])
# a raise of the text on the stack from inside a helper
raise_called(p: Emission) as list<int> := helper_call(p, "raise_text", raising_function) + UNREACHABLE
# a raise of a message from inside a helper
raised(message: text, p: Emission) as list<int> := text_literal(message, p.m).instructions + raise_called(p)
# a raise of a message and the text the code `ending` gives, joined
raised_with(message: text, ending: list<int>, p: Emission) as list<int> := text_literal(message, p.m).instructions + ending + runtime_call(p, TEXT_JOINING) + raise_called(p)
# The helper of memory_held: the memory grown to hold that many bytes from BYTES_ADDRESS. Its locals: 0 the count, 1
# the pages short.
memory_holding_function(p: Emission) as int := added_function(p.m, [I64], [], [I32], memory_grown(BYTES_ADDRESS + 1, int_local(0), 1))
# The helper of memory_taken: the address of that many new zero bytes past the memory the module started with, which
# grows; never freed. Each address is a multiple of the widest field's bytes, so C reads any struct there. Its global:
# where the next bytes go, 0 till the first are taken; its locals: 0 the count, 1 the address, 2 the pages short.
memory_taking_function(p: Emission) as int := {
	end = added_global(p.m, I32, MUTABLE, i32_const(0))
	reached = instruction(GLOBAL_GET, [end])
	started = reached + I32_EQZ + if_block(instruction(MEMORY_SIZE, [0]) + i32_const(PAGE_BYTES) + I32_MUL + instruction(GLOBAL_SET, [end]))
	taken = reached + local_set(1) + reached + local_get(0) + I32_ADD + i32_const(WIDEST_BYTES - 1) + I32_ADD + i32_const(WIDEST_BYTES) + I32_DIV_U + i32_const(WIDEST_BYTES) + I32_MUL + instruction(GLOBAL_SET, [end])
	added_function(p.m, [I32], [I32], [I32, I32], started + taken + memory_grown(0, reached, 2) + local_get(1))
}
# the memory grown to hold that many bytes from an address, the scratch local holding the pages short:
# (address + length + a page - 1) ÷ page - memory.size, grown when positive
memory_grown(from: int, length: list<int>, scratch: int) as list<int> := i32_const(from + PAGE_BYTES - 1) + length + I32_ADD + i32_const(PAGE_BYTES) + I32_DIV_U + instruction(MEMORY_SIZE, [0]) + I32_SUB + instruction(LOCAL_TEE, [scratch]) + i32_const(0) + I32_GT_S + if_block(local_get(scratch) + instruction(MEMORY_GROW, [0]) + DROP)
