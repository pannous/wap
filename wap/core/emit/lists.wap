# Growable lists and the maps built on them. A list<T> is a struct of its count and an array of its items
# (values.wap list_index); the array's places past the count are spare, so add puts an item in place and only a full
# array is copied into a larger one, and every name holding the list sees it grow. A map<K, V> is a struct of three such
# lists, its keys and its values, an entry the same place in both, and its slots (values.wap map_parts).

use folder
use "../../kernel/opcodes.wap"
use "../errors.wap"
use "../stage.wap"
use "../type_notation.wap"

# a full list's array grows to twice its places and this many more
GROWTH = 4
NO_SUCH_ITEM = "this list has no item at this place"
POPPED_EMPTY = "pop of an empty list"
NO_MAP_TYPE = "this is no map type"
NO_ITEM_LAYOUT = "the emitter has no value layout for this list's items yet"
LIST_COUNT = "list_count"
LIST_SLICE = "list_slice"
# The operations on a list or a map, one helper for each type of their first operand: operation → its builder
TYPED_HELPERS = {
	"list_item": item_reading_function, "list_set": item_setting_function, "list_add": adding_function,
	"list_pop": popping_function, "list_slice": list_slicing_function
}
# a call of the helper of an operation on a value of this type
typed_helper_called(operation: text, type: Term, p: Emission) as list<int> := helper_call(p, "${operation} ${type_text(type, yes)}", q => TYPED_HELPERS[operation](q, type))
# the count of any list, read from the list base every list's type extends
counted_items(p: Emission) as list<int> := instruction(STRUCT_GET, [list_base(p.m), LIST_COUNT_AT]) + I64_EXTEND_I32_U

# a new list of these items' code, of a list type
# a new list of items of a type
list_made(item: Term, items: list<Code>, p: Emission) as list<int> := i32_const(#items) + items.flat_map(each => each.instructions) + instruction(ARRAY_NEW_FIXED, [item_array(item, p.m, p.records) ?? refused_type(item, NO_ITEM_LAYOUT), #items]) + instruction(STRUCT_NEW, [items_list(item, p.m, p.records) ?? refused_type(item, NO_ITEM_LAYOUT)])

# The helpers of list_item and list_set, an item at a place counted from 0, an int: locals 0 the list, 1 the place, for
# list_set 2 the value, a place below the count: `#` and set take a position, checked or proved before the call
item_reading_function(p: Emission, type: Term) as int := added_function(p.m, [list_layout(type, p), I64], [item_layout(type, p)], [], item_read(type, 0, int_local(1), p))
item_setting_function(p: Emission, type: Term) as int := added_function(p.m, [list_layout(type, p), I64, item_layout(type, p)], [], [], items_in(type, 0, p) + int_local(1) + local_get(2) + instruction(ARRAY_SET, [items_array(type, p)]))

# The helper of list_add: the item put at the count, the array first copied into a larger one when full. Its locals:
# 0 the list, 1 the item, 2 the larger array.
adding_function(p: Emission, type: Term) as int := {
	array = items_array(type, p)
	full = count_in(type, 0, p) + items_in(type, 0, p) + ARRAY_LEN + I32_EQ
	grown = items_in(type, 0, p) + ARRAY_LEN + i32_const(2) + I32_MUL + i32_const(GROWTH) + I32_ADD + instruction(ARRAY_NEW_DEFAULT, [array]) + local_set(2) + local_get(2) + i32_const(0) + items_in(type, 0, p) + i32_const(0) + count_in(type, 0, p) + instruction(ARRAY_COPY, [array, array]) + local_get(0) + local_get(2) + instruction(STRUCT_SET, [list_struct(type, p), LIST_ITEMS_AT])
	put = items_in(type, 0, p) + count_in(type, 0, p) + local_get(1) + instruction(ARRAY_SET, [array])
	added_function(p.m, [list_layout(type, p), item_layout(type, p)], [], [nullable(array)], full + if_block(grown) + put + counted_by(type, 1, p))
}
# The helper of list_pop: the last item taken off; an empty list raises. Its local: 0 the list.
popping_function(p: Emission, type: Term) as int := {
	none_left = count_in(type, 0, p) + I32_EQZ + if_block(raised(POPPED_EMPTY, p))
	last = item_read(type, 0, count_in(type, 0, p), p)
	added_function(p.m, [list_layout(type, p)], [item_layout(type, p)], [], none_left + counted_by(type, -1, p) + last)
}
# The helper of array_slice given a list: a new list of `count` items from the place `from`, counted from 0. Its
# locals: 0 the list, 1 from, 2 count, 3 the new array. A slice past the count raises.
list_slicing_function(p: Emission, type: Term) as int := {
	array = items_array(type, p)
	checked = count_in(type, 0, p) + int_local(1) + int_local(2) + I32_ADD + I32_LT_U + if_block(raised(NO_SUCH_ITEM, p))
	added_function(p.m, [list_layout(type, p), I64, I64], [list_layout(type, p)], [nullable(array)], checked + slice_copied(array, items_in(type, 0, p)) + int_local(2) + local_get(3) + instruction(STRUCT_NEW, [list_struct(type, p)]))
}

# a new map of these keys' and values' code
map_made(map: Term, keys: list<Code>, values: list<Code>, p: Emission) as list<int> := {
	parts = map_parts(map)
	(1 to #parts).flat_map(at => list_made(parts#at, [keys, values, []]#at, p)) + instruction(STRUCT_NEW, [map_struct(map, p)])
}

# the wasm types of a list: the struct, a reference to it, the array of its items, an item's layout
list_struct(type: Term, p: Emission) as int := list_index(type, p.m, p.records) ?? refused_type(type, NO_ITEM_LAYOUT)
# DEBT: one layout per item type (an array of i64 for list<int>, of references for list<Node>): a list<int> can't
#   stand where a list of anything is wanted without a copy, and lists are shared, so a copy changes meaning. Paid off
#   when every list and map holds references (small ints as i31, others boxed) and `list<int>` is a promise typing
#   checks with a cast at the read: any list fits a bare `list`, the list words exist once.
list_layout(type: Term, p: Emission) as list<int> := nullable(list_struct(type, p))
items_array(type: Term, p: Emission) as int := items_index(type, p.m, p.records) ?? refused_type(type, NO_ITEM_LAYOUT)
list_item(type: Term) as Term := item_type(type) ?? refused_type(type, "this list type names no item type")
item_layout(type: Term, p: Emission) as list<int> := known_layout(list_item(type), p)
# the count or the items array of the list in a local, or of the one on the stack for ø
count_in(type: Term, local: int?, p: Emission) as list<int> := list_field(type, local, LIST_COUNT_AT, p)
items_in(type: Term, local: int?, p: Emission) as list<int> := list_field(type, local, LIST_ITEMS_AT, p)
# the item at a place of the list in a local, or of the one on the stack for ø
item_read(type: Term, local: int?, place: list<int>, p: Emission) as list<int> := items_in(type, local, p) + place + instruction(ARRAY_GET, [items_array(type, p)])
list_field(type: Term, local: int?, at: int, p: Emission) as list<int> := (if local == ø then [] else local_get(local)) + instruction(STRUCT_GET, [list_struct(type, p), at])
# the list in local 0 counted up or down by one
counted_by(type: Term, step: int, p: Emission) as list<int> := local_get(0) + count_in(type, 0, p) + i32_const(step) + I32_ADD + instruction(STRUCT_SET, [list_struct(type, p), LIST_COUNT_AT])
# a map's struct, the types of its lists of keys and of values
map_struct(map: Term, p: Emission) as int := map_index(map, p.m, p.records) ?? refused_type(map, "this is no map")
# a map type's key type and value type, and the lists of them its parts are
map_key(map: Term) as Term := key_type(map) ?? refused_type(map, NO_MAP_TYPE)
map_value(map: Term) as Term := held_type(map) ?? refused_type(map, NO_MAP_TYPE)
