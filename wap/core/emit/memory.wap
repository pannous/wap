# How a build that keeps texts, lists and enums in the memory lays them out, filled by its extension
# (extensions/native/memory.wap); the GC build has none: the words a list's literal is built by, by "list", each
# value's layout by its type word, a fixed text's bytes, an uncaught raise's code given the host's fd_write and
# proc_exit, and the library files it reads in others' places, by their paths in the wap folder (a record's instance is
# laid out as a C struct, core/emit/places.wap memory_place)
class MemoryLayout { built_by: map<text, list<text>>, layouts: map<text, list<int>>, text_bytes: (text) -> list<int>, raised: (int, int) -> list<int>, files: map<text, text> }
