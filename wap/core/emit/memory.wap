# How a build that keeps texts, lists and enums in the memory lays them out, filled by its extension
# (extensions/native/memory.wap); the GC build has none: the words a list's or a record's literal is built by, by
# "list" and "record", each value's layout by its type word, a fixed text's bytes, the bytes a record's field takes,
# and an uncaught raise's code given the host's fd_write and proc_exit
class MemoryLayout { built_by: map<text, list<text>>, layouts: map<text, list<int>>, text_bytes: (text) -> list<int>, field_bytes: int, raised: (int, int) -> list<int> }
