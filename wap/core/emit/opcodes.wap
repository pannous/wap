# The wasm binary format's codes: section ids, value and heap types, kinds, and the opcodes of the instructions
# wap emits, each as its bytes. Format reference: https://webassembly.github.io/spec/core/binary/
MAGIC = [0x00, 0x61, 0x73, 0x6D]
VERSION = [0x01, 0x00, 0x00, 0x00]

# section ids, in the order the format requires them, a custom section's anywhere
CUSTOM_SECTION = 0
TYPE_SECTION = 1
IMPORT_SECTION = 2
FUNCTION_SECTION = 3
MEMORY_SECTION = 5
TAG_SECTION = 13
GLOBAL_SECTION = 6
EXPORT_SECTION = 7
ELEMENT_SECTION = 9
DATA_COUNT_SECTION = 12
CODE_SECTION = 10
DATA_SECTION = 11

# value types, each its bytes; a reference to a declared type is `nullable(index)`
I32 = [0x7F]
I64 = [0x7E]
F64 = [0x7C]
ANYREF = [0x6E]
# the storage of an array of bytes, packed
I8 = [0x78]
# heap types, each its bytes (a declared type's is signed(index)), and type constructors
ANY_HEAP = [0x6E]
# the heap type of the references wasm compares by identity, structs and arrays among them
EQ_HEAP = [0x6D]
NULLABLE_REFERENCE = 0x63
FUNCTION_TYPE = 0x60
STRUCT_TYPE = 0x5F
ARRAY_TYPE = 0x5E
# a type that others may extend, with the types it extends
SUBTYPE = 0x50
# types declared together, one recursion group
REC_GROUP = 0x4E
IMMUTABLE = 0
MUTABLE = 1

# what an import or export is
FUNCTION_KIND = 0x00
MEMORY_KIND = 0x02
GLOBAL_KIND = 0x03

# an element segment that only declares the functions `ref.func` refers to, by their indices
DECLARED_FUNCTIONS = [0x03, 0x00]
# a tag of an exception, the only kind of tag, and a try_table's clause catching one tag's exceptions with their values
EXCEPTION_TAG = 0x00
CATCH = 0x00
# a data segment kept passive, for `array.new_data`
PASSIVE_SEGMENT = 0x01
ACTIVE_SEGMENT = 0x00
# where a module's data starts in its memory (wasm.wap data_placed), and a memory page's size
DATA_ADDRESS = 65536
PAGE_BYTES = 65536

# Instructions, each its opcode bytes; `instruction(opcode, indices)` adds the unsigned immediates it takes.
UNREACHABLE = [0x00]
BLOCK = [0x02]
# a raise: the exception of a tag thrown, its values on the stack, and a block that catches such
THROW = [0x08]
TRY_TABLE = [0x1F]
LOOP = [0x03]
IF = [0x04]
ELSE = [0x05]
BRANCH = [0x0C]
BRANCH_IF = [0x0D]
# the type of a block that takes and leaves nothing
VOID_BLOCK = [0x40]
RETURN = [0x0F]
CALL = [0x10]
# a call of the function a typed function reference on the stack refers to, `call_ref $type`
CALL_REF = [0x14]
DROP = [0x1A]
LOCAL_GET = [0x20]
LOCAL_SET = [0x21]
LOCAL_TEE = [0x22]
GLOBAL_GET = [0x23]
GLOBAL_SET = [0x24]
I32_LOAD = [0x28]
I32_LOAD8_U = [0x2D]
I32_STORE = [0x36]
I32_STORE8 = [0x3A]
MEMORY_SIZE = [0x3F]
MEMORY_GROW = [0x40]
I32_CONST = [0x41]
I64_CONST = [0x42]
F64_CONST = [0x44]
I32_EQZ = [0x45]
I32_EQ = [0x46]
I32_NE = [0x47]
I32_GT_S = [0x4A]
I32_LT_U = [0x49]
I32_GE_U = [0x4F]
I64_EQ = [0x51]
F64_EQ = [0x61]
I32_ADD = [0x6A]
I32_SUB = [0x6B]
I32_MUL = [0x6C]
I32_DIV_U = [0x6E]
I64_SUB = [0x7D]
I32_OR = [0x72]
I32_WRAP_I64 = [0xA7]
I64_EXTEND_I32_U = [0xAD]
REF_NULL = [0xD0]
# a reference to a function of the module, which a declarative element segment names (WasmModule.referenced)
REF_FUNC = [0xD2]
REF_IS_NULL = [0xD1]
REF_EQ = [0xD3]
REF_AS_NON_NULL = [0xD4]
END = [0x0B]
STRUCT_NEW = [0xFB, 0x00]
STRUCT_GET = [0xFB, 0x02]
STRUCT_SET = [0xFB, 0x05]
REF_TEST = [0xFB, 0x14]
# a test that takes ø as of the type too, `ref.test null $t`
REF_TEST_NULL = [0xFB, 0x15]
REF_CAST = [0xFB, 0x16]
REF_CAST_NULL = [0xFB, 0x17]
ARRAY_NEW_DEFAULT = [0xFB, 0x07]
ARRAY_NEW_FIXED = [0xFB, 0x08]
ARRAY_NEW_DATA = [0xFB, 0x09]
ARRAY_GET = [0xFB, 0x0B]
ARRAY_GET_U = [0xFB, 0x0D]
ARRAY_SET = [0xFB, 0x0E]
ARRAY_LEN = [0xFB, 0x0F]
ARRAY_COPY = [0xFB, 0x11]
# The instructions a Prim names by their wasm mnemonic, `prim i64.add(a, b)`. The types of their operands and of
# their value are the ones the built-in's definition writes (wap/types/prelude.wap).
MNEMONICS: map<text, list<int>> = {
	"ref.is_null": REF_IS_NULL, "i64.add": [0x7C], "i64.sub": I64_SUB, "i64.mul": [0x7E], "i64.eq": I64_EQ,
	"i64.ne": [0x52], "i64.lt_s": [0x53], "i64.gt_s": [0x55], "i64.le_s": [0x57], "i64.ge_s": [0x59],
	"f64.add": [0xA0], "f64.sub": [0xA1], "f64.mul": [0xA2], "f64.div": [0xA3], "f64.eq": F64_EQ, "f64.ne": [0x62],
	"f64.lt": [0x63], "f64.gt": [0x64], "f64.le": [0x65], "f64.ge": [0x66], "i64.div_s": [0x7F],
	"i64.rem_s": [0x81], "f64.neg": [0x9A], "f64.floor": [0x9C], "f64.ceil": [0x9B], "i64.trunc_f64_s": [0xB0],
	"f64.convert_i64_s": [0xB9], "i64.reinterpret_f64": [0xBD], "f64.reinterpret_i64": [0xBF],
	"i64.extend_i32_u": I64_EXTEND_I32_U, "i64.extend_i32_s": [0xAC], "i32.wrap_i64": I32_WRAP_I64,
	"i64.clz": [0x79], "i64.ctz": [0x7A], "i64.popcnt": [0x7B], "i64.and": [0x83], "i64.or": [0x84], "i64.xor": [0x85],
	"i64.shl": [0x86], "i64.shr_s": [0x87], "i64.shr_u": [0x88], "i64.rotl": [0x89], "i64.rotr": [0x8A]
}
# a memory's size in pages
PAGE_BYTES = 0x10000
