# The primitives the emitter performs (wap/types/prelude.wap): where warp ends and wasm or the host begins.
#
# Input: a Prim's operation and the code of its arguments; output: the code of the operation. Only the types module
# writes a Prim, as the body of a built-in (wap/types/prelude.wap), so each operation here is named once, in the
# definition that gives it a warp signature. An operation that needs more than a few instructions is a helper
# function of the module, emitted once.

use folder
use "../../kernel/opcodes.wap"
use "../../kernel/forms.wap"
use "../../kernel/primitives.wap"
use "../../kernel/scalars.wap"
use "../errors.wap"
use "../stage.wap"
use "../type_notation.wap"

# operands within ±2^31 multiply within 64 bits: an operand plus FACTOR_OFFSET, read unsigned, below FACTOR_RANGE
FACTOR_OFFSET := 2147483648
FACTOR_RANGE := 4294967296
# a shift by at least the word's bits shifts out every bit
WORD_BITS := 64
# the row that takes an int where the machine takes 32 bits, which refuses one past the scalars
NARROWED_ROW = "i32.wrap_i64"
# a helper's early end: unless the test on the stack is yes, the helper gives no
NO_UNLESS_YES = I32_EQZ + if_block(i32_const(0) + RETURN)

# The operations a helper function of the module performs: operation → the function that builds the helper
HELPERS = {"memory_held": memory_holding_function, "raise_text": raising_function, "case_name": case_naming_function}
# the lists a map holds, not copied: its keys and its values, an entry the same place in both, and its slots
MAP_FIELDS = {"map_keys_held": MAP_KEYS, "map_values_held": MAP_VALUES, "map_slots_held": MAP_SLOTS}

# The operations on a text's bytes, each by the wasm types it takes and gives and its instructions, as a host
# operation's row (kernel/primitives.wap): an int given where it takes an i32 is wrapped to one, an i32 it gives extended
# to an int; an operand of another type than it takes is refused
# an item of a list in the memory (wap/types/memory_lists.wap): 8 bytes at an address, read or written as
# the item's type is laid out, an int or a float as it is, an address (a text, a list) in the low 4 bytes
ITEM_LOAD = "item.load"
ITEM_STORE = "item.store"
ITEM_BYTES = "item.bytes"
# new bytes in the memory, never freed
MEMORY_TAKEN = "memory_taken"
item_loaded(type: list<int>) as WasmOperation := WasmOperation([I32], [type], instruction(item_access(type)#1, [2, 0]))
item_stored(type: list<int>) as WasmOperation := WasmOperation([I32, type], [], instruction(item_access(type)#2, [2, 0]))
# the load and the store of a value of a layout at its own width
item_access(type: list<int>) as list<list<int>> := if type == I32 then [I32_LOAD, I32_STORE] else if type == F32 then [F32_LOAD, F32_STORE] else if type == F64 then [F64_LOAD, F64_STORE] else [I64_LOAD, I64_STORE]
text_operations(p: Emission) as map<text, WasmOperation> := {
	bytes = text_type(p.m)
	text = text_layout(p.m)
	{
		"array.get_u": WasmOperation([text, I32], [I32], instruction(ARRAY_GET_U, [bytes])), "array.len": WasmOperation([text], [I32], ARRAY_LEN), "ref.eq": WasmOperation([text, text], [I32], REF_EQ),
		"array.new_default": WasmOperation([I32], [text], instruction(ARRAY_NEW_DEFAULT, [bytes])), "array.set": WasmOperation([text, I32, I32], [], instruction(ARRAY_SET, [bytes])),
		"array.copy": WasmOperation([text, I32, text, I32, I32], [], instruction(ARRAY_COPY, [bytes, bytes]))
	}
}
# the code of an operation of wasm types: as many operands as it takes, each int it takes as an i32 wrapped, its
# instructions, then the value it gives as its definition writes it: an i32 as an int extended, another of its own type
# (the extension is the declared mirror of the operand's wrap: wap's host words read every i32 as an int)
wasm_called(form: Node, arguments: list<Code>, operation: WasmOperation, p: Emission) as Code := {
	if #arguments != #operation.takes { refused(form, "this primitive takes ${#operation.takes} operands, not ${#arguments}") }
	narrowed = (1 to #arguments).flat_map(at => arguments#at.instructions + (if arguments#at.type == operation.takes#at or arguments#at.type == NEVER then [] else if arguments#at.type == I64 and operation.takes#at == I32 then I32_WRAP_I64 else refused(form, "operand ${at} of this primitive is not of the wasm type it takes")))
	type = typed_layout(form, p)
	given = if operation.gives == [type] or (operation.gives is empty and type is empty) then [] else if operation.gives == [I32] and type == I64 then I64_EXTEND_I32_U else refused(form, "this primitive gives a value of another wasm type than its definition writes")
	Code(type, narrowed + operation.code + given)
}

# two cases compared, by the type of the first: its tag and its fields, each by its own type's equality
TAG_EQUAL = "tag_equal"
# a plain case's number among its enum's cases, from 0: its tag past its enum's first one (patterns.wap declared_tag)
CASE_NUMBER = "case_number"
case_numbered(enum: Term, p: Emission) as list<int> := tagged(p.m) + i32_const(declared_tag(cases_of(record_named(p.records, enum) ?? raise("${type_text(enum)} is no enum"))#1, p)) + I32_SUB + I64_EXTEND_I32_U
# the code of a primitive: its arguments, then its instruction or a call of its helper, giving the value its
# built-in's definition writes
primitive_code(form: Node, operation: Node, arguments: list<Code>, p: Emission) as Code := {
	name = text(operation)
	operands = arguments.flat_map(argument => argument.instructions)
	# the value the operands and these instructions after them give
	ending = instructions => Code(typed_layout(form, p), operands + instructions)
	if name == MISSING_TEST { return ending(p.m.strategy.missing_tested) }
	if name == HANDLE_TEST { return ending(if p.m.strategy.exact_ints then beneath([]) else DROP + i32_const(0)) }
	if HELPERS.has(name) { return helper_called(form, operands, name, HELPERS[name], p) }
	if name == BOXED_TEST { return boxed_test(form, operands, fact_type(fact_of(form, TESTED)) ?? refused(form, "this test reached the emitter without the type it tests"), p) }
	if name == BOXED_VALUE { return ending(box_made(plain_word(boxed_operand(form)), p)) }
	if name == CHECKED_CAST { return finished(ending(cast_called(typed_layout(form, p), type_text(type_of(form)), form, p))) }
	if name == OPTIONAL_VALUE { return ending(optional_value(form, p)) }
	if name == SHOWN_VALUE or name == READ_AS_IS { return arguments#1 }
	if name == CASE_NUMBER { return ending(case_numbered(first_operand_type(form), p)) }
	if name == TAG_EQUAL { return ending(type_equality(first_operand_type(form), p)) }
	if name == LIST_COUNT { return ending(counted_items(p)) }
	if MAP_FIELDS.has(name) { return ending(instruction(STRUCT_GET, [map_struct(first_operand_type(form), p), MAP_FIELDS[name]])) }
	if TYPED_HELPERS.has(name) { return finished(ending(typed_helper_called(name, first_operand_type(form), p))) }
	# a 32-bit word given where its definition writes an int is extended, as wasm_called extends it
	if p.m.strategy.exact_ints and is_carried(form, name) { return finished(ending(if name == NARROWED_ROW then plain_checked(p) + PRIMITIVES[name].code + (if typed_layout(form, p) == I64 then I64_EXTEND_I32_U else []) else helper_call(p, "carried ${name}", q => carried_function(name, q)))) }
	if PRIMITIVES.has(name) { return wasm_called(form, arguments, host_performed(name, p), p) }
	if name == ITEM_LOAD { return wasm_called(form, arguments, item_loaded(typed_layout(form, p)), p) }
	if name == ITEM_STORE { return wasm_called(form, arguments, item_stored(arguments#2.type), p) }
	if name == MEMORY_TAKEN { return wasm_called(form, arguments, WasmOperation([I32], [I32], helper_call(p, MEMORY_TAKEN, memory_taking_function)), p) }
	if name == ITEM_BYTES { return ending(DROP + i64_const(layout_bytes(item_layout(first_operand_type(form), p)))) }
	operations = text_operations(p)
	if operations.has(name) { return wasm_called(form, arguments, operations[name], p) }
	refused(form, "no primitive of this name")
}
# A row on ints (kernel/scalars.wap), never a row on words or one compiling showed gives a scalar
# (core/analyze/types.wap row_placed): run by a helper of the module
is_carried(form: Prim, name: text) as bool := (CARRIED_ROWS.has(name) or name in ORDER_ROWS or name == NARROWED_ROW) and type_text(first_operand_type(form)) == INT_TYPE and (fact_of(form, TYPE) == ø or type_text(type_of(form)) != SCALAR_WORD)
# The helper running a row on ints: the row's instruction where its operands and its value are scalars, else the
# types library's carried function, exact (types/whole.wap); an order compares the carried order with 0
carried_function(name: text, p: Emission) as int := {
	row = PRIMITIVES[name].code
	operands = local_get(0) + local_get(1)
	away = beneath(local_get(0)) + beneath(local_get(1)) + I32_OR
	if name in ORDER_ROWS { return added_function(p.m, [I64, I64], [I32], [], away + if_block(operands + runtime_call(p, "${CARRIED_ORDER}(int, int)") + i64_const(0) + row + RETURN) + operands + row) }
	carried = if_block(operands + runtime_call(p, "${CARRIED_ROWS[name]}(int, int)") + RETURN)
	value = local_get(2)
	added_function(p.m, [I64, I64], [I64], [I64], away + operands_unfit(name) + I32_OR + carried + operands + row + local_set(2) + beneath(value) + value_unfit(name) + I32_OR + carried + value)
}
# an int on the stack where the machine takes a plain word, refused past the scalars
plain_checked(p: Emission) as list<int> := helper_call(p, "plain int", q => added_function(q.m, [I64], [I64], [], beneath(local_get(0)) + if_block(local_get(0) + runtime_call(q, "${CARRIED_NARROWING}(int)") + DROP + UNREACHABLE) + local_get(0)))
# an int literal below the scalars (values.wap is_banded): its word, widened to its handle
banded_code(n: Node, p: Emission) as Code := match n { Number(value) => Code(I64, i64_const(value) + runtime_call(p, WIDENING)); _ => refused(n, "this is no int literal") }
# whether a word is a handle, below the scalars
beneath(word: list<int>) as list<int> := word + i64_const(SMALLEST_SCALAR) + PRIMITIVES["i64.lt_s"].code
# whether a row may leave 64 bits before it runs: a product of an operand past 31 bits, a shift by the word's bits or more
operands_unfit(name: text) as list<int> := match name {
	"i64.mul" => past_factors(local_get(0)) + past_factors(local_get(1)) + I32_OR
	"i64.shl" => local_get(1) + i64_const(WORD_BITS) + I64_LT_U + I32_EQZ
	_ => i32_const(0)
}
past_factors(word: list<int>) as list<int> := word + i64_const(FACTOR_OFFSET) + I64_ADD + i64_const(FACTOR_RANGE) + I64_LT_U + I32_EQZ
# whether the row's value, local 2, left 64 bits: a sum or a difference of a sign neither operand explains, a shift
# that does not shift back
value_unfit(name: text) as list<int> := {
	signs = (left: list<int>, right: list<int>) => left + PRIMITIVES["i64.xor"].code + right + PRIMITIVES["i64.xor"].code + PRIMITIVES["i64.and"].code + i64_const(0) + PRIMITIVES["i64.lt_s"].code
	match name {
		"i64.add" => signs(local_get(0) + local_get(2), local_get(1) + local_get(2))
		"i64.sub" => signs(local_get(0) + local_get(1), local_get(0) + local_get(2))
		"i64.shl" => local_get(2) + local_get(1) + PRIMITIVES["i64.shr_s"].code + local_get(0) + PRIMITIVES["i64.ne"].code
		_ => i32_const(0)
	}
}
# a host operation's row, an imported function's with the call of its import
host_performed(name: text, p: Emission) as WasmOperation := {
	row = PRIMITIVES[name]
	if is_imported(row) then WasmOperation(row.takes, row.gives, instruction(CALL, [host(p, name)])) else row
}
# the plain value a box holds
boxed_operand(form: Prim) as Node := match form { Prim(operation, given) => given#1 }
first_operand_type(form: Prim) as Term := match form { Prim(operation, given) => if given is empty then refused(form, "this primitive takes an operand") else type_of(given#1) }
# an optional's value, x known to be there: a plain value taken out of its box, a reference made non-null, a value
# of no optional's type (a condition found it present) itself; a missing one traps. A value any or a number holds,
# known of its type, is cast to it first.
# an any's value as an any, `x!` of an any (an any? is an any), is the any itself, missing raising. A class's value a
# test found of an extension is cast to it
optional_value(form: Node, p: Emission) as list<int> := if layout_of(first_operand_type(form), p.m, p.records) == ANYREF then (if typed_layout(form, p) == ANYREF then REF_AS_NON_NULL else held_value(type_of(form), form, p)) else (if base_of_optional(first_operand_type(form)) == ø then [] else present(p) + (if type_text(type_of(form)) in BOXED_WORDS then box_opened(plain_word(form), p) else [])) + cast_down(layout_of(first_operand_type(form), p.m, p.records) ?? [], typed_layout(form, p), p)
# a reference to a struct cast to one of its subtypes' references, nothing for any other two types
cast_down(given: list<int>, wanted: list<int>, p: Emission) as list<int> := if is_reference(given) and supertype_passes(wanted, given, p.m) then REF_CAST_NULL + heap_of(wanted) else []
# a plain value of a type word, `int`, put in its box, and the value a box on the stack holds
box_made(word: text, p: Emission) as list<int> := struct_made(() => [WORD_LAYOUTS[word]], () => box_index(p.m, word), p)
box_opened(word: text, p: Emission) as list<int> := (p.m.strategy.box_opened)(word, p)
# an optional on the stack known to be there, trapping where it is ø: GC's non-null reference, or in the memory its
# address, which a helper tests
present(p: Emission) as list<int> := (p.m.strategy.present)(p)
# the primitive testing an optional for its ø (types/prelude.wap missing)
MISSING_TEST = "ref.is_null"
# the code of a primitive its helper function performs
helper_called(form: Node, operands: list<int>, key: text, build: (Emission) -> int, p: Emission) as Code := finished(Code(typed_layout(form, p), operands + helper_call(p, key, build)))
# the wasm type of the value a primitive gives, [] when its definition writes none, NEVER when it never finishes
# a test of an any for a type: for each type whose values pass it (type_notation.wap passing_types), a char's for a
# text, an int's or a float's for a number, its test, any of them passing
boxed_test(form: Node, operands: list<int>, type: Term, p: Emission) as Code := {
	types = passing_types(type)
	if #types == 1 { return Code(typed_layout(form, p), operands + type_tested(type, form, p)) }
	helper_called(form, operands, "is ${type_text(type, yes)}", q => passing_test_function(types, form, q), p)
}
# the test of the any on the stack for one type: a class's by its struct and tag, any other's by its struct or box
type_tested(type: Term, at: Node, p: Emission) as list<int> := {
	record = record_named(p.records, type)
	if record != ø and cases_of(record!) is empty then helper_call(p, "is ${place_key(record_declared(record!))}", q => class_test_function(record!, q)) else heap_instruction(REF_TEST, held_in_any(type, at, p).type_index)
}
# the test of an any for any of these types, its local 0 the value
passing_test_function(types: list<Term>, at: Node, p: Emission) as int := added_function(p.m, [ANYREF], [I32], [], types.flat_map(each => local_get(0) + type_tested(each, at, p)) + types.drop(1).flat_map(each => I32_OR))
# the test of an any for a class: its struct, then its tag, the class's or one of a class extending it. Its locals: 0
# the value, 1 its tag
class_test_function(record: Record, p: Emission) as int := {
	type = struct_of(record, p.m, p.records)
	tags = kin(record, p.records).map(class_tag)
	tag_is = tags.flat_map(tag => local_get(1) + i32_const(tag) + I32_EQ) + tags.drop(1).flat_map(tag => I32_OR)
	added_function(p.m, [ANYREF], [I32], [I32], local_get(0) + heap_instruction(REF_TEST, type) + IF + I32 + local_get(0) + heap_instruction(REF_CAST_NULL, type) + tagged(p.m) + local_set(1) + tag_is + ELSE + i32_const(0) + END)
}
# a class and the classes extending it, at any depth
kin(record: Record, records: Records) as list<Record> := [record] + records.items.filter(each => class_extended(each) != ø and record_named(records, type_term(class_extended(each)!)) == record).flat_map(each => kin(each, records))
# the helper function of an operation, added by `build` the first time
helper(p: Emission, operation: text, build: (Emission) -> int) as int := {
	if p.helpers.has(operation) { return p.helpers[operation] }
	index = build(p)
	p.helpers[operation] = index
	named_function(p.m, index, operation)
	index
}
# a call of the helper function of an operation
helper_call(p: Emission, operation: text, build: (Emission) -> int) as list<int> := instruction(CALL, [helper(p, operation, build)])
# a call of one of the types library's functions the emitter calls itself (kernel/primitives.wap RUNTIME_WORDS)
runtime_call(p: Emission, word: text) as list<int> := instruction(CALL, [p.helpers.get(word) ?? refused(Text(word), "the types library defines no such function")])

# the body run for each count from 0 while it stays below the limit, the count in that local
counted(local: int, limit: list<int>, body: list<int>) as list<int> := {
	count = local_get(local)
	i32_const(0) + local_set(local) + looped(count + limit + I32_GE_U + instruction(BRANCH_IF, [1]) + body + count + i32_const(1) + I32_ADD + local_set(local) + instruction(BRANCH, [0]))
}

# a slice's new array of an array type in local 3: `count` (local 2) items copied from the array `source` gives, from
# the place `from` (local 1), both ints
slice_copied(array: int, source: list<int>) as list<int> := int_local(2) + instruction(ARRAY_NEW_DEFAULT, [array]) + local_set(3) + local_get(3) + i32_const(0) + source + int_local(1) + int_local(2) + instruction(ARRAY_COPY, [array, array])
# an int local as an i32
int_local(slot: int) as list<int> := local_get(slot) + I32_WRAP_I64
# The helper giving a case's name by its tag, among the cases of every enum the program declares (patterns.wap
# tag_of). Its local: 0 the case.
case_naming_function(p: Emission) as int := {
	cases = p.records.items.flat_map(cases_of)
	named = (1 to #cases).flat_map(at => local_get(0) + tagged(p.m) + i32_const(at - 1) + I32_EQ + if_block(text_literal(text(case_name(cases#at)), p.m).instructions + RETURN))
	added_function(p.m, [enum_layout(p.m)], [text_layout(p.m)], [], named + UNREACHABLE)
}
