# How a build lays out its values and emits them where builds differ, chosen once for a module (emitter.wap
# emitted): the GC build's, core's own, or one an extension gives, a native build's keeping texts, lists and enums in
# the memory (extensions/native/memory.wap). Beside the code of each place: the words a list's literal is built by, by
# "list", each value's layout by its type word, and the library files it reads in others' places, by their paths in
# the wap folder.
use folder
use "../../kernel/opcodes.wap"

class Strategy {
	built_by: map<text, list<text>> = {}
	layouts: map<text, list<int>> = {}
	files: map<text, text> = {}
	# whether a module exports its protocol words' dispatchers, as the GC build's modules call each other's
	dispatchers_exported: bool = yes
	# an optional's ø, the test of one on the stack for it, and what a value of a signature captures
	missing: Code
	missing_tested: list<int>
	captures_layout: list<int>
	# a compound type's layout, and a layout as the build keeps it, ø where it has none
	compound_layout: (Term, Node?, WasmModule, Records) -> list<int>?
	kept: (Term, Node?, list<int>?) -> list<int>?
	# a text as a constant expression, and as code
	fixed_text: (text, WasmModule) -> Code
	text_literal: (text, WasmModule) -> Code
	# the place of a field, from 1, of a struct of these layouts at the address reached; GC's by its struct and index
	field: (list<int>, () -> list<list<int>>, int, () -> list<int>) -> Place
	# a new struct of its fields' values on the stack, GC's of the struct given; the code before a record's fields
	struct_made: (() -> list<list<int>>, () -> int, Emission) -> list<int>
	tagged: (int) -> list<int>
	# a function value's captures as its function takes them, a box's value, an optional known present, an uncaught raise
	captures_cast: (Term, Node, Emission) -> list<int>
	box_opened: (text, Emission) -> list<int>
	present: (Emission) -> list<int>
	raised: (Emission) -> list<int>
}
GC_STRATEGY = Strategy{missing: Code(ANYREF, null_of(ANY_HEAP)), missing_tested: REF_IS_NULL, captures_layout: ANYREF, compound_layout: gc_compound_layout, kept: (type, at, layout) => layout, fixed_text: gc_fixed_text, text_literal: gc_text_literal, field: gc_field, struct_made: (layouts, gc, p) => instruction(STRUCT_NEW, [gc()]), tagged: tag => i32_const(tag), captures_cast: (own, form, p) => heap_instruction(REF_CAST_NULL, closure_of_type(own, form, p)), box_opened: (word, p) => instruction(STRUCT_GET, [box_index(p.m, word), 0]), present: p => REF_AS_NON_NULL, raised: p => local_get(0) + instruction(THROW, [raised_tag(p)])}
# a GC struct's field: read and written by its struct and index
gc_field(reached: list<int>, layouts: () -> list<list<int>>, at: int, gc: () -> list<int>) as Place := {
	where = gc()
	Place(reached, instruction(STRUCT_GET, where), instruction(STRUCT_SET, where))
}
