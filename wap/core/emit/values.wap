# The value layout (notes/self_hosting.md "Value layout"): which wasm type holds which kind of warp value.
#
# Input: a literal of the kernel (Number, Char, Text, True, False, Empty) or a type's name; output: the instructions that leave its
# value on the stack, and that value's wasm type. Values stay plain where their kind is known: an int an i64, a float
# an f64, yes/no and a character an i32, a text a GC array of its UTF-8 bytes, ø a null reference. Boxing into a
# $Node, where a kind is known only at run time, joins with the first form that needs it.

# DEBT: its constants are read at the top of the files beside it, so it names its uses: `use folder` would run those
#   first. Paid off when top-level statements run in the order their values need, or constants are read lazily.
use "wasm.wap"
use "../../kernel/opcodes.wap"
use "../../kernel/primitives.wap"
use "../stage.wap"
use "../type_notation.wap"
use "../errors.wap"

# Code that leaves one value of `type` on the stack; a form that leaves none has the type []
class Code {
	type: list<int> = []
	instructions: list<int> = []
}

# the bytes a value of a layout takes in the memory, a list's item at its type's width (wap/types/memory_lists.wap)
layout_bytes(layout: list<int>) as int := if layout in [I32, F32] then 4 else 8
# a case's tag, the first field of an enum's struct: its place among the cases, from 0
TAG_FIELD = field_type(I32, IMMUTABLE)
# a class tag's hash: its base and the largest i32 prime, so every tag is a positive i32
TAG_BASE = 31
TAG_RANGE = 2147483647

# the GC type of a text: its UTF-8 bytes
text_type(m: WasmModule) as int := added_type(m, array_type(field_type(I8, MUTABLE)))
# the wasm type of a text's value: a reference to its bytes, null where it is missing; or the address of its bytes in
# the memory
text_layout(m: WasmModule) as list<int> := memory_layout(m, TEXT_TYPE) ?? nullable(text_type(m))
# the layout of a type word's values in the memory, ø where they are GC values
memory_layout(m: WasmModule, word: text) as list<int>? := if m.memory == ø then ø else m.memory!.layouts.get(word)

# the code of a literal, or ø for a node that is none
literal(n: Node, m: WasmModule) as Code? := match n {
	Text(value) => text_literal(value, m)
	_ => constant(n, m)
}
# a literal's code where it is a constant expression, which a global may start with: all but a text's
constant(n: Node, m: WasmModule) as Code? := match n {
	Number(value) => if not value is int then Code(F64, f64_const(value)) else if fact_of(n, TYPE) != ø and WORD_LAYOUTS.get(type_text(type_of(n))) == I32 then Code(I32, i32_const(value)) else Code(I64, i64_const(value))
	Char(value) => Code(I32, i32_const(ord(value)))
	True => Code(I32, i32_const(1))
	False => Code(I32, i32_const(0))
	Empty => missing_value(m)
	_ => ø
}

# the wasm type of a declared type, `int` in `x: int`, or ø for one without a layout yet; a record's among these
# records (core/stage.wap record_named)
# a shape, `Record`, laid out as the type it narrows (core/analyze/shapes.wap); a list or a class's instance in the
# memory its address
layout_of(type_name: Term, m: WasmModule, records: Records, at: Node? = ø) as list<int>? := memory_layout(m, type_word(type_name)) ?? memory_kept(type_name, at, m, if (is_word(type_name) or WORD_LAYOUTS.has(type_word(type_name))) and function_value_key(type_name) == ø then word_layout(narrowed_type(type_name) ?? subtype_base(type_name, records) ?? type_name, m, records) else compound_layout(type_name, at, m, records))
word_layout(type: Term, m: WasmModule, records: Records) as list<int>? := {
	name = type_text(type)
	record = record_named(records, type)
	if WORD_LAYOUTS.has(type_word(type)) then WORD_LAYOUTS[type_word(type)] else if name == TEXT_TYPE then text_layout(m) else if name == LIST_TYPE then nullable(list_base(m)) else if name == MAP_TYPE then nullable(map_base(m)) else if name == ENUM_TYPE then enum_layout(m) else if record == ø then ø else if plain_enums(m) and cases_of(record!).all(case => case_fields(case) is empty) then I32 else nullable(struct_of(record, m, records))
}
# a compound type the memory lays out none of is refused whole, before its parts, which have no place of their own;
# a function value in the memory is the address of what it captures, or of its function's table slot beside them;
# an optional the address of its value or of the box holding it, 0 its ø
compound_layout(type: Term, at: Node?, m: WasmModule, records: Records) as list<int>? := if m.memory != ø then (if function_value_parts(type) != ø or function_parts(type) != ø or base_of_optional(type) != ø then I32 else memory_refused(type, at)) else {
	index = list_index(type, m, records) ?? function_value_index(type, m, records) ?? signature_value_index(type, m, records) ?? map_index(type, m, records)
	if index == ø then optional_layout(type, m, records) else nullable(index)
}
# a layout as a build keeping its values in the memory takes it: a number's; any other is refused, as its wasm2c takes no GC type
memory_kept(type: Term, at: Node?, m: WasmModule, layout: list<int>?) as list<int>? := if m.memory == ø or layout == ø or layout in PLAIN_VALUES then layout else memory_refused(type, at)
memory_refused(type: Term, at: Node?) as list<int> := {
	why = "a build keeping values in the memory has no layout for ${type_text(type)}"
	if at != ø { refused(at!, why) }
	raise why
}

# The GC type of a map, `map<text, int>`: a struct of three lists, its keys and its values of one count and its slots (lists.wap); ø
# for a type that is no map. Every map's type extends the map base, so `x is map` tests any map at once
map_index(type: Term, m: WasmModule, records: Records) as int? := if key_type(type) == ø then ø else added_type(m, open_type([map_base(m)], struct_type(map_parts(type).map(part => field_type(nullable(items_list(part, m, records) ?? refused_type(part, "the emitter has no value layout for this type yet")), MUTABLE)))))
map_base(m: WasmModule) as int := type_kept(m, MAP_TYPE, () => added_type(m, open_type([], struct_type([]))))
# a map type's parts, each held as a list: its keys (field 0), its values (field 1) and its slots (field 2), the places
# of its keys by their hash (types/maps.wap key_place)
map_parts(type: Term) as list<Term> := [key_type(type), held_type(type)].map(part => part ?? refused_type(type, "a map type names its key and value types, `map<text, int>`")) + [word_term(SLOT_TYPE)]
MAP_KEYS = 0
MAP_VALUES = 1
MAP_SLOTS = 2
SLOT_TYPE = "int"

# The wasm type of an optional, `T?`, ø its null: a reference type's own layout; a plain value's (int, float, bool,
# char) a reference to its box, a struct of the value. ø for a type that is no optional.
optional_layout(type: Term, m: WasmModule, records: Records) as list<int>? := {
	base = base_of_optional(type)
	if base == ø { return ø }
	held = known_layout(base, m, records)
	if held in PLAIN_VALUES then nullable(box_index(m, type_text(base))) else held
}
# an optional's ø: GC's null, or the memory's address 0
missing_value(m: WasmModule) as Code := if m.memory != ø then Code(I32, i32_const(0)) else Code(ANYREF, null_of(ANY_HEAP))
# the test of an optional on the stack for its ø
missing_tested(m: WasmModule) as list<int> := if m.memory != ø then I32_EQZ else REF_IS_NULL
# The box of a plain value of a type, `int`: a struct of the value, one type for each type word, so a value in an `any`
# is told apart by its box at run time
box_index(m: WasmModule, word: text) as int := plain_typed(m, word, layout => struct_type([field_type(layout, IMMUTABLE)]))
# A type made of a plain value's layout, one for each type word: the types of all the words are declared together in
# one recursion group, which keeps a yes/no's apart from a character's though both hold an i32, and keeps them apart
# from any other type of their shape
plain_typed(m: WasmModule, word: text, made: function) as int := added_group(m, BOXED_WORDS.map(each => made(WORD_LAYOUTS[each]))) + index_where(BOXED_WORDS, each => each == word) - 1
# the type the typing stage gave a node, which every node reaching the emitter has
type_of(n: Node) as Term := fact_type(fact_of(n, TYPE)) ?? refused(n, "this reached the emitter untyped")
# the type word of a plain value, from the type the typing stage gave its form
plain_word(form: Node) as text := {
	type = type_of(form)
	if is_word(type) and type_text(type) in BOXED_WORDS then type_text(type) else refused(form, "this plain value reached the emitter without its type")
}

# The GC type of a function value: a struct of what it captures, in the order its type writes them; ø for a type that
# is none. Its function is the one its type names, called directly.
function_value_index(type: Term, m: WasmModule, records: Records) as int? := {
	parts = function_value_parts(type)
	if parts == ø then ø else added_type(m, open_type([function_base(m)], struct_type(parts!.map(capture => field_type(known_layout(capture, m, records), IMMUTABLE)))))
}

# The GC type of a function value of a signature, `(int) -> int`, chosen at run time: a struct of a reference to its
# function and what it captures, ø for a type that is no signature. Every function of one signature has one wasm type,
# its captures first as an anyref, then its parameters, giving its result.
VALUE_FUNCTION_AT = 0
VALUE_CAPTURES_AT = 1
signature_value_index(type: Term, m: WasmModule, records: Records) as int? := {
	parts = function_parts(type)
	if parts == ø then ø else signature_struct(m)
}
# a value of a signature, of any one: the reference to its function beside what it captures
signature_struct(m: WasmModule) as int := function_base(m) + 1
# the type every function value's extends, so a test of an any tells a function value: declared in one recursion group
# with a signature value's, which extends it, so it is no other empty struct (map_base); made once, kept by a name no
# record's place key is, its group's types at #m.types in order (added_group), the signature value's next to it
function_base(m: WasmModule) as int := type_kept(m, FUNCTION_WORD, () => added_group(m, [open_type([], struct_type([])), open_type([#m.types], struct_type([field_type(I32, IMMUTABLE), field_type(ANYREF, IMMUTABLE)]))]))
# the function a value of a signature refers to: what it captures, then the signature's parameters
signature_function_index(parts: FunctionType, m: WasmModule, records: Records) as int := added_type(m, function_type([captures_layout(m)] + signature_parameters(parts, m, records), signature_results(parts, m, records)))
# what a value of a signature captures: any struct, or in the memory its address
captures_layout(m: WasmModule) as list<int> := if m.memory != ø then I32 else ANYREF
signature_parameters(parts: FunctionType, m: WasmModule, records: Records) as list<list<int>> := parts.parameters.map(parameter => known_layout(parameter, m, records))
signature_results(parts: FunctionType, m: WasmModule, records: Records) as list<list<int>> := if parts.result == EMPTY_TERM then [] else [known_layout(parts.result, m, records)]
# a type's layout, refused when the emitter has none for it yet
known_layout(type: Term, m: WasmModule, records: Records, at: Node? = ø) as list<int> := layout_of(type, m, records, at) ?? no_layout(type, at)
# the refusal of a type the emitter cannot lay out yet, at the code that has it
no_layout(type: Term?, at: Node?) as list<int> := {
	why = "the emitter has no value layout for the type ${type_text(type)} yet"
	if at != ø { refused(at!, why) }
	raise why
}

# The GC type of a list, `list<int>`: a struct of its count and an array of its items, the array's places past the
# count spare (lists.wap); ø for a type that is no list. Every list's type extends the list base, its count alone, so
# `#` of any list reads it.
list_index(type: Term, m: WasmModule, records: Records) as int? := items_list(item_type(type) ?? return ø, m, records)
# the list of items of a type, its base built before its items: items of a record being built open a recursion group,
# and a type that refers to none of its records stays out of it
items_list(item: Term, m: WasmModule, records: Records) as int? := {
	base = list_base(m)
	added_type(m, open_type([base], struct_type([LIST_COUNT_FIELD, field_type(nullable(item_array(item, m, records) ?? return ø), MUTABLE)])))
}
list_base(m: WasmModule) as int := type_kept(m, LIST_TYPE, () => added_type(m, open_type([], struct_type([LIST_COUNT_FIELD]))))
LIST_COUNT_FIELD = field_type(I32, MUTABLE)
LIST_COUNT_AT = 0
LIST_ITEMS_AT = 1
# the GC array of a list's items, ø for a type that is no list
items_index(type: Term, m: WasmModule, records: Records) as int? := item_array(item_type(type) ?? return ø, m, records)
# a plain value's array is its type word's own (plain_typed), so a list<bool> held as an any is told from a list<char>
item_array(item: Term, m: WasmModule, records: Records) as int? := {
	array = layout => array_type(field_type(layout, MUTABLE))
	if type_text(item) in BOXED_WORDS then plain_typed(m, type_text(item), array) else added_type(m, array(layout_of(item, m, records) ?? return ø))
}
# The GC type of a record: its tag first, then a struct of its fields' layouts, in the order the class writes them.
# An enum's is open to its cases, a case with fields extending it with them; a class is as an enum of one case, its
# tag its name's (class_tag), so two classes of one shape stay apart, in every module. Records that refer to each
# other are one recursion group. The base, the enum base or the struct of the class it extends, is built before the
# record's own index is asked for, and the fields whose types name no record before the other fields, whose types may
# reserve the record's index: a supertype comes before its subtypes, and the group holds only the
# types that refer to its records, so a text or a list<int> is the same type in every module.
struct_of(record: Record, m: WasmModule, records: Records) as int := {
	extended = class_extended(record)
	below = declared_base(record_term(record), records)
	if below != ø and not records.reads.any(read => same(read.given, record_term(record)) and same(read.read, below!)) { refused(record_declared(record), "${record_name(record)} has fields, so it is seen as ${type_text(below!)} only through its read: declare @read ${type_word(below!)}(x: ${record_name(record)}): ${type_text(below!)}") }
	base = if extended == ø or below != ø then enum_base(m) else struct_of(record_named(records, type_term(extended!)) ?? refused(extended!, "a class extends a class the program declares"), m, records)
	key = place_key(record_declared(record))
	built = named_index(m, key)
	if built != ø { return built }
	for field in fields_of(record).filter(field => not names_record(field_declared(field), records)) { known_layout(field_declared(field), m, records) }
	at = named_added(m, key, open_type([base], struct_type([TAG_FIELD] + field_layouts(fields_of(record), m, records))))
	if extended != ø { m.supertypes[at] = base }
	at
}
# whether a type is a record or has one among its parts, `list<Tree>`
names_record(type: Term?, records: Records) as bool := record_named(records, type) != ø or (type_parts(type) ?? []).any(part => names_record(part, records))
# a class's tag, its name's hash: the same in every module declaring the class
class_tag(record: Record) as int := text(record_declared(record)).bytes.fold(0, (hash, byte) => (hash * TAG_BASE + byte) % TAG_RANGE)
# the GC type every enum's extends: its case's tag, which the instructions of `tagged` read. In the memory (a native
# build) a case of no fields is its tag alone, an i32, as a class's instance is its address
enum_base(m: WasmModule) as int := type_kept(m, ENUM_TYPE, () => added_type(m, open_type([], struct_type([TAG_FIELD]))))
enum_layout(m: WasmModule) as list<int> := memory_layout(m, ENUM_TYPE) ?? nullable(enum_base(m))
# whether an enum's case of no fields is its tag alone
plain_enums(m: WasmModule) as bool := memory_layout(m, ENUM_TYPE) != ø
tagged(m: WasmModule) as list<int> := if plain_enums(m) then [] else instruction(STRUCT_GET, [enum_base(m), 0])
# the field `at` of a case's own fields, after its record's, of the value on the stack cast to the case's struct
case_field_read(cast: int, record: Record, at: int) as list<int> := heap_instruction(REF_CAST_NULL, cast) + instruction(STRUCT_GET, [cast, at + #fields_of(record)])
field_declared(field: Node) as Term := written_type(declared_type(field)) ?? refused(field, "a field is written name: type")
field_layouts(fields: list<Node>, m: WasmModule, records: Records) as list<list<int>> := fields.map(field => field_type(known_layout(field_declared(field), m, records), MUTABLE))
case_struct_of(record: Record, case: Node, m: WasmModule, records: Records) as int := {
	base = struct_of(record, m, records)
	fields = field_layouts(fields_of(record) + case_fields(case), m, records)
	added_type(m, open_type([base], struct_type([TAG_FIELD] + fields)))
}

# a text's bytes kept in a passive segment, copied into a new array where the program meets it
# a text literal as a constant expression, its bytes given one by one, ø for any other node
fixed_text(n: Node, m: WasmModule) as Code? := match n { Text(t) => if m.memory != ø then memory_text(t, m) else Code(text_layout(m), t.bytes.flat_map(b => i32_const(b)) + instruction(ARRAY_NEW_FIXED, [text_type(m), byte_count(t)])); _ => ø }
text_literal(t: text, m: WasmModule) as Code := {
	if m.memory != ø { return memory_text(t, m) }
	type = text_type(m)
	Code(nullable(type), i32_const(0) + i32_const(byte_count(t)) + instruction(ARRAY_NEW_DATA, [type, added_text(m, t.bytes)]))
}
# a text in the module's data, its address: its bytes as the memory lays a text out
memory_text(t: text, m: WasmModule) as Code := Code(I32, i32_const(data_placed(m, (m.memory!.text_bytes)(t))))
