# Refusals: a form wap does not take, reported where the program wrote it (the stages: wap/compiler.wap).
#
# Every stage refuses through here, never with a bare `raise`, so every message has the same shape and points at the
# user's code, whichever stage found it. Kernel forms carry the position of the code they were
# lowered from (core/stage.wap):
#
#   hello.wap line 2:1: the emitter takes no call but print of a text yet: print 3
#
# Later: the readings a phrase allows, a fix-it, and the rule that expanded the form.

use "stage.wap"

# what a compiler-made form of one shape is, said when another reaches the place that takes it
NOT_A_FIELD = "a field is written name: value"
NOT_AN_ENTRY = "a map's entry is written key: value"
# how much of the refused code a message quotes: its place says where the rest is, a whole definition is a wall
QUOTED_LENGTH = 80
QUOTE_CUT = " …"

refused(code: Node, why: text) := raise warning_of(code, why)
# code that calls a function wap refuses; one of the library, whose own refusal no one sees, repeats the first reason
# of the chain with its place, so the user's own line says why
FIRST_REASON = "; first: "
calling_refused(code: Node, called: text, first: text, library: bool) := refused(code, "this calls ${called}, which wap refuses" + (if library then FIRST_REASON + first else ""))
# a message about code, as a refusal or a warning says it
warning_of(code: Node, why: text) as text := place_of(code) + why + ": " + quoted(code)

# the text of each file the reader read, as its reader gave it (core/pipeline.wap source_of): what a message quotes
sources_read: map<text, text> = {}
# the refused code as written, the line of the program it stands on, cut to its head when it is longer than a line of a
# message; code the reader read from no file shows as the compiler holds it
quoted(code: Node) as text := {
	shown = written_line(code) ?? "${code}".replace("\n", " ")
	if #shown > QUOTED_LENGTH then shown[0 .. QUOTED_LENGTH] + QUOTE_CUT else shown
}

written_line(code: Node) as text? := {
	at = position_of(code) ?? return ø
	source = sources_read.get(file_of(code) ?? return ø) ?? return ø
	source.split("\n")#(at.line).trim()
}
# `hello.wap line 2:1: `, `line 2:1: ` for code no file holds or read from standard input, or nothing for code without
# a position
place_of(code: Node) as text := {
	at = position_of(code) ?? return ""
	file = file_of(code) ?? STANDARD_INPUT_FILE
	(if file == STANDARD_INPUT_FILE then "" else file + " ") + "line ${at.line}:${at.column}: "
}
# the path naming standard input, the program's when code is given there (wap/types/system.wap STANDARD_INPUT_PATH)
# TODO the types module's STANDARD_INPUT_PATH once the seed holds it
STANDARD_INPUT_FILE = "-"
