# Code → canonical warp text, what `wap format` prints (notes/backbone.md "Operators"). Reads notation or operated
# code: each operator Call in its own notation (`(Call + a b)` is `a + b`), brackets only where precedence needs them,
# and a reading that spacing decided spelled out: `[a -1]` prints as `[a, -1]`, `print -x` as `print (-x)`.

use "parse/operators.wap"
use folder
use "../kernel/forms.wap"
use "../types/operators.wap"
use "analyze/calls.wap"
use "parse/operator_table.wap"
use "parse/lexemes.wap"
use "parse/cascade.wap"

# the operator that defines, whose left side is a definition's head
DEFINE_SPELLING = ":="
# how deep the statements being printed are indented, a tab each
format_depth = [0]

formatted(language: Language, n: Node) as text := annotations_text(language, n) + (text_written(n) ?? reading_text(language, n) ?? written(language, n))
# a phrase as typing read it, where the parameter counts decided it: `sin cos 0` prints as `sin(cos(0))`
reading_text(language: Language, n: Node) as text? := written(language, typed_readings.get(reading_key(reading_head(n) ?? return ø)) ?? return ø)
# the word that leads a phrase or a call
reading_head(n: Node) as Node? := match n { Call(called, arguments) => called; List(items, bracket, separator) => if items is empty then ø else items#1; _ => ø }
# the spelling the program wrote, where the reader gave its code another shape or a type alias stands for its type
# (core/stage.wap WRITTEN)
text_written(n: Node) as text? := text_of(fact_of(n, WRITTEN))

written(language: Language, n: Node) as text := match n {
	Call(called, arguments) => call_text(language, n, called, arguments)
	# statements, and a bracket written with its items on lines after it, each line of items as written
	List(items, bracket, separator) => if separator == Separator.Newline then statements_text(language, items, bracket) else if fact_of(n, OWN_LINES) != ø then statements_text(language, rows_of(items, separator), bracket, trim(separator_text(separator))) else list_text(language, items, bracket, separator)
	Key(left, Op.Colon, right) => key_text(language, left) + ": " + formatted(language, right)
	Key(head, Op.None, group) => formatted(language, head) + (if group is Empty then "()" else formatted(language, group))
	# a whole literal past i64 as its digits, never the float beside them
	Number(value) => if digits_of(n) != ø then digits_of(n)! else if value is float and not "${value}".contains(".") and not "${value}".contains("e") then "${value}.0" else "${value}"
	Text(value) => show(value)
	# one character in quotes reads as a Char, `"a"`, and prints as the text it was
	Char(value) => show(text(value))
	Symbol(name) => name
	_ => "${n}"
}

# the `@annotations` the reader found before the code, each with its `@`
annotations_text(language: Language, n: Node) as text := annotations_of(n).map(annotation => "@" + formatted(language, annotation) + " ").join("")

# a definition's head, its result type after the canonical colon: `f(x) as int`, the alias, is `f(x): int`
definition_head_text(language: Language, head: Node) as text := match head {
	Call(called, arguments) => formatted(language, if formatted(language, called) == RESULT_WORD and #arguments == 2 then Key(arguments#1, Op.Colon, arguments#2) else head)
	_ => formatted(language, head)
}
# A key in brackets when it is a phrase or an operator call: `(a b): c`, `(a - b): 2`; `a b: c` would key only b
key_text(language: Language, key: Node) as text := if is_loose(language, key) then "(" + formatted(language, key) + ")" else formatted(language, key)
# code that blanks or an operator hold together, which a `:` beside it would split
is_loose(language: Language, n: Node) as bool := group_written(language, n) != "" and group_written(language, n) != glue_group

# a key before more items of a phrase, written tight, `a:1 b:2`: `a: 1 b: 2` would make `1 b: 2` the value
tight_key_text(language: Language, key: Node, value: Node) as text := key_text(language, key) + ":" + key_text(language, value)

# an operator call in its notation; a call of anything else as `f(a, b)`
call_text(language: Language, call: Node, called: Node, arguments: list) as text := {
	compound = fact_of(call, COMPOUND)
	if compound != ø { return compound_text(language, compound, arguments) }
	if #arguments == 3 and formatted(language, called) == CHOICE { return operand_text(language, arguments#1, call, Side.Left) + " ? " + operand_text(language, arguments#2, call, Side.Left) + " : " + operand_text(language, arguments#3, call, Side.Right) }
	spelling = formatted(language, called)
	if #arguments == 2 and group_of(language, spelling, Fixity.Infix) != "" {
		left = if spelling == DEFINE_SPELLING then definition_head_text(language, arguments#1) else operand_text(language, arguments#1, call, Side.Left)
		gap = if group_of(language, spelling, Fixity.Infix) == glue_group then "" else " "
		# a spelling that is postfix too reads infix by its spacing alone: its left operand bracketed, `(x * 2) ! Pure`
		if group_of(language, spelling, Fixity.Postfix) != "" { left = "(${left})" }
		if two_sided(language, spelling) and (arguments#1 == symbol(OPEN_SIDE) or arguments#2 == symbol(OPEN_SIDE)) { return open_text(language, arguments, call, spelling) }
		return left + gap + spelling + line_gap(call, arguments#2, gap) + operand_text(language, arguments#2, call, Side.Right)
	}
	if #arguments == 1 and group_of(language, spelling, Fixity.Prefix) != "" { return spelling + word_gap(spelling) + operand_text(language, arguments#1, call, Side.Right) }
	if #arguments == 1 and group_of(language, spelling, Fixity.Postfix) != "" { return operand_text(language, arguments#1, call, Side.Left) + word_gap(spelling) + spelling }
	spelling + "(" + arguments.map(argument => formatted(language, argument)).join(", ") + ")"
}

# the gap after an operator: a new line one tab deeper where the program went on with the operand on the next line,
# `a +⏎	b`; a bracket over lines of its own starts on the operator's
line_gap(call: Node, operand: Node, gap: text) as text :=
	if first_line(operand) > (line_of(call) ?? LAST_INT) and not lays_out_lines(operand) then "\n" + "\t" * (format_depth[0] + 1) else gap
# the first line a node's code was written on, LAST_INT where none is known: an operator's call stands at its operator,
# after its left side
first_line(n: Node) as int := ([line_of(n) ?? LAST_INT] + (match n { Call(called, arguments) => arguments; _ => direct_parts(n) }).map(first_line)).min()
lays_out_lines(n: Node) as bool := match n { List(items, bracket, separator) => separator == Separator.Newline or fact_of(n, OWN_LINES) != ø; _ => no }

# an operator read before or after one operand, its open side written as nothing: `2 ..`, `.. 3`; `x = ø` keeps its ø
open_text(language: Language, arguments: list, call: Node, spelling: text) as text :=
	if arguments#1 == symbol(OPEN_SIDE) then spelling + " " + operand_text(language, arguments#2, call, Side.Right) else operand_text(language, arguments#1, call, Side.Left) + " " + spelling

# `x += 1` as written: the assignment x = x + 1 the operator stage read it as, the operator it was written with, its
# right side's right operand
compound_text(language: Language, written: Node, arguments: list) as text := match arguments#2 {
	Call(operator, operands) => formatted(language, arguments#1) + " " + formatted(language, written) + " " + formatted(language, operands#2)
	_ => refused(arguments#2, "a compound assignment gives the call of its operator")
}

enum Side { Left, Right }

# an operand of an operator, in brackets only when it would not be applied first without them: `1 + (2 * 3)` prints
# as `1 + 2 * 3`, `(1 + 2) * 3` keeps its brackets; a parameter list keeps its own, `(int) -> int`, a text with holes its quotes
operand_text(language: Language, operand: Node, call: Node, side: Side) as text := {
	inner = if side == Side.Left and group_written(language, call) == parameters_group or text_written(operand) != ø then operand else ungrouped(operand)
	if needs_brackets(language, inner, call, side) then "(" + formatted(language, inner) + ")" else formatted(language, inner)
}

needs_brackets(language: Language, operand: Node, call: Node, side: Side) as bool := {
	inner = group_written(language, operand)
	outer = group_written(language, call)
	# a key binds looser than every operator, the reader keys before the table applies: `($field: $type)...`; the
	# typed place an assignment sets is no operand, `x: int = 3`
	typed_place = side == Side.Left and outer == compound_assignment_group
	match operand { Key(left, op, right) => if op != Op.None and not typed_place { return yes }; _ => ø }
	if inner == "" { return no }
	# a prefix operator is no operand of what stands before it, `x is not ø`; code ending in one looser than the
	# operator after it is bracketed, else that operator would be read inside it: `(a * not b) + c`
	if side == Side.Right and prefixed(language, operand) { return no }
	ending = open_end(language, operand)
	if side == Side.Left and ending != "" and not binds_tighter(language, ending, outer) { return yes }
	if inner == outer {
		grouping = group_named(language, outer).grouping
		return not (grouping == Grouping.Left and side == Side.Left or grouping == Grouping.Right and side == Side.Right)
	}
	not binds_tighter(language, inner, outer)
}

prefixed(language: Language, n: Node) as bool := match n { Call(called, arguments) => #arguments == 1 and fixity_of(language, formatted(language, called), 1) == Fixity.Prefix; _ => no }
# the group of the prefix operator code's text ends in, its operand running to the end: not's in `a * not b`; "" for none
open_end(language: Language, n: Node) as text := match n {
	Call(called, arguments) => if prefixed(language, n) then group_written(language, n) else if #arguments == 2 and not needs_brackets(language, ungrouped(arguments#2), n, Side.Right) then open_end(language, ungrouped(arguments#2)) else ""
	_ => ""
}
# a word operator stands apart from its operand, `not x`, `x required`; a glyph touches it, `-x`, `x²`
word_gap(spelling: text) as text := if is_word(spelling) then " " else ""

# the precedence group code is written in at its top, "" for an atom or a bracketed list
group_written(language: Language, n: Node) as text := match n {
	Call(called, arguments) => group_of(language, formatted(language, called), fixity_of(language, formatted(language, called), #arguments))
	List(items, Bracket.None, Separator.None) => glue_group
	List(items, Bracket.None, Separator.Space) => juxtaposition_group
	_ => ""
}

fixity_of(language: Language, spelling: text, count: int) as Fixity :=
	if count == 2 then Fixity.Infix else if group_of(language, spelling, Fixity.Prefix) != "" then Fixity.Prefix else Fixity.Postfix

is_word(spelling: text) as bool := is_alpha(spelling#1)

# Items of a space list: one after the first that spacing alone made prefix (`[a -1]`, `print -x`) is spelled out,
# with commas inside brackets, in brackets of its own in a phrase.
list_text(language: Language, items: list, bracket: Bracket, separator: Separator) as text := {
	spaced_sign = separator == Separator.Space and #items[1 ..].filter(item => led_by_sign(language, item)) > 0
	shown = []
	for i in 1 to #items { shown += [phrase_item_text(language, items#i, i == #items, separator == Separator.Space, spaced_sign and bracket == Bracket.None)] }
	if spaced_sign and bracket != Bracket.None { separator = Separator.Comma }
	# braces on one line hold their items apart from them, `{ a: 1 }`; other brackets hold them close, `f(a)`, `[1, 2]`
	pad = if bracket == Bracket.Curly and items is not empty then " " else ""
	opening(bracket) + pad + shown.join(separator_text(separator)) + pad + closing(bracket)
}

# the items of a bracket by the line each was written on, a line of several one row: `[1, 2,⏎ 3]` is rows 1, 2 and 3
rows_of(items: list, separator: Separator) as list<Node> := {
	rows: list<Node> = []
	row: list<Node> = []
	for item in items {
		if row is not empty and line_of(item) != line_of(row#1) { rows.add(phrase_of(row, separator)); row = [] }
		row.add(item)
	}
	rows + [phrase_of(row, separator)]
}

# Statements one per line, each with the comments and blank lines above it, the mark that ends it but the last, and its
# line's comment after it; those of a bracket indented one tab deeper than the bracket
statements_text(language: Language, items: list, bracket: Bracket, mark: text = "") as text := {
	outer = format_depth[0]
	format_depth[0] = if bracket == Bracket.None then outer else outer + 1
	indent = "\t" * format_depth[0]
	lines = (1 to #items).map(at => comment_lines(said(items#at, COMMENT), indent).map(line => line + "\n").join("") + indent + formatted(language, items#at) + (if at < #items then mark else "") + trailing_text(said(items#at, TRAILING), indent))
	format_depth[0] = outer
	if bracket == Bracket.None then lines.join("\n") else opening(bracket) + "\n" + lines.join("\n") + "\n" + "\t" * outer + closing(bracket)
}
# what a statement's atoms say of this kind, the statements of a block inside it left to that block
said(n: Node, fact: text) as list<text> := {
	own = match fact_of(n, fact) { Text(value) => value.split("\n"); _ => [] }
	inner = match n { List(items, bracket, Separator.Newline) => []; Call(called, arguments) => [called] + arguments; _ => if fact_of(n, OWN_LINES) != ø then [] else direct_parts(n) }
	own + inner.flat_map(part => said(part, fact))
}
# comments as lines, each empty one a blank line
comment_lines(lines: list<text>, indent: text) as list<text> := lines.map(line => if line == "" then "" else indent + line)
# a line's own comment after its code, then the comments on lines of their own after it
trailing_text(lines: list<text>, indent: text) as text := if lines is empty then "" else (if lines#1 == "" then "" else " " + lines#1) + comment_lines(lines.drop(1), indent).map(line => "\n" + line).join("")

# an item of a list; in a phrase a key before the last item is tight, a sign-led item bracketed when asked
phrase_item_text(language: Language, n: Node, last: bool, in_phrase: bool, sign_bracketed: bool) as text := {
	if sign_bracketed and led_by_sign(language, n) { return "(" + formatted(language, n) + ")" }
	if in_phrase and not last { match n { Key(left, Op.Colon, right) => return annotations_text(language, n) + tight_key_text(language, left, right); _ => ø } }
	formatted(language, n)
}

# a negative number, or a call of an operator that is prefix and infix alike, applied as prefix
led_by_sign(language: Language, n: Node) as bool := match n {
	Number(value) => value < 0
	Call(called, arguments) => #arguments == 1 and group_of(language, formatted(language, called), Fixity.Infix) != "" and group_of(language, formatted(language, called), Fixity.Prefix) != ""
	_ => no
}

