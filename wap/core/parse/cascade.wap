# Pass 2 of the reader (core/parse/reader.wap): tokens → notation by the separator cascade, the loosest separator
# splitting first, glued runs, keys, typed holes, `@annotations` and duplicate keys warned.

use folder
use "../stage.wap"

# ── pass 2: the separator cascade ───────────────────────────────────────────────────────────────────────────────────

# the whole text: one item, the list of its items, or Empty
built(tokens: list<Lexeme>) as Node := level_node(body_read(tokens, 0).parts)

class Body { parts: list<Lexeme>; at: int }

# the tokens from `at` up to the closing bracket, a bracket's own list made of each inner bracket
body_read(tokens: list<Lexeme>, at: int) as Body := {
	parts: list<Lexeme> = []
	while at < tokens.length and token_at(tokens, at).kind != LexemeKind.Close {
		t = tokens[at]
		if t.kind == LexemeKind.Open {
			inner = body_read(tokens, at + 1)
			parts.add(Lexeme{kind: LexemeKind.Atom, node: bracket_list(inner.parts, t), bracket: t.bracket, separator: Separator.None, glued: t.glued, line: t.line, column: t.column})
			at = inner.at + 1
		} else {
			if t.kind != LexemeKind.Separator or parts.length > 0 { parts.add(t) }
			at += 1
		}
	}
	if parts.length > 0 and last_of(parts).kind == LexemeKind.Separator { parts = parts[0 .. parts.length - 1] }
	Body{parts: parts, at: at}
}

# a bracket's list: its items split by the loosest separator inside; duplicate keys in `{…}` warned of
bracket_list(parts: list<Lexeme>, opener: Lexeme) as Node := {
	items = level_items(parts)
	# `()` is Empty; `[]` and `{}` keep their bracket, an empty list and an empty map (wiki/node.md)
	if items is empty and opener.bracket == Bracket.Round { return Empty }
	separator = if items.length > 1 then loosest_separator(parts) else Separator.None
	written = placed(List(items, opener.bracket, separator), opener.line, opener.column)
	if opener.written != "" { written = with_fact(written, WRITTEN, Text(opener.written)) }
	if opener.indented { written = with_fact(written, INDENTED, True) }
	if opener.indented or parts is not empty and parts[0].line > opener.line { written = with_fact(written, OWN_LINES, True) }
	if opener.bracket == Bracket.Curly then with_duplicates_warned(written, items) else written
}

listed(items: list, bracket: Bracket, separator: Separator) as Node := positioned_like(List(items, bracket, separator), items#1)

# the loosest separator among the parts, Space between two unglued atoms, None for a glued run
loosest_separator(parts: list<Lexeme>) as Separator := {
	found = Separator.None
	for i in 0 ..< parts.length {
		t = parts[i]
		here = if t.kind == LexemeKind.Separator then t.separator else if i > 0 and not t.glued and token_at(parts, i - 1).kind != LexemeKind.Separator then Separator.Space else Separator.None
		if looseness(here) > looseness(found) { found = here }
	}
	found
}

# the items of a level: the parts split by their loosest separator, each piece read one level tighter
level_items(parts: list<Lexeme>) as list<Node> := {
	separator = loosest_separator(parts)
	if separator == Separator.None { return if parts.length == 0 then [] else [glued_run(parts)] }
	if separator == Separator.Space { return phrase_annotated(runs_of(parts)) }
	pieces = pieces_between(parts, separator)
	annotated(pieces.map(piece => level_node(piece)))
}

# a level as one node: Empty, its one item, or the list of its items
level_node(parts: list<Lexeme>) as Node := phrase_of(level_items(parts), loosest_separator(parts))

# the parts between the separators of this kind, the tighter separators kept inside each piece
pieces_between(parts: list<Lexeme>, separator: Separator) as list := {
	pieces: list<list<Lexeme>> = []
	piece: list<Lexeme> = []
	for t in parts {
		if t.kind == LexemeKind.Separator and looseness(t.separator) >= looseness(separator) { pieces.add(piece); piece = [] } else { piece.add(t) }
	}
	pieces.add(piece)
	pieces
}

# the glued runs of a phrase: a new run at each part with a blank before it
runs_of(parts: list<Lexeme>) as list := { // todo use  [Lexeme] as soon as syntax works, EVERYWHERE for all generics (via warp fix ?)
	runs: list<list<Lexeme>> = []
	run: list<Lexeme> = []
	for t in parts {
		if not t.glued and run.length > 0 { runs.add(run); run = [] }
		run.add(t)
	}
	runs.add(run)
	runs
}

# A phrase's items, split at its loosest key (below). A key with blanks around takes all before it as key and all
# after it as value (`a b : c`, `x = a + b`); glued to a run with a blank after, it takes the rest of the phrase as
# value (`a: b c`), unless an operator stands beside it (cut_run). A hole's `:` takes one run, its type: `$c: Node $then: Node` are two typed holes
# (warp's notes/first_principles.md "Holes")
spaced(written: list) as list<Node> := {
	runs = cut_beside_operator(written)
	split = splitting_run(runs)
	if split < 0 { return holes_typed(runs.map(glued_run)) }
	run = runs[split]
	before = runs[0 .. split]
	value = phrase_of(phrase_annotated(runs[split + 1 .. runs.length]), Separator.Space)
	if run.length == 1 then [keyed(phrase_of(spaced(before), Separator.Space), last_of(run).op, value)] else spaced(before) + [keyed(glued_run(run[0 .. run.length - 1]), last_of(run).op, value)]
}
# An operator never takes a key as its operand: a run beside an operator's run has its key cut out to stand between
# blanks, keying the whole phrase before it with the rest: `xs[start - 1: end - 1]`, `xs[0:end - 1]`
operator_run(runs: list, at: int) as bool := at >= 0 and at < runs.length and runs[at].length == 1 and is_operator(token_at(runs[at], 0).node)
cut_beside_operator(runs: list) as list := (0 ..< runs.length).flat_map(at => cut_run(runs, at))
cut_run(runs: list, at: int) as list := {
	run = runs[at]
	key = first_key(run)
	if key < 0 or is_typed_hole(run) or not (operator_run(runs, at - 1) or operator_run(runs, at + 1)) { return [run] }
	[run[0 .. key], [run[key]], run[key + 1 .. run.length]].filter(piece => piece is not empty)
}
# the first key of a run after its first part; -1 for none
first_key(run: list) as int := {
	for key in 1 ..< run.length { if token_at(run, key).kind == LexemeKind.Key { return key } }
	-1
}

# Keys split by looseness: `=` and `:=` before `:`, so `x: int = 3` is (x: int) = 3 and `f(x): int := e` gives
# f(x): int the body e; among keys alike the first splits (typed declarations)
KEY_LOOSENESS = {":": 1, "=": 2, ":=": 2}
key_looseness(op: Op) as int := KEY_LOOSENESS[op as text]

# the run of a phrase at its loosest key, -1 for none: a key between blanks (never the first run), or ending its run
splitting_run(runs: list) as int := {
	found = -1
	for i in 0 ..< runs.length {
		run = runs[i]
		if last_of(run).kind == LexemeKind.Key and (run.length > 1 or i > 0) and not is_typed_hole(run) and (found < 0 or key_looseness(last_of(run).op) > key_looseness(last_of(runs[found]).op)) { found = i }
	}
	found
}

is_hole_word(n: Node) as bool := match n { Symbol(name) => name.starts_with(HOLE_SIGN) and #name > 1; _ => no }
# a run that is a hole and its colon, `$c:`
is_typed_hole(run: list) as bool := run.length == 2 and last_of(run).op == Op.Colon and is_hole_word(token_at(run, 0).node)

# each hole's colon given the item after it as its type
holes_typed(items: list) as list := {
	typed = []
	for item in items { if #typed > 0 and untyped_hole(typed.last) then typed[#typed - 1] = keyed(hole_of(typed.last), Op.Colon, item) else typed.add(item) }
	typed
}
untyped_hole(n: Node) as bool := match n { Key(hole, Op.Colon, Empty) => is_hole_word(hole); _ => no }
hole_of(n: Node) as Node := match n { Key(hole, op, value) => hole; _ => n }

# the items as one node: Empty for none, the item for one, else their list without brackets, by this separator
phrase_of(items: list, separator: Separator) as Node := if items.length == 0 then Empty else if items.length == 1 then items#1 else listed(items, Bracket.None, separator)

# A run without blanks: `x:40` and `a=1` split at their loosest key, the first of alike ones; a head glued to a bracket is the glue key
# Key(head, Op.None, group), `f(x)` `a{x:1}` `xs[1]` `f(x)(y)`; a run of one part is that part, any other run a
# glued list, `3ms` `a-b` `-x`
glued_run(run: list) as Node := {
	split = -1
	for i in 1 ..< run.length {
		t = token_at(run, i)
		if t.kind == LexemeKind.Key and (split < 0 or key_looseness(t.op) > key_looseness(token_at(run, split).op)) { split = i }
	}
	if split > 0 { return keyed(glued_run(run[0 .. split]), token_at(run, split).op, if split + 1 < run.length then glued_run(run[split + 1 .. run.length]) else Empty) }
	nodes: list<Node> = []
	for t in run {
		if t.bracket != Bracket.None and nodes.length > 0 and not is_operator(nodes.last) {
			nodes[nodes.length - 1] = keyed(nodes.last, Op.None, t.node)
		} else { nodes.add(t.node) }
	}
	phrase_of(nodes, Separator.None)
}

# an operator written as glyphs, `+` `..` `#`: no head a bracket can glue to
is_operator(n: Node) as bool := match n { Symbol(name) => is_glyph(name#1); _ => no }

keyed(key: Node, op: Op, value: Node) as Node := positioned_like(Key(key, op, value), key)

# ── annotations: `@name` and `@name(args)` belong to the item after them, leading a phrase to the whole phrase ──

# a phrase led by annotations is that phrase annotated: `@runs a + b`, `@final enum E {…}`, `@primitive f(x) := …`
phrase_annotated(runs: list) as list<Node> := {
	led = runs.index_where(run => not is_annotation(glued_run(run))) - 1
	items = annotated(spaced(runs[max(led, 0) .. runs.length]))
	if led < 1 then items else [with_fact(phrase_of(items, Separator.Space), ANNOTATIONS, phrase_of(runs[0 .. led].map(run => annotation_of(glued_run(run))), Separator.Space))]
}

annotated(items: list) as list := {
	result: list<Node> = []
	waiting: list<Node> = []
	for item in items {
		if is_annotation(item) { waiting.add(item) }
		else if waiting.length > 0 { result.add(with_fact(item, ANNOTATIONS, phrase_of(waiting.map(annotation_of), Separator.Space))); waiting = [] }
		else { result.add(item) }
	}
	result + waiting
}

# `@name…` glued, or a phrase of them
is_annotation(n: Node) as bool := match n {
	List(items, Bracket.None, Separator.None) => items.length > 1 and items#1 == Symbol("@")
	List(items, Bracket.None, Separator.Space) => items.all(is_annotation)
	_ => no
}

# what an annotation says, without its `@`
annotation_of(n: Node) as Node := match n {
	List(items, Bracket.None, Separator.None) => phrase_of(items[1 .. items.length], Separator.None)
	List(items, Bracket.None, Separator.Space) => listed(items.map(annotation_of), Bracket.None, Separator.Space)
	_ => n
}

# ── duplicate keys: the reader keeps both and warns, a later stage decides ──

with_duplicates_warned(written: Node, items: list) as Node := {
	seen: map<text, bool> = {}
	for item in items {
		match item {
			Key(key, Op.Colon, value) => {
				name = text(key)
				if seen.has(name) { return with_fact(written, "warning", Text("the key " + name + " is given twice")) }
				seen[name] = yes
			}
			_ => ø
		}
	}
	written
}

# the program's statements: lines, `;` statements, or the one statement; a run
# within the run (`a; b` on a line of many, or the two statements a rule wrote) gives its own
top_level_statements(program: Node) as list<Node> := match program {
	List(items, Bracket.None, separator) => if is_run(separator) then items.flat_map(top_level_statements) else [program]
	_ => [program]
}
# the separators of statements: lines and `;`
is_run(separator: Separator) as bool := separator == Separator.Newline or separator == Separator.Semicolon
