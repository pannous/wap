# The operator table (wap/types/operators.wap) as the operator stage reads it (core/parse/operators.wap): its
# precedence relations checked, the operators a program declares joined to it, each spelling by its canonical word.

use "../errors.wap"
use "../stage.wap"
use "../../kernel/forms.wap"
use folder
use "../../types/operators.wap"
use "../language.wap"

# the assignment a compound one means, `+=` is `=` of `+`
ASSIGNMENT = "="
# the word declaring a glyph pair that brackets an operand, `circumfix operator ‖ ‖ := abs` (wiki/operator.md)
CIRCUMFIX_WORD = "circumfix"
# the word of a line naming a word another way, `alias length => count`, and its arrows, the new name's first
ALIAS_WORD = "alias"
ALIAS_ARROWS = ["=>", "<="]

# ---- the table, checked when it is read

# the group of that name; an unknown name in the table is refused
group_named(language: Language, name: text) as Group := {
	found = items_named(language.grammar.group_names, language.grammar.groups, name, group => group.name)
	if #found == 0 { raise "operator table: no precedence group " + name }
	found#1
}

# every group the named one binds tighter than, directly or through others; `path` names a cycle when it closes
looser_groups(language: Language, name: text, path: list<text>) as list<text> := {
	if path.contains(name) { raise "operator table: the precedence groups form a cycle: " + (path + [name]).join(" > ") }
	group_named(language, name).tighter_than.flat_map(looser => [looser] + looser_groups(language, looser, path + [name]))
}

# group name → every group it binds tighter than: the topological order of the relations, read again whenever a
# program adds to them
related_groups(language: Language) := { for group in language.grammar.groups { language.grammar.looser_than[group.name] = looser_groups(language, group.name, []) } }

binds_tighter(language: Language, group: text, other: text) as bool := language.grammar.looser_than[group].contains(other)

# ---- a program's own operators

# every operator the code declares added to the table; its precedence declarations kept for after, when all exist
operators_declared(language: Language, n: Node, placements: list) := match n {
	List(items, Bracket.None, Separator.Space) => {
		declaration_read(language, n, declaration_words(language, items), placements)
		for item in items { operators_declared(language, item, placements) }
	}
	_ => for part in direct_parts(n) { operators_declared(language, part, placements) }
}

# the word an item spells, a call's head for `⊕(a, b)` (a glyph's still a glued run), "" for anything else
declared_word(item: Node) as text := match item {
	Symbol(name) => name
	Key(head, Op.None, group) => declared_word(head)
	List(items, Bracket.None, Separator.None) => declared_word(items#1)
	_ => ""
}

# a precedence declaration: the operator's spelling, the operator it is placed against, above or below it
class Placement { spelling: text, other: text, above: bool, written: Node }

# a head with parameters without the result type written after it, `⊕(a, b)` of `⊕(a, b): T` (a call, or a glyph's
# glued run); a typed name, a rule's `$name: Symbol`, stays as it is and declares nothing
untyped(item: Node) as Node := match item { Key(head, Op.Colon, type) => if head is Key or head is List then head else item; _ => item }
# the words of a phrase declaring an operator, its declaring word and the spelling, and for a placement the placing
# words: `[fixity] operator ⊕`, its parameters glued after it with a result type or none (`⊕(a, b)`, `⊕(a, b): T`),
# `operator ⊕ has precedence above|below *`, or `circumfix operator ‖ ‖`, its two glyphs; none for any other phrase
declaration_words(language: Language, items: list) as list<text> := {
	tokens = tokens_of(language, items)
	words = spelled_words(tokens)
	start = if words#1 == operator_word then 1 else if #words > 1 and words#2 == operator_word then 2 else 0
	if start == 0 or not declaring_words.any(row => row.word == words#1) and words#1 != CIRCUMFIX_WORD { return [] }
	rest = words[start ..]
	if words#1 == CIRCUMFIX_WORD { return if #rest == 2 and not rest.contains("") then [words#1] + rest else [] }
	parameters = #rest == 2 and tokens.last.glued_before and is_bracketed(tokens.last.item)
	if #rest == 1 or parameters or #rest == 5 and [precedence_above, precedence_below].contains(rest[1 .. 4]) then [words#1] + (if parameters then [rest#1] else rest) else []
}

# the words of a phrase's tokens, a word glued after another spelled with it: `operator ⊕s(a, b)` declares `⊕s`
spelled_words(tokens: list) as list<text> := {
	words: list<text> = []
	for token in tokens {
		word = declared_word(untyped(token.item))
		words.add(if token.glued_before and not is_bracketed(token.item) and words is not empty then words.pop() + word else word)
	}
	words
}

# `[fixity] operator ⊕ …` declares ⊕; `operator ⊕ has precedence above|below *` places it
declaration_read(language: Language, n: Node, words: list<text>, placements: list) := {
	if words is empty { return }
	language.grammar.declares = yes
	if #words == 6 { placements.add(Placement(words#2, words#6, words[2 .. 5] == precedence_above, n)); return }
	if words#1 == CIRCUMFIX_WORD { language.grammar.circumfix[words#2] = words#3; return }
	declared(language, words#2, declaring_words.filter(row => row.word == words#1)#1)
}

# the operator joins the table in the declaring word's fixity and group; one the table has there is an overload
declared(language: Language, spelling: text, declaring: Declaring) := {
	if group_of(language, spelling, declaring.fixity) != "" { return }
	found = operator_spelled(language, spelling)
	operator = found ?? Operator(spelling, spelling)
	if found == ø { language.grammar.operators.add(operator) }
	grouped(language, operator, declaring.fixity, declaring.group)
}

grouped(language: Language, operator: Operator, fixity: Fixity, group: text) := {
	language.grammar.placed_by[operator.spelling] = language.grammar.file
	match fixity {
		Fixity.Infix => operator.infix = group
		Fixity.Prefix => operator.prefix = group
		_ => operator.postfix = group
	}
}

# a declared operator in a group of its own, related to the group of the operator it is placed against
placed(language: Language, placement: Placement) := {
	operator = operator_spelled(language, placement.spelling)
	if operator == ø { refused(placement.written, "declare operator " + placement.spelling + " before placing it") }
	fixity = declared_fixity(operator)
	other = group_of_any(language, canonical(language, placement.other, Fixity.Anywhere))
	if other == "" { refused(placement.written, "no operator " + placement.other + " to place " + placement.spelling + " against") }
	own = Group(placement.spelling, if placement.above then [other] else [])
	if not placement.above { group_named(language, other).tighter_than.add(placement.spelling) }
	language.grammar.groups.add(own)
	grouped(language, operator, fixity, placement.spelling)
}

declared_fixity(operator: Operator) as Fixity :=
	if operator.infix != "" then Fixity.Infix else if operator.prefix != "" then Fixity.Prefix else Fixity.Postfix

# the group of an operator in its first fixity: infix, then prefix, then postfix
group_of_any(language: Language, spelling: text) as text := {
	for fixity in [Fixity.Infix, Fixity.Prefix, Fixity.Postfix] {
		group = group_of(language, spelling, fixity)
		if group != "" { return group }
	}
	""
}

# ---- a program's own words

# A call of a function a file defines at its top is the program's own: no rule of that glued head rewrites it
# (core/rules/stages.wap programs_own)

# the names code defines at its top, each a key of words
words_defined(code: Node, words: map<text, bool>) := { for word in words_named(code) { words[word] = yes } }
words_named(code: Node) as list<text> := top_level_statements(code).flat_map(named_by)
# the side of a definition that names what it defines, ø for any other node
definition_side(n: Node) as Node? := match n {
	Key(left, op, right) => if op in [Op.Assign, Op.Define] then left else ø
	_ => ø
}
# the names a definition defines, `f` of `f(x) := …`
named_by(n: Node) as list<text> := names_of(definition_side(n) ?? return [])
# the name a defining side names: a name, a typed one, a function's, `f(x) as int`'s f
names_of(side: Node) as list<text> := match side {
	Symbol(spelling) => [spelling]
	Key(name, op, value) => if op in [Op.Colon, Op.Assign, Op.None] then names_of(name) else []
	List(items, Bracket.None, Separator.Space) => names_of(items#1)
	_ => []
}

# ---- spellings

# the canonical word of a spelling written in that fixity: the spelling itself when no alias applies
canonical(language: Language, spelling: text, fixity: Fixity) as text := {
	read = language.grammar.reading.find(alias => alias.spelling == spelling)
	if read != ø { return read!.canonical }
	written = aliased(spelling, fixity)
	if written != spelling { return written }
	compound = compound_assignment(language, spelling)
	if compound != "" { return compound }
	spelling
}
# the canonical word the types module's aliases give a spelling, the spelling itself when none does
aliased(spelling: text, fixity: Fixity) as text := {
	for alias in aliases_spelled(spelling) {
		if alias.fixity == fixity or alias.fixity == Fixity.Anywhere { return alias.canonical }
	}
	spelling
}

# the types module's aliases of a spelling, looked up by it in alias_names
alias_names = NameIndex()
aliases_spelled(spelling: text) as list<Alias> := items_named(alias_names, aliases, spelling, alias => alias.spelling)
# the canonical word a plain word names (types/operators.wap word_aliases), the word itself when it names none
word_alias_names = NameIndex()
word_aliased(word: text) as text := {
	named = items_named(word_alias_names, word_aliases, word, alias => alias.spelling)
	if named is empty then word else named#1.canonical
}

# a discouraged alias, ø for any other spelling
discouraged_alias(spelling: text) as Alias? := aliases_spelled(spelling).find(alias => alias.discouraged)

# `+=` of the infix `+`: an infix operator's spelling followed by `=`, unless the table knows the spelling itself
compound_assignment(language: Language, spelling: text) as text := {
	if not spelling.ends_with(ASSIGNMENT) or #spelling < 2 or operator_spelled(language, spelling) != ø { return "" }
	inner = canonical(language, spelling[0 .. #spelling - 1], Fixity.Infix)
	operator = operator_spelled(language, inner)
	if operator == ø or operator.infix == "" { return "" }
	inner + ASSIGNMENT
}

# the operator of that canonical spelling, ø when there is none
operator_spelled(language: Language, spelling: text) as Operator? := {
	found = items_named(language.grammar.operator_names, language.grammar.operators, spelling, operator => operator.spelling)
	if found is empty then ø else found#1
}

# the group an operator spelled so has in that fixity, "" when it has no such fixity
group_of(language: Language, spelling: text, fixity: Fixity) as text := {
	if fixity == Fixity.Infix and compound_assignment(language, spelling) == spelling { return compound_assignment_group }
	operator = operator_spelled(language, spelling) ?? return ""
	match fixity { Fixity.Infix => operator.infix; Fixity.Prefix => operator.prefix; Fixity.Postfix => operator.postfix; _ => "" }
}

# an operator as it is applied: its canonical spelling, fixity and group, and the item that wrote it (for its place)
class Use { spelling: text, fixity: Fixity, group: text, written: Node }
# a word or glyph the table reads in that fixity, ø when it is no operator there
reading_as(language: Language, item: Node, fixity: Fixity) as Use? := match item {
	Symbol(spelling) => {
		word = canonical(language, spelling, fixity)
		group = group_of(language, word, fixity)
		if group == "" { ø } else { Use(word, fixity, group, item) }
	}
	_ => ø
}

# A file's alias line (wiki/alias.md), `alias length => count` or `alias count <= length`, taken out of it: its row
# joins the aliases the file's lines below it are read by, and those of the files using it. Kept, for format, it is
# written back as its row reads. Its two sides are taken as written, never through the aliases read before it
alias_line_taken(language: Language, line: Node, kept: bool) as list := {
	if phrase_items(line)#1 != symbol(ALIAS_WORD) { return [line] }
	reading = language.grammar.reading
	language.grammar.reading = []
	row = alias_read(operated(language, line))
	language.grammar.reading = reading
	found = row ?? return [line]
	language.grammar.reading.add(found)
	language.grammar.declares = yes
	if kept then [with_fact(line, WRITTEN, Text("${ALIAS_WORD} ${found.spelling} ${ALIAS_ARROWS#1} ${found.canonical}"))] else []
}
# the line `alias (a => b)` as the arrow binds looser than the phrase or tighter, `alias (count <= length)`
alias_read(line: Node) as Alias? := match line {
	Call(called, arguments) => if #arguments == 2 and is_alias_phrase(arguments#1) then alias_row(line, spelling_written(called), items_of(arguments#1)#2, arguments#2) else ø
	List(items, Bracket.None, Separator.Space) => if is_alias_phrase(line) then (match items#2 { Call(called, arguments) => if #arguments == 2 then alias_row(line, spelling_written(called), arguments#1, arguments#2) else ø; _ => ø }) else ø
	_ => ø
}
is_alias_phrase(n: Node) as bool := #items_of(n) == 2 and items_of(n)#1 == symbol(ALIAS_WORD)
alias_row(line: Node, arrow: text, left: Node, right: Node) as Alias := {
	if not ALIAS_ARROWS.contains(arrow) { refused(line, "an alias points from the new name to its meaning: write alias ${left} => ${right}") }
	if arrow == ALIAS_ARROWS#1 then Alias(text(left), text(right)) else Alias(text(right), text(left))
}
