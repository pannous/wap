# Notation → operated: every operator phrase read by the operator table (notes/backbone.md "Stage languages",
# "Operators"; the table: wap/types/operators.wap).
#
#   a + b * c          → (Call + a (Call * b c))      precedence from the relations between groups
#   x ≤ y              → (Call <= x y)                every alias by its canonical word
#   a -b   a - b  a-b  → [a, (Call - b)]  (Call - a b)  (Call - a b)     the one minus rule, by spacing
#   print 1 + 2        → [print, (Call + 1 2)]        juxtaposition stays a phrase: stage 2 decides it
#   x += 1             → (Call = x (Call + x 1))      a compound assignment of the table, its spelling a fact
#
# Reads: notation, whose phrases are space lists and glued runs (separator None) with operators as Symbols. Writes:
# the same notation with each operator application a Call of its canonical spelling. An unrelated mix, a chain of a
# group that refuses chaining, or an operator key the table lacks is refused.

use folder
use "../errors.wap"
use "../stage.wap"
use "../../kernel/forms.wap"
use "../../types/operators.wap"
use "../language.wap"

# the word of a chain of comparisons
CHAINED = "comparison_chain"

# the fact keeping a compound assignment's written spelling
COMPOUND = "compound"
# the operator a colon closes: c ? a : b
CHOICE = "?"
# the word an operator read on one side of its operand writes on the other, `2 ..` is (Call .. 2 ø)
OPEN_SIDE = "ø"

# the program with its operator phrases read, after its own declarations joined the table (core/parse/operator_table.wap),
# wherever they stand
# DEBT: a program's own `alias a => b` lines are not read: such a line would rewrite the line declaring it. Paid off
#   with the rule engine reading alias lines as rules.
operated_program(language: Language, program: Node) as Node := {
	placements = []
	operators_declared(language, program, placements)
	for placement in placements { placed(language, placement) }
	related_groups(language)
	operated(language, program)
}

# ---- reading a phrase


# code with each operator phrase in it read, placed where it was written (core/stage.wap)
operated(language: Language, n: Node) as Node := replaced(n, operated_form(language, n))
operated_form(language: Language, n: Node) as Node := match n {
	List(items, Bracket.None, Separator.None) => phrase_read(language, glued_tokens(language, items))
	# an operator's declaration is no phrase of operators, only its items are read: `suffix operator ³ := …` declares ³,
# never applies it
	List(items, Bracket.None, Separator.Space) => if declaration_words(language, items) is empty then phrase_read(language, tokens_of(language, items)) else List(items.map(item => operated(language, item)), Bracket.None, Separator.Space)
	List(items, bracket, Separator.Space) => in_brackets(phrase_read(language, tokens_of(language, items)), bracket)
	List(items, bracket, separator) => List(items.map(item => operated(language, item)), bracket, separator)
	Key(left, Op.Colon, right) => chosen(operated(language, left), operated(language, right))
	Key(left, Op.None, right) => Key(operated(language, left), Op.None, operated(language, right))
	Key(left, op, right) => key_read(language, n, left, op as text, right)
	Symbol(spelling) => word_read(language, n, spelling)
	_ => n
}

# `c ? a : b`: the reader keys `c ? a` with b; the colon closes the choice left open at the key's end, (Call ? c a b),
# also as a phrase's last argument, `print c ? a : b`; any other colon key stays a key
chosen(left: Node, right: Node) as Node := match left {
	Call(called, arguments) => if open_choice(left) then Call(called, arguments + [right]) else Key(left, Op.Colon, right)
	List(items, Bracket.None, Separator.Space) => if open_choice(items.last) then List(items[.. #items - 1] + [chosen(items.last, right)], Bracket.None, Separator.Space) else Key(left, Op.Colon, right)
	_ => Key(left, Op.Colon, right)
}
open_choice(n: Node) as bool := match n { Call(called, arguments) => spelling_written(called) == CHOICE and #arguments == 2; _ => no }

# a key the reader built by an operator (`a = 1`, the colon's rules) applied as that infix operator: (Call = a 1)
key_read(language: Language, n: Node, left: Node, spelling: text, right: Node) as Node := {
	use = reading_as(language, placed_like(symbol(spelling), n), Fixity.Infix)
	if use == ø { refused(n, "no infix operator " + spelling + " in the operator table") }
	infix_call(language, use.spelling, operated(language, left), operated(language, right))
}

# An infix operator applied: (Call + a b). A compound assignment of the table, `x += 1`, is the assignment it means,
# x = x + 1, (Call = x (Call + x 1)); its written spelling stays a fact, so `wap format` prints `x += 1` again
infix_call(language: Language, spelling: text, left: Node, right: Node) as Node := {
	if is_assignment(language, spelling) and arrow_parts(language, left) != ø { return arrow_assigned(language, spelling, left, right) }
	phrase = if is_assignment(language, spelling) then rule_phrase(language, left) else ø
	if phrase != ø { return phrase_assigned(language, spelling, phrase, right) }
	if compound_assignment(language, spelling) != spelling { return Call(symbol(spelling), [left, right]) }
	with_fact(Call(symbol(ASSIGNMENT), [left, Call(symbol(spelling[.. #spelling - 1]), [left, right])]), COMPOUND, symbol(spelling))
}

is_assignment(language: Language, spelling: text) as bool := spelling == ASSIGNMENT or compound_assignment(language, spelling) == spelling

# A rule's phrase is no place to assign to either: `if c then xs[0] = 5 else xs.add(2)` assigns to its last word, the
# value running to the next word the rule's phrase continues with, `if c then (xs[0] = 5) else xs.add(2)`; so does
# `… else x = 2`
phrase_assigned(language: Language, spelling: text, words: list, value: Node) as Node := {
	after = match value { List(items, Bracket.None, Separator.Space) => items; _ => [value] }
	cut = 0
	while cut < #after and not continuation_item(language, after#(cut + 1), words) { cut = cut + 1 }
	given = if cut == 1 then after#1 else List(after[.. cut], Bracket.None, Separator.Space)
	List(words[.. #words - 1] + [infix_call(language, spelling, words.last, given)] + after[cut ..], Bracket.None, Separator.Space)
}
# the words of a phrase that holds a word of a rule's phrase, `if`, `else`, ø for any other code
rule_phrase(language: Language, n: Node) as list? := match n {
	List(items, Bracket.None, Separator.Space) => if items.filter(item => rule_word(language, item)) is not empty then items else ø
	_ => ø
}
rule_word(language: Language, n: Node) as bool := n is symbol and (language.phrase_words.leading.has(spelling_written(n)) or language.phrase_words.inner.has(spelling_written(n)))

# An arrow is no place to assign to: `1 => y = 2` assigns in the arrow's result, `1 => (y = 2)`, as a match arm or a
# function's body means it
arrow_assigned(language: Language, spelling: text, arrow: Call, value: Node) as Node := match arrow {
	Call(called, parts) => with_facts_of(Call(called, [parts#1, infix_call(language, spelling, parts#2, value)]), arrow)
}
arrow_parts(language: Language, n: Node) as list? := match n {
	Call(called, parts) => if #parts == 2 and group_of(language, spelling_written(called), Fixity.Infix) == parameters_group then parts else ø
	_ => ø
}

# a word standing alone, by its canonical spelling
word_read(language: Language, n: Node, spelling: text) as Node := {
	word = canonical(language, spelling, Fixity.Anywhere)
	note_discouraged(n, spelling)
	if word == spelling { n } else { placed_like(symbol(word), n) }
}

note_discouraged(written: Node, spelling: text) := {
	alias = discouraged_alias(spelling)
	if alias != ø { hint place_of(written) + "write " + alias.canonical + " for " + spelling }
}

# A phrase read by precedence (an operator-precedence parse): operands wait on one stack, operators on another; an
# operator is applied once the one after it binds looser. Between two operands stands juxtaposition, glued or
# spaced, a group like any other. An operator whose operand cannot follow it is a name: `fold +`, `(+)`.
phrase_read(language: Language, written: list) as Node := tokens_read(language, names_marked(language, operators_called(language, written)))
tokens_read(language: Language, tokens: list) as Node := {
	operands = []
	pending = []
	expecting_operand = yes
	i = 1
	while i <= #tokens {
		token = tokens#i
		next = if i < #tokens then tokens#(i + 1) else ø
		after = if i + 1 < #tokens then tokens#(i + 2) else ø
		if expecting_operand {
			prefix = if operand_after(language, next) != ø then reading_as(language, token.item, Fixity.Prefix) else ø
			if prefix == ø and called_after_infix(language, token, next, after, pending, tokens[.. i - 1]) {
				last = i + 1
				takes_block = language.phrase_words.leading[spelling_written(token.item)] == yes
				while last < #tokens and (takes_block or not is_block(tokens#(last + 1).item)) { last = last + 1 }
				operands.add(tokens_read(language, tokens[i - 1 .. last]))
				expecting_operand = no
				i = last
			} else if prefix == ø {
				operands.add(operated(language, token.item))
				expecting_operand = no
			} else {
				note_discouraged(token.item, spelling_written(token.item))
				pending.add(prefix)
			}
			i = i + 1
		} else {
			use = operator_after_operand(language, token, next)
			if use == ø {
				juxtaposition = juxtaposition_before(language, token, operands.last)
				arrive(language, juxtaposition, operands, pending)
				pending.add(juxtaposition)
				expecting_operand = yes
			} else {
				note_discouraged(token.item, spelling_written(token.item))
				arrive(language, use, operands, pending)
				if use.fixity == Fixity.Postfix { applied(language, use, operands) } else { pending.add(use); expecting_operand = yes }
				i = i + 1
			}
		}
	}
	while pending is not empty { applied(language, pending.pop(), operands) }
	operands#1
}

# A word that leads a rule's phrase after an infix operator, with more operands after it, takes the rest of the phrase
# as its own, as at a phrase's start: `a ?? return ø` is `a ?? (return ø)`, `a ?? if c {1} else {2}` the whole if. A
# block stays the statement's (`if a == f x { … }`) unless the word's rules take one. Other words stay operands
# (`0 - step else step`), and so does one an operator follows, as any operand: `2 * no + 1` is `(2 * no) + 1`.
called_after_infix(language: Language, token: Spaced, next: Spaced?, after: Spaced?, pending: list<Use>, before: list) as bool := {
	operand = operand_after(language, next)
	pending is not empty and pending.last.spelling != "" and pending.last.fixity == Fixity.Infix and token.item is symbol and language.phrase_words.leading.has(spelling_written(token.item)) and not token.glued_after and operand != ø and not is_block(operand.item) and operator_after_operand(language, operand, after) == ø and not continues_another(language, spelling_written(token.item), operand.item, before)
}
# a word after the leading one that continues another word's phrase opened before it, `then` of `if x is list then …`:
# the leading word is an operand then, not the start of its own phrase; a phrase not opened leaves it leading, so
# `a ?? return text 0` returns `text 0` though `text` continues the c extension's `c_type text`
continues_another(language: Language, leading: text, next: Node, before: list) as bool := continuation_item(language, next, before.map(token => token.item)) and not language.phrase_words.inner[spelling_written(next)].contains(leading)
# a word rules use only inside their phrases, of a phrase opened among these words: one of its phrases' leading words
# stands among them; elsewhere the word is the program's own, a variable `out` beside a rule `c_kept out $parameter`
continuation_item(language: Language, item: Node, words: list) as bool := item is symbol and continuation_word(language, spelling_written(item)) and words.filter(word => word is symbol and language.phrase_words.inner[spelling_written(item)].contains(spelling_written(word))) is not empty
# a word rules use only inside their phrases, which continues the code before it: `else`
continuation_word(language: Language, word: text) as bool := language.phrase_words.inner.has(word) and not language.phrase_words.leading.has(word)
is_block(n: Node) as bool := match n { List(items, Bracket.Curly, separator) => yes; _ => no }

# the next token where it can start an operand: a word, a literal, a group, or a prefix operator; ø where it cannot,
# and at the phrase's end
operand_after(language: Language, next: Spaced?) as Spaced? :=
	if next != ø and (next.named or reading_as(language, next.item, Fixity.Prefix) != ø or reading_as(language, next.item, Fixity.Infix) == ø and reading_as(language, next.item, Fixity.Postfix) == ø) then next else ø

# after an operand, the token as an infix or postfix operator, by the minus rule (notes/backbone.md "Minus"): spaced
# on both sides or on neither it is infix; attached only to what follows it is prefix, so juxtaposition comes first
# (ø here), and so is one glued to brackets, a call of it like any `f(x)` (`⊕(a, b)`); attached only to what
# precedes it is postfix where it has a postfix, else infix. Infix and prefix need an operand after them.
operator_after_operand(language: Language, token: Spaced, next: Spaced?) as Use? := {
	operand = operand_after(language, next)
	infix = if operand != ø then reading_as(language, token.item, Fixity.Infix) else ø
	postfix = reading_as(language, token.item, Fixity.Postfix)
	if token.glued_after and not token.glued_before and operand != ø and (reading_as(language, token.item, Fixity.Prefix) != ø or is_bracketed(operand.item)) { return ø }
	if token.glued_before and not token.glued_after and postfix != ø { return postfix }
	if infix != ø { return infix }
	postfix
}

# a space list read as a phrase, its brackets kept: `[a -1]` stays two items, `(a + b)` holds one
in_brackets(read: Node, bracket: Bracket) as Node := {
	if bracket == Bracket.None { return read }
	match read {
		List(items, Bracket.None, Separator.Space) => List(items, bracket, Separator.Space)
		_ => List([read], bracket, Separator.None)
	}
}

# the juxtaposition before a token, glued when nothing separates them; a word after a number literal measures it as
# glued `3ms` does, `x > 1500 m` is x > (1500 m), unless the word is a rule's (`1 then`) or a hole (`- 1 $body`)
juxtaposition_before(language: Language, token: Spaced, left: Node) as Use :=
	Use("", Fixity.Infix, if token.glued_before then glue_group else if word_measures(language, left, token.item) then measure_group else juxtaposition_group, token.item)
word_measures(language: Language, left: Node, word: Node) as bool := match left { Number(value) => word is symbol and not is_hole_word(word) and reading_as(language, word, Fixity.Prefix) == ø and not rule_word(language, word); _ => no }

spelling_written(item: Node) as text := match item { Symbol(name) => name; _ => "" }

# Before an incoming operator waits, every pending one that binds tighter is applied. Two of one group apply by its
# grouping; two groups with no relation are refused, as is a chain of a group that refuses chaining.
arrive(language: Language, incoming: Use, operands: list<Node>, pending: list<Use>) := {
	while pending is not empty and applies_first(language, pending.last, incoming) { applied(language, pending.pop(), operands) }
}

applies_first(language: Language, waiting: Use, incoming: Use) as bool := {
	if waiting.fixity == Fixity.Prefix and incoming.fixity == Fixity.Prefix { return no }
	if waiting.group == incoming.group {
		if waiting.fixity == Fixity.Prefix { return yes }
		grouping = group_named(language, waiting.group).grouping
		if grouping == Grouping.Refused { refused(incoming.written, "chained " + shown(waiting) + " and " + shown(incoming) + " read two ways: add brackets") }
		return grouping in [Grouping.Left, Grouping.Chained]
	}
	if binds_tighter(language, waiting.group, incoming.group) { return yes }
	if binds_tighter(language, incoming.group, waiting.group) { return no }
	refused(incoming.written, shown(waiting) + " and " + shown(incoming) + " have no precedence between them: add brackets")
}

shown(use: Use) as text := if use.spelling == "" then "juxtaposition" else use.spelling

# A spelling read both before and after one operand, `.. 3` and `2 ..`, tells the two by its position only: the absent
# side is written ø, (Call .. ø 3) and (Call .. 2 ø); one reading alone, `-x`, `x!`, keeps its one operand
one_sided(language: Language, use: Use, operand: Node) as list := {
	if not two_sided(language, use.spelling) { return [operand] }
	if use.fixity == Fixity.Prefix then [symbol(OPEN_SIDE), operand] else [operand, symbol(OPEN_SIDE)]
}
two_sided(language: Language, spelling: text) as bool := group_of(language, spelling, Fixity.Prefix) != "" and group_of(language, spelling, Fixity.Postfix) != ""

# the operator applied to its operands on the stack: a Call of its canonical spelling, or a phrase for juxtaposition
applied(language: Language, use: Use, operands: list<Node>) := {
	right = operands.pop()
	if use.fixity != Fixity.Infix { operands.add(placed_like(Call(symbol(use.spelling), one_sided(language, use, right)), use.written)); return }
	left = operands.pop()
	if use.spelling == "" { operands.add(juxtaposed(left, right, separator_of(use))); return }
	operands.add(placed_like(chained_call(language, use, left, right) ?? infix_call(language, use.spelling, left, right), use.written))
}
# a comparison after a comparison, `a < b < c`, is one chain, comparison_chain(a, <, b, <, c), the middle value computed
# once (sugar/conditions.wap); a bracketed comparison, `(a < b) < c`, stays one value
chained_call(language: Language, use: Use, left: Node, right: Node) as Node? := {
	if group_named(language, use.group).grouping != Grouping.Chained { return ø }
	match left {
		Call(called, arguments) => if #arguments == 2 and group_of(language, text(called), Fixity.Infix) == use.group then Key(symbol(CHAINED), Op.None, List([arguments#1, called, arguments#2, symbol(use.spelling), right], Bracket.Round, Separator.Comma)) else ø
		_ => ø
	}
}

separator_of(use: Use) as Separator := if use.group == glue_group then Separator.None else Separator.Space

# a phrase grows by one operand: juxtaposition reads `a b c` as one phrase, not nested pairs
# the items a word and what follows it make: a space before an empty `()` changes nothing, `f ()` is the call `f()`
# (wiki/significant-whitespace.md)
juxtaposed(left: Node, right: Node, separator: Separator) as Node := match left {
	List(items, Bracket.None, joined) => if joined == separator then List(items[.. #items - 1] + followed(items.last, right), Bracket.None, separator) else List([left, right], Bracket.None, separator)
	_ => { parts = followed(left, right); if #parts == 1 then parts#1 else List(parts, Bracket.None, separator) }
}
followed(word: Node, right: Node) as list<Node> := if right is Empty and word is symbol then [Key(word, Op.None, right)] else [word, right]

# what round brackets around one item group, the item itself
ungrouped(n: Node) as Node := match n {
	List(items, Bracket.Round, separator) => if #items == 1 then ungrouped(items#1) else n
	_ => n
}
