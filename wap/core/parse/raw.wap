# Raw blocks (wiki/dsl.md "Raw block"): a word whose definition takes a `raw` parameter, `shader(wgsl: raw) := …`,
# takes the braced block after it as text, kept verbatim: another language's operators, comments and lines as
# written. The reader knows no language, so it is told these words (core/pipeline.wap reads them out of the sources).

use folder
use "../stage.wap"

RAW_TYPE = "raw"
BLANKS = " \t"

# the words a source defines with a raw parameter: a line `shader(wgsl: raw, …) …`, the word before its `(`
raw_words_written(source: text) as list<text> := source.split("\n").map(line => line.trim()).filter(takes_raw).map(line => line.split("(")#1.split(" ").last)
takes_raw(line: text) as bool := line.contains("(") and line.split(")")#1.split(",").any(parameter => parameter.contains(":") and parameter.split(":").last.trim() == RAW_TYPE)

# the `{ … }` after a raw word, one Text of what it holds to its balancing `}`: the reader knows no other language's
# comments or quotes. Format writes it back as it was written. A word with no block after it is plain.
raw_block(r: Reader) := {
	open = r.at
	while open < r.n and BLANKS.contains(r.code[open]) { open += 1 }
	if peek_at(r, open) != '{' { return ø }
	close = raw_end(r, open)
	if close < 0 { return failed(r, "this block is never closed") }
	r.blank = r.blank or open > r.at
	r.at = open
	atom_token(r, with_fact(Text(slice_of(r, open + 1, close)), WRITTEN, Text(slice_of(r, open, close + 1))), close + 1)
	for at in open upto close { if r.code[at] == '\n' { r.line += 1; r.line_start = at + 1 } }
}
# where the `}` closing the `{` at `open` is, -1 for none
raw_end(r: Reader, open: int) as int := {
	depth = 0
	at = open
	while at < r.n {
		c = r.code[at]
		if c == '{' { depth += 1 }
		else if c == '}' { depth -= 1; if depth == 0 { return at } }
		at += 1
	}
	-1
}
