# Arguments read unparsed (wiki/dsl.md): a word whose definition takes a `raw` parameter, `shader(wgsl: raw) := …`,
# takes the braced block after it as text, kept verbatim: another language's operators, comments and lines as
# written; a word of a `phrase` parameter, `sql(command: phrase)`, takes the rest of its argument as text. The reader knows no language, so it is told these words (core/pipeline.wap reads them out of the sources).

use folder
use "../stage.wap"

RAW_TYPE = "raw"
PHRASE_TYPE = "phrase"
UNPARSED_TYPES = [RAW_TYPE, PHRASE_TYPE]
BLANKS = " \t"
# what ends a phrase besides the separators and closers: a line's end, a tab between columns, a block
PHRASE_STOPS = "\n\t{"

# the words a source defines with a raw or phrase parameter, each with that type: a line `shader(wgsl: raw, …) …`,
# the word before its one `(` up to the first `)`
unparsed_written(source: text) as map<text, text> := {
	words: map<text, text> = {}
	for line in source.split("\n").map(line => line.trim()).filter(line => line.split(")")#1.split("(").length == 2) {
		taking = line.split(")")#1.split(",").filter(parameter => parameter.contains(":")).map(parameter => parameter.split(":").last.trim()).find(type => UNPARSED_TYPES.contains(type))
		if taking != ø { words[line.split("(")#1.split(" ").last] = taking! }
	}
	words
}

# the `{ … }` after a raw word as its text; a word with no block after it is plain
raw_block(r: Reader) := {
	open = r.at
	while open < r.n and BLANKS.contains(r.code[open]) { open += 1 }
	if peek_at(r, open) == '{' { bracketed_text(r, open) }
}
# the bracket at `open` as one Text of what it holds to its balancing closer: the reader knows no other language's
# comments or quotes. Format writes it back as it was written.
bracketed_text(r: Reader, open: int) := {
	close = bracket_end(r, open)
	if close < 0 { return failed(r, "this bracket is never closed") }
	r.blank = r.blank or open > r.at
	r.at = open
	atom_token(r, with_fact(Text(slice_of(r, open + 1, close)), WRITTEN, Text(slice_of(r, open, close + 1))), close + 1)
	for at in open upto close { if r.code[at] == '\n' { r.line += 1; r.line_start = at + 1 } }
}
# where the closer balancing the bracket at `open` is, -1 for none
bracket_end(r: Reader, open: int) as int := {
	opener = r.code[open]
	closer = CLOSERS.codepoints[OPENERS.find(opener) - 1]
	depth = 0
	at = open
	while at < r.n {
		c = r.code[at]
		if c == opener { depth += 1 }
		else if c == closer { depth -= 1; if depth == 0 { return at } }
		at += 1
	}
	-1
}

# A phrase parameter's argument as one Text, unread. Glued, `shout(a b)`, it is what the parentheses hold,
# unless a `:` after them makes them the definition's parameters. After a blank, a phrase is the rest of what a spaced
# call's argument holds, up to a separator, a line comment, a bracket it did not open or a block's `{`. Format writes
# it back as it was written. A phrase at its item's end is plain.
phrase_text(r: Reader) := {
	if peek_at(r, r.at) == '(' {
		close = bracket_end(r, r.at)
		if close >= 0 and peek_at(r, past_blank(r, close + 1)) != ':' { bracketed_text(r, r.at) }
		return ø
	}
	start = r.at
	while start < r.n and BLANKS.contains(r.code[start]) { start += 1 }
	end = start
	depth = 0
	while end < r.n and not (depth == 0 and phrase_ends(r, end)) {
		if OPENERS.contains(r.code[end]) { depth += 1 } else if CLOSERS.contains(r.code[end]) { depth -= 1 }
		end += 1
	}
	while end > start and BLANKS.contains(r.code[end - 1]) { end -= 1 }
	if start == r.at or end == start { return ø }
	r.at = start
	r.blank = yes
	words = Text(slice_of(r, start, end))
	atom_token(r, with_fact(words, WRITTEN, words), end)
}
phrase_ends(r: Reader, at: int) as bool := {
	c = r.code[at]
	SEPARATOR_CHARS.contains(c) or PHRASE_STOPS.contains(c) or CLOSERS.contains(c) or hash_comment_at(r, at, BLANKS.contains(r.code[at - 1]))
}
