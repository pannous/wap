# Text → notation: any text read as Node, data and code alike (notes/backbone.md "Stage languages").
#
# The reader knows no language: no keyword, no operator table, no precedence. Character classes tell a word from an
# operator, and spacing and separators give the structure:
#
#   1 2 3            S(1 2 3)          a phrase: List(…, None, Space)
#   a-b  f(x)        G(a - b) G(f (x)) a glued run, no blank between: List(…, None, None)
#   a b, c; d        ;(,(S(a b) c) d)  separators cascade, the loosest splits first
#   a: b c   a=1     K(a, S(b c))      keys are `:` `=` `:=`; `a=1` is Key(a, Assign, 1), never turned into `:`
#   if x⏎  y         S(if G(x C⏎(y)))  an indented block is `{…}` glued to the line before
# It makes Number, Char, Text, Symbol, Key, List, Meta, Empty and Error, never True, False, Type or Data: `yes` and
# `null` are Symbols, the alias table gives them meaning.
#
# Comments, `@annotations` and positions ride in the nodes' metadata (core/stage.wap with_fact, positioned).
# Reading runs in two passes: `read_tokens` cuts the text into atoms (atoms.wap), brackets, separators and colons
# (layout.wap), each knowing whether a blank came before it, on the reader's state (lexemes.wap); `built` assembles
# them by the separator cascade (cascade.wap). This file reads a text and tells each character's token apart.

use "../errors.wap"
use folder
use "../stage.wap"

# a line comment starts with `//`, or with `#` before a blank, `!` or `#`
HASH_COMMENT_FOLLOWERS = " \t\n!#"

# the notation of a text read from a file: its one item, the list of its items, Empty for none, each node marked with
# the file (core/stage.wap file_of); a text it cannot read is an Error of why and where, `Error("this bracket is never
# closed": "(a")`, which a compiler refuses (core/pipeline.wap read_notation) and data may hold; each line is told
# before it is read, and what follows a word of a raw or phrase parameter that telling names is read unparsed (raw.wap)
notation(source: text, file: text, told: (text) -> map<text, text> = untold) as Node := {
	code = source.codepoints
	r = Reader{code: code, n: code.length, told: told, lines: source.split("\n")}
	read_tokens(r)
	if r.error == "" then filed(built(r.tokens), file) else Error(Key(Text(r.error), Op.Colon, filed(r.failure, file)))
}
# n and each part of it that has a position, marked with the file it was read from
filed(n: Node, file: text) as Node := {
	if n is Empty { return n }
	whole = rebuilt(n, part => filed(part, file))
	if line_of(n) == ø then whole else with_fact(whole, SOURCE_FILE, Text(file))
}

# ── pass 1: tokens ──────────────────────────────────────────────────────────────────────────────────────────────────

read_tokens(r: Reader) := {
	line_told(r)
	indentation(r)
	while r.at < r.n and r.error == "" { read_token(r) }
	if r.error != "" { return ø }
	# the comments after the last code, each on a line of its own after the last statement
	if r.top_atom != ø and r.comments is not empty { top = r.top_atom!; top.node = commented(top.node, [""] + r.comments, TRAILING) }
	while r.indents.length > 0 { dedent(r) }
	if r.opened.length > 0 { failed_at(r, "this bracket is never closed", last_of(r.opened).line, last_of(r.opened).column) }
}

read_token(r: Reader) := {
	c = r.code[r.at]
	next = peek(r, 1)
	// todo rewrite as match c { ... later
	if c == '\n' { new_line(r) }
	else if c == ' ' or c == '\r' { r.at += 1; r.blank = yes }
	else if c == '\t' { tab(r) }
	else if c == '/' and next == '/' and not after_colon(r) { line_comment(r, 2) }
	else if hash_comment_at(r, r.at, r.blank) { line_comment(r, 1) }
	else if c == '/' and (next == '*' or next == '#') { block_comment(r) }
	else if c == ANGLE_OPEN and type_list_follows(r) { bracket_opened(r, c, 1) }
	else if c == ANGLE_CLOSE and r.angle_closers.contains(r.at) { bracket_closed(r, c) }
	else if OPENERS.contains(c) { bracket_opened(r, c, 1) }
	else if CLOSERS.contains(c) { bracket_closed(r, c) }
	else if SEPARATOR_CHARS.contains(c) { separated(r, SEPARATORS_WRITTEN[SEPARATOR_CHARS.find(c) - 1], 1) }
	else if QUOTES.contains(c) { quoted(r, c) }
	else if number_starts(r) { number_read(r) }
	else if c == ':' and next != ':' and next != '=' { key_token(r, Op.Colon) }
	else if c == ':' and next == '=' and not joins_glyph(r, 2) { key_token(r, Op.Define) }
	else if c == '=' and not joins_glyph(r, 1) { key_token(r, Op.Assign) }
	else if is_glyph(c) { glyphs_read(r, c) }
	else if is_name_char(c) { name_read(r) }
	else { failed(r, "a character the reader does not know") }
}

# a `#` line comment at `at`: after a blank, before a blank, `!` or `#`
hash_comment_at(r: Reader, at: int, blank: bool) as bool := r.code[at] == '#' and blank and HASH_COMMENT_FOLLOWERS.contains(peek_at(r, at + 1))
# `http://`: `//` glued after `:` is no comment
after_colon(r: Reader) as bool := r.at > 0 and r.code[r.at - 1] == ':'

# A number starts at its digits, or at a sign or a point glued to them where an item starts: after a blank, a bracket,
# a separator or an operator (`a -1`, `(-1)`, `x=-1`, `.5`, `-.5`), never after a word, number or closing bracket
# (`a-1` is a - 1, `x.5` reads x's 5)
number_starts(r: Reader) as bool := {
	signed = (r.code[r.at] == '-' or r.code[r.at] == '+') and item_starts(r)
	at = if signed then r.at + 1 else r.at
	is_digit(peek_at(r, at)) or peek_at(r, at) == '.' and is_digit(peek_at(r, at + 1)) and (signed or item_starts(r))
}
item_starts(r: Reader) as bool := {
	if r.blank or r.at == 0 { return yes }
	before = r.code[r.at - 1]
	OPENERS.contains(before) or before == ',' or before == ';' or (is_glyph(before) and before != r.code[r.at])
}

# `=` alone makes a key; `==`, `=>` and the like are operators, while a sign after it starts a number (`x=-1`)
joins_glyph(r: Reader, width: int) as bool := {
	next = peek(r, width)
	is_glyph(next) and not ((next == '-' or next == '+') and is_digit(peek(r, width + 1)))
}

# a key's `:`, `=` or `:=`
key_token(r: Reader, op: Op) := {
	spelling = op as text
	token(r, LexemeKind.Key, Symbol(spelling), spelling.length)
	last_of(r.tokens).op = op
}

# ── comments ──

# `// …` and `# …` to the end of the line: the comment of the line's last atom, else of the next atom
line_comment(r: Reader, opener: int) := {
	end = r.at
	while end < r.n and r.code[end] != '\n' { end += 1 }
	noted(r, COMMENT_MARK + slice_of(r, r.at + opener, end))
	r.at = end
	r.blank = yes
}

# `/* … */` and `/# … #/`, nested; a comment counts as a blank between items
block_comment(r: Reader) := {
	opener = slice_of(r, r.at, r.at + 2)
	closer = r.code[r.at + 1] + "/"
	depth = 0
	start = r.at
	while r.at < r.n {
		if slice_of(r, r.at, r.at + 2) == opener { depth += 1; r.at += 2 }
		else if slice_of(r, r.at, r.at + 2) == closer { depth -= 1; r.at += 2; if depth == 0 { break } }
		else { if r.code[r.at] == '\n' { r.line += 1; r.line_start = r.at + 1 }; r.at += 1 }
	}
	if depth > 0 { r.at = start; failed(r, "this comment is never closed") }
	pending(r, slice_of(r, start + 2, r.at - 2).trim().split("\n").map(line => COMMENT_MARK + " " + line.trim()).join("\n"))
	r.blank = yes
}

noted(r: Reader, comment: text) := {
	atom = r.line_atom
	if atom != ø then attach_comment(atom, comment) else pending(r, comment)
}
pending(r: Reader, comment: text) := { r.comments.add(comment) }
attach_comment(t: Lexeme, comment: text) := { t.node = commented(t.node, [comment], TRAILING) }
