# The tokens of a phrase as the operator stage reads them (core/parse/operators.wap): each item with whether it touches
# its neighbours, a glued run of glyphs joined to the longest spelling the operator table knows (`=` `>` is `=>`), and
# an operator glued to the brackets after it called like any `f(x)`.
use "operator_table.wap"
use "atoms.wap"
use "../errors.wap"
use "../stage.wap"
use "../../kernel/forms.wap"
use "../../types/operators.wap"
use "../language.wap"

# an item of a phrase and whether it touches the item before and the item after it with no blank between
# and whether it stands for a name where an operator could not stand (operators.wap names_marked)
class Spaced { item: Node, glued_before: bool, glued_after: bool, named: bool = no }

# the tokens of a space phrase: a glued run among its items contributes each of its own items
tokens_of(language: Language, items: list) as list := {
	tokens = []
	for item in items {
		match item {
			List(run, Bracket.None, Separator.None) => tokens += glued_tokens(language, run)
			_ => tokens.add(Spaced(item, no, no))
		}
	}
	tokens
}

# the tokens of a glued run, adjacent glyphs joined to the longest operator the table knows (`=` `>` is `=>`)
glued_tokens(language: Language, run: list) as list := {
	items = signs_split(language, joined_glyphs(language, run))
	(1 to #items).map(i => Spaced(items#i, i > 1, i < #items))
}

# a sign glued after what ends an operand is an operator, `x²+1`, `‖-5‖-1`; after an operator it signs its number, `a*-1`
signs_split(language: Language, items: list) as list := {
	split = []
	for item in items {
		parts = fact_of(item, SIGNED)
		if split is not empty and parts != ø and not wants_operand(language, Spaced(split.last, no, no)) { split += items_of(parts!).map(part => placed_like(part, item)) } else { split.add(item) }
	}
	split
}

# the items of a glued run with each run of glyph symbols joined greedily to the longest known spelling
joined_glyphs(language: Language, run: list) as list := {
	joined = []
	i = 1
	while i <= #run {
		length = longest_spelling_at(language, run, i)
		if length == 1 { joined.add(run#i) } else { joined.add(placed_like(spelled_as(run#(i + length - 1), symbol(spelling_of(run, i, length))), run#i)) }
		i += length
	}
	joined
}

# how many symbols from position i spell the longest operator or alias the table knows, the last one perhaps called
# (`⊕` `s(a, b)`); 1 when none longer does
longest_spelling_at(language: Language, run: list, i: int) as int := {
	longest = 1
	length = 2
	while i + length - 1 <= #run and run#(i + length - 2) is symbol and declared_word(run#(i + length - 1)) != "" {
		if known_spelling(language, spelling_of(run, i, length)) { longest = length }
		length += 1
	}
	longest
}

spelling_of(run: list, i: int, length: int) as text := {
	spelled = ""
	for k in i to i + length - 1 { spelled += declared_word(run#k) }
	spelled
}

# a joined spelling keeps the call of its last symbol: `⊕` `s(a, b)` is `⊕s(a, b)`
spelled_as(last: Node, spelled: Node) as Node := match last { Key(head, Op.None, group) => Key(spelled, Op.None, group); _ => spelled }

known_spelling(language: Language, spelled: text) as bool := operator_spelled(language, spelled) != ø or aliases_spelled(spelled) is not empty or compound_assignment(language, spelled) != ""

# A symbol glued to the bracket group after it, with nothing glued before it, is called like any `f(x)`, an operator or
# a glyph nobody declared alike (wiki/operator.md: a free symbol is a name): `+(a, b)` is the glued head
# Key(+, None, (a, b)), whatever fixities + has; `a-(b)` stays a subtraction
operators_called(language: Language, tokens: list) as list := {
	called = []
	i = 1
	while i <= #tokens {
		token = tokens#i
		if i < #tokens and token.item is symbol and token.glued_after and not token.glued_before and is_bracketed(tokens#(i + 1).item) {
			called.add(Spaced(Key(token.item, Op.None, tokens#(i + 1).item), no, tokens#(i + 1).glued_after))
			i += 2
		} else {
			called.add(token)
			i += 1
		}
	}
	called
}

is_bracketed(n: Node) as bool := match n { List(items, bracket, separator) => bracket != Bracket.None; _ => no }

# An operator where none can stand is a name, a parameter's or a field's: one ending the phrase (`from != to`), a word
# glued to what follows it (`to.length`), as a glyph glued so is a prefix, or a word right after an operator that wants
# an operand (`" and " + to + " b"`), where only a prefix could stand
names_marked(language: Language, tokens: list) as list := (1 to #tokens).map(i => if stands_as_name(language, tokens#i, i == #tokens, if i > 1 then tokens#(i - 1) else ø) then Spaced(tokens#i.item, tokens#i.glued_before, tokens#i.glued_after, yes) else tokens#i)
stands_as_name(language: Language, token: Spaced, last: bool, before: Spaced?) as bool := match token.item {
	Symbol(spelling) => last or not is_glyph(spelling#1) and (token.glued_after or wants_operand(language, before) and reading_as(language, token.item, Fixity.Prefix) == ø)
	_ => no
}
# an operator token before an operand, infix or prefix and never postfix: `+`, `not`, but `³` stands after its operand
wants_operand(language: Language, token: Spaced?) as bool := token != ø and reading_as(language, token.item, Fixity.Postfix) == ø and (reading_as(language, token.item, Fixity.Infix) != ø or reading_as(language, token.item, Fixity.Prefix) != ø)

# A declared opening glyph where an operand starts brackets the tokens up to its closing one, `‖-5‖` is (Call ‖ -5);
# the place of that closing glyph, nested pairs counted, 0 for no opening glyph
closing_at(language: Language, tokens: list, i: int) as int := {
	opening = declared_word(tokens#i.item)
	if not language.circumfix.has(opening) { return 0 }
	depth = 0
	for k in i + 1 to #tokens {
		spelled = declared_word(tokens#k.item)
		if spelled == language.circumfix[opening] and depth == 0 { return k }
		if spelled == language.circumfix[opening] { depth -= 1 } else if spelled == opening { depth += 1 }
	}
	refused(tokens#i.item, "no ${language.circumfix[opening]} closes this ${opening}")
}

# the next token where it can start an operand: a word, a literal, a group, or a prefix operator; ø where it cannot,
# and at the phrase's end
operand_after(language: Language, next: Spaced?) as Spaced? :=
	if next != ø and (next.named or reading_as(language, next.item, Fixity.Prefix) != ø or reading_as(language, next.item, Fixity.Infix) == ø and reading_as(language, next.item, Fixity.Postfix) == ø) then next else ø

