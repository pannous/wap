# The paths of the files a program uses (core/analyze/declarations.wap): a used path read against the folder of the
# file that names it, its `.` and `..` parts resolved, so each file has one spelling.

# the file `use` names, beside the file naming it: "../stage.wap" used by "core/analyze/scope.wap" is "core/stage.wap";
# the build's own file where it reads one in a library file's place
beside(file: text, used: text) as text := in_place(normalized_path(if used.starts_with("/") then used else folder_of(file) + "/" + used))
# the files a build reads in library files' places, by the end of the path each stands in for (core/emit/memory.wap
# files): "types/text_bytes.wap" read as "types/memory_texts.wap"
# set by the build that has them (compiler.wap native), a global since `beside`'s callers hold no language
placed_files: map<text, text> = {}
in_place(path: text) as text := {
	own = placed_files.keys.find(end => ("/" + path).ends_with("/" + end)) ?? return path
	path.replace(own, placed_files[own])
}
# the names in the folder of a file, by name, so a compile reads them in one order whatever the host lists
names_beside(file: text) as list<text> := list_files(folder_of(file)).sorted
LIBRARY_FOLDER = "lib"
# the standard library: lib beside the compiler's folder (a seed's), else one folder above it (the tree's
# wap/compiler.wap reads <tree>/lib); with neither the one beside, which lists nothing
library_of(folder: text) as text := library_places(folder).find(library => exists(library)) ?? library_places(folder)#1
library_places(folder: text) as list<text> := [folder, folder_of(folder)].map(at => normalized_path(at + "/" + LIBRARY_FOLDER))
# the names in a folder, none where there is no such folder
listed_in(folder: text) as list<text> := try { list_files(folder) } else []
# a path without empty and `.` parts, each `..` taking back the part before it; "." for none
normalized_path(path: text) as text := {
	absolute = path.starts_with("/")
	kept = []
	for part in path.split("/") {
		if part == ".." and kept and kept.last != ".." {
			kept = kept[.. #kept - 1]
		} else if part == ".." {
			if not absolute { kept += [part] }
		} else if part != "" and part != "." { kept += [part] }
	}
	written = kept.join("/")
	if absolute then "/" + written else if written == "" then "." else written
}
