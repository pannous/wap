# The stages in order (the table in compiler.wap), one function per step from source to typed program, shared by the
# compiler and the census (scripts/wap-census.warp), so neither can skip a stage.
use "../kernel/forms.wap"
use folder
use "parse/reader.wap"
use "parse/raw.wap"
use "parse/operators.wap"
use "parse/operator_table.wap"
use "analyze/declarations.wap"
use "rules/stages.wap"
use "rules/lowering.wap"
use "analyze/scope.wap"
use "analyze/library.wap"
use "analyze/types.wap"
use "rules/typed.wap"
use "rules/declared.wap"
use "stage.wap"
use "bindings.wap"
use "parse/cascade.wap"
use "analyze/modules.wap"

# the patterns of the kernel forms and the rules of the spellings every program may use, loaded as data
RULES_FILE = "types/rules.wap"
# SCRIPT on the block of a program run as a script, whose last value it shows: a rule may ask it, `where script`
SCRIPT = "script"

# the rules files a list of them uses, every program's unless another list is named, each file read with the rules of
# the files before it loaded
rules_files_loaded(language: Language, wap_folder: text, listed: text = RULES_FILE) := { for file in used_files(listing(language, in_folder(wap_folder, listed))) { based(language, file) } }
# a file listing files by its uses, read once, kept beside the files operated, so a warm state holds it too and no
# source of it is read (extensions/warm.wap)
listing(language: Language, file: text) as Node := {
	if not language.operated.has(file) { language.operated[file] = Operated(notation(source_of(language, file), file), []) }
	language.operated[file].code
}
# a rules file's grammar joined to the one every file starts from, which it is read in from then on, as a module too
based(language: Language, file: text) := {
	joined(language.base, grammar_of(language, file))
	language.grammars[file] = language.base
	# its patterns taken in again there once it is used as a module, their shapes read in the whole base
	language.operated[file].rest = ø
}
# the types module declared, its grammar the base: every file is read in it
types_declared(language: Language, wap_folder: text, types_file: text = TYPES_FILE) as Module := {
	program_operated(language, in_folder(wap_folder, types_file))
	types = module_declared(declared_file(language, in_folder(wap_folder, types_file)))
	grammar = language.grammars[types.file]
	based(language, types.file)
	# the base holds what the types module's grammar holds, whose rules' termination its reading checked
	checked_as(language.base, grammar)
	language.grammar = language.base
	types
}
# the names a program's file defines at its top, its own words: a rule head led by one of them is the program's own
# definition, never a rule (rules/stages.wap programs_own); aliases no longer look at them
words_known(language: Language, program: Node) := words_defined(program, language.grammar.words)
# a file of the wap folder, its path spelled as a used module's is, so a place names its file one way
in_folder(folder: text, file: text) as text := normalized_path(folder + "/" + file)
# a file's notation, its source read by the reader the language has for its ending (compiler.wap hands them in: a
# compiled module's), else as text
read_notation(language: Language, file: text) as Node := readable(notation_of(language, file))
# a file's notation, read in one scan, each line told the pipeline before it is read
notation_of(language: Language, file: text) as Node := {
	language.unparsed[file] = {}
	notation(source_of(language, file), file, line => line_told(language, file, line))
}
# a line of a file before it is read: the files a `use` line names operated, so their operators read below it, `use
# math` before ‖x‖; the words of a raw or phrase parameter it and they define, read unparsed from there on
line_told(language: Language, file: text, line: text) as map<text, text> := {
	words = unparsed_written(line)
	if line.starts_with(USE_WORD + " ") { for used in used_files(notation(line, file)) { operated_file(language, used); if language.unparsed.has(used) { words.update(language.unparsed[used]) } } }
	language.unparsed[file].update(words)
	words
}
source_of(language: Language, file: text) as text := {
	source = read(file)
	sources_read[file] = source
	source
}
# notation the reader could read, an Error of it refused where the reader failed (core/parse/reader.wap notation)
readable(code: Node) as Node := match code {
	Error(Key(Text(why), op, failure)) => refused(failure, why)
	_ => code
}

# read code with its operators read, its spellings rewritten by the shape rules, then declared
declared_code(language: Language, code: Node) as Node := declared_operated(language, operated_program(language, code))
declared_operated(language: Language, code: Node) as Node := declared_program(shaped_program(language, code))
# a file's code declared once a compile, shaped in its grammar
declared_file(language: Language, file: text) as Node := {
	grammar_of(language, file)
	operated = language.operated[file]
	if operated.rest == ø { rules_taken(language, file) }
	if operated.declared == ø { operated.declared = read_in(language, file, () => declared_program(shaped_rest(language, operated.code, operated.rest!))) }
	operated.declared!
}
# a file's code with its operators read, each `include "file"` in it replaced by that file's statements, as they are
# (wiki/use.md); a program's file has the names it defines at its top known before its operators are read
operated_file(language: Language, file: text) as Node := operated_once(language, file, no)
program_operated(language: Language, file: text) as Node := operated_once(language, file, yes)
# each file read and operated once a compile, or brought in operated already (extensions/warm.wap), by the build's
# bringer of its ending
operated_once(language: Language, file: text, program: bool) as Node := {
	if not language.operated.has(file) and not brought(language, file, "." + file.split(".").last) {
		# a use back while it is read finds it taken
		language.operated[file] = Operated(Empty, [])
		notation = read_notation(language, file)
		# the files it uses first, so their operators read in it too, `use math` before ‖x‖; a use back finds it read
		language.operated[file] = Operated(notation, words_named(notation))
		read_in_own(language, file, used_files(notation), () => operated_notation(language, file, notation))
	}
	if program { for word in language.operated[file].words { grammar_of(language, file).words[word] = yes } }
	language.operated[file].code
}
brought(language: Language, file: text, ending: text) as bool := language.build.bringers.has(ending) and language.build.bringers[ending](language, file)
# the grammar a file is read in: the base's, then those of the files it uses; a file brought in operated already
# (extensions/warm.wap) gets its own when first asked
grammar_of(language: Language, file: text) as Grammar := {
	code = operated_file(language, file)
	if not language.grammars.has(file) { read_in_own(language, file, used_files(code), () => code) }
	language.grammars[file]
}
# a file's code made in a grammar of its own, its rules then taken in
read_in_own(language: Language, file: text, uses: list<text>, reading: () -> Node) := {
	grammar = Grammar([], [])
	grammar.file = file
	# a use back while it is read finds this one, still growing
	language.grammars[file] = grammar
	joined(grammar, language.base)
	checked_as(grammar, language.base)
	declaring = uses.map(used => grammar_of(language, used)).filter(used => used.declares)
	for used in declaring { joined(grammar, used) }
	grammar.declares = declaring is not empty
	language.operated[file].code = read_in(language, file, () => { related_groups(language); reading() })
	rules_taken(language, file)
}
# a file's rules and patterns taken into its grammar, what is left of its code kept for its shaping
rules_taken(language: Language, file: text) := { language.operated[file].rest = read_in(language, file, () => rules_loaded(language, language.operated[file].code)) }
# work done in a file's grammar, or in the one at hand for code of a file read no grammar
read_in(language: Language, file: text, work: () -> T) as T := {
	held = language.grammar
	language.grammar = language.grammars.get(file) ?? held
	done = work()
	language.grammar = held
	done
}
# the files the `use` lines of a source name, read on their own
# a file's notation with its operators read and its includes in
operated_notation(language: Language, file: text, notation: Node) as Node := {
	code = operated_program(language, notation)
	match code {
		List(lines, Bracket.None, Separator.Newline) => refitted(List(lines.flat_map(line => included(language, file, line)), Bracket.None, Separator.Newline), code)
		_ => code
	}
}
# a line of a file, or the lines of the file it includes
included(language: Language, file: text, line: Node) as list<Node> := {
	path = phrase_text(line, INCLUDE_WORD) ?? return [line]
	# what the included file declares is the including file's from here on (wiki/use.md)
	joined(language.grammar, grammar_of(language, beside(file, path)))
	match operated_file(language, beside(file, path)) {
		List(lines, Bracket.None, Separator.Newline) => lines
		code => [code]
	}
}
# a file with the modules it uses, theirs first, each declared after the modules it uses, so their rules shape it
declared_modules(language: Language, file: text) as list<Module> := {
	code = program_operated(language, file)
	used_modules(language, code) + [module_declared(declared_file(language, file))]
}
# the modules operated code uses, theirs first, each declared
used_modules(language: Language, code: Node) as list<Module> := modules_used(code, file => if language.modules.has(module_key(file)) then language.modules[module_key(file)].code else operated_file(language, file)).map(module => used_module(language, module))
# a used module declared, or the one this compile declared already from its file; code of no file is declared anew
used_module(language: Language, code: Node) as Module := {
	key = module_key(file_of(code) ?? return declared_module(language, code))
	if language.modules.has(key) { return language.modules[key] }
	module = module_declared(declared_file(language, file_of(code)!))
	language.modules[key] = module
	module
}
# the key a module's file is cached under, one spelling of its path
module_key(file: text) as text := normalized_path(file)
declared_module(language: Language, code: Node) as Module := module_declared(declared_operated(language, code))
# a declared module lowered and bound inside the modules it uses and the types module's declarations
# and the standard library's words beyond, a word of a module it does not use bound to that module (standard_brought)
prepared(language: Language, module: Module, modules: list<Module>, types: Module) as Block := bound_program(lowered_module(language, module, modules, types), library_around(module, types), modules_of_uses(module, modules), language.build.standard)
# a declared module lowered, the declaration rules first (stage 2), reading what the module, the modules it uses and
# the types module declare; a library module the warm state brought in lowered already
lowered_module(language: Language, module: Module, modules: list<Module>, types: Module) as Block := {
	if language.lowered.has(module_key(module.file)) { return language.lowered[module_key(module.file)] }
	uses = modules_of_uses(module, modules)
	read_in(language, module.file, () => lowered_program(language, declared_rewritten(language, module, library_around(module, types) + uses.flat_map(used => used.signatures))))
}
# the modules a declared module uses, of a standard module it names without its `use` only the words it names
modules_of_uses(module: Module, modules: list<Module>) as list<Module> := module.uses.map(file => narrowed(module_of(file, modules), module.named.filter(name => file in standard_sources(name)).map(name => text(name))))
narrowed(used: Module, words: list<text>) as Module := if words is empty then used else Module(used.file, used.code, used.uses, used.signatures.filter(signature => signature.name in words))
# A standard module's word named without its `use` (wiki/use.md "Library folders"): the modules again, each standard
# module named brought in before them and used by the module naming it, with a note; a module with rules refused, its
# rules would change what the code means unasked
standard_brought(language: Language, modules: list<Module>, named: list<Node>) as list<Module> := {
	files = named.flat_map(standard_sources).unique
	for file in files { if ruled(operated_file(language, file)) { refused(named.find(name => file in standard_sources(name))!, "${file_module_name(file)} has rules, which change what code means: write use ${file_module_name(file)}") } }
	# a word a rule wrote is brought in unsaid: the program never named it; a use-free module's word needs no use
	written = named.filter(name => not has_fact(name, DERIVED) and not standard_sources(name).all(file => file_module_name(file) in language.build.use_free_modules))
	for word in written.map(name => text(name)).unique {
		name = written.find(first => text(first) == word)!
		sources = standard_sources(name).map(file_module_name)
		hint(place_of(name) + "${name} comes from ${sources.join(" or ")}: write ${sources.map(source => "use " + source).join(" or ")}")
	}
	brought = files.flat_map(file => used_modules(language, operated_file(language, file)) + [used_module(language, operated_file(language, file))]).unique.filter(module => not modules.any(other => other.file == module.file))
	brought + modules.map(module => standard_used(module, named.filter(name => file_of(name) == module.file)))
}
# the names code binds to a standard module's word
standard_named(n: Node) as list<Node> := if is_kind_word(fact_of(n, BINDING), DefinitionKind.Standard) then [n] else direct_parts(n).flat_map(standard_named)
# the modules a standard word was bound to
standard_sources(name: Node) as list<text> := fact_items(name, DEFINED_AT).map(file => text(file))
# a module using the standard modules whose words it names, seeing those words alone
standard_used(module: Module, named: list<Node>) as Module := if named is empty then module else Module(module.file, module.code, module.uses + named.flat_map(standard_sources).unique, module.signatures, module.named + named)
# whether operated code declares rules
ruled(code: Node) as bool := top_level_statements(code).any(statement => match statement { Call(called, arguments) => spelling_written(called) == RULE_ARROW and #arguments == 2 and spelling_written(phrase_items(arguments#1)#1) == RULE_WORD; _ => no })
# the library a module is bound inside: the types module's declarations, except in the types module, which declares them
# itself
library_around(module: Module, types: Module) as list<Signature> := if module.file == types.file then [] else types.signatures
# the modules prepared in order, each bound among all the modules, their statements as one block, each module's kept
# by its file for a pass again
modules_prepared(language: Language, preparing: list<Module>, modules: list<Module>, types: Module, program: text, kept: map<text, list<Node>> = {}) as Block := Block(preparing.flat_map(module => kept.get(module.file) ?? kept.setdefault(module.file, called_only(module, statements_in(prepared(language, module, modules, types)), program))))
# a used module's definitions are typed, and so emitted, once something calls them, as the types module's are, and its
# values of a written type once something reads them; the program's own and the exports always are
called_only(module: Module, statements: list, program: text) as list := {
	exported = fact_items(module.code, EXPORTS).map(name => text(name))
	held = (name: Node) => module.file != program and not exported.contains(text(name))
	statements.map(statement => if statement is Define and held(defined_name(statement)) then with_fact(statement, TYPED_WHEN_CALLED, True) else if statement is Set and declared_type(statement) != ø and held(declared_name(statement)) then with_fact(statement, TYPED_WHEN_READ, True) else statement)
}
# the types module's code after the modules it uses, whose words only the types module sees: its functions bound once
# typing reaches them (core/analyze/scope.wap library_bound)
library_code_of(language: Language, types: Module) as Library := {
	uses = used_modules(language, types.code)
	bound = (uses + [types]).map(module => library_bound(lowered_module(language, module, uses, types), modules_of_uses(module, uses), library_around(module, types)))
	scopes: map<text, Scope> = {}
	for library in bound { scopes.update(library.scopes) }
	Library(Block(bound.flat_map(library => statements_in(library.code))), scopes, (uses + [types]).flat_map(module => module.signatures))
}
# the program with the modules it uses, theirs first: a module's statements run before the code that uses it, its
# functions are there for any caller; typed, then rewritten by the typed rules. The types module compiled as the program
# is its own library, with none around it. A module the types module uses is the library's, declared once per compile
# (core/language.wap): the program binds to it, never prepares it again. The program names the file whose definitions
# are typed though nothing calls them, "" for none
# DEBT: One types file compiled alone as the program (types/floats.wap) still brings its definitions twice, the file
#   being the program and part of the library around it: calls.wap refuses "two definitions share the key". Off the
#   census: only the whole types module compiles as a program. Paid off by binding such a file inside the rest of the
#   types module only.
typed_modules(language: Language, modules: list<Module>, types: Module, program: text, kept: map<text, list<Node>> = {}) as Block := {
	own = library_place(modules.last.file) == library_place(types.file)
	held = if own then [] else used_modules(language, types.code).map(module => module.file)
	program_modules = modules.filter(module => not (module.file in held))
	whole = with_fact(modules_prepared(language, program_modules, modules, if own then modules.last else types, program, kept), SCRIPT, True)
	named = standard_named(whole)
	# a pass again with the standard words' modules: bringing a module in changes only the binding of the modules that
	# name its words, so they and the brought modules are prepared anew, every other module's statements kept
	if named is not empty {
		for name in named { kept.remove(file_of(name)!) }
		return typed_modules(language, standard_brought(language, modules, named), types, program, kept)
	}
	library_code = if own then Library(Block([]), {}) else library_code_of(language, types)
	read_in(language, modules.last.file, () => typed_by_rules(language, whole, if own then [] else types.signatures, library_code, program_modules.flat_map(module => module.signatures), modules.last.signatures, runs_statements(modules.last.code)))
}
