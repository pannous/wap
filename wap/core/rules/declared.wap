# Declaration rules (stage 2): declared surface → declared surface (wiki/rule.md
# "Holes"). A rule with a hole that asks the declarations, `$f: function` or `$p: predicate`, runs after declare and
# before lowering, on the code stage 1 shaped (core/rules/patterns.wap hole_stage).
#
#   rule $x is $p: predicate => $p($x)     `xs is empty` is empty(xs), empty declared a test of one value
use folder
use "../analyze/declarations.wap"
use "../analyze/modules.wap"
use "../stage.wap"
use "../../kernel/forms.wap"
use "../language.wap"
use "../bindings.wap"

# A declared module rewritten by the declaration rules (stage 2), which read the declarations in force: the module's
# own, then the library's, those of the modules it uses and the types module's. A name nothing at the top declares is no
# function to them, so a local that hides a declared one is binding's to refuse (core/analyze/scope.wap)
declared_rewritten(language: Language, module: Module, library: list<Signature>) as Node := {
	language.declarations.by_name = declarations_by_name(module.signatures + library)
	# a class the rules wrote is in force for them again, `class C extends B` where B extends A: what they wrote is
	# declared and rewritten once more. Either way the code given back is the rules' rewrite of a declared program
	code = with_facts_of(rewritten_by(language, language.declared_rules, module.code).code ?? Block([]), module.code)
	rewritten = module_declared(declared_program(code))
	if #rewritten.signatures > #module.signatures then declared_rewritten(language, rewritten, library) else code
}
declarations_by_name(signatures: list<Signature>) as map<text, list<Signature>> := {
	by_name: map<text, list<Signature>> = {}
	for signature in signatures {
		name = signature.name
		continued(by_name, name, [signature])
	}
	by_name
}
