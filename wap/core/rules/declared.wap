# Declaration rules (stage 2): declared surface → declared surface (notes/kernel.md "How a program reaches the
# kernel"). A rule with a hole that asks the declarations, `$f: function` or `$p: predicate`, runs after declare and
# before lowering, on the code stage 1 shaped (core/rules/patterns.wap hole_stage).
#
#   rule $x is $p: predicate => $p($x)     `xs is empty` is empty(xs), empty declared a test of one value
use "stages.wap"
use "patterns.wap"
use "../analyze/declarations.wap"
use "../analyze/modules.wap"
use "../stage.wap"
use "../../kernel/forms.wap"
use "../language.wap"
use "../bindings.wap"

# A declared module rewritten by the declaration rules (stage 2), which read the declarations in force: the module's
# own, then the library's, those of the modules it uses and the preload's. A name nothing at the top declares is no
# function to them, so a local that hides a declared one is binding's to refuse (core/analyze/scope.wap)
declared_rewritten(language: Language, module: Module, library: list<Signature>) as Node := {
	language.declarations.by_name = declarations_by_name(module.signatures + library)
	with_facts_of(rewritten_by(language, language.declared_rules, module.code).code ?? Block([]), module.code)
}
declarations_by_name(signatures: list<Signature>) as map<text, list<Signature>> := {
	by_name: map<text, list<Signature>> = {}
	for signature in signatures {
		name = signature.name
		by_name[name] = (if by_name.has(name) then by_name[name] else []) + [signature]
	}
	by_name
}
