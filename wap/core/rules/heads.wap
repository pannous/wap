# The heads rules are indexed by (rules/stages.wap rule_added) and code is looked up under (rule_applied): the words and
# shapes a node starts with, so a node tries only the rules that could fit it.
use "patterns.wap"
use "matcher.wap"
use "../parse/operators.wap"
use "../stage.wap"
use "../language.wap"

# the head of a pattern that starts with a hole: tried on every node
NO_HEAD = ""
# the head of a pattern that is one word, before the word
WORD_HEAD = "word "

# The heads a node is indexed under, most specific first: a phrase's first word, a declared form's name with its
# first word (`Call/+` for (Call + a b)), a key's operator, a word alone; NO_HEAD last, where rules starting with a hole wait.
heads_of(language: Language, n: Node) as list<text> := match n {
	List(items, bracket, separator) => list_heads(language, items) + shape_heads(items, bracket, separator) + [NO_HEAD]
	Key(left, Op.None, List(items, bracket, separator)) => glued_heads(left, bracket) + ["key " + (Op.None as text), NO_HEAD]
	Key(left, Op.None, Empty) => EMPTY_GROUPS.flat_map(bracket => glued_heads(left, bracket)) + ["key " + (Op.None as text), NO_HEAD]
	Key(left, op, right) => ["key " + (op as text), NO_HEAD]
	# a word standing alone, `break`: the rules of that one word, apart from those of the phrases it heads
	Symbol(name) => [WORD_HEAD + canonical_word(spelling_written(n)), NO_HEAD]
	_ => [NO_HEAD]
}
# A list under its bracket and separator, then its bracket alone: `$then... if $c` is a space phrase starting with a hole,
# indexed there, not among the rules tried on any code; a pattern of one part matches any separator, so it waits under
# its bracket
shape_heads(items: list, bracket: Bracket, separator: Separator) as list<text> := (if #items > 1 then ["${bracket} ${separator}"] else []) + ["${bracket}"]

# a glued call or index, `f(x)`, `xs[i]`: under its name and bracket, then under its bracket alone (`$f($x)`, `$xs[$i]`)
glued_heads(left: Node, bracket: Bracket) as list<text> := (if left is symbol and not is_hole(left) then ["${canonical_word(spelling_written(left))} ${bracket}"] else []) + ["glued ${bracket}"]

list_heads(language: Language, items: list) as list<text> := {
	if #items == 0 or is_hole(items#1) or not (items#1 is symbol) { return [] }
	first = canonical_word(spelling_written(items#1))
	if language.patterns.has(first) and #items > 1 and items#2 is symbol and not is_hole(items#2) { return [first + "/" + spelling_written(items#2), first] }
	[first]
}
