# A program's lines as the rules read them (stage 1, core/rules/stages.wap): a line that starts with a word rules use only
# inside their phrases continues the line before, and a block the reader glued below a phrase belongs to the phrase.
use "patterns.wap"
use "../parse/operators.wap"
use "../parse/operator_table.wap"
use "../stage.wap"
use "../../kernel/forms.wap"
use "../language.wap"

# the items of a list, a block's lines continued
lines_of(language: Language, items: list, separator: Separator) as list := if STATEMENT_SEPARATORS.contains(separator) then lines_continued(language, items).map(line => own_line(language, line)) else items

# A line that starts with a word rules spell inside their phrases but start none with continues the statement before
# it when that statement opened one of the word's phrases: `if c {a}⏎else {b}` is one if, so is a `then` or `else` at a
# line's start; a line ending in such a word of a phrase it opened takes the next line, and only that one:
# `if c then⏎"a"⏎else⏎"b"` is one if. A word of a phrase not opened is the program's own (core/parse/operators.wap).
lines_continued(language: Language, statements: list) as list := {
	joined = []
	for statement in statements {
		before = if joined is empty then [] else phrase_items(joined.last)
		if continued(language, before, statement) { joined[#joined - 1] = replaced(joined.last, List(before + phrase_items(statement), Bracket.None, Separator.Space)) } else { joined.add(statement) }
	}
	joined
}
# a line led by such a word that continues no phrase is the program's own, and so is the assignment the reader gave the
# phrase's last word: `text t = "a"`, text spelled inside the c extension's phrases, is (text t) = "a" again
own_line(language: Language, statement: Node) as Node := match statement {
	List(items, Bracket.None, Separator.Space) => match items.last { Call(called, parts) => if continuation_word(language, spelling_written(items#1)) and spelling_written(called) == ASSIGNMENT then replaced(statement, Call(called, [List(items[.. #items - 1] + [parts#1], Bracket.None, Separator.Space), parts#2])) else statement; _ => statement }
	_ => statement
}
continued(language: Language, before: list, statement: Node) as bool := before is not empty and (continues(language, statement, before) or continuation_item(language, before.last, before))
# The lines indented below a phrase, which the reader glues to its last word as a block, belong to the phrase: they
# continue it when they start with such a word, `x = if c then 1⏎	else 2` is `x = if c then 1 else 2`; otherwise the
# block is the phrase's last part, `if c⏎	print "a"` is `if c {print "a"}`. A block glued on its line, `Point{x: 1}`,
# stays its word's. ø when no block is glued to a phrase.
unglued(language: Language, n: Node) as Node? := match n {
	List(items, Bracket.None, Separator.Space) => {
		split = block_split(items.last) ?? return ø
		taken = block_taken(language, split#2, items) ?? return ø
		replaced(n, List(items[.. #items - 1] + [split#1] + taken, Bracket.None, Separator.Space))
	}
	_ => ø
}
# a phrase with the block glued on its line taken apart, where no rule fits it glued: `class Point{x: int}` is
# `class Point {x: int}`; ø when no block ends it
apart(n: Node) as Node? := match n {
	List(items, Bracket.None, Separator.Space) => replaced(n, List(items[.. #items - 1] + (block_split(items.last) ?? return ø), Bracket.None, Separator.Space))
	_ => ø
}
# the code a block is glued to at its end, and that block: `1{else 2}`, `i in xs{…}` the operator's right side; ø when
# no block ends it
block_split(n: Node) as list<Node>? := match n {
	Key(word, Op.None, block) => if is_block(block) then [word, block] else ø
	Call(called, arguments) => {
		inner = if arguments is empty then ø else block_split(arguments.last)
		if inner == ø then ø else [replaced(n, Call(called, arguments[.. #arguments - 1] + [inner#1])), inner#2]
	}
	_ => ø
}
# the parts a glued block gives the phrase it ends, ø where it stays glued
block_taken(language: Language, block: Node, phrase: list) as list? := match block {
	List(lines, Bracket.Curly, separator) => {
		continued = lines_continued(language, if STATEMENT_SEPARATORS.contains(separator) then lines else [List(lines, Bracket.None, separator)])
		if #continued == 1 and continues(language, continued#1, phrase) then phrase_items(continued#1) else if fact_of(block, INDENTED) != ø then [block] else ø
	}
	_ => ø
}
continues(language: Language, statement: Node, opening: list) as bool := continuation_item(language, phrase_items(statement)#1, opening)
