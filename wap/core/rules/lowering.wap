# Declared code → kernel forms (wap/compiler.wap, the forms: wap/kernel/forms.wap;
# the operated shapes it reads: notes/backbone.md "Stage languages").
#
# The rules have written the kernel forms of words (sugar/: yes, break, global, if, while …); this stage
# writes the general ones, which no word names: calls, definitions, data and blocks, one arm per form. A phrase
# becomes a call of its head; typing refuses one whose head holds no function.
#   print "Hello"            a phrase, a word then its arguments → Call(print, ["Hello"])
#   f(1, 2)                  a head glued to its arguments, Key(f, Op.None, (1, 2)) → Call(f, [1, 2])
#   make(1)(2)               any head glued to them, a call of its value: Call(Call(make, [1]), [2])
#   Point{x: 1, y: 2}        an instance, data as the reader reads it, its fields' values lowered
#   x: int                   a typed name, a record's field or a parameter, as written
#   a + b                    an operator call, (Call + a b) → Call(+, [a, b])
#   x = 1                    (Call = x 1) → Set(x, 1)
#   let x = 1, global x = 1  (Call = (Variable x local) 1), the sugar's → Set(x, 1) with the fact which variable it
#                            assigns: a new one here, the program's
#   f(x) := body             (Call := f(x) body) → Define(f, [x], body); `n := 1` → Define(n, [], 1)
#   x => x + 1               (Call => x (x + 1)) → Fn([x], x + 1); `(a, b) -> a + b` likewise, -> and => both
#                            write a function value
#   { a; b }                 a block of code → Block([a, b]); a program's statements likewise
#   (x + 1)  (a; b)          a group: its one statement, several a Block
#   [a, b]                   a list, data as the reader reads it, its items lowered
#   a, b                     a row is a list wherever it stands as a value: `[1, 2⏎3]` is [[1, 2], 3]; in braces
#                            rows of keys are the keys, `{a: 1, b: 2⏎c: 3}` one map of three
#   global x, let x          (Variable x global), the sugar's, named without a value: no statement, the fact on its
#                            Block which x it means
#   use "path"               a module brought in: no statement, read by the declare stage (core/analyze/declarations.wap)
#   (If c a b)               a kernel form a rule built (sugar: `if c then a else b`, `c ? a : b`, `a if c`,
#                            `unless c { a }`, `while c { b }`, `return x`, `prim print_text(t)`), its parts lowered
# A form not lowered yet is refused, naming it: never passed on to the emitter unlowered.

use "../analyze/declarations.wap"
use "../errors.wap"
use "../stage.wap"
use "../bindings.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"
use "../../kernel/surface.wap"
use "../parse/cascade.wap"
use "../parse/operator_table.wap"
use "patterns.wap"
use "matcher.wap"
use "termination.wap"
use "heads.wap"
use "../language.wap"
use "../paths.wap"

EMBEDDED_WORD = "embedded"

# the program as one Block of its statements
lowered_program(language: Language, program: Node) as Block := replaced(program, lowered_block(language, statements_of(program)))

# Statements as one Block. A Variable alone, `global x`, is no code: it says which variable x is in the whole block,
# the Block's fact VARIABLES, [x: global] (core/analyze/scope.wap)
lowered_block(language: Language, statements: list) as Node := {
	named = statements.filter(statement => statement is Variable)
	block = Block(all_lowered(language, statements.filter(statement => not (statement is Variable) and not is_use(statement))))
	if named is empty then block else with_fact(block, VARIABLES, data_list(named.map(variable_named)))
}
variable_named(statement: Node) as Node := match statement {
	Variable(name, kind) => Key(name, Op.Colon, kind)
	_ => refused(statement, "this statement names no variable")
}

# code as a kernel form, placed where the code was written (core/stage.wap)
lowered(language: Language, n: Node) as Node := replaced(n, lowered_form(language, n))
all_lowered(language: Language, items: list) as list<Node> := items.map(item => lowered(language, item))
lowered_form(language: Language, n: Node) as Node := match n {
	Text(value) => n
	Number(value) => n
	Char(value) => n
	True => n
	False => n
	Empty => n
	Symbol(name) => n
	Call(called, arguments) => operator_lowered(language, n, text(called), arguments)
	Key(head, Op.None, List(items, Bracket.Curly, separator)) => if head is symbol then Key(head, Op.None, fields_lowered(language, items, separator, n)) else not_lowered(n)
	# a type written with its parts, `list<Node>`, stays as written: a named argument's or a case's field's type
	Key(head, Op.None, List(items, Bracket.Less, separator)) => n
	Key(head, Op.None, group) => if is_embedded(head) then embedded_text(n, group) else Call(if head is symbol then head else lowered(language, head), call_arguments_lowered(language, head, arguments_of(group)))
	Key(name, Op.Colon, type) => if name is symbol then n else not_lowered(n)
	List(items, Bracket.Square, separator) => List(all_lowered(language, items), Bracket.Square, separator)
	List(items, Bracket.Curly, separator) => if items.all(is_fields) then fields_lowered(language, items, separator, n) else lowered_block(language, statements_of(List(items, Bracket.None, separator)))
	List(items, Bracket.None, Separator.Comma) => data_list(all_lowered(language, items))
	# an enum's cases are declarations, their fields' types as written (analyze/declarations.wap cases_lowered)
	Record(name, fields, variants) => Record(name, lowered(language, fields), cases_lowered(variants))
	# a kernel form a rule built, `(If c a b)`, `(Break)`, its parts lowered; any other group its statements
	List(items, Bracket.Round, separator) => if (separator == Separator.Space or #items == 1) and names_pattern(language, items#1) then List([items#1] + all_lowered(language, items[1 ..]), Bracket.Round, separator) else group_lowered(language, statements_of(List(items, Bracket.None, separator)))
	# values parted by blanks are a list of them, `(1 2)`, `v = 1 2 3` or `5 m`; a phrase headed by a word, a call of the word
	List(items, Bracket.None, Separator.Space) => if parted_map(items) then with_fact(data_list(all_lowered(language, items)), PARTED, n) else if is_value(items#1) then List(all_lowered(language, items), Bracket.Square, Separator.Space) else with_fact(phrase_lowered(language, items, n), PHRASED, True)
	# a word written against what follows it, `...rest`, as a phrase; an optional type, `nat?`, stays one
	List(items, Bracket.None, Separator.None) => if written_parts(n) != ø then n else phrase_lowered(language, items, n)
	_ => not_lowered(n)
}

# `embedded("file")`: the file's bytes as a text, read when the program is compiled, the path taken from the folder of
# the file that writes it (wiki/text.md "Embedded files")
is_embedded(head: Node) as bool := head is symbol and text(head) == EMBEDDED_WORD
embedded_text(n: Node, group: Node) as Node := Text(read(beside(file_of(n) ?? "", text(arguments_of(group)#1))))

# an operator call: the defining operators as their kernel forms, any other a call of the operator's function
operator_lowered(language: Language, n: Node, spelling: text, arguments: list) as Node := match spelling {
	"=" => assigned(language, n, arguments#1, if is_code_block(arguments#2) and names_it(arguments#2) then it_function(language, arguments#2) else lowered(language, arguments#2))
	":=" => defined(language, n, arguments#1, lowered(language, arguments#2))
	_ => if FUNCTION_ARROWS.contains(spelling) then Fn(parameter_list(language, arguments#1), lowered(language, arguments#2)) else Call(symbol(spelling), all_lowered(language, arguments))
}

# a phrase headed by a word, a call of the word; a number glued to what follows multiplies it, `2x` is 2 * x
# (wiki/significant-whitespace.md); spaced, `5 m`, they are a list
phrase_lowered(language: Language, items: list, n: Node) as Node := if items#1 is symbol then Call(items#1, call_arguments_lowered(language, items#1, items[1 ..])) else if items#1 is number and #items == 2 then Call(symbol("*"), all_lowered(language, items)) else not_lowered(n)

# whether code is a value, no word and no call that a phrase could continue: `g(2) { … }` gives its call a block
is_value(n: Node) as bool := match n {
	Symbol(name) => no
	Key(head, Op.None, group) => no
	_ => yes
}
# whether a word is parted by a blank from the map after it, `style {a: 1}`: two items, the list [style, {a: 1}], unless a
# typed rule takes the phrase (wiki/significant-whitespace.md, core/rules/typed.wap parted_rewritten)
parted_map(items: list) as bool := #items == 2 and items#1 is symbol and match items#2 { List(fields, Bracket.Curly, separator) => fields.all(is_fields); _ => no }

# `x = 1` gives x a value, `3 = 4` or `unknown = 0` (ø, which has no place of its own) none, refused where written; a
# Variable place, `let x = 1` or `global x = 1`, also says which variable x is (core/analyze/scope.wap)
assigned(language: Language, n: Node, place: Node, value: Node) as Node := match place {
	Variable(name, kind) => with_fact(Set(name, value), ASSIGNS, kind)
	_ => if is_place(language, place) then Set(lowered(language, place), value) else refused(n, "no place to assign: a name, a variable, a part or an item")
}
# a name, typed or not, a part or an item; a word a rule takes standing alone, `ø` (also written nothing), `yes`, is none
is_place(language: Language, place: Node) as bool := (place is symbol or place is Key or place is Get or place is Item) and rules_on(language.grammar.shape_rules, [WORD_HEAD + canonical_word("${declared_name(place)}")]) is empty

# `f(x) := body` defines a function, `n := 1` a constant, its parameter list unwritten (Bracket.None); `f(x): int := body` names its result type with the name
defined(language: Language, n: Node, head: Node, body: Node) as Node := match head {
	Key(signature, Op.Colon, result) => with_result(defined(language, n, signature, body), result)
	Key(name, Op.None, group) => if name is symbol then Define(name, parameter_list(language, group), body) else not_lowered(n)
	Symbol(name) => Define(head, if names_it(body) then parameter_list(language, symbol(IT_WORD)) else List([], Bracket.None, Separator.Comma), body)
	_ => not_lowered(n)
}
with_result(definition: Define, result: Node) as Node := match definition { Define(name, parameters, body) => Define(Key(name, Op.Colon, result), parameters, body) }

# what a head's brackets hold: `()` nothing, `(a, b)` its items, `(a)` or `(a b)` one argument
# a map's or an instance's fields, `{a: 1, b: 2}`, each value lowered: data, not a block
fields_lowered(language: Language, items: list, separator: Separator, n: Node) as Node := List(items.flat_map(written_fields).map(field => field_lowered(language, field, n)), Bracket.Curly, separator)
# a key, or a row of keys
is_fields(item: Node) as bool := match item {
	Key(name, Op.Colon, value) => yes
	List(row, Bracket.None, separator) => separator in FIELD_ROWS and row.all(is_fields)
	_ => no
}
# the rows fields are written in: with commas, or keys written tight without, `{x:1 y:2}` (wiki/map.md)
FIELD_ROWS = [Separator.Comma, Separator.Semicolon, Separator.Space]
written_fields(item: Node) as list<Node> := match item { List(row, Bracket.None, separator) => if separator in FIELD_ROWS then row.flat_map(written_fields) else [item]; _ => [item] }
# an instance's field, `x: 1`, its value lowered
# a call's argument lowered: a named one, `by: f`, its value
# a call's arguments, a block where every definition of the word takes code there a function of no parameters, run by
# its call: `twice { 4 }` of twice(body: block) (wiki/block.md "A block runs by a call"); code naming `it` where every
# definition takes a function of one parameter there, a function of it: `filter(xs, it > 1)`
call_arguments_lowered(language: Language, head: Node, arguments: list) as list<Node> := (1 to #arguments).map(at => {
	argument = arguments#at
	if is_deferred(argument) and takes_code(language, head, at, #arguments, 0, is_code_block(argument)) then Fn(parameter_list(language, Empty), lowered(language, argument)) else if names_it(argument) and takes_code(language, head, at, #arguments, 1, no) then it_function(language, argument) else argument_lowered(language, argument)
})
is_code_block(n: Node) as bool := match n { List(items, Bracket.Curly, separator) => not items.all(is_fields); _ => no }
# what a code place runs later: a block or any other code, `go f(3)`; a name, a named argument or a function value is
# passed as it is
is_deferred(n: Node) as bool := is_code_block(n) or not (n is symbol or match n { Call(called, parts) => FUNCTION_ARROWS.contains(text(called)); Key(name, Op.Colon, value) => yes; _ => no })
# whether every declaration of a word taking at least this many arguments takes code at this place: a block, or a
# function of that many parameters; for code written in braces one such declaration is enough, typing then chooses it
takes_code(language: Language, head: Node, at: int, count: int, taking: int, braced: bool) as bool := {
	declared = (if head is symbol then language.declarations.by_name.get(text(head)) ?? [] else []).filter(signature => #signature.parameters >= count)
	wanting = declared.filter(signature => wants_code(signature.parameters#at, taking))
	wanting is not empty and (braced or #wanting == #declared)
}
wants_code(type: Term?, taking: int) as bool := (taking == 0 and type == BLOCK_TERM) or #((function_parts(type) ?? return no).parameters) == taking

# `it`, the parameter code names without declaring it (wiki/function.md): `square := it * it` is square(it),
# `square = {it * it}` a function of it, `filter(xs, it > 1)` filters by one
IT_WORD = "it"
FUNCTION_ARROWS = ["=>"]
names_it(n: Node) as bool := match n {
	Symbol(name) => name == IT_WORD
	# a function value's `it` is its own
	Call(called, arguments) => not FUNCTION_ARROWS.contains(text(called)) and arguments.any(names_it)
	Fn(parameters, body) => no
	_ => direct_parts(n).any(names_it)
}
it_function(language: Language, code: Node) as Node := Fn(parameter_list(language, symbol(IT_WORD)), lowered(language, code))
argument_lowered(language: Language, argument: Node) as Node := match argument {
	Key(name, Op.Colon, value) => if name is symbol then field_lowered(language, argument, argument) else lowered(language, argument)
	# among a call's arguments `b = 1` names the parameter as `b: 1` does, and assigns nothing (wiki/argument.md)
	Call(called, parts) => if text(called) == ASSIGNMENT and parts#1 is symbol then field_lowered(language, refitted(Key(parts#1, Op.Colon, parts#2), argument), argument) else lowered(language, argument)
	_ => lowered(language, argument)
}
field_lowered(language: Language, field: Node, n: Node) as Node := match field {
	Key(name, Op.Colon, value) => refitted(Key(if name is symbol then name else lowered(language, name), Op.Colon, lowered(language, value)), field)
	_ => not_lowered(n)
}
arguments_of(group: Node) as list := match group {
	Empty => []
	List(items, Bracket.Round, Separator.Comma) => items
	List(items, Bracket.Round, Separator.None) => items
	_ => [group]
}

# the parameters a definition or a function value names, as the one list Define and Fn take
parameter_list(language: Language, written: Node) as Node := List(arguments_of(written).map(item => parameter_lowered(language, item)), Bracket.Round, Separator.Comma)
# a parameter as written; one with a default, `y: int = 2`, is the parameter with the default as its fact DEFAULT
parameter_lowered(language: Language, parameter: Node) as Node := match parameter {
	Call(called, arguments) => if is_default_given(parameter) then with_fact(arguments#1, DEFAULT, lowered(language, arguments#2)) else parameter
	_ => parameter
}

# round brackets group: one statement is itself, `(x + 1)`, several a Block, `(a; b)`
group_lowered(language: Language, statements: list) as Node := if #statements == 1 then lowered(language, statements#1) else lowered_block(language, statements)

# a sequence of statements gives each (core/analyze/declarations.wap), a group of one its item, any other node is the
# one statement
statements_of(n: Node) as list<Node> := match n {
	Block(statements) => statements
	List(items, Bracket.None, separator) => if #items == 1 then statements_of(items#1) else top_level_statements(n)
	_ => [n]
}

not_lowered(n: Node) := refused(n, "wap does not lower this form yet")
