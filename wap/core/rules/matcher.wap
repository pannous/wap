# The matcher: running a compiled Matcher (rules/patterns.wap) against code, each hole bound to the code it takes, and
# how specific a matcher is, so the most specific rule of a head wins. Input: a Matcher and Nodes; output: yes or no
# and the bindings.
use "patterns.wap"
use "../analyze/fits.wap"
use "../analyze/types.wap"
use "../parse/operators.wap"
use "../parse/operator_table.wap"
use "../../types/operators.wap"
use "../errors.wap"
use "../stage.wap"
use "../type_notation.wap"
use "../parse/atoms.wap"
use "../language.wap"
use "../../kernel/forms.wap"
use "../bindings.wap"
use "../analyze/modules.wap"
use "../analyze/declarations.wap"

# whether the code fits the matcher, its holes bound in `bindings` (a hole met twice must meet equal code)
# Round brackets around one key or call only group it: `($f: $t)` in a pattern is the key, and code in such brackets is
# matched as its key; a hole or a sequence still takes the group as written. Brackets around a phrase or a list keep their meaning.
matches(m: Matcher, n: Node, bindings: map<text, Node>) as bool := annotated_as(m, n) and match m.test {
	Test.Hole => hole_matches(m, n, bindings)
	Test.Sequence => sequence_matches(m, if is_form(m) then call_ungrouped(n) else n, bindings)
	_ => item_matches(m, grouped_item(n) ?? n, bindings)
}
# a call in round brackets is the call where a pattern asks for a form, `($a + $b)`, whose normalized pattern is the
# call (rules/patterns.wap normalized); a call's argument group, `f(x + 1)`, stays the group `($arguments...)` asks for
is_form(m: Matcher) as bool := m.bracket == Bracket.Round and m.separator == Separator.Space and m.parts is not empty and m.parts#1.test == Test.Literal
call_ungrouped(n: Node) as Node := match n { List(items, Bracket.Round, separator) => if #items == 1 and items#1 is Call then items#1 else n; _ => n }
# whether the code carries each annotation the pattern wrote before it
annotated_as(m: Matcher, n: Node) as bool := m.annotations.all(wanted => annotations_of(n).any(said => "${said}" == "${wanted}"))
item_matches(m: Matcher, n: Node, bindings: map<text, Node>) as bool := match m.test {
	Test.Literal => same_atom(m, n)
	Test.Repeat => repeat_matches(m.parts#1, [n], bindings)
	Test.Pair => match n { Key(left, op, right) => op == m.op and matches(m.parts#1, left, bindings) and matches(m.parts#2, right, bindings); _ => no }
	_ => refused(n, "this matcher tests no single item")
}

hole_matches(m: Matcher, n: Node, bindings: map<text, Node>) as bool := {
	if not of_shape(m, n) { return no }
	if bindings.has(m.name) { return "${bindings[m.name]}" == "${n}" }
	bindings[m.name] = taken_by_hole(m, n)
	yes
}
# the code a hole takes; a name a declaration hole read carries the name of the declaration it was read as, so binding
# refuses a local that hides that declaration (core/bindings.wap READ_WITH)
taken_by_hole(m: Matcher, n: Node) as Node := {
	if m.stage != DECLARED_STAGE or is_type_hole(m) { return n }
	declaration = hole_declaration(m, n)!
	with_fact(if spelling_written(m.type) == CLASS_HOLE then declaration.record! else n, READ_WITH, declaration.definer)
}

# whether code is a literal matcher's atom: a word spelled by any alias of it, anything else written alike
same_atom(m: Matcher, n: Node) as bool := match m.literal {
	Symbol(name) => match n { Symbol(other) => canonical_word(other) == m.spelled; _ => no }
	_ => "${n}" == m.spelled
}
canonical_word(spelling: text) as text := word_aliased(aliased(spelling, Fixity.Anywhere))

sequence_matches(m: Matcher, n: Node, bindings: map<text, Node>) as bool := match n {
	List(items, bracket, separator) => bracket == m.bracket and (#m.parts < 2 or #items < 2 or bracket == Bracket.Square or separators_fit(m.separator, separator)) and parts_match(m.parts, items_matched(m, items, bracket, separator), bindings)
	Empty => EMPTY_GROUPS.contains(m.bracket) and parts_match(m.parts, [], bindings)
	_ => no
}

# a round phrase is one item where the pattern is no phrase, as a call's argument is (rules/lowering.wap arguments_of):
# `$x.$f($arguments...)` takes `(if c then 2 else 3)` whole
items_matched(m: Matcher, items: list, bracket: Bracket, separator: Separator) as list := if bracket == Bracket.Round and separator == Separator.Space and m.separator != Separator.Space then [List(items, Bracket.None, separator)] else braced_items(items, bracket)
# In braces the lines' comma rows are their items: `{ A, B⏎ C }` holds three; square brackets keep a row a list
braced_items(items: list, bracket: Bracket) as list := if bracket != Bracket.Curly then items else items.flat_map(row_items)

# a group of one item has no separator to compare: `{ x: int }` fits `{ ($f: $t)... ($m := $b)... }`; nor has a list,
# `[a b]` and `[a, b]` being one list
separators_fit(wanted: Separator, given: Separator) as bool := wanted == given or STATEMENT_SEPARATORS.contains(given) and (wanted == Separator.Space or STATEMENT_SEPARATORS.contains(wanted))

# Parts matched against items in order. A rest hole takes as few items as let the parts after it match, all that
# remain when it is last: `if $c... then $a...` stops the condition at the first then. A failed try leaves no binding.
parts_match(parts: list, items: list, bindings: map<text, Node>) as bool := {
	if parts is empty { return items is empty }
	part = parts#1
	if not part.rest { return items is not empty and matches(part, items#1, bindings) and parts_match(parts[1 ..], items[1 ..], bindings) }
	known = bindings.keys
	for taken in 0 to #items {
		if taken_by(part, items[.. taken], bindings) and parts_match(parts[1 ..], items[taken ..], bindings) { return yes }
		for name in bindings.keys { if not known.contains(name) { bindings.remove(name) } }
	}
	no
}

taken_by(m: Matcher, items: list, bindings: map<text, Node>) as bool := if m.test == Test.Repeat then repeat_matches(m.parts#1, items, bindings) else rest_matches(m, items, bindings)

# each item fits the repeated part on its own; each hole of it is bound to the sequence of what it met
repeat_matches(part: Matcher, items: list<Node>, bindings: map<text, Node>) as bool := {
	met: map<text, list<Node>> = {}
	# none taken binds each name to the empty sequence, so a template writes the part no times
	for name in names_bound(part) { met[name] = [] }
	for item in items {
		own: map<text, Node> = {}
		if not matches(part, item, own) { return no }
		for name in own.keys { continued(met, name, [own[name]]) }
	}
	for name in met.keys { bindings[name + REST_MARK] = List(met[name], Bracket.None, Separator.Space) }
	yes
}

# the names a matcher binds when it fits: its holes, a repetition's under `$p...`
names_bound(m: Matcher) as list<text> := match m.test {
	Test.Hole => [m.name]
	Test.Repeat => names_bound(m.parts#1).map(name => name + REST_MARK)
	_ => m.parts.flat_map(names_bound)
}

rest_matches(m: Matcher, items: list, bindings: map<text, Node>) as bool := {
	for item in items { if not of_shape(m, item) { return no } }
	bindings[m.name] = List(items, Bracket.None, Separator.Space)
	yes
}

# whether code has the shape a hole asks for
of_shape(m: Matcher, n: Node) as bool := {
	if m.stage == TYPED_STAGE { return if spelling_written(m.type) == VALUE_HOLE then gives_value(n) else fits_type(n, type_term(m.type)) }
	if m.stage == DECLARED_STAGE { return if is_type_hole(m) then is_type_name(m, n) else hole_declaration(m, n) != ø }
	pattern = m.pattern ?? return of_type(m, n)
	matches(pattern.matcher, n, {})
}
# whether code is of the shape a hole's type names, Symbol, List, Key, Text, Number or Node
of_type(m: Matcher, n: Node) as bool := {
	type = spelling_written(m.type)
	if m.type == Empty or type == NODE_TYPE { return yes }
	match type {
		"Symbol" => n is symbol
		"List" => n is List
		"Key" => n is Key
		"Text" => n is Text
		"Number" => n is Number
		_ => n is Char
	}
}

is_type_hole(m: Matcher) as bool := spelling_written(m.type) == TYPE_HOLE
# whether code is a type's name: a type word or a class among the declarations in force
is_type_name(m: Matcher, n: Node) as bool := is_name(n) and (TYPE_WORDS.contains(spelling_written(n)) or (m.declarations.by_name.get(spelling_written(n)) ?? []).any(signature => signature.kind == DefinitionKind.Record))
# the declaration of a name, among those in force, that a declaration hole asks for: a function, a test of one
# value, its result bool, or a class; ø when the code is no such name
hole_declaration(m: Matcher, n: Node) as Signature? := {
	declared = m.declarations.by_name
	if not is_name(n) or not declared.has(spelling_written(n)) or TYPE_WORDS.contains(spelling_written(n)) { return ø }
	records = declared[spelling_written(n)].filter(signature => signature.kind == DefinitionKind.Record)
	if spelling_written(m.type) == CLASS_HOLE {
		if #records > 1 { refused(n, "${n} names ${#records} classes: rename all but one") }
		return if records is empty then ø else records#1
	}
	# a name that is a type, a type word or a declared class or record, is a type test, never its conversion called as a
	# predicate: `x is bool` asks x's type
	if records is not empty { return ø }
	functions = declared[spelling_written(n)].filter(signature => is_function(signature))
	tests = if spelling_written(m.type) == FUNCTION_HOLE then functions else functions.filter(signature => #signature.parameters == 1 and signature.result == BOOL_TERM)
	if tests is empty then ø else tests#1
}

# the stage a matcher's rule runs in, the latest any of its holes asks for: stage 3 on typed code
matcher_stage(m: Matcher) as int := if m.test == Test.Hole then m.stage else m.parts.map(matcher_stage).fold(SHAPE_STAGE, (a, b) => max(a, b))

# the holes of a pattern named again after their first occurrence: the second `$x` must equal the first, so it counts as a literal
repeated_holes(m: Matcher) as int := #names_bound(m) - #names_bound(m).unique
# how specific a pattern is: a literal part, and an annotation it asks for, counts twice a typed hole, as it fits one
# node, a type many; a hole of any value, `$x: value`, counts half a typed one; brackets count as a typed hole, a rest
# hole in them nothing, so `@protocol Record($b, $f, [])` (14) beats `Record($b, [$f...], [])` (12)
specificity(m: Matcher) as int := 4 * repeated_holes(m) + part_specificity(m)
part_specificity(m: Matcher) as int := 4 * #m.annotations + match m.test {
	Test.Literal => 4
	Test.Hole => if m.type == Empty or spelling_written(m.type) == NODE_TYPE then 0 else if spelling_written(m.type) == VALUE_HOLE then 1 else 2
	_ => 2 + m.parts.map(part_specificity).sum()
}
