# Patterns: code with holes, declared and compiled to a Matcher (notes/first_principles.md "Holes", wiki/pattern.md).
# Reads a pattern as the operator stage wrote it, in the very language it matches, and compiles it once to the Matcher
# that rules/matcher.wap matches Nodes with, binding each hole.
#
#   unless $c $body                 a phrase: the word unless, then two holes
#   $a ÷ $b                         (Call ÷ $a $b), as the operator stage reads it
#   (If $condition: Node $then …)   a hole typed by a shape: Symbol, List, Key, Text, Number, Node or a declared pattern
#   (Block $statements...: Node)    a rest hole takes the remaining items, each of the type
#
# A hole's type picks the stage its rule runs in: a shape is checked here (stage 1); `function` or `predicate` asks the
# declarations in force, `$p: predicate` a name declared as a test of one value (stage 2, after declare); a value type
# (`$k: int`, `$xs: list<int>`) is checked by typing (stage 3, core/analyze/types.wap fits_type).
use "../analyze/types.wap"
use "../analyze/declarations.wap"
use "../parse/reader.wap"
use "../parse/operators.wap"
use "../format.wap"
use "../errors.wap"
use "../stage.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"
use "../parse/atoms.wap"
use "../parse/cascade.wap"
use "../parse/operator_table.wap"
use "../../types/operators.wap"
use folder
use "../analyze/fits.wap"
use "../language.wap"
use "../bindings.wap"

# the shapes a hole can ask for, beside Node and the declared patterns
SHAPES = ["Symbol", "List", "Key", "Text", "Number", "Char"]
# what a pattern's builder writes: the Node cases it builds with, the enums of a group's parts, a case's dot; its line
SYMBOL_CASE = "Symbol"
LIST_CASE = "List"
BRACKET_TYPE = "Bracket"
SEPARATOR_TYPE = "Separator"
CASE_DOT = "."
BUILDER_LINE = 1
# the groups that are Empty when they hold nothing, `()`: a rule's round group of no items fits it
EMPTY_GROUPS = [Bracket.Round]
# the separators that end a statement, one for matching: a block's statements fit a pattern whether `;` or line ends
# part them, and a pattern that parts them by spaces, `{ $a... $b... }`, fits either
STATEMENT_SEPARATORS = [Separator.Semicolon, Separator.Newline]
# the stages a rule may run in, by what its holes ask: the shape, the declarations, the inferred types
SHAPE_STAGE = 1
DECLARED_STAGE = 2
TYPED_STAGE = 3
RULE_STAGES = [SHAPE_STAGE, DECLARED_STAGE, TYPED_STAGE]
# the hole types that ask the declarations: a name declared as a function, `$f: function`, as a test of one value,
# its result bool, `$p: predicate`, or as a class, `$c: class`, which takes the class's declaration; a type word or a
# class, `$t: type`, taken as written
FUNCTION_HOLE = "function"
PREDICATE_HOLE = "predicate"
CLASS_HOLE = "class"
TYPE_HOLE = "type"
# the hole type that asks for code giving a value of any type, none and a jump excepted: `$last: value` (stage 3)
VALUE_HOLE = "value"

# a pattern declared by `pattern Name = shape` (kernel/forms.wap, a rule file, a program): its shape, its holes in order
# its shape as the Node pattern that takes a value apart, `taken`
class Declared { name: text, shape: Node, holes: list<text>, matcher: Matcher, taken: Node = Empty }

# what a part of a pattern asks of the code at its place
enum Test { Hole, Literal, Sequence, Pair, Repeat }
# the declarations stage 2 reads, by name: those of the module it rewrites, of the modules it uses and of the types
# module
class Declarations { by_name: map<text, list<Signature>> }
# a hole's matcher knows, from when it was compiled, the stage its type asks for, which declared pattern it names and
# the declarations it reads; a literal's, how the literal is spelled; any matcher, the annotations its code must carry,
# `@protocol Record($n, $f, $c)`
class Matcher { test: Test, name: text = "", type: Node = Empty, stage: int = SHAPE_STAGE, pattern: Declared? = ø, declarations: Declarations = Declarations({}), rest: bool = no, literal: Node = Empty, bracket: Bracket = Bracket.None, separator: Separator = Separator.None, op: Op = Op.None, parts: list<Matcher> = [], spelled: text = "", annotations: list<Node> = [] }

# ---- holes

is_hole(n: Node) as bool := is_hole_word(n)
# a word that is no hole: what a rule's literal word or a declaration hole takes
is_name(n: Node) as bool := n is symbol and not is_hole(n)
is_rest_hole(n: Node) as bool := is_hole(n) and spelling_written(n).ends_with(REST_MARK)
# the spelling a hole is bound under: `$c`, `$items...`
hole_key(n: Node) as text := spelling_written(n)
# a hole's type as written, Empty when it has none
hole_type(n: Node) as Node := fact_of(n, HOLE_TYPE) ?? Empty

# whether a type is a shape: none, Node, a case of Node or a declared pattern; any other type is a value type
is_shape(language: Language, type: Node) as bool := match type {
	Empty => yes
	Symbol(name) => name == NODE_TYPE or SHAPES.contains(name) or language.grammar.patterns.has(name)
	_ => no
}

# the stage a hole's type asks for
hole_stage(language: Language, type: Node) as int := if is_shape(language, type) then SHAPE_STAGE else if type is symbol and [FUNCTION_HOLE, PREDICATE_HOLE, CLASS_HOLE, TYPE_HOLE].contains(spelling_written(type)) then DECLARED_STAGE else TYPED_STAGE

# A typed hole `$c: Symbol` reads as a colon key (the reader gives a hole's `:` one type): the hole, its type a fact.
# A type holds no hole, so code with a hole after the colon makes a key: `$field: $type`, as in
# `class $name { ($field: $type)... }`, and `class $name: $protocol { $members... }`; the part keeps what the reader
# wrote on it, `@protocol Record(…)` its annotations
normalized(n: Node) as Node := with_facts_of(normalized_shape(n), n)
normalized_shape(n: Node) as Node := match n {
	# brackets group in a pattern as they do in code: a round group of one key or call is that item, `global ($n = $v)`;
	# around a phrase or a list they keep their meaning
	List(items, Bracket.Round, separator) => if grouped_item(n) != ø or #items == 1 and items#1 is Call then normalized(items#1) else bracketed_normalized(n)
	List(items, bracket, separator) => bracketed_normalized(n)
	Key(left, Op.Colon, right) => if is_hole(left) and holes_in(right) is empty then typed_hole(left, right) else Key(normalized(left), Op.Colon, normalized(right))
	Key(left, op, right) => Key(normalized(left), op, if op == Op.None then bracketed_normalized(right) else normalized(right))
	_ => n
}

# brackets that are part of the form keep their meaning, its parts normalized: a glued call's arguments, `shout($x)`, a
# declared pattern's shape, `(Return $value)`
bracketed_normalized(n: Node) as Node := match n { List(items, bracket, separator) => List(items.map(normalized), bracket, separator); _ => normalized(n) }

typed_hole(hole: Node, type: Node) as Node := with_fact(hole, HOLE_TYPE, type)
# the type a hole is written with, `$x: int`: notation, read into a term where a typed value is matched
HOLE_TYPE = "hole type"

# ---- compiling

# a normalized pattern compiled to its matcher; a declared pattern written as a call, `If($c, $a, $b)`, is its shape
compiled_pattern(language: Language, n: Node) as Matcher := {
	# Repetition, as in macros by example: `($p => $r)...` in a pattern takes items that each fit `$p => $r`, binding $p
	# and $r to the sequences of their matches (as a rest hole binds, under `$p...`); in a template `Arm($p, $r)...`
	# writes one Arm per match. The part repeated, ø when the node is no repetition.
	repeated = rest_named(n)
	matcher = if repeated != ø then Matcher(Test.Repeat, rest: yes, parts: [compiled_pattern(language, ungrouped(repeated))]) else shape_matcher(language, n)
	matcher.annotations = annotations_of(n)
	matcher
}
# a literal's matcher, which knows how the literal is spelled, a word by its canonical spelling, once
literal_matcher(n: Node) as Matcher := Matcher(Test.Literal, literal: n, spelled: match n { Symbol(name) => canonical_word(name); _ => "${n}" })
shape_matcher(language: Language, n: Node) as Matcher := match n {
	Symbol(name) => if is_hole(n) then Matcher(Test.Hole, name: hole_key(n), type: hole_type(n), stage: hole_stage(language, hole_type(n)), declarations: language.declarations, pattern: pattern_called(language, hole_type(n)), rest: is_rest_hole(n)) else literal_matcher(n)
	Key(head, Op.None, List(arguments, Bracket.Round, separator)) => {
		if names_pattern(language, head) then compiled_pattern(language, instance(language, pattern_called(language, head)!, arguments)) else pair_matcher(language, head, Op.None, List(arguments, Bracket.Round, separator))
	}
	Key(left, op, right) => pair_matcher(language, left, op, right)
	List(items, bracket, separator) => if grouped_item(n) != ø and not is_hole(items#1) then compiled_pattern(language, items#1) else sequence_matcher(language, items, bracket, separator)
	_ => literal_matcher(n)
}
sequence_matcher(language: Language, items: list, bracket: Bracket, separator: Separator) as Matcher := Matcher(Test.Sequence, bracket: bracket, separator: separator, parts: items.map(item => compiled_pattern(language, item)))

pair_matcher(language: Language, left: Node, op: Op, right: Node) as Matcher := Matcher(Test.Pair, op: op, parts: [compiled_pattern(language, left), compiled_pattern(language, right)])

# the declared pattern a name calls, ø for any other name
pattern_called(language: Language, head: Node) as Declared? := if names_pattern(language, head) then language.grammar.patterns[text(head)] else ø
# whether a name calls a declared pattern
names_pattern(language: Language, head: Node) as bool := match head {
	Symbol(name) => language.grammar.patterns.has(name)
	_ => no
}

# a declared pattern's shape with the given parts at its holes, in order; a rest hole takes the remaining parts
instance(language: Language, pattern: Declared, parts: list) as Node := built(language, pattern.shape, bound_in_order(pattern.holes, parts))

bound_in_order(holes: list<text>, parts: list<Node>) as map<text, Node> := {
	bindings: map<text, Node> = {}
	for i in 1 to #holes {
		hole = holes#i
		if hole.ends_with(REST_MARK) { bindings[hole] = List(parts[i - 1 ..], Bracket.None, Separator.Space) } else { bindings[hole] = parts#i }
	}
	bindings
}

# the holes of a normalized pattern in the order they are written
holes_in(n: Node) as list<text> := hole_nodes(n).map(hole_key)
# the holes themselves, each with its type as a fact
hole_nodes(n: Node) as list<Node> := match n {
	Symbol(name) => if is_hole(n) then [n] else []
	_ => direct_parts(n).flat_map(hole_nodes)
}

# `pattern Name = shape`: the pattern joins the declared ones, so holes and templates can name it
declare_pattern(language: Language, name: Node, shape: Node) as Declared := {
	normal = bracketed_normalized(shape)
	# known before its matcher is compiled, so the pattern may name itself
	declared = Declared(spelling_written(name), normal, holes_in(normal), Matcher(Test.Literal))
	language.grammar.patterns[declared.name] = declared
	language.grammar.declares = yes
	declared.matcher = compiled_pattern(language, normal)
	declared.taken = shape_taken(language, declared)
	declared
}

# A declared pattern's builder, a function of its name taking its holes in order, each of its type, a rest hole as a
# list, that gives its shape with them at their places, a value of the pattern's type (wiki/pattern-matching.md "Named
# patterns as types"): `pattern Call = (Call $called: Node $arguments...: Node)` declares
# Call(called: Node, arguments: list<Node>): Call := List([Symbol("Call"), called, ...arguments], Bracket.Round,
# Separator.Space), so Call(f, [x]) is (Call f x), built as the operator stage reads it, at a line of its own
pattern_builder(pattern: Declared) as Node := {
	head = called_with(pattern.name, hole_nodes(pattern.shape).map(hole_parameter))
	typed = match pattern.shape { List(items, Bracket.Square, separator) => head; _ => Key(head, Op.Colon, symbol(pattern.name)) }
	builder = positioned(Call(symbol(DEFINE_SPELLING), [typed, body_code(pattern.shape, hole => symbol(hole_variable(hole)))]), BUILDER_LINE, BUILDER_LINE)
	leftmost_marked(leftmost_marked(builder, PATTERN_HOLES, data_list(pattern.holes.map(hole => symbol(hole_variable(hole))))), PATTERN_TAKEN, pattern.taken)
}
# n with a fact on its leftmost word, the name a definition `f(x): T := body` defines; an operator's leftmost word is
# in its first operand
leftmost_marked(n: Node, name: text, value: Node) as Node := match n {
	Symbol(word) => with_fact(n, name, value)
	Call(called, operands) => replaced(n, Call(called, [leftmost_marked(operands#1, name, value)] + operands[1 ..]))
	Key(left, op, right) => replaced(n, Key(leftmost_marked(left, name, value), op, right))
	_ => n
}
# a hole as its builder's parameter: of its type, Node when it has none, a rest hole a list<Node>
hole_parameter(hole: Node) as Node := Key(symbol(hole_variable(hole_key(hole))), Op.Colon, if is_rest_hole(hole) then Key(symbol(LIST_TYPE), Op.None, List([symbol(NODE_TYPE)], Bracket.Less, Separator.None)) else if hole_type(hole) is Empty then symbol(NODE_TYPE) else hole_type(hole))
hole_variable(hole: text) as text := if hole.ends_with(REST_MARK) then hole[1 .. #hole - #REST_MARK] else hole[1 ..]
# A declared pattern's shape as the Node pattern that takes it apart, its holes those its call's parts fill:
# `Call(f, args)` in an arm is List([Symbol("Call"), f, ...args], Bracket.Round, Separator.Space)
shape_taken(language: Language, pattern: Declared) as Node := lowered(language, top_level_statements(shaped_program(language, body_code(pattern.shape, hole => symbol(HOLE_SIGN + hole_variable(hole)))))#1)
# A declared pattern's call in an arm, its parts at its holes in order, by the facts its builder's name carries
pattern_taken(called: Node, parts: list, builder: Node) as Node := {
	holes = fact_items(builder, PATTERN_HOLES)
	if #parts != #holes { refused(called, "${text(called)} takes ${#holes} parts, not ${#parts}") }
	bindings = bound_in_order(holes.map(hole => HOLE_SIGN + text(hole)), parts)
	holes_filled(fact_of(builder, PATTERN_TAKEN) ?? refused(called, "${text(called)} names a pattern whose shape was not taken"), bindings)
}
# lowered code with each hole replaced by its binding; a `...` in it spreads a list, no repetition as in a template
holes_filled(n: Node, bindings: map<text, Node>) as Node := match n {
	Symbol(name) => bindings.get(name) ?? n
	List(items, bracket, separator) => with_items(n, items.map(item => holes_filled(item, bindings)))
	_ => n
}
# A pattern's body as code, as the operator stage reads it: a list in square brackets a list value, `[$a: int, $b: int]`
# builds [a, b] and takes a list apart; any other body the node of its shape (wiki/pattern-matching.md "Named patterns
# as types")
body_code(shape: Node, hole_written: (text) -> Node) as Node := match shape {
	List(items, Bracket.Square, separator) => items_code(items, hole_written)
	_ => shape_code(shape, hole_written)
}
# a group's items as a list value, `[a, b]`
items_code(items: list, hole_written: (text) -> Node) as Node := List(items.map(item => shape_code(item, hole_written)), Bracket.Square, if #items > 1 then Separator.Comma else Separator.None)
# The code of a shape: a name its symbol, `Symbol("Call")`, a group its list, `List([…], Bracket.Round,
# Separator.Space)`, a hole as `hole_written` writes it, a rest hole's items spread into the group, `...arguments`
shape_code(shape: Node, hole_written: (text) -> Node) as Node := match shape {
	Symbol(name) => if not is_hole(shape) then called_with(SYMBOL_CASE, [Text(spelling_written(shape))]) else if is_rest_hole(shape) then List([symbol(REST_MARK), hole_written(hole_key(shape))], Bracket.None, Separator.None) else hole_written(hole_key(shape))
	List(items, bracket, separator) => called_with(LIST_CASE, [items_code(items, hole_written), case_code(BRACKET_TYPE, text(bracket)), case_code(SEPARATOR_TYPE, text(separator))])
	_ => refused(shape, "a pattern's builder writes names, holes and groups, not this part yet")
}
# `f(a, b)` (`f()` with an Empty group, as the reader gives it) and `Type.Case` as the operator stage reads them
called_with(name: text, arguments: list<Node>) as Node := Key(symbol(name), Op.None, if arguments is empty then Empty else List(arguments, Bracket.Round, if #arguments > 1 then Separator.Comma else Separator.None))
case_code(type: text, case: text) as Node := Call(symbol(CASE_DOT), [symbol(type), symbol(case)])

# a group of one item, `($f: $t)`, is that item: matched and compiled as it (rules/matcher.wap)
grouped_item(n: Node) as Node? := match n {
	List(items, Bracket.Round, separator) => if #items == 1 and not (items#1 is List) and rest_named(items#1) == ø then items#1 else ø
	_ => ø
}
