# Shape rules (stage 1): operated → surface (notes/backbone.md "Stage languages"). Rules and patterns are data, read
# by wap's own reader and operator stage from kernel/forms.wap, sugar/ and the program itself, and compiled to
# matchers when they are loaded:
#
#   pattern If = (If $condition: Node $then: Node $else: Node)      a pattern every rule may name
#   rule unless $c $body => If(not $c, $body, ø)                     a spelling written as other code
#
# Rules are indexed by the head of their pattern. A node is rewritten top-down: by the most specific rule that fits,
# again until none fits, then its parts. Each node a rule builds is placed where the rewritten code was and carries
# the rule (fact RULE, core/stage.wap). Rules terminate by construction, checked when they are loaded.
use folder
use "../parse/reader.wap"
use "../parse/operators.wap"
use "../format.wap"
use "../errors.wap"
use "../stage.wap"
use "../../kernel/forms.wap"
use "../parse/atoms.wap"
use "../analyze/declarations.wap"
use "../language.wap"
use "../bindings.wap"

RULE_WORD = "rule"
PATTERN_WORD = "pattern"
RULE_ARROW = "=>"
# a template that refuses what its pattern matched: `=> refuse "message"`
REFUSE_WORD = "refuse"
# what a rule's pattern ends with to ask a fact of the code, `rule … where script => …`: the rule takes the fact, what it
# writes holds it no more, so it fires once where a stage wrote it, and the termination check passes it
WHERE_WORD = "where"
DEFINITION = "="
# what a rule writes that writes nothing, `=> ()`: the empty statement sequence, whose no statements its list takes in
# its place; not ø, a value a rule may write, `rule ø => Empty()`
NOTHING_WRITTEN = List([], Bracket.None, Separator.Newline)
# a walk's notes (rewritten_by): whether a rule fired, whether the node in hand changed, by a rule or a regrouping
FIRED = 0
CHANGED = 1

# code after a stage's rules, and whether any of them fired
class Fired { code: Node, fired: bool }

# ---- loading
#
# A side of a rule may stand in brackets to keep its keys and operators inside: `rule ($h as $t := $b) => ($h: $t := $b)`.
# Only a pattern's holes take a type (`$c: Node`); in a template `$h: $t` is the key it writes.

# the rules and patterns of loaded code taken in, the code returned with each pattern's builder in its place
rules_loaded(language: Language, code: Node) as Node := match code {
	List(items, Bracket.None, Separator.Newline) => List(items.flat_map(item => left_by(language, sequence_rule(item)) ?? [item]), Bracket.None, Separator.Newline)
	_ => {
		left = left_by(language, sequence_rule(code))
		if left == ø then code else if left is empty then Empty else List(left, Bracket.None, Separator.Newline)
	}
}

# `rule P => A; B` writes both statements: the `;` binds looser than `=>`, so the line is a sequence whose first
# statement is the rule; the rule takes the rest as its template's further statements
sequence_rule(statement: Node) as Node := match statement {
	List(items, Bracket.None, separator) => if separator != Separator.Semicolon and separator != Separator.Comma then statement else match items#1 {
		Call(called, arguments) => if spelling_written(called) == RULE_ARROW and #arguments == 2 then Call(called, [arguments#1, List([arguments#2] + items[1 ..], Bracket.None, separator)]) else statement
		_ => statement
	}
	_ => statement
}

# a rule or pattern statement taken in, what it leaves in the code: a pattern its builder, a rule nothing; ø for any
# other statement
left_by(language: Language, statement: Node) as list? := match statement {
	Call(called, arguments) => declaration_taken(language, spelling_written(called), arguments)
	_ => ø
}

declaration_taken(language: Language, called: text, arguments: list) as list<Node>? := {
	if #arguments != 2 { return ø }
	words = phrase_items(arguments#1)
	if #words < 2 or not (words#1 is symbol) { return ø }
	keyword = spelling_written(words#1)
	if called == DEFINITION and keyword == PATTERN_WORD and #words == 2 { return [pattern_builder(declare_pattern(language, words#2, arguments#2))] }
	if called == RULE_ARROW and keyword == RULE_WORD {
		guarded = #words > 3 and spelling_written(words#(#words - 1)) == WHERE_WORD
		pattern = if guarded then words[1 .. #words - 2] else words[1 ..]
		rule_added(language, arguments#1, if #pattern == 1 then pattern#1 else List(pattern, Bracket.None, Separator.Space), arguments#2, if guarded then spelling_written(words.last) else "")
		return []
	}
	if keyword == RULE_WORD or keyword == PATTERN_WORD { refused(arguments#1, "this ${keyword} reads as `${called}` with the ${keyword} on its left: put its pattern in brackets, `rule ($a = $b) => …`") }
	ø
}


rule_added(language: Language, written: Node, pattern: Node, template: Node, fact: text) := {
	normal = normalized(ungrouped(pattern))
	writes_nothing = ungrouped(template) is Empty
	output = if writes_nothing then NOTHING_WRITTEN else ungrouped(template)
	for hole in holes_in(output) { if not holes_in(normal).contains(hole) and not holes_in(normal).contains(hole + REST_MARK) { refused(written, "the rule writes " + hole + ", which its pattern has no hole for") } }
	stage = matcher_stage(compiled_pattern(language, normal))
	# a typed rule meets typed kernel: its pattern and template are lowered as the program is, `twice $x: int`
	if stage == TYPED_STAGE { normal = lowered(language, normal); output = if writes_nothing then output else forms_built(language, lowered(language, output)) }
	matcher = compiled_pattern(language, normal)
	rule = Rule(heads_of(language, normal)#1, matcher, output, names_bound_in(language, output), written, specificity(matcher) + (if fact == "" then 0 else 1), fact)
	rules = rules_of_stage(language, stage)
	if not rules.by_head.has(rule.head) { rules.by_head[rule.head] = [] }
	# a rule loaded again, its file read twice, is the rule already there
	if rules.by_head[rule.head].filter(other => "${other.written}" == "${written}") is not empty { return }
	rules.by_head[rule.head].add(rule)
	rules.checked = no
	match normal { List(items, Bracket.None, Separator.Space) => words_told(language, items, #matcher.parts.filter(takes_block) > 0); _ => ø }
}
# a phrase pattern's words told the operator stage: the first ones lead it, the words after the first are inner words,
# each with the words whose phrases it continues
words_told(language: Language, items: list, block: bool) := {
	for word in list_heads(language, items) { if block or not language.phrase_words.leading.has(word) { language.phrase_words.leading[word] = block } }
	for word in items[1 ..].filter(item => item is symbol and not is_hole(item)) { continued(language.phrase_words.inner, spelling_written(word), list_heads(language, items)) }
}
# a pattern part that takes a block: a braced sequence, `{ ($pattern => $result)... }`, or a hole of a shape a block has
takes_block(m: Matcher) as bool := m.test == Test.Sequence and m.bracket == Bracket.Curly or m.test == Test.Hole and m.type != Empty and matches(m, SAMPLE_BLOCK, {})
SAMPLE_BLOCK = List([symbol("x")], Bracket.Curly, Separator.Newline)

# A rule may refuse a spelling with a fix-it, `rule … => refuse "put the inner if in braces"`: the message, ø for a
# template that writes code
refusal_of(template: Node) as text? := phrase_text(template, REFUSE_WORD)

# ---- the stage

# a program's own rules and patterns taken in, then the program shaped by every shape rule loaded
# DEBT: A module's rules reach files that don't `use` it: all loaded rules go into one table, so once a module is
#   shaped its rules also apply to every file shaped after it (the types module's and the census's included). Bends
#   "use builds the language the program is written in". Paid off by a rule table per program: the language's rules
#   plus those of the modules it uses.
shaped_program(language: Language, program: Node) as Node := {
	rest = rules_loaded(language, program)
	for stage in [SHAPE_STAGE, DECLARED_STAGE, TYPED_STAGE] { terminating(language, rules_of_stage(language, stage)) }
	# the rewritten program stands for the program: it keeps its facts, the file it was read from among them; a
	# program of rules only is an empty block, as Empty carries no facts
	shaped = rewritten_by(language, language.shape_rules, rest).code ?? Block([])
	with_facts_of(if shaped is Empty then Block([]) else shaped, program)
}

# Code with a stage's rules applied top-down: a node rewritten by the most specific rule that fits, again until none
# does, then its parts. Says whether any rule fired, so typing can run again after stage 3. A node no rule changed and
# no regrouping reshaped, itself or below, is kept as it is, never rebuilt
rewritten_by(language: Language, rules: Rules, code: Node) as Fired := {
	fired = [no, no]
	result = rules_applied(language, rules, code, fired)
	Fired(result, fired[FIRED])
}

rules_applied(language: Language, rules: Rules, n: Node, fired: list) as Node := {
	outer = fired[CHANGED]
	fired[CHANGED] = no
	whole = rewritten(language, rules, noted(fired, unglued(language, n)) ?? n, fired)
	built = parts_applied(language, rules, whole, fired)
	if not fired[CHANGED] { fired[CHANGED] = outer; return n }
	refitted(built, whole)
}
# a node the walk regrouped, noted as a change; ø, none regrouped, notes none
noted(fired: list, regrouped: Node?) as Node? := {
	if regrouped != ø { fired[CHANGED] = yes }
	regrouped
}

# A block or group of one phrase, `{ if c { a } }`, `(if c then a else b)`, holds the phrase's words: its one statement
# is that phrase, rewritten as one. A list whose words start with a rule's word, `[if c then a else b]`, holds
# that phrase as its one item; `[a b c]` holds three. A kernel form, `(If c a b)`, is its parts; square brackets hold items.
parts_applied(language: Language, rules: Rules, whole: Node, fired: list) as Node := {
	applied = part => rules_applied(language, rules, part, fired)
	match whole {
		List(items, Bracket.None, Separator.Space) => with_parts(noted(fired, inner_rewritten(language, rules, items, whole)) ?? whole, applied)
		List(items, bracket, Separator.Space) => {
			phrase = with_facts_of(List(items, Bracket.None, Separator.Space), whole)
			if one_phrase(language, items, bracket) then noted(fired, group_kept(applied(phrase), bracket))!
			else if bracket == Bracket.Square and items#1 is symbol and language.phrase_words.leading.has(spelling_written(items#1)) then noted(fired, List([applied(phrase)], bracket, Separator.None))!
			else with_parts(whole, applied)
		}
		List(items, bracket, separator) => with_facts_of(List(statements_applied(language, items, separator, applied, fired), bracket, separator), whole)
		# a key's word names, a field, a parameter or a map's key, `{yes: 1}`: no rule of one word takes it, its value is code
		Key(left, Op.Colon, right) => if left is symbol then with_facts_of(Key(left, Op.Colon, applied(right)), whole) else with_parts(whole, applied)
		_ => with_parts(whole, applied)
	}
}
# A phrase no rule fits whole, whose later word heads a rule that fits from there on, `print match x {…}`: that part
# is the earlier words' last argument, as in `print -x`: it groups in round brackets, `print (match x {…})`, a group of
# one phrase the walk rewrites as one, and the grouping `wap format` prints
inner_rewritten(language: Language, rules: Rules, items: list, whole: Node) as Node? := {
	for at in 2 to #items {
		part = items[at - 1 ..]
		if items#at is symbol and rules.by_head.has(spelling_written(items#at)) and #rule_applied(language, rules, phrase_placed(part, Bracket.None, whole)) > 0 {
			return List(items[.. at - 1] + [phrase_placed(part, Bracket.Round, whole)], Bracket.None, Separator.Space)
		}
	}
	ø
}

# words as one phrase in those brackets, where the phrase they come from was written
phrase_placed(words: list, bracket: Bracket, origin: Node) as Node := with_facts_of(List(words, bracket, Separator.Space), origin)

# code with every grouping a rule head inside a phrase makes written out, nothing rewritten: what `wap format` prints;
# a rule or pattern line is printed as written
groupings_written(language: Language, n: Node) as Node := match n {
	List(items, Bracket.None, Separator.Space) => if declares(items) then n else phrase_written(language, unglued(language, n) ?? n)
	_ => with_facts_of(with_parts(n, part => groupings_written(language, part)), n)
}
phrase_written(language: Language, phrase: Node) as Node := match phrase {
	List(items, Bracket.None, Separator.Space) => with_facts_of(with_parts(inner_rewritten(language, language.shape_rules, items, phrase) ?? phrase, part => groupings_written(language, part)), phrase)
	_ => refused(phrase, "only a spaced phrase is written by its rules")
}
declares(items: list) as bool := items#1 == symbol(RULE_WORD) or items#1 == symbol(PATTERN_WORD)

# A rule's result as the items it stands for in its list or block: a statement sequence, `A; B`, its statements; a row a
# rule wrote, `$a, $rest...`, its items; none for a rule that wrote nothing, `()`. Each item keeps the rule that wrote it.
spread(result: Node, fired: list) as list := {
	items = spread_items(result) ?? return [result]
	fired[CHANGED] = yes
	items
}
# a list's statements, lines a later line continues joined (a change), each with the rules applied
statements_applied(language: Language, items: list, separator: Separator, applied: (Node) -> Node, fired: list) as list := {
	lines = lines_of(language, items, separator)
	if #lines != #items { fired[CHANGED] = yes }
	lines.flat_map(line => spread(applied(line), fired))
}
# the items a rule's sequence or row stands for, ø for any other result
spread_items(result: Node) as list? := match result {
	List(items, Bracket.None, separator) => if STATEMENT_SEPARATORS.contains(separator) or separator == Separator.Comma and fact_of(result, RULE) != ø then items.map(item => with_rule_of(item, result)) else ø
	_ => ø
}
# a group of one phrase keeps its brackets only around a phrase it became, whose words they hold together; any other
# result, a key, a call, a row or nothing, takes the group's place: `[(both a), c]`, `{(sub $x)...}`
group_kept(result: Node, bracket: Bracket) as Node := if is_phrase(result) and spread_items(result) == ø then List([result], bracket, Separator.None) else result
is_phrase(n: Node) as bool := match n { List(items, Bracket.None, Separator.Space) => yes; _ => no }
# a spliced item keeps the rule that wrote its sequence, so a later stage knows a rule wrote it
with_rule_of(item: Node, sequence: Node) as Node := {
	rule = fact_of(sequence, RULE)
	if rule == ø or item is Empty then item else with_fact(item, RULE, rule)
}
# DEBT: A rewrite that loops forever hangs the compiler instead of being refused: letting any rule read a square list
#   as one phrase made `xs = [1 2 3]` hang (some rule rewrote `1 2 3` again and again). A list is now one phrase only
#   when its first word leads a rule. A rewrite whose result fires the rules again without end should be refused by
#   name.
one_phrase(language: Language, items: list, bracket: Bracket) as bool := bracket == Bracket.Curly or bracket == Bracket.Round and not names_pattern(language, items#1)

rewritten(language: Language, rules: Rules, n: Node, fired: list) as Node := {
	current = n
	steps = rule_applied(language, rules, current)
	while steps is not empty {
		fired[FIRED] = yes
		fired[CHANGED] = yes
		if steps#1 is Empty { return steps#1 }
		current = replaced(current, steps#1)
		steps = rule_applied(language, rules, current)
	}
	current
}

# a typed rule's holes, each the code it took marked typed already, a sequence's items each (core/bindings.wap TYPED_HOLE)
typed_holes(bindings: map<text, Node>) as map<text, Node> := {
	marked: map<text, Node> = {}
	for hole in bindings.keys { marked[hole] = if hole.ends_with(REST_MARK) then with_parts(bindings[hole], marked_typed) else marked_typed(bindings[hole]) }
	marked
}
# code marked typed already; ø stays bare, as typing leaves it, so a later stage types it as ø
marked_typed(code: Node) as Node := if code is Empty then code else with_fact(code, TYPED_HOLE, True)
# a call of a function the program defines, `f(x)`, is the program's own: no rule of that glued head rewrites it, the
# program's word wins (phrase rules, `print x`, still fire)
programs_own(language: Language, n: Node, head: text) as bool := match n { Key(left, Op.None, group) => left is symbol and language.defined_words.has(spelling_written(left)) and head.starts_with(spelling_written(left) + " "); _ => no }
# the code the most specific fitting rule builds from it, as a list of that one code, empty when none fits; of two
# equally specific ones the one under the more specific head, else they are refused
# DEBT: The source avoids comparing an optional record with ø (here `best` as a list, patterns.wap names_pattern,
#   matcher.wap of_shape), because the seed's emitter compares records field by field.
#   Paid off at the next seed refresh, once the seed compares an optional with ø: `!= ø` and `best: Rule? = ø` again.
rule_applied(language: Language, rules: Rules, n: Node) as list<Node> := {
	# the most specific fitting rule so far, none or one (a list: the seed compares no record holding a map with ø)
	best: list<Rule> = []
	best_bindings = {}
	for head in heads_of(language, n) {
		if rules.by_head.has(head) and not programs_own(language, n, head) {
			for rule in rules.by_head[head] {
				bindings = {}
				if (rule.fact == "" or fact_of(n, rule.fact) == True) and matches(rule.matcher, n, bindings) {
					if best is not empty and best#1.specificity == rule.specificity and best#1.head == rule.head { refused(n, "two rules fit equally: ${best#1.written} and ${rule.written}") }
					if best is empty or rule.specificity > best#1.specificity { best = [rule]; best_bindings = bindings }
				}
			}
		}
	}
	if best is empty { return [] }
	chosen = best#1
	refusal = refusal_of(chosen.template)
	if refusal != ø { refused(n, refusal) }
	taken_holes = if matcher_stage(chosen.matcher) == TYPED_STAGE then typed_holes(best_bindings) else best_bindings
	result = built(language, chosen.template, with_fresh_names(taken_holes, chosen.fresh))
	taken = if chosen.fact == "" or result is Empty then result else with_fact(result, chosen.fact, False)
	[if taken is Empty then taken else with_fact(taken, RULE, chosen.written)]
}
