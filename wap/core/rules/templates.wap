# Templates: what a rule writes, its holes filled with the code they matched (warp's notes/first_principles.md "Holes").
# Reads a normalized template (core/rules/patterns.wap) and the bindings of a match; writes new code. A rest hole
# splices its items, a declared pattern called by name builds its node (`If(not $c, $body, ø)` is (If (Call not …) …)),
# a hole inside a text, "$f" or "get_$f", is the spelling of what it took, and every node the template itself spells is
# new, so the stage walker places it where the rewritten code was.
use "patterns.wap"
use "matcher.wap"
use "../parse/reader.wap"
use "../parse/operators.wap"
use "../errors.wap"
use "../stage.wap"
use "../type_notation.wap"
use "../../kernel/forms.wap"
use "../parse/operator_table.wap"
use "../parse/atoms.wap"
use "../parse/cascade.wap"
use "../../types/operators.wap"
use "../language.wap"
use "lowering.wap"

FRESH_MARK = "·"
# the shape a form's part must have, in the program's words
SHAPES_SAID: map<text, text> = {"Symbol": "a name", "List": "a list", "Key": "a `key: value`", "Text": "a text", "Number": "a number", "Char": "a character"}

# the template with each hole replaced by its binding, carrying the template's annotations, filled too, `@protocol Record(…)`,
# after those the bound code had; a template that is a repetition, `($m := $b)...`, the statements it writes, spliced where it stands
built(language: Language, template: Node, bindings: map<text, Node>) as Node := {
	repeated_by = rest_named(template)
	if repeated_by != ø { return List(repeated(language, repeated_by, bindings), Bracket.None, Separator.Newline) }
	said = annotations_of(template).map(annotation => filled(language, annotation, bindings))
	made = filled(language, template, bindings)
	if said is empty then made else with_fact(made, ANNOTATIONS, phrase_of(annotations_of(made) + said, Separator.Space))
}
# Every word a rule's template spells carries DERIVED: a definition's name ranks below the program's (analyze/calls.wap
# ranked), and a standard word it names is brought in without a hint (core/pipeline.wap standard_brought)
filled(language: Language, template: Node, bindings: map<text, Node>) as Node := match template {
	# a word the template spells itself is the rule's: a function it names yields to the program's (analyze/calls.wap ranked)
	Symbol(name) => if bindings.has(name) then bindings[name] else if bindings.has(name + REST_MARK) then taken_as_one(bindings[name + REST_MARK]) else with_fact(symbol(name), DERIVED, True)
	Key(head, Op.None, List(arguments, Bracket.Round, separator)) => {
		items = built_items(language, arguments, bindings)
		called_built(language, head, items, grown(items, Bracket.Round, separator), bindings)
	}
	Key(head, Op.None, Empty) => called_built(language, head, [], Empty, bindings)
	Key(left, op, right) => Key(built(language, left, bindings), op, built(language, right, bindings))
	List(items, bracket, separator) => grown(built_items(language, items, bindings), bracket, separator)
	Text(value) => Text(interpolated(value, bindings))
	Number(value) => Number(value)
	_ => template
}

# A call the template writes, `If(…)`, `Break()`: a declared pattern called by name builds its node, a literal called
# by its case's name its case, `False()`, `Symbol("$a.$b")` (literal_named below); any other head is called
# with the group
called_built(language: Language, head: Node, arguments: list<Node>, group: Node, bindings: map<text, Node>) as Node := head_built(language, head, arguments) ?? Key(built(language, head, bindings), Op.None, group)
# the form or the literal a head names, `If(…)`, `False()`, ø for any other head
head_built(language: Language, head: Node, arguments: list<Node>) as Node? := {
	if names_pattern(language, head) { return fitted(language, pattern_called(language, head)!, arguments) }
	literal = if head is symbol then literal_named(text(head), arguments) else []
	if literal is empty then ø else if literal#1 is symbol then with_fact(literal#1, DERIVED, True) else literal#1
}
# the form a template builds, refused at its parts where they do not fit the pattern's holes, `Record` given the key
# `Pair<A, B>` for its name, a Symbol: never left as a call of the pattern's builder that fails when the program runs
fitted(language: Language, pattern: Declared, parts: list<Node>) as Node := {
	holes = hole_matchers(pattern.matcher)
	for i in 1 to min(#holes, #parts) { if not holes#i.rest and holes#i.pattern == ø and holes#i.stage == SHAPE_STAGE and not of_type(holes#i, parts#i) { refused(parts#i, "`${parts#i}` stands where ${SHAPES_SAID.get(text(holes#i.type)) ?? text(holes#i.type)} is wanted") } }
	instance(language, pattern, parts)
}

# a typed rule's lowered template or pattern with each declared pattern it calls, `Prim(shown, …)`, built as that form
# and each literal it names, `False()`, as that literal, as a shape rule's template builds it, never left a call of a
# function of that name
forms_built(language: Language, n: Node) as Node := match n {
	Call(called, arguments) => head_built(language, called, arguments.map(argument => forms_built(language, argument))) ?? with_parts(n, part => forms_built(language, part))
	_ => with_parts(n, part => forms_built(language, part))
}
# a template text, each hole in it replaced by the spelling of what it took, the longest name first ($fx before $f)
interpolated(value: text, bindings: map<text, Node>) as text := {
	filled = value
	for name in sorted(bindings.keys, name => -#name) { filled = filled.replace(name, text(bindings[name])) }
	filled
}

# the items a rest hole took, written as one node where the template names it without dots: `$a` for `$a...` is the
# phrase `print "a"` (core/parse/cascade.wap phrase_of)
taken_as_one(taken: Node) as Node := match taken { List(items, bracket, separator) => phrase_of(items, Separator.Space); _ => taken }

# items of a template, a rest hole replaced by the items it took
built_items(language: Language, items: list<Node>, bindings: map<text, Node>) as list<Node> := {
	all: list<Node> = []
	for item in items {
		repeated_by = rest_named(item)
		if is_rest_hole(item) and bindings.has(hole_key(item)) {
			all += items_or_one(bindings[hole_key(item)])
		} else if repeated_by != ø {
			all += repeated(language, repeated_by, bindings)
		} else {
			all.add(built(language, item, bindings))
		}
	}
	all
}

# A bracketed list a repetition or rest made longer than written, `{ print($x)... }`, takes its natural separator: a
# block's statements one a line, other items by commas
grown(items: list, bracket: Bracket, separator: Separator) as Node := {
	if bracket == Bracket.None or separator != Separator.None or #items < 2 { return List(items, bracket, separator) }
	List(items, bracket, if bracket == Bracket.Curly then Separator.Newline else Separator.Comma)
}

# `Arm($p, $r)...`: the part once per match of a repetition, each of its holes bound to its own match in turn; a part
# in parentheses, `($f: $f)...`, is written without them, as a pattern reads it
repeated(language: Language, part: Node, bindings: map<text, Node>) as list<Node> := {
	sequences = holes_in(part).filter(hole => bindings.has(hole + REST_MARK)).unique
	if sequences is empty { refused(part, "a repeated part names no hole of a repetition or rest") }
	times = #items_or_one(bindings[sequences#1 + REST_MARK])
	written = []
	for i in 1 to times {
		for hole in sequences { bindings[hole] = items_or_one(bindings[hole + REST_MARK])#i }
		written.add(built(language, ungrouped(part), bindings))
	}
	for hole in sequences { bindings.remove(hole) }
	written
}

# Hygiene: a name the template binds itself, `m = $b`, is renamed fresh at each use (m·1, m·2 …), so it can neither
# capture the program's m nor be captured by it. These are the names; their fresh spellings join the bindings.
names_bound_in(language: Language, template: Node) as list<text> := placed_in(language, template, name_placed)
# A definition the template writes keeps its parameters' names, `self` the program's method body reads, but binds them
# as a written definition does: its body's `index` is the parameter, never a function of that name
parameters_bound_in(language: Language, template: Node) as list<text> := placed_in(language, template, parameters_placed)
# the names the places of the template's assignments bind, as named reads each place
placed_in(language: Language, template: Node, named: (Node) -> list<text>) as list<text> := match template {
	Call(called, arguments) => {
		inner = arguments.flat_map(argument => placed_in(language, argument, named))
		if #arguments == 2 and assigning(language, called) then named(arguments#1) + inner else inner
	}
	# a typed rule's template is lowered: its assignment a Set
	Set(place, value) => named(place) + placed_in(language, value, named)
	_ => direct_parts(template).flat_map(part => placed_in(language, part, named))
}
# a place's name, typed or not: `m = …` and `m: T = …` both bind m
name_placed(place: Node) as list<text> := [declared_name(place)].filter(name => name is symbol and not is_hole(name)).map(spelling_written)
# a definition head's parameters, `f(index: int): T`
parameters_placed(place: Node) as list<text> := match place {
	Key(signature, Op.Colon, result) => parameters_placed(signature)
	Key(name, Op.None, group) => arguments_of(group).flat_map(name_placed)
	_ => []
}

# whether a called operator is in the assignment group: `=`, `:=`, `+=` …
assigning(language: Language, called: Node) as bool := group_of(language, spelling_written(called), Fixity.Infix) == compound_assignment_group

fresh_count = [0]
# the bindings with each name the rule's template binds made fresh, each parameter it binds its plain name
with_bound_names(bindings: map<text, Node>, rule: Rule) as map<text, Node> := {
	fresh_count[0] = fresh_count[0] + 1
	for name in rule.fresh { bindings[name] = with_fact(symbol(name + FRESH_MARK + fresh_count[0]), FRESH, symbol(name)) }
	for name in rule.parameters { bindings[name] = symbol(name) }
	bindings
}

# Node's cases a template writes by name, as a list of the one it builds (Empty is one), none for any other call: the
# literals without fields, `False()`, and a symbol of a text, `Symbol("$type.$operation")` the word its holes spell
# DEBT: The literals a template writes are named twice: `True()`, `False()` and `Empty()` are spelled out here beside
#   types/nodes.wap's declaration of Node's fieldless cases, because templates are built before the types module's
#   Records are declared. Paid off when templates see the declared Records: the table goes for that lookup.
literal_named(name: text, parts: list<Node>) as list<Node> := {
	if name == "Symbol" and #parts == 1 { return match parts#1 { Text(value) => [Symbol(value)]; _ => [] } }
	if parts is not empty { return [] }
	match name { "True" => [True]; "False" => [False]; "Empty" => [Empty]; _ => [] }
}
