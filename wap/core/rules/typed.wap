# Typed rules (stage 3): typed kernel → typed kernel (notes/backbone.md "Stage languages", decision hole-types).
#
# A rule with a hole of a value type, `$xs: list<int>` or `$f: (float) -> float`, fires on code whose type is settled
# (core/analyze/types.wap fits_type). Its pattern and template are lowered like the program (core/rules/stages.wap).
# It fires inside the type walk, on each node as typing writes it and before elaborate: what it wrote is bound and
# typed in place, with the frame and the type expected there, so the code around it reads the type it gives; the code
# its holes took stays as typed (core/bindings.wap TYPED_HOLE).
#
#   rule twice $x: int => $x + $x      a rule only ints take
#   twice 3                            3 + 3, typed in place
use "stages.wap"
use "lowering.wap"
use "../analyze/scope.wap"
use "../analyze/names.wap"
use "../analyze/types.wap"
use "../errors.wap"
use "../stage.wap"
use "../bindings.wap"
use "../../kernel/forms.wap"
use "../language.wap"
use "../analyze/declarations.wap"
use "../analyze/definers.wap"

# the typed rules and the scope what they write binds in: the program's top level, inside the library
class KindRules { language: Language; scope: Scope }

# the bound program typed, the typed rules firing as it is typed (a script's value is shown by one,
# sugar/calls.wap), what they write bound among the program's words and its used modules', `And` of `use logic`; its
# definitions checked against the words every program has where its file runs a statement: a file of definitions only
# is a library, which may replace one, as a module a program uses may
typed_by_rules(language: Language, program: Block, library: list<Signature>, used: list<Module>, types: Library, signatures: list<Signature>, written: list<Signature>, runs: bool) as Block := {
	scope = block_scope(program, statements_in(program), scope_around(library, used), PROGRAM_DEPTH)
	typed_program(program, types, KindRules(language, scope), signatures, if runs then library else [], written)
}
# typed code rewritten by the typed rule that fits it, what the rule wrote bound and typed in its place, the names it
# defines given their ids first, `held = $a`; the typed rules never fire on what one wrote, so it is typed once
kind_rewritten(typed: Node, s: TypingState, f: TypeFrame, expected: Term?) as Node := rule_rewritten(typed, s, f, expected) ?? typed
rule_rewritten(typed: Node, s: TypingState, f: TypeFrame, expected: Term?) as Node? := {
	rules = s.kind_rules ?? return ø
	if f.rewritten { return ø }
	steps = rule_applied(rules.language, rules.language.grammar.typed_rules, typed)
	if steps is empty { return ø }
	f.rewritten = yes
	rewritten = try typed_form(bound_in(steps#1, rules, s), s, f, expected) catch e {
		f.rewritten = no
		raise e.message
	}
	f.rewritten = no
	rewritten
}
# code the typing stage writes bound as the program's top level is, its definers given their ids: a rule's template,
# a subtype's condition lowered first (core/analyze/shapes.wap narrowing_test)
bound_in(code: Node, rules: KindRules, s: TypingState) as Node := bound(definers_identified(code, s.ids), rules.scope, PROGRAM_DEPTH)
written_bound(code: Node, s: TypingState) as Node := {
	rules = s.kind_rules ?? raise("a subtype's condition is read where no rules are")
	# a condition written in a value's place comes lowered with it, one in a type's place as notation
	bound_in(if code is Fn then code else lowered(rules.language, code), rules, s)
}
# a word and the map a blank parts from it, typed as two items, `size_of {"a": 1}`: the call of the word with the map
# where a typed rule takes that phrase, else the two items, said with the glued call (decision spaced-is-two)
parted_rewritten(listed: Node, n: Node, s: TypingState, f: TypeFrame, expected: Term?) as Node := {
	written = fact_of(n, PARTED) ?? return listed
	taken = match listed { List(items, bracket, separator) => rule_rewritten(Call(items#1, [items#2]), s, f, expected); _ => ø }
	if taken != ø { return taken }
	match written { List(words, bracket, separator) => hint(warning_of(written, "a blank parts ${words#1} from the map after it, so these are two items: write ${words#1}{…} for the call")); _ => ø }
	listed
}
