# A definition's record: core/analyze/declarations.wap builds it, typing holds it, the emitter names exports by it

use "stage.wap"
use "bindings.wap"
use "type_notation.wap"

# the arrow an export's name writes its result after, where a program writes `as`
EXPORT_ARROW = "→"

# What a program's top level declares, as every stage after declare knows it, its one record: its name, the key of its
# place, its kind (a function, a value or a record), the name that defines it, its parameters' types, its written
# result, its module's file, and whether typing has shaped its types. It holds no body: a stage finds the definition as
# it is now by the key (core/analyze/types.wap define_of). record: a record's own Record node, held only because its
# readers take its fields and cases from it today, never a second copy of its code
class Signature { name: text; key: text; kind: DefinitionKind; definer: Node; parameters: list<Node?> = []; result: Node? = ø; module: text = ""; record: Node? = ø; shaped: bool = no; names: list<text> = []; defaults: list<Node?> = [] }
# the record of a function named, with its parameters, their names and defaults, and its written result
signature_from(name: Node, parameters: list<Node>, result: Node?) as Signature := Signature(text(name), place_key(name), DefinitionKind.Function, name, parameters.map(type_given), result, file_of(name) ?? "", names: parameters.map(parameter => text(declared_name(parameter))), defaults: parameters.map(parameter => fact_of(parameter, DEFAULT)))
# A function's header line as its export is named (wiki/wasm-representation.md "Export names"):
# `add(a: int, b: int = 1) → int`, each parameter by name, type and default, the result after the arrow unless none
signature_text(signature: Signature) as text := "${signature.name}(${(1 to #signature.names).map(at => parameter_text(signature, at)).join(", ")})${if signature.result == ø then "" else " ${EXPORT_ARROW} ${type_text(signature.result)}"}"
parameter_text(signature: Signature, at: int) as text := {
	typed = if signature.parameters#at == ø then "" else ": " + type_text(signature.parameters#at)
	default = signature.defaults#at
	signature.names#at + typed + (if default == ø then "" else " = " + code(default!))
}
# a parameter's type, given by an earlier typing, else written: a generic function's instance takes its own types, and
# typing a typed program again changes nothing
type_given(parameter: Node) as Node? := fact_of(declared_name(parameter), TYPE) ?? declared_type(parameter)
