# The one walker every stage runs through: a rewrite applied to a node, and the metadata carried over (the stages:
# wap/compiler.wap).
#
# A stage only says what a node becomes. Where the result was written is never its business: `replaced` gives every
# node the rewrite built the position of the node it rewrote, so an error found three stages later still points at
# the user's line. Nodes the rewrite reused, the parts of the input it took apart and put back (a pattern's holes),
# keep their own positions:
#
#   print 3                     the phrase, written at line 2
#   → Call(print, [3])          the Call and its argument list are new: line 2, like the phrase
#                               print and 3 were reused: their own columns
#
# Later the stamp also carries the name of the rule or stage that built the node, for errors like
# `line 4: unless … (rule extensions/…:3): …`.

use "errors.wap"
use "../kernel/forms.wap"
use "type_notation.wap"

# n replaced by what a stage built from it, every node built placed where n was written; the
# result stands for n, so it also takes the facts earlier stages learned about n (a definition's declaration survives
# its lowering)
replaced(n: Node, built: Node) as Node := with_facts_of(placed_like(built, n), n)

# where n was written, its line and column together, ø for a node without a position
class Position { line: int, column: int }
# where a node is written, ø for a node made by the compiler; a node with a line has its column too
position_of(n: Node) as Position? := {
	line = line_of(n) ?? return ø
	Position(line, column_of(n)!)
}
# n placed where origin was written, its facts kept; n itself when origin has no position
positioned_like(n: Node, origin: Node) as Node := {
	at = position_of(origin) ?? return n
	positioned(n, at.line, at.column)
}

# The new node a rewrite built, and each of its new parts, given the position of the code it replaced (a rebuilt node
# keeps its own: refitted); a part that has a position already was reused, and the walk stops there. An origin
# without a position (a node a stage built) passes on none.
placed_like(built: Node, origin: Node) as Node := {
	# Empty (and an empty `{}` or `()`, Empty in warp) carries no metadata
	if built is Empty or line_of(built) != ø or line_of(origin) == ø { return built }
	placed = with_facts_of(positioned_like(with_parts(built, part => placed_like(part, origin)), origin), built)
	file = file_of(origin) ?? return placed
	with_fact(placed, SOURCE_FILE, Text(file))
}

# The same node rebuilt, its parts replaced, as a stage that only learns facts rebuilds it (binding, typing): it keeps
# its own position and the facts earlier stages learned. A new node a rewrite built takes only the position of the
# code it replaced, placed_like.
refitted(built: Node, original: Node) as Node := {
	with_facts_of(positioned_like(built, original), original)
}

# n with each fact of the original whose name it holds no fact of: what n learned itself wins; Empty carries none
with_facts_of(n: Node, original: Node) as Node := {
	if n is Empty { return n }
	held = attributes_of(n)
	for fact in attributes_of(original) { if (if fact_name(fact) == "" then not held.contains(fact) else not held.any(other => fact_name(other) == fact_name(fact))) { n = with_attribute(n, fact) } }
	n
}

# a node with each of its direct parts changed by f
with_parts(n: Node, f: (Node) -> Node) as Node := match n {
	Key(left, op, right) => Key(f(left), op, f(right))
	List(items, bracket, separator) => List(items.map(f), bracket, separator)
	_ => n
}
# code with each `name` in it read as another
substituted(n: Node, name: text, value: Node) as Node := if n is symbol and text(n) == name then value else with_parts(n, part => substituted(part, name, value))
# a node's direct parts: a key's two sides, a list's items; none of an atom
direct_parts(n: Node) as list<Node> := match n {
	Key(left, op, right) => [left, right]
	List(items, bracket, separator) => items
	_ => []
}
# a node and every node within it
nodes_in(n: Node) as list<Node> := [n] + direct_parts(n).flat_map(nodes_in)

# the fact of the `@annotations` written before a node, `@protocol Record(…)`: their phrase
ANNOTATIONS = "meta"
# the annotation naming the class a class extends
EXTENDS_ANNOTATION = "extends"
# the annotation naming the sort of an enum's values
INDUCTIVE_ANNOTATION = "inductive"
# the annotation of a definition taken as given: its written type, no body, `@axiom f: A`
AXIOM_ANNOTATION = "axiom"
# the annotation naming the letters of a generic record
PARAMETERS_ANNOTATION = "parameters"
# the mark of a law's or a theorem's proof (extensions/law_for.wap)
PROOF_ANNOTATION = "proof"
# the annotations written before a node, each one: `@final @protocol` two
annotations_of(n: Node) as list<Node> := match fact_of(n, ANNOTATIONS) ?? Empty { Empty => []; List(items, Bracket.None, Separator.Space) => items; said => [said] }
# the annotation of one word written before a node, `@protocol` or `@extends(A)`, ø without it
annotation(n: Node, word: text) as Node? := annotations_of(n).find(said => match said { Key(Symbol(name), Op.None, arguments) => name == word; _ => text(said) == word })
# the fact naming the rule that built a node: the rule's head, where it was written
RULE = "rule"
# the fact of a name a rule's template made fresh, m·1 (core/rules/templates.wap): the name as the template wrote it
FRESH = "fresh"

# Facts a stage learns about a node (notes/backbone.md "Stage languages"): a name's binding, a type, the overload a
# call chose. Each is a named entry in the node's metadata, never a hole of its shape, so a form keeps the same holes
# from stage to stage. A later fact of the same name replaces the earlier.
with_fact(n: Node, name: text, value: Node) as Node := with_attribute(n, Key(symbol(name), Op.Colon, value))
# a list as data writes it, `[a, b]`: a fact's items, a call's arguments as data
data_list(items: list<Node>) as Node := List(items, Bracket.Square, Separator.Comma)
# whether a stage has learned the fact of that name; one that holds ø is learned too, `o: text? = ø` a default
has_fact(n: Node, name: text) as bool := fact_of(n, name) != ø
# a fact's name, "" of an attribute that is no fact
fact_name(fact: Node) as text := match fact { Key(Symbol(name), Op.Colon, value) => name; _ => "" }
# a fact's text, ø for none
text_of(fact: Node?) as text? := match fact { Text(value) => value; _ => ø }
# the fact of that name, ø when no stage has learned it; both read a Meta's facts in place, never a copy of them
fact_of(n: Node, name: text) as Node? := {
	match n { Meta(node, List(data, bracket, separator)) => for at in META_FACTS to #data { match data#at { Key(Symbol(key), Op.Colon, value) => if key == name { return value }; _ => ø } }; _ => ø }
	ø
}
# the items of a fact that holds a list, none when no stage has learned it; a fact set to anything else is a stage's bug
fact_items(n: Node, name: text) as list<Node> := {
	found = fact_of(n, name)
	if found == ø { return [] }
	match found {
		List(items, bracket, separator) => items
		_ => refused(found, "the fact ${name} holds a list")
	}
}

# Where a node was written: line_of and column_of its position, file_of the file the reader read it from (ø for a
# node no file holds), a fact SOURCE_FILE the reader gives every node with a position
SOURCE_FILE = "file"
# the spelling a program wrote for code the reader gave another shape, which `wap format` prints back: the text
# `"a ${x} b"` read as ("a " + text(x) + " b")
WRITTEN = "written"
# a compound assignment's written spelling, `+=`, on the assignment and its operator's call (core/parse/keys.wap)
COMPOUND = "compound"
# a `{…}` the reader built from a block indented below its line, not one written there: `if c⏎\tbody`, not `Point{x: 1}`
INDENTED = "indented"
# what a declared pattern's builder carries on its name, so that binding finds the pattern through scope: its holes
# in order, the Node pattern that takes it apart in an arm
PATTERN_HOLES = "pattern_holes"
PATTERN_TAKEN = "pattern_taken"
# a pattern a declared pattern's call wrote, `Record(n, f, v)` in an arm, carries the pattern's name
SHAPE_OF = "shape_of"
# `it`, the parameter code names without declaring it (core/rules/lowering.wap names_it): never a variable the program
# assigns, which would make the code around it a block (wiki/Footguns.md)
IT_WORD = "it"
# a function's inverse is the function of its name and INVERSE_MARK, `successor⁻¹`; a pattern naming a function with an
# inverse carries INVERSE: binding, the inverse's name, typing, its call unwrapped (wiki/enum.md "Patterns by inverse")
INVERSE_MARK = "⁻¹"
INVERSE = "inverse"
# a bare name in a pattern that names a program's constant, `limit`, is that value, matched by equality, and carries VALUED
VALUED = "valued"
# a list's items, none of any other node
items_of(n: Node) as list := match n {
	List(items, bracket, separator) => items
	_ => []
}
# a list with these items instead, its bracket and separator kept; any other node as it is
with_items(n: Node, items: list) as Node := match n {
	List(old, bracket, separator) => refitted(List(items, bracket, separator), n)
	_ => n
}
file_of(n: Node) as text? := match fact_of(n, SOURCE_FILE) {
	Text(name) => name
	_ => ø
}

# A written name, bare or typed, as a parameter (`b: int = 1` before lowering), a Set's place and a Define's name write
# it. The type is the program's, never a fact a stage learned: declared_name is the name, declared_type the type or ø.
declared_name(n: Node) as Node := match n {
	Key(name, Op.Colon, type) => declared_name(name)
	Call(called, arguments) => if is_default_given(n) then declared_name(arguments#1) else n
	Set(place, value) => declared_name(place)
	_ => n
}
# whether two written names, bare or typed, name the same thing: a field and an instance's item, two parameters
same_name(a: Node, b: Node) as bool := text(declared_name(a)) == text(declared_name(b))
declared_type(n: Node) as Node? := match n {
	Key(name, Op.Colon, type) => type
	Call(called, arguments) => if is_default_given(n) then declared_type(arguments#1) else ø
	Set(place, value) => declared_type(place)
	_ => ø
}
# a name given its default, `b: int = 1`
is_default_given(n: Node) as bool := match n {
	Call(called, arguments) => text(called) == "=" and #arguments == 2
	_ => no
}
# a written name with a fact on its name: `x: int` keeps its type
with_name_fact(n: Node, name: text, value: Node) as Node := match n {
	Key(written, Op.Colon, type) => refitted(Key(with_name_fact(written, name, value), Op.Colon, type), n)
	_ => with_fact(n, name, value)
}
# A definition's identity. Each name that defines something carries its DEFINER fact, an id "f#n", f its file's number, n one counter of
# its module gives out: the declaration prescan to the top level's names, the binding analysis to a function's
# parameters, variables and pattern names, typing to the names it writes. Two definitions one rule writes at one
# place are two ids, and formatting changes none; positions are only for messages. The count a stage leaves is its
# program's fact DEFINERS, where the next stage goes on counting.
DEFINER = "definer"
DEFINERS = "definers"
class Definers { file: text; count: int = 0 }
# a module's counter, going on from the count its program holds
definers_of(program: Node) as Definers := Definers(text(file_number(file_of(program) ?? ".")), match fact_of(program, DEFINERS) {
	Number(count) => count
	_ => 0
})
# a file's number, its place among the files the compile read (core/errors.wap sources_read), so an id is short however
# long the path; a file it holds no source of, code given as text, counted in without one
file_number(file: text) as int := {
	if not sources_read.has(file) { sources_read[file] = "" }
	index_of(sources_read.keys, file)
}
# a program with the count its stage left
with_definers(program: Node, ids: Definers) as Node := with_fact(program, DEFINERS, Number(ids.count))
# a defining name with its id: the one it has, or the counter's next
identified(definer: Node, ids: Definers) as Node := {
	if fact_of(definer, DEFINER) != ø { return definer }
	ids.count += 1
	with_fact(definer, DEFINER, Text("${ids.file}#${ids.count}"))
}
# A definition's key: its definer's id (the same in each typed version), the name, and the signature of a typed
# function, which tells its typed versions apart
place_key(definer: Node) as text := "${definer_id(definer)} ${text(definer)}${signature_key(definer)}"
# a declaration's place in the source, one however often its module is read and identified; its key where it has none
declaration_place(n: Node) as text := {
	at = position_of(n) ?? return place_key(n)
	"${file_of(n) ?? ""} ${at.line}:${at.column}"
}
definer_id(definer: Node) as text := text(fact_of(definer, DEFINER) ?? refused(definer, "a definition is named by a word, and this name reads as a value (null, yes, a number …): rename it"))
signature_key(definer: Node) as text := if fact_of(definer, SIGNATURE) == ø then "" else " ${type_text(fact_type(fact_of(definer, SIGNATURE)), yes)}"

# DEFINED_AT on a bound name: the name that defined it, positioned (core/analyze/scope.wap learns it; its other
# facts are in core/bindings.wap)
DEFINED_AT = "defined_at"
# BINDING on a bound name: what it refers to, the word of its DefinitionKind as a Symbol
BINDING = "binding"
# REBOUND on a name read or set: the definer of the binding it holds there where an assignment of another type made
# one of its own (core/analyze/flow.wap); the emitter keys its storage by it
REBOUND = "rebound"
# a type's name bound to the name of the Record declaring it, as the code writing it sees it: a module's class hides
# the types module's of one name only inside the module (core/analyze/scope.wap type_bound)
DECLARED_BY = "declared_by"
SELF_WORD = "self"
# on a call's word in a method, the receiver it passes first to a sibling method called bare (core/analyze/scope.wap)
RECEIVER = "receiver"
# the fact of a part read where a call was written, `f(x, 2)` read `x.f(2)`: the call a refusal names
WRITTEN_CALL = "written_call"
# on a Define of a used module that nothing exports: typed, and so emitted, only once something calls it
# (pipeline.wap called_only)
TYPED_WHEN_CALLED = "typed_when_called"
# on a used module's value of a written type that nothing exports: typed, and so computed, once something reads it
TYPED_WHEN_READ = "typed_when_read"
# on a parameter, the value a call that leaves it out gives it: `f(x: int, y: int = 2)`, f(1) is f(1, 2)
DEFAULT = "default"
# on a written type shaped as a call, `a + 0 == a`, `P(f)`, its reading as code, lowered: what scope binds where its
# head makes no type, a statement (scope.wap type_bound)
AS_CODE = "as_code"
# the words of a type test, `s is Circle`, where nothing else defines it, and of the equality `3 is 3` asks (scope.wap)
TYPE_TEST_WORD = "is"
# the word a value's static type is asked by, `type of x` (sugar/types.wap)
TYPE_OF_WORD = "type_of"
# the words of a proof (wiki/proof.md): `by` the laws it follows from, `refl` an equation's sides the same, `assume` a
# statement taken as true
BY_WORD = "by"
REFL_WORD = "refl"
ASSUME_WORD = "assume"
PROOF_WORDS = [REFL_WORD, ASSUME_WORD]
# a word the language reads itself where no program defines it: `is`, `type_of`, `by`, `refl`
question_word(n: Node, word: text) as bool := n is symbol and text(n) == word and fact_of(n, BINDING) == ø
EQUALITY_WORD = "=="
# the word a function's effects are asked by, `effects of f` (sugar/types.wap)
EFFECTS_OF_WORD = "effects_of"
# the compiler's questions, each answered by the compiler itself where no definition takes its word, its argument left
# as written but for a value it names (core/analyze/scope.wap, calls.wap answered)
QUESTION_WORDS = [TYPE_OF_WORD, EFFECTS_OF_WORD]
# the words whose arguments scope binds only where they name values: the questions, and `by`, whose arguments name laws
NAMING_WORDS = QUESTION_WORDS + [BY_WORD]
# on a body, the effects its function claims after it, `! IO` (core/analyze/effects.wap)
CLAIMED = "claimed"
# on a typed function's Define, the effects it has, each a word (core/analyze/effects.wap)
EFFECTS = "effects"
# A type test of a value any or a number holds, `x is int`, is asked at run time: the Prim BOXED_TEST of x, the type
# it tests its fact TESTED. Where it holds, x reads as that type, the Prim OPTIONAL_VALUE of x, as a present optional
# reads as its value.
BOXED_TEST = "boxed_test"
# the case of Node a raise is caught as, Error(Text(message)), and a failable value holds: `int or Error`
ERROR_CASE = "Error"
# `prim cast(x)`, x an any: its value as the Prim's type, checked, raising with the place when it holds another type
CHECKED_CAST = "cast"
# `prim as_is(x)`: x as another type of its layout, a type value as the text it holds (types/prelude.wap): x itself
READ_AS_IS = "as_is"
# `prim box(x)`, x a plain value (int, float, bool, char) going into an any or an optional: x in its box, the Prim's
# type the one wanted; only typing writes it (notes/decisions.md wap-boxed-any-debt)
BOXED_VALUE = "box"
TESTED = "tested"
# on a word called through a type, `nat.recursor(…)`: that type's name, so the call takes only definitions taking it
OWNER = "owner"
OPTIONAL_VALUE = "optional_value"
# on code that never finishes, a return, break or continue, a block ending in one, a choice all of whose arms jump, a
# call of a function that never returns: it has no type, and a join of arms skips it
JUMPS = "jumps"
# on a word a rule's template spells itself: a function it names yields to one the program wrote (core/analyze/calls.wap
# ranked)
DERIVED = "derived"
# the pattern of a Case's arm that fits any value and names none
WILDCARD = "_"
# what starts a hole, `$c`, and what ends a rest hole, `$items...`, or starts a list pattern's rest, `...rest`
# (first_principles.md "Holes")
HOLE_SIGN = "$"
REST_MARK = "..."
# A list pattern, `[]`, `[first, ...rest]`: its items' patterns, a last `...name` naming the items after them; ø for
# any other pattern
list_pattern_items(pattern: Node) as list? := match pattern {
	List(items, Bracket.Square, separator) => items
	_ => ø
}
# the name a list pattern's `...name` gives the rest, ø for any other item
rest_named(item: Node) as Node? := match item {
	Call(called, names) => if text(called) == REST_MARK and #names == 1 then names#1 else ø
	_ => ø
}

# The facts of the typing stage, core/analyze/types.wap: a value's TYPE, `int`, as a program writes types; a function's
# SIGNATURE on its name, `(int, text) -> int`; a call's DEFINED_AT then names the one function it means
TYPE = "type"
# on a type as a value, `int` in `identity(int, 3)`: the type it is (core/analyze/types.wap type_value)
DENOTES = "denotes"
# on a function's name called at a level, `identity[1](…)`: the level written (core/analyze/calls.wap level_written_call)
LEVEL_WRITTEN = "level"
SIGNATURE = "signature"
# A list's places by name, for a list that only grows or is changed in place, as the typing state's definitions and a
# program's records are: indexed up to `count`, extended for the items added since
class NameIndex { places: map<text, list<int>> = {}, count: int = 0 }
# the items of a name in the order written; a place past the list's end, or an item at an indexed place that bears
# another name now, is refused: the list changed other than by growing or in place
items_named(index: NameIndex, items: list<T>, name: text, name_of: (T) -> text) as list<T> := {
	while index.count < #items {
		key = name_of(items[index.count])
		index.places[key] = (index.places.get(key) ?? []) + [index.count]
		index.count += 1
	}
	places = index.places.get(name) ?? []
	places.map(place => if place >= #items then refused(symbol(name), "the list indexed for ${name} shrank: it may only grow or change in place") else if name_of(items[place]) == name then items[place] else refused(symbol(name), "an item indexed under ${name} bears another name now: the list it is indexed in changed other than in place"))
}
# The Records a program declares, in the order written, found by name through their index; added_records is their
# only writer, so the index keeps up with the list; extending, the names of those that extend another, so a type
# extending none is never looked for
class Records { items: list<Node> = [], names: NameIndex = NameIndex(), extending: list<text> = [] }
added_records(records: Records, added: list<Node>) as Records := {
	kept = added.filter(statement => statement is Record)
	Records(records.items + kept, records.names, records.extending + kept.filter(record => class_extended(record) != ø).map(record_name))
}
# A record's TYPE is its name, `Point`; these find a record among the Records a program declares, and its fields,
# each a typed name `x: int` (declared_name, declared_type)
record_named(records: Records, type: Term?) as Node? := {
	if word_of(type) == ø { return ø }
	named = items_named(records.names, records.items, word_of(type)!, record => record_name(record))
	# the one its code sees, else the one declared last: a program's own class, or a used module's, shadows the types
	# module's
	declared = declared_by(type)
	if declared == ø { return if named is empty then ø else named.last }
	named.find(record => declaration_place(record_declared(record)) == declaration_place(declared!)) ?? refused(declared!, "this type names a record its scope declared at ${declaration_place(declared!)}, but the program's records hold no record from that place")
}
record_name(record: Record) as text := text(record_declared(record))
record_declared(record: Record) as Node := match record { Record(name, fields, variants) => name }
# the class a class extends, `@extends(A)` on its name (wap/sugar/records.wap), ø for one extending none
class_extended(record: Node) as Node? := annotated(record_declared(record), EXTENDS_ANNOTATION)
# the sort an enum's header names, `@inductive(Prop)` on its name (wap/sugar/records.wap), ø for an enum naming none
enum_sort(name: Node) as Node? := annotated(name, INDUCTIVE_ANNOTATION)
# the parameters a record's header names, `T` of `enum list<T>`, `a: Prop` of `enum And(a: Prop, b: Prop)`,
# `@parameters(…)` on its name; none for a record naming none
record_parameters(name: Node) as list<Node> := annotated_all(name, PARAMETERS_ANNOTATION)
# their names, the words its fields' types and its uses' parts fill
record_letters(name: Node) as list<Node> := record_parameters(name).map(parameter => match parameter { Key(letter, Op.Colon, type) => letter; _ => parameter })
# what an annotation of one word says, `A` of `@extends(A)`; ø without it
annotated(n: Node, word: text) as Node? := { said = annotated_all(n, word); if said is empty then ø else said#1 }
annotated_all(n: Node, word: text) as list<Node> := match annotation(n, word) { Key(name, op, List(items, bracket, separator)) => items; _ => [] }
# the type a subtype is (wiki/alias.md), `int` of `type Color < int` (core/rules/stages.wap): the type its record
# extends, which is no record; ø for any other type
subtype_base(type: Term, records: Records) as Term? := {
	if not records.extending.contains(word_of(type) ?? return ø) { return ø }
	base = type_term(class_extended(record_named(records, type) ?? return ø) ?? return ø)
	if record_named(records, base) == ø then base else ø
}
# a record as a type, its name bound to it, so it means this record wherever another of its name is declared too
record_type(record: Record) as Node := {
	word = with_fact(symbol(record_name(record)), DECLARED_BY, record_declared(record))
	letters = record_letters(record_declared(record))
	if letters is empty then word else Key(word, Op.None, List(letters, Bracket.Less, Separator.Comma))
}
# its term (core/type_notation.wap)
record_term(record: Record) as Term := type_term(record_type(record))
fields_of(record: Record) as list := match record { Record(name, fields, variants) => items_of(fields) }
# An enum's cases, as its Record's variants hold them: a bare name, `Dot`, or a name with its fields, `Circle(r: float)`
cases_of(record: Record) as list<Node> := match record { Record(name, fields, variants) => items_of(variants) }
# GUESS (T6a3's indices): a case written with the type it gives, `step(k: nat, h: Even(k)): Even(k + 2)`, is that type after a
# colon beside its shape; case_result is that type's code, ø for a case giving its enum itself
case_shape(case: Node) as Node := match case { Key(shape, Op.Colon, result) => shape; _ => case }
case_result(case: Node) as Node? := match case { Key(shape, Op.Colon, result) => if is_spelling(result) then ø else result; _ => ø }
# whether a case's part after its colon is its spelling, a written text or character (`fail = "✗"` reads as a Char),
# not the type it gives
is_spelling(part: Node) as bool := match part { Text(value) => yes; Char(value) => yes; _ => no }
case_name(case: Node) as Node := match case_shape(case) { Call(called, fields) => called; shape => shape }
# a declared case's text, its spelling or else its name: `empty = "ø"` is "ø" (core/analyze/declarations.wap case_lowered)
SPELLING = "spelling"
case_text(case: Node) as text := text(fact_of(case_name(case), SPELLING) ?? case_name(case))
# the patterns of a case pattern's fields, `r` and `0` of `Circle(r, 0)`
case_fields(case: Node) as list<Node> := match case_shape(case) { Call(called, fields) => fields; _ => [] }
# the declared case a bound case name means, by the place its DEFINED_AT names (core/analyze/scope.wap), and the enum
# declaring it: two enums may each have a case of one spelling
case_declaring(records: Records, name: Node) as Node := declaring(records, name)#2
enum_declaring(records: Records, name: Node) as Node := declaring(records, name)#1
declaring(records: Records, name: Node) as list := {
	key = place_key(fact_of(name, DEFINED_AT) ?? refused(name, "this case name reached here unbound"))
	for record in records.items { for case in cases_of(record) { if place_key(case_name(case)) == key { return [record, case] } } }
	refused(name, "no enum the program declares has this case")
}
# a record's field of this name, ø when it has none
field_named(record: Node, key: Node) as Node? := fields_of(record).find(field => same_name(field, key))
# the one item of a list, ø for none, several or no list
only(items: list<Node>?) as Node? := if items != ø and #items == 1 then items#1 else ø
# on a program, the files it USES (`use "path"`), each a Text of the path resolved against the program's own folder
USES = "uses"

# A line's comma or semicolon row in braces stands for its items, `{a: 1; b: 2⏎c: 3}`; any other item for itself
row_items(item: Node) as list := match item { List(row, Bracket.None, separator) => if separator == Separator.Comma or separator == Separator.Semicolon then row else [item]; _ => [item] }
