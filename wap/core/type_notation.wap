# Types as kernel terms (notes/coc-t3.md "Where a type lives"), and the notation programs write them in. A type is its
# word applied to its parts: `list<int>` the constant list applied to int, `int?` the constant ? applied to int, a
# function value's own type its function's own word applied to its captures' types. A function type is a Pi:
# `(int, text) -> bool` takes the list of its parameters' types, `and int (and text none)`, to bool, so it is never
# the curried `(int) -> (text) -> bool`. Every word is an opaque constant the compile's kernel environment declares
# as it first meets it, a type of its parts' types (list : Type -> Type); the words core builds types of come first,
# each at its place among CORE_WORDS, so their constants are fixed.
#
# A compile keeps one table of the types it met, each entered once, so a fact names its type by its place there and
# two facts of one type are equal. A type a program writes is notation, code like any other: type_term reads it into
# its term, type_text writes a term back as a program writes it, for messages and `format` only.

use "stage.wap"
use "errors.wap"
use "../kernel/forms.wap"
use "../kernel/primitives.wap"
use "../kernel/terms.wap"
use "../kernel/levels.wap"
use "../kernel/environment.wap"
use "../kernel/equality.wap"
use "../kernel/logic.wap"
use "../kernel/counting.wap"
use "../kernel/inductive.wap"
use "../kernel/typing.wap"
use "../kernel/recursors.wap"
use "../kernel/show.wap"
use "analyze/courses.wap"

# a written `block`: code run by its call, a function of no parameters (wiki/block.md)
BLOCK_WORD = "block"
# A function type, `(int, text) -> bool`: the parameters' types in round brackets, an arrow, the result's type; its
# parameters' types are a list of two words, the one of a type before others and the one of none. The arrow heads a
# function type's parts as type_parts lists them, its parameters' types and its result's, never a term
FUNCTION_ARROW = "->"
PARAMETERS_WORD = "and"
NO_PARAMETERS_WORD = "none"
# A subtype by condition, `int where it > 0` (wiki/subtype.md), as sugar/data.wap writes it: where(int, it => it > 0),
# the values of its parent that meet the condition, the function of `it`
WHERE_WORD = "where"
# A union, `int or text` (also `int | text`, the reader's bit_or): a value of any of its parts, flat, each part once and
# in no order, `int or ø` an int?; the or rule writes it as a choice, `{ held = int; If(held, held, text) }`
# (sugar/conditions.wap)
UNION_WORD = "or"
UNION_ALIAS = "|"
# An optional type, `int?`, as the reader reads it: the type glued to `?`; it holds a value of the type or ø
OPTIONAL_MARK = "?"
# A failable type, `int??`: a value of the type, ø or an Error, which `int or Error` writes precisely (wiki/Error.md)
FAILABLE_MARK = "??"
# the dynamic type, which holds any value, ø too: an any? is an any
ANY_TYPE = "any"
# a type still unknown, a hole of the typing (core/analyze/letters.wap), shown by its id: α3
UNKNOWN_MARK = "α"
# the type of ø alone, as a result or a name writes it
EMPTY_TYPE = "ø"
# the type of code that never finishes, as a return, a break or `raise(message: text): never`: its calls jump, of no
# type, and it fits wherever a value of any type is wanted
NEVER_TYPE = "never"
# the type of code as data, the types module's enum Node; a case of it or a declared pattern names a shape of it
NODE_TYPE = "Node"
# the fact of a shape's type, `Record`, naming the type it narrows (core/analyze/shapes.wap): its values are of that
# type, laid out as it is
NARROWS = "narrows"
LIST_TYPE = "list"
RANGE_TYPE = "Range"
# the types of the literals, as a program writes them
INT_TYPE = INT_WORD
FLOAT_TYPE = "float"
TEXT_TYPE = "text"
CHAR_TYPE = "char"
# number holds an int or a float, as any (core/stage.wap) holds every value, each boxed as a T? holds its value
# (core/emit/values.wap)
NUMBER_TYPE = "number"
BOOL_TYPE = "bool"
MAP_TYPE = "map"
# the words of the types whose values hold others, typed by their parts
COLLECTION_WORDS = [LIST_TYPE, MAP_TYPE]
# the bare type of an enum's values, which every enum fits
ENUM_TYPE = "enum"
# A function value's type, its own for each `x => …` the program writes: the word of the function it calls, `fn` and
# the function's key, applied to the types of what it captures (core/analyze/types.wap)
FUNCTION_VALUE_TYPE = "fn"
# the bare word of a function type, which every function value fits; a function value's own type is shown as it
FUNCTION_WORD = "function"
# the item type of an array of n items, `40⋅byte` a number times a type (wiki/number.md)
ARRAY_TIMES = "*"
# the universe of data types, the type of every type word without parts and of every hole a type stands for
DATA_TERM = universe(TYPE_LEVEL)
# the larger of two levels, `Type(max(u, v))`
LEVEL_MAX_WORD = "max"
# the words of the truths, bool's cases in their order, the terms the kernel forms False and True stand for
# (literals_declared)
TRUTH_WORDS = ["no", "yes"]
# a case's constructor is named by its enum's key, this mark and the case's name, `bool.yes`: two enums may each have
# a case so named
CASE_MARK = "."
case_constructed(key: text, case: text) as text := "${key}${CASE_MARK}${case}"
# the words core builds types of and the number of parts each takes, each declared at its place here, its id
class CoreWord { word: text; parts: int = 0 }
// todo turn all of these into Enum(s) AFTER The theory is done. This is a big refactoring for all files to replace all magic keywords with enums!
CORE_WORDS = [CoreWord(ANY_TYPE), CoreWord(EMPTY_TYPE), CoreWord(NEVER_TYPE), CoreWord(NODE_TYPE), CoreWord(LIST_TYPE, 1), CoreWord(RANGE_TYPE), CoreWord(INT_TYPE), CoreWord(FLOAT_TYPE), CoreWord(TEXT_TYPE), CoreWord(CHAR_TYPE), CoreWord(NUMBER_TYPE), CoreWord(BOOL_TYPE), CoreWord(MAP_TYPE, 2), CoreWord(ENUM_TYPE), CoreWord(FUNCTION_WORD), CoreWord(BLOCK_WORD), CoreWord(OPTIONAL_MARK, 1), CoreWord(UNION_WORD, 2), CoreWord(FUNCTION_ARROW), CoreWord(PARAMETERS_WORD, 2), CoreWord(NO_PARAMETERS_WORD)]
core_word(word: text) as Term := constant(core_place(word) ?? raise("${word} is no word core builds types of"), word, [])
core_place(word: text) as int? := (1 to #CORE_WORDS).find(at => CORE_WORDS#at.word == word)
ANY_TERM = core_word(ANY_TYPE)
EMPTY_TERM = core_word(EMPTY_TYPE)
NODE_TERM = core_word(NODE_TYPE)
LIST_TERM = core_word(LIST_TYPE)
RANGE_TERM = core_word(RANGE_TYPE)
INT_TERM = core_word(INT_TYPE)
FLOAT_TERM = core_word(FLOAT_TYPE)
TEXT_TERM = core_word(TEXT_TYPE)
CHAR_TERM = core_word(CHAR_TYPE)
NUMBER_TERM = core_word(NUMBER_TYPE)
BOOL_TERM = core_word(BOOL_TYPE)
ENUM_TERM = core_word(ENUM_TYPE)
MAP_TERM = core_word(MAP_TYPE)
FUNCTION_TERM = core_word(FUNCTION_WORD)
BLOCK_TERM = core_word(BLOCK_WORD)
OPTIONAL_TERM = core_word(OPTIONAL_MARK)
UNION_TERM = core_word(UNION_WORD)
ARROW_TERM = core_word(FUNCTION_ARROW)
PARAMETERS_TERM = core_word(PARAMETERS_WORD)
NO_PARAMETERS_TERM = core_word(NO_PARAMETERS_WORD)
NEVER_TERM = core_word(NEVER_TYPE)
# the types of the values a Node holds as its cases, read as a Node where one is wanted: `n: Node = 'a'` is Char('a')
ATOM_TYPES = [CHAR_TYPE, INT_TYPE, FLOAT_TYPE, NUMBER_TYPE, TEXT_TYPE]
# the type words a type test may name besides records and letters
TYPE_WORDS = ATOM_TYPES + [BOOL_TYPE, ANY_TYPE, LIST_TYPE, MAP_TYPE, ENUM_TYPE, FUNCTION_WORD]

# The table of the types a compile met: the terms by place, the places by hash, the environment declaring their words
# by key, the declaration a record's own word names (two records of one name are two words, the first word of each
# name kept and the words sharing one marked, so their texts tell them apart), the type a shape's word narrows
# (core/analyze/shapes.wap), the condition a subtype's word holds, the subtypes met so far, the key of the function a
# function value's word calls, how many typed functions the environment holds as assumptions and as definitions
# (core/analyze/terms.wap), how many have each effect (core/analyze/effects.wap), what became of each enum, by its
# word's id, and each case's constructor, by its definer's place (core/analyze/inductives.wap). It is the compile's own, as a
# symbol table is: every stage reads a type fact through it, so it is one value for the whole run, not handed down
# every call
# (refused: where a compile keeps what it typed beside the functions it refuses, each refusal's message by the
# function's key, as wap verify's laws do; ø where a refusal ends the compile; prove: what answers a `by`, the provers
# wap verify gives; ø in a build, where a proof by laws gives no term and its function is assumed)
class TypeTerms { terms: list<Term> = []; places: map<int, list<int>> = {}; environment: Environment = core_environment(); declared: map<int, Node> = {}; names: map<text, int> = {}; shared: map<int, bool> = {}; narrows: map<int, Term> = {}; functions: map<int, text> = {}; conditions: map<int, Node> = {}; subsets: list<Term> = []; assumed: int = 0; defined: int = 0; effects: map<text, int> = {}; enums: map<int, text> = {}; constructors: map<text, int> = {}; refused: map<text, text>? = ø; prove: ((ByHole) -> Term?)? = ø }
TYPES: TypeTerms = TypeTerms()
# A `by` read into a proof (core/analyze/terms.wap): the binders around it, free variables of the checker c, the
# statement it proves, the laws it names, and the program's function of a name as the kernel holds it; the
# provers TYPES.prove names answer it (extensions/verify/laws.wap)
class ByHole { c: Checker; context: list<Term>; type: Term; laws: list<Node>; function: (text) -> Term? }
core_environment() as Environment := {
	e = Environment()
	for core in CORE_WORDS { word_declared(e, core.word, core.parts) }
	literals_declared(e)
	products_declared(e)
	equality_declared(e)
	logic_declared(e)
	count_declared(e)
	int_declared(e)
	e
}
# bool, the block of its two truths, the terms the kernel forms True and False stand for (core/analyze/terms.wap),
# filling core's word: an `if` is its recursor's case split. And the types of the literals: a whole number an int, a
# text a text, a truth a bool
literals_declared(e: Environment) := {
	truths = truths_declared(e)
	e.literals = Literals(INT_TERM, TEXT_TERM, BOOL_TERM, truths#2, truths#1)
}
# bool's block, its cases no and yes, filling bool's word where it is declared; the truths' constructors
truths_declared(e: Environment) as list<Term> := {
	names = TRUTH_WORDS.map(word => case_constructed(BOOL_TYPE, word))
	inductive_declared(e, InductiveBlock([], 0, [BlockType(BOOL_TYPE, DATA_TERM, names.map(name => WrittenCase(name, pi(BOOL_TYPE, DATA_TERM, bound(0)))))]))
	names.map(name => constant(named_id(e, name)!, name, []))
}
# a type word declared, an opaque type of its parts' types in its sort; its id, its place in the environment. Its
# type is a type by construction, so it is added unchecked
word_declared(e: Environment, key: text, parts: int, sort: Term = DATA_TERM) as int := axiom_added(e, key, (1 to parts).fold(sort, (kind, at) => pi("_", DATA_TERM, kind)), yes)
# an axiom added, in core's scope for a word of core's own, seen from every scope (word_keyed)
axiom_added(e: Environment, name: text, type: Term, core: bool = no) as int := {
	added(e, Declaration(name, [], type, DeclarationKind.Axiom), core)
	size(e)
}
# a type word's term, the word declared by its key the first time
word_term(word: text) as Term := word_keyed(word, word)
word_keyed(word: text, key: text, parts: int = 0, sort: Term = DATA_TERM) as Term := constant(TYPES.environment.core.get(key) ?? word_declared(TYPES.environment, key, parts, sort), word, [])
# the sort a record's header names, `enum False: Prop {}` (wiki/proposition.md), data where it names none: a universe, or the
# types of the enum's indices and then a universe, `enum Even: nat -> Prop` (GUESS, T6a3's indices: a Pi over each index
# type, so the word is declared a family and `Even(4)` kernel-checks); ø for any other sort
record_sort(declared: Node) as Term? := sorted(enum_sort(declared) ?? return DATA_TERM)
sorted(sort: Node) as Term? := {
	level = universe_written(sort)
	if level != ø { return universe(level!) }
	match sort {
		Call(arrow, items) => if text(arrow) == FUNCTION_ARROW and #items == 2 then indexed(items_or_one(items#1), sorted(items#2)) else ø
		_ => ø
	}
}
indexed(indices: list<Node>, sort: Term?) as Term? := if sort == ø then ø else indices.reverse.fold(sort!, (body, index) => pi("_", type_term(index), body))
# a written word's term: a record's own by its declaration, a shape's with the type it narrows known
word_named(n: Node) as Term := {
	declared = fact_of(n, DECLARED_BY)
	narrows = fact_of(n, NARROWS)
	# a case's word is its own, named by its enum's declaration as a case shape's is (core/analyze/shapes.wap case_term_of)
	word = if declared != ø then declared_word(text(n), declared!) else if narrows == ø then word_term(text(n)) else word_keyed(text(n), "${text(n)} ${declaration_place(fact_of(narrows!, DECLARED_BY)!)}")
	if narrows == ø then word else narrowing(word, type_term(narrows!))
}
# a record's word: its own, named by its declaration's place, so it means that record wherever the name is declared
# again; a core word's is the core word. A bare word, written without a declaration, has none: the typing state
# finds the record it means (core/stage.wap record_named)
declared_word(name: text, declared: Node) as Term := {
	if core_place(name) != ø { return word_term(name) }
	own = word_keyed(name, "${name} ${declaration_place(declared)}", 0, record_sort(declared) ?? DATA_TERM)
	if not TYPES.declared.has(word_id(own)) { if TYPES.names.has(name) { TYPES.shared[TYPES.names[name]] = yes; TYPES.shared[word_id(own)] = yes } else { TYPES.names[name] = word_id(own) } }
	TYPES.declared[word_id(own)] = declared
	own
}
word_id(word: Term) as int := match word.shape { Constant(name, levels, id) => id; _ => 0 }
# the declaration of the record a record's own word names, ø for any other type
declared_by(type: Term?) as Node? := if is_word(type) then TYPES.declared.get(word_id(type!)) else ø
# a shape's word, known from here on to narrow this type
narrowing(word: Term, type: Term) as Term := {
	TYPES.narrows[word_id(word)] = type
	word
}
# a subtype by condition: a word narrowing its parent, named by the condition as written, the function of `it` it holds
subset_term(parent: Term, condition: Node, name: text? = ø) as Term := {
	# shown as the program wrote it, by the alias's name, `nat`, or `int where it > 0`; keyed by its code, so two spacings
	# of a condition are one type
	shown = name ?? "${type_text(parent)} ${WHERE_WORD} ${condition_shown(condition)}"
	key = "${type_text(parent)} ${WHERE_WORD} ${text(condition_of(condition))}"
	# the kernel's subtype is its parent by definition: a value of it is one of the parent's, its condition a law's
	# hypothesis (extensions/verify/laws.wap)
	if not TYPES.environment.core.has(key) { added(TYPES.environment, Declaration(key, [], DATA_TERM, Defined(parent)), yes) }
	word = word_keyed(shown, key)
	if not TYPES.conditions.has(word_id(word)) { TYPES.subsets.add(narrowing(word, parent)) }
	TYPES.conditions[word_id(word)] = condition
	narrowing(word, parent)
}
# a condition as written, or as the compiler holds one it made
condition_shown(condition: Node) as text := written_span(condition_of(condition)) ?? text(condition_of(condition))
# what a condition's function gives, as written or lowered: `it > 0` of `it => it > 0`
condition_of(condition: Node) as Node := match condition {
	Fn(parameters, body) => body
	Call(arrow, parts) => parts.last
	_ => condition
}
# the condition a subtype holds, the function of `it`; ø for any other type
subset_condition(type: Term?) as Node? := if is_word(type) then TYPES.conditions.get(word_id(type!)) else ø
# the type a shape's word narrows, `Node` of Define, ø for any other type
narrowed_type(type: Term?) as Term? := if is_word(type) then TYPES.narrows.get(word_id(type!)) else ø
# the place of a type in the table, entered the first time it is met
type_place(type: Term) as int := {
	places = TYPES.places.get(type.hash) ?? []
	found = places.find(place => same(TYPES.terms#place, type))
	if found != ø { return found! }
	TYPES.terms.add(type)
	TYPES.places[type.hash] = places + [#TYPES.terms]
	#TYPES.terms
}
# a type as a fact holds it, its place, and the type a fact holds
type_fact(type: Term) as Node := Number(type_place(type))
fact_type(fact: Node?) as Term? := match fact { Number(place) => TYPES.terms#place; _ => ø }

# a type's word and parts, the word first, as the spine of its applications gives them
spine(type: Term) as list<Term> := match type.shape {
	Apply(function, argument) => spine(function) + [argument]
	_ => [type]
}
# a word applied to its parts; an optional's built as optional_type builds it, an int?? is an int?
type_built(word: Term, parts: list<Term>) as Term := {
	spelled = word_of(word)
	if spelled == OPTIONAL_MARK and #parts == 1 { return optional_type(parts#1) }
	if spelled == FAILABLE_MARK and #parts == 1 { return union_type([parts#1, EMPTY_TERM, word_named(symbol(ERROR_CASE))]) }
	if spelled == FUNCTION_ARROW and not parts is empty { return function_type_of(parts.take(#parts - 1), parts.last) }
	applied(word, parts)
}
applied(word: Term, parts: list<Term>) as Term := parts.fold(word, (applied, part) => apply(applied, part))
# the name a type's word has, `list` of list<int>, `text` of text; ø for a type headed by no word
word_of(type: Term?) as text? := if type == ø then ø else match head_of(type!).shape {
	Constant(name, levels, id) => name
	_ => ø
}
# the word a type is applied from, found without taking its parts apart
head_of(type: Term) as Term := match type.shape { Apply(function, argument) => head_of(function); _ => type }
# whether a type is a word alone, `int`, `T`, `Triple`, with no parts
is_word(type: Term?) as bool := type != ø and match type!.shape { Constant(name, levels, id) => yes; _ => no }
# the parts a type of this word has, `int` of list<int`; ø for a type of another word
parts_of_type(word: text, type: Term?) as list<Term>? := if not is_word(type) and word_of(type) == word then parts_of(type!) else ø
parts_of(type: Term) as list<Term> := spine(type).drop(1)
# any type's word and parts, `list` and `int` of `list<int>`, a function type's under the arrow; ø for a word alone
type_parts(type: Term?) as list<Term>? := if type == ø then ø else match type!.shape {
	Apply(function, argument) => spine(type!)
	Pi(binder, domain, body) => [ARROW_TERM] + parameters_listed(domain) + [body]
	_ => ø
}
# A function's signature, its parameter types and its result type, as a function type writes them; ø for any other type
class FunctionType { parameters: list<Term>, result: Term }
function_type_of(parameters: list<Term>, result: Term) as Term := pi("_", parameters.reverse().fold(NO_PARAMETERS_TERM, (rest, parameter) => applied(PARAMETERS_TERM, [parameter, rest])), result)
function_parts(type: Term?) as FunctionType? := if type == ø then ø else match type!.shape {
	Pi(binder, domain, body) => FunctionType(parameters_listed(domain), body)
	_ => ø
}
# a Π as the kernel writes it, `(T: Type) -> T -> T`, over no parameter list of a function type
kernel_pi(type: Term) as bool := match type.shape { Pi(binder, domain, body) => not same(domain, NO_PARAMETERS_TERM) and word_of(domain) != PARAMETERS_WORD; _ => no }
parameters_listed(parameters: Term) as list<Term> := {
	parts = parts_of_type(PARAMETERS_WORD, parameters) ?? return []
	[parts#1] + parameters_listed(parts#2)
}
# what a rest or repetition took; none taken is Empty, as the host gives an empty list
items_or_one(n: Node) as list := match n { List(items, bracket, separator) => items; Empty => []; _ => [n] }
# an optional's value type, any other type itself: int of int? and of int
base_of(type: Term) as Term := base_of_optional(type) ?? type
base_or_self(type: Term?) as Term? := if type == ø then ø else base_of(type!)
optional_type(base: Term) as Term := if base_of_optional(base) != ø or same(base, ANY_TERM) then base else applied(OPTIONAL_TERM, [base])
base_of_optional(type: Term?) as Term? := only_term(parts_of_type(OPTIONAL_MARK, type))
# a union of types: its parts flat, each once, sorted by their texts, ø among them making it optional and any any; a
# part alone is itself
union_type(types: list<Term>) as Term := {
	parts = types.flat_map(union_parts).unique().sorted(by: part => type_text(part, yes))
	if parts.contains(ANY_TERM) { return ANY_TERM }
	present = parts.filter(part => part != EMPTY_TERM)
	if present is empty { return EMPTY_TERM }
	if #present < #parts { return optional_type(union_type(present)) }
	present.reverse().drop(1).fold(present.last, (rest, part) => applied(UNION_TERM, [part, rest]))
}
# the parts of a union, an optional's value type and ø, any other type itself
union_parts(type: Term) as list<Term> := {
	base = base_of_optional(type)
	if base != ø { return union_parts(base!) + [EMPTY_TERM] }
	(parts_of_type(UNION_WORD, type) ?? return [type]).flat_map(union_parts)
}
# whether a type is a union, an optional one too, `(int or text)?`
is_union(type: Term?) as bool := parts_of_type(UNION_WORD, base_or_self(type)) != ø
only_term(parts: list<Term>?) as Term? := if parts != ø and #parts == 1 then parts#1 else ø
# a function as the kernel's runtime words name it, `write(text, int, bool)`, when it is one of them
# (kernel/primitives.wap RUNTIME_WORDS), its types spelled only for a name among theirs
runtime_word(name: text, types: list<Term?>) as text? := if runtime_named(name) then RUNTIME_WORDS.find(word => word == "${name}(${types.map(type => type_text(type)).join(", ")})") else ø
runtime_named(name: text) as bool := RUNTIME_WORDS.any(word => word.starts_with(name + "("))
# a type as a message writes it, as a program writes it: `int?`, `list<(int) -> int>`; whole, a function value's own
# type spelled with its key and captures, `fn f.wap 3:5<int>`, and a record's word sharing its name with another by
# its declaration, as a key tells instances apart by them, and so does any record that shares its name with another
type_text(type: Term?, whole: bool = no) as text := {
	if type == ø { return "no type" }
	hole = variable_id(type!)
	if hole != 0 { return "${UNKNOWN_MARK}${hole}" }
	sort = universe_text(type!)
	if sort != ø { return sort! }
	if is_word(type) { return if whole or TYPES.shared.has(word_id(type!)) then declared_at(TYPES.environment, word_id(type!))!.name else if TYPES.functions.has(word_id(type!)) then FUNCTION_WORD else word_of(type)! }
	if function_value_key(type) != ø and not whole { return FUNCTION_WORD }
	base = base_of_optional(type)
	if base != ø { return if is_union(base) then failable_text(base!, whole) ?? "(${type_text(base, whole)})${OPTIONAL_MARK}" else type_text(base, whole) + OPTIONAL_MARK }
	if is_union(type) { return union_parts(type!).map(part => type_text(part, whole)).join(" ${UNION_WORD} ") }
	if kernel_pi(type!) { return shown(type!) }
	function = function_parts(type)
	if function != ø { return "(${types_text(function.parameters, whole)}) ${FUNCTION_ARROW} ${type_text(function.result, whole)}" }
	"${type_text(head_of(type!), whole)}<${types_text(parts_of(type!), whole)}>"
}
# an optional's union of an Error and one other type, shown as that type failable, `int??`; ø for any other
failable_text(base: Term, whole: bool) as text? := {
	parts = union_parts(base)
	others = parts.filter(part => type_text(part) != ERROR_CASE)
	if #parts == 2 and #others == 1 then type_text(others#1, whole) + FAILABLE_MARK else ø
}
types_text(types: list<Term>, whole: bool = no) as text := types.map(type => type_text(type, whole)).join(", ")
# a value of a type read as another where that one is wanted: a char as its text, a range as its list
READS = [[CHAR_TERM, TEXT_TERM], [RANGE_TERM, list_type(INT_TERM)]]
read_of(given: Term?) as Term? := if given == ø then ø else (READS.find(pair => same(pair#1, given!)) ?? return ø)#2
# the types whose values pass an any's test for a type: its own and those read as it, a char for a text; a number has
# no box of its own, its values are ints and floats
passing_types(type: Term) as list<Term> := if is_union(type) then union_parts(type).flat_map(passing_types) else if same(type, NUMBER_TERM) then [INT_TERM, FLOAT_TERM] else [type] + READS.filter(pair => same(pair#2, type)).map(pair => pair#1)
list_type(item: Term) as Term := applied(LIST_TERM, [item])
# the word a type is named by, `list` of list<int>, `text` of text
type_word(type: Term) as text := word_of(type) ?? type_text(type)
item_type(type: Term?) as Term? := only_term(parts_of_type(LIST_TYPE, type))
# a map's type, `map<text, int>`, and its keys' and values' types, ø for any other type
map_type(key: Term, value: Term) as Term := applied(MAP_TERM, [key, value])
key_type(type: Term?) as Term? := map_part(type, 1)
held_type(type: Term?) as Term? := map_part(type, 2)
map_part(type: Term?, at: int) as Term? := {
	parts = parts_of_type(MAP_TYPE, type) ?? return ø
	if #parts == 2 then parts#at else ø
}
function_value_type(key: text, captures: list<Term>) as Term := {
	word = word_keyed(FUNCTION_VALUE_TYPE, "${FUNCTION_VALUE_TYPE} ${key}", #captures)
	TYPES.functions[word_id(word)] = key
	applied(word, captures)
}
# a function value's captures' types, and the key of the function it calls; ø for a type of no function value
function_value_parts(type: Term?) as list<Term>? := if function_value_key(type) == ø then ø else parts_of(type!)
function_value_key(type: Term?) as text? := if type == ø then ø else TYPES.functions.get(word_id(head_of(type!)))

# a type as the program wrote it, read into its term; ø where none is written
# (a statement in a result's or a parameter's place is a bool where a signature is read, its truth where typing reads
# the function: core/analyze/calls.wap statement_held)
written_type(written: Node?) as Term? := if written == ø then ø else if is_statement_written(written) then BOOL_TERM else type_term(written!)
# a type the compiler writes into code it makes, as its notation carrying its term
written_of(type: Term) as Node := with_fact(symbol(type_text(type)), TYPE, type_fact(type))
# a type refused as code is, where it has no place of its own
refused_type(type: Term, why: text) as never := raise("${why}: ${type_text(type)}")
# The door: a type as a program writes it read into its term. `list<int>`, `int?`, `(int) -> text`, `40⋅byte` (a
# list of bytes), a function value's `fn<"key", int>`; a name alone is its word
type_term(n: Node) as Term := {
	known = fact_type(fact_of(n, TYPE))
	if known != ø { return known! }
	sort = universe_written(n)
	if sort != ø { return universe(sort!) }
	subset = subset_written(n)
	if subset != ø { return subset_term(type_term(subset#1), subset#2, text_of(fact_of(n, WRITTEN))) }
	union = union_written(n)
	if union != ø { return union_type(union.map(part => type_term(part))) }
	binder = universe_binder(n)
	if binder != ø { return binder! }
	parts = written_parts(n)
	if parts != ø { return type_built(word_term(text(parts#1)), parts.drop(1).map(part => type_term(part))) }
	match n {
		Call(times, items) => if text(times) == ARRAY_TIMES and #items == 2 and items#1 is number then list_type(type_term(items#2)) else if is_family_call(n) then family_typed(times, items) else raise("${n} is no type")
		Empty => EMPTY_TERM
		_ => word_named(n)
	}
}
# GUESS (T6a3's value reader): a declared type applied to values, `Even(double(n))`. While typing, an argument that is no type stands as its
# code, as a subtype's condition does (the type is keyed by it); terms.wap family_read reads the values under the function's parameters
is_family_call(n: Node) as bool := match n { Call(head, items) => is_type_former(family_type(head)) and items.any(item => is_value_written(item)); _ => no }
# the type of a call's head, its word's: the program's type word as declared with its header (word_named declares it
# the first time, the same word each time), else the kernel's declaration of the name (`Equal`), which is looked up,
# never declared; ø for a name neither holds yet
family_type(head: Node) as Term? := {
	if fact_of(head, DECLARED_BY) != ø { return (declared_at(TYPES.environment, word_id(word_named(head))) ?? return ø).type }
	(declaration(TYPES.environment, text(head)) ?? return ø).type
}
# the head of a type applied to values as typing holds it: the program's word, or the kernel's family at its own
# level parameters, never a word declared again. Those levels are typing's only, for the type as a value: the kernel's
# reading heads it again at the levels its arguments give (core/analyze/terms.wap kernel_headed)
family_word(head: Node) as Term := {
	family = if fact_of(head, DECLARED_BY) != ø then ø else declaration(TYPES.environment, text(head))
	if family == ø then word_named(head) else constant(named_id(TYPES.environment, family!.name)!, family!.name, family!.levels.map(name => Parameter(name)))
}
# a function type's parameter types and its result
arrow_parts(type: Term) as list<Term> := match type.shape {
	Pi(binder, domain, body) => [domain] + arrow_parts(body)
	_ => [type]
}
# whether a type is a type former's: a function of one argument or more ending in a sort
is_type_former(type: Term?) as bool := match (type ?? return no).shape { Pi(binder, domain, body) => match body.shape { Sort(level) => yes; _ => is_type_former(body) }; _ => no }
# a type place written as a statement, `a + 0 == a`: a call of a function the program names that type_term reads as no
# type, which states the truth it holds (core/analyze/calls.wap statement_held); a call of a name nothing defines,
# `Lsit(int)`, is an unknown type
is_statement_written(n: Node?) as bool := match n ?? Empty { Call(head, items) => fact_of(head, DEFINED_AT) != ø and text(head) != ARRAY_TIMES and not is_type_written(n!) and not is_family_call(n!); _ => no }
# a value: an expression, or a name bound as a parameter or a value; any other name is no value, so a misspelt type is unknown as everywhere
is_value_written(item: Node) as bool := not (is_type_written(item) or fact_of(item, DECLARED_BY) != ø or core_place(text(item)) != ø) and (not item is symbol or fact_of(item, DEFINED_AT) != ø)
family_typed(head: Node, items: list<Node>) as Term := {
	parts = items.map(item => if is_value_written(item) then word_term("${item}") else type_term(item))
	type_built(family_word(head), parts)
}
# the level a universe is written at, `Prop`, `Type`, `Type(n)`, `Sort(n)`; ø for other code
universe_written(n: Node) as Level? := {
	call = call_written(n)
	if call != ø { return if #call == 2 and [TYPE_UNIVERSE_WORD, SORT_WORD].contains(text(call#1)) then level_written(call#2, if text(call#1) == TYPE_UNIVERSE_WORD then 1 else 0) else ø }
	if not n is symbol then ø else if text(n) == PROP_WORD then Zero else if text(n) == TYPE_UNIVERSE_WORD then TYPE_LEVEL else ø
}
# a level as written, `steps` above it: a number, `max(u, v)`, or a one-letter name, a level parameter found where it is
# used (wiki/universe.md); ø for other code
level_written(n: Node, steps: int) as Level? := {
	call = call_written(n)
	if call != ø { return if text(call#1) == LEVEL_MAX_WORD and #call == 3 then Max(level_written(call#2, steps) ?? return ø, level_written(call#3, steps) ?? return ø) else ø }
	match n {
		Number(value) => if value is int and value >= 0 then level_above(Zero, value + steps) else ø
		_ => if n is symbol and #text(n) == 1 then level_above(Parameter(text(n)), steps) else ø
	}
}
# a universe in the words that write it (kernel/show.wap sort_shown)
universe_text(type: Term) as text? := match type.shape { Sort(level) => sort_shown(level); _ => ø }
universe_level(type: Term?) as Level? := if type == ø then ø else match type!.shape { Sort(level) => level; _ => ø }
# the universe a type lies in: the kernel's type of a universe, else Type, the universe of every data type (a letter, a
# record, a union, a type former the kernel holds no judgement of)
universe_of(type: Term) as Term := match type.shape { Sort(level) => judged_universe(type); Pi(binder, domain, body) => judged_universe(type); Apply(function, argument) => applied_universe(type); _ => DATA_TERM }
# an applied type's universe, `Equal(int, a, b)` Prop: the sort its head's type ends in, past a binder for each argument
applied_universe(type: Term) as Term := match head(type).shape {
	Constant(name, levels, id) => {
		given = arguments(type)
		ended = instantiated_all(peeled(type_of(checker(TYPES.environment, term_levels(head(type))), head(type)), #given), given)
		if universe_level(ended) == ø then DATA_TERM else universe_plain(universe_level(ended)!)
	}
	_ => DATA_TERM
}
judged_universe(type: Term) as Term := universe_plain(universe_level(type_of(checker(TYPES.environment, term_levels(type)), type))!)
# a universe at its level written plainest, Type(1) of Sort(max(2, 1)): one level, one term
universe_plain(level: Level) as Term := universe(level_above(Zero, level_number(level) ?? return universe(simplified(level))))
# the level parameters and holes a term names, each once
term_levels(t: Term) as list<text> := {
	if not t.holds_parameter { return [] }
	match t.shape {
		Sort(level) => level_parameters(level)
		Constant(name, levels, _) => levels.flat_map(level_parameters).unique()
		_ => parts(t).flat_map(term_levels).unique()
	}
}
# a function type over a universe, `(A: Type) -> A`: the kernel's Π over it, the result reading the parameter as the
# binder's variable; ø for other code
universe_binder(n: Node) as Term? := {
	parts = written_parts_of(FUNCTION_ARROW, n) ?? return ø
	if #parts != 2 { return ø }
	match parts#1 {
		Key(name, Op.Colon, type) => {
			domain = universe(universe_written(type) ?? return ø)
			variable = hypothesis(checker(TYPES.environment, []), text(name), domain)
			pi(text(name), domain, abstracted(type_term(substituted(parts#2, text(name), with_fact(name, TYPE, type_fact(variable)))), variable_id(variable)))
		}
		_ => ø
	}
}
# whether code is a type as written with parts or a condition, or a universe, `list<int>`, `int?`, `int where it > 0`, `Type(1)`
is_type_written(n: Node) as bool := written_parts(n) != ø or subset_written(n) != ø or union_written(n) != ø or universe_written(n) != ø
# a union as written, read as `or` reads (both_parts), or `int | text`: its two parts; ø for other code
union_written(n: Node) as list<Node>? := {
	or_parts = both_parts(n)
	if or_parts != ø { return if or_parts!.arm == 2 then [or_parts!.first, or_parts!.second] else ø }
	match n { Call(called, items) => if text(called) == UNION_ALIAS and #items == 2 then items else ø; _ => ø }
}
# the two parts of `a and b`, If(a, b, no), with the arm where both hold, 1; of `a or b`, { held = a; If(held, held, b) },
# with the arm where neither holds, 2, so `if x == ø or x.n == 0 { return }` leaves x present after it; ø for any other
# form
class BothParts { first: Node; second: Node; arm: int }
both_parts(n: Node) as BothParts? := match n {
	If(first, second, otherwise) => if otherwise is False then BothParts(first, second, 1) else ø
	_ => {
		statements = statements_written(n) ?? return ø
		if #statements == 2 then either_parts(statements#1, statements#2) else ø
	}
}
# a block's statements, written (`{ a; b }`) or lowered
statements_written(n: Node) as list<Node>? := match n {
	Block(items) => items
	List(items, Bracket.Curly, separator) => items
	_ => ø
}
either_parts(held: Node, chosen: Node) as BothParts? := {
	assignment = assignment_parts(held) ?? return ø
	place = assignment#1
	match chosen { If(tested, kept, otherwise) => if same_name(tested, place) and same_name(kept, place) then BothParts(assignment#2, otherwise, 2) else ø; _ => ø }
}
# a variable's place and the value given it, written (`x = 1`) or lowered
assignment_parts(n: Node) as list<Node>? := match n {
	Set(place, value) => [place, value]
	Call(called, arguments) => if is_default_given(n) then arguments else ø
	_ => ø
}
# a subtype as written, `where(T, it => p)`, as notation or lowered: its parent and its condition's function; ø for
# other code
subset_written(n: Node) as list<Node>? := {
	call = call_written(n) ?? return ø
	if text(call#1) == WHERE_WORD and #call == 3 then call.drop(1) else ø
}
# a call as written or as the lowering made it, `Sort(1)`: what it calls, then its arguments; ø for other code
call_written(n: Node) as list<Node>? := match n {
	Key(called, Op.None, List(items, Bracket.Round, separator)) => [called] + items
	Call(called, items) => [called] + items
	_ => ø
}
# A written type with parts read as its word and then the parts, as type_parts reads a term: `list<int>` as list and
# int, `int?` as ? and int, `(int, text) -> bool` as ->, int, text and bool, in round brackets or not; ø for a word
# alone and any other code
written_parts(n: Node) as list<Node>? := match n {
	Key(name, Op.None, List(items, Bracket.Less, separator)) => [name] + items
	List(items, Bracket.None, separator) => if #items == 2 and [OPTIONAL_MARK, FAILABLE_MARK].contains(text(items#2)) then [items#2, items#1] else ø
	Call(called, items) => if text(called) == FUNCTION_ARROW and #items == 2 then [called] + items_or_one(items#1) + [items#2] else ø
	List(items, Bracket.Round, separator) => if #items == 1 then written_parts(items#1) else ø
	_ => ø
}
# two types are one where their terms are the same
==(a: Term, b: Term) as bool := same(a, b)
