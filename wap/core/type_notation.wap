# Types as the program writes them, the notation every stage reads and builds (core/stage.wap holds the facts that
# carry them): a word with parts in angle brackets `list<int>`, an optional `int?`, a function type `(int) -> text`,
# a function value's own `fn<…>`; each built from its parts and taken back apart, ø for a type of another kind.
# Input and output: type Nodes.

use "stage.wap"
use "../kernel/forms.wap"
# A type with parts, as the reader reads `list<int>` or `map<text, int>`: its word glued to the parts' types in angle
# brackets; parts_of_type gives the parts back, ø for a type of another word
generic_type(word: text, parts: list) as Node := Key(symbol(word), Op.None, List(parts, Bracket.Less, if #parts > 1 then Separator.Comma else Separator.None))
# TODO  if #parts > 1 then Separator.Comma else Separator.None  This can be cleaned up globally by the convention that a list with one item does not print its last comma 
parts_of_type(word: text, type: Node?) as list? := match type {
	Key(name, Op.None, List(items, Bracket.Less, separator)) => if name == symbol(word) then items else ø
	_ => ø
}
# any type's word and parts, `list` and `int` of `list<int>`; ø for a type without parts
type_parts(type: Node?) as list? := {
	base = base_of_optional(type)
	if base != ø { return [symbol(OPTIONAL_MARK), base] }
	function = function_parts(type)
	if function != ø { return [symbol(FUNCTION_ARROW)] + function.parameters + [function.result] }
	match type {
		Key(name, Op.None, List(items, Bracket.Less, separator)) => [name] + items
		_ => ø
	}
}
# a type built back from its word and parts, as type_parts gives them
type_built(word: text, parts: list) as Node := if word == OPTIONAL_MARK then optional_type(parts#1) else if word == FUNCTION_ARROW then function_type_of(parts.take(#parts - 1), parts.last) else generic_type(word, parts)
# a written `block`: code run by its call, a function of no parameters (wiki/block.md)
BLOCK_WORD = "block"
# A function type, `(int, text) -> bool`: the parameters' types in round brackets, an arrow, the result's type; its
# list as the reader reads it, separated by commas only when it holds several
FUNCTION_ARROW = "->"
function_type_of(parameters: list<Node>, result: Node) as Node := Call(symbol(FUNCTION_ARROW), [List(parameters, Bracket.Round, if #parameters > 1 then Separator.Comma else Separator.None), result])
# A function's signature, its parameter types and its result type, as a function type writes them, in round brackets or
# not; ø for any other type
class FunctionType { parameters: list<Node>, result: Node }
function_parts(type: Node?) as FunctionType? := match type {
	Call(called, items) => if text(called) == FUNCTION_ARROW and #items == 2 then FunctionType(items_or_one(items#1), items#2) else ø
	List(items, Bracket.Round, separator) => if #items == 1 then function_parts(items#1) else ø
	_ => ø
}
# what a rest or repetition took; none taken is Empty, as the host gives an empty list
items_or_one(n: Node) as list := match n { List(items, bracket, separator) => items; Empty => []; _ => [n] }
# An optional type, `int?`, as the reader reads it: the type glued to `?`; it holds a value of the type or ø
OPTIONAL_MARK = "?"
# the dynamic type, which holds any value, ø too: an any? is an any
ANY_TYPE = "any"
ANY_SYMBOL = symbol(ANY_TYPE)
# the type of ø alone, as a result or a name writes it
EMPTY_TYPE = "ø"
EMPTY_SYMBOL = symbol(EMPTY_TYPE)
# the type of code that never finishes, as a return, a break or `raise(message: text): never`: its calls jump, of no
# type, and it fits wherever a value of any type is wanted
NEVER_TYPE = "never"
# the type of code as data, the types module's enum Node; a case of it or a declared pattern names a shape of it
NODE_TYPE = "Node"
NODE_SYMBOL = symbol(NODE_TYPE)
# the fact of a shape's type, `Record`, naming the type it narrows (core/analyze/shapes.wap): its values are of that
# type, laid out as it is
NARROWS = "narrows"
# an optional's value type, any other type itself: int of int? and of int; ø of none
base_of(type: Node) as Node := base_of_optional(type) ?? type
base_or_self(type: Node?) as Node? := if type == ø then ø else base_of(type)
optional_type(base: Node) as Node := if base_of_optional(base) != ø or base == ANY_SYMBOL then base else List([base, symbol(OPTIONAL_MARK)], Bracket.None, Separator.None)
base_of_optional(type: Node?) as Node? := match type {
	List(items, Bracket.None, separator) => if #items == 2 and text(items#2) == OPTIONAL_MARK then items#1 else ø
	_ => ø
}
# a type as a message writes it, as a program writes it: `int?`, `list<(int) -> int>`
# a function as the kernel's runtime words name it (kernel/primitives.wap RUNTIME_WORDS): `write(text, int, bool)`
runtime_word(name: text, types: list<Node?>) as text := "${name}(${types.map(type_text).join(", ")})"
type_text(type: Node?) as text := {
	if type == ø { return "no type" }
	base = base_of_optional(type)
	if base != ø { return type_text(base) + OPTIONAL_MARK }
	function = function_parts(type)
	if function != ø { return "(${types_text(function.parameters)}) ${FUNCTION_ARROW} ${type_text(function.result)}" }
	if function_value_parts(type) != ø { return FUNCTION_WORD }
	match type {
		Key(name, Op.None, List(items, Bracket.Less, separator)) => "${name}<${types_text(items)}>"
		_ => "${type}"
	}
}
types_text(types: list) as text := types.map(type_text).join(", ")
# a list's TYPE, `list<int>`, and its item type, ø for any other type
LIST_TYPE = "list"
LIST_SYMBOL = symbol(LIST_TYPE)
RANGE_TYPE = "Range"
RANGE_SYMBOL = symbol(RANGE_TYPE)
# the types of the literals, as a program writes them
INT_TYPE = "int"
INT_SYMBOL = symbol(INT_TYPE)
FLOAT_TYPE = "float"
FLOAT_SYMBOL = symbol(FLOAT_TYPE)
TEXT_TYPE = "text"
TEXT_SYMBOL = symbol(TEXT_TYPE)
CHAR_TYPE = "char"
CHAR_SYMBOL = symbol(CHAR_TYPE)
# number holds an int or a float, as any (core/stage.wap) holds every value, each boxed as a T? holds its value
# (core/emit/values.wap)
NUMBER_TYPE = "number"
NUMBER_SYMBOL = symbol(NUMBER_TYPE)
BOOL_TYPE = "bool"
BOOL_SYMBOL = symbol(BOOL_TYPE)
# the types of the values a Node holds as its cases, read as a Node where one is wanted: `n: Node = 'a'` is Char('a')
ATOM_TYPES = [CHAR_TYPE, INT_TYPE, FLOAT_TYPE, NUMBER_TYPE, TEXT_TYPE]
# a value of a type read as another where that one is wanted: a char as its text, a range as its list
READS = [[CHAR_SYMBOL, TEXT_SYMBOL], [RANGE_SYMBOL, list_type(INT_SYMBOL)]]
read_of(given: Node?) as Node? := (READS.find(pair => pair#1 == given) ?? return ø)#2
# the types whose values pass an any's test for a type: its own and those read as it, a char for a text; a number has
# no box of its own, its values are ints and floats
passing_types(type: Node) as list<Node> := if type == NUMBER_SYMBOL then [INT_SYMBOL, FLOAT_SYMBOL] else [type] + READS.filter(pair => type_text(pair#2) == type_text(type)).map(pair => pair#1)
list_type(item: Node) as Node := generic_type(LIST_TYPE, [item])
# the word a type is named by, `list` of list<int>, `text` of text
type_word(type: Node) as text := text((type_parts(type) ?? [type])#1)
item_type(type: Node?) as Node? := only(parts_of_type(LIST_TYPE, type))
# a map's TYPE, `map<text, int>`, and its keys' and values' types, ø for any other type
MAP_TYPE = "map"
map_type(key: Node, value: Node) as Node := generic_type(MAP_TYPE, [key, value])
key_type(type: Node?) as Node? := map_part(type, 1)
held_type(type: Node?) as Node? := map_part(type, 2)
map_part(type: Node?, at: int) as Node? := {
	parts = parts_of_type(MAP_TYPE, type)
	if parts == ø then ø else parts#at
}
# the bare type of an enum's values, which every enum fits
ENUM_TYPE = "enum"
ENUM_SYMBOL = symbol(ENUM_TYPE)
# the type words a type test may name besides records and letters
TYPE_WORDS = ATOM_TYPES + [BOOL_TYPE, ANY_TYPE, LIST_TYPE, MAP_TYPE, ENUM_TYPE]
# A function value's TYPE, its own for each `x => …` the program writes: the word fn glued to the key of the function
# it calls and the types of what it captures, `fn<"f.wap:3:5 λ", int>` (core/analyze/types.wap); its parts, the key and
# then the captures' types
FUNCTION_VALUE_TYPE = "fn"
# the bare word of a function type, which every function value fits; a function value's own type is shown as it
FUNCTION_WORD = "function"
function_value_type(key: text, captures: list) as Node := generic_type(FUNCTION_VALUE_TYPE, [Text(key)] + captures)
function_value_parts(type: Node?) as list? := parts_of_type(FUNCTION_VALUE_TYPE, type)
