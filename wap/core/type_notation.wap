# Types as kernel terms (notes/coc-t3.md "Where a type lives"), and the notation programs write them in. A type is its
# word applied to its parts: `list<int>` the constant list applied to int, `int?` the constant ? applied to int, a
# function value's own type its function's own word applied to its captures' types. A function type is a Pi:
# `(int, text) -> bool` takes the list of its parameters' types, `and int (and text none)`, to bool, so it is never
# the curried `(int) -> (text) -> bool`. Every word is an opaque constant the compile's kernel environment declares
# as it first meets it, a type of its parts' types (list : Type -> Type); the words core builds types of come first,
# each at its place among CORE_WORDS, so their constants are fixed.
#
# A compile keeps one table of the types it met, each entered once, so a fact names its type by its place there and
# two facts of one type are equal. A type a program writes is notation, code like any other: type_term reads it into
# its term, type_text writes a term back as a program writes it, for messages and `format` only.

use "stage.wap"
use "../kernel/forms.wap"
use "../kernel/primitives.wap"
use "../kernel/terms.wap"
use "../kernel/environment.wap"

# a written `block`: code run by its call, a function of no parameters (wiki/block.md)
BLOCK_WORD = "block"
# A function type, `(int, text) -> bool`: the parameters' types in round brackets, an arrow, the result's type; its
# parameters' types are a list of two words, the one of a type before others and the one of none. The arrow heads a
# function type's parts as type_parts lists them, its parameters' types and its result's, never a term
FUNCTION_ARROW = "->"
PARAMETERS_WORD = "and"
NO_PARAMETERS_WORD = "none"
# An optional type, `int?`, as the reader reads it: the type glued to `?`; it holds a value of the type or ø
OPTIONAL_MARK = "?"
# the dynamic type, which holds any value, ø too: an any? is an any
ANY_TYPE = "any"
# a type still unknown, a hole of the typing (core/analyze/letters.wap), shown by its id: α3
UNKNOWN_MARK = "α"
# the type of ø alone, as a result or a name writes it
EMPTY_TYPE = "ø"
# the type of code that never finishes, as a return, a break or `raise(message: text): never`: its calls jump, of no
# type, and it fits wherever a value of any type is wanted
NEVER_TYPE = "never"
# the type of code as data, the types module's enum Node; a case of it or a declared pattern names a shape of it
NODE_TYPE = "Node"
# the fact of a shape's type, `Record`, naming the type it narrows (core/analyze/shapes.wap): its values are of that
# type, laid out as it is
NARROWS = "narrows"
LIST_TYPE = "list"
RANGE_TYPE = "Range"
# the types of the literals, as a program writes them
INT_TYPE = "int"
FLOAT_TYPE = "float"
TEXT_TYPE = "text"
CHAR_TYPE = "char"
# number holds an int or a float, as any (core/stage.wap) holds every value, each boxed as a T? holds its value
# (core/emit/values.wap)
NUMBER_TYPE = "number"
BOOL_TYPE = "bool"
MAP_TYPE = "map"
# the bare type of an enum's values, which every enum fits
ENUM_TYPE = "enum"
# A function value's type, its own for each `x => …` the program writes: the word of the function it calls, `fn` and
# the function's key, applied to the types of what it captures (core/analyze/types.wap)
FUNCTION_VALUE_TYPE = "fn"
# the bare word of a function type, which every function value fits; a function value's own type is shown as it
FUNCTION_WORD = "function"
# the item type of an array of n items, `40⋅byte` a number times a type (wiki/number.md)
ARRAY_TIMES = "*"
# the universe of data types, the type of every type word without parts and of every hole a type stands for
DATA_TERM = type_at(Zero)
# the words core builds types of and the number of parts each takes, each declared at its place here, its id
class CoreWord { word: text; parts: int = 0 }
// todo turn all of these into Enum(s) AFTER The theory is done. This is a big refactoring for all files to replace all magic keywords with enums!
CORE_WORDS = [CoreWord(ANY_TYPE), CoreWord(EMPTY_TYPE), CoreWord(NEVER_TYPE), CoreWord(NODE_TYPE), CoreWord(LIST_TYPE, 1), CoreWord(RANGE_TYPE), CoreWord(INT_TYPE), CoreWord(FLOAT_TYPE), CoreWord(TEXT_TYPE), CoreWord(CHAR_TYPE), CoreWord(NUMBER_TYPE), CoreWord(BOOL_TYPE), CoreWord(MAP_TYPE, 2), CoreWord(ENUM_TYPE), CoreWord(FUNCTION_WORD), CoreWord(BLOCK_WORD), CoreWord(OPTIONAL_MARK, 1), CoreWord(FUNCTION_ARROW), CoreWord(PARAMETERS_WORD, 2), CoreWord(NO_PARAMETERS_WORD)]
core_word(word: text) as Term := constant(core_place(word) ?? raise("${word} is no word core builds types of"), word, [])
core_place(word: text) as int? := (1 to #CORE_WORDS).find(at => CORE_WORDS#at.word == word)
ANY_TERM = core_word(ANY_TYPE)
EMPTY_TERM = core_word(EMPTY_TYPE)
NODE_TERM = core_word(NODE_TYPE)
LIST_TERM = core_word(LIST_TYPE)
RANGE_TERM = core_word(RANGE_TYPE)
INT_TERM = core_word(INT_TYPE)
FLOAT_TERM = core_word(FLOAT_TYPE)
TEXT_TERM = core_word(TEXT_TYPE)
CHAR_TERM = core_word(CHAR_TYPE)
NUMBER_TERM = core_word(NUMBER_TYPE)
BOOL_TERM = core_word(BOOL_TYPE)
ENUM_TERM = core_word(ENUM_TYPE)
MAP_TERM = core_word(MAP_TYPE)
FUNCTION_TERM = core_word(FUNCTION_WORD)
BLOCK_TERM = core_word(BLOCK_WORD)
OPTIONAL_TERM = core_word(OPTIONAL_MARK)
ARROW_TERM = core_word(FUNCTION_ARROW)
PARAMETERS_TERM = core_word(PARAMETERS_WORD)
NO_PARAMETERS_TERM = core_word(NO_PARAMETERS_WORD)
NEVER_TERM = core_word(NEVER_TYPE)
# the types of the values a Node holds as its cases, read as a Node where one is wanted: `n: Node = 'a'` is Char('a')
ATOM_TYPES = [CHAR_TYPE, INT_TYPE, FLOAT_TYPE, NUMBER_TYPE, TEXT_TYPE]
# the type words a type test may name besides records and letters
TYPE_WORDS = ATOM_TYPES + [BOOL_TYPE, ANY_TYPE, LIST_TYPE, MAP_TYPE, ENUM_TYPE, FUNCTION_WORD]

# The table of the types a compile met: the terms by place, the places by hash, the environment declaring their words
# by key, the declaration a record's own word names (two records of one name are two words, the first word of each
# name kept and the words sharing one marked, so their texts tell them apart), the type a shape's word narrows
# (core/analyze/shapes.wap), the key of the function a function value's word calls and how many typed functions the
# environment holds as assumptions (core/analyze/calls.wap function_assumed). It is the compile's own, as a
# symbol table is: every stage reads a type fact through it, so it is one value for the whole run, not handed down
# every call
class TypeTerms { terms: list<Term> = []; places: map<int, list<int>> = {}; environment: Environment = core_environment(); declared: map<int, Node> = {}; names: map<text, int> = {}; shared: map<int, bool> = {}; narrows: map<int, Term> = {}; functions: map<int, text> = {}; assumed: int = 0 }
TYPES: TypeTerms = TypeTerms()
core_environment() as Environment := {
	e = Environment()
	for core in CORE_WORDS { word_declared(e, core.word, core.parts) }
	e
}
# a type word declared, an opaque type of its parts' types; its id, its place in the environment. Its type is a
# type by construction, so it is added unchecked
word_declared(e: Environment, key: text, parts: int) as int := axiom_added(e, key, (1 to parts).fold(DATA_TERM, (kind, at) => pi("_", DATA_TERM, kind)))
axiom_added(e: Environment, name: text, type: Term) as int := {
	added(e, Declaration(name, [], type, DeclarationKind.Axiom))
	size(e)
}
# a type word's term, the word declared by its key the first time
word_term(word: text) as Term := word_keyed(word, word)
word_keyed(word: text, key: text, parts: int = 0) as Term := constant(named_id(TYPES.environment, key) ?? word_declared(TYPES.environment, key, parts), word, [])
# a written word's term: a record's own by its declaration, a shape's with the type it narrows known
word_named(n: Node) as Term := {
	declared = fact_of(n, DECLARED_BY)
	narrows = fact_of(n, NARROWS)
	# a case's word is its own, named by its enum's declaration as a case shape's is (core/analyze/shapes.wap case_shape)
	word = if declared != ø then declared_word(text(n), declared!) else if narrows == ø then word_term(text(n)) else word_keyed(text(n), "${text(n)} ${declaration_place(fact_of(narrows!, DECLARED_BY)!)}")
	if narrows == ø then word else narrowing(word, type_term(narrows!))
}
# a record's word: its own, named by its declaration's place, so it means that record wherever the name is declared
# again; a core word's is the core word. A bare word, written without a declaration, has none: the typing state
# finds the record it means (core/stage.wap record_named)
declared_word(name: text, declared: Node) as Term := {
	if core_place(name) != ø { return word_term(name) }
	own = word_keyed(name, "${name} ${declaration_place(declared)}")
	if not TYPES.declared.has(word_id(own)) { if TYPES.names.has(name) { TYPES.shared[TYPES.names[name]] = yes; TYPES.shared[word_id(own)] = yes } else { TYPES.names[name] = word_id(own) } }
	TYPES.declared[word_id(own)] = declared
	own
}
word_id(word: Term) as int := match word.shape { Constant(name, levels, id) => id; _ => 0 }
# the declaration of the record a record's own word names, ø for any other type
declared_by(type: Term?) as Node? := if is_word(type) then TYPES.declared.get(word_id(type!)) else ø
# a shape's word, known from here on to narrow this type
narrowing(word: Term, type: Term) as Term := {
	TYPES.narrows[word_id(word)] = type
	word
}
# the type a shape's word narrows, `Node` of Define, ø for any other type
narrowed_type(type: Term?) as Term? := if is_word(type) then TYPES.narrows.get(word_id(type!)) else ø
# the place of a type in the table, entered the first time it is met
type_place(type: Term) as int := {
	places = TYPES.places.get(type.hash) ?? []
	found = places.find(place => same(TYPES.terms#place, type))
	if found != ø { return found! }
	TYPES.terms.add(type)
	TYPES.places[type.hash] = places + [#TYPES.terms]
	#TYPES.terms
}
# a type as a fact holds it, its place, and the type a fact holds
type_fact(type: Term) as Node := Number(type_place(type))
fact_type(fact: Node?) as Term? := match fact { Number(place) => TYPES.terms#place; _ => ø }

# a type's word and parts, the word first, as the spine of its applications gives them
spine(type: Term) as list<Term> := match type.shape {
	Apply(function, argument) => spine(function) + [argument]
	_ => [type]
}
# a word applied to its parts; an optional's built as optional_type builds it, an int?? is an int?
type_built(word: Term, parts: list<Term>) as Term := {
	spelled = word_of(word)
	if spelled == OPTIONAL_MARK and #parts == 1 { return optional_type(parts#1) }
	if spelled == FUNCTION_ARROW and not parts is empty { return function_type_of(parts.take(#parts - 1), parts.last) }
	applied(word, parts)
}
applied(word: Term, parts: list<Term>) as Term := parts.fold(word, (applied, part) => apply(applied, part))
# the name a type's word has, `list` of list<int>, `text` of text; ø for a type headed by no word
word_of(type: Term?) as text? := if type == ø then ø else match head_of(type!).shape {
	Constant(name, levels, id) => name
	_ => ø
}
# the word a type is applied from, found without taking its parts apart
head_of(type: Term) as Term := match type.shape { Apply(function, argument) => head_of(function); _ => type }
# whether a type is a word alone, `int`, `T`, `Triple`, with no parts
is_word(type: Term?) as bool := type != ø and match type!.shape { Constant(name, levels, id) => yes; _ => no }
# the parts a type of this word has, `int` of list<int`; ø for a type of another word
parts_of_type(word: text, type: Term?) as list<Term>? := if not is_word(type) and word_of(type) == word then parts_of(type!) else ø
parts_of(type: Term) as list<Term> := spine(type).drop(1)
# any type's word and parts, `list` and `int` of `list<int>`, a function type's under the arrow; ø for a word alone
type_parts(type: Term?) as list<Term>? := if type == ø then ø else match type!.shape {
	Apply(function, argument) => spine(type!)
	Pi(binder, domain, body) => [ARROW_TERM] + parameters_listed(domain) + [body]
	_ => ø
}
# A function's signature, its parameter types and its result type, as a function type writes them; ø for any other type
class FunctionType { parameters: list<Term>, result: Term }
function_type_of(parameters: list<Term>, result: Term) as Term := pi("_", parameters.reverse().fold(NO_PARAMETERS_TERM, (rest, parameter) => applied(PARAMETERS_TERM, [parameter, rest])), result)
function_parts(type: Term?) as FunctionType? := if type == ø then ø else match type!.shape {
	Pi(binder, domain, body) => FunctionType(parameters_listed(domain), body)
	_ => ø
}
parameters_listed(parameters: Term) as list<Term> := {
	parts = parts_of_type(PARAMETERS_WORD, parameters) ?? return []
	[parts#1] + parameters_listed(parts#2)
}
# what a rest or repetition took; none taken is Empty, as the host gives an empty list
items_or_one(n: Node) as list := match n { List(items, bracket, separator) => items; Empty => []; _ => [n] }
# an optional's value type, any other type itself: int of int? and of int
base_of(type: Term) as Term := base_of_optional(type) ?? type
base_or_self(type: Term?) as Term? := if type == ø then ø else base_of(type!)
optional_type(base: Term) as Term := if base_of_optional(base) != ø or same(base, ANY_TERM) then base else applied(OPTIONAL_TERM, [base])
base_of_optional(type: Term?) as Term? := only_term(parts_of_type(OPTIONAL_MARK, type))
only_term(parts: list<Term>?) as Term? := if parts != ø and #parts == 1 then parts#1 else ø
# a function as the kernel's runtime words name it, `write(text, int, bool)`, when it is one of them
# (kernel/primitives.wap RUNTIME_WORDS), its types spelled only for a name among theirs
runtime_word(name: text, types: list<Term?>) as text? := if runtime_named(name) then RUNTIME_WORDS.find(word => word == "${name}(${types.map(type => type_text(type)).join(", ")})") else ø
runtime_named(name: text) as bool := RUNTIME_WORDS.any(word => word.starts_with(name + "("))
# a type as a message writes it, as a program writes it: `int?`, `list<(int) -> int>`; whole, a function value's own
# type spelled with its key and captures, `fn f.wap 3:5<int>`, and a record's word sharing its name with another by
# its declaration, as a key tells instances apart by them, and so does any record that shares its name with another
type_text(type: Term?, whole: bool = no) as text := {
	if type == ø { return "no type" }
	hole = variable_id(type!)
	if hole != 0 { return "${UNKNOWN_MARK}${hole}" }
	if is_word(type) { return if whole or TYPES.shared.has(word_id(type!)) then declared_at(TYPES.environment, word_id(type!))!.name else if TYPES.functions.has(word_id(type!)) then FUNCTION_WORD else word_of(type)! }
	if function_value_key(type) != ø and not whole { return FUNCTION_WORD }
	base = base_of_optional(type)
	if base != ø { return type_text(base, whole) + OPTIONAL_MARK }
	function = function_parts(type)
	if function != ø { return "(${types_text(function.parameters, whole)}) ${FUNCTION_ARROW} ${type_text(function.result, whole)}" }
	"${type_text(head_of(type!), whole)}<${types_text(parts_of(type!), whole)}>"
}
types_text(types: list<Term>, whole: bool = no) as text := types.map(type => type_text(type, whole)).join(", ")
# a value of a type read as another where that one is wanted: a char as its text, a range as its list
READS = [[CHAR_TERM, TEXT_TERM], [RANGE_TERM, list_type(INT_TERM)]]
read_of(given: Term?) as Term? := if given == ø then ø else (READS.find(pair => same(pair#1, given!)) ?? return ø)#2
# the types whose values pass an any's test for a type: its own and those read as it, a char for a text; a number has
# no box of its own, its values are ints and floats
passing_types(type: Term) as list<Term> := if same(type, NUMBER_TERM) then [INT_TERM, FLOAT_TERM] else [type] + READS.filter(pair => same(pair#2, type)).map(pair => pair#1)
list_type(item: Term) as Term := applied(LIST_TERM, [item])
# the word a type is named by, `list` of list<int>, `text` of text
type_word(type: Term) as text := word_of(type) ?? type_text(type)
item_type(type: Term?) as Term? := only_term(parts_of_type(LIST_TYPE, type))
# a map's type, `map<text, int>`, and its keys' and values' types, ø for any other type
map_type(key: Term, value: Term) as Term := applied(MAP_TERM, [key, value])
key_type(type: Term?) as Term? := map_part(type, 1)
held_type(type: Term?) as Term? := map_part(type, 2)
map_part(type: Term?, at: int) as Term? := {
	parts = parts_of_type(MAP_TYPE, type) ?? return ø
	if #parts == 2 then parts#at else ø
}
function_value_type(key: text, captures: list<Term>) as Term := {
	word = word_keyed(FUNCTION_VALUE_TYPE, "${FUNCTION_VALUE_TYPE} ${key}", #captures)
	TYPES.functions[word_id(word)] = key
	applied(word, captures)
}
# a function value's captures' types, and the key of the function it calls; ø for a type of no function value
function_value_parts(type: Term?) as list<Term>? := if function_value_key(type) == ø then ø else parts_of(type!)
function_value_key(type: Term?) as text? := if type == ø then ø else TYPES.functions.get(word_id(head_of(type!)))

# a type as the program wrote it, read into its term; ø where none is written
written_type(written: Node?) as Term? := if written == ø then ø else type_term(written!)
# a type the compiler writes into code it makes, as its notation carrying its term
written_of(type: Term) as Node := with_fact(symbol(type_text(type)), TYPE, type_fact(type))
# a type refused as code is, where it has no place of its own
refused_type(type: Term, why: text) as never := raise("${why}: ${type_text(type)}")
# The door: a type as a program writes it read into its term. `list<int>`, `int?`, `(int) -> text`, `40⋅byte` (a
# list of bytes), a function value's `fn<"key", int>`; a name alone is its word
type_term(n: Node) as Term := {
	known = fact_type(fact_of(n, TYPE))
	if known != ø { return known! }
	parts = written_parts(n)
	if parts != ø { return type_built(word_term(text(parts#1)), parts.drop(1).map(part => type_term(part))) }
	match n {
		Call(times, items) => if text(times) == ARRAY_TIMES and #items == 2 and items#1 is number then list_type(type_term(items#2)) else raise("${n} is no type")
		Empty => EMPTY_TERM
		_ => word_named(n)
	}
}
# A written type with parts read as its word and then the parts, as type_parts reads a term: `list<int>` as list and
# int, `int?` as ? and int, `(int, text) -> bool` as ->, int, text and bool, in round brackets or not; ø for a word
# alone and any other code
written_parts(n: Node) as list<Node>? := match n {
	Key(name, Op.None, List(items, Bracket.Less, separator)) => [name] + items
	List(items, Bracket.None, separator) => if #items == 2 and text(items#2) == OPTIONAL_MARK then [items#2, items#1] else ø
	Call(called, items) => if text(called) == FUNCTION_ARROW and #items == 2 then [called] + items_or_one(items#1) + [items#2] else ø
	List(items, Bracket.Round, separator) => if #items == 1 then written_parts(items#1) else ø
	_ => ø
}
# the parts a written type of this word has, `int` of `int?`; ø for code of another word
written_parts_of(word: text, n: Node) as list<Node>? := {
	parts = written_parts(n) ?? return ø
	if text(parts#1) == word then parts.drop(1) else ø
}
# two types are one where their terms are the same
==(a: Term, b: Term) as bool := same(a, b)
