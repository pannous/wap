# A C function as lib writes it, the function as C has it, `strlen(s: text): i64 from 'c'` (lib/c.warp): a function
# whose body calls the library's import (extensions/c/functions.wap describes it for the native warp), a text passed as
# its C copy and a text given back copied from C (lib/foreign.wap). C's numbers are the program's: an int of any width, a
# handle a C pointer held as the number of the run it crosses as (lib/foreign.wap c_handle_of), a double a float, and a float written f32 crosses as C's float, a bool as C's int;
# an out-pointer (`out`, `sqlite3 **`) no argument but a slot C fills, the first one's pointer a handle result;
# a list of texts (`texts`) C's NULL-ended `char *[]`; a u32 C's unsigned int; an `owned_text` result a `char *` the
# caller owns, read back as a text, then freed; a list of bytes (`bytes`) a pointer to their copy, its count the
# `length` parameter after it, and a `bytes` result a pointer to a length and the bytes, a text, freed; `bytes<40>` a
# struct of 40 bytes at a handle, given by value (wgpu's callback infos); a typed list (`list<float32>`) a pointer to its
# items packed at their width, as C reads an array of them, C's writes into them seen once the call returns, its byte
# count the `length` after it; `void` is ø.
rule ($name($parameters...): ø from $library) => ($name((c_parameter $parameters)...) := { c_outer = c_call_started(); prim foreign($library, "$name", (c_passed $parameters)...); (c_returned $parameters)...; c_call_ended(c_outer) })
rule ($name($parameters...): $result from $library) => ($name((c_parameter $parameters)...): (c_type $result) := { c_outer = c_call_started(); c_value: (c_type $result) = c_back $result (prim foreign($library, "$name", (c_passed $parameters)...)); (c_returned $parameters)...; c_call_ended(c_outer); c_value })
# (a parameter's type read as a word: `$parameter: text` in a pattern is a hole for code of type text)
rule c_parameter ($parameter: $type) => c_kept $type $parameter
rule c_kept out $parameter => ()
rule c_kept length $parameter => ()
rule c_kept bytes $parameter => ($parameter: list<int>)
rule c_kept bytes<$size> $parameter => ($parameter: int)
rule c_kept list<$type> $parameter => ($parameter: list<$type>)
# a record's parameter keeps its class; the class case, a declaration rule, would lose to a catch-all of the shape stage
rule c_kept $type: class $parameter => c_record_kept $type $parameter
rule c_record_kept Record($name, $fields, $cases) $parameter => ($parameter: $name)
rule c_kept text $parameter => ($parameter: (c_type text))
rule c_kept texts $parameter => ($parameter: (c_type texts))
rule c_kept f32 $parameter => ($parameter: (c_type f32))
rule c_kept f64 $parameter => ($parameter: (c_type f64))
rule c_kept bool $parameter => ($parameter: (c_type bool))
rule c_kept handle $parameter => ($parameter: (c_type handle))
rule c_kept i32 $parameter => ($parameter: (c_type i32))
rule c_kept i64 $parameter => ($parameter: (c_type i64))
rule c_kept u32 $parameter => ($parameter: (c_type u32))
rule c_passed ($parameter: $type) => c_argument $type $parameter
# after the call: a typed list holds what C wrote into its items
rule c_returned ($parameter: $type) => c_given_back $type $parameter
rule c_given_back list<$type> $parameter => items_returned($parameter)
rule c_given_back $type: class $parameter => c_record_read $type $parameter
rule c_record_read Record($name, [$fields...], $cases) $parameter => { c_record_returned(); (c_field_back (c_field $parameter $fields))... }
rule c_field_back $place => ($place = item_found($place, c_field_next(value_bytes($place))))
# what no other C type has to read back: the class case, a declaration rule, would lose to a catch-all of the shape stage
rule c_given_back out $parameter => ()
rule c_given_back length $parameter => ()
rule c_given_back bytes $parameter => ()
rule c_given_back bytes<$size> $parameter => ()
rule c_given_back texts $parameter => ()
rule c_given_back text $parameter => ()
rule c_given_back f32 $parameter => ()
rule c_given_back f64 $parameter => ()
rule c_given_back bool $parameter => ()
rule c_given_back handle $parameter => ()
rule c_given_back i32 $parameter => ()
rule c_given_back i64 $parameter => ()
rule c_given_back u32 $parameter => ()
rule c_argument out $parameter => c_out()
rule c_argument length $parameter => c_bytes_count
rule c_argument bytes $parameter => c_bytes($parameter)
rule c_argument bytes<$size> $parameter => c_struct(c_pointer_of($parameter), $size)
rule c_argument list<$type> $parameter => c_items($parameter)
rule c_argument texts $parameter => c_texts($parameter)
rule c_argument text $parameter => c_text($parameter)
rule c_argument f32 $parameter => float32($parameter)
rule c_argument bool $parameter => c_flag($parameter)
rule c_argument handle $parameter => c_pointer_of($parameter)
# a record (a class's instance) crosses as a pointer to its fields laid out as C's struct of them, C's writes into
# them seen once the call returns (lib/foreign.wap c_record_started)
rule c_argument $type: class $parameter => c_record_laid $type $parameter
rule c_record_laid Record($name, [$fields...], $cases) $parameter => { c_record_started([(value_bytes(c_field $parameter $fields))...]); (c_field_placed(c_field $parameter $fields))...; c_record_address() }
rule c_field $parameter ($field: $type) => $parameter.$field
rule c_field $parameter ($field = $default) => $parameter.$field
rule c_argument i32 $parameter => $parameter
rule c_argument i64 $parameter => $parameter
rule c_argument u32 $parameter => $parameter
rule c_argument f64 $parameter => $parameter
rule c_type text => text
rule c_type texts => list<text>
rule c_type bytes => text
rule c_type f64 => float
rule c_type f32 => float
rule c_type bool => bool
rule c_type i32 => int
rule c_type u32 => int
rule c_type owned_text => text
rule c_type i64 => int
rule c_type handle => int
rule c_back text $call => c_text_from($call)
rule c_back i32 $call => c_number($call)
rule c_back u32 $call => c_unsigned($call)
rule c_back owned_text $call => c_owned_text($call)
rule c_back f32 $call => c_double($call)
rule c_back bool $call => c_bool($call)
rule c_back bytes $call => c_counted_text($call)
rule c_back handle $call => c_handle_of(c_handle($call))
rule c_back $type $call => $call
