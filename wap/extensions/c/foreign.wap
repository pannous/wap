# A C function as lib writes it, the function as C has it, `strlen(s: text): i64 from 'c'` (lib/c.warp): a function
# whose body calls the library's import (extensions/c/functions.wap describes it for the native warp), a text passed as
# its C copy and a text given back copied from C (types/c.wap). C's numbers are the program's: an int of any width, a
# handle a C pointer held as an int, a double a float, and a float written f32 crosses as C's float, a bool as C's int;
# an out-pointer (`out`, `sqlite3 **`) no argument but a slot C fills, the first one's pointer a handle result;
# a list of texts (`texts`) C's NULL-ended `char *[]`; a u32 C's unsigned int; an `owned_text` result a `char *` the
# caller owns, read back as a text, then freed; a list of bytes (`bytes`) a pointer to their copy, its count the
# `length` parameter after it, and a `bytes` result a pointer to a length and the bytes, a text, freed; `void` is ø.
rule ($name($parameters...): ø from $library) => ($name((c_parameter $parameters)...) := { c_call_started(); prim foreign($library, "$name", (c_passed $parameters)...) })
rule ($name($parameters...): $result from $library) => ($name((c_parameter $parameters)...): (c_word $result c_type) := { c_call_started(); c_word $result c_back (prim foreign($library, "$name", (c_passed $parameters)...)) })
# (a parameter's type read as a word: `$parameter: text` in a pattern is a hole for code of type text)
rule c_parameter ($parameter: $type) => c_word $type c_kept $parameter
rule c_kept out $parameter => ()
rule c_kept length $parameter => ()
rule c_kept bytes $parameter => ($parameter: list<int>)
rule c_kept $type $parameter => ($parameter: (c_type $type))
rule c_passed ($parameter: $type) => c_word $type c_argument $parameter
rule c_argument out $parameter => c_out()
rule c_argument length $parameter => c_bytes_count
rule c_argument bytes $parameter => c_bytes($parameter)
rule c_argument texts $parameter => c_texts($parameter)
rule c_argument text $parameter => c_text($parameter)
rule c_argument f32 $parameter => c_float($parameter)
rule c_argument bool $parameter => c_flag($parameter)
rule c_argument $type $parameter => $parameter
# warp's other words for the C types (extensions/c_imports/imports.warp c_type_words), each as the one it means,
# handed to the rule that reads it: `c_word int c_kept n` is `c_kept i32 n`
rule c_word int $then $rest... => $then i32 $rest...
rule c_word int32 $then $rest... => $then i32 $rest...
rule c_word char $then $rest... => $then i32 $rest...
rule c_word int64 $then $rest... => $then i64 $rest...
rule c_word long $then $rest... => $then i64 $rest...
rule c_word size_t $then $rest... => $then i64 $rest...
rule c_word uint32 $then $rest... => $then u32 $rest...
rule c_word float $then $rest... => $then f64 $rest...
rule c_word double $then $rest... => $then f64 $rest...
rule c_word number $then $rest... => $then f64 $rest...
rule c_word float32 $then $rest... => $then f32 $rest...
rule c_word string $then $rest... => $then text $rest...
rule c_word pointer $then $rest... => $then handle $rest...
rule c_word nothing $then $rest... => $then void $rest...
rule c_word $type $then $rest... => $then $type $rest...
rule c_type text => text
rule c_type texts => list<text>
rule c_type bytes => text
rule c_type f64 => float
rule c_type f32 => float
rule c_type bool => bool
rule c_type i32 => int
rule c_type u32 => int
rule c_type owned_text => text
rule c_type i64 => int
rule c_type handle => int
rule c_type $type => refuse "this C type does not cross yet: i32, u32, i64, f32, f64, bool, handle, out, text, owned_text, texts, bytes and length do"
rule c_back text $call => c_text_from($call)
rule c_back i32 $call => c_number($call)
rule c_back u32 $call => c_unsigned($call)
rule c_back owned_text $call => c_owned_text($call)
rule c_back f32 $call => c_double($call)
rule c_back bool $call => c_bool($call)
rule c_back bytes $call => c_counted_text($call)
rule c_back handle $call => c_handle($call)
rule c_back $type $call => $call
