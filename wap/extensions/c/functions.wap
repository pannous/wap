# The C functions a program calls through the native warp, lib's foreign lines `strlen(s: text): i64 from 'c'` (lowered
# by extensions/c/foreign.wap, their texts by types/c.wap): the module describes each import of a C library in its custom
# section warp.c_functions, one line of tab-separated fields the native warp links by (core/native/driver.warp "C
# calls"): the import's module, the library, the name, its parameters' kinds, the result's register, how the result
# crosses, and three fields left empty. A kind follows the import's value type: an i32 is an address of the module's
# memory, which the host gives C as its pointer (as extensions/native/c.wap has it), an i64 a number or a C pointer, an
# f64 a double.
use "../../core/emit/wasm.wap"
use "../../core/emit/opcodes.wap"

C_FUNCTIONS_SECTION = "warp.c_functions"
# the rules that lower a foreign line, beside the compiler as the types module is
C_FUNCTION_RULES = "extensions/c/foreign.wap"
# the import modules that are no C library: WASI's and the native warp's host words; a compiled module is named by its
# path, which ends in .wasm
NOT_C = ["wasi_snapshot_preview1", "host"]
NO_RESULT = "void"
CROSSES_AS = "number"
FIELDS_LEFT_EMPTY = ["", "", ""]

# a module's bytes and, when it imports C functions, the section that describes them
c_described(m: WasmModule, bytes: list<int>) as list<int> := {
	lines = m.imported_functions.filter(is_c).map(c_line)
	if lines is empty then bytes else bytes + custom_section(C_FUNCTIONS_SECTION, lines.join("\n").bytes)
}
is_c(function: ImportedFunction) as bool := not NOT_C.contains(function.module) and not function.module.ends_with(MODULE_ENDING)
c_line(function: ImportedFunction) as text := {
	result = if function.results is empty then NO_RESULT else kind(function.results#1, "i32")
	([function.module, function.module, function.name, function.parameters.map(type => kind(type, "address")).join(","), result, CROSSES_AS] + FIELDS_LEFT_EMPTY).join("\t")
}
# the kind of a value type, an i32 named as given: a parameter's is an address, a result's a number
kind(type: list<int>, i32: text) as text := if type == I32 then i32 else if type == I64 then "i64" else if type == F32 then "f32" else "f64"
