# A named law's `for` lines are its binders, `law doubled:` then `for n: nat` is `law doubled(n: nat): …`, as the law
# rules of a verify compile read them (law_runs.wap, law_statements.wap)
rule law ($name: {for $binder {$type}; $lines...}) => law_for $name [$binder: $type] {$lines...}
rule law_for $name [$binders...] {for $binder {$type}; $lines...} => law_for $name [$binders..., $binder: $type] {$lines...}
rule law_for $name [$binders...] {$statement} => law($name: (($binders...) -> $statement))
