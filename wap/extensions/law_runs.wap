# Each law a function wap verify runs (wiki/law.md "Checking a law", extensions/verify_rules.wap): `law positive(x:
# int): x > 0`, which sugar/definitions.wap reads as `law(positive: ((x: int) -> x > 0))`, is `law_positive()`, which
# tries the statement on each choice of its binders' values (lib/laws.wap). A law with a proof is the kernel's, and
# one whose binders are left unwritten waits for their types: both are left out
use "law_for.wap"
rule law($head := $proof) => ()
rule law($name: (($binders...) -> $statement)) => (Symbol("law_$name")() := law_tried("$name", law_trials $statement [] [$binders...]))
rule law ($name: $statement) => (Symbol("law_$name")() := law_tried("$name", [law_trial($statement, [])]))
rule law $statement... => ()
# the trials of a statement, binder by binder, several binders a tuple: each value of the first one's type, the trials
# of the rest with it
rule law_trials $statement [$shown...] [($first, $second, $more...)] => law_trials $statement [$shown...] [$first, $second, $more...]
rule law_trials $statement [$shown...] [($binder: $type), $rest...] => flat_map(law_values $type, $binder => law_trials $statement [$shown..., trial_shown("$binder", $binder)] [$rest...])
rule law_trials $statement [$shown...] [] => [law_trial($statement, [$shown...])]
# the values a binder of the type takes: a list's built of its items' (the language picks no generic overload by its
# result alone, so a list's values are asked of its items' type), any other type's its trial_values
rule law_values list<$item> => trial_lists(trial_values() as list<$item>)
rule law_values $type => trial_values() as list<$type>
