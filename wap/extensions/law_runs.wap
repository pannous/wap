# Each law a function wap verify runs (wiki/law.md "Checking a law", extensions/verify_rules.wap): `law positive(x:
# int): x > 0`, which sugar/definitions.wap reads as `law(positive: ((x: int) -> x > 0))`, is `law_positive()`, which
# tries the statement on each choice of its binders' values (types/laws.wap). A law with a proof is the kernel's, and
# one whose binders are left unwritten waits for their types: both are left out
rule law($head := $proof) => ()
rule law($name: (($binders...) -> $statement)) => (Symbol("law_$name")() := law_tried("$name", law_trials $statement [] [$binders...]))
# a named law's `for` lines are its binders, `law doubled:` then `for n: nat` is `law doubled(n: nat): …`
rule law ($name: {for $binder {$type}; $lines...}) => law_for $name [$binder: $type] {$lines...}
rule law_for $name [$binders...] {for $binder {$type}; $lines...} => law_for $name [$binders..., $binder: $type] {$lines...}
rule law_for $name [$binders...] {$statement} => law($name: (($binders...) -> $statement))
rule law ($name: $statement) => (Symbol("law_$name")() := law_tried("$name", [LawTrial($statement, [])]))
rule law $statement... => ()
# the trials of a statement, binder by binder, several binders a tuple: each value of the first one's type, the trials
# of the rest with it
rule law_trials $statement [$shown...] [($first, $second, $more...)] => law_trials $statement [$shown...] [$first, $second, $more...]
rule law_trials $statement [$shown...] [($binder: $type), $rest...] => flat_map(trial_values() as list<$type>, $binder => law_trials $statement [$shown..., trial_shown("$binder", $binder)] [$rest...])
rule law_trials $statement [$shown...] [] => [LawTrial($statement, [$shown...])]
