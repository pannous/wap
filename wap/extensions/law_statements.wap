# The laws wap verify has analyze type (wiki/law.md, extensions/verify/laws.wap): each law whose statement is written
# in wap, the function of its binders giving the statement, `law positive(x: int): x > 0` the function
# `law_positive(x: int): bool := x > 0`; a law with a proof, `law nine: 3 * 4 - 3 == 9 := refl`, is the function of
# its proof every build reads (law_for.wap). A law whose binders are left unwritten gets no function
use "law_for.wap"
# a theorem is a law that must be proved (wiki/proof.md), verified as one
rule theorem($head := $proof) => law($head := $proof)
rule law($head := $proof) => law_proved $proof ($head)
rule law_proved $proof ($name($binders...): $statement) => (Symbol("law_$name")($binders...): bool := Symbol("law proof")($statement, $proof))
rule law_proved $proof ($name: $statement) => (Symbol("law_$name")(): bool := Symbol("law proof")($statement, $proof))
# one binder alone, several binders a tuple
rule law($name: (($binder: $type) -> $statement)) => (Symbol("law_$name")($binder: $type): bool := $statement)
rule law($name: (($first, $second, $more...) -> $statement)) => (Symbol("law_$name")($first, $second, $more...): bool := $statement)
rule law($name: ($binders -> $statement)) => ()
rule law ($name: $statement) => (Symbol("law_$name")(): bool := $statement)
rule law $statement... => ()
