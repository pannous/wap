# The laws the theory's door has analyze type (wiki/law.md, extensions/theory/elaborate/typed_laws.wap): each law whose
# statement is written in wap, without a proof, the function of its binders giving the statement, `law positive(x:
# int): x > 0` the function `law_positive(x: int): bool := x > 0`. A law with a proof, one in the short form and every
# axiom and theorem are the theory's alone, which reads them as written
use "law_for.wap"
rule law($head := $proof) => ()
# one binder alone, several binders a tuple; binders without their types are the theory's
rule law($name: (($binder: $type) -> $statement)) => (Symbol("law_$name")($binder: $type): bool := $statement)
rule law($name: (($first, $second, $more...) -> $statement)) => (Symbol("law_$name")($first, $second, $more...): bool := $statement)
rule law($name: ($binders -> $statement)) => ()
rule law ($name: $statement) => (Symbol("law_$name")(): bool := $statement)
rule law $statement... => ()
