# The C functions a native wap program calls (wap/extensions/native, build.sh's glue.awk): libc's and wasmtime's C
# API, each a foreign primitive of the module "c". A pointer is an address in the program's memory, which the glue
# gives C as a pointer to it; an int is an int, a C bool or a host handle (an engine, a store, a malloc'd block) as it
# is; a text crosses as the address of its own bytes, a C string (`from 'c'`, extensions/c/foreign.wap). Each C name is
# declared once, by the types this extension gives it.

# --- the program's memory: a pointer as an int and back, its 32-bit words, the host's longs read and written ---
address(p: int32): int := prim i64.extend_i32_u(p)
pointer_at(at: int): int32 := prim i32.wrap_i64(at)
word_at(at: int): int := prim i32.load(at)
memory_byte(at: int): int := prim i32.load8_u(at)
set_word(at: int, word: int) := prim i32.store(at, word)
WORD_RANGE := 4294967296
# where a host long passes through the program's memory, past the bytes the host's own words borrow (core/emit/host.wap)
LONG_AT := 1024
# a host pointer: what the glue makes of an address of the program's memory (memmove gives its destination back)
host_of(p: int32): int := memmove(p, p, 0)
long_at(host: int): int := {
	memcpy(pointer_at(LONG_AT), host, 8)
	word_at(LONG_AT) + word_at(LONG_AT + 4) * WORD_RANGE
}
set_long_at(host: int, value: int) := {
	set_word(LONG_AT, value % WORD_RANGE)
	set_word(LONG_AT + 4, value ÷ WORD_RANGE)
	bcopy(pointer_at(LONG_AT), host, 8)
}
# a byte of the host's memory
host_byte(host: int): int := {
	memcpy(pointer_at(LONG_AT), host, 1)
	memory_byte(LONG_AT)
}
# a block of the host's memory of `count` bytes, zeroed
host_block(count: int): int := calloc(1, count)

# --- libc ---
memmove(destination: int32, source: int32, count: int): int := prim foreign("c", "memmove", destination, source, count)
memcpy(destination: int32, source: int, count: int): int := prim foreign("c", "memcpy", destination, source, count)
bcopy(source: int32, destination: int, count: int) := prim foreign("c", "bcopy", source, destination, count)
calloc(count: int, size: int): int := prim foreign("c", "calloc", count, size)
malloc(count: int): int := prim foreign("c", "malloc", count)
strlen(t: int): int := prim foreign("c", "strlen", t)
# the same of the host's memory: a run of bytes, a copy of the first count
memchr(bytes: int, character: int, count: int): int := prim foreign("c", "memchr", bytes, character, count)
memmem(bytes: int, count: int, found: int32, found_count: int): int := prim foreign("c", "memmem", bytes, count, found, found_count)
strndup(t: int, count: int): int := prim foreign("c", "strndup", t, count)
fopen(path: text, mode: text): i64 from 'c'
fseek(file: int, offset: int, whence: int): int := prim foreign("c", "fseek", file, offset, whence)
ftell(file: int): int := prim foreign("c", "ftell", file)
fread(into: int, size: int, count: int, file: int): int := prim foreign("c", "fread", into, size, count, file)
fclose(file: int): int := prim foreign("c", "fclose", file)
fputs(t: text, file: i64): i64 from 'c'
write(file: int, bytes: int, count: int): int := prim foreign("c", "write", file, bytes, count)
getenv(name: text): text from 'c'
# the int a text of decimal digits writes (prelude's int() raises, which a native build takes not)
atol(digits: text): i64 from 'c'
mkstemps(template: text, suffix_length: i64): i64 from 'c'
close(file: int): int := prim foreign("c", "close", file)
# a file made empty, or anew, for writing; its descriptor
creat(path: text, mode: i64): i64 from 'c'
# (C's read, under a name of its own: wap's read reads a file's text)
bytes_read(file: int, into: int32, count: int): int := prim foreign("c", "read", file, into, count)
isatty(file: int): int := prim foreign("c", "isatty", file)
# a new folder by the template, its last six X's replaced
mkdtemp(template: text): text from 'c'
rmdir(path: text): i64 from 'c'
rename(from: text, to: text): i64 from 'c'
unlink(path: text): i64 from 'c'
# the path with its links followed; "" where nothing is there
realpath(path: text, resolved: handle): text from 'c'
# 0 where the path names a file there
access(path: text, mode: i64): i64 from 'c'
_NSGetExecutablePath(path: text, size_at: handle): i64 from 'c'
# the command run by the shell, its wait status given
system(command: text): i64 from 'c'
exit(code: int) := prim proc_exit(code)

# --- wasmtime's C API (lib/libwarp_wasmtime, warp's build of it with its warp_config_ words) ---
wasm_config_new(): int := prim foreign("c", "wasm_config_new")
wasmtime_config_wasm_gc_set(config: int, enabled: int) := prim foreign("c", "wasmtime_config_wasm_gc_set", config, enabled)
wasmtime_config_wasm_function_references_set(config: int, enabled: int) := prim foreign("c", "wasmtime_config_wasm_function_references_set", config, enabled)
wasmtime_config_wasm_exceptions_set(config: int, enabled: int) := prim foreign("c", "wasmtime_config_wasm_exceptions_set", config, enabled)
warp_config_gc_heap_initial_size_set(config: int, bytes: int) := prim foreign("c", "warp_config_gc_heap_initial_size_set", config, bytes)
warp_config_wasm_stack_set(config: int, bytes: int) := prim foreign("c", "warp_config_wasm_stack_set", config, bytes)
wasm_engine_new_with_config(config: int): int := prim foreign("c", "wasm_engine_new_with_config", config)
wasmtime_store_new(engine: int, data: int, finalizer: int): int := prim foreign("c", "wasmtime_store_new", engine, data, finalizer)
# a store's caps, -1 for none: the bytes of each memory, the elements of each table, its instances, tables, memories
wasmtime_store_limiter(store: int, memory_bytes: int, table_elements: int, instances: int, tables: int, memories: int) := prim foreign("c", "wasmtime_store_limiter", store, memory_bytes, table_elements, instances, tables, memories)
# a clock for the engine's stores: epoch deadlines on, ticked once a second (main.c), a store's deadline in ticks
wasmtime_config_epoch_interruption_set(config: int, enabled: int) := prim foreign("c", "wasmtime_config_epoch_interruption_set", config, enabled)
epoch_ticker_started(engine: int) := prim foreign("c", "epoch_ticker_started", engine)
wasmtime_context_set_epoch_deadline(context: int, ticks: int) := prim foreign("c", "wasmtime_context_set_epoch_deadline", context, ticks)
wasmtime_store_context(store: int): int := prim foreign("c", "wasmtime_store_context", store)
wasi_config_new(): int := prim foreign("c", "wasi_config_new")
wasi_config_set_argv(config: handle, count: i64, arguments: texts): i64 from 'c'
wasi_config_inherit_stdin(config: int) := prim foreign("c", "wasi_config_inherit_stdin", config)
wasi_config_inherit_stdout(config: int) := prim foreign("c", "wasi_config_inherit_stdout", config)
wasi_config_inherit_stderr(config: int) := prim foreign("c", "wasi_config_inherit_stderr", config)
wasi_config_inherit_env(config: int) := prim foreign("c", "wasi_config_inherit_env", config)
wasi_config_preopen_dir(config: handle, host_path: text, guest_path: text, mutable: i64): i64 from 'c'
wasmtime_context_set_wasi(context: int, config: int): int := prim foreign("c", "wasmtime_context_set_wasi", context, config)
wasmtime_linker_new(engine: int): int := prim foreign("c", "wasmtime_linker_new", engine)
wasmtime_linker_define_wasi(linker: int): int := prim foreign("c", "wasmtime_linker_define_wasi", linker)
wasmtime_module_new(engine: int, bytes: int, size: int, module_at: int): int := prim foreign("c", "wasmtime_module_new", engine, bytes, size, module_at)
# a module's machine code, as a byte vector, and a module of the machine code in a file; each an error, 0 for none
wasmtime_module_serialize(module: int, code_at: int): int := prim foreign("c", "wasmtime_module_serialize", module, code_at)
wasmtime_module_deserialize_file(engine: handle, path: text, module_at: handle): i64 from 'c'
wasmtime_module_exports(module: int, exports_at: int) := prim foreign("c", "wasmtime_module_exports", module, exports_at)
wasmtime_module_imports(module: int, imports_at: int) := prim foreign("c", "wasmtime_module_imports", module, imports_at)
# an import's module and its name, each a host name vector (size, data)
wasm_importtype_module(imported: int): int := prim foreign("c", "wasm_importtype_module", imported)
wasm_importtype_name(imported: int): int := prim foreign("c", "wasm_importtype_name", imported)
# whether the linker holds the item of that module and name, each a host name vector (size, data); a C bool
wasmtime_linker_get(linker: int, context: int, module: int, name: int, item_at: int): int := prim foreign("c", "wasmtime_linker_get", linker, context, long_at(module + 8), long_at(module), long_at(name + 8), long_at(name), item_at)
wasmtime_linker_define_instance(linker: handle, context: handle, name: text, size: i64, instance_at: handle): i64 from 'c'
wasmtime_linker_instantiate(linker: int, context: int, module: int, instance_at: int, trap_at: int): int := prim foreign("c", "wasmtime_linker_instantiate", linker, context, module, instance_at, trap_at)
wasmtime_instance_export_get(context: handle, instance_at: handle, name: text, size: i64, item_at: handle): i64 from 'c'
wasmtime_func_call(context: int, function_at: int, arguments_at: int, count: int, results_at: int, results_count: int, trap_at: int): int := prim foreign("c", "wasmtime_func_call", context, function_at, arguments_at, count, results_at, results_count, trap_at)
wasmtime_error_exit_status(error: int, status_at: int): int := prim foreign("c", "wasmtime_error_exit_status", error, status_at)
wasmtime_error_message(error: int, message_at: int) := prim foreign("c", "wasmtime_error_message", error, message_at)
wasm_trap_message(trap: int, message_at: int) := prim foreign("c", "wasm_trap_message", trap, message_at)
