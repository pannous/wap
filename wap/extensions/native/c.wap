# The C functions a native wap program calls (wap/extensions/native, build.sh's glue.awk): libc's and wasmtime's C
# API, each a foreign primitive of the module "c". A pointer is an address in the program's memory, which the glue
# gives C as a pointer to it; an int is an int, a C bool or a host address (an engine, a store, a malloc'd block, an i64, no handle) as it
# is; a text crosses as the address of its own bytes, a C string (`from 'c'`, extensions/c/foreign.wap). Each C name is
# declared once, by the types this extension gives it.

# --- the program's memory: a pointer as an int and back, its 32-bit words, the host's longs read and written ---
use foreign
use "../../types/host.wap"

address(p: int32): int := prim i64.extend_i32_u(p)
pointer_at(at: int): int32 := prim i32.wrap_i64(at)
# where a host long passes through the program's memory, past the bytes the host's own words borrow (core/emit/host.wap)
LONG_AT := 1024
# a host pointer: an address of the program's memory as the glue translates it (main.c wap_host_pointer)
host_of(address: int32): int := prim foreign("c", "wap_host_pointer", address)
long_at(host: int): int := {
	memcpy(pointer_at(LONG_AT), host, 8)
	memory_int(LONG_AT)
}
set_long_at(host: int, value: int) := {
	set_memory_int(LONG_AT, value)
	bcopy(pointer_at(LONG_AT), host, 8)
}
# a byte of the host's memory
host_byte(host: int): int := {
	memcpy(pointer_at(LONG_AT), host, 1)
	memory_byte(LONG_AT)
}
# a block of the host's memory of `count` bytes, zeroed
host_block(count: int): int := calloc(1, count)

# --- libc ---
memcpy(destination: int32, source: int, count: int): int := prim foreign("c", "memcpy", destination, source, count)
bcopy(source: int32, destination: int, count: int) := prim foreign("c", "bcopy", source, destination, count)
calloc(count: i64, size: i64): i64 from 'c'
malloc(count: i64): i64 from 'c'
free(block: i64): ø from 'c'
strlen(t: i64): i64 from 'c'
# the same of the host's memory: a run of bytes, a copy of the first count
memchr(bytes: i64, character: i64, count: i64): i64 from 'c'
memmem(bytes: int, count: int, found: int32, found_count: int): int := prim foreign("c", "memmem", bytes, count, found, found_count)
strndup(t: i64, count: i64): i64 from 'c'
fopen(path: text, mode: text): i64 from 'c'
fseek(file: i64, offset: i64, whence: i64): i64 from 'c'
ftell(file: i64): i64 from 'c'
fread(into: i64, size: i64, count: i64, file: i64): i64 from 'c'
fwrite(from: i64, size: i64, count: i64, file: i64): i64 from 'c'
fclose(file: i64): i64 from 'c'
fputs(t: text, file: i64): i64 from 'c'
# (C's write, under a name of its own: wap's write writes a text)
c_write(file: int, bytes: int, count: int): int := prim foreign("c", "write", file, bytes, count)
getenv(name: text): text from 'c'
# a system text by its name, written into the block of `size` bytes (macOS: the user's temporary folder)
confstr(name: i64, into: i64, size: i64): i64 from 'c'
# the int a text of decimal digits writes (prelude's int() raises, which a native build takes not)
atol(digits: text): i64 from 'c'
mkstemps(template: text, suffix_length: i64): i64 from 'c'
close(file: i64): i64 from 'c'
# (C's read, under a name of its own: wap's read reads a file's text)
bytes_read(file: int, into: int32, count: int): int := prim foreign("c", "read", file, into, count)
isatty(file: i64): i64 from 'c'
# a new folder by the template, its last six X's replaced
mkdtemp(template: text): text from 'c'
rmdir(path: text): i64 from 'c'
rename(from: text, to: text): i64 from 'c'
unlink(path: text): i64 from 'c'
# the path with its links followed; "" where nothing is there
realpath(path: text, resolved: i64): text from 'c'
# 0 where the path names a file there
access(path: text, mode: i64): i64 from 'c'
_NSGetExecutablePath(path: text, size_at: i64): i64 from 'c'
# the command run by the shell, its wait status given
system(command: text): i64 from 'c'

# --- wasmtime's C API (lib/libwarp_wasmtime, warp's build of it with its warp_config_ words) ---
wasm_config_new(): i64 from 'c'
wasmtime_config_wasm_gc_set(config: i64, enabled: i64): ø from 'c'
wasmtime_config_wasm_function_references_set(config: i64, enabled: i64): ø from 'c'
wasmtime_config_wasm_exceptions_set(config: i64, enabled: i64): ø from 'c'
warp_config_gc_heap_initial_size_set(config: i64, bytes: i64): ø from 'c'
warp_config_wasm_stack_set(config: i64, bytes: i64): ø from 'c'
wasm_engine_new_with_config(config: i64): i64 from 'c'
wasmtime_store_new(engine: i64, data: i64, finalizer: i64): i64 from 'c'
# a store's caps, -1 for none: the bytes of each memory, the elements of each table, its instances, tables, memories
wasmtime_store_limiter(store: i64, memory_bytes: i64, table_elements: i64, instances: i64, tables: i64, memories: i64): ø from 'c'
# a clock for the engine's stores: epoch deadlines on, ticked once a second (main.c), a store's deadline in ticks
wasmtime_config_epoch_interruption_set(config: i64, enabled: i64): ø from 'c'
epoch_ticker_started(engine: i64): ø from 'c'
# when this executable was built, C's `Nov 22 2026 17:20:33` (main.c)
wap_built(): text from 'c'
# the library folder told to the programs the native wap runs (main.c, lib/host/native_host/platform.wap library_folder)
wap_library_folder_set(folder: text): ø from 'c'
# the options of the run told to the programs it runs, a `name=value` line each (main.c, lib/os.wap run_option)
wap_run_options_set(options: text): ø from 'c'
wasmtime_context_set_epoch_deadline(context: i64, ticks: i64): ø from 'c'
wasmtime_store_context(store: i64): i64 from 'c'
wasmtime_store_delete(store: i64): ø from 'c'
wasi_config_new(): i64 from 'c'
wasi_config_set_argv(config: i64, count: i64, arguments: texts): i64 from 'c'
wasi_config_inherit_stdin(config: i64): ø from 'c'
wasi_config_set_stdin_bytes(config: i64, bytes: i64): ø from 'c'
wasm_byte_vec_new(vector: i64, count: i64, bytes: text): ø from 'c'
wasi_config_inherit_stdout(config: i64): ø from 'c'
wasi_config_set_stdout_file(config: i64, path: text): i64 from 'c'
wasi_config_inherit_stderr(config: i64): ø from 'c'
wasi_config_inherit_env(config: i64): ø from 'c'
wasi_config_preopen_dir(config: i64, host_path: text, guest_path: text, mutable: i64): i64 from 'c'
wasmtime_context_set_wasi(context: i64, config: i64): i64 from 'c'
wasmtime_linker_new(engine: i64): i64 from 'c'
wasmtime_linker_define_wasi(linker: i64): i64 from 'c'
wasmtime_linker_allow_shadowing(linker: i64, allowed: i64): ø from 'c'
wasmtime_module_new(engine: i64, bytes: i64, size: i64, module_at: i64): i64 from 'c'
# a module's machine code, as a byte vector, and a module of the machine code in a file; each an error, 0 for none
wasmtime_module_serialize(module: i64, code_at: i64): i64 from 'c'
wasmtime_module_deserialize_file(engine: i64, path: text, module_at: i64): i64 from 'c'
wasmtime_module_exports(module: i64, exports_at: i64): ø from 'c'
wasmtime_module_imports(module: i64, imports_at: i64): ø from 'c'
# an import's module and its name, each a host name vector (size, data)
wasm_importtype_module(imported: i64): i64 from 'c'
wasm_importtype_name(imported: i64): i64 from 'c'
# an export's name, a host name vector (size, data)
wasm_exporttype_name(exported: i64): i64 from 'c'
# whether the linker holds the item of that module and name, each a host name vector (size, data); a C bool
wasmtime_linker_get(linker: int, context: int, module: int, name: int, item_at: int): int := prim foreign("c", "wasmtime_linker_get", linker, context, long_at(module + 8), long_at(module), long_at(name + 8), long_at(name), item_at)
wasmtime_linker_define_instance(linker: i64, context: i64, name: text, size: i64, instance_at: i64): i64 from 'c'
wasmtime_linker_instantiate(linker: i64, context: i64, module: i64, instance_at: i64, trap_at: i64): i64 from 'c'
wasmtime_instance_export_get(context: i64, instance_at: i64, name: text, size: i64, item_at: i64): i64 from 'c'
wasmtime_func_call(context: i64, function_at: i64, arguments_at: i64, count: i64, results_at: i64, results_count: i64, trap_at: i64): i64 from 'c'
wasmtime_error_exit_status(error: i64, status_at: i64): i64 from 'c'
wasmtime_error_message(error: i64, message_at: i64): ø from 'c'
wasm_trap_message(trap: i64, message_at: i64): ø from 'c'
