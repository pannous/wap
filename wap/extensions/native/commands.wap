# The native wap's commands and options, one table (driver.wap acts on them): `wap help` lists it, an unknown option is
# refused with it. The words are warp's where they mean the same (core/commands, `warp help`)
use "c.wap"
use "run.wap"
use "linking.wap"

# what a command does, driver.wap's ran: a case of no fields, its tag alone in the native build
enum Action { Program, Module, Console, Build, Test, Verify, Format, Check, Version, Help }
# a command or option as help shows it, how it is written and what it does; a command's words, any one of which picks
# it, and its action. A row of no words is picked by the argument's form: a module by its suffix, else a program
class Usage { written: text, meaning: text, words: list<text> = [], action: Action = Action.Program }
# wap's version, the first line of `wap version`, of the console's start and of the help
WAP_VERSION := "0.1.0"
# the stamp scripts/refresh-seed.sh appends to the seed it installs, a custom section of lines: wap's commit, when it
# was built
BUILD_SECTION := "wap.build"
MONTHS := "JanFebMarAprMayJunJulAugSepOctNovDec"
# where help's meanings start, as in `warp help`
MEANING_COLUMN := 38

commands(): list<Usage> := [
	Usage("wap <file|code> [arguments…]", "Run a program: a .wap file, or code given in its place"),
	Usage("wap run <file|code> [arguments…]", "The same", ["run"], Action.Program),
	Usage("wap release <file|code> [arguments…]", "Run it in the release build mode: its errors name no place (wiki/cli.md)", ["release"], Action.Program),
	Usage("wap <module.wasm> [arguments…]", "Run a compiled module as it is", [], Action.Module),
	Usage("wap repl", "The console: each line run, its value shown (wap alone too)", ["repl"], Action.Console),
	Usage("wap build <file.wap>", "The program as a native executable named as it (build.sh)", ["build"], Action.Build),
	Usage("wap build --wasm [--trim=unused|none] <file.wap>", "The program as one WebAssembly module, app.wasm, the modules it uses linked in (app.full.wasm untrimmed, app.mod.wasm alone)"),
	Usage("wap test [<area>…]", "wap's tests, all or those of each area (test/wap/run.sh)", ["test"], Action.Test),
	Usage("wap verify <file.wap>", "Each law of the program Proved, Tested, FAILED, Untested, Assumed or an Axiom, a verdict a line", ["verify"], Action.Verify),
	Usage("wap format <file.wap>", "The program in canonical spelling, each reading typing decided spelled out", ["format"], Action.Format),
	Usage("wap check [--strict] <file.wap>", "The conditions the program's types leave to be checked when it runs, a line each; --strict refuses the first", ["check"], Action.Check),
	Usage("wap format check <file.wap>", "Each line the format would change; exit 1 if any would", [], Action.Format),
	Usage("wap version", "Show version", ["version", "--version"], Action.Version),
	Usage("wap help", "Show this help (also --help, -h)", ["help", "--help", "-h"], Action.Help)
]
# each before the command or file: `wap --seconds 5 slow.wap`
options(): list<Usage> := [
	Usage("${MEMORY_OPTION} <n>", "The run's memory cap in GB (default ${memory_cap_gb})"),
	Usage("${SECONDS_OPTION} <n>", "The run's time cap in seconds (default ${time_cap_seconds})"),
	Usage(NO_WINDOW_OPTION, "No window opens: a program that paints runs headless, one that opens a window or a sound device itself is stopped"),
	Usage(MUTE_OPTION, "No sound plays (also --muted)")
]
MEMORY_OPTION := "--memory-gb"
SECONDS_OPTION := "--seconds"
NO_WINDOW_OPTION := "--no-window"
MUTE_OPTION := "--mute"
# the other spellings of an option, each taken with a note naming the canonical one
OPTION_ALIASES := {"--muted": MUTE_OPTION}
is_cap_option(word: text): bool := word == MEMORY_OPTION or word == SECONDS_OPTION
# an option told to the program, which asks for it by its name (lib/os.wap run_option)
is_told_option(word: text): bool := [NO_WINDOW_OPTION, MUTE_OPTION].contains(canonical_option(word))
# an option as canonically spelled
canonical_option(word: text): text := OPTION_ALIASES.get(word) ?? word
# the command the word picks: the row naming it, else a module or a program by its form; an option no row names
# is refused, never run as code
command_of(word: text): Usage := {
	for usage in commands() { if usage.words.contains(word) { return usage } }
	if is_option(word) { option_refused(word) }
	row_doing(if word.ends_with(MODULE_SUFFIX) then Action.Module else Action.Program)
}
# the first row of the action
row_doing(action: Action): Usage := {
	rows = commands()
	for usage in rows { if usage.action == action { return usage } }
	rows#1
}

# the help: the commands, then the options
help(): text := version_line() + "\nits commands:\n" + listed(commands()) + "\noptions:\n" + listed(options())
# the usages one a line, each meaning in the meaning column
listed(usages: list<Usage>): text := {
	lines: list<text> = []
	for usage in usages { lines.add("  " + spaced_to(usage.written, MEANING_COLUMN - 2) + usage.meaning) }
	lines.join("\n")
}
# the text with blanks after it up to the width, one blank at least
spaced_to(t: text, width: int): text := t + " " * max(1, width - #t)
# `wap version`, as `warp version`: wap's version, when this executable was built, the compiler it runs and its stamp
version(): text := version_line() + "\nthe native wap · built " + built_minute(wap_built()) + "\n" + compiler_stamp()
version_line(): text := "🌀 Wap ${WAP_VERSION} (${compiler_path})"
# the compiler's stamp: `wap.wasm of 1792a05d8a · built 2026-10-28 20:25`
compiler_stamp(): text := {
	stamp = section_text(compiler_path, BUILD_SECTION)
	line_end = find(stamp, "\n")
	if line_end == 0 then "wap.wasm unstamped" else "wap.wasm of " + bytes_between(stamp, 0, min(line_end - 1, 10)) + " · built " + bytes_between(stamp, line_end, byte_count(stamp))
}
# C's build time, `Nov 22 2026 17:20:33`, as the stamps show one: `2026-11-22 17:20`
built_minute(said: text): text := {
	month = 1
	while month < 12 and bytes_between(MONTHS, 3 * month - 3, 3 * month) != bytes_between(said, 0, 3) { month += 1 }
	day = bytes_between(said, 4, 6).replace(" ", "0")
	bytes_between(said, 7, 11) + "-" + (if month < 10 then "0" else "") + text(month) + "-" + day + " " + bytes_between(said, 12, 17)
}
# whether the word is written as an option, `-h` or `--seconds`; `-` alone names standard input
is_option(word: text): bool := word.starts_with("-") and word != STANDARD_INPUT_PATH
# an option no command takes: refused with the options, exit status 2
option_refused(word: text) := {
	eprint("wap: no option ${word}; the options, before the command or file:\n" + listed(options()) + "\nwap help lists the commands")
	exit(2)
}
