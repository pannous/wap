# The native wap's commands and options, one table (driver.wap acts on them): `wap help` lists it, an unknown option is
# refused with it. The words are warp's where they mean the same (core/commands, `warp help`)
use "c.wap"
use "run.wap"
use "linking.wap"

# a command or option as help shows it: how it is written, what it does
class Usage { written: text, meaning: text }
# wap's version, the first line of `wap version`, of the console's start and of the help
WAP_VERSION := "0.1.0"
# the stamp scripts/refresh-seed.sh appends to the seed it installs, a custom section of lines: wap's commit, when it
# was built
BUILD_SECTION := "wap.build"
MONTHS := "JanFebMarAprMayJunJulAugSepOctNovDec"
# where help's meanings start, as in `warp help`
MEANING_COLUMN := 38

commands(): list<Usage> := [
	Usage("wap <file|code> [arguments…]", "Run a program: a .wap file, or code given in its place"),
	Usage("wap run <file|code> [arguments…]", "The same"),
	Usage("wap <module.wasm> [arguments…]", "Run a compiled module as it is"),
	Usage("wap repl", "The console: each line run, its value shown (wap alone too)"),
	Usage("wap test [<area>…]", "wap's tests, all or those of each area (test/wap/run.sh)"),
	Usage("wap version", "Show version"),
	Usage("wap help", "Show this help (also --help, -h)")
]
# each before the command or file: `wap --seconds 5 slow.wap`
options(): list<Usage> := [
	Usage("${MEMORY_OPTION} <n>", "The run's memory cap in GB (default ${memory_cap_gb})"),
	Usage("${SECONDS_OPTION} <n>", "The run's time cap in seconds (default ${time_cap_seconds})")
]
MEMORY_OPTION := "--memory-gb"
SECONDS_OPTION := "--seconds"
is_cap_option(word: text): bool := word == MEMORY_OPTION or word == SECONDS_OPTION
is_help_word(word: text): bool := word == "help" or word == "--help" or word == "-h"
is_version_word(word: text): bool := word == "version" or word == "--version"
CONSOLE_WORD := "repl"
RUN_WORD := "run"

# the help: the commands, then the options
help(): text := version_line() + "\nits commands:\n" + listed(commands()) + "\noptions:\n" + listed(options())
# the usages one a line, each meaning in the meaning column
listed(usages: list<Usage>): text := {
	lines: list<text> = []
	for usage in usages { lines.add("  " + padded(usage.written, MEANING_COLUMN - 2) + usage.meaning) }
	lines.join("\n")
}
# the text with blanks after it up to the width, one blank at least
padded(t: text, width: int): text := t + " " * max(1, width - #t)
# `wap version`, as `warp version`: wap's version, when this executable was built, the compiler it runs and its stamp
version(): text := version_line() + "\nthe native wap · built " + built_minute(wap_built()) + "\n" + compiler_stamp()
version_line(): text := "🌀 Wap ${WAP_VERSION} (${compiler_path})"
# the compiler's stamp: `wap.wasm of 1792a05d8a · built 2026-10-28 20:25`
compiler_stamp(): text := {
	stamp = section_text(compiler_path, BUILD_SECTION)
	line_end = find(stamp, "\n")
	if line_end == 0 then "wap.wasm unstamped" else "wap.wasm of " + bytes_between(stamp, 0, min(line_end - 1, 10)) + " · built " + bytes_between(stamp, line_end, byte_count(stamp))
}
# C's build time, `Nov 22 2026 17:20:33`, as the stamps show one: `2026-11-22 17:20`
built_minute(said: text): text := {
	month = 1
	while month < 12 and bytes_between(MONTHS, 3 * month - 3, 3 * month) != bytes_between(said, 0, 3) { month = month + 1 }
	day = bytes_between(said, 4, 6).replace(" ", "0")
	bytes_between(said, 7, 11) + "-" + (if month < 10 then "0" else "") + text(month) + "-" + day + " " + bytes_between(said, 12, 17)
}
# whether the word is written as an option, `-h` or `--seconds`
is_option(word: text): bool := word.starts_with("-")
# an option no command takes: refused with the options, exit status 2
option_refused(word: text) := {
	eprint("wap: no option ${word}; the options, before the command or file:\n" + listed(options()) + "\nwap help lists the commands")
	exit(2)
}
