# The native wap's commands and options, one table (driver.wap acts on them): `wap help` lists it, an unknown option is
# refused with it. The words are warp's where they mean the same (core/commands, `warp help`)
use "c.wap"
use "run.wap"
use "linking.wap"

# what a command does, driver.wap's ran: a case of no fields, its tag alone in the native build
enum Action { Program, Module, Console, Test, Version, Help }
# a command or option as help shows it, how it is written and what it does; a command's words, any one of which picks
# it, and its action. A row of no words is picked by the argument's form: a module by its suffix, else a program
class Usage { written: text, meaning: text, words: text = "", action: Action = Action.Program }
# where help's meanings start, as in `warp help`
MEANING_COLUMN := 38

commands(): list<Usage> := [
	Usage("wap <file|code> [arguments…]", "Run a program: a .wap file, or code given in its place"),
	Usage("wap run <file|code> [arguments…]", "The same", "run", Action.Program),
	Usage("wap <module.wasm> [arguments…]", "Run a compiled module as it is", "", Action.Module),
	Usage("wap repl", "The console: each line run, its value shown (wap alone too)", "repl", Action.Console),
	Usage("wap test [<area>…]", "wap's tests, all or those of each area (test/wap/run.sh)", "test", Action.Test),
	Usage("wap version", "Show version", "version --version", Action.Version),
	Usage("wap help", "Show this help (also --help, -h)", "help --help -h", Action.Help)
]
# each before the command or file: `wap --seconds 5 slow.wap`
options(): list<Usage> := [
	Usage("${MEMORY_OPTION} <n>", "The run's memory cap in GB (default ${memory_cap_gb})"),
	Usage("${SECONDS_OPTION} <n>", "The run's time cap in seconds (default ${time_cap_seconds})")
]
MEMORY_OPTION := "--memory-gb"
SECONDS_OPTION := "--seconds"
is_cap_option(word: text): bool := word == MEMORY_OPTION or word == SECONDS_OPTION
# the command the word picks: the row naming it, else a module or a program by its form; an option no row names
# is refused, never run as code
command_of(word: text): Usage := {
	for usage in commands() { if " ${usage.words} ".contains(" ${word} ") { return usage } }
	if is_option(word) { option_refused(word) }
	row_doing(if word.ends_with(MODULE_SUFFIX) then Action.Module else Action.Program)
}
# the first row of the action
row_doing(action: Action): Usage := {
	rows = commands()
	for usage in rows { if usage.action == action { return usage } }
	rows#1
}

# the help: the commands, then the options
help(): text := "wap, the native command of wap's compiler, its commands:\n" + listed(commands()) + "\noptions:\n" + listed(options())
# the usages one a line, each meaning in the meaning column
listed(usages: list<Usage>): text := {
	lines: list<text> = []
	for usage in usages { lines.add("  " + padded(usage.written, MEANING_COLUMN - 2) + usage.meaning) }
	lines.join("\n")
}
# the text with blanks after it up to the width, one blank at least
padded(t: text, width: int): text := {
	filled = t + " "
	while #filled < width { filled = filled + " " }
	filled
}
# which compiler this wap runs, the one beside it
version(): text := "wap, the native command · its compiler ${compiler_path}"
# whether the word is written as an option, `-h` or `--seconds`
is_option(word: text): bool := word.starts_with("-")
# an option no command takes: refused with the options, exit status 2
option_refused(word: text) := {
	eprint("wap: no option ${word}; the options, before the command or file:\n" + listed(options()) + "\nwap help lists the commands")
	exit(2)
}
