# wap.wasm for the native wap (driver.wap): found beside the executable, compiling a source to a module (run.wap runs
# both); a module's machine code, the compiler's too, kept beside it for the next runs (<stem>-<hash>.cwasm, by its
# bytes' hash; another wasmtime's refused, said, and written anew).
use "c.wap"
use "../../types/host.wap"
use "run.wap"
use "linking.wap"

# the compiler compiled to machine code, beside it: wap-<hash>.cwasm; a part written before it takes that name
# (linking.wap PART_SUFFIX)
CACHED_SUFFIX := ".cwasm"
DIGIT_TABLE := "0123456789abcdef"
HEXADECIMAL := 16
# a hash of bytes: a polynomial over their 32-bit words below HASH_RANGE, read a chunk at a time
HASH_BASE := 31
HASH_RANGE := 72057594037927931
CHUNK_BYTES := 4096
# the program compiled to the module by the compiler's module: the file the argument names, or the code given, which the
# compiler reads on its standard input, in the build mode given; whether it was, the compiler's refusal said
compiled(compiler: int, program: text, module: text, code: text = "", mode: text = ""): bool := module_ran(compiler, [compiler_path] + (if mode is empty then [] else [mode]) + [source_named(program, code), module], compiler_path, code)
# how a run names the program, the compiler's and its own: its file's real path (so program.folder is the source's
# folder), or for code given standard input's, so the folder and the files it names are the current folder's
source_named(program: text, code: text): text := if code is empty then program_path(program) else STANDARD_INPUT_PATH

# wap.wasm's hash, which its machine code and every program's are named by
compiler_hash(): int := {
	size_at = host_block(8)
	bytes = file_read(compiler_path, size_at)
	if bytes == 0 then 0 else hash_of(engine_settings_hash(), bytes, long_at(size_at))
}
# the module of the .wasm file at `path`, its machine code kept beside it, <stem>-<hash>.cwasm by the hash of its bytes
# (wap.wasm's: wap-<hash>.cwasm): read from there where this wasmtime wrote it, else compiled and written there for the
# next run; 0 where there is no module, said
module_loaded(path: text): int := {
	size_at = host_block(8)
	bytes = file_read(path, size_at)
	if bytes == 0 { return said_none("wap: no module at ${path}") }
	cache = cache_named(bytes_between(path, 0, byte_count(path) - byte_count(MODULE_SUFFIX)), hash_of(engine_settings_hash(), bytes, long_at(size_at)))
	cached = deserialized(cache)
	if cached != 0 { return cached }
	module = module_of(bytes, long_at(size_at))
	if module != 0 then cache_written(module, cache) else 0
	module
}
# the stem's machine code path, ended by -<hash>.cwasm
cache_named(stem: text, hash: int): text := "${stem}-${digits_of(hash, HEXADECIMAL)}${CACHED_SUFFIX}"
# the module of the machine code at the path; 0 where there is none, or where this wasmtime refuses it (another's), said
deserialized(path: text): int := {
	if access(path, EXISTS) != 0 { return 0 }
	module_at = host_block(8)
	if wasmtime_module_deserialize_file(engine, path, module_at) == 0 then long_at(module_at) else said_none("wap: this machine code is not this wasmtime's, so it is compiled again: ${path}")
}
# the module's machine code written to the path, through a part of its own, so a run reading it never reads half of it
cache_written(module: int, path: text): int := {
	code = host_block(VECTOR_BYTES)
	if wasmtime_module_serialize(module, code) != 0 { return 0 }
	# (mkstemps replaces the part's X's in its own bytes)
	part = path + PART_SUFFIX
	file = mkstemps(part, 0)
	c_write(file, long_at(code + 8), long_at(code))
	close(file)
	rename(part, path)
}
# the engine's settings hashed (run.wap ENGINE_SETTINGS), where every machine code's hash starts
engine_settings_hash(): int := {
	hash = 0
	for setting in ENGINE_SETTINGS { hash = hashed_on(hash, setting) }
	hash
}
# a hash gone on over one more word: the polynomial's step below HASH_RANGE
hashed_on(hash: int, word: int): int := (hash * HASH_BASE + word) % HASH_RANGE
# a hash gone on over these bytes of the host's memory: a polynomial over their 32-bit words below HASH_RANGE
hash_of(start: int, bytes: int, size: int): int := {
	# (a word past the chunk: the last word's bytes past the file are none)
	chunk = text_address(text_made(CHUNK_BYTES + 4))
	hash = start
	at = 0
	while at < size {
		count = if size - at < CHUNK_BYTES then size - at else CHUNK_BYTES
		memcpy(pointer_at(chunk), bytes + at, count)
		set_memory_word(chunk + count, 0)
		i = 0
		while i < count {
			hash = hashed_on(hash, memory_word(chunk + i))
			i += 4
		}
		at += count
	}
	hash
}
# the digits of a count in the base (up to 16)
digits_of(n: int, base: int): text := (if n < base then "" else digits_of(n ÷ base, base)) + bytes_between(DIGIT_TABLE, n % base, n % base + 1)
