# The console of the native wap, `wap` alone (driver.wap): each line read is the source <session>/<n>.wap, which uses
# the modules of the lines before it, 1.wasm to <n-1>.wasm, compiled to <n>.wasm and run once in the session's store,
# linked to their kept instances: a definition stays, an effect happens once, a value is shown. A line that fails or
# defines nothing leaves nothing; the next line is <n> again.
use "c.wap"
use "run.wap"
use "compiler.wap"

# the standard files the console reads and prompts on, the newline
STANDARD_INPUT := 0
STANDARD_OUTPUT := 1
NEWLINE := 10
WAP_SUFFIX := ".wap"
PROMPT := "› "

console(compiler: int, command: text) := {
	global source_file
	global module_file
	# (by its real path: WASI follows no link out of the root, and the temporary folder often is one)
	session = realpath(mkdtemp(temporary_path("/wap-console-XXXXXX")), 0)
	linker = linker_made()
	context = context_made([command])
	lines = 0
	line = line_read()
	while line != "" {
		global source_file = line_path(session, lines + 1, WAP_SUFFIX)
		global module_file = line_path(session, lines + 1, MODULE_SUFFIX)
		source_written(source_file, line, session, lines)
		if compiled(compiler, source_file, module_file) and instance_defined(linker, context, module_file, module_file, yes) { lines = lines + 1 }
		line = line_read()
	}
	for n in 1 upto lines + 2 {
		unlink(line_path(session, n, WAP_SUFFIX))
		unlink(line_path(session, n, MODULE_SUFFIX))
	}
	rmdir(session)
}
# a line of standard input ended by a newline, the prompt shown first on a terminal; "" at the input's end
line_read(): text := {
	if isatty(STANDARD_INPUT) % BOOL_BYTE != 0 { written(STANDARD_OUTPUT, PROMPT) }
	cell = text_made(1)
	line = ""
	got = bytes_read(STANDARD_INPUT, c_text(cell), 1)
	while got > 0 and byte_at(cell, 0) != NEWLINE {
		line = line + cell
		got = bytes_read(STANDARD_INPUT, c_text(cell), 1)
	}
	if got > 0 or line != "" then line + "\n" else ""
}
# <session>/<n><suffix>
line_path(session: text, n: int, suffix: text): text := "${session}/${n}${suffix}"
# the line's source at the path: the line, then a use of each earlier line's module (after it, so what the compiler says of the
# line is of its line 1)
source_written(path: text, line: text, session: text, lines: int) := {
	source = creat(path, FILE_MODE)
	written(source, line)
	for n in 1 upto lines + 1 { written(source, "use \"${line_path(session, n, MODULE_SUFFIX)}\"\n") }
	close(source)
}
