# The console of the native wap, `wap` alone (driver.wap): each line read is the source <session>/<n>.wap, which uses
# the modules of the lines before it, 1.wasm to <n-1>.wasm, but those whose words a later line defined again, compiled to <n>.wasm and run once in the session's store,
# linked to their kept instances: a definition stays, an effect happens once, a value is shown. A line that fails or
# defines nothing leaves nothing; the next line is <n> again.
use "c.wap"
use "run.wap"
use "compiler.wap"
use "editing.wap"

WAP_SUFFIX := ".wap"
PROMPT := "› "

console(compiler: int, command: text) := {
	global source_file
	global module_file
	# (by its real path: WASI follows no link out of the root, and the temporary folder often is one)
	session = realpath(mkdtemp(temporary_path("/wap-console-XXXXXX")), 0)
	linker = linker_made()
	context = context_made([command])
	lines = 0
	# the lines whose modules the next line uses; the words each line defines
	kept: list<int> = []
	words_of: list<list<text>> = []
	history: list<text> = if on_terminal() then history_read() else []
	line = line_read(history)
	while line != "" {
		global source_file = line_path(session, lines + 1, WAP_SUFFIX)
		global module_file = line_path(session, lines + 1, MODULE_SUFFIX)
		source_written(source_file, line, session, kept)
		defined: list<text> = if compiled(compiler, source_file, module_file) then instance_words(linker, context, module_file, module_file, yes) else []
		if defined is not empty {
			lines += 1
			kept = still_kept(kept, words_of, defined) + [lines]
			words_of += [defined]
		}
		line = line_read(history)
	}
	for n in 1 upto lines + 2 {
		unlink(line_path(session, n, WAP_SUFFIX))
		unlink(line_path(session, n, MODULE_SUFFIX))
	}
	rmdir(session)
}
# the kept lines but those defining a word a new line defines again
still_kept(kept: list<int>, words_of: list<list<text>>, defined: list<text>): list<int> := kept.filter(n => not words_of#n.any(word => defined.contains(word)))
# a line of standard input ended by a newline, edited after the prompt on a terminal (editing.wap); "" at the input's end
line_read(history: list<text>): text := {
	if on_terminal() { return edited_line(PROMPT, history) }
	cell = text_made(1)
	line = ""
	got = bytes_read(STANDARD_INPUT, c_text(cell), 1)
	while got > 0 and byte_at(cell, 0) != NEWLINE {
		line += cell
		got = bytes_read(STANDARD_INPUT, c_text(cell), 1)
	}
	if got > 0 or line != "" then line + "\n" else ""
}
# whether the console reads a terminal, where its lines are edited and kept in the history
on_terminal(): bool := isatty(STANDARD_INPUT) % BOOL_BYTE != 0
# <session>/<n><suffix>
line_path(session: text, n: int, suffix: text): text := "${session}/${n}${suffix}"
# the line's source at the path: the line, then a use of each kept earlier line's module (after it, so what the compiler says of the
# line is of its line 1)
source_written(path: text, line: text, session: text, kept: list<int>) := {
	source = creat(path, FILE_MODE)
	written(source, line)
	for n in kept { written(source, "use \"${line_path(session, n, MODULE_SUFFIX)}\"\n") }
	close(source)
}
