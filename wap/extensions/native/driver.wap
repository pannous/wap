# The native wap command (wap/extensions/native, built by build.sh to ~/dev/bin/wap): `wap hello.wap [arguments…]`
# compiles the program with wap.wasm, wap's compiler in wap-seed/ beside this executable with its types module and
# kernel, then runs the module it wrote with the arguments, each a wasm module run by wasmtime's C API with WASI (the
# program's arguments, standard input and output, the current folder and the root). Its exit status is the program's.
# `wap m.wasm [arguments…]` runs a compiled module as it is; `wap test [<area>…]` runs wap's tests instead (tested,
# below); an argument naming no program file is code (program_of); `wap` alone is the console (console.wap).
use "c.wap"
use "run.wap"
use "compiler.wap"
use "console.wap"
use "programs.wap"

# the texts the command names, each a C string in its memory
module_template(): int32 := prim data_address("/wap-XXXXXX.wasm")
MODULE_SUFFIX_BYTES := 5
# code given in place of a program file goes to a file of its own, compiled as a file is
source_template(): int32 := prim data_address("/wap-XXXXXX.wap")
SOURCE_SUFFIX_BYTES := 4
warp_suffix(): int32 := prim data_address(".warp")
# `wap test [<area>…]`: wap's tests in the current folder, test/wap/run.sh, all of them or those of each area
test_word(): int32 := prim data_address("test")
tests_run(): int32 := prim data_address("test/wap/run.sh --wait")
separator(): int32 := prim data_address(" ")
# a wait status's exit code, the byte above its signal's
STATUS_UNIT := 256

# the program's own arguments, by WASI, into its memory: the count; each argument's address
args_sizes_get(count_at: int, bytes_at: int): int := prim args_sizes_get(count_at, bytes_at)
args_get(addresses_at: int, bytes_at: int): int := prim args_get(addresses_at, bytes_at)
argument(at: int): int32 := pointer_at(word_at(ARGUMENTS_AT + 4 * at))

# a new file in the temporary folder, its path at `at` by the template, `suffix_bytes` of it kept; its open descriptor
temporary_made(at: int, template: int32, suffix_bytes: int): int := {
	temporary_path(at, template)
	mkstemps(pointer_at(at), suffix_bytes)
}
# a program file, as warp tells one (core/native/warp.warp is_warp_file): its name ends in .wap or .warp, or a file of
# that name is there; any other argument is code
is_program_file(name: int32): bool := ends_in(name, wap_suffix()) or ends_in(name, warp_suffix()) or realpath(name, 0) != 0
# the program the argument names: the file, or the code written to a file of its own at SOURCE_AT
program_of(argument: int32): int32 := if is_program_file(argument) then argument else {
	source = temporary_made(SOURCE_AT, source_template(), SOURCE_SUFFIX_BYTES)
	written(source, host_of(argument))
	close(source)
	pointer_at(SOURCE_AT)
}

# the tests of the areas named after `test`, run by test/wap/run.sh; its exit status is this run's
tested(count: int) := {
	set_word(COMMAND_AT, 0)
	strcat(pointer_at(COMMAND_AT), host_of(tests_run()))
	i = 2
	while i < count {
		strcat(pointer_at(COMMAND_AT), host_of(separator()))
		strcat(pointer_at(COMMAND_AT), host_of(argument(i)))
		i = i + 1
	}
	exit(system(pointer_at(COMMAND_AT)) ÷ STATUS_UNIT)
}

args_sizes_get(ARGUMENT_COUNT_AT, ARGUMENT_BYTES_COUNT_AT)
args_get(ARGUMENTS_AT, ARGUMENT_BYTES_AT)
count = word_at(ARGUMENT_COUNT_AT)
if count > 1 and strcmp(argument(1), test_word()) == 0 { tested(count) }
compiler_found()
if count < 2 {
	console(module_loaded(pointer_at(COMPILER_AT), CACHE_AT))
	exit(0)
}
# a compiled module, `wap m.wasm [arguments…]`: run as it is, its arguments from its file on
if ends_in(argument(1), module_suffix()) {
	if not module_ran(module_loaded(argument(1), PROGRAM_CACHE_AT), count - 1, host_list(ARGUMENTS_AT + 4, count - 1), host_of(argument(1))) { ended(word_at(STATUS_AT)) }
	ended(0)
}
close(temporary_made(MODULE_AT, module_template(), MODULE_SUFFIX_BYTES))
program = program_of(argument(1))
# the program's module, compiled or kept from an earlier run; then run: the module, the program's arguments after its
# file
module = program_module(program, compiler_hash())
if module == 0 { ended(word_at(STATUS_AT)) }
set_word(ARGUMENTS_AT + 4, MODULE_AT)
if not module_ran(module, count - 1, host_list(ARGUMENTS_AT + 4, count - 1), program_path(program)) { ended(word_at(STATUS_AT)) }
# (an exit, not a value: the program shows none, so its module holds no text)
ended(0)
