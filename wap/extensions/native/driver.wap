# The native wap command (wap/extensions/native, built by build.sh to ~/dev/bin/wap): `wap hello.wap [arguments…]`
# compiles the program with wap.wasm, wap's compiler in wap-seed/ beside this executable with its types module and
# kernel, then runs the module it wrote with the arguments, each a wasm module run by wasmtime's C API with WASI (the
# program's arguments, standard input and output, the current folder and the root). Its exit status is the program's.
# `wap m.wasm [arguments…]` runs a compiled module as it is; `wap test [<area>…]` runs wap's tests instead (tested,
# below); an argument naming no program file is code (program_of); `wap` alone is the console (console.wap). The
# commands and options are one table, commands.wap, which `wap help` lists
use foreign
use "c.wap"
use "../../types/host.wap"
use "run.wap"
use "linking.wap"
use "compiler.wap"
use "console.wap"
use "programs.wap"
use "host_words.wap"
use "commands.wap"

# a C function a module the command runs imports, called through wasmtime (host_words.wap); exported here, as only
# the program's own functions are exports
host_word(word: int, caller: int, given: int, count: int, results: int, results_count: int) := host_word_answered(word, caller, given, count, results, results_count)
# C calling back a function the module handed it (lib/native/callbacks.h's trampolines call this export, which a
# program built natively answers itself, lib/callbacks.wap)
c_callback_fired(slot: int, a: int, b: int, c: int, d: int, e: int, f: int): int := callback_answered(slot, a, b, c, d, e, f)
# the module a program compiles to, a temporary file of this template, its suffix kept
MODULE_TEMPLATE := "/wap-XXXXXX.wasm"
# `wap test [<area>…]`: wap's tests in the current folder, test/wap/run.sh, all of them or those of each area
TESTS_RUN := "test/wap/run.sh --wait"
# `wap build <program.wap>`: the program as a native executable named as it, by wap's build script in the current
# folder, as the tests; it builds programs that use no GC value
BUILD_RUN := "wap/extensions/native/build.sh"
# `wap verify <program.wap>`: the verify tool in the seed folder, run by this wap on the program, told the seed folder,
# whose wap folder it reads (wap/extensions/proof/verify/options.wap)
VERIFY_PART := "verify.wasm"
# `wap check [--strict] <program.wap>`: the check tool beside it, run the same way, its lines and exit status the run's
CHECK_PART := "check.wasm"
SEED_OPTION := "--seed"
# the compiler's command that compiles a program's laws into functions (wap/compiler.wap), the verdicts of the kernel
# and of the run each written to a temporary file of this template, and how a verdict line reads
LAWS_COMMAND := "laws"
VERDICTS_TEMPLATE := "/wap-verdicts-XXXXXX.txt"
VERDICTS_SUFFIX := ".txt"
# the verify program's option naming where it writes the rules of the laws with hypotheses, wap source the compiler
# reads, each run's in a temporary file of this template
RUN_RULES_OPTION := "--run-rules"
RULES_TEMPLATE := "/wap-hypotheses-XXXXXX.wap"
RULES_SUFFIX := ".wap"
VERDICT_SEPARATOR := ": "
# how a verdict names the axioms it rests on (extensions/proof/verify/verify.wap), and the kernel's folder in the seed
# folder
RESTS_ON := ", rests on "
KERNEL_FOLDER := "kernel"
# the types module's folder in the seed folder, and how a library function claims the kernel's definition of it agrees
# with its body (`@kernel(list.count)`)
TYPES_FOLDER := "types"
KERNEL_CLAIM := "@kernel("
TESTED_VERDICT := "Tested"
UNTESTED_VERDICT := "Untested"
FAILED_VERDICT := "FAILED"
VERDICT_WORDS := ["Proved", TESTED_VERDICT, FAILED_VERDICT, UNTESTED_VERDICT, "Assumed", "Axiom"]
# what an option word of `wap build` starts with, the program's file the word without it
OPTION_START := "--"
WAP_SUFFIX := ".wap"
# a wait status's exit code, the byte above its signal's
STATUS_UNIT := 256

# the command line by WASI: the command, the program, its arguments, read into new memory of their own (system.wap's
# arguments() reads them from BYTES_AT, into the words run.wap keeps past it, and maps, which a native build takes not)
command_line(): list<text> := {
	args_sizes_get(ARGUMENT_COUNT_AT, ARGUMENT_BYTES_COUNT_AT)
	addresses = text_address(text_made(4 * memory_word(ARGUMENT_COUNT_AT)))
	args_get(addresses, text_address(text_made(memory_word(ARGUMENT_BYTES_COUNT_AT))))
	words: list<text> = []
	for i in 0 upto memory_word(ARGUMENT_COUNT_AT) { words.add(c_text_from(host_of(pointer_at(memory_word(addresses + 4 * i))))) }
	words
}
# the text, then the list's items from item `from` (from 1) on
followed(first: text, xs: list<text>, from: int): list<text> := {
	joined = [first]
	for i in from upto #xs + 1 { joined.add(xs#i) }
	joined
}

# a new file in the temporary folder by the template, `suffix_bytes` of it kept; its path
temporary_made(template: text, suffix: text): text := {
	path = temporary_path(template)
	close(mkstemps(path, byte_count(suffix)))
	path
}
# a program file, as warp tells one (core/native/warp.warp is_warp_file): its name ends in .wap or .warp, or a file of
# that name is there; any other argument is code
is_program_file(name: text): bool := name.ends_with(WAP_SUFFIX) or name.ends_with(".warp") or realpath(name, 0) != ""
# the code an argument gives in place of a program file, which the compiler reads on its standard input: standard
# input's own for `-`; "" for a file
code_of(argument: text): text := if argument == STANDARD_INPUT_PATH then input_rest() else if is_program_file(argument) then "" else argument

# the tests of the areas named after `test`, run by test/wap/run.sh; its exit status is this run's
tested(words: list<text>) := script_ran(followed(TESTS_RUN, words, 2))
# the program's obligations left to the run, listed by the check tool (wap/extensions/proof/verify/check.wap)
check_ran(words: list<text>) := exit(if system("'${executable_path}' '${seed_part(CHECK_PART)}' ${SEED_OPTION} '${seed_part("")}' ${words.drop(1).map(word => "'${word}'").join(" ")}") == 0 then 0 else 1)
# the program's laws verified (laws_checked), each verdict a line, what was said beside them on standard error; the run
# exits 1 when a law fails
verified(words: list<text>) := {
	checked = laws_checked(words#2)
	for line in checked.said { eprint(line) }
	for line in checked.verdicts { print line }
	exit(if checked.verdicts.any(line => line.contains(VERDICT_SEPARATOR + FAILED_VERDICT)) then 1 else 0)
}
# `wap trust [<file.wap>]` (wiki/cli.md "Proofs"): what a verdict rests on, the kernel's files, which check every
# proof, the library's kernel claims (each a function whose body the kernel's definition must agree with), then the
# axioms the program's laws rest on, each once, read off their verdicts
trust_listed(words: list<text>) := {
	kernel = seed_files(KERNEL_FOLDER)
	if kernel is empty { eprint("wap trust: ${seed_part("")} holds no kernel sources to list") }
	for file in kernel { print file }
	for claim in kernel_claims() { print claim }
	if #words < 2 { return }
	for axiom in laws_checked(words#2).verdicts.flat_map(rested_on).unique() { print axiom }
}
# the wap files of a folder in the seed folder, as "<folder>/<name>", sorted
seed_files(folder: text): list<text> := {
	path = "${seed_part("")}/${folder}"
	if exists(path) then list_files(path).filter(name => name.ends_with(WAP_SUFFIX)).sorted().map(name => "${folder}/${name}") else []
}
# "<name> (types/<file>.wap)" for every `@kernel(<name>)` the types module's files hold
kernel_claims(): list<text> := seed_files(TYPES_FOLDER).flat_map(file => read("${seed_part("")}/${file}").split("\n").filter(line => line.contains(KERNEL_CLAIM)).map(line => "${line.split(KERNEL_CLAIM).last.split(")")#1} (${file})"))
rested_on(verdict: text): list<text> := if verdict.contains(RESTS_ON) then verdict.split(RESTS_ON).last.split(", ") else []
# What checking a program's laws found: the verify program's verdicts, the kernel's, joined with those of the laws run
# (the program compiled by the compiler's laws command and its laws called, run.wap laws_ran, never its main), then the
# laws of each module it uses by their stamps (wap build --wasm writes them); and what was said beside: the theory's
# refusal, and why the laws did not run where a law needed the run, one left Untested or none given a verdict
class LawsChecked { verdicts: list<text>; said: list<text> }
laws_checked(program: text): LawsChecked := {
	proved = temporary_made(VERDICTS_TEMPLATE, VERDICTS_SUFFIX)
	ran = temporary_made(VERDICTS_TEMPLATE, VERDICTS_SUFFIX)
	module = temporary_made(MODULE_TEMPLATE, MODULE_SUFFIX)
	compiling = temporary_made(VERDICTS_TEMPLATE, VERDICTS_SUFFIX)
	# the rules the run reads the laws with hypotheses by, written by the verify program from its typing
	hypotheses = temporary_made(RULES_TEMPLATE, RULES_SUFFIX)
	system("'${executable_path}' '${seed_part(VERIFY_PART)}' ${SEED_OPTION} '${seed_part("")}' ${RUN_RULES_OPTION} '${hypotheses}' '${program}' >'${proved}'")
	compiled = system("'${executable_path}' '${compiler_path}' ${LAWS_COMMAND} '${program}' '${module}' '${hypotheses}' 2>'${compiling}'") == 0
	laws = if compiled then module_compiled(module) else 0
	if laws != 0 { laws_ran(laws, program, ran) }
	kernel = lines_of(file_text(proved))
	shown = verdicts_joined(kernel, lines_of(file_text(ran)))
	unran = not compiled and (shown is empty or shown.any(line => line.ends_with(VERDICT_SEPARATOR + UNTESTED_VERDICT)))
	said = kernel.filter(line => verdict_read(line) == ø) + (if unran then [file_text(compiling)] else [])
	used = if laws == 0 then [] else imported_modules(laws).map(name => module_path(name, program))
	stamped = used.filter(path => path != "" and not path.starts_with(seed_part(""))).flat_map(stamps_of)
	for path in [proved, ran, module, compiling, hypotheses] { unlink(path) }
	LawsChecked(shown + stamped, said)
}
# the laws of a module the program uses, one of its own and not wap's (the library in the seed folder), by their
# stamps, its section's lines; a module without the section was never checked, so its laws are Untested
stamps_of(path: text): list<text> := {
	stamps = section_text(path, LAWS_SECTION)
	if stamps is empty then [path.split("/").last + VERDICT_SEPARATOR + UNTESTED_VERDICT] else lines_of(stamps)
}
# a law's verdict as `wap verify` prints it, `positive: Tested`
class Verdict { law: text; said: text }
# the verdict a line says, ø for a line that says none, a refusal
verdict_read(line: text): Verdict? := {
	parts = line.split(VERDICT_SEPARATOR)
	said = parts.drop(1).join(VERDICT_SEPARATOR)
	if VERDICT_WORDS.any(word => said.starts_with(word)) then Verdict(parts#1, said) else ø
}
# the kernel's verdict of each law, and beside it the run's: a run that failed says so whatever the kernel says (a
# Proved law that fails when it runs shows its translation is wrong), one that held makes an Untested law Tested; a law
# only the run gave a verdict, the theory having refused it, keeps its place. In the program's order, the run's, then
# the laws only the kernel gave a verdict
verdicts_joined(kernel: list<text>, run: list<text>): list<text> := {
	proved = kernel.map(verdict_read).compact()
	tried = run.map(verdict_read).compact()
	shown = tried.map(trial => Verdict(trial.law, verdict_beside(proved.find(verdict => verdict.law == trial.law), trial)))
	(shown + proved.filter(verdict => not tried.any(trial => trial.law == verdict.law))).map(verdict => verdict.law + VERDICT_SEPARATOR + verdict.said)
}
verdict_beside(proved: Verdict?, tried: Verdict): text := if proved is ø or tried.said.starts_with(FAILED_VERDICT) or proved!.said in [UNTESTED_VERDICT, TESTED_VERDICT] then tried.said else proved!.said
# the lines of a text, its empty ones left out
lines_of(t: text): list<text> := t.split("\n").filter(line => not line is empty)
# `wap format <program.wap>`, the program in canonical spelling, the compiler's own command of that name
FORMAT_COMMAND := "format"
CHECK_COMMAND := "check"
compiler_ran(command: text, words: list<text>) := module_file_ran([words#1, compiler_path, command] + words.drop(1))
# `wap format check <file.wap>` lists the lines the format would change, the file formatted into a temporary file of
# this template
FORMATTED_TEMPLATE := "/wap-formatted-XXXXXX.wap"
formatted(words: list<text>) := if words#2 == CHECK_COMMAND then format_checked(words#3) else compiler_ran(FORMAT_COMMAND, words)
# each line of the file the format would change, `app.wap:3: layout: <the line formatted>`; the run exits 1 if any
# would, else 0
format_checked(file: text) := {
	canonical = temporary_made(FORMATTED_TEMPLATE, WAP_SUFFIX)
	if system("'${executable_path}' '${compiler_path}' ${FORMAT_COMMAND} '${file}' >'${canonical}'") != 0 { exit(1) }
	written = file_text(file).split("\n")
	wanted = file_text(canonical).split("\n")
	unlink(canonical)
	changed = (0 upto max(#written, #wanted)).filter(at => line_at(written, at) != line_at(wanted, at))
	for at in changed { print "${file}:${at + 1}: layout: ${line_at(wanted, at)}" }
	exit(if changed is empty then 0 else 1)
}
# the line at the place, "" past the last
line_at(lines: list<text>, at: int): text := if at < #lines then lines[at] else ""
# the program built by the compiler this wap runs
built(words: list<text>) := {
	given = words.drop(1)
	options = given.filter(word => word.starts_with(OPTION_START))
	program = given.find(word => not word.starts_with(OPTION_START)) ?? ""
	if not program.ends_with(WAP_SUFFIX) { eprint("wap build takes a .wap file: wap build app.wap makes app"); exit(2) }
	base = bytes_between(program, 0, byte_count(program) - byte_count(WAP_SUFFIX))
	if options.contains(WASM_OPTION) { return wasm_built(program, base, trim_passes(options)) }
	script_ran([BUILD_RUN, compiler_path, program, base])
}
# the program compiled into app.mod.wasm, linked with the modules it uses into app.full.wasm, trimmed into app.wasm
wasm_built(program: text, base: text, passes: text) := {
	module = base + MOD_ENDING
	if not module_ran(module_loaded(compiler_path), [compiler_path, program, module], compiler_path) { exit(1) }
	# the program first, so its exports (main, warp/start, memory) keep their names; a module's clashing ones are renamed
	merged = linked_modules(module, [Linked(module, PROGRAM_NAME)]).map(linked => "'${linked.path}' '${linked.name}'").join(" ")
	full = base + FULL_ENDING
	if system("wasm-merge ${BINARYEN_FEATURES} -g ${merged} --rename-export-conflicts -o '${full}'") != 0 or system("wasm-opt ${BINARYEN_FEATURES} -g ${passes} '${full}' -o '${base}${MODULE_SUFFIX}'") != 0 {
		eprint(BINARYEN_MISSING)
		exit(1)
	}
	# app.wasm, compiled for others to use, carries its laws' verdicts, checked once here: a use never checks them again
	section_added(base + MODULE_SUFFIX, LAWS_SECTION, laws_checked(program).verdicts.join("\n"))
	# a linked module imports no module, so it names no folder to find one in
	for linked in [full, base + MODULE_SUFFIX] { section_dropped(linked, LIBRARY_SECTION) }
}
# wasm-opt's passes for the build's --trim, all of them where it has none
trim_passes(options: list<text>): text := {
	trim = options.find(option => option.starts_with(TRIM_OPTION)) ?? return TRIMMED
	passes = TRIM_PASSES.get(trim[byte_count(TRIM_OPTION) ..])
	if passes == ø {
		eprint("wap build --wasm trims all by default, or --trim=${TRIM_PASSES.keys.join(" or --trim=")}: ${trim}")
		exit(2)
	}
	passes!
}
# the command run; its exit status is this run's
script_ran(command: list<text>) := exit(system(command.join(" ")) ÷ STATUS_UNIT)

# the command line with the run's options taken off it, each before the program: its caps, `--memory-gb <n>`,
# `--seconds <n>` (run.wap memory_cap_gb, time_cap_seconds); the options told to the programs it runs, `--no-window`
# as a line `no-window=yes` (main.c run_options), which also stops a window or sound device opened (run.wap windowless)
options_taken(given: list<text>): list<text> := {
	global memory_cap_gb
	global time_cap_seconds
	global windowless
	words = given
	told = ""
	while (#words > 1 and is_told_option(words#2)) or (#words > 2 and is_cap_option(words#2)) {
		option = canonical_option(words#2)
		if option != words#2 { eprint("got it: ${words#2} is ${option}") }
		if option == MEMORY_OPTION { memory_cap_gb = cap_given(words) }
		else if option == SECONDS_OPTION { time_cap_seconds = cap_given(words) }
		else {
			told = told + bytes_between(option, 2, byte_count(option)) + "=yes\n"
			windowless = windowless or option == NO_WINDOW_OPTION
		}
		words = followed(words#1, words, if is_told_option(option) then 3 else 4)
	}
	wap_run_options_set(told)
	words
}
# the whole number a cap option is given, a value of any other form refused: `--seconds 1x` stops the run
cap_given(words: list<text>): int := {
	if not is_digits(words#3) { eprint("wap: ${words#2} takes a whole number, not ${words#3}"); exit(2) }
	atol(words#3)
}

# what the command's action does with the command line, which holds the command's word no more (`wap run f.wap` is
# `wap f.wap`)
ran(action: Action, words: list<text>) := match action {
	Action.Help => print(help())
	Action.Version => print(version())
	Action.Console => console_started(words)
	Action.Build => built(words)
	Action.Test => tested(words)
	Action.Verify => verified(words)
	Action.Format => formatted(words)
	Action.Check => check_ran(words)
	Action.Trust => trust_listed(words)
	Action.Module => module_file_ran(words)
	Action.Program => program_ran(words)
}
# the console, on a terminal after the version, as warp's console starts
console_started(words: list<text>) := {
	if on_terminal() { print(version()) }
	console(module_loaded(compiler_path), words#1)
}
# a compiled module, `wap m.wasm [arguments…]`: run as it is, its arguments from its file on
module_file_ran(words: list<text>) := {
	global run_input = words#2
	if not module_ran(module_loaded(words#2), followed(words#2, words, 3), words#2) { ended(memory_word(STATUS_AT)) }
}
# the program's module, compiled or kept from an earlier run; then run: the module, the program's arguments after its
# name (source_named), which is its first
program_ran(words: list<text>) := {
	global run_input = words#2
	global module_file = temporary_made(MODULE_TEMPLATE, MODULE_SUFFIX)
	code = code_of(words#2)
	module = program_module(words#2, compiler_hash(), code)
	if module == 0 { ended(memory_word(STATUS_AT)) }
	named = source_named(words#2, code)
	if not module_ran(module, followed(named, words, 3), named) { ended(memory_word(STATUS_AT)) }
}

# the library beside the compiler, told to the programs this run runs
wap_library_folder_set(seed_part(LIBRARY_PART))
words = options_taken(command_line())
# `wap` alone is the console
command = if #words < 2 then row_doing(Action.Console) else command_of(words#2)
ran(command.action, if command.words is empty then words else followed(words#1, words, 3))
# (an exit, not a value: the program shows none, so its module holds no text)
ended(0)
