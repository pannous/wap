# The console's line on a terminal (console.wap line_read), as warp's console edits it (core/native/warp.warp
# edited_line): the terminal gives a key at a time without echo while the line is edited; ←/→ move the cursor over a
# character's UTF-8 bytes whole, Alt+←/→ (or Alt+B/F) a word; Home/End or Ctrl+A/E go to the line's start and end;
# ⌫ deletes before the cursor, Delete under it, Alt+⌫ the word before it, Alt+Delete (or Alt+D) the word after it;
# ↑/↓ step through the lines typed before, the earlier consoles' too (HISTORY_FILE); Ctrl+C drops the line, and on
# an empty line a second Ctrl+C ends the console, as Ctrl+D does.
use foreign
use "c.wap"
use "run.wap"

# the standard files the console reads and prompts on, the newline
STANDARD_INPUT := 0
STANDARD_OUTPUT := 1
NEWLINE := 10
# the terminal's modes: a key at a time, unechoed, Ctrl+C a key (while a line runs a signal again)
KEYS_MODE := "stty -icanon -echo -isig min 1"
LINES_MODE := "stty icanon echo isig"
# where the lines typed on a terminal stay for the next console, below the home folder
HISTORY_FILE := "/.wap_history"
APPENDING := "a"
EMPTY_LINE_INTERRUPTED := "\n(Ctrl+C again or Ctrl+D to exit)\n"
LINE_INTERRUPTED := "^C\n"
# the keys that end the line, drop it, end the input; a typed character's first byte is at least a space
RETURN := "\r"
INTERRUPT := "\x03"
END_OF_INPUT := "\x04"
SPACE := 32
# a control sequence's numbers and their separator, the bytes 0 to ; between ESC [ or ESC O and its final byte
DIGIT_ZERO := 48
SEMICOLON := 59
# a UTF-8 byte that continues a character is 10xxxxxx
CONTINUATION_UNIT := 64
CONTINUATION := 2

# the edits a key asks for: a move of the cursor, a deletion from it to where that move would reach, a step through
# the history
enum Edit { Typed, Left, Right, Up, Down, Start, End, WordLeft, WordRight, Back, Delete, WordBefore, WordAfter }

# the line edited on the terminal after the prompt, and its newline, as console.wap line_read gives a line; "" at the input's end.
# The history is the lines typed before, the line added to it
edited_line(prompt: text, history: list<text>): text := {
	system(KEYS_MODE)
	# (the prompt once the terminal gives keys: what is typed after it is edited, never echoed by the terminal)
	written(STANDARD_OUTPUT, prompt)
	line = ""
	at = 0
	back = 0
	interrupted = no
	known = known_keys()
	typed = key()
	while typed != RETURN and typed != "\n" and typed != "" and not (typed == END_OF_INPUT and line == "") and not (typed == INTERRUPT and interrupted) {
		edit = edit_of(typed, known)
		interrupted = typed == INTERRUPT and line == ""
		if typed == INTERRUPT {
			written(STANDARD_OUTPUT, if interrupted then EMPTY_LINE_INTERRUPTED else LINE_INTERRUPTED)
			line = ""
			at = 0
			back = 0
		}
		if (edit == Up and back < #history) or (edit == Down and back > 0) {
			back = if edit == Up then back + 1 else back - 1
			line = if back == 0 then "" else history#(#history + 1 - back)
			at = byte_count(line)
		}
		if edit == Typed and byte_at(typed, 0) >= SPACE {
			line = spliced(line, at, at, typed)
			at += byte_count(typed)
		}
		reached = reached_by(line, at, edit)
		if edit == Back or edit == Delete or edit == WordBefore or edit == WordAfter {
			line = spliced(line, min(at, reached), max(at, reached), "")
			reached = min(at, reached)
		}
		at = reached
		redrawn(prompt, line, at)
		typed = key()
	}
	system(LINES_MODE)
	written(STANDARD_OUTPUT, "\n")
	if typed != RETURN and typed != "\n" { return "" }
	if line != "" { history_added(history, line) }
	line + "\n"
}
# the next key the terminal gives, its bytes: one, or ESC and the key after it (ESC ESC and one more, iTerm's Alt with
# an arrow), a control sequence ESC [ or ESC O with its numbers up to its final byte; "" at the input's end
key(): text := {
	c = byte()
	typed = if c < 0 then "" else byte_text(c)
	while typed == "\e" or typed == "\e\e" { typed += byte_text(byte()) }
	# (ESC O, the terminal's application mode, sends what ESC [ does)
	if typed == "\eO" { typed = "\e[" }
	if typed == "\e[" or typed == "\e\e[" {
		c = byte()
		while c >= DIGIT_ZERO and c <= SEMICOLON {
			typed += byte_text(c)
			c = byte()
		}
		typed += byte_text(c)
	}
	typed
}
# the next byte the terminal gives, -1 at its end
byte(): int := {
	cell = text_made(1)
	if bytes_read(STANDARD_INPUT, c_text(cell), 1) <= 0 then -1 else byte_at(cell, 0)
}
# a key as a terminal sends it and the edit it asks for
class Key { sequence: text, edit: Edit }
# the keys as macOS Terminal, iTerm and xterm send them: the arrows and Home/End as ESC [ sequences, ESC [ <number> ~
# for Home 1 or 7, Delete 3, End 4 or 8; Alt as ESC before a key or as the ;3 modifier
known_keys(): list<Key> := [
	Key("\e[D", Left),
	Key("\e[C", Right),
	Key("\e[A", Up),
	Key("\e[B", Down),
	Key("\x01", Start),
	Key("\e[H", Start),
	Key("\e[1~", Start),
	Key("\e[7~", Start),
	Key("\x05", End),
	Key("\e[F", End),
	Key("\e[4~", End),
	Key("\e[8~", End),
	Key("\eb", WordLeft),
	Key("\e[1;3D", WordLeft),
	Key("\e\e[D", WordLeft),
	Key("\ef", WordRight),
	Key("\e[1;3C", WordRight),
	Key("\e\e[C", WordRight),
	Key("\x7f", Back),
	Key("\x08", Back),
	Key("\e[3~", Delete),
	Key("\e\x7f", WordBefore),
	Key("\e\x08", WordBefore),
	Key("\ed", WordAfter),
	Key("\e[3;3~", WordAfter)
]
# the edit a key asks for among the keys, Typed for a character
edit_of(typed: text, known: list<Key>): Edit := {
	for k in known { if k.sequence == typed { return k.edit } }
	Typed
}
# where an edit takes the cursor; a deletion's the place its move reaches
reached_by(line: text, at: int, edit: Edit): int := {
	if edit == Start { return 0 }
	if edit == End { return byte_count(line) }
	step = if edit == Left or edit == Back or edit == WordLeft or edit == WordBefore then -1 else 1
	if edit == Left or edit == Right or edit == Back or edit == Delete { return character_edge(line, at, step) }
	if edit == WordLeft or edit == WordRight or edit == WordBefore or edit == WordAfter { return word_edge(line, at, step) }
	at
}

# --- the line's text ---
# the line with its bytes from start until stop replaced by a text
spliced(line: text, start: int, stop: int, put: text): text := bytes_between(line, 0, start) + put + bytes_between(line, stop, byte_count(line))
# whether a step from at stays in the line; the byte it passes over
stays(line: text, at: int, step: int): bool := if step < 0 then at > 0 else at < byte_count(line)
passed(line: text, at: int, step: int): int := byte_at(line, if step < 0 then at - 1 else at)
# where a step from at ends past a word: past the blanks first, then the word's bytes
word_edge(line: text, from: int, step: int): int := {
	at = from
	while stays(line, at, step) and passed(line, at, step) == SPACE { at += step }
	while stays(line, at, step) and passed(line, at, step) != SPACE { at += step }
	at
}
# where a step from at ends past one character, its continuing bytes with it
character_edge(line: text, from: int, step: int): int := {
	at = if stays(line, from, step) then from + step else from
	while at > 0 and at < byte_count(line) and continues(line, at) { at += step }
	at
}
continues(line: text, at: int): bool := byte_at(line, at) ÷ CONTINUATION_UNIT == CONTINUATION
# the prompt and the line written anew, the rest of the terminal's line cleared, the cursor moved back over the
# characters after it
redrawn(prompt: text, line: text, at: int) := {
	characters_after = 0
	for i in at upto byte_count(line) { if not continues(line, i) { characters_after += 1 } }
	back = if characters_after > 0 then "\e[${characters_after}D" else ""
	written(STANDARD_OUTPUT, "\r" + prompt + line + "\e[K" + back)
}

# --- the history: the lines typed before, one a line of HISTORY_FILE ---
history_path(): text := getenv("HOME") + HISTORY_FILE
# the history's lines, read once for the console; a file it cannot write is said then, once
history_read(): list<text> := {
	appending = fopen(history_path(), APPENDING)
	if appending == 0 { eprint("wap: history not kept: can't write ${history_path()}") } else { fclose(appending) }
	size_at = host_block(8)
	block = file_read(history_path(), size_at)
	all = if block == 0 then "" else c_copied(block, long_at(size_at))
	# (each line ends in a newline: the part after the last one is no line)
	lines = all.split("\n")
	lines.remove_at(#lines - 1)
	lines
}
# a line added to the history and appended to its file
history_added(history: list<text>, line: text) := {
	file = fopen(history_path(), APPENDING)
	# (a file it cannot open history_read said once: the history stays this console's)
	if file != 0 {
		fputs(line + "\n", file)
		fclose(file)
	}
	history.add(line)
}
