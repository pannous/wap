# Where the native wap finds a module another one imports by name (wap/extensions/native, run.wap links it), as a
# dynamic linker looks: beside the importing module, else in the folder of the compiler that built the importer, which
# the compiler records in it as rpath is recorded (custom section "wap.compiler", extensions/wasm/library.wap), else
# beside the installed compiler. A program so finds the types module of the compiler that built it, whichever ran.
use "c.wap"
use "run.wap"

COMPILER_SECTION := "wap.compiler"
COMPILER_BESIDE := "wap-seed/wap.wasm"
# macOS's longest path, which dyld writes this executable's into
PATH_BYTES := 1024
# a wasm file: its magic and version before the sections; a custom section's id; a LEB128 byte's payload and its
# continuation bit
WASM_HEADER_BYTES := 8
CUSTOM_SECTION := 0
LEB_PAYLOAD := 128

# the path of the module a name names: a bare name (no slash) beside the importing module at its path, else in the
# compiler folder the importer records, else beside the installed compiler; any other name is its path; "" where
# neither place has it, said
module_path(name: text, importer: text): text := {
	if name.contains("/") { return name }
	near = beside(importer, name)
	if access(near, EXISTS) == 0 { return near }
	recorded = recorded_folder(importer)
	far = beside(if recorded == "" then compiler_path else recorded, name)
	if access(far, EXISTS) == 0 { return far }
	eprint("wap: no module at ${near} nor at ${far}")
	""
}

# the folder the module at the path records as its compiler's, ending in a slash; "" where it records none
recorded_folder(path: text): text := {
	size_at = host_block(8)
	bytes = file_read(path, size_at)
	if bytes == 0 { return "" }
	at = bytes + WASM_HEADER_BYTES
	while at < bytes + long_at(size_at) {
		id = host_byte(at)
		size = leb_at(at + 1)
		content = leb_end(at + 1)
		if id == CUSTOM_SECTION and c_copied(leb_end(content), leb_at(content)) == COMPILER_SECTION {
			name_end = leb_end(content) + leb_at(content)
			return c_copied(name_end, content + size - name_end) + "/"
		}
		at = content + size
	}
	""
}
# the unsigned LEB128 number at the host's address; where the bytes after it start
leb_at(at: int): int := if host_byte(at) < LEB_PAYLOAD then host_byte(at) else host_byte(at) - LEB_PAYLOAD + LEB_PAYLOAD * leb_at(at + 1)
leb_end(at: int): int := if host_byte(at) < LEB_PAYLOAD then at + 1 else leb_end(at + 1)
# this executable's path (Linux's link, else macOS's dyld), its links followed (a link to it finds the wap-seed/ beside
# the file itself, and WASI reads no path through a link to a place outside), with its file name replaced by the
# compiler's
compiler_found(): text := {
	own = realpath("/proc/self/exe", 0)
	if own == "" {
		written = text_made(PATH_BYTES)
		set_word(SIZE_AT, PATH_BYTES)
		_NSGetExecutablePath(written, host_of(pointer_at(SIZE_AT)))
		own = realpath(written, 0)
	}
	folder_part(own) + COMPILER_BESIDE
}
compiler_path = compiler_found()
