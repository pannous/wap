# Where the native wap finds a module another one imports by name (wap/extensions/native, run.wap links it), the name
# the compiler resolved when it compiled the importer (extensions/wasm/library.wap, the library by the path the compiler
# wrote it to): a path, beside the importing module unless it starts at the root. Nothing else is searched: a module
# not there is said, never guessed.
use foreign
use "c.wap"
use "../../types/host.wap"
use "run.wap"

# wap's parts, in the seed folder beside this executable: the compiler, its library folder, the tools it runs
# (scripts/lib/wap-beside.sh WAP_TOOLS)
SEED_FOLDER := "wap-seed/"
COMPILER_PART := "wap.wasm"
LIBRARY_PART := "lib"
# where a seed built into this executable (build.sh --standalone) is unpacked, under the user's home: a folder by its
# name, each unpacking through a part of its own; the archive written there for tar
CACHE_FOLDER := "/Library/Caches/wap/"
PART_SUFFIX := ".XXXXXX"
SEED_ARCHIVE := "/seed.tar"
# macOS's longest path, which dyld writes this executable's into
PATH_BYTES := 1024
# a wasm file: its magic and version before the sections; a custom section's id; a LEB128 byte's payload and its
# continuation bit
WASM_HEADER_BYTES := 8
CUSTOM_SECTION := 0
LEB_PAYLOAD := 128
# the custom section of a module naming the folder of the library it imports by file name (extensions/wasm/modules.wap)
LIBRARY_SECTION := "wap.library"
# the custom section of a module wap build --wasm compiled for others: its laws' verdicts, a line each, as wap verify
# prints them
LAWS_SECTION := "wap.laws"

# `wap build --wasm app.wap` (wiki/cli.md): app.mod.wasm the program as compiled, app.full.wasm it and every module it
# imports by a .wasm name linked into one by Binaryen's wasm-merge, which needs no loader, app.wasm that one trimmed
WASM_OPTION := "--wasm"
MOD_ENDING := ".mod.wasm"
FULL_ENDING := ".full.wasm"
# Binaryen's features; its compact import section and custom descriptors left out, which wasmtime does not read yet
# (drop each once it does)
BINARYEN_FEATURES := "--all-features --disable-compact-imports --disable-custom-descriptors"
# app.wasm's trim, wasm-opt's passes: all of them by default, `--trim=unused` only drops what nothing reaches,
# `--trim=none` keeps the module as linked
TRIM_OPTION := "--trim="
TRIMMED := "-O2"
TRIM_PASSES := {"unused": "--remove-unused-module-elements", "none": ""}
# the name the program itself is merged under, which nothing imports
PROGRAM_NAME := "program"
BINARYEN_MISSING := "wap build --wasm: linking or trimming failed; it runs Binaryen's wasm-merge and wasm-opt (brew install binaryen)"

# the path of the module a name names, beside the importing module unless it starts at the root, else the file of
# its name beside the importer (a seed's tools and its modules move together), else in the folder of the library a
# compiled importer records, else in the seed folder, whose compiler compiled a program run from its source; "" where
# no module is there, said
module_path(name: text, importer: text): text := {
	recorded = if importer.ends_with(MODULE_SUFFIX) then section_text(importer, LIBRARY_SECTION) else ""
	found = [beside(importer, name), beside(importer, name.split("/").last), recorded + "/" + name, seed_part(name)].find(path => access(path, EXISTS) == 0)
	if found == ø { eprint("wap: no module ${name} at ${beside(importer, name)}, as ${importer} names it") }
	found ?? ""
}

# a module's bytes in the host's memory, their count, and where its custom section of a name starts, 0 where it has
# none (or where there is no module)
class Section { bytes: int, size: int, at: int }
section_of(path: text, name: text): Section := {
	size_at = host_block(8)
	bytes = file_read(path, size_at)
	if bytes == 0 then Section(0, 0, 0) else Section(bytes, long_at(size_at), section_at(bytes, long_at(size_at), name))
}
# the text of the module's custom section of that name; "" where it has none
section_text(path: text, name: text): text := {
	found = section_of(path, name)
	if found.at == 0 { return "" }
	content = leb_end(found.at + 1)
	name_end = leb_end(content) + leb_at(content)
	c_copied(name_end, section_end(found.at) - name_end)
}
# the module at the path written again without its custom section of that name
section_dropped(path: text, name: text) := {
	found = section_of(path, name)
	if found.at == 0 { return }
	file = fopen(path, "wb")
	fwrite(found.bytes, 1, found.at - found.bytes, file)
	fwrite(section_end(found.at), 1, found.bytes + found.size - section_end(found.at), file)
	fclose(file)
}
# the module at the path with a custom section of that name holding the text added at its end
section_added(path: text, name: text, content: text) := {
	payload = leb_bytes(byte_count(name)) + name.bytes + content.bytes
	file = fopen(path, "ab")
	for byte in [CUSTOM_SECTION] + leb_bytes(#payload) + payload { fputc(byte, file) }
	fclose(file)
}
# a number's unsigned LEB128 bytes
leb_bytes(n: int): list<int> := if n < LEB_PAYLOAD then [n] else [n % LEB_PAYLOAD + LEB_PAYLOAD] + leb_bytes(n ÷ LEB_PAYLOAD)
# where a module's custom section of that name starts, its id byte, among the module's bytes; 0 where it has none
section_at(bytes: int, size: int, name: text): int := {
	at = bytes + WASM_HEADER_BYTES
	while at < bytes + size {
		content = leb_end(at + 1)
		if host_byte(at) == CUSTOM_SECTION and c_copied(leb_end(content), leb_at(content)) == name { return at }
		at = section_end(at)
	}
	0
}
# where the section starting at `at` ends
section_end(at: int): int := leb_end(at + 1) + leb_at(at + 1)
# the unsigned LEB128 number at the host's address; where the bytes after it start
leb_at(at: int): int := if host_byte(at) < LEB_PAYLOAD then host_byte(at) else host_byte(at) - LEB_PAYLOAD + LEB_PAYLOAD * leb_at(at + 1)
leb_end(at: int): int := if host_byte(at) < LEB_PAYLOAD then at + 1 else leb_end(at + 1)
# this executable's path (Linux's link, else macOS's dyld), its links followed (a link to it finds the wap-seed/ beside
# the file itself, and WASI reads no path through a link to a place outside)
executable_found(): text := {
	own = realpath("/proc/self/exe", 0)
	if own == "" {
		written = text_made(PATH_BYTES)
		set_memory_word(SIZE_AT, PATH_BYTES)
		_NSGetExecutablePath(written, host_of(pointer_at(SIZE_AT)))
		own = realpath(written, 0)
	}
	own
}
# the seed built into this executable (main.c): its name, "" where it has none; its bytes
wap_seed_name(): text from 'c'
wap_seed(): i64 from 'c'
wap_seed_size(): i64 from 'c'
# the folder of wap's parts: the seed folder beside this executable, or the cache's folder the seed built into it is
# unpacked into, at its first run
seed_folder_found(): text := {
	name = wap_seed_name()
	if name == "" { return folder_part(executable_path) + SEED_FOLDER }
	cache = getenv("HOME") + CACHE_FOLDER
	folder = cache + name
	if access(folder, EXISTS) != 0 { seed_unpacked(cache, folder) }
	folder + "/"
}
# the seed built into this executable unpacked into the folder, through a part renamed to it, so a run never reads
# half of it (another run's, renamed first, is the one kept); a seed not unpacked is said and ends the run
seed_unpacked(cache: text, folder: text) := {
	system("mkdir -p '${cache}'")
	part = mkdtemp(cache + PART_SUFFIX)
	archive = part + SEED_ARCHIVE
	file = mkstemps(archive, 0)
	c_write(file, wap_seed(), wap_seed_size())
	close(file)
	if system("tar -xf '${archive}' -C '${part}'") != 0 {
		eprint("wap: the seed built into wap was not unpacked into ${part}")
		exit(1)
	}
	unlink(archive)
	if rename(part, folder) == 0 then 0 else system("rm -rf '${part}'")
}
# the path of a part of wap by its name in the seed folder: the one place a part is looked up
seed_part(name: text): text := seed_folder + name
executable_path = executable_found()
seed_folder = seed_folder_found()
compiler_path = seed_part(COMPILER_PART)

# a module linked, by the name its importer imports it under
class Linked { path: text, name: text }
# the modules a module imports by a .wasm name, found as the loader finds them, then theirs, each once after those held
linked_modules(importer: text, held: list<Linked>): list<Linked> := {
	imports = imports_vector(module_compiled(importer))
	for i in 0 upto long_at(imports) {
		name = vector_text(wasm_importtype_module(vector_item(imports, i)))
		path = if name.ends_with(MODULE_SUFFIX) then module_path(name, importer) else ""
		if path != "" and not held.any(linked => linked.path == path) { held = linked_modules(path, held + [Linked(path, name)]) }
	}
	held
}
