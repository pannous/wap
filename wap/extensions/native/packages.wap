# The packages a program uses fetched (wiki/use.md "packages"): where a compile stops at packages it does not hold
# (extensions/packages.wap), the registry is cloned once, the compiler says where each package comes from, and each is
# fetched once into the cache and linked into the program's packages/ folder, its own packages after it; the program
# is then compiled again. git does the fetching; the compiler reads every wap file, this reads none.
use foreign
use "c.wap"
use "run.wap"
use "linking.wap"
use "compiler.wap"

# the default registry, one folder per package (`--registry <git url or folder>` names another), and where a clone of
# one is kept: the cache of fetched packages beside it, ~/.cache/wap/packages/
REGISTRY := "https://github.com/pannous/warp-packages.git"
REGISTRY_CLONE_IN_HOME := "/.cache/wap/registry"
PACKAGES_FOLDER := "/packages/"
# the pins and redirects beside a program (the compiler reads them, extensions/packages.wap)
PINS_FILE := "packages.wap"
PACKAGES_ENDING := ".packages"
USES_COMMAND := "uses"
REGISTRY_SOURCE := "registry"
GITHUB := "https://github.com/"
GIT_ENDING := ".git"
# a package's main file, by its name, the first ending found
SOURCE_ENDINGS := [".wap", ".warp"]
# the registry's tag of a package's version, `colors@1.0.0`, and a repository's, v1.0.0
REGISTRY_TAG_MARK := "@"
REPOSITORY_TAG_MARK := "v"

registry_given: text = REGISTRY

# the packages the compile of a program (its file, or code for "-") stopped at, fetched and linked: whether it stopped
# so, and compiles again
packages_fetched(program: text, code: text, module: text): bool := {
	listed = module + PACKAGES_ENDING
	if access(listed, EXISTS) != 0 { return no }
	packages_linked(program, code, listed)
	yes
}
# each package a program uses that it does not hold, as the compiler says where it comes from (into the file
# `listed`), fetched and linked, then each package's own the same way, each main file once
packages_linked(program: text, code: text, listed: text) := {
	registry = registry_folder()
	users = [program]
	done = 0
	while done < #users {
		user = users#(done + 1)
		given = if done == 0 then code else ""
		if not module_ran(module_loaded(compiler_path), [compiler_path, USES_COMMAND, user, registry, listed], compiler_path, given) { exit(1) }
		for line in file_text(listed).split("\n").filter(line => line != "") {
			main = package_linked(line, registry, if given == "" then folder_of(user) else ".")
			if main != "" and not users.contains(main) { users.add(main) }
		}
		done += 1
	}
	unlink(listed)
}
# a package's line `<name> <source> <version>` fetched and linked as <folder>/packages/<name>: its main file, "" for
# none
package_linked(line: text, registry: text, folder: text): text := {
	parts = line.split(" ")
	name = parts#1
	fetched = if parts#2 == REGISTRY_SOURCE then registry_package(name, parts#3, registry) else repository_package(name, parts#2, parts#3, registry)
	system("mkdir -p '${folder}${PACKAGES_FOLDER}' && ln -sfn '${fetched}' '${folder}${PACKAGES_FOLDER}${name}'")
	SOURCE_ENDINGS.map(ending => fetched + "/" + name + ending).find(path => access(path, EXISTS) == 0) ?? ""
}
# the registry's folder of the package, at the registry's tag of the version where one is asked
registry_package(name: text, version: text, registry: text): text := if version == "" then held(registry + "/" + name, name, registry) else cloned(registry, at_version(name, version), cached(registry, at_version(name, version))) + "/" + name
# the registry's folder of a package, a name it has no folder of ends the run, said
held(folder: text, name: text, registry: text): text := {
	if access(folder, EXISTS) != 0 { eprint("wap: no package ${name}: neither a module beside the program nor the library holds it, nor the registry ${registry}"); exit(1) }
	folder
}
# a repository (owner/repo on GitHub, a git url or a folder) at the tag of the version, else its default branch
repository_package(name: text, repository: text, version: text, registry: text): text := {
	place = if repository.contains(":") or repository.starts_with("/") then repository else GITHUB + repository + GIT_ENDING
	cloned(place, if version == "" then "" else REPOSITORY_TAG_MARK + version, cached(registry, at_version(name, version)))
}
# a package's name at a version, `colors@1.0.0`, the registry's tag of it and its folder in the cache; the name alone
# for the newest
at_version(name: text, version: text): text := if version == "" then name else name + REGISTRY_TAG_MARK + version
# a fetched package's folder in the cache, packages/ beside the registry's folder: ~/.cache/wap/packages/
cached(registry: text, named: text): text := folder_of(registry) + PACKAGES_FOLDER + named
# a repository cloned once into the folder at a tag, or its default branch for "": the folder; a clone that fails
# ends the run, said
cloned(place: text, tag: text, folder: text): text := {
	if access(folder, EXISTS) == 0 { return folder }
	if system("mkdir -p '${folder_of(folder)}' && git clone -q --depth 1 ${if tag == "" then "" else "--branch '${tag}'"} '${place}' '${folder}' 2>/dev/null") != 0 {
		eprint("wap: cannot fetch ${place}${if tag == "" then "" else " at ${tag}"}")
		exit(1)
	}
	folder
}
# the registry's folder: a folder --registry names as it is, else its clone in the cache, made once
registry_folder(): text := if access(registry_given, EXISTS) == 0 then registry_given else cloned(registry_given, "", getenv("HOME") + REGISTRY_CLONE_IN_HOME)
