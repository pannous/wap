# The native wap's compiled programs (driver.wap): a program's machine code kept beside wap.wasm (compiler.wap),
# program-<hash>.cwasm by the hash of the compiler, the program's source and each file it uses or includes by a quoted
# path, so a program run again unchanged runs at once, never compiled; a library module the compiler finds by its name
# changes only with an install, which removes every machine code (scripts/refresh-seed.sh)
use "c.wap"
use "run.wap"
use "compiler.wap"

use_mark(): int32 := prim data_address("use \"")
USE_MARK_BYTES := 5
include_mark(): int32 := prim data_address("include \"")
INCLUDE_MARK_BYTES := 9
QUOTE := 34
program_cache(): int32 := prim data_address("program")
# how deep files using files are followed (a cycle of uses is hashed that many times over, the same each run)
USE_DEPTH := 8

# the program's module, its machine code read from beside the compiler, else compiled by it (wap.wasm of this hash) to
# the module at MODULE_AT and its machine code kept; 0 where it was not, said
program_module(program: int32, compiler_hash: int): int := {
	strcpy(pointer_at(PROGRAM_CACHE_AT), pointer_at(COMPILER_AT))
	set_word(PROGRAM_CACHE_AT + strrchr(pointer_at(PROGRAM_CACHE_AT), SLASH) + 1 - host_of(pointer_at(PROGRAM_CACHE_AT)), 0)
	strcat(pointer_at(PROGRAM_CACHE_AT), host_of(program_cache()))
	hash_named(PROGRAM_CACHE_AT, sources_hashed(compiler_hash, program_path(program), 0))
	cached = deserialized(PROGRAM_CACHE_AT)
	if cached != 0 { return cached }
	if not compiled(module_loaded(pointer_at(COMPILER_AT), CACHE_AT), program, pointer_at(MODULE_AT)) { return 0 }
	module = module_compiled(host_of(pointer_at(MODULE_AT)))
	if module != 0 then cache_written(module, PROGRAM_CACHE_AT) else 0
	module
}
# the hash gone on over the bytes of the file at the host's path and over each file they name after a use or an include
sources_hashed(hash: int, path: int, depth: int): int := {
	size_at = host_block(8)
	bytes = file_read(path, size_at)
	if bytes == 0 or depth > USE_DEPTH { return hash }
	size = long_at(size_at)
	used = named_hashed(hash_of(hash, bytes, size), path, bytes, size, use_mark(), USE_MARK_BYTES, depth)
	named_hashed(used, path, bytes, size, include_mark(), INCLUDE_MARK_BYTES, depth)
}
# the hash gone on over each file the bytes name in quotes after the mark, its path beside the file's
named_hashed(hash: int, path: int, bytes: int, size: int, mark: int32, mark_bytes: int, depth: int): int := {
	gone_on = hash
	found = memmem(bytes, size, mark, mark_bytes)
	while found != 0 {
		name = found + mark_bytes
		quote = memchr(name, QUOTE, bytes + size - name)
		if quote == 0 { return gone_on }
		gone_on = sources_hashed(gone_on, beside(path, name, quote - name), depth + 1)
		found = memmem(quote, bytes + size - quote, mark, mark_bytes)
	}
	gone_on
}
