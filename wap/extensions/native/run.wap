# How the native wap runs wasm modules (driver.wap): by wasmtime's C API, a store with WASI for each program's run,
# a module's .wasm and C imports linked first; the memory where the driver, compiler loading and console keep words.
use foreign
use "c.wap"
use "../../types/host.wap"
use "host_words.wap"
use "linking.wap"

# --- the program's memory: the out-cells C and WASI fill, below the data at 65536 (kernel/opcodes.wap) ---
STATUS_AT := 1032
ARGUMENT_COUNT_AT := 1040
ARGUMENT_BYTES_COUNT_AT := 1044
SIZE_AT := 1048
# the used modules' `finished()` the run's end calls: their context, their count, the host block of their externs
finishing: int = 0
finisher_count: int = 0
FINISHERS := 16
# the temporary file a run makes, gone at its end: a program's module
module_file: text = ""
# the host's records the C API fills, by their sizes in bytes: a byte vector (size, data), an instance, an extern
VECTOR_BYTES := 16
INSTANCE_BYTES := 16
EXTERN_BYTES := 32
# a func's place in its extern, past the kind
EXTERN_VALUE_OFFSET := 8
# wasmtime's limits for a run: the GC heap it starts with and its wasm stack (core/native/driver.warp's); a heap of
# 2 GB lets a compile of wap collect seldom (a fifth fewer instructions than 128 MB), and a small program touches
# no more of it than before
GC_HEAP_BYTES := 2147483648
WASM_STACK_BYTES := 251658240
# the run's clock on (a C bool): epoch deadlines, the time cap below
EPOCH_INTERRUPTION := 1
# macOS's confstr name of the user's temporary folder, which a run without TMPDIR (as under cron) uses, and the
# bytes its path may take
USER_TEMPORARY_FOLDER := 65537
PATH_BYTES := 1024
# the engine's settings its machine code depends on, which every cache's hash starts from (compiler.wap), so wap builds
# of other settings keep caches of their own and never refuse each other's
ENGINE_SETTINGS := [GC_HEAP_BYTES, WASM_STACK_BYTES, EPOCH_INTERRUPTION]
# a run's caps, as scripts/guarded.sh's: a store's memory in GB, its seconds; `--memory-gb <n>` and `--seconds <n>`
# before the program change them (driver.wap). One runaway wap took 90 GB of a 32 GB Mac, 2026-11-22
memory_cap_gb: int = 12
time_cap_seconds: int = 1800
# a run under --no-window: no window, no sound device (host_words.wap headless_checked)
windowless: bool = no
GB := 1073741824
NO_CAP := -1
# what wasmtime says when a store passes its time cap, its memory cap
TIME_CAP_PASSED := "wasm trap: interrupt"
MEMORY_CAP_PASSED := "out of memory"
# the program or module the run was given, named when it passes a cap (driver.wap)
run_input: text = ""
# a C bool's byte, a path's mode that asks whether it is there, the mode of a file the driver writes (rw-r--r--); C's
# whence for fseek is WASI's (types/host.wap FROM_START, FROM_END)
BOOL_BYTE := 256
FAILED := 1
EXISTS := 0
MODULE_SUFFIX := ".wasm"
WASI_MODULE := "wasi_snapshot_preview1"
# what a program's run calls, and a used module's: its top level but the value shown (core/emit/emitter.wap)
MAIN_NAME := "main"
INIT_NAME := "warp/start"
# every module exports its memory: a module whose memory the linker holds was started already
MEMORY_NAME := "memory"
TABLE_NAME := "warp/functions"
# what a module exports to be called when the run ends (host.wap's: the queued sound heard out; timers.wap's: the
# program's timers run)
FINISHED_NAME := "finished()"

# the run ended with this status, its temporary files gone (a path not made yet is an empty one, unlinking nothing),
# the modules' finished() run only after a run that went well
ended(status: int) := {
	global module_file
	if status == 0 { each_finished() }
	unlink(module_file)
	exit(status)
}
# a text written to the file
written(file: int, t: text) := c_write(file, host_of(c_text(t)), byte_count(t))
# (wasmtime's messages end in a C string's 0, which a reader of the output would take for binary data); a message of
# a passed cap is followed by the cap, the input and the option that changes it
said_vector(vector: int): bool := {
	message = c_text_from(long_at(vector + 8))
	eprint(message)
	if message.contains(TIME_CAP_PASSED) { eprint("wap: ${run_input} ran past the time cap of ${time_cap_seconds} s (--seconds <n> before the program changes it)") }
	if message.contains(MEMORY_CAP_PASSED) { eprint("wap: ${run_input} passed the memory cap of ${memory_cap_gb} GB (--memory-gb <n> before the program changes it)") }
	yes
}
# whether a call failed: its error or trap said, the status at STATUS_AT; an exit() of status 0 is no failure, one of
# another status a failure the program said itself
failed(error: int, trap_at: int): bool := {
	set_memory_word(STATUS_AT, FAILED)
	if error != 0 and wasmtime_error_exit_status(error, host_of(pointer_at(STATUS_AT))) % BOOL_BYTE != 0 { return memory_word(STATUS_AT) != 0 }
	trap = long_at(trap_at)
	if error == 0 and trap == 0 { return no }
	message = host_block(VECTOR_BYTES)
	if error != 0 { wasmtime_error_message(error, message) } else { wasm_trap_message(trap, message) }
	said_vector(message)
}
# the run ended where a step of wasmtime's setup failed
checked(error: int) := if failed(error, host_block(8)) then ended(memory_word(STATUS_AT))
said_none(message: text): int := {
	eprint(message)
	0
}
# the bytes of the file at the path in a block of the host's memory, its size written at the host's size_at; 0 where
# there is no file
file_read(path: text, size_at: int): int := {
	file = fopen(path, "rb")
	if file == 0 { return 0 }
	fseek(file, 0, FROM_END)
	size = ftell(file)
	fseek(file, 0, FROM_START)
	block = malloc(size)
	fread(block, 1, size, file)
	fclose(file)
	set_long_at(size_at, size)
	block
}
# the text of the file at the path, "" where there is none
file_text(path: text): text := {
	size_at = host_block(8)
	block = file_read(path, size_at)
	if block == 0 then "" else c_copied(block, long_at(size_at))
}

# --- wasmtime: one engine for the run, a store with WASI for each program's arguments, modules linked by path ---
# a GC engine with exceptions, at wasmtime's limits for a run
engine_made(): int := {
	config = wasm_config_new()
	wasmtime_config_wasm_gc_set(config, 1)
	wasmtime_config_wasm_function_references_set(config, 1)
	wasmtime_config_wasm_exceptions_set(config, 1)
	warp_config_gc_heap_initial_size_set(config, GC_HEAP_BYTES)
	warp_config_wasm_stack_set(config, WASM_STACK_BYTES)
	wasmtime_config_epoch_interruption_set(config, EPOCH_INTERRUPTION)
	made = wasm_engine_new_with_config(config)
	epoch_ticker_started(made)
	made
}
# a store's context, within the run's caps, whose WASI gives the host argument list, the standard files (standard
# input the text given, else the command's; standard output the file at `output`, else the command's), the
# environment, the current folder by its real name (types/host.wap real_path follows links from it) and the root
context_made(arguments: list<text>): int := wasmtime_store_context(store_made(arguments))
store_made(arguments: list<text>, input: text = "", output: text = ""): int := {
	store = wasmtime_store_new(engine, 0, 0)
	wasmtime_store_limiter(store, memory_cap_gb * GB, NO_CAP, NO_CAP, NO_CAP, NO_CAP)
	context = wasmtime_store_context(store)
	wasmtime_context_set_epoch_deadline(context, time_cap_seconds)
	wasi = wasi_config_new()
	wasi_config_set_argv(wasi, #arguments, arguments)
	if input is empty { wasi_config_inherit_stdin(wasi) } else { wasi_config_set_stdin_bytes(wasi, byte_vector(input)) }
	if output is empty { wasi_config_inherit_stdout(wasi) } else { wasi_config_set_stdout_file(wasi, output) }
	wasi_config_inherit_stderr(wasi)
	wasi_config_inherit_env(wasi)
	wasi_config_preopen_dir(wasi, ".", realpath(".", 0), 1)
	wasi_config_preopen_dir(wasi, "/", "/", 1)
	checked(wasmtime_context_set_wasi(context, wasi))
	store
}
# a text's bytes as a new wasm byte vector, its owner the call it is given to
byte_vector(t: text): int := {
	vector = host_block(VECTOR_BYTES)
	wasm_byte_vec_new(vector, byte_count(t), t)
	vector
}
linker_made(): int := {
	linker = wasmtime_linker_new(engine)
	checked(wasmtime_linker_define_wasi(linker))
	wasmtime_linker_allow_shadowing(linker, 1)
	linker
}
# the module of the file at the path, compiled by the engine; 0 where there is none, said
module_compiled(path: text): int := {
	set_memory_word(STATUS_AT, FAILED)
	size_at = host_block(8)
	bytes = file_read(path, size_at)
	if bytes == 0 then said_none("wap: no module at ${path}") else module_of(bytes, long_at(size_at))
}
# the module of these bytes of the host's memory; 0 where they are none, said
module_of(bytes: int, size: int): int := {
	module_at = host_block(8)
	if failed(wasmtime_module_new(engine, bytes, size, module_at), host_block(8)) then 0 else long_at(module_at)
}
# the module of the file at the path `importer` instantiated in the context, what it imports by a .wasm name
# linked first, then its main run when `main` asks (a program's, a console line's), else its warp/start (a module
# another uses, its top level but the value shown, where it has one): the instance, 0 where a step failed
instance_ran(linker: int, context: int, module: int, importer: text, main: bool): int := {
	if not imports_linked(linker, context, module, importer) { return 0 }
	instance = host_block(INSTANCE_BYTES)
	trap_at = host_block(8)
	if failed(wasmtime_linker_instantiate(linker, context, module, instance, trap_at), trap_at) { return 0 }
	finisher_kept(context, instance)
	item = host_block(EXTERN_BYTES)
	name = if main then MAIN_NAME else INIT_NAME
	if wasmtime_instance_export_get(context, instance, name, byte_count(name), item) % BOOL_BYTE == 0 { return instance }
	if failed(wasmtime_func_call(context, item + EXTERN_VALUE_OFFSET, 0, 0, 0, 0, trap_at), trap_at) then 0 else instance
}
# each module the module imports by a .wasm name (`use "m.wasm"`) the linker holds no instance of yet run and kept in
# it under its name, whether each was, a module that is not tried once; each C import as that C function
# (host_words.wap), path_readlink as main.c's
imports_linked(linker: int, context: int, module: int, importer: text): bool := {
	imports = host_block(VECTOR_BYTES)
	wasmtime_module_imports(module, imports)
	linked = yes
	unlinked: list<text> = []
	i = 0
	while i < long_at(imports) {
		imported = vector_item(imports, i)
		from = wasm_importtype_module(imported)
		name = wasm_importtype_name(imported)
		module_name = vector_text(from)
		held = linker_holds(linker, context, from, name)
		if module_name.ends_with(MODULE_SUFFIX) and not held and not unlinked.contains(module_name) {
			started = module_started(linker, context, from) or instance_defined(linker, context, module_name, importer, no)
			if not started { unlinked += [module_name] }
			linked = started and (linker_holds(linker, context, from, name) or missing_word_said(name, module_name)) and linked
		}
		else if is_c_import(module_name) and not held { c_function_defined(linker, imported, from, name) }
		else if module_name == WASI_MODULE and vector_text(name) == READLINK_NAME { import_defined(linker, imported, from, name, readlink_name(), 0) }
		i += 1
	}
	linked
}
# the modules a module imports by a .wasm name (`use "m.wasm"`), each once
imported_modules(module: int): list<text> := {
	imports = host_block(VECTOR_BYTES)
	wasmtime_module_imports(module, imports)
	(0 upto long_at(imports)).map(i => vector_text(wasm_importtype_module(vector_item(imports, i)))).filter(name => name.ends_with(MODULE_SUFFIX)).unique
}
# the instance of a module, the program's or one it uses, its `finished()`, when it exports one, kept for the run's end
finisher_kept(context: int, instance: int): int := {
	global finisher_count
	item = finishers + EXTERN_BYTES * finisher_count
	if finisher_count < FINISHERS and wasmtime_instance_export_get(context, instance, FINISHED_NAME, byte_count(FINISHED_NAME), item) % BOOL_BYTE != 0 {
		global finishing = context
		global finisher_count = finisher_count + 1
	}
	instance
}
# each kept `finished()` called, in the order its module was used; an exit or a failure inside one ends the run with
# its status
each_finished() := {
	global finisher_count
	global finishing
	i = 0
	while i < finisher_count {
		trap_at = host_block(8)
		if failed(wasmtime_func_call(finishing, finishers + EXTERN_BYTES * i + EXTERN_VALUE_OFFSET, 0, 0, 0, 0, trap_at), trap_at) { ended(memory_word(STATUS_AT)) }
		i += 1
	}
}
# whether the linker holds the module of the name vector `from` already, by its memory
module_started(linker: int, context: int, from: int): bool := linker_holds(linker, context, from, byte_vector(MEMORY_NAME))
# whether the linker holds the word of the name vector `name` from the module of the name vector `from`
linker_holds(linker: int, context: int, from: int, name: int): bool := wasmtime_linker_get(linker, context, from, name, host_block(EXTERN_BYTES)) % BOOL_BYTE != 0
# a word the program imports, a host name vector, that its running module does not export, said; no
missing_word_said(word: int, module_name: text): bool := said_none("wap: no ${vector_text(word)} in ${module_name}") != 0
# the text of a host name vector (size, data)
vector_text(vector: int): text := c_copied(long_at(vector + 8), long_at(vector))
# the module the importer names instantiated in the context (its main run when `main` asks) and kept in the linker
# under that name, when it defines something (what another module imports from it; a console line that only did
# something is run and gone): whether it was
instance_defined(linker: int, context: int, name: text, importer: text, main: bool): bool := {
	path = module_path(name, importer)
	module = if path == "" then 0 else module_compiled(path)
	instance = if module == 0 then 0 else instance_ran(linker, context, module, path, main)
	instance != 0 and exports_more(module) and not failed(wasmtime_linker_define_instance(linker, context, name, byte_count(name), instance), host_block(8))
}
# the exception tag a module exports where it raises (core/emit/functions.wap RAISED_EXPORT)
RAISED_NAME := "raised"
# whether the module exports more than any program may: a word or a global of its own
exports_more(module: int): bool := {
	exports = host_block(VECTOR_BYTES)
	wasmtime_module_exports(module, exports)
	i = 0
	while i < long_at(exports) {
		if not is_program_export(vector_text(wasm_exporttype_name(vector_item(exports, i)))) { return yes }
		i += 1
	}
	no
}
# whether any program may export the name: its main, its warp/start, its memory, its table, its exception tag
is_program_export(name: text): bool := name == MAIN_NAME or name == INIT_NAME or name == MEMORY_NAME or name == TABLE_NAME or name == RAISED_NAME
# the item at index i of a host vector of pointers (size, data)
vector_item(vector: int, i: int): int := long_at(long_at(vector + 8) + 8 * i)
# the path of the name: as it is when it starts at the root, else in the folder of the file at the path (the current
# folder when the path names none)
beside(path: text, name: text): text := if name.starts_with("/") then name else folder_part(path) + name
# a path's folder and a slash: names beside the file follow it ("./" for a path naming no folder)
folder_part(path: text): text := folder_of(path) + "/"
# the module of the file at the path `importer` run with these arguments, in a store of its own, freed after the run
# (a compiler's GC heap gone before its program runs) unless the run's end calls its modules' finished(); its standard
# input the text given, else the command's; whether it ran
module_ran(module: int, arguments: list<text>, importer: text, input: text = ""): bool := {
	global finishing
	store = store_made(arguments, input)
	ran = module != 0 and instance_ran(linker_made(), wasmtime_store_context(store), module, importer, yes) != 0
	if finishing != wasmtime_store_context(store) { wasmtime_store_delete(store) }
	ran
}
# the laws of a module wap verify compiled (extensions/law_runs.wap) run, its verdicts written to the file at `output`:
# its top level started, never its main, then each export whose name starts so, in the module's order, each printing
# its law's verdict; whether every one ran to its end. A function is exported by its name and by its signature, a
# law's `law_positive()`, which names it once
LAW_PREFIX := "law_"
LAW_SIGNATURE_END := "()"
laws_ran(module: int, path: text, output: text): bool := {
	context = wasmtime_store_context(store_made([path], output: output))
	instance = if module == 0 then 0 else instance_ran(linker_made(), context, module, path, no)
	if instance == 0 { return no }
	exports = host_block(VECTOR_BYTES)
	wasmtime_module_exports(module, exports)
	item = host_block(EXTERN_BYTES)
	trap_at = host_block(8)
	names = (0 upto long_at(exports)).map(i => vector_text(wasm_exporttype_name(vector_item(exports, i)))).filter(name => name.starts_with(LAW_PREFIX) and name.ends_with(LAW_SIGNATURE_END))
	names.all(name => wasmtime_instance_export_get(context, instance, name, byte_count(name), item) % BOOL_BYTE != 0 and not failed(wasmtime_func_call(context, item + EXTERN_VALUE_OFFSET, 0, 0, 0, 0, trap_at), trap_at))
}
# a new path in the temporary folder by the template
temporary_path(template: text): text := temporary_folder() + template
# TMPDIR, else the user's temporary folder
temporary_folder(): text := {
	given = getenv("TMPDIR")
	if given != "" { return given }
	folder = host_block(PATH_BYTES)
	confstr(USER_TEMPORARY_FOLDER, folder, PATH_BYTES)
	c_text_from(folder)
}
# a program's path as the compiler reads it, its links followed; as written where nothing is there, for the compiler
# to say so
program_path(written: text): text := {
	resolved = realpath(written, 0)
	if resolved == "" then written else resolved
}

engine = engine_made()
finishers = host_block(FINISHERS * EXTERN_BYTES)
