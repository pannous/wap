# How the native wap runs wasm modules (wap/extensions/native, driver.wap): by wasmtime's C API, one engine for the
# run, a store with WASI for each program's arguments, what a module imports by a .wasm path linked first; wap.wasm,
# the compiler beside the executable, compiling a source to a module; and the program's memory, where the driver and
# the console keep their words.
use "c.wap"

# --- the program's memory: where the driver keeps its own words, below the data at 65536 (core/emit/opcodes.wap) ---
STATUS_AT := 1032
ARGUMENT_COUNT_AT := 1040
ARGUMENT_BYTES_COUNT_AT := 1044
SIZE_AT := 1048
DIGITS_AT := 1056
ARGUMENTS_AT := 2048
ARGUMENT_BYTES_AT := 4096
LINE_AT := 16384
LINE_BYTES := 8192
NAME_AT := 24576
SESSION_AT := 28672
COMPILER_AT := 32768
MODULE_AT := 40960
SOURCE_AT := 45056
COMMAND_AT := 49152
PATH_BYTES := 4096
# the host's records the C API fills, by their sizes in bytes: a byte vector (size, data), an instance, an extern
VECTOR_BYTES := 16
INSTANCE_BYTES := 16
EXTERN_BYTES := 24
# a func's place in its extern, past the kind
EXTERN_VALUE_OFFSET := 8
# wasmtime's limits for a run: the compiler's GC heap and its wasm stack (core/native/driver.warp's)
GC_HEAP_BYTES := 134217728
WASM_STACK_BYTES := 251658240
# C's whence for fseek, a C bool's byte, the file descriptor of standard error, the slash
FROM_START := 0
FROM_END := 2
BOOL_BYTE := 256
STANDARD_ERROR := 2
SLASH := 47
FAILED := 1
# the texts named here, each a C string in the program's memory
compiler_beside(): pointer := prim data_address("/wap-seed/wap.wasm")
wap_suffix(): pointer := prim data_address(".wap")
module_suffix(): pointer := prim data_address(".wasm")
temporary_folder(): pointer := prim data_address("TMPDIR")
current_folder(): pointer := prim data_address(".")
# the root, and the slash a path's folders are joined with
root(): pointer := prim data_address("/")
reading(): pointer := prim data_address("rb")
main_name(): pointer := prim data_address("main")
MAIN_NAME_BYTES := 4
own_path_link(): pointer := prim data_address("/proc/self/exe")
no_module(): pointer := prim data_address("wap: no module at that path\n")

# the run ended with this status, its temporary files gone (a path not made yet is an empty one, unlinking nothing)
ended(status: int) := {
	unlink(pointer_at(MODULE_AT))
	unlink(pointer_at(SOURCE_AT))
	exit(status)
}
# a C string of the host's memory written to the file
written(file: int, t: int) := write(file, t, strlen(t))
said(t: pointer) := written(STANDARD_ERROR, host_of(t))
said_vector(vector: int): bool := write(STANDARD_ERROR, long_at(vector + 8), long_at(vector)) >= 0
# whether a call failed: its error or trap said, the status at STATUS_AT; an exit() of status 0 is no failure, one of
# another status a failure the program said itself
failed(error: int, trap_at: int): bool := {
	set_word(STATUS_AT, FAILED)
	if error != 0 and wasmtime_error_exit_status(error, host_of(pointer_at(STATUS_AT))) % BOOL_BYTE != 0 then word_at(STATUS_AT) != 0 else if error != 0 then error_said(error) else if long_at(trap_at) != 0 then trap_said(long_at(trap_at)) else no
}
error_said(error: int): bool := {
	message = host_block(VECTOR_BYTES)
	wasmtime_error_message(error, message)
	said_vector(message)
}
trap_said(trap: int): bool := {
	message = host_block(VECTOR_BYTES)
	wasm_trap_message(trap, message)
	said_vector(message)
}
# the run ended where a step of wasmtime's setup failed
checked(error: int) := if failed(error, host_block(8)) then ended(word_at(STATUS_AT))

# the bytes of a file in a block of the host's memory, its size written at the host's size_at; 0, said, where there is
# no file
file_read(path: pointer, size_at: int): int := {
	file = fopen(host_of(path), reading())
	if file == 0 {
		said(no_module())
		return 0
	}
	fseek(file, 0, FROM_END)
	size = ftell(file)
	fseek(file, 0, FROM_START)
	block = malloc(size)
	fread(block, 1, size, file)
	fclose(file)
	set_long_at(size_at, size)
	block
}

# --- wasmtime: one engine for the run, a store with WASI for each program's arguments, modules linked by path ---
# a GC engine with exceptions, at wasmtime's limits for a run
engine_made(): int := {
	config = wasm_config_new()
	wasmtime_config_wasm_gc_set(config, 1)
	wasmtime_config_wasm_function_references_set(config, 1)
	wasmtime_config_wasm_exceptions_set(config, 1)
	warp_config_gc_heap_initial_size_set(config, GC_HEAP_BYTES)
	warp_config_wasm_stack_set(config, WASM_STACK_BYTES)
	wasm_engine_new_with_config(config)
}
# a store's context whose WASI gives the host argument list, the standard files, the environment, the current folder
# and the root
context_made(count: int, arguments: int): int := {
	context = wasmtime_store_context(wasmtime_store_new(engine, 0, 0))
	wasi = wasi_config_new()
	wasi_config_set_argv(wasi, count, arguments)
	wasi_config_inherit_stdin(wasi)
	wasi_config_inherit_stdout(wasi)
	wasi_config_inherit_stderr(wasi)
	wasi_config_inherit_env(wasi)
	wasi_config_preopen_dir(wasi, current_folder(), current_folder(), 1)
	wasi_config_preopen_dir(wasi, root(), root(), 1)
	checked(wasmtime_context_set_wasi(context, wasi))
	context
}
linker_made(): int := {
	linker = wasmtime_linker_new(engine)
	checked(wasmtime_linker_define_wasi(linker))
	linker
}
# the module of the file, compiled by the engine; 0 where there is none, said
module_compiled(path: pointer): int := {
	set_word(STATUS_AT, FAILED)
	size_at = host_block(8)
	bytes = file_read(path, size_at)
	if bytes == 0 { return 0 }
	module_at = host_block(8)
	if failed(wasmtime_module_new(engine, bytes, long_at(size_at), module_at), host_block(8)) then 0 else long_at(module_at)
}
# the module instantiated in the context, what it imports by a .wasm path linked first, then its main run: the
# instance, 0 where a step failed
instance_ran(linker: int, context: int, module: int): int := {
	if not imports_linked(linker, context, module) { return 0 }
	instance = host_block(INSTANCE_BYTES)
	trap_at = host_block(8)
	if failed(wasmtime_linker_instantiate(linker, context, module, instance, trap_at), trap_at) { return 0 }
	item = host_block(EXTERN_BYTES)
	wasmtime_instance_export_get(context, instance, main_name(), MAIN_NAME_BYTES, item)
	if failed(wasmtime_func_call(context, item + EXTERN_VALUE_OFFSET, 0, 0, 0, 0, trap_at), trap_at) then 0 else instance
}
# each module the module imports by a .wasm path (`use "m.wasm"`, extensions/wasm/modules.wap) that the linker holds
# no instance of yet: that file's module run, its instance kept in the linker under its path; whether each was
imports_linked(linker: int, context: int, module: int): bool := {
	imports = host_block(VECTOR_BYTES)
	wasmtime_module_imports(module, imports)
	linked = yes
	i = 0
	while i < long_at(imports) {
		import = long_at(long_at(imports + 8) + 8 * i)
		from = wasm_importtype_module(import)
		name = wasm_importtype_name(import)
		memcpy(pointer_at(NAME_AT), long_at(from + 8), long_at(from))
		set_word(NAME_AT + long_at(from), 0)
		held = wasmtime_linker_get(linker, context, from, name, host_block(EXTERN_BYTES)) % BOOL_BYTE != 0
		linked = if ends_in(pointer_at(NAME_AT), module_suffix()) and not held then instance_defined(linker, context, pointer_at(NAME_AT)) and linked else linked
		i = i + 1
	}
	linked
}
# the module of the file at `path` run in the context and kept in the linker under its path, when it defines something
# (what another module imports from it; a console line that only did something is run and gone): whether it was
instance_defined(linker: int, context: int, path: pointer): bool := {
	name = strdup(path)
	module = module_compiled(path)
	instance = if module == 0 then 0 else instance_ran(linker, context, module)
	instance != 0 and exports_more(module) and not failed(wasmtime_linker_define_instance(linker, context, name, strlen(name), instance), host_block(8))
}
# whether the module exports more than every program does, its main and its memory
BASE_EXPORTS := 2
exports_more(module: int): bool := {
	exports = host_block(VECTOR_BYTES)
	wasmtime_module_exports(module, exports)
	long_at(exports) > BASE_EXPORTS
}
# the module run with the host argument list given, in a store of its own; whether it ran
module_ran(module: int, count: int, arguments: int): bool := module != 0 and instance_ran(linker_made(), context_made(count, arguments), module) != 0
# the source compiled to the module by the compiler's module: whether it was, the compiler's refusal said
COMPILE_COUNT := 3
compiled(compiler: int, source: pointer, module: pointer): bool := {
	arguments = host_block(8 * COMPILE_COUNT)
	set_long_at(arguments, host_of(pointer_at(COMPILER_AT)))
	# (its links followed: WASI follows none out of a folder it opened, and data/ often is one)
	set_long_at(arguments + 8, program_path(source))
	set_long_at(arguments + 16, host_of(module))
	module_ran(compiler, COMPILE_COUNT, arguments)
}

# this executable's path (Linux's link, else macOS's dyld) with its file name replaced by the compiler's, at COMPILER_AT
compiler_found() := {
	length = readlink(own_path_link(), pointer_at(COMPILER_AT), PATH_BYTES - 1)
	if length > 0 then set_word(COMPILER_AT + length, 0) else {
		set_word(SIZE_AT, PATH_BYTES)
		_NSGetExecutablePath(pointer_at(COMPILER_AT), pointer_at(SIZE_AT))
	}
	slash = strrchr(pointer_at(COMPILER_AT), SLASH) - host_of(pointer_at(COMPILER_AT))
	strcpy(pointer_at(COMPILER_AT + slash), compiler_beside())
}
# a new path in the temporary folder at `at`, by the template
temporary_path(at: int, template: pointer) := {
	set_word(at, 0)
	strcat(pointer_at(at), getenv(temporary_folder()))
	strcat(pointer_at(at), host_of(template))
}
# whether the C string ends in the suffix
ends_in(t: pointer, suffix: pointer): bool := strlen(host_of(t)) >= strlen(host_of(suffix)) and strcmp(pointer_at(address(t) + strlen(host_of(t)) - strlen(host_of(suffix))), suffix) == 0
# a program's path as the compiler reads it, its links followed; as written where nothing is there, for the compiler
# to say so
program_path(written: pointer): int := {
	resolved = realpath(written, 0)
	if resolved == 0 then host_of(written) else resolved
}
# a host list of these addresses' C strings
host_list(addresses: int, count: int): int := {
	list = host_block(8 * count)
	i = 0
	while i < count {
		set_long_at(list + 8 * i, host_of(pointer_at(word_at(addresses + 4 * i))))
		i = i + 1
	}
	list
}

engine = engine_made()
