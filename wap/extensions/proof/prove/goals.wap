# A goal of the provers (prove.wap): a statement gone into, and the equations they read
use "../../../kernel/terms.wap"
use "../../../kernel/environment.wap"
use "../../../kernel/compute.wap"
use "../../../kernel/typing.wap"
use "../../../kernel/inductive.wap"
use "../../../kernel/recursors.wap"
use "integer_laws.wap"
use "../../../core/analyze/holes.wap"
use "../../../core/analyze/unify.wap"

# what a prover is asked: the statement under its parameters, each a binder in scope of the elaboration whose holes
# the provers answer, the laws its `by` names, which the provers try first, and how many premises deep it lies
class Goal { el: Elaboration; parameters: list<Term>; statement: Term; named: list<Declaration>; depth: int = 0 }

# a statement gone into: each parameter of its function type a binder in scope, the rest the goal
goal_of(el: Elaboration, statement: Term, named: list<Declaration>): Goal := {
	goal = Goal(el, [], statement, named)
	while yes {
		match computed(el.c, goal.statement).shape {
			Pi(binder, domain, body) => {
				parameter = scoped(el, binder, domain)
				goal.parameters += [parameter]
				goal.statement = instantiated(body, parameter)
			}
			_ => return goal
		}
	}
	goal
}

# the statement that a and b are equal by the equality and at the type of an equation
stated(equation: Equation, a: Term, b: Term): Term := apply_all(at_levels(equation.equality, equation.levels), [equation.type, a, b])
# the proof by `refl` that a value equals itself, at the type of an equation
reflexivity(c: Checker, equation: Equation, value: Term): Term := apply_all(at_levels(reflexive_case(c.environment, equation.equality), equation.levels), [equation.type, value])

# the recursor the provers take a value apart by, of the enum its type names; ø for a type of no enum, of several
# naming each other, or with indices
case_recursor(c: Checker, type: Term): Declaration? := match head(type).shape {
	Constant(name, levels, _) => {
		facts = recursor_facts(c.environment, recursor_name(name)) ?? return ø
		if facts.motives > 1 or facts.indices > 0 then ø else declaration(c.environment, recursor_name(name))
	}
	_ => ø
}

# An earlier law at holes: its proof applied to a hole for each parameter and its levels, and what it then concludes;
# a premise written by a definition (`a implies b`) is a parameter too
class LawInstance { proof: Term; holes: list<Term>; conclusion: Term }
instance_of(el: Elaboration, law: Declaration): LawInstance := {
	levels = law.levels.map(level => level_hole(el))
	instance = LawInstance(constant_of(el.c.environment, law.name, levels), [], with_levels(law.type, law.levels, levels))
	while yes {
		match computed(el.c, instance.conclusion).shape {
			Pi(binder, domain, body) => {
				found = hole(el, binder, domain)
				instance.holes += [found]
				instance.proof = apply(instance.proof, found)
				instance.conclusion = instantiated(body, found)
			}
			_ => return instance
		}
	}
	instance
}
# A law whose conclusion is the goal, applied: its instance first `fitted` (a hole given a value before the
# conclusion is matched), then each premise the conclusion left open `answered`; ø where any fails, its holes taken
# back
applied_law(goal: Goal, law: Declaration, fitted: (LawInstance) -> bool, answered: (Term) -> bool): Term? := attempt(goal.el, () => {
	el = goal.el
	instance = instance_of(el, law)
	if not (fitted(instance) and unified(el, instance.conclusion, goal.statement) and instance.holes.all(premise => not open(el, filled(el, premise)) or answered(premise))) { return ø }
	proof = filled(el, instance.proof)
	if open(el, proof) then ø else proof
})
# what a trial finds, ø where it finds nothing, the answers it found then taken back
attempt(el: Elaboration, trial: () -> T?): T? := {
	kept = found_so_far(el)
	found = trial()
	if found is ø { back_to(el, kept) }
	found
}
# the proof the first of the provers finds, ø where none does
# (the laws a prover declares on the way join the environment only with the proof it returns; int's laws are
# declared before, once, so no prover's giving up takes them back)
first_proof(goal: Goal, provers: list<(Goal) -> Term?>): Term? := {
	integer_laws_ready(goal.el.c.environment)
	for prover in provers {
		proof = kept_if_given(goal.el.c.environment, () => found_within_budget(() => prover(goal)))
		if proof is not ø { return proof }
	}
	ø
}
# what a prover found, ø when it gave up counting its steps; any other refusal is a prover's bug and is raised
found_within_budget(search: () -> Term?): Term? := try { search() } catch e {
	refusal_only(e, [GAVE_UP])
	ø
}
# the provers' facts: the laws proved so far, and those taken as true, an axiom or an `assume` stating a proposition
# (wiki/proof.md: an assumed theorem counts as proved for the ones after it)
proved_laws(c: Checker): list<Declaration> := declared_names(c.environment).map(name => declaration(c.environment, name)!).filter(d => d.kind is Theorem or (d.kind is Axiom and states_proposition(c, d)))
# whether a declaration's type is a proposition at its lowest levels, as it is at every level: a type ending in a
# proposition is one at any level
states_proposition(c: Checker, d: Declaration): bool := is_proposition(c, with_levels(d.type, d.levels, d.levels.map(level => Zero)))
# the laws a prover tries, those `by` names first, each once
laws_of(goal: Goal): list<Declaration> := (goal.named + proved_laws(goal.el.c)).unique()

# the facts of the recursor of that name, ø for any other declaration
recursor_facts(environment: Environment, name: text): RecursorFacts? := match (declaration(environment, name) ?? return ø).kind {
	Recursor(facts) => facts
	_ => ø
}
# how many binders a function type has
binders_counted(type: Term): int := match type.shape {
	Pi(binder, domain, body) => 1 + binders_counted(body)
	_ => 0
}
