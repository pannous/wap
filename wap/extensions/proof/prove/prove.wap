# The provers (notes/coc-plan.md 3.5 and 8, "The provers"; wiki/proof.md "Ways to prove"): functions from a goal to a
# proof term, tried in order on a law stated without a proof. They are not trusted: a proof they find is declared as
# the law's and checked by the kernel like any other, so a wrong prover proves nothing. A prover that runs out of
# steps has found nothing.
use "../../../kernel/environment.wap"
use "../../../core/analyze/holes.wap"
use "goals.wap"
use "computing.wap"
use "facts.wap"
use "rewriting.wap"
use "induction.wap"

# The provers, cheapest first: induction last, its cases proved by the others
PROVERS: list<(Goal) -> Term?> := CASE_PROVERS + by_induction

# a proof of a closed statement, as a function of its parameters, the laws `by` names tried first; ø when no prover
# finds one
proof_found(el: Elaboration, statement: Term, named: list<Declaration>): Term? := {
	goal = goal_of(el, statement, named)
	proof = first_proof(goal, PROVERS) ?? return ø
	closed_filled(el, proof, goal.parameters, yes)
}

# a proof of a condition from the facts in scope, by the provers of one case; ø when none finds one
condition_proof(el: Elaboration, facts: list<Term>, condition: Term): Term? := first_proof(Goal(el, facts, condition, []), CASE_PROVERS)
