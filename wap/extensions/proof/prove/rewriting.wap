# Proof by rewriting (wiki/proof.md "Ways to prove"): both sides of an equation rewritten by earlier laws, a part
# matching a law's left side replaced by its right side, until the two sides meet; a hypothesis that is an equation
# rewrites too, and a part's definitions unfold until it applies the law's function (`x + y` is `add(x, y)`). Without
# `by` a law rewrites only where it orients: its left side holds all its parameters and is bigger than its right, or
# as big with a head defined above the right's, so each step goes down and needs nothing the match does not give. A law `by` names rewrites even where it does not orient, at most
# once at each place of a side, so `add(a, b) == add(b, a)` turns a sum round once instead of forever. The proof is
# built from the equality's recursor alone: the left side's steps carried forward from `refl`, then the right side's
# steps carried back
use "../../../kernel/terms.wap"
use "../../../kernel/inductive.wap"
use "../../../kernel/environment.wap"
use "../../../kernel/typing.wap"
use "../../../kernel/equal.wap"
use "../../../kernel/compute.wap"
use "../../../kernel/recursors.wap"
use "../../../core/analyze/holes.wap"
use "../../../core/analyze/unify.wap"
use "goals.wap"

# the steps each side may take before the prover gives up on it
REWRITE_LIMIT := 64
# the names of the variables a carried proof's motive binds
CARRIED_VALUE := "y"
CARRIED_PROOF := "e"
# the refusal of laws named in `by` that rewrite a side without end
ENDLESS := "endless rewriting"
# what separates a law's name from the place it rewrote
PLACE_MARK := "@"
# what names a hypothesis among the rewriters
GIVEN := "given "

# A law that rewrites, the function its left side applies to how many arguments, which a part must apply alike before
# the law is matched against it, and whether it rewrites only once at a place, a named law that does not orient
class Rewriter { name: text; made: () -> LawInstance; function: text; count: int; once: bool }
# One rewrite: a proof of the part's equation, the term around the part, given what stands in the part, and the law
# and place it rewrote
class Rewrite { equation: Equation; proof: Term; around: (Term) -> Term; place: text }
# A side rewritten: the terms it became, the side first, and the steps between them
class Rewritten { terms: list<Term>; steps: list<Rewrite> }

by_rewriting(goal: Goal): Term? := {
	equation = equation_of(goal.el.c, goal.statement) ?? return ø
	laws = laws_of(goal).map(law => rewriter_of(goal, law.name, () => instance_of(goal.el, law), goal.named.any(named => named.name == law.name)))
	# a hypothesis rewrites as a law `by` names does, even where it does not orient: what the goal assumes is what it
	# is about, often an equation of two variables, which no order turns down; it rewrites once at each place
	given = goal.parameters.map(parameter => rewriter_of(goal, GIVEN + "${variable_id(parameter)}", () => LawInstance(parameter, [], filled(goal.el, type_of(goal.el.c, parameter))), yes))
	rules = (laws + given).compact()
	if rules is empty { return ø }
	left = rewritten(goal, rules, equation.left)
	right = rewritten(goal, rules, equation.right)
	# the first term of the right side the left side reaches, and the steps each side takes to it
	back = right.terms.index_where(t => left.terms.any(u => equal(goal.el.c, u, t)))
	if back == 0 { return ø }
	ahead = left.terms.index_where(u => equal(goal.el.c, u, right.terms#back))
	if ahead + back == 2 { return ø }
	# a proof of `left == t`, t the left side rewritten and then the right side's steps undone
	forward = left.steps.take(ahead - 1).fold(reflexivity(goal.el.c, equation, equation.left), (proof, step) => continued(goal, equation, step, proof))
	right.steps.take(back - 1).reverse().fold(forward, (proof, step) => continued(goal, equation, reversed(goal, step), proof))
}
# a proof of `left == t` carried along a rewrite of a part of t
continued(goal: Goal, equation: Equation, step: Rewrite, proof: Term): Term := carried(goal.el.c, step.equation, step.proof, proof, t => stated(equation, equation.left, step.around(t)))

# a law as a rewriter where it orients or `by` names it, a hypothesis always; ø elsewhere. A law orients where each
# step goes down: its left side holds all its parameters and is bigger than its right, or as big with a head defined
# above the right's head and no parameter standing more often on the right
rewriter_of(goal: Goal, name: text, made: () -> LawInstance, named: bool): Rewriter? := {
	el = goal.el
	instance = taken_back(el, made)
	equation = equation_of(el.c, instance.conclusion) ?? return ø
	held = holes_in(el, equation.left)
	left_size = term_size(el, equation.left)
	right_size = term_size(el, equation.right)
	goes_down = left_size > right_size or (left_size == right_size and above(el.c, head(equation.left), head(equation.right)) and held.all(id => occurrences(equation.right, id) <= occurrences(equation.left, id)))
	orients = goes_down and instance.holes.all(found => hole_id(found) in held)
	if not orients and not named { return ø }
	match head(equation.left).shape {
		Constant(function, levels, _) => Rewriter(name, made, function, #arguments(equation.left), not orients)
		_ => ø
	}
}
# whether a function is defined above another: its definition names it, or names a function defined above it
above(c: Checker, function: Term, other: Term): bool := match function.shape {
	Constant(name, levels, _) => match other.shape {
		Constant(other_name, other_levels, _) => defined_above(c, name, other_name)
		_ => no
	}
	_ => no
}
defined_above(c: Checker, name: text, other: text): bool := match (declaration(c.environment, name) ?? return no).kind {
	Defined(value) => constants_in(value).map(constant_name).any(named => named == other or defined_above(c, named, other))
	_ => no
}
# how often a variable stands in a term
occurrences(t: Term, id: int): int := match t.shape {
	Free(found) => if found == id then 1 else 0
	_ => parts(t).fold(0, (count, part) => count + occurrences(part, id))
}
# how many terms a term is made of, a hole counted as one
term_size(el: Elaboration, t: Term): int := if is_hole_applied(el, t) then 1 else parts(t).fold(1, (size, part) => size + term_size(el, part))
is_hole_applied(el: Elaboration, t: Term): bool := match head(t).shape {
	Free(id) => el.holes.has(id)
	_ => no
}
hole_id(found: Term): int := variable_id(head(found))

# a side rewritten step by step until no rule matches a part of it. Each step goes down in size, or keeps it and goes
# down at the head only, so that order alone does not end every rewriting: the limit does. A side still rewriting at
# the limit is refused, naming the rules: by a law `by` names, for the program to name fewer; else the prover gives
# up on the goal
rewritten(goal: Goal, rules: list<Rewriter>, side: Term): Rewritten := {
	done = Rewritten([side], [])
	while #done.steps < REWRITE_LIMIT {
		used = done.steps.map(step => step.place)
		step = step_in(goal, rules, done.terms.last, t => t, "", used) ?? return done
		done.steps += [step]
		done.terms += [step.around(step.equation.right)]
	}
	rewriting = rules.filter(rule => done.steps.any(step => step.place.starts_with(rule.name + PLACE_MARK))).map(rule => rule.name)
	named = goal.named.map(law => law.name).filter(name => name in rewriting)
	if named is not empty { refused(ENDLESS, "the laws `by` names rewrite a side without end: ${named.join(", ")}; name fewer laws in `by`") }
	refused(GAVE_UP, "rewriting a side took more than ${REWRITE_LIMIT} steps, by ${rewriting.join(", ")}")
}
# the first rewrite of a term or of one of its parts, outermost first; around gives the whole term of a part, path
# names the part's place, and used the places rewritten so far
step_in(goal: Goal, rules: list<Rewriter>, t: Term, around: (Term) -> Term, path: text, used: list<text>): Rewrite? := {
	for rule in rules {
		place = rule.name + PLACE_MARK + path
		if not (rule.once and place in used) {
			step = rewrite_at(goal, rule, t, around, place)
			if step is not ø { return step }
		}
	}
	match t.shape {
		Apply(function, argument) => step_in(goal, rules, function, inner => around(apply(inner, argument)), path + "f", used) ?? step_in(goal, rules, argument, inner => around(apply(function, inner)), path + "a", used)
		_ => ø
	}
}
# a rule's law matched against a term, the proof that it equals the law's right side there; ø where it does not
# match or changes nothing, the holes of the try taken back
rewrite_at(goal: Goal, rule: Rewriter, t: Term, around: (Term) -> Term, place: text): Rewrite? := {
	el = goal.el
	part = applied_alike(el.c, t, rule) ?? return ø
	attempt(el, () => {
		instance = rule.made()
		if not matched(el, equation_of(el.c, instance.conclusion)!.left, part) { return ø }
		proof = filled(el, instance.proof)
		equation = equation_of(el.c, filled(el, instance.conclusion))!
		if open(el, proof) or same(equation.left, equation.right) then ø else Rewrite(equation, proof, around, place)
	})
}
# a law's left side matched against a part as written: a hole takes the part it stands at, a piece without holes
# computes to the same, and the rest is alike piece by piece; matching never computes a piece with holes, which
# would let a law's left side match any term it computes from
matched(el: Elaboration, pattern: Term, t: Term): bool := {
	p = filled(el, pattern)
	if not open(el, p) { return equal(el.c, p, t) }
	if is_hole_applied(el, p) { return unified(el, p, t) }
	match p.shape {
		Apply(function, argument) => match t.shape {
			Apply(other_function, other_argument) => matched(el, function, other_function) and matched(el, argument, other_argument)
			_ => no
		}
		Constant(name, levels, _) => match t.shape {
			Constant(other, other_levels, _) => name == other and #levels == #other_levels and paired(levels, other_levels, (a, b) => levels_unified(el, a, b)).all(fits => fits)
			_ => no
		}
		_ => no
	}
}
# a part as the rule's function applies to its arguments, its definitions unfolded until it does: `x + y` as
# `add(x, y)`; ø where it never does
applied_alike(c: Checker, t: Term, rule: Rewriter): Term? := match head(t).shape {
	Constant(name, levels, _) => {
		if name == rule.function and #arguments(t) == rule.count { return t }
		applied_alike(c, computed_folded(c, unfolded(c, t) ?? return ø), rule)
	}
	_ => ø
}

# a proof of `motive(a)` carried along a proof of the equation `a == b` to a proof of `motive(b)`, by the equality's
# recursor, the motive a proposition
carried(c: Checker, equation: Equation, proof: Term, start: Term, motive: (Term) -> Term): Term := {
	value = hypothesis(c, CARRIED_VALUE, equation.type)
	along = hypothesis(c, CARRIED_PROOF, stated(equation, equation.left, value))
	recursor = constant_of(c.environment, recursor_name(constant_name(equation.equality)), [Zero] + equation.levels)
	apply_all(recursor, [equation.type, equation.left, closed_over(c, motive(value), [value, along], yes), start, equation.right, proof])
}
# a step turned round: a proof of `b == a` from its proof of `a == b`, carried from `a == a`
reversed(goal: Goal, step: Rewrite): Rewrite := {
	e = step.equation
	turned = Equation(e.equality, e.levels, e.type, e.right, e.left)
	Rewrite(turned, carried(goal.el.c, e, step.proof, reflexivity(goal.el.c, e, e.left), t => stated(e, t, e.left)), step.around, step.place)
}
