# `wap verify program.wap` (wiki/law.md "Checking a law", wiki/proof.md "Checking proofs"), run as `verify.wasm
# --seed <seed folder> program.wap` by the native wap or with `--tree <root>` (options.wap): one verdict per law the
# program states, in their order, the kernel's (laws.wap). Proved: its function computes to yes, or the provers proved
# it for every value of its binders and the kernel checked the proof. FAILED: it computes to no. Untested: the kernel
# leaves it open, and the run's verdict stands in its place (native/driver.wap). A refusal is printed in its law's
# place; the first refusal of the program ends the run. The run fails when a law does.
use "laws.wap"
use "options.wap"
use "../../../kernel/environment.wap"

PROVED := "Proved"
UNTESTED := "Untested"
ASSUMED := "Assumed"
AXIOM := "Axiom"
BROKEN := "FAILED"
FAILED_EXIT := 1

RESTS_ON := ", rests on "

# a law's verdict as printed, or the refusal that leaves it none; a proved law resting on an assume is Assumed, one
# resting on axioms names them (wiki/proof.md "What a proof rests on")
verdict(law: TypedLaw, assumed: list<text>, names: map<text, text>): text := {
	typed = try typed_verdict(law) catch refusal {
		refusal_only(refusal)
		return refusal.message
	}
	"${law.name}: ${match typed { Holds => proved_said(law, assumed, names); Breaks => BROKEN; Open => UNTESTED; Assumed => ASSUMED; Axiom => AXIOM }}"
}
# (the axioms by their laws' names, a proof's theorem going by its function's key in the kernel)
proved_said(law: TypedLaw, assumed: list<text>, names: map<text, text>): text := {
	resting = resting_on(kernel_name(law)).map(name => names.get(name) ?? name)
	if resting.any(axiom => assumed.contains(axiom)) then ASSUMED else if resting is empty then PROVED else PROVED + RESTS_ON + resting.join(", ")
}

# The rule the law run reads a law with hypotheses by (native/driver.wap): the law as sugar writes it, its binders
# holes, taken to the law of its other binders whose statement holds where its hypotheses do, `if h then statement else
# yes`, so a trial where a hypothesis computes to no holds without its statement running
run_rule(law: TypedLaw): text := {
	holes = (1 to #law.binders).map(at => "$p${at}: $t${at}")
	hypotheses = (1 to #law.binders).filter(at => law.given.any(premise => premise.binder == law.binders#at))
	kept = (1 to #law.binders).filter(at => not hypotheses.contains(at)).map(at => holes#at)
	held = hypotheses.reverse.fold("$statement", (statement, at) => "(if $t${at} then ${statement} else yes)")
	"rule law(${law.name}: ((${holes.join(", ")}) -> $statement)) => law(${law.name}: ((${kept.join(", ")}) -> ${held}))"
}

try {
	arguments = door_arguments(args)
	laws = laws_typed(arguments.wap_folder, door_program(arguments))
	if arguments.run_rules != "" { write(arguments.run_rules, laws.filter(law => law.given is not empty).map(run_rule).map(rule => rule + "\n").join("")) }
	assumed = laws.filter(law => is_assume(law.proof)).map(law => law.name)
	names: map<text, text> = {}
	for law in laws { names[kernel_name(law)] = law.name }
	verdicts = laws.map(law => verdict(law, assumed, names))
	for line in verdicts { print line }
	if verdicts.any(line => line.ends_with(": " + BROKEN)) { exit(FAILED_EXIT) }
} catch refusal { stopped_by(refusal) }
