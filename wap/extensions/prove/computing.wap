# Proof by computing (wiki/proof.md "By computing"): an equation whose two sides compute to the same, for every value
# of its parameters, is proved by `refl`
use "../theory/terms.wap"
use "../theory/equal.wap"
use "goals.wap"

by_computing(goal: Goal): Term? := {
	equation = equation_of(goal.c, goal.statement) ?? return ø
	if not equal(goal.c, equation.left, equation.right) { return ø }
	apply_all(constant(reflexive(goal.c, equation.equality), equation.levels), [equation.type, equation.left])
}
