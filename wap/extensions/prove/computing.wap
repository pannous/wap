# Proof by computing (wiki/proof.md "By computing"): an equation whose two sides compute to the same, for every value
# of its parameters, is proved by `refl`; a statement with holes is no such equation yet
use "../theory/terms.wap"
use "../theory/equal.wap"
use "../theory/elaborate/unify.wap"
use "goals.wap"

by_computing(goal: Goal): Term? := {
	if open(goal.el, goal.statement) { return ø }
	equation = equation_of(goal.el.c, goal.statement) ?? return ø
	if not equal(goal.el.c, equation.left, equation.right) { return ø }
	reflexivity(goal.el.c, equation, equation.left)
}
