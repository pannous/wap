# Proof by a fact (wiki/proof.md "Ways to prove"): a goal that is one of its own hypotheses, or what an earlier law
# concludes, the law's premises left open answered by the hypotheses or by computing
use "../theory/typing.wap"
use "../theory/equal.wap"
use "../theory/elaborate/state.wap"
use "../theory/elaborate/unify.wap"
use "goals.wap"
use "computing.wap"

by_fact(goal: Goal): Term? := {
	hypothesis = goal.parameters.find(parameter => is_proof_of(goal, parameter))
	if hypothesis is not ø { return hypothesis }
	for law in laws_of(goal) {
		proof = applied_law(goal, law, instance => yes, premise => premise_answered(goal, premise))
		if proof is not ø { return proof }
	}
	ø
}

# whether a hypothesis states the goal
is_proof_of(goal: Goal, parameter: Term): bool := equal(goal.el.c, type_of(goal.el.c, parameter), goal.statement)

# a premise the conclusion left open given the first hypothesis of its type, or proved by computing
premise_answered(goal: Goal, premise: Term): bool := {
	el = goal.el
	wanted = type_of(el.c, premise)
	computed_proof = if open(el, filled(el, wanted)) then ø else by_computing(Goal(el, goal.parameters, filled(el, wanted), goal.named))
	if computed_proof is not ø and attempt(el, () => if unified(el, premise, computed_proof!) then premise else ø) is not ø { return yes }
	goal.parameters.any(parameter => attempt(el, () => if unified(el, wanted, type_of(el.c, parameter)) and unified(el, premise, parameter) then parameter else ø) is not ø)
}
