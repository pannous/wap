# Proof by a fact (wiki/proof.md "Ways to prove"): a goal that is one of its own hypotheses, or what an earlier law
# concludes, the law's premises left open answered by the hypotheses
use "../theory/typing.wap"
use "../theory/equal.wap"
use "../theory/elaborate/state.wap"
use "../theory/elaborate/unify.wap"
use "goals.wap"

by_fact(goal: Goal): Term? := {
	hypothesis = goal.parameters.find(parameter => is_proof_of(goal, parameter))
	if hypothesis is not ø { return hypothesis }
	for law in goal.named + proved_laws(goal.el.c.environment) {
		proof = law_concluding(goal, law)
		if proof is not ø { return proof }
	}
	ø
}

# whether a hypothesis states the goal
is_proof_of(goal: Goal, parameter: Term): bool := equal(goal.el.c, type_of(goal.el.c, parameter), goal.statement)

# a law whose conclusion is the goal, applied; ø where it concludes something else, its holes taken back
law_concluding(goal: Goal, law: Declaration): Term? := {
	el = goal.el
	kept = found_so_far(el)
	instance = instance_of(el, law)
	if unified(el, instance.conclusion, goal.statement) and instance.holes.all(premise => answered_by_hypothesis(goal, premise)) {
		proof = filled(el, instance.proof)
		if not open(el, proof) { return proof }
	}
	back_to(el, kept)
	ø
}

# a premise the conclusion left open given the first hypothesis of its type
answered_by_hypothesis(goal: Goal, premise: Term): bool := {
	el = goal.el
	if not open(el, filled(el, premise)) { return yes }
	wanted = type_of(el.c, premise)
	goal.parameters.any(parameter => {
		kept = found_so_far(el)
		if unified(el, wanted, type_of(el.c, parameter)) and unified(el, premise, parameter) { return yes }
		back_to(el, kept)
		no
	})
}
