# Proof by a fact (wiki/proof.md "Ways to prove"): a goal that is one of its own hypotheses, or what an earlier law
# concludes, the law's premises left open answered as introduction.wap answers them
use "goals.wap"
use "introduction.wap"

by_fact(goal: Goal): Term? := {
	hypothesis = by_hypothesis(goal)
	if hypothesis is not ø { return hypothesis }
	for law in laws_of(goal) {
		proof = applied_law(goal, law, instance => yes, premise => premise_answered(goal, premise))
		if proof is not ø { return proof }
	}
	ø
}
