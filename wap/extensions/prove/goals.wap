# A goal of the provers (prove.wap): a statement gone into, and the equations they read
use "../theory/terms.wap"
use "../theory/environment.wap"
use "../theory/compute.wap"
use "../theory/inductive.wap"

# what a prover is asked: the statement under its parameters, each a hypothesis of the checker
class Goal { c: Checker; parameters: list<Term>; statement: Term }

# a statement gone into: each parameter of its function type a hypothesis, the rest the goal
goal_of(c: Checker, statement: Term): Goal := {
	goal = Goal(c, [], statement)
	while yes {
		match computed(c, goal.statement).shape {
			Pi(binder, domain, body) => {
				parameter = hypothesis(c, binder, domain)
				goal.parameters += [parameter]
				goal.statement = instantiated(body, parameter)
			}
			_ => return goal
		}
	}
	goal
}

# an equation `Equal(T, left, right)` taken apart: the equality applied, its levels, the type and the two sides
class Equation { equality: text; levels: list<Level>; type: Term; left: Term; right: Term }
# a statement computed to an equation of a type like the prelude's Equal; ø for any other
equation_of(c: Checker, statement: Term): Equation? := {
	t = computed(c, statement)
	sides = arguments(t)
	match head(t).shape {
		Constant(name, levels) => if #sides == 3 and is_equality(c, name) then Equation(name, levels, sides#1, sides#2, sides#3) else ø
		_ => ø
	}
}
# whether a name declares a type like the prelude's Equal (inductive.wap equality_checked)
is_equality(c: Checker, name: text): bool := try { equality_checked(c.environment, name, ""); yes } catch shape { no }
# the one case of an equality, `refl`
reflexive(c: Checker, equality: text): text := match declared_named(c.environment, equality).kind {
	Inductive(facts) => facts.block.types#1.cases#1.name
	_ => raise "${equality} is no equality"
}
