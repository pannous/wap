# Proof by induction (wiki/proof.md "By induction"; notes/coc-plan.md P4): a goal over a value of an enum is what
# the enum's recursor concludes, the recursor taken as a law. Its value is the parameter and its motive the goal with
# that parameter made a binder, which unifying the recursor's conclusion with the goal finds; each case's premise,
# the goal at the case under its fields and the hypotheses that it holds of the fields of the enum itself, is proved
# by the provers before this one. So `fact(n) > 0` is proved along fact's own recursion: at zero by computing, at a
# successor by the helper law, its premises the hypothesis at the field and computing
use "../theory/terms.wap"
use "../theory/environment.wap"
use "../theory/typing.wap"
use "../theory/compute.wap"
use "../theory/recursors.wap"
use "../theory/elaborate/state.wap"
use "../theory/elaborate/unify.wap"
use "goals.wap"
use "computing.wap"
use "facts.wap"
use "rewriting.wap"

# the provers a case's premise is proved by
CASE_PROVERS: list<(Goal) -> Term?> := [by_computing, by_fact, by_rewriting]

by_induction(goal: Goal): Term? := {
	for parameter in goal.parameters {
		proof = along(goal, parameter)
		if proof is not ø { return proof }
	}
	ø
}
# the goal proved by the recursor of a parameter's type, the parameter its value and the goal over it its motive; ø
# for a type of no enum, of several naming each other, or with indices
along(goal: Goal, value: Term): Term? := {
	el = goal.el
	type = computed(el.c, type_of(el.c, value))
	enum = match head(type).shape {
		Constant(name, levels) => name
		_ => return ø
	}
	recursor = declaration(el.c.environment, recursor_name(enum)) ?? return ø
	facts = match recursor.kind {
		Recursor(facts) => facts
		_ => return ø
	}
	if facts.motives > 1 or facts.indices > 0 { return ø }
	motive = closed_filled(el, goal.statement, [value], yes)
	applied_law(goal, recursor, instance => unified(el, instance.holes#(facts.parameters + 1), motive) and valued(el, instance.holes.last, value, type), premise => case_proved(goal, premise))
}
# a hole given a value of the type it is given at
valued(el: Elaboration, hole: Term, value: Term, type: Term): bool := unified(el, type_of(el.c, hole), type) and unified(el, hole, value)
# a case's premise proved under its fields and hypotheses, the proof a function of them
case_proved(goal: Goal, premise: Term): bool := {
	el = goal.el
	case = goal_of(el, filled(el, type_of(el.c, premise)), goal.named)
	within = Goal(el, goal.parameters + case.parameters, case.statement, goal.named)
	proof = first_proof(within, CASE_PROVERS) ?? return no
	unified(el, premise, closed_filled(el, proof, case.parameters, yes))
}
