# int's laws the linear prover builds its proofs of (linear.wap), each a theorem the kernel checks
# (notes/unify-provers.md "Recommended proof route"). An int is the difference of its two counts, so each law becomes
# an equation or a comparison of counts: the counts' sums are regrouped by the count's add laws, and the parts of a
# difference by `difference_parts`. Declared once, before the first goal a prover is given (goals.wap), so a
# compile that proves nothing never checks them.

use "../../kernel/terms.wap"
use "../../kernel/levels.wap"
use "../../kernel/environment.wap"
use "../../kernel/typing.wap"
use "../../kernel/equal.wap"
use "../../kernel/show.wap"
use "../../kernel/numbers.wap"
use "../../kernel/recursors.wap"
use "../../kernel/equality.wap"
use "../../kernel/logic.wap"
use "../../kernel/counting.wap"

# the bridge's theorems, between `(a == b) == yes` and `Equal(T, a, b)`
COUNT_EQUALS_ITSELF := "·count_equals_itself"
COUNT_ZERO_ADD := "·count_zero_add"
COUNT_EQUALS_SOUND := "·count_equals_sound"
EQUAL_INTEGERS_ITSELF := "·equal_integers_itself"
EQUALS_SOUND := "·equals_sound"
EQUALS_COMPLETE := "·equals_complete"

ZERO_ADD := "·zero_add"
ADD_ZERO := "·add_zero"
ADD_COMMUTATIVE := "·add_commutative"
ADD_ASSOCIATIVE := "·add_associative"
ADD_MINUS := "·add_minus"
MINUS_ADD := "·minus_add"
ADD_CANCEL := "·add_cancel"
ADD_DIFFERENCE := "·add_difference"
DIFFERENCE_NONNEGATIVE := "·difference_nonnegative"
NONNEGATIVE_ADD := "·nonnegative_add"
GAP_BOUND := "·gap_bound"
BEYOND_NOT_ABOVE := "·beyond_not_above"
BOTH_FIRST := "·both_first"
BOTH_SECOND := "·both_second"
ZERO_TIMES := "·zero_times"
ONE_TIMES := "·one_times"
TIMES_COMMUTATIVE := "·times_commutative"
TIMES_DISTRIBUTIVE := "·times_distributive"
TIMES_NEGATED := "·times_negated"
# the count's laws they rest on
SUCCESSOR_ADD := "·count_successor_add"
COUNT_COMMUTATIVE := "·count_add_commutative"
COUNT_ASSOCIATIVE := "·count_add_associative"
ZERO_MULTIPLY := "·count_zero_multiply"
SUCCESSOR_MULTIPLY := "·count_successor_multiply"
MULTIPLY_COMMUTATIVE := "·count_multiply_commutative"
MULTIPLY_DISTRIBUTIVE := "·count_multiply_distributive"
MULTIPLY_DISTRIBUTIVE_RIGHT := "·count_multiply_distributive_right"
AT_MOST_SHIFTED := "·at_most_shifted"
AT_MOST_ADD := "·at_most_add"
AT_MOST_SPLIT := "·at_most_split"
AT_MOST_BEYOND := "·at_most_beyond"
PARTS_BACK := "·parts_back"
MINUS_PARTS := "·minus_parts"
DIFFERENCE_PARTS := "·difference_parts"
DIFFERENCE_SHIFTED := "·difference_shifted"
DIFFERENCE_EQUAL := "·difference_equal"
SUM_DIFFERENCE := "·sum_difference"
MINUS_DIFFERENCE := "·minus_difference"
TIMES_DIFFERENCE := "·times_difference"
NOT_ABOVE_DIFFERENCE := "·not_above_difference"
# Lean's sum and order (kernel/counting.wap int_declared) as the crossed counts the laws go by
COUNTS_SUBTRACTED_DIFFERENCE := "·counts_subtracted_difference"
NATURAL_DIFFERENCE := "·natural_difference"
SUM_CROSSED := "·sum_crossed"
TIMES_CROSSED := "·times_crossed"
# one step up and down joined to int's two cases, each by computing
NATURAL_STEP := "·natural_step"
NEGATIVE_ZERO_STEP := "·negative_zero_step"
NEGATIVE_STEP := "·negative_step"
ZERO_STEP_BACK := "·zero_step_back"

# an int as the difference of two counts, and the proof that it is `difference(up, down)`
class Counts { up: Term; down: Term; identity: Identity }

# int's laws declared once, where core declared int and they are not yet
integer_laws_ready(e: Environment) := if e.integers != ø and declaration(e, ZERO_ADD) is ø { integer_laws_declared(e) }
integer_laws_declared(e: Environment) := {
	b = building(e)
	count_bridge_declared(b)
	int_bridge_declared(b)
	bridge = bridge_at(e, e.integers!.type)!
	bridge.sound = named(b, EQUALS_SOUND)
	bridge.complete = named(b, EQUALS_COMPLETE)
	count_laws_declared(b)
	crossed_laws_declared(b)
	difference_laws_declared(b)
	sum_laws_declared(b)
	product_laws_declared(b)
	order_laws_declared(b)
	truth_laws_declared(b)
	step_laws_declared(b)
}

# --- equations as values

# a theorem applied, its statement the equation of these two sides
applied(b: Building, type: Term, name: text, given: list<Term>, left: Term, right: Term): Identity := Identity(type, left, right, called(b, name, given))
# a proof of `value == yes`, as an equation
yes_known(b: Building, value: Term, proof: Term): Identity := Identity(truth_of(b), value, b.e.literals!.yes_case, proof)

# --- a commutative monoid's sums regrouped

# A commutative monoid: its type, zero and addition, its laws as equations, `0 + t == t`,
# `(a + b) + c == a + (b + c)` and `a + b == b + a`, and the rank its sums are ordered by, the lower first
class Monoid { c: Checker; type: Term; zero: Term; addition: Term; zero_law: (Term) -> Identity; grouping_law: (Term, Term, Term) -> Identity; order_law: (Term, Term) -> Identity; rank: (Term) -> int }
# atoms ranked by their hashes
hash_rank(t: Term): int := t.hash
# terms in one order, and the proof that a sum is their sum in it
class Ordered { atoms: list<Term>; identity: Identity }
plus(m: Monoid, left: Term, right: Term): Term := apply_all(m.addition, [left, right])
# the sum of atoms in one order, `((0 + x1) + …) + xk`
total(m: Monoid, atoms: list<Term>): Term := atoms.fold(m.zero, (sum, atom) => plus(m, sum, atom))
# t as the sum of its atoms in order: each part that is no sum and does not compute to zero
ordered(m: Monoid, t: Term): Ordered := {
	if equal(m.c, t, m.zero) { return Ordered([], Identity(m.type, t, m.zero, reflexive(m.c.environment, TYPE_LEVEL, m.type, t))) }
	if #arguments(t) != 2 or not is_constant(head(t), m.addition) { return Ordered([t], flipped(m.c, m.zero_law(t))) }
	left = ordered(m, arguments(t)#1)
	right = ordered(m, arguments(t)#2)
	both = merged(m, left.atoms, right.atoms)
	Ordered(both.atoms, followed(m.c, [both_added(m, left.identity, right.identity), both.identity]))
}
# `total(xs) + total(ys) == total(both in order)`, xs in order
merged(m: Monoid, xs: list<Term>, ys: list<Term>): Ordered := {
	if ys is empty { return Ordered(xs, followed(m.c, [m.order_law(total(m, xs), m.zero), m.zero_law(total(m, xs))])) }
	rest = ys.take(#ys - 1)
	top = ys.last()
	regrouped = flipped(m.c, m.grouping_law(total(m, xs), total(m, rest), top))
	further = appended(m, merged(m, xs, rest), top)
	Ordered(further.atoms, followed(m.c, [regrouped, further.identity]))
}
# a sum in order plus one more atom, in order
appended(m: Monoid, inner: Ordered, atom: Term): Ordered := {
	further = inserted(m, inner.atoms, atom)
	Ordered(further.atoms, followed(m.c, [mapped(m.c, m.type, z => plus(m, z, atom), inner.identity), further.identity]))
}
# `total(xs) + atom` in order: the atom swapped down past each that goes after it
inserted(m: Monoid, xs: list<Term>, atom: Term): Ordered := {
	if xs is empty or m.rank(xs.last()) <= m.rank(atom) { return Ordered(xs + [atom], itself(m.c, m.type, plus(m, total(m, xs), atom))) }
	rest = xs.take(#xs - 1)
	top = xs.last()
	inner = inserted(m, rest, atom)
	Ordered(inner.atoms + [top], followed(m.c, [swapped(m, total(m, rest), top, atom), mapped(m.c, m.type, z => plus(m, z, top), inner.identity)]))
}
# `(x + a) + c == (x + c) + a`
swapped(m: Monoid, x: Term, a: Term, c: Term): Identity := followed(m.c, [m.grouping_law(x, a, c), mapped(m.c, m.type, z => plus(m, x, z), m.order_law(a, c)), flipped(m.c, m.grouping_law(x, c, a))])
# `a + c == b + d` from `a == b` and `c == d`
both_added(m: Monoid, first: Identity, second: Identity): Identity := mapped_both(m.c, m.type, (x, y) => plus(m, x, y), first, second)
# `from == to`, two sums of the same atoms, each of to's ranked by the place of the one of from's it computes to;
# refused for any other
rearranged(m: Monoid, from: Term, to: Term): Identity := {
	one = ordered(m, from)
	place_of_match = (atom: Term) => one.atoms.index_where(known => equal(m.c, known, atom))
	other = ordered(Monoid(m.c, m.type, m.zero, m.addition, m.zero_law, m.grouping_law, m.order_law, place_of_match), to)
	if not equal(m.c, one.identity.right, other.identity.right) { raise "the sums ${shown(from)} and ${shown(to)} are not of the same atoms" }
	followed(m.c, [one.identity, flipped(m.c, other.identity)])
}

# --- the count's sums

count_of(b: Building): Term := named(b, COUNT)
add(b: Building, left: Term, right: Term): Term := called(b, ADD, [left, right])
# the counts with their add laws
count_sums(b: Building): Monoid := {
	count = count_of(b)
	Monoid(b.c, count, named(b, COUNT_ZERO), named(b, ADD), t => zero_added(b, t), (x, y, z) => applied(b, count, COUNT_ASSOCIATIVE, [x, y, z], add(b, add(b, x, y), z), add(b, x, add(b, y, z))), (x, y) => applied(b, count, COUNT_COMMUTATIVE, [x, y], add(b, x, y), add(b, y, x)), hash_rank)
}
# `from == to` through known equations: from regrouped to their left sides' sum, then to their right sides'
through(b: Building, from: Term, knowns: list<Identity>, to: Term): Identity := {
	known = knowns.drop(1).fold(knowns#1, (sum, i) => both_added(count_sums(b), sum, i))
	followed(b.c, [distributed(b, from, known.left), known, distributed(b, known.right, to)])
}
# a term's two operands where it is a call of that two-place function, ø for any other
operands(b: Building, t: Term, function: text): list<Term>? := if #arguments(t) == 2 and is_constant(head(t), named(b, function)) then arguments(t) else ø

# --- the count's products

multiply(b: Building, left: Term, right: Term): Term := called(b, MULTIPLY, [left, right])
# `from == to` of two sums of counts with the same products of atoms once each is expanded
distributed(b: Building, from: Term, to: Term): Identity := {
	there = expanded(b, from)
	back = expanded(b, to)
	followed(b.c, [there, rearranged(count_sums(b), there.right, back.right), flipped(b.c, back)])
}
# a sum of counts as a sum of products of atoms, each product in it expanded
expanded(b: Building, t: Term): Identity := {
	summed = operands(b, t, ADD)
	if summed != ø {
		sides = summed!
		return both_added(count_sums(b), expanded(b, sides#1), expanded(b, sides#2))
	}
	factors = operands(b, t, MULTIPLY) ?? return itself(b.c, count_of(b), t)
	product_expanded(b, factors#1, factors#2)
}
# `m·n` as a sum of products of atoms: a factor computing to zero gives zero, which a sum drops; a sum in either factor
# is distributed and a factor computing to a successor taken one off, by the product's laws; a product of two atoms
# has its factors in rank order
product_expanded(b: Building, m: Term, n: Term): Identity := {
	count = count_of(b)
	zero = named(b, COUNT_ZERO)
	product = multiply(b, m, n)
	further = (sum: Term, proof: Term) => followed(b.c, [Identity(count, product, sum, proof), expanded(b, sum)])
	if equal(b.c, n, zero) { return itself(b.c, count, product) }
	if equal(b.c, m, zero) { return Identity(count, product, zero, called(b, ZERO_MULTIPLY, [n])) }
	left_sum = operands(b, m, ADD)
	if left_sum != ø {
		sides = left_sum!
		return further(add(b, multiply(b, sides#1, n), multiply(b, sides#2, n)), called(b, MULTIPLY_DISTRIBUTIVE, [sides#1, sides#2, n]))
	}
	right_sum = operands(b, n, ADD)
	if right_sum != ø {
		sides = right_sum!
		return further(add(b, multiply(b, m, sides#1), multiply(b, m, sides#2)), called(b, MULTIPLY_DISTRIBUTIVE_RIGHT, [m, sides#1, sides#2]))
	}
	before_n = called(b, PREDECESSOR, [n])
	if equal(b.c, n, successor(b, before_n)) {
		sum = add(b, multiply(b, m, before_n), m)
		return further(sum, reflexive(b.e, TYPE_LEVEL, count, sum))
	}
	before_m = called(b, PREDECESSOR, [m])
	if equal(b.c, m, successor(b, before_m)) { return further(add(b, multiply(b, before_m, n), n), called(b, SUCCESSOR_MULTIPLY, [before_m, n])) }
	if hash_rank(m) > hash_rank(n) { return applied(b, count, MULTIPLY_COMMUTATIVE, [m, n], product, multiply(b, n, m)) }
	itself(b.c, count, product)
}

# --- the count's laws

count_laws_declared(b: Building) := {
	count = count_of(b)
	m = entered(b.c, "m", count)
	n = entered(b.c, "n", count)
	k = entered(b.c, "k", count)
	# successor(m) + n == successor(m + n), by n
	successor_add = (j: Term) => counts_equal(b, add(b, successor(b, m.variable), j), successor(b, add(b, m.variable, j)))
	inducted(b, SUCCESSOR_ADD, [m, n], successor_add, reflexive(b.e, TYPE_LEVEL, count, successor(b, m.variable)), (j, h) => successors(b, Identity(count, add(b, successor(b, m.variable), j), successor(b, add(b, m.variable, j)), h)).proof, n.variable)
	# m + n == n + m, by n
	commuted = (j: Term) => counts_equal(b, add(b, m.variable, j), add(b, j, m.variable))
	commuted_step = (j: Term, h: Term) => followed(b.c, [successors(b, Identity(count, add(b, m.variable, j), add(b, j, m.variable), h)), flipped(b.c, successor_added(b, j, m.variable))]).proof
	inducted(b, COUNT_COMMUTATIVE, [m, n], commuted, flipped(b.c, zero_added(b, m.variable)).proof, commuted_step, n.variable)
	# (m + n) + k == m + (n + k), by k
	associated = (j: Term) => counts_equal(b, add(b, add(b, m.variable, n.variable), j), add(b, m.variable, add(b, n.variable, j)))
	inducted(b, COUNT_ASSOCIATIVE, [m, n, k], associated, reflexive(b.e, TYPE_LEVEL, count, add(b, m.variable, n.variable)), (j, h) => successors(b, Identity(count, add(b, add(b, m.variable, n.variable), j), add(b, m.variable, add(b, n.variable, j)), h)).proof, k.variable)
	at_most_laws_declared(b, m, n, k)
	multiply_laws_declared(b, m, n, k)
}
# a count equation by induction on its last binder, `left(j) == right(j)`: its base by computing, each step made from
# the equation at the count before
equation_inducted(b: Building, name: text, binders: list<Local>, left: (Term) -> Term, right: (Term) -> Term, base: Term, step: (Term, Identity) -> Identity) := {
	count = count_of(b)
	inducted(b, name, binders, j => counts_equal(b, left(j), right(j)), base, (j, h) => step(j, Identity(count, left(j), right(j), h)).proof, binders.last().variable)
}
# `h.left + x == to`: x added to both sides of h, the sum regrouped
added_to(b: Building, h: Identity, x: Term, to: Term): Identity := followed(b.c, [mapped(b.c, count_of(b), z => add(b, z, x), h), rearranged(count_sums(b), add(b, h.right, x), to)])
# the count's product laws, each by induction on its last binder: a product by a successor is the product by the
# count before plus the other factor
multiply_laws_declared(b: Building, m: Local, n: Local, k: Local) := {
	count = count_of(b)
	zero = named(b, COUNT_ZERO)
	zero_same = reflexive(b.e, TYPE_LEVEL, count, zero)
	mv = m.variable
	nv = n.variable
	# 0·n == 0
	equation_inducted(b, ZERO_MULTIPLY, [n], j => multiply(b, zero, j), j => zero, zero_same, (j, h) => h)
	# successor(m)·n == m·n + n: successor(m)·successor(j) is successor(successor(m)·j + m)
	equation_inducted(b, SUCCESSOR_MULTIPLY, [m, n], j => multiply(b, successor(b, mv), j), j => add(b, multiply(b, mv, j), j), zero_same, (j, h) => successors(b, added_to(b, h, mv, add(b, add(b, multiply(b, mv, j), mv), j))))
	# m·n == n·m
	at_zero = Identity(count, multiply(b, zero, mv), zero, called(b, ZERO_MULTIPLY, [mv]))
	equation_inducted(b, MULTIPLY_COMMUTATIVE, [m, n], j => multiply(b, mv, j), j => multiply(b, j, mv), flipped(b.c, at_zero).proof, (j, h) => followed(b.c, [added_to(b, h, mv, add(b, multiply(b, j, mv), mv)), flipped(b.c, applied(b, count, SUCCESSOR_MULTIPLY, [j, mv], multiply(b, successor(b, j), mv), add(b, multiply(b, j, mv), mv)))]))
	# (m + n)·k == m·k + n·k
	both = add(b, mv, nv)
	equation_inducted(b, MULTIPLY_DISTRIBUTIVE, [m, n, k], j => multiply(b, both, j), j => add(b, multiply(b, mv, j), multiply(b, nv, j)), zero_same, (j, h) => added_to(b, h, both, add(b, add(b, multiply(b, mv, j), mv), add(b, multiply(b, nv, j), nv))))
	# m·(n + k) == m·n + m·k
	first = multiply(b, mv, nv)
	equation_inducted(b, MULTIPLY_DISTRIBUTIVE_RIGHT, [m, n, k], j => multiply(b, mv, add(b, nv, j)), j => add(b, first, multiply(b, mv, j)), reflexive(b.e, TYPE_LEVEL, count, first), (j, h) => added_to(b, h, mv, add(b, first, add(b, multiply(b, mv, j), mv))))
}
at_most(b: Building, left: Term, right: Term): Term := called(b, AT_MOST, [left, right])
# `at_most(l + j, r + j) == at_most(l, r)`
at_most_shifted(b: Building, l: Term, r: Term, j: Term): Identity := applied(b, truth_of(b), AT_MOST_SHIFTED, [l, r, j], at_most(b, add(b, l, j), add(b, r, j)), at_most(b, l, r))
# `at_most(a, c) == at_most(b, d)` from `a == b` and `c == d`
at_most_both(b: Building, first: Identity, second: Identity): Identity := mapped_both(b.c, truth_of(b), (l, r) => at_most(b, l, r), first, second)
# `successor(m) + n == successor(m + n)`
successor_added(b: Building, m: Term, n: Term): Identity := applied(b, count_of(b), SUCCESSOR_ADD, [m, n], add(b, successor(b, m), n), successor(b, add(b, m, n)))
at_most_laws_declared(b: Building, m: Local, n: Local, k: Local) := {
	count = count_of(b)
	truth = truth_of(b)
	zero = named(b, COUNT_ZERO)
	# at_most(m + k, n + k) == at_most(m, n), by k: two successors compare as the counts before them
	shifted = (j: Term) => truths_equal(b.e, at_most(b, add(b, m.variable, j), add(b, n.variable, j)), at_most(b, m.variable, n.variable))
	inducted(b, AT_MOST_SHIFTED, [m, n, k], shifted, reflexive(b.e, TYPE_LEVEL, truth, at_most(b, m.variable, n.variable)), (j, h) => h, k.variable)
	# at_most(m, m + k) == yes: as at_most(0 + m, k + m), which is at_most(0, k)
	widened = at_most_both(b, flipped(b.c, zero_added(b, m.variable)), count_sums(b).order_law(m.variable, k.variable))
	theorem(b, AT_MOST_ADD, [m, k], truth_stated(b.e, at_most(b, m.variable, add(b, m.variable, k.variable))), followed(b.c, [widened, at_most_shifted(b, zero, k.variable, m.variable)]).proof)
	# at_most(m, n) == yes -> n == m + (n - m), by m for every n, each by n's cases
	split_at = (i: Term, j: Term) => pis([entered(b.c, "h", truth_stated(b.e, at_most(b, i, j)))], counts_equal(b, j, add(b, i, called(b, SUBTRACT, [j, i]))))
	split_zero = function_of(b, "n", count, j => assuming(b, truth_stated(b.e, at_most(b, zero, j)), h => flipped(b.c, zero_added(b, j)).proof))
	split_first = (i: Term) => assuming(b, truth_stated(b.e, at_most(b, successor(b, i), zero)), h => absurd(b, counts_equal(b, zero, add(b, successor(b, i), called(b, SUBTRACT, [zero, successor(b, i)]))), h))
	split_both = (i: Term, l: Term, before: Term) => assuming(b, truth_stated(b.e, at_most(b, successor(b, i), successor(b, l))), h => {
		known = Identity(count, l, add(b, i, called(b, SUBTRACT, [l, i])), apply(before, h))
		rest = called(b, SUBTRACT, [l, i])
		fixed = Identity(count, called(b, SUBTRACT, [successor(b, l), successor(b, i)]), rest, called(b, SUCCESSORS_SUBTRACT, [l, i]))
		followed(b.c, [successors(b, known), flipped(b.c, successor_added(b, i, rest)), mapped(b.c, count, z => add(b, successor(b, i), z), flipped(b.c, fixed))]).proof
	})
	hypothesis = entered(b.c, "h", truth_stated(b.e, at_most(b, m.variable, n.variable)))
	every = paired(b, Zero, split_at, split_zero, split_first, split_both, m.variable)
	theorem(b, AT_MOST_SPLIT, [m, n, hypothesis], counts_equal(b, n.variable, add(b, m.variable, called(b, SUBTRACT, [n.variable, m.variable]))), apply(apply(every, n.variable), hypothesis.variable))
	# not at_most(m, n) -> at_most(n + 1, m), by m for every n, each by n's cases
	one = successor(b, zero)
	refused = (i: Term, j: Term) => truth_stated(b.e, called(b, NEGATED, [at_most(b, i, j)]))
	beyond_at = (i: Term, j: Term) => pis([entered(b.c, "h", refused(i, j))], truth_stated(b.e, at_most(b, add(b, j, one), i)))
	beyond_zero = function_of(b, "n", count, j => assuming(b, refused(zero, j), h => absurd(b, truth_stated(b.e, at_most(b, add(b, j, one), zero)), h)))
	beyond_first = (i: Term) => assuming(b, refused(successor(b, i), zero), h => reflexive(b.e, TYPE_LEVEL, truth, b.e.literals!.yes_case))
	beyond_both = (i: Term, l: Term, before: Term) => assuming(b, refused(successor(b, i), successor(b, l)), h => apply(before, h))
	beyond = entered(b.c, "h", refused(m.variable, n.variable))
	every_beyond = paired(b, Zero, beyond_at, beyond_zero, beyond_first, beyond_both, m.variable)
	theorem(b, AT_MOST_BEYOND, [m, n, beyond], truth_stated(b.e, at_most(b, add(b, n.variable, one), m.variable)), apply(apply(every_beyond, n.variable), beyond.variable))
}

# --- an int as the difference of its counts

int_of(b: Building): Term := named(b, INT_WORD)
difference(b: Building, up: Term, down: Term): Term := called(b, DIFFERENCE, [up, down])
ups(b: Building, x: Term): Term := called(b, UPS, [x])
downs(b: Building, x: Term): Term := called(b, DOWNS, [x])
sum(b: Building, left: Term, right: Term): Term := called(b, SUM, [left, right])
minus(b: Building, x: Term): Term := called(b, MINUS, [x])

difference_laws_declared(b: Building) := {
	count = count_of(b)
	int = int_of(b)
	zero = named(b, COUNT_ZERO)
	x = entered(b.c, "x", int)
	# difference(ups(x), downs(x)) == x and -x == difference(downs(x), ups(x)), each case by computing
	by_cases = (name: text, left: (Term) -> Term, right: (Term) -> Term) => {
		stated = (t: Term) => ints_equal(b, left(t), right(t))
		theorem(b, name, [x], stated(x.variable), int_split(b, Zero, stated, (at, n) => reflexive(b.e, TYPE_LEVEL, int, left(valued(b, at, n))), x.variable))
	}
	by_cases(PARTS_BACK, t => difference(b, ups(b, t), downs(b, t)), t => t)
	by_cases(MINUS_PARTS, t => minus(b, t), t => difference(b, downs(b, t), ups(b, t)))
	m = entered(b.c, "m", count)
	n = entered(b.c, "n", count)
	p = entered(b.c, "p", count)
	q = entered(b.c, "q", count)
	# ups(difference(m, n)) + n == downs(difference(m, n)) + m, by m for every n, each by n's cases
	parts_at = (i: Term, j: Term) => counts_equal(b, add(b, ups(b, difference(b, i, j)), j), add(b, downs(b, difference(b, i, j)), i))
	parts_zero = function_of(b, "n", count, j => induced(b, l => parts_at(zero, l), reflexive(b.e, TYPE_LEVEL, count, zero), (l, r) => zero_added(b, successor(b, l)).proof, j))
	parts_first = (i: Term) => flipped(b.c, zero_added(b, successor(b, i))).proof
	parts_both = (i: Term, l: Term, before: Term) => successors(b, Identity(count, add(b, ups(b, difference(b, i, l)), l), add(b, downs(b, difference(b, i, l)), i), before)).proof
	every = paired(b, Zero, parts_at, parts_zero, parts_first, parts_both, m.variable)
	theorem(b, DIFFERENCE_PARTS, [m, n], parts_at(m.variable, n.variable), apply(every, n.variable))
	# difference(m + k, n + k) == difference(m, n), by k
	k = entered(b.c, "k", count)
	shifted = (j: Term) => ints_equal(b, difference(b, add(b, m.variable, j), add(b, n.variable, j)), difference(b, m.variable, n.variable))
	inducted(b, DIFFERENCE_SHIFTED, [m, n, k], shifted, reflexive(b.e, TYPE_LEVEL, int, difference(b, m.variable, n.variable)), (j, h) => h, k.variable)
	# m + q == p + n -> difference(m, n) == difference(p, q)
	h = entered(b.c, "h", counts_equal(b, add(b, m.variable, q.variable), add(b, p.variable, n.variable)))
	known = Identity(count, add(b, m.variable, q.variable), add(b, p.variable, n.variable), h.variable)
	commuted = count_sums(b).order_law(n.variable, q.variable)
	equal_chain = followed(b.c, [flipped(b.c, shift(b, m.variable, n.variable, q.variable)), mapped_both(b.c, int, (l, r) => difference(b, l, r), known, commuted), shift(b, p.variable, q.variable, n.variable)])
	theorem(b, DIFFERENCE_EQUAL, [m, n, p, q, h], ints_equal(b, difference(b, m.variable, n.variable), difference(b, p.variable, q.variable)), equal_chain.proof)
	differences_laws_declared(b, m, n, p, q)
}
# --- Lean's definitions as the crossed counts: m - n of counts as their paired difference, a paired difference
# natural where its second count is at most its first, a sum as the crossed counts' difference

crossed_sum(b: Building, x: Term, y: Term): Term := difference(b, add(b, ups(b, x), ups(b, y)), add(b, downs(b, x), downs(b, y)))
sum_crossed(b: Building, x: Term, y: Term): Identity := applied(b, int_of(b), SUM_CROSSED, [x, y], sum(b, x, y), crossed_sum(b, x, y))
crossed_product(b: Building, x: Term, y: Term): Term := apply_all(named(b, DIFFERENCE), product_counts(b, ups(b, x), downs(b, x), ups(b, y), downs(b, y)))
times_crossed(b: Building, x: Term, y: Term): Identity := applied(b, int_of(b), TIMES_CROSSED, [x, y], called(b, TIMES, [x, y]), crossed_product(b, x, y))
subtracted_difference(b: Building, m: Term, n: Term): Identity := applied(b, int_of(b), COUNTS_SUBTRACTED_DIFFERENCE, [m, n], subtracted(b, m, n), difference(b, m, n))
# `difference(x, zero) == natural(x)`, by x's two forms
difference_zero(b: Building, x: Term): Identity := Identity(int_of(b), difference(b, x, named(b, COUNT_ZERO)), valued(b, 1, x), induced(b, t => ints_equal(b, difference(b, t, named(b, COUNT_ZERO)), valued(b, 1, t)), reflexive(b.e, TYPE_LEVEL, int_of(b), valued(b, 1, named(b, COUNT_ZERO))), (k, h) => reflexive(b.e, TYPE_LEVEL, int_of(b), valued(b, 1, successor(b, k))), x))
# a theorem of two ints by both their cases, each case's proof made from its indices and counts
both_cases(b: Building, name: text, a: Local, c: Local, stated: (Term, Term) -> Term, case: (int, Term, int, Term) -> Term) := {
	int = int_of(b)
	against = (i: int, p: Term) => function_of(b, "c", int, y => int_split(b, Zero, t => stated(valued(b, i, p), t), (j, q) => case(i, p, j, q), y))
	theorem(b, name, [a, c], stated(a.variable, c.variable), apply(int_split(b, Zero, t => for_every(b, int, y => stated(t, y)), against, a.variable), c.variable))
}
crossed_laws_declared(b: Building) := {
	count = count_of(b)
	int = int_of(b)
	truth = truth_of(b)
	zero = named(b, COUNT_ZERO)
	yes = b.e.literals!.yes_case
	no = b.e.literals!.no_case
	less = (m: Term, n: Term) => called(b, SUBTRACT, [m, n])
	zero_less = (n: Term) => Identity(count, less(zero, n), zero, called(b, ZERO_SUBTRACT, [n]))
	both_less = (m: Term, n: Term) => Identity(count, less(successor(b, m), successor(b, n)), less(m, n), called(b, SUCCESSORS_SUBTRACT, [m, n]))
	m = entered(b.c, "m", count)
	n = entered(b.c, "n", count)
	# subtracted(m, n) == difference(m, n), by both counts at once: at two successors n - m and m - n are each the
	# difference of the counts before
	same_at = (i: Term, j: Term) => ints_equal(b, subtracted(b, i, j), difference(b, i, j))
	same_zero = function_of(b, "n", count, j => induced(b, t => same_at(zero, t), reflexive(b.e, TYPE_LEVEL, int, valued(b, 1, zero)), (k, h) => reflexive(b.e, TYPE_LEVEL, int, valued(b, 2, k)), j))
	same_first = (i: Term) => mapped(b.c, int, t => subtracted_over(b, less(successor(b, i), zero), t), zero_less(successor(b, i))).proof
	same_both = (i: Term, j: Term, before: Term) => followed(b.c, [mapped_both(b.c, int, (major, base) => subtracted_over(b, base, major), both_less(j, i), both_less(i, j)), Identity(int, subtracted(b, i, j), difference(b, i, j), before)]).proof
	theorem(b, COUNTS_SUBTRACTED_DIFFERENCE, [m, n], same_at(m.variable, n.variable), apply(paired(b, Zero, same_at, same_zero, same_first, same_both, m.variable), n.variable))
	# natural_tested(difference(m, n)) == at_most(n, m), by both counts at once, each case computing
	natural_at = (i: Term, j: Term) => truths_equal(b.e, natural_tested(b, difference(b, i, j)), at_most(b, j, i))
	natural_zero = function_of(b, "n", count, j => induced(b, t => natural_at(zero, t), reflexive(b.e, TYPE_LEVEL, truth, yes), (k, h) => reflexive(b.e, TYPE_LEVEL, truth, no), j))
	theorem(b, NATURAL_DIFFERENCE, [m, n], natural_at(m.variable, n.variable), apply(paired(b, Zero, natural_at, natural_zero, (i: Term) => reflexive(b.e, TYPE_LEVEL, truth, yes), (i: Term, j: Term, before: Term) => before, m.variable), n.variable))
	a = entered(b.c, "a", int)
	c = entered(b.c, "c", int)
	# Lean's sum at each pair of cases, a natural with a negative by subtracted's difference, zero's add and the
	# successor's add moving the counts' zeros and steps where the crossed counts hold them
	both_cases(b, SUM_CROSSED, a, c, (x, y) => ints_equal(b, sum(b, x, y), crossed_sum(b, x, y)), (i, p, j, q) => if i == j then (if i == 1 then flipped(b.c, difference_zero(b, add(b, p, q))).proof else mapped(b.c, int, t => valued(b, 2, t), flipped(b.c, successor_added(b, p, q))).proof) else {
		# the natural's count, and the negative's one short of its size; zero's add on the natural's place q
		natural = if i == 1 then p else q
		short = if i == 1 then q else p
		moved = (t: Term) => if i == 1 then difference(b, natural, successor(b, t)) else difference(b, t, successor(b, short))
		followed(b.c, [subtracted_difference(b, natural, successor(b, short)), mapped(b.c, int, moved, flipped(b.c, zero_added(b, q)))]).proof
	})
	# Lean's product at each pair of cases: a natural product as the difference from zero, a negative one as
	# from_zero's, which difference(zero, n) is; 0·q and 0 + x moved where the crossed counts hold them
	zero_times = (q: Term) => flipped(b.c, Identity(count, multiply(b, zero, q), zero, called(b, ZERO_MULTIPLY, [q])))
	crossed_at = (l: Identity, r: Identity) => mapped_both(b.c, int, (x, y) => difference(b, x, y), l, r)
	both_cases(b, TIMES_CROSSED, a, c, (x, y) => ints_equal(b, called(b, TIMES, [x, y]), crossed_product(b, x, y)), (i, p, j, q) => {
		sizes = multiply(b, if i == 1 then p else successor(b, p), if j == 1 then q else successor(b, q))
		natural = (l: Identity, r: Identity) => followed(b.c, [flipped(b.c, difference_zero(b, sizes)), crossed_at(l, r)])
		(if i == 1 and j == 1 then natural(itself(b.c, count, sizes), mapped(b.c, count, t => add(b, zero, t), zero_times(q))) else if i == 1 then crossed_at(mapped(b.c, count, t => add(b, zero, t), zero_times(q)), itself(b.c, count, sizes)) else if j == 1 then crossed_at(zero_times(q), flipped(b.c, zero_added(b, sizes))) else natural(flipped(b.c, zero_added(b, sizes)), zero_times(q))).proof
	})
}

# `difference(l + j, r + j) == difference(l, r)`
shift(b: Building, l: Term, r: Term, j: Term): Identity := applied(b, int_of(b), DIFFERENCE_SHIFTED, [l, r, j], difference(b, add(b, l, j), add(b, r, j)), difference(b, l, r))
# `difference(ups(d), downs(d))` of a difference d of m and n: `ups(d) + n == downs(d) + m`
parts(b: Building, m: Term, n: Term): Identity := {
	d = difference(b, m, n)
	applied(b, count_of(b), DIFFERENCE_PARTS, [m, n], add(b, ups(b, d), n), add(b, downs(b, d), m))
}
# difference(m, n) == difference(p, q) from `m + q == p + n`
differences_equal(b: Building, m: Term, n: Term, p: Term, q: Term, known: Identity): Identity := applied(b, int_of(b), DIFFERENCE_EQUAL, [m, n, p, q, known.proof], difference(b, m, n), difference(b, p, q))
differences_laws_declared(b: Building, m: Local, n: Local, p: Local, q: Local) := {
	int = int_of(b)
	truth = truth_of(b)
	first = difference(b, m.variable, n.variable)
	second = difference(b, p.variable, q.variable)
	# difference(m, n) + difference(p, q) == difference(m + p, n + q)
	summed = through(b, add(b, add(b, ups(b, first), ups(b, second)), add(b, n.variable, q.variable)), [parts(b, m.variable, n.variable), parts(b, p.variable, q.variable)], add(b, add(b, m.variable, p.variable), add(b, downs(b, first), downs(b, second))))
	sum_law = differences_equal(b, add(b, ups(b, first), ups(b, second)), add(b, downs(b, first), downs(b, second)), add(b, m.variable, p.variable), add(b, n.variable, q.variable), summed)
	theorem(b, SUM_DIFFERENCE, [m, n, p, q], equated(b.e, TYPE_LEVEL, int, sum(b, first, second), sum_law.right), followed(b.c, [sum_crossed(b, first, second), sum_law]).proof)
	# -difference(m, n) == difference(n, m)
	turned = followed(b.c, [flipped(b.c, parts(b, m.variable, n.variable)), rearranged(count_sums(b), add(b, ups(b, first), n.variable), add(b, n.variable, ups(b, first)))])
	minus_law = followed(b.c, [applied(b, int, MINUS_PARTS, [first], minus(b, first), difference(b, downs(b, first), ups(b, first))), differences_equal(b, downs(b, first), ups(b, first), n.variable, m.variable, turned)])
	theorem(b, MINUS_DIFFERENCE, [m, n], equated(b.e, TYPE_LEVEL, int, minus_law.left, minus_law.right), minus_law.proof)
	# difference(m, n)·difference(p, q) == difference(m·p + n·q, m·q + n·p): each difference's own counts u - w have
	# u1 + n == w1 + m and u2 + q == w2 + p; these multiplied by the other's counts add up to the two sides crossed,
	# both shifted by the same four products
	own = product_counts(b, ups(b, first), downs(b, first), ups(b, second), downs(b, second))
	given = product_counts(b, m.variable, n.variable, p.variable, q.variable)
	scaled = (i: Identity, place: (Term) -> Term) => mapped(b.c, count_of(b), place, i)
	ups_first = parts(b, m.variable, n.variable)
	ups_second = parts(b, p.variable, q.variable)
	knowns = [scaled(ups_first, z => multiply(b, z, ups(b, second))), flipped(b.c, scaled(ups_first, z => multiply(b, z, downs(b, second)))), scaled(ups_second, z => multiply(b, m.variable, z)), flipped(b.c, scaled(ups_second, z => multiply(b, n.variable, z)))]
	shared = add(b, add(b, add(b, multiply(b, n.variable, ups(b, second)), multiply(b, m.variable, downs(b, second))), multiply(b, m.variable, ups(b, second))), multiply(b, n.variable, downs(b, second)))
	crossed = through(b, add(b, add(b, own#1, shared), given#2), knowns, add(b, given#1, add(b, own#2, shared)))
	product_law = followed(b.c, [flipped(b.c, shift(b, own#1, own#2, shared)), differences_equal(b, add(b, own#1, shared), add(b, own#2, shared), given#1, given#2, crossed)])
	theorem(b, TIMES_DIFFERENCE, [m, n, p, q], equated(b.e, TYPE_LEVEL, int, called(b, TIMES, [first, second]), product_law.right), followed(b.c, [times_crossed(b, first, second), product_law]).proof)
	# not_above(difference(m, n), difference(p, q)) == at_most(m + q, p + n): q - p plus the turned first is
	# difference(p + n, q + m), natural where q + m is at most p + n
	turned_sum = mapped(b.c, int, t => sum(b, second, t), applied(b, int, MINUS_DIFFERENCE, [m.variable, n.variable], minus(b, first), difference(b, n.variable, m.variable)))
	summed_parts = applied(b, int, SUM_DIFFERENCE, [p.variable, q.variable, n.variable, m.variable], turned_sum.right, difference(b, add(b, p.variable, n.variable), add(b, q.variable, m.variable)))
	natural = applied(b, truth, NATURAL_DIFFERENCE, [add(b, p.variable, n.variable), add(b, q.variable, m.variable)], natural_tested(b, summed_parts.right), at_most(b, add(b, q.variable, m.variable), add(b, p.variable, n.variable)))
	ordered = at_most_both(b, count_sums(b).order_law(q.variable, m.variable), itself(b.c, count_of(b), add(b, p.variable, n.variable)))
	order = followed(b.c, [mapped(b.c, truth, t => natural_tested(b, t), followed(b.c, [turned_sum, summed_parts])), natural, ordered])
	theorem(b, NOT_ABOVE_DIFFERENCE, [m, n, p, q], truths_equal(b.e, called(b, NOT_ABOVE, [first, second]), order.right), order.proof)
}

# --- int's laws, each an equation or a comparison of its two sides' counts

# t as `difference(up, down)`: a sum, a product and a minus by their parts' counts, any other int by its own
counts_of(b: Building, t: Term): Counts := combined(b, t, SUM, SUM_DIFFERENCE, (l, r) => [add(b, l.up, r.up), add(b, l.down, r.down)]) ?? combined(b, t, TIMES, TIMES_DIFFERENCE, (l, r) => product_counts(b, l.up, l.down, r.up, r.down)) ?? negated_counts(b, t) ?? Counts(ups(b, t), downs(b, t), flipped(b.c, applied(b, int_of(b), PARTS_BACK, [t], difference(b, ups(b, t), downs(b, t)), t)))
# t's counts where it is a call of a two-place int function whose law takes two differences to one: its operands'
# counts combined; ø for any other t
combined(b: Building, t: Term, function: text, law: text, combine: (Counts, Counts) -> list<Term>): Counts? := {
	given = operands(b, t, function) ?? return ø
	int = int_of(b)
	l = counts_of(b, given#1)
	r = counts_of(b, given#2)
	both = mapped_both(b.c, int, (x, y) => called(b, function, [x, y]), l.identity, r.identity)
	counts = combine(l, r)
	known = applied(b, int, law, [l.up, l.down, r.up, r.down], both.right, difference(b, counts#1, counts#2))
	Counts(counts#1, counts#2, followed(b.c, [both, known]))
}
# -t's counts, t's turned; ø for any t that is not a minus
negated_counts(b: Building, t: Term): Counts? := {
	given = arguments(t)
	if #given != 1 or not is_constant(head(t), named(b, MINUS)) { return ø }
	int = int_of(b)
	inner = counts_of(b, given#1)
	turned = applied(b, int, MINUS_DIFFERENCE, [inner.up, inner.down], minus(b, difference(b, inner.up, inner.down)), difference(b, inner.down, inner.up))
	Counts(inner.down, inner.up, followed(b.c, [mapped(b.c, int, x => minus(b, x), inner.identity), turned]))
}
zero_of(b: Building): Term := valued(b, 1, named(b, COUNT_ZERO))
not_above(b: Building, left: Term, right: Term): Term := called(b, NOT_ABOVE, [left, right])
complete(b: Building, i: Identity): Term := called(b, EQUALS_COMPLETE, [i.left, i.right, i.proof])
sound(b: Building, left: Term, right: Term, proof: Term): Identity := Identity(int_of(b), left, right, called(b, EQUALS_SOUND, [left, right, proof]))
# `left == right` of ints from their counts' equation `up(left) + down(right) == up(right) + down(left)`, which the
# count's add laws regroup
regrouped(b: Building, left: Term, right: Term): Identity := {
	l = counts_of(b, left)
	r = counts_of(b, right)
	crossed = distributed(b, add(b, l.up, r.down), add(b, r.up, l.down))
	followed(b.c, [l.identity, differences_equal(b, l.up, l.down, r.up, r.down, crossed), flipped(b.c, r.identity)])
}
# `not_above(left, right) == at_most(up(left) + down(right), up(right) + down(left))`
compared_counts(b: Building, left: Term, right: Term): Identity := {
	l = counts_of(b, left)
	r = counts_of(b, right)
	both = mapped_both(b.c, truth_of(b), (x, y) => not_above(b, x, y), l.identity, r.identity)
	followed(b.c, [both, applied(b, truth_of(b), NOT_ABOVE_DIFFERENCE, [l.up, l.down, r.up, r.down], both.right, at_most(b, add(b, l.up, r.down), add(b, r.up, l.down)))])
}
# a proof of `not_above(left, right) == yes` as its counts' comparison made yes
counts_known(b: Building, left: Term, right: Term, proof: Term): Identity := followed(b.c, [flipped(b.c, compared_counts(b, left, right)), yes_known(b, not_above(b, left, right), proof)])
# `at_most(x, y) == yes` from a known `at_most(x', y') == yes`, x and x', y and y' sums of the same counts
moved(b: Building, known: Identity, x: Term, y: Term): Identity := {
	sides = arguments(known.left)
	followed(b.c, [at_most_both(b, rearranged(count_sums(b), x, sides#1), rearranged(count_sums(b), y, sides#2)), known])
}
# `not_above(left, right) == yes` from a known comparison of the same counts made yes
comparison_from(b: Building, left: Term, right: Term, known: Identity): Identity := {
	counted = compared_counts(b, left, right)
	sides = arguments(counted.right)
	followed(b.c, [counted, moved(b, known, sides#1, sides#2)])
}
# a law of ints of these binders, its two sides regrouped by their counts
equation_law(b: Building, name: text, binders: list<text>, sides: (list<Term>) -> list<Term>) := {
	locals = binders.map(binder => entered(b.c, binder, int_of(b)))
	both = sides(variables(locals))
	theorem(b, name, locals, told(b, both#1, both#2), complete(b, regrouped(b, both#1, both#2)))
}

sum_laws_declared(b: Building) := {
	zero = zero_of(b)
	equation_law(b, ZERO_ADD, ["y"], v => [sum(b, zero, v#1), v#1])
	equation_law(b, ADD_ZERO, ["a"], v => [sum(b, v#1, zero), v#1])
	equation_law(b, ADD_COMMUTATIVE, ["a", "b"], v => [sum(b, v#1, v#2), sum(b, v#2, v#1)])
	equation_law(b, ADD_ASSOCIATIVE, ["a", "b", "c"], v => [sum(b, sum(b, v#1, v#2), v#3), sum(b, v#1, sum(b, v#2, v#3))])
	equation_law(b, ADD_MINUS, ["x"], v => [sum(b, v#1, minus(b, v#1)), zero])
	equation_law(b, MINUS_ADD, ["a", "b"], v => [minus(b, sum(b, v#1, v#2)), sum(b, minus(b, v#1), minus(b, v#2))])
	equation_law(b, ADD_DIFFERENCE, ["a", "b"], v => [sum(b, v#1, sum(b, v#2, minus(b, v#1))), v#2])
	# a + c == b + c -> a == b: a is (a + c) + -c, which is (b + c) + -c, which is b
	int = int_of(b)
	a = entered(b.c, "a", int)
	c = entered(b.c, "b", int)
	d = entered(b.c, "c", int)
	h = entered(b.c, "h", told(b, sum(b, a.variable, d.variable), sum(b, c.variable, d.variable)))
	back = (x: Term) => sum(b, sum(b, x, d.variable), minus(b, d.variable))
	given = sound(b, sum(b, a.variable, d.variable), sum(b, c.variable, d.variable), h.variable)
	cancelled = followed(b.c, [regrouped(b, a.variable, back(a.variable)), mapped(b.c, int, x => sum(b, x, minus(b, d.variable)), given), regrouped(b, back(c.variable), c.variable)])
	theorem(b, ADD_CANCEL, [a, c, d, h], told(b, a.variable, c.variable), complete(b, cancelled))
}

# int's product laws, its two sides regrouped by their counts' products
product_laws_declared(b: Building) := {
	zero = zero_of(b)
	times = (l: Term, r: Term) => called(b, TIMES, [l, r])
	equation_law(b, ZERO_TIMES, ["y"], v => [times(zero, v#1), zero])
	equation_law(b, ONE_TIMES, ["y"], v => [times(int_numeral(b.e, 1), v#1), v#1])
	equation_law(b, TIMES_COMMUTATIVE, ["a", "b"], v => [times(v#1, v#2), times(v#2, v#1)])
	equation_law(b, TIMES_DISTRIBUTIVE, ["a", "b", "c"], v => [times(sum(b, v#1, v#2), v#3), sum(b, times(v#1, v#3), times(v#2, v#3))])
	equation_law(b, TIMES_NEGATED, ["a", "b"], v => [times(minus(b, v#1), v#2), minus(b, times(v#1, v#2))])
}

order_laws_declared(b: Building) := {
	a = entered(b.c, "a", int_of(b))
	c = entered(b.c, "b", int_of(b))
	difference_nonnegative_declared(b, a, c)
	nonnegative_add_declared(b, a, c)
	gap_bound_declared(b)
	beyond_not_above_declared(b, a, c)
}
# `0 <= x == yes`
nonnegative(b: Building, x: Term): Term := truth_stated(b.e, not_above(b, zero_of(b), x))
# a <= b -> 0 <= b + -a, the same counts compared
difference_nonnegative_declared(b: Building, a: Local, c: Local) := {
	h = entered(b.c, "h", truth_stated(b.e, not_above(b, a.variable, c.variable)))
	difference_part = sum(b, c.variable, minus(b, a.variable))
	theorem(b, DIFFERENCE_NONNEGATIVE, [a, c, h], nonnegative(b, difference_part), comparison_from(b, zero_of(b), difference_part, counts_known(b, a.variable, c.variable, h.variable)).proof)
}
# 0 <= a -> 0 <= b -> 0 <= a + b: each count past the other by a difference, so their sums past each other by the
# differences' sum
nonnegative_add_declared(b: Building, a: Local, c: Local) := {
	first = entered(b.c, "h", nonnegative(b, a.variable))
	second = entered(b.c, "k", nonnegative(b, c.variable))
	below = (x: Term, proof: Term) => moved(b, counts_known(b, zero_of(b), x, proof), downs(b, x), ups(b, x))
	both = sum(b, a.variable, c.variable)
	theorem(b, NONNEGATIVE_ADD, [a, c, first, second], nonnegative(b, both), comparison_from(b, zero_of(b), both, at_most_summed(b, below(a.variable, first.variable), below(c.variable, second.variable))).proof)
}
# 0 <= g -> t + g == u -> t <= u: u is t + g, and t <= t + g compares g's counts shifted by t's
gap_bound_declared(b: Building) := {
	int = int_of(b)
	t = entered(b.c, "t", int)
	g = entered(b.c, "g", int)
	u = entered(b.c, "u", int)
	gap = entered(b.c, "h", nonnegative(b, g.variable))
	reached = entered(b.c, "k", told(b, sum(b, t.variable, g.variable), u.variable))
	widened = mapped(b.c, truth_of(b), x => not_above(b, t.variable, x), flipped(b.c, sound(b, sum(b, t.variable, g.variable), u.variable, reached.variable)))
	counted = compared_counts(b, t.variable, sum(b, t.variable, g.variable))
	sides = arguments(counted.right)
	by_t = add(b, ups(b, t.variable), downs(b, t.variable))
	gap_counts = [downs(b, g.variable), ups(b, g.variable)]
	regroup = at_most_both(b, rearranged(count_sums(b), sides#1, add(b, gap_counts#1, by_t)), rearranged(count_sums(b), sides#2, add(b, gap_counts#2, by_t)))
	gap_known = moved(b, counts_known(b, zero_of(b), g.variable, gap.variable), gap_counts#1, gap_counts#2)
	theorem(b, GAP_BOUND, [t, g, u, gap, reached], truth_stated(b.e, not_above(b, t.variable, u.variable)), followed(b.c, [widened, counted, regroup, at_most_shifted(b, gap_counts#1, gap_counts#2, by_t), gap_known]).proof)
}
# not (a <= b) -> b + 1 <= a: the counts not at most are at least one past
beyond_not_above_declared(b: Building, a: Local, c: Local) := {
	truth = truth_of(b)
	refused = entered(b.c, "h", truth_stated(b.e, called(b, NEGATED, [not_above(b, a.variable, c.variable)])))
	negated_counts = mapped(b.c, truth, x => called(b, NEGATED, [x]), compared_counts(b, a.variable, c.variable))
	known = followed(b.c, [flipped(b.c, negated_counts), yes_known(b, negated_counts.left, refused.variable)])
	crossed = arguments(arguments(negated_counts.right)#1)
	one = successor(b, named(b, COUNT_ZERO))
	past = yes_known(b, at_most(b, add(b, crossed#2, one), crossed#1), called(b, AT_MOST_BEYOND, [crossed#1, crossed#2, known.proof]))
	stepped = sum(b, c.variable, int_numeral(b.e, 1))
	theorem(b, BEYOND_NOT_ABOVE, [a, c, refused], truth_stated(b.e, not_above(b, stepped, a.variable)), comparison_from(b, stepped, a.variable, past).proof)
}
# `at_most(m + p, n + q) == yes` from `at_most(m, n) == yes` and `at_most(p, q) == yes`: n is m + (n - m) and q is
# p + (q - p), so n + q is (m + p) plus both differences
at_most_summed(b: Building, first: Identity, second: Identity): Identity := {
	count = count_of(b)
	split = (known: Identity) => {
		sides = arguments(known.left)
		applied(b, count, AT_MOST_SPLIT, [sides#1, sides#2, known.proof], sides#2, add(b, sides#1, called(b, SUBTRACT, [sides#2, sides#1])))
	}
	lower = add(b, arguments(first.left)#1, arguments(second.left)#1)
	splits = [split(first), split(second)]
	parts = both_added(count_sums(b), splits#1, splits#2)
	differences = add(b, arguments(splits#1.right)#2, arguments(splits#2.right)#2)
	upper = followed(b.c, [parts, rearranged(count_sums(b), parts.right, add(b, lower, differences))])
	widened = mapped(b.c, truth_of(b), x => at_most(b, lower, x), upper)
	followed(b.c, [widened, yes_known(b, widened.right, called(b, AT_MOST_ADD, [lower, differences]))])
}

# `a and b` gives a, and gives b: by a's two cases, `no and b` never yes
truth_laws_declared(b: Building) := {
	truths = b.e.literals!
	both = (x: Term, y: Term) => truth_split(b.e, TYPE_LEVEL, function_of(b, "t", truths.truth, t => truths.truth), truths.no_case, y, x)
	a = entered(b.c, "a", truths.truth)
	c = entered(b.c, "b", truths.truth)
	h = entered(b.c, "h", truth_stated(b.e, both(a.variable, c.variable)))
	part_law = (name: text, gives: (Term) -> Term, at_yes: (Term) -> Term) => {
		motive = function_of(b, "t", truths.truth, t => pis([entered(b.c, "h", truth_stated(b.e, both(t, c.variable)))], truth_stated(b.e, gives(t))))
		at_no = assuming(b, truth_stated(b.e, both(truths.no_case, c.variable)), proof => absurd(b, truth_stated(b.e, gives(truths.no_case)), proof))
		cases = truth_split(b.e, Zero, motive, at_no, assuming(b, truth_stated(b.e, both(truths.yes_case, c.variable)), at_yes), a.variable)
		theorem(b, name, [a, c, h], truth_stated(b.e, gives(a.variable)), apply(cases, h.variable))
	}
	part_law(BOTH_FIRST, t => t, proof => reflexive(b.e, TYPE_LEVEL, truths.truth, truths.yes_case))
	part_law(BOTH_SECOND, t => c.variable, proof => proof)
}

# x + 1 and x - 1 at int's cases, so the provers rewrite a step at the case level without unfolding the sum:
# natural(c) + 1 == natural(c + 1), negative(0) + 1 == natural(0), negative(c + 1) + 1 == negative(c) and
# natural(0) - 1 == negative(0), each by computing (natural is int's first case, negative its second)
step_laws_declared(b: Building) := {
	int = int_of(b)
	zero = named(b, COUNT_ZERO)
	one = valued(b, 1, successor(b, zero))
	c = entered(b.c, "c", count_of(b))
	stepped = (name: text, binders: list<Local>, left: Term, right: Term) => theorem(b, name, binders, ints_equal(b, left, right), reflexive(b.e, TYPE_LEVEL, int, left))
	stepped(NATURAL_STEP, [c], sum(b, valued(b, 1, c.variable), one), valued(b, 1, successor(b, c.variable)))
	stepped(NEGATIVE_ZERO_STEP, [], sum(b, valued(b, 2, zero), one), valued(b, 1, zero))
	stepped(NEGATIVE_STEP, [c], sum(b, valued(b, 2, successor(b, c.variable)), one), valued(b, 2, c.variable))
	stepped(ZERO_STEP_BACK, [], called(b, SUBTRACTED, [valued(b, 1, zero), one]), valued(b, 2, zero))
}

# --- the bridge between `(a == b) == yes` and `Equal(T, a, b)`, for counts and then for ints, declared with the
# laws, as only the provers read it
# the count's recursor into Prop, by cases or by induction
induced(b: Building, motive: (Term) -> Term, base: Term, step: (Term, Term) -> Term, major: Term): Term := counted(b, Zero, motive, base, step, major)
# a theorem by the count's induction on one binder: its statement the motive at that binder's variable
inducted(b: Building, name: text, binders: list<Local>, motive: (Term) -> Term, base: Term, step: (Term, Term) -> Term, major: Term) := theorem(b, name, binders, motive(major), induced(b, motive, base, step, major))
# a function of a proof of `premise`, its body made from the proof
assuming(b: Building, premise: Term, body: (Term) -> Term): Term := function_of(b, "h", premise, body)
# anything, from `no == yes`
absurd(b: Building, wanted: Term, h: Term): Term := apply_all(constant_of(b.e, FALSE_ELIM, [Zero]), [wanted, apply(named(b, NO_IS_NOT_YES), h)])
# `successor(left) == successor(right)` from `left == right`
successors(b: Building, i: Identity): Identity := mapped(b.c, named(b, COUNT), t => successor(b, t), i)
# `zero + t == t`
zero_added(b: Building, t: Term): Identity := Identity(named(b, COUNT), called(b, ADD, [named(b, COUNT_ZERO), t]), t, called(b, COUNT_ZERO_ADD, [t]))
count_bridge_declared(b: Building) := {
	count = named(b, COUNT)
	zero = named(b, COUNT_ZERO)
	n = entered(b.c, "n", count)
	theorem(b, COUNT_EQUALS_ITSELF, [n], told_equal(b, EQUALS, n.variable, n.variable), induced(b, k => told_equal(b, EQUALS, k, k), reflexive(b.e, TYPE_LEVEL, truth_of(b), b.e.literals!.yes_case), (k, h) => h, n.variable))
	theorem(b, COUNT_ZERO_ADD, [n], counts_equal(b, called(b, ADD, [zero, n.variable]), n.variable), induced(b, k => counts_equal(b, called(b, ADD, [zero, k]), k), reflexive(b.e, TYPE_LEVEL, count, zero), (k, h) => successors(b, Identity(count, called(b, ADD, [zero, k]), k, h)).proof, n.variable))
	# what equals says yes to is equal: by induction on m for every n, each by n's cases
	sound_at = (i: Term, k: Term) => pis([entered(b.c, "h", told_equal(b, EQUALS, i, k))], counts_equal(b, i, k))
	at_zero = function_of(b, "k", count, k => induced(b, j => sound_at(zero, j), assuming(b, told_equal(b, EQUALS, zero, zero), h => reflexive(b.e, TYPE_LEVEL, count, zero)), (j, r) => assuming(b, told_equal(b, EQUALS, zero, successor(b, j)), h => absurd(b, counts_equal(b, zero, successor(b, j)), h)), k))
	at_first = (i: Term) => assuming(b, told_equal(b, EQUALS, successor(b, i), zero), h => absurd(b, counts_equal(b, successor(b, i), zero), h))
	at_both = (i: Term, j: Term, before: Term) => assuming(b, told_equal(b, EQUALS, successor(b, i), successor(b, j)), h => successors(b, Identity(count, i, j, apply(before, h))).proof)
	m = entered(b.c, "m", count)
	k = entered(b.c, "k", count)
	h = entered(b.c, "h", told_equal(b, EQUALS, m.variable, k.variable))
	every = paired(b, Zero, sound_at, at_zero, at_first, at_both, m.variable)
	theorem(b, COUNT_EQUALS_SOUND, [m, k, h], counts_equal(b, m.variable, k.variable), apply(apply(every, k.variable), h.variable))
}
# int's equal_integers says yes to itself, says yes only to equal ints, and says yes to equal ints
int_bridge_declared(b: Building) := {
	int = named(b, INT_WORD)
	zero = named(b, COUNT_ZERO)
	x = entered(b.c, "x", int)
	theorem(b, EQUAL_INTEGERS_ITSELF, [x], told(b, x.variable, x.variable), called(b, COUNT_EQUALS_ITSELF, [called(b, ADD, [called(b, UPS, [x.variable]), called(b, DOWNS, [x.variable])])]))
	# two negatives' counts are told equal shifted by zero's add: `(zero + n == zero + m) == yes`
	unshifted = (m: Term, n: Term, h: Term) => {
		shifted = (t: Term) => called(b, ADD, [zero, t])
		apart = called(b, COUNT_EQUALS_SOUND, [shifted(n), shifted(m), h])
		followed(b.c, [flipped(b.c, zero_added(b, m)), flipped(b.c, Identity(named(b, COUNT), shifted(n), shifted(m), apart)), zero_added(b, n)]).proof
	}
	# one case against itself: naturals and negatives are equal by their counts
	same = (at: int, m: Term, n: Term, h: Term) => mapped(b.c, int, t => valued(b, at, t), Identity(named(b, COUNT), m, n, if at == 1 then called(b, COUNT_EQUALS_SOUND, [m, n, h]) else unshifted(m, n, h))).proof
	# by a's cases for every b, each by b's cases: two different cases are never told equal
	sound_at = (left: Term, right: Term) => pis([entered(b.c, "h", told(b, left, right))], ints_equal(b, left, right))
	against = (at: int, m: Term) => function_of(b, "r", int, right => int_split(b, Zero, t => sound_at(valued(b, at, m), t), (other, n) => assuming(b, told(b, valued(b, at, m), valued(b, other, n)), proof => if other == at then same(at, m, n, proof) else absurd(b, ints_equal(b, valued(b, at, m), valued(b, other, n)), proof)), right))
	a = entered(b.c, "a", int)
	r = entered(b.c, "r", int)
	h = entered(b.c, "h", told(b, a.variable, r.variable))
	every = int_split(b, Zero, t => for_every(b, int, y => sound_at(t, y)), against, a.variable)
	theorem(b, EQUALS_SOUND, [a, r, h], ints_equal(b, a.variable, r.variable), apply(apply(every, r.variable), h.variable))
	same_ints = entered(b.c, "h", ints_equal(b, a.variable, r.variable))
	motive = motive_of(b.e, b.c, TYPE_LEVEL, int, a.variable, y => told(b, a.variable, y))
	theorem(b, EQUALS_COMPLETE, [a, r, same_ints], told(b, a.variable, r.variable), rewritten(b.e, TYPE_LEVEL, int, a.variable, motive, called(b, EQUAL_INTEGERS_ITSELF, [a.variable]), r.variable, same_ints.variable))
}
