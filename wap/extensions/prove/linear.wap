# Proof by linear arithmetic over int (wiki/proof.md "Ways to prove"): a goal `t <= u` or `t == u` over sums of
# numbers, minuses and unknowns (variables, and any other term taken as one) that holds wherever the hypotheses do.
# Each hypothesis `a <= b` or `a == b` is a row `b - a >= 0` with a proof that `a + d == b` and that `0 <= d`, the
# goal's negation `t - u - 1 >= 0` another, and each unknown's minus `-x` an unknown of its own, bound by
# `x + -x == 0`; an unknown is bounded only by the hypotheses. Eliminating the unknowns one by one (Fourier and
# Motzkin), each row keeping how many of the first rows it sums, ends in a sum of rows that is a negative number: it
# says how many of each hypothesis prove the goal. The proof is built of int's laws (types/integers.wap): both sides
# brought to one order, the hypotheses' sides cancelled, and `t + gap == u` with `0 <= gap` carried to `t <= u`. A goal
# outside these forms, or rows no sum refutes, finds nothing; a goal choosing by a truth value is proved at yes once
# the truth value is
use "../../kernel/terms.wap"
use "../../kernel/inductive.wap"
use "../../kernel/environment.wap"
use "../../kernel/typing.wap"
use "../../kernel/compute.wap"
use "../../kernel/numbers.wap"
use "../../kernel/recursors.wap"
use "../../kernel/equality.wap"
use "../../core/analyze/holes.wap"
use "../../core/analyze/unify.wap"
use "goals.wap"
use "rewriting.wap"

# int's laws the proofs are built of (types/integers.wap), each a theorem by its own name
ZERO_ADD := "zero_add"
ADD_COMMUTATIVE := "add_commutative"
ADD_ASSOCIATIVE := "add_associative"
ADD_SWAPPED := "add_swapped"
ADD_MINUS := "add_minus"
MINUS_ADD := "minus_add"
ADD_CANCEL := "add_cancel"
ADD_DIFFERENCE := "add_difference"
DIFFERENCE_NONNEGATIVE := "difference_nonnegative"
NONNEGATIVE_ADD := "nonnegative_add"
GAP_BOUND := "gap_bound"
BEYOND_NOT_ABOVE := "beyond_not_above"
BOTH_FIRST := "both_first"
BOTH_SECOND := "both_second"
LAWS := [ZERO_ADD, ADD_COMMUTATIVE, ADD_ASSOCIATIVE, ADD_SWAPPED, ADD_MINUS, MINUS_ADD, ADD_CANCEL, ADD_DIFFERENCE, DIFFERENCE_NONNEGATIVE, NONNEGATIVE_ADD, GAP_BOUND, BEYOND_NOT_ABOVE, BOTH_FIRST, BOTH_SECOND]
# how many rows the elimination holds before it gives up
ROW_LIMIT := 400
# the binder of the place in a sum a congruence rewrites
PLACE := "z"
# the names of the unknowns and of the hypotheses a proof is generalized over
ATOM := "a"
FACT := "h"
# the name of the laws the linear prover declares, numbered
LEMMA := "linear"
NO_TERMS: list<Term> := []

# the checker the sums are read and proved with, int and its functions, the count int's cases carry, and the truths
class Sums { c: Checker; i: Integers; n: Numbers; truths: Literals }
# an equation between ints and its proof
class Equated { left: Term; right: Term; proof: Term }
# unknowns in one order with the proof that a sum of them equals their sum in that order
class Ordered { unknowns: list<Term>; equated: Equated }
# a sum in one order, `((0 + x1) + … + xk) + number`, the number of any sign, and the proof that the sum read equals it
class Normal { unknowns: list<Term>; number: int; equated: Equated }
# a hypothesis read as `left + difference == right` and `0 <= difference`, with their proofs
class Bound { left: Term; difference: Term; right: Term; proof: Term; nonnegative: Term }
# a term with the proof that it is at least 0
class Part { term: Term; nonnegative: Term }
# a row `Σ coefficient·atom + number >= 0`, and how many of each first row it sums
class Row { coefficients: list<int>; number: int; sources: list<int> }
# a choice by a truth value: the function choosing, its parts at no and at yes, and the truth value deciding
class TruthChoice { chooser: Term; at_no: Term; at_yes: Term; decided: Term }
# what makes t at most u: `t + gap == u` and `0 <= gap`
class Gap { gap: Term; equated: Equated; nonnegative: Term }

by_linear_arithmetic(goal: Goal): Term? := {
	el = goal.el
	wanted = filled(el, goal.statement)
	if open(el, wanted) { return ø }
	s = sums_of(el.c) ?? return ø
	bounds = goal.parameters.flat_map(parameter => bounds_of(s, filled(el, type_of(el.c, parameter)), parameter))
	proved(s, bounds, wanted)
}
# the sums of int's functions, ø where no int is declared; a missing law is refused
sums_of(c: Checker): Sums? := {
	e = c.environment
	i = e.integers ?? return ø
	missing = LAWS.filter(law => declaration(e, law) is ø)
	if missing is not empty { refused(UNKNOWN_NAME, "the linear prover proves by int's laws ${missing.join(", ")}, which nothing declares") }
	Sums(c, i, e.numbers!, e.literals!)
}

# --- the goals

proved(s: Sums, bounds: list<Bound>, wanted: Term): Term? := {
	equation = equation_of(s.c, wanted) ?? return ø
	if of_integers(s, equation) { return equal_proof(s, bounds, equation.left, equation.right) }
	if not made_yes(s, equation) { return ø }
	truth_proof(s, bounds, equation.left)
}
# the proof that a truth value is yes: a comparison `t <= u`, an equation of ints, or a choice by a truth value
truth_proof(s: Sums, bounds: list<Bound>, t: Term): Term? := {
	compared = called(s, t, s.i.not_above)
	if compared is not ø { return at_most_proof(s, bounds, compared!#1, compared!#2) }
	equal = called(s, t, s.i.equal_integers)
	if equal is not ø {
		l = equal!#1
		r = equal!#2
		return complete(s, Equated(l, r, equal_proof(s, bounds, l, r) ?? return ø))
	}
	chosen_proof(s, bounds, t)
}
# `t <= u`: `t + gap == u` where `0 <= gap`
at_most_proof(s: Sums, bounds: list<Bound>, t: Term, u: Term): Term? := {
	gap = gap_proof(s, bounds, t, u) ?? return ø
	at_most_from(s, t, u, gap)
}
at_most_from(s: Sums, t: Term, u: Term, gap: Gap): Term := law(s, GAP_BOUND, [], [t, gap.gap, u, gap.nonnegative, complete(s, gap.equated)])
# `t == u`: `t + gap == u` where the gap is no atom and no number
equal_proof(s: Sums, bounds: list<Bound>, t: Term, u: Term): Term? := {
	gap = gap_proof(s, bounds, t, u) ?? return ø
	closed = normal(s, gap.gap)
	if closed.unknowns is not empty or closed.number != 0 { return ø }
	widened = symmetric(s, inside(s, place => added(s, t, place), closed.equated))
	chained(s, chained(s, symmetric(s, zero_added(s, t)), widened), gap.equated).proof
}
# A goal choosing by a truth value (`a and b` is the choice of b at a's yes): proved where the truth value is proved
# yes and the choice at yes is proved, the proof of that carried back along the truth value's equation
chosen_proof(s: Sums, bounds: list<Bound>, t: Term): Term? := {
	choice = choice_of(s, t) ?? return ø
	truth = s.truths.truth
	affirmed = s.truths.yes_case
	sure = truth_proof(s, bounds, choice.decided) ?? return ø
	at_yes = truth_proof(s, bounds, choice.at_yes) ?? return ø
	turned = symmetric_at(s, truth, Equated(choice.decided, affirmed, sure))
	carried(s.c, equation(s, truth, affirmed, choice.decided), turned.proof, at_yes, v => truth_stated(s.c.environment, apply(choice.chooser, v)))
}
# t as a choice by a truth value, ø where it computes to none
choice_of(s: Sums, t: Term): TruthChoice? := {
	choice = computed_folded(s.c, t)
	recursor = match head(choice).shape {
		Constant(name, levels, _) => name
		_ => return ø
	}
	facts = recursor_facts(s.c.environment, recursor) ?? return ø
	given = arguments(choice)
	if not is_constant(facts.of, s.truths.truth) or #given != before_major(facts) + 1 { return ø }
	part = case => given#(facts.parameters + facts.motives + case_place(facts, case))
	TruthChoice(apply_all(head(choice), given.take(#given - 1)), part(s.truths.no_case), part(s.truths.yes_case), given.last())
}

# --- the hypotheses

# what a hypothesis bounds: `a == b` of ints both ways, and what a truth value made yes bounds
bounds_of(s: Sums, type: Term, proof: Term): list<Bound> := {
	equation = equation_of(s.c, type) ?? return []
	if of_integers(s, equation) { return equal_bounds(s, Equated(equation.left, equation.right, proof)) }
	if not made_yes(s, equation) { return [] }
	truth_bounds(s, equation.left, proof)
}
# what a truth value proved yes bounds: `a <= b`, `a == b` both ways, `not (a <= b)` as `b + 1 <= a`, and both parts
# of `a and b`
truth_bounds(s: Sums, t: Term, proof: Term): list<Bound> := {
	beyond = beyond_of(s, t)
	if beyond is not ø {
		a = beyond!#1
		b = beyond!#2
		return [difference_bound(s, added(s, b, int_numeral(s.c.environment, 1)), a, law(s, BEYOND_NOT_ABOVE, [], [a, b, proof]))]
	}
	compared = called(s, t, s.i.not_above)
	if compared is not ø { return [difference_bound(s, compared!#1, compared!#2, proof)] }
	equal = called(s, t, s.i.equal_integers)
	if equal is not ø { return equal_bounds(s, sound(s, equal!#1, equal!#2, proof)) }
	chosen_bounds(s, t, proof)
}
# `a <= b` read as `a + (b + -a) == b` and `0 <= b + -a`
difference_bound(s: Sums, a: Term, b: Term, proof: Term): Bound := {
	difference = added(s, b, minus_of(s, a))
	Bound(a, difference, b, law_equated(s, ADD_DIFFERENCE, [a, b], added(s, a, difference), b).proof, law(s, DIFFERENCE_NONNEGATIVE, [], [a, b, proof]))
}
# A truth value choosing whose part at no is no (`a and b`): the truth value is yes, and the part at yes is
chosen_bounds(s: Sums, t: Term, proof: Term): list<Bound> := {
	choice = choice_of(s, t) ?? return []
	if not is_named(s, choice.at_no, s.truths.no_case) { return [] }
	given = [choice.decided, choice.at_yes, proof]
	truth_bounds(s, choice.decided, law(s, BOTH_FIRST, [], given)) + truth_bounds(s, choice.at_yes, law(s, BOTH_SECOND, [], given))
}
# `a == b` read both ways, each a bound whose difference is 0
equal_bounds(s: Sums, e: Equated): list<Bound> := [exact_bound(s, e), exact_bound(s, symmetric(s, e))]
exact_bound(s: Sums, e: Equated): Bound := Bound(e.left, zero_of(s), e.right, chained(s, zero_added(s, e.left), e).proof, truth_computed(s))
# the bounds `x + -x == 0` for each unknown's minus among the sides' unknowns
minus_bounds(s: Sums, sides: list<Term>): list<Bound> := {
	negated = sides.flat_map(side => normal(s, side).unknowns).filter(atom => negated_of(s, atom) is not ø).fold(NO_TERMS, with_new)
	negated.flat_map(atom => equal_bounds(s, minus_cancelled(s, negated_of(s, atom)!)))
}
bound_sides(bound: Bound): list<Term> := [bound.left, bound.difference, bound.right]
bound_proofs(bound: Bound): list<Term> := [bound.proof, bound.nonnegative]

# --- the elimination

# `t + gap == u` and `0 <= gap` from the hypotheses, ø where no sum of rows refutes `t > u`
gap_proof(s: Sums, bounds: list<Bound>, t: Term, u: Term): Gap? := generalized(s, relevant(s, bounds, [t, u]), t, u)
# The bounds linked to the terms: those sharing an unknown with them or with a bound linked already, and those of no
# unknown, which can refute alone; the others cannot help, and every bound more multiplies the rows eliminated
relevant(s: Sums, bounds: list<Bound>, terms: list<Term>): list<Bound> := {
	linking = bounds.map(bound => Linking(bound, bound_sides(bound).flat_map(side => atoms_of(s, side)).fold(NO_TERMS, with_new)))
	reached = terms.flat_map(term => atoms_of(s, term)).fold(NO_TERMS, with_new)
	linked_to(linking, reached).map(found => found.bound)
}
class Linking { bound: Bound; unknowns: list<Term> }
linked_to(linking: list<Linking>, reached: list<Term>): list<Linking> := {
	near = linking.filter(found => found.unknowns is empty or found.unknowns.any(atom => reached.any(known => same(known, atom))))
	grown = near.flat_map(found => found.unknowns).fold(reached, with_new)
	if #grown == #reached then near else linked_to(linking, grown)
}
# the unknowns of a term, each minus taken off: `-x` and x are linked by `x + -x == 0`
atoms_of(s: Sums, t: Term): list<Term> := normal(s, t).unknowns.map(atom => unnegated(s, atom))
unnegated(s: Sums, t: Term): Term := unnegated(s, negated_of(s, t) ?? return t)
# `t + gap == u` and `0 <= gap` from the hypotheses alone, eliminated over variables standing for the unknowns and the
# hypotheses: the proofs, closed over them, are given each unknown and each hypothesis's proofs once, however often
# they use them
generalized(s: Sums, bounds: list<Bound>, t: Term, u: Term): Gap? := {
	atoms = ([t, u] + bounds.flat_map(bound_sides)).flat_map(side => atoms_of(s, side)).fold(NO_TERMS, with_new)
	unknowns = atoms.map(atom => hypothesis(s.c, ATOM, s.i.type))
	standing = (side: Term) => skeleton(s, side, atom => unknowns#(atoms.index_where(found => same(found, atom))))
	facts = bounds.map(bound => standing_bound(s, standing(bound.left), standing(bound.difference), standing(bound.right)))
	gap = eliminated(s, facts, standing(t), standing(u)) ?? return ø
	given = unknowns + facts.flat_map(bound_proofs)
	proved_by_lemma = (type: Term, proof: Term) => apply_all(lemma_declared(s, closed_over(s.c, type, given, no), closed_over(s.c, proof, given, yes)), atoms + bounds.flat_map(bound_proofs))
	equal = proved_by_lemma(int_stated(s, gap.equated.left, gap.equated.right), gap.equated.proof)
	nonnegative = proved_by_lemma(nonnegative_stated(s, gap.gap), gap.nonnegative)
	gap_given = (0 upto #atoms).fold(gap.gap, (inner, at) => replaced_by(inner, variable_id(unknowns[at]), atoms[at]))
	Gap(gap_given, Equated(added(s, t, gap_given), u, equal), nonnegative)
}
# A law of the environment proving a type by a proof, both closed, checked once: the provers' proofs are given as calls
# of it, so a big proof is not copied wherever the term proved goes, and a type proved again calls the law it has
lemma_declared(s: Sums, type: Term, proof: Term): Term := {
	e = s.c.environment
	named = "${LEMMA}·${type.hash}"
	known = declaration(e, named)
	if known is not ø and same(known!.type, type) { return constant_of(e, named, known!.levels.map(level => Parameter(level))) }
	name = if known is ø then named else "${LEMMA}·${size(e) + 1}"
	levels = [type, proof].flat_map(term_levels).unique()
	declared(e, Declaration(name, levels, type, Theorem(proof)))
	constant_of(e, name, levels.map(level => Parameter(level)))
}
standing_bound(s: Sums, left: Term, difference: Term, right: Term): Bound :=
	Bound(left, difference, right, hypothesis(s.c, FACT, int_stated(s, added(s, left, difference), right)), hypothesis(s.c, FACT, nonnegative_stated(s, difference)))
# `t + gap == u` and `0 <= gap` from the hypotheses and the minuses' bounds, ø where no sum of rows refutes `t > u`
eliminated(s: Sums, hypotheses: list<Bound>, t: Term, u: Term): Gap? := {
	bounds = hypotheses + minus_bounds(s, hypotheses.flat_map(bound_sides) + [t, u])
	lefts = bounds.map(bound => normal(s, bound.left))
	rights = bounds.map(bound => normal(s, bound.right))
	lower = normal(s, t)
	upper = normal(s, u)
	unknowns = (lefts + rights + [lower, upper]).flat_map(found => found.unknowns).fold(NO_TERMS, with_new)
	goal_row = difference_row(unknowns, lower, upper)
	unsourced = (0 upto #bounds).map(at => difference_row(unknowns, rights[at], lefts[at])) + [Row(goal_row.coefficients, goal_row.number - 1, [])]
	total = #unsourced
	rows = (0 upto total).map(at => Row(unsourced[at].coefficients, unsourced[at].number, unit(at, total)))
	sources = refuted(rows, #unknowns) ?? return ø
	common = sources.fold(0, divisor)
	times = sources.map(source => source ÷ common)
	if times[#bounds] != 1 { return ø }
	refuting = (0 upto total).map(at => times[at] * rows[at].number).fold(0, (sum, part) => sum + part)
	used = (0 upto #bounds).flat_map(at => copies(bounds[at], times[at]))
	kept = Part(int_numeral(s.c.environment, -refuting - 1), truth_computed(s))
	gap = summed_parts(s, used.map(bound => Part(bound.difference, bound.nonnegative)) + [kept])
	widened = added(s, t, gap.term)
	lefts_sum = summed(s, used.map(bound => bound.left))
	cancelled = added(s, widened, lefts_sum)
	regrouped = added(s, added(s, t, kept.term), summed(s, used.map(bound => added(s, bound.left, bound.difference))))
	along = inside(s, place => added(s, added(s, t, kept.term), place), sums_equal(s, used.map(bound => Equated(added(s, bound.left, bound.difference), bound.right, bound.proof))))
	reordered = same_sum(s, cancelled, regrouped) ?? return ø
	ended = same_sum(s, along.right, added(s, u, lefts_sum)) ?? return ø
	chain = chained(s, chained(s, reordered, along), ended)
	Gap(gap.term, law_equated(s, ADD_CANCEL, [widened, u, lefts_sum, complete(s, chain)], widened, u), gap.nonnegative)
}
# the sum of parts at least 0, at least 0
summed_parts(s: Sums, parts: list<Part>): Part :=
	parts.fold(Part(zero_of(s), truth_computed(s)), (sum, part) => Part(added(s, sum.term, part.term), law(s, NONNEGATIVE_ADD, [], [sum.term, part.term, sum.nonnegative, part.nonnegative])))
# the unknowns, the term added where none is the same
with_new(unknowns: list<Term>, term: Term): list<Term> := if unknowns.any(known => same(known, term)) then unknowns else unknowns + [term]
# the row `a - b`, over the unknowns found
difference_row(unknowns: list<Term>, a: Normal, b: Normal): Row := Row(unknowns.map(atom => counted(a, atom) - counted(b, atom)), a.number - b.number, [])
counted(found: Normal, atom: Term): int := found.unknowns.filter(x => same(x, atom)).fold(0, (count, x) => count + 1)
unit(at: int, size: int): list<int> := (0 upto size).map(place => if place == at then 1 else 0)
copies(item: T, times: int): list<T> := (0 upto times).map(place => item)
divisor(a: int, b: int): int := if b == 0 then a else divisor(b, a % b)
# how many of each row sum to a negative number, the unknowns eliminated one by one; ø where none does
refuted(rows: list<Row>, unknowns: int): list<int>? := {
	current = rows
	for at in 0 upto unknowns {
		above = current.filter(row => row.coefficients[at] > 0)
		below = current.filter(row => row.coefficients[at] < 0)
		current = current.filter(row => row.coefficients[at] == 0) + above.flat_map(p => below.map(q => row_sum(p, -q.coefficients[at], q, p.coefficients[at])))
		if #current > ROW_LIMIT { return ø }
	}
	(current.find(row => row.number < 0) ?? return ø).sources
}
row_sum(p: Row, a: int, q: Row, b: int): Row := {
	scaled = (x: int, y: int) => a * x + b * y
	Row(paired(p.coefficients, q.coefficients, scaled), scaled(p.number, q.number), paired(p.sources, q.sources, scaled))
}

# --- sums brought to one order

# the proof that two sums are equal, both brought to one order; ø where their orders differ
same_sum(s: Sums, a: Term, b: Term): Equated? := {
	one = normal(s, a)
	other = normal(s, b)
	if not same(one.equated.right, other.equated.right) { return ø }
	chained(s, one.equated, symmetric(s, other.equated))
}
# t read as a sum and brought to one order
normal(s: Sums, t: Term): Normal := {
	found = unfolded_until(s, t, part => is_sum_part(s, part)) ?? return unknown_normal(s, t, spine_computed(s.c, t))
	value = integer_value(s, found)
	if value is not ø { return number_normal(s, t, value!) }
	negated = negated_of(s, found)
	if negated is not ø { return minus_normal(s, t, normal(s, negated!)) }
	given = arguments(found)
	sum_normal(s, t, normal(s, given#1), normal(s, given#2))
}
# t with each unknown in its sums replaced, the same sum by computing
skeleton(s: Sums, t: Term, replaced: (Term) -> Term): Term := {
	found = unfolded_until(s, t, part => is_sum_part(s, part)) ?? return replaced(spine_computed(s.c, t))
	if integer_value(s, found) is not ø { return found }
	apply_all(head(found), arguments(found).map(part => skeleton(s, part, replaced)))
}
# t as one unknown, computed with its arguments, so one unknown written two ways, `#xs` of a value and of its
# subset's, is one
spine_computed(c: Checker, t: Term): Term := {
	found = computed(c, t)
	match found.shape {
		Projection(structure, field, of) => projection(structure, field, spine_computed(c, of))
		_ => apply_all(head(found), arguments(found).map(argument => spine_computed(c, argument)))
	}
}
# an int literal, a minus, or a sum: what a sum is read of
is_sum_part(s: Sums, t: Term): bool := integer_value(s, t) is not ø or negated_of(s, t) is not ø or calls(t, s.i.sum)
# the int a term of int's cases holds: the zero case, or the positive or negative case of a count; ø for another term
integer_value(s: Sums, t: Term): int? := {
	given = arguments(t)
	if is_constant(head(t), s.i.zero) and given is empty { return 0 }
	if #given != 1 { return ø }
	sign = if is_constant(head(t), s.i.positive) then 1 else if is_constant(head(t), s.i.negative) then -1 else return ø
	sign * ((number_computed(s.c, s.n, given#1) ?? return ø) + 1)
}
# what a minus `-x` takes, ø for another term
# (a program's `-x` is `0 - x`, its row meaning the sum `0 + -x`)
negated_of(s: Sums, t: Term): Term? := if #arguments(t) == 1 and is_constant(head(t), s.i.minus) then arguments(t)#1 else ø
unknown_normal(s: Sums, t: Term, atom: Term): Normal := {
	once = added(s, zero_of(s), atom)
	started = symmetric(s, law_equated(s, ZERO_ADD, [atom], once, atom))
	Normal([atom], 0, Equated(t, normal_term(s, [atom], 0), chained(s, started, symmetric(s, zero_added(s, once))).proof))
}
number_normal(s: Sums, t: Term, number: int): Normal := Normal([], number, Equated(t, normal_term(s, [], number), refl(s, t).proof))
# `-x`, x in order: `-(F + c) == -F + -c`, -F spread over its unknowns and -c computed
minus_normal(s: Sums, t: Term, inner: Normal): Normal := {
	inner_sum = sum_term(s, inner.unknowns)
	value = -inner.number
	spread = law_equated(s, MINUS_ADD, [inner_sum, int_numeral(s.c.environment, inner.number)], minus_of(s, inner.equated.right), added(s, minus_of(s, inner_sum), int_numeral(s.c.environment, value)))
	negated = negated_sum(s, inner.unknowns)
	both = chained(s, chained(s, inside(s, place => minus_of(s, place), inner.equated), spread), inside(s, place => added(s, place, int_numeral(s.c.environment, value)), negated.equated))
	Normal(negated.unknowns, value, Equated(t, normal_term(s, negated.unknowns, value), both.proof))
}
# `-(x1 + … + xk)` spread to the sum of each unknown's minus, in order; `-0` computes to 0
negated_sum(s: Sums, xs: list<Term>): Ordered := {
	if xs is empty { return Ordered([], Equated(minus_of(s, zero_of(s)), zero_of(s), refl(s, zero_of(s)).proof)) }
	rest = xs.take(#xs - 1)
	top = xs.last()
	spread = law_equated(s, MINUS_ADD, [sum_term(s, rest), top], minus_of(s, sum_term(s, xs)), added(s, minus_of(s, sum_term(s, rest)), minus_of(s, top)))
	further = appended(s, negated_sum(s, rest), minus_of(s, top))
	Ordered(further.unknowns, chained(s, spread, further.equated))
}
# `x + y`, each in order: `(F + c) + (G + d)` regrouped to `((F + c) + G) + d`, swapped to `((F + G) + c) + d`,
# regrouped to `(F + G) + (c + d)` with c + d computed, and F + G merged
sum_normal(s: Sums, t: Term, x: Normal, y: Normal): Normal := {
	left_sum = sum_term(s, x.unknowns)
	right_sum = sum_term(s, y.unknowns)
	c = int_numeral(s.c.environment, x.number)
	d = int_numeral(s.c.environment, y.number)
	value = x.number + y.number
	both = chained(s, inside(s, place => added(s, place, y.equated.left), x.equated), inside(s, place => added(s, x.equated.right, place), y.equated))
	both = chained(s, both, symmetric(s, associated(s, added(s, left_sum, c), right_sum, d)))
	both = chained(s, both, inside(s, place => added(s, place, d), swapped(s, left_sum, c, right_sum)))
	both = chained(s, both, associated(s, added(s, left_sum, right_sum), c, d))
	merged_sum = merged(s, x.unknowns, y.unknowns)
	both = chained(s, both, inside(s, place => added(s, place, int_numeral(s.c.environment, value)), merged_sum.equated))
	Normal(merged_sum.unknowns, value, Equated(t, normal_term(s, merged_sum.unknowns, value), both.proof))
}
# the sum of two sums in order, in order
merged(s: Sums, xs: list<Term>, ys: list<Term>): Ordered := {
	if ys is empty { return Ordered(xs, zero_added(s, sum_term(s, xs))) }
	rest = ys.take(#ys - 1)
	top = ys.last()
	regrouped = symmetric(s, associated(s, sum_term(s, xs), sum_term(s, rest), top))
	further = appended(s, merged(s, xs, rest), top)
	Ordered(further.unknowns, chained(s, regrouped, further.equated))
}
# a sum in order plus one more atom, in order
appended(s: Sums, inner: Ordered, atom: Term): Ordered := {
	further = inserted(s, inner.unknowns, atom)
	Ordered(further.unknowns, chained(s, inside(s, place => added(s, place, atom), inner.equated), further.equated))
}
# the sum of unknowns in order plus one more atom, in order: the atom swapped down past each that goes after it
inserted(s: Sums, xs: list<Term>, atom: Term): Ordered := {
	if xs is empty or xs.last().hash <= atom.hash { return Ordered(xs + [atom], refl(s, added(s, sum_term(s, xs), atom))) }
	rest = xs.take(#xs - 1)
	top = xs.last()
	inner = inserted(s, rest, atom)
	Ordered(inner.unknowns + [top], chained(s, swapped(s, sum_term(s, rest), top, atom), inside(s, place => added(s, place, top), inner.equated)))
}
# the proof that two sums are equal where each part is
sums_equal(s: Sums, parts: list<Equated>): Equated := parts.fold(refl(s, zero_of(s)), (sum, part) => chained(s, inside(s, place => added(s, place, part.left), sum), inside(s, place => added(s, sum.right, place), part)))

# --- int's laws of sums, each statement written once

# `a + 0 == a`: commuted, then `0 + a == a`
zero_added(s: Sums, a: Term): Equated := {
	commuted = law_equated(s, ADD_COMMUTATIVE, [a, zero_of(s)], added(s, a, zero_of(s)), added(s, zero_of(s), a))
	chained(s, commuted, law_equated(s, ZERO_ADD, [a], added(s, zero_of(s), a), a))
}
# `(a + b) + c == a + (b + c)`
associated(s: Sums, a: Term, b: Term, c: Term): Equated := law_equated(s, ADD_ASSOCIATIVE, [a, b, c], added(s, added(s, a, b), c), added(s, a, added(s, b, c)))
# `(x + a) + b == (x + b) + a`
swapped(s: Sums, x: Term, a: Term, b: Term): Equated := law_equated(s, ADD_SWAPPED, [x, a, b], added(s, added(s, x, a), b), added(s, added(s, x, b), a))
# `x + -x == 0`
minus_cancelled(s: Sums, x: Term): Equated := law_equated(s, ADD_MINUS, [x], added(s, x, minus_of(s, x)), zero_of(s))

# --- terms and proofs

law(s: Sums, name: text, levels: list<Level>, given: list<Term>): Term := apply_all(constant_of(s.c.environment, name, levels), given)
# a law stating `left == right` of ints, a truth value made yes, as the kernel's equation of them, by equals_sound
law_equated(s: Sums, name: text, given: list<Term>, left: Term, right: Term): Equated := sound(s, left, right, law(s, name, [], given))
# the kernel's `a == b` of ints from `(a == b) == yes`, and back
sound(s: Sums, a: Term, b: Term, proof: Term): Equated := Equated(a, b, apply_all(s.i.equals_sound, [a, b, proof]))
complete(s: Sums, e: Equated): Term := apply_all(s.i.equals_complete, [e.left, e.right, e.proof])
added(s: Sums, a: Term, b: Term): Term := apply_all(s.i.sum, [a, b])
minus_of(s: Sums, t: Term): Term := apply(s.i.minus, t)
zero_of(s: Sums): Term := s.i.zero
summed(s: Sums, parts: list<Term>): Term := parts.fold(zero_of(s), (sum, part) => added(s, sum, part))
sum_term(s: Sums, unknowns: list<Term>): Term := summed(s, unknowns)
normal_term(s: Sums, unknowns: list<Term>, value: int): Term := added(s, sum_term(s, unknowns), int_numeral(s.c.environment, value))
# the equation of a type between two values, by the kernel's equality
equation(s: Sums, type: Term, left: Term, right: Term): Equation := Equation(constant_of(s.c.environment, EQUAL, [TYPE_LEVEL]), [TYPE_LEVEL], type, left, right)
int_stated(s: Sums, left: Term, right: Term): Term := equated(s.c.environment, TYPE_LEVEL, s.i.type, left, right)
nonnegative_stated(s: Sums, t: Term): Term := truth_stated(s.c.environment, apply_all(s.i.not_above, [zero_of(s), t]))
# the proof of a truth value that computes to yes, `0 <= 0` and `0 <= 3` alike
truth_computed(s: Sums): Term := reflexive(s.c.environment, TYPE_LEVEL, s.truths.truth, s.truths.yes_case)
refl(s: Sums, t: Term): Equated := Equated(t, t, reflexive(s.c.environment, TYPE_LEVEL, s.i.type, t))
symmetric(s: Sums, e: Equated): Equated := symmetric_at(s, s.i.type, e)
symmetric_at(s: Sums, type: Term, e: Equated): Equated := Equated(e.right, e.left, law(s, EQUAL_SYMMETRIC, [TYPE_LEVEL], [type, e.left, e.right, e.proof]))
chained(s: Sums, e: Equated, f: Equated): Equated := Equated(e.left, f.right, law(s, EQUAL_TRANSITIVE, [TYPE_LEVEL], [s.i.type, e.left, e.right, f.right, e.proof, f.proof]))
# an equation of ints made one of the sums around them: `place(a) == place(b)`
inside(s: Sums, place: (Term) -> Term, e: Equated): Equated := Equated(place(e.left), place(e.right), law(s, EQUAL_CONGRUENT, [TYPE_LEVEL, TYPE_LEVEL], [s.i.type, s.i.type, lambda(PLACE, s.i.type, place(bound(0))), e.left, e.right, e.proof]))
# whether a term computes to the constant of a name, without arguments
is_named(s: Sums, t: Term, constant: Term): bool := same(computed(s.c, t), constant)
# an equation of two ints; one saying a truth value is yes, `a <= b == yes`
of_integers(s: Sums, equation: Equation): bool := is_named(s, equation.type, s.i.type)
made_yes(s: Sums, equation: Equation): bool := is_named(s, equation.type, s.truths.truth) and is_named(s, equation.right, s.truths.yes_case)
# the arguments of the two-argument call of a function that t unfolds to, ø where it unfolds to none
called(s: Sums, t: Term, function: Term): list<Term>? := arguments(unfolded_until(s, t, found => calls(found, function)) ?? return ø)
calls(t: Term, function: Term): bool := #arguments(t) == 2 and same(head(t), function)
# the ints of `not (a <= b)` t unfolds to, a choice by `a <= b` that is yes at no and no at yes; ø for another term
beyond_of(s: Sums, t: Term): list<Term>? := {
	negation = unfolded_until(s, t, found => negation_of(s, found) is not ø) ?? return ø
	called(s, negation_of(s, negation)!.decided, s.i.not_above)
}
negation_of(s: Sums, t: Term): TruthChoice? := {
	choice = choice_of(s, t) ?? return ø
	if is_named(s, choice.at_no, s.truths.yes_case) and is_named(s, choice.at_yes, s.truths.no_case) then choice else ø
}
# t unfolded, one step at a time, until it fits; ø where it unfolds no further first
unfolded_until(s: Sums, t: Term, fits: (Term) -> bool): Term? := {
	found = computed_folded(s.c, t)
	while not fits(found) { found = computed_folded(s.c, unfolded(s.c, found) ?? return ø) }
	found
}
