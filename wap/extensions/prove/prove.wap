# The provers (notes/coc-plan.md 3.5 and 8, "The provers"; wiki/proof.md "Ways to prove"): functions from a goal to a
# proof term, tried in order on a law stated without a proof. They are not trusted: a proof they find is declared as
# the law's and checked by the kernel like any other, so a wrong prover proves nothing. A prover that runs out of
# steps has found nothing.
use "../theory/environment.wap"
use "goals.wap"
use "computing.wap"

# The provers, cheapest first
PROVERS := [by_computing]

# a proof of a closed statement, as a function of its parameters; ø when no prover finds one
proof_found(c: Checker, statement: Term): Term? := {
	goal = goal_of(c, statement)
	for prover in PROVERS {
		proof = found_within_budget(() => prover(goal))
		if proof is not ø { return closed_over(c, proof!, goal.parameters, yes) }
	}
	ø
}

# what a prover found, ø when it gave up counting its steps; any other refusal is a prover's bug and is raised
found_within_budget(search: () -> Term?): Term? := try { search() } catch e { if e.message.starts_with(REFUSED + GAVE_UP) then ø else raise e.message }

