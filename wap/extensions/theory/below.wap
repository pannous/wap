# The values below a value, and recursion on any of them (notes/theory.md "The declarations that bind names"): the
# statement `products(Pair, Unit)` names the pair type and the unit type, and from then on each enum that may be
# taken apart into any universe gets two definitions, made from its recursor the first time a recursion asks for them.
# `nat.below(motive, n)` is the type of the motive's values at every value below n, a pair for each recursive field
# and its own values below, ending in Unit; `nat.course(motive, step, n)` is the motive at n, where step makes it
# from n and those values: `nat.below(motive, successor(successor(j)))` computes to
# `Pair(Pair(motive(successor(j)), Pair(Pair(motive(j), …), Unit)), Unit)`, so a recursion may call itself on j there.
# Both are checked by the kernel like any definition.

use "terms.wap"
use "levels.wap"
use "environment.wap"
use "typing.wap"
use "inductive.wap"
use "recursors.wap"

# the suffixes of the two definitions' names: `nat.below`, `nat.course`
BELOW := ".below"
COURSE := ".course"
# the binders of course's step and of the values below
STEP := "step"
BELOW_VALUE := "below"

# `products(pair, unit)`: pair has the shape of `enum Pair(A: Sort(u), B: Sort(v)): Sort(max(1, max(u, v))) {
# intro(first: A, second: B) }`, unit of `enum Unit: Sort(u) { unit }`. A later binding stands instead, as only the
# declarations after it build their values below of the products
products_declared(e: Environment, pair: text, unit: text) := {
	pairs = block_of(e, pair, PRODUCTS)
	if not pair_shaped(pairs, pair) { refused(PRODUCTS, "${pair} is no block like `enum Pair(A: Sort(u), B: Sort(v)): Sort(max(1, max(u, v))) { intro(first: A, second: B) }`") }
	units = block_of(e, unit, PRODUCTS)
	if not unit_shaped(units, unit) { refused(PRODUCTS, "${unit} is no block like `enum Unit: Sort(u) { unit }`") }
	e.products = Products(pair, pairs.block.types#1.cases#1.name, unit, units.block.types#1.cases#1.name)
}
pair_shaped(facts: InductiveFacts, pair: text): bool := {
	if #facts.block.levels != 2 { return no }
	u = Parameter(facts.block.levels#1)
	v = Parameter(facts.block.levels#2)
	intro = under_sorts(u, v, pi("first", bound(1), pi("second", bound(1), apply_all(constant(pair, [u, v]), [bound(3), bound(2)]))))
	block_shaped(facts, 2, 2, under_sorts(u, v, universe(Max(Successor(Zero), Max(u, v)))), [intro])
}
under_sorts(u: Level, v: Level, inner: Term): Term := pi("A", universe(u), pi("B", universe(v), inner))
unit_shaped(facts: InductiveFacts, unit: text): bool := {
	if #facts.block.levels != 1 { return no }
	u = Parameter(facts.block.levels#1)
	block_shaped(facts, 1, 0, universe(u), [constant(unit, [u])])
}

# The name of a type's course, declared with its below the first time it is asked for; ø where the products are not
# bound, or the type is no enum of one type taken apart into any universe, or a field holds a function into it
course_of(e: Environment, type: text): text? := {
	products = e.products ?? return ø
	name = type + COURSE
	if declaration(e, name) is not ø { return name }
	facts = match (declaration(e, type) ?? return ø).kind {
		Inductive(facts) => facts
		_ => return ø
	}
	if not facts.any_motive or #facts.block.types != 1 { return ø }
	m = making(e, facts)
	if m.cases#1.any(case => case.inductions.any(induction => induction.binders is not empty)) { return ø }
	b = Built(type, m, products, constant(type + BELOW, m.levels.map(level => Parameter(level))), Parameter(MOTIVE_LEVEL), Max(Successor(Zero), Parameter(MOTIVE_LEVEL)))
	declared(e, below_made(b))
	declared(e, course_made(b))
	name
}

# What both are built of: the type, the recursor's binders, the products, below at its own levels, the level of the motive's
# values and the level of the pairs, which is never Prop
class Built { type: text; m: Making; products: Products; below: Term; values: Level; pairs: Level }
pair_type(b: Built, first: Level, second: Level, a: Term, c: Term): Term := apply_all(constant(b.products.pair, [first, second]), [a, c])
# a pair of a value of `a` and one of `c`, two types at the pairs' level
pair_made(b: Built, a: Term, c: Term, first: Term, second: Term): Term := apply_all(constant(b.products.intro, [b.pairs, b.pairs]), [a, c, first, second])
the_motive(b: Built): Term := b.m.motives#1.variable
motive_at(b: Built, indices: list<Term>, value: Term): Term := motive_applied(b.m, 1, indices, value)
# the type a recursion's step gets at a value: the motive there, and the values below it
course_value_type(b: Built, indices: list<Term>, value: Term): Term := pair_type(b, b.values, b.pairs, motive_at(b, indices, value), below_at(b, indices, value))
below_at(b: Built, indices: list<Term>, value: Term): Term := apply_all(b.below, variables(b.m.parameters) + [the_motive(b)] + indices + [value])
# the type's recursor into the motive given, applied to the parameters, the minor premises, the indices and the value
recursor_into(b: Built, level: Level, motive: Term, minors: list<Term>, indices: list<Local>, value: Local): Term := {
	levels = [level] + b.m.facts.block.levels.map(name => Parameter(name))
	apply_all(constant(recursor_name(b.type), levels), variables(b.m.parameters) + [motive] + minors + variables(indices) + [value.variable])
}
# the binders a definition takes after the parameters and the motive: the indices and the value
class Major { indices: list<Local>; value: Local }
major_entered(b: Built): Major := {
	indices = indices_entered(b.m, 1)
	Major(indices, entered(b.m.c, MAJOR, type_applied(b.m, 1, variables(indices))))
}

# `below(parameters, motive, indices, t)`: the recursor into types, each case's minor premise the pairs of its
# recursive fields' motive and their below, its hypothesis
below_made(b: Built): Declaration := {
	major = major_entered(b)
	sort = universe(b.pairs)
	minors = b.m.cases#1.map(case => {
		hypotheses = case.inductions.map(induction => entered(b.m.c, INDUCTION, sort))
		chain = (1 to #hypotheses).list().reverse().fold(constant(b.products.unit, [b.pairs]), (rest, at) => {
			induction = case.inductions#at
			pair_type(b, b.pairs, b.pairs, pair_type(b, b.values, b.pairs, motive_at(b, induction.indices, induction.field), hypotheses#at.variable), rest)
		})
		lambdas(case.fields + hypotheses, chain)
	})
	value = recursor_into(b, Successor(b.pairs), lambdas(major.indices + [major.value], sort), minors, major.indices, major.value)
	binders = b.m.parameters + [b.m.motives#1] + major.indices + [major.value]
	Declaration(b.type + BELOW, b.m.levels, pis(binders, sort), Defined(lambdas(binders, value)))
}

# `course(parameters, motive, step, indices, t)`: the first of the recursor's pair of the motive's value and the
# values below, each case's minor premise the step at the case given the values below it, paired with them
course_made(b: Built): Declaration := {
	inside = major_entered(b)
	values = entered(b.m.c, BELOW_VALUE, below_at(b, variables(inside.indices), inside.value.variable))
	step = entered(b.m.c, STEP, pis(inside.indices + [inside.value, values], motive_at(b, variables(inside.indices), inside.value.variable)))
	major = major_entered(b)
	minors = b.m.cases#1.map(case => {
		hypotheses = case.inductions.map(induction => entered(b.m.c, INDUCTION, course_value_type(b, induction.indices, induction.field)))
		below_value = (1 to #hypotheses).list().reverse().fold(Chain(constant(b.products.one, [b.pairs]), constant(b.products.unit, [b.pairs])), (rest, at) => {
			induction = case.inductions#at
			first = course_value_type(b, induction.indices, induction.field)
			Chain(pair_made(b, first, rest.type, hypotheses#at.variable, rest.value), pair_type(b, b.pairs, b.pairs, first, rest.type))
		})
		made = apply_all(step.variable, case.indices + [case.value, below_value.value])
		pair = apply_all(constant(b.products.intro, [b.values, b.pairs]), [motive_at(b, case.indices, case.value), below_at(b, case.indices, case.value), made, below_value.value])
		lambdas(case.fields + hypotheses, pair)
	})
	value = projection(b.products.pair, 1, recursor_into(b, b.pairs, lambdas(major.indices + [major.value], course_value_type(b, variables(major.indices), major.value.variable)), minors, major.indices, major.value))
	binders = b.m.parameters + [b.m.motives#1, step] + major.indices + [major.value]
	Declaration(b.type + COURSE, b.m.levels, pis(binders, motive_at(b, variables(major.indices), major.value.variable)), Defined(lambdas(binders, value)))
}
# the values below a case's value, and their type
class Chain { value: Term; type: Term }
