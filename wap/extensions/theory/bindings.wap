# The statements that bind names (notes/theory.md "The declarations that bind names"): `numbers(nat, bool.yes, Equal)`,
# `shortcut(add, plus, plus_zero, plus_successor)` and `texts(text_of, list.empty, list.item)` (numbers.wap), `quotients(Equal)` and `products(Pair, Unit)`; and
# any statement of the explicit spellings checked: the theory's door checks a program so, the elaborator's the prelude
use "../../kernel/environment.wap"
use "explicit.wap"
use "../../kernel/numbers.wap"
use "../../kernel/quotients.wap"
use "below.wap"
use "../../kernel/typing.wap"
use "../../kernel/inductive.wap"
use "../../kernel/show.wap"
use "export.wap"

# a binding statement checked, then recorded with what the environment accepted (export.wap)
binding_declared(e: Environment, binding: WordBinding) := {
	bound(e, binding.word, binding.names)
	e.accepted += [AcceptedBinding(binding.word, binding.names)]
}
# the names a statement binds, each the constant it names here; a shortcut's first name is its kind
bound(e: Environment, word: text, names: list<text>) := {
	if word == SHORTCUT { return shortcut_bound(e, shortcut_kind(names#1), names.drop(1).map(name => named_here(e, name))) }
	constants = names.map(name => named_here(e, name))
	if word == INTEGERS { return integers_declared(e, given(word, constants, 1)#1) }
	if word == QUOTIENTS { return quotients_declared(e, given(word, constants, 1)#1) }
	if word == TEXTS {
		texts = given(word, constants, 3)
		return texts_declared(e, texts#1, texts#2, texts#3)
	}
	if word == PRODUCTS {
		types = given(word, constants, 2)
		return products_declared(e, types#1, types#2)
	}
	parts = given(word, constants, 3)
	numbers_declared(e, parts#1, parts#2, parts#3)
}
# a name a statement is given, as the constant it names here
named_here(e: Environment, name: text): Term := {
	declared_named(e, name)
	constant_of(e, name, [])
}
# the constants a statement is given, refused unless it is given this many
given(word: text, constants: list<Term>, count: int): list<Term> := if #constants == count then constants else refused(word, "${word} takes ${count} names, and is given ${#constants}")

# a statement checked against the declarations before it, and what it says printed or written
statement_checked(e: Environment, statement: Statement) := match statement {
	Declares(declaration) => declared(e, declaration)
	DeclaresBlock(block) => inductive_declared(e, block)
	AsksType(of, levels) => print shown(type_of(checker(e, levels), of))
	AsksAxioms(of) => print axioms_shown(e, named_here(e, of))
	Binds(binding) => binding_declared(e, binding)
	Exports(to) => write(to, exported(e))
	LaysOut(name, parts) => refused(LAYOUT, PROGRAM_LAYOUT)
}
