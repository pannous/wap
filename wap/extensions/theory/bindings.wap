# The statements that bind names (notes/theory.md "The declarations that bind names"): `numbers(nat, bool.yes, Equal)`,
# `shortcut(add, plus, plus_zero, plus_successor)` (numbers.wap), `quotients(Equal)` and `products(Pair, Unit)`; and
# any statement of the explicit spellings checked: the theory's door checks a program so, the elaborator's the prelude
use "environment.wap"
use "explicit.wap"
use "numbers.wap"
use "quotients.wap"
use "below.wap"
use "typing.wap"
use "inductive.wap"
use "show.wap"
use "export.wap"

# a binding statement checked, then recorded with what the environment accepted (export.wap)
binding_declared(e: Environment, binding: Binding) := {
	bound(e, binding.word, binding.names)
	e.accepted += [AcceptedBinding(binding.word, binding.names)]
}
bound(e: Environment, word: text, names: list<text>) := {
	if word == QUOTIENTS { return quotients_declared(e, given(word, names, 1)#1) }
	if word == PRODUCTS {
		types = given(word, names, 2)
		return products_declared(e, types#1, types#2)
	}
	numbers_bound(e, word, names)
}
# the names a statement is given, refused unless it is given this many
given(word: text, names: list<text>, count: int): list<text> := if #names == count then names else refused(word, "${word} takes ${count} names, and is given ${#names}")

# a statement checked against the declarations before it, and what it says printed or written
statement_checked(e: Environment, statement: Statement) := match statement {
	Declares(declaration) => declared(e, declaration)
	DeclaresBlock(block) => inductive_declared(e, block)
	AsksType(of, levels) => print shown(type_of(checker(e, levels), of))
	AsksAxioms(of) => print "[${axioms_of(e, declared_named(e, of).name).join(", ")}]"
	Binds(binding) => binding_declared(e, binding)
	Exports(to) => write(to, exported(e))
}
