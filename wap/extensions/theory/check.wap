# The theory's door (notes/theory.md "The door"): `wap wap/extensions/theory/check.wap program.wap` reads a program in
# the explicit spellings and takes its statements in order. A declaration is checked and added, and nothing is said
# of it; `type of e` prints e's type, `axioms of name` the axioms it rests on. The first refusal is printed as its one
# line and ends the run with a failure.
use "../../core/pipeline.wap"
use "../../core/language.wap"
use "../../core/rules/lowering.wap"
use "terms.wap"
use "environment.wap"
use "typing.wap"
use "inductive.wap"
use "explicit.wap"
use "show.wap"

# the exit code of a program the door refused
REFUSED_EXIT := 1

# a statement checked against the declarations before it, and what it says printed
statement_checked(e: Environment, statement: Statement) := match statement {
	Declares(declaration) => declared(e, declaration)
	DeclaresBlock(block) => inductive_declared(e, block)
	AsksType(of, levels) => print shown(type_of(checker(e, levels), of))
	AsksAxioms(of) => print "[${axioms_of(e, of).join(", ")}]"
}

environment = Environment()
try {
	for unit in units_of(statements_of(operated_file(base_language(), args#1))) { statement_checked(environment, unit_read(environment, unit)) }
} catch refusal {
	print refusal.message
	exit(REFUSED_EXIT)
}
