# The theory's door (notes/theory.md "The door"): `wap wap/extensions/theory/check.wap --tree <root> program.wap` reads a program in
# the explicit spellings and takes its statements in order. A declaration is checked and added, and nothing is said
# of it; `type of e` prints e's type, `axioms of name` the axioms it rests on, `export("file")` writes the statements
# accepted so far for a second checker (export.wap). The first refusal is printed as its one
# line and ends the run with a failure.
use "../../core/pipeline.wap"
use "../../core/language.wap"
use "../../core/rules/lowering.wap"
use "../../kernel/terms.wap"
use "../../kernel/environment.wap"
use "../../core/analyze/courses.wap"
use "explicit.wap"
use "bindings.wap"
use "options.wap"

# the products every environment holds (core/analyze/courses.wap)
environment = Environment()
products_declared(environment)
try {
	for unit in units_of(statements_of(operated_file(base_language(), door_program(door_arguments(args))))) { statement_checked(environment, unit_read(environment, unit)) }
} catch refusal { stopped_by(refusal) }
