# The theory's door (notes/theory.md "The door"): `wap wap/extensions/theory/check.wap program.wap` reads a program in
# the explicit spellings and takes its statements in order. A declaration is checked and added, and nothing is said
# of it; `type of e` prints e's type. The first refusal is printed as its one line and ends the run with a failure.
use "../../core/pipeline.wap"
use "../../core/language.wap"
use "../../core/rules/lowering.wap"
use "terms.wap"
use "environment.wap"
use "typing.wap"
use "explicit.wap"
use "show.wap"
use "numbers.wap"

# the exit code of a program the door refused
REFUSED_EXIT := 1

# the statement checked against the declarations before it, and what it says printed
statement_checked(e: Environment, statement: Node) := match statement_read(e, statement) {
	Declares(declaration) => declared(e, declaration)
	AsksType(of, levels) => print shown(type_of(checker(e, levels), of))
	Binds(word, names) => binding_declared(e, word, names)
}

environment = Environment()
try {
	for statement in statements_of(operated_file(base_language(), args#1)) { statement_checked(environment, statement) }
} catch refusal {
	print refusal.message
	exit(REFUSED_EXIT)
}
