# A term computed to its head (notes/coc-plan.md 6.4; this folder's files: notes/theory.md): beta (a function
# applied to an argument), zeta (a let put into its body) and delta (a definition or theorem replaced by its value).
# Only the head is computed: the arguments stay as they are, equality and typing compute them when they need them.
# Eta is no step of computing; equality applies both sides instead (6.5).

use "terms.wap"
use "environment.wap"
use "typing.wap"
use "equal.wap"
use "quotients.wap"

# t computed until its head is no beta, zeta or delta step
computed(c: Checker, t: Term): Term := {
	kept = not t.holds_free
	if kept {
		earlier = remembered(c.heads, t)
		if earlier is not ø { return earlier }
	}
	result = computed_folded(c, t)
	while yes {
		next_value = unfolded(c, result) ?? break
		result = computed_folded(c, next_value)
	}
	if kept { remember(c.heads, t, result) }
	result
}

# t computed by beta and zeta alone, so the caller chooses what unfolds. The chain of applications is taken apart
# once per step: a function applied to k arguments eats k binders at once
computed_folded(c: Checker, t: Term): Term := {
	result = t
	while yes {
		leading = head(result)
		given = arguments(result)
		match leading.shape {
			LetIn(binder, type, value, body) => { result = apply_all(instantiated(body, value), given) }
			Lambda(binder, domain, body) => {
				if given is empty { break }
				result = beta(leading, given)
			}
			Constant(name, levels) => { result = iota(c, name, levels, given) ?? quotient_step(c, name, given) ?? break }
			_ => break
		}
		stepped(c)
	}
	result
}
# A recursor applied to a case (iota, notes/coc-plan.md 7): the case's computation rule at the recursor's levels,
# applied to the recursor's parameters, motives and minor premises, to the case's fields and to the arguments left
# over; ø for any other head, or a recursor whose major premise computes to no case of its type
iota(c: Checker, name: text, levels: list<Level>, given: list<Term>): Term? := {
	d = declaration(c.environment, name) ?? return ø
	match d.kind {
		Recursor(facts) => {
			shared = facts.parameters + facts.motives + facts.minors
			taken = shared + facts.indices
			if #given <= taken { return ø }
			major = computed(c, given#(taken + 1))
			place = case_place(facts, major)
			if place == 0 and facts.k {
				major = k_case(c, facts, major) ?? return ø
				place = 1
			}
			if place == 0 { return ø }
			apply_all(with_levels(facts.rules#place, d.levels, levels), given.take(shared) + case_fields(major, facts.fields#place) + given.drop(taken + 1))
		}
		_ => ø
	}
}
# a case's fields: the last of its arguments, after its type's parameters
case_fields(value: Term, count: int): list<Term> := arguments(value).drop(#arguments(value) - count)
# the place of a term's head among the recursor's cases, 0 for no case of its type
case_place(facts: RecursorFacts, t: Term): int := match head(t).shape {
	Constant(case, levels) => facts.cases.index_of(case)
	_ => 0
}
# K: a proof of a proposition with one case and no fields, which is no case application, stands for the case at the
# parameters of its type, when the case's type and the proof's type are equal; ø when they are not
k_case(c: Checker, facts: RecursorFacts, proof: Term): Term? := {
	type = computed(c, type_of(c, proof))
	built = match head(type).shape {
		Constant(name, levels) => if name == facts.of then apply_all(constant(facts.cases#1, levels), arguments(type).take(#arguments(type) - facts.indices)) else ø
		_ => ø
	}
	if built is ø or not equal(c, type_of(c, built), type) { return ø }
	built
}
# A quotient's lift or induct applied to a value made by quotient.of (6.4): its function applied to the value the
# made one was made from and to the arguments left over; ø for any other head, or a value not made by quotient.of
quotient_step(c: Checker, name: text, given: list<Term>): Term? := {
	d = declaration(c.environment, name) ?? return ø
	major = match d.kind {
		Quotient(part) => quotient_major(part)
		_ => 0
	}
	if major == 0 or #given < major { return ø }
	made = computed(c, given#major)
	if not made_by_quotient(made) { return ø }
	apply_all(given#QUOTIENT_FUNCTION, [arguments(made)#3] + given.drop(major))
}
# whether a term is quotient.of applied to its type, its relation and a value: lift and induct exist only beside the
# quotient.of their statement made
made_by_quotient(t: Term): bool := #arguments(t) == 3 and match head(t).shape {
	Constant(name, levels) => name == QUOTIENT_OF
	_ => no
}
# a function of nested binders applied to arguments: as many binders as there are arguments eaten at once, the
# arguments it does not take applied to what is left
beta(function: Term, given: list<Term>): Term := {
	body = function
	eaten = 0
	while eaten < #given {
		match body.shape {
			Lambda(binder, domain, inner) => { body = inner; eaten += 1 }
			_ => break
		}
	}
	apply_all(instantiated_all(body, given.take(eaten)), given.drop(eaten))
}

# t with its head constant replaced by its value at the levels it is used at, ø when the head unfolds to nothing:
# an axiom, an opaque constant, a variable, a sort, a number
unfolded(c: Checker, t: Term): Term? := {
	leading = head(t)
	match leading.shape {
		Constant(name, levels) => {
			d = declaration(c.environment, name)
			if d is ø { refused(UNKNOWN_NAME, name) }
			value = unfolding(d) ?? return ø
			stepped(c)
			apply_all(with_levels(value, d.levels, levels), arguments(t))
		}
		_ => ø
	}
}
