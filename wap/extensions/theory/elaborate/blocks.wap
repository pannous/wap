# Enums and classes elaborated into inductive blocks (notes/elaborate.md "Declarations"): the enums next to each
# other that name one another are one block (explicit.wap's units_of), a class is one type with one case named as
# the type, `class Point { x: nat; y: nat }` the enum `Point { Point(x: nat, y: nat) }`.
#
# The header and the cases are read as a definition's header is: a one-letter name nothing binds is a letter. A
# letter of the parameters is a parameter found, before the written ones: `enum Equal(a: T): T -> Prop` takes T
# first. A letter of a case is a field found, before the written ones: `step(e: Even(n)): Even(n + 2)` takes n first.
# A case without a result type gives its type at the parameters; an enum without a header is a Type. Inside the
# cases a type of the block stands for its declaration at the found parameters, so a case writes only the others:
# `refl: Equal(a, a)`. What a call finds: a type its found parameters, a case all the parameters and its found
# fields, a recursor the parameters and the motives.
#
# A trait is a class of its operations (instances.wap): `trait Orderable { less(a: T, b: T): bool }` is
# `class Orderable(T) { less: (a: T, b: T) -> bool }`, its letters its written parameters, read from the operations
# before the header.
use "../terms.wap"
use "../levels.wap"
use "../environment.wap"
use "../inductive.wap"
use "../recursors.wap"
use "../compute.wap"
use "../typing.wap"
use "../show.wap"
use "../explicit.wap"
use "../../../kernel/forms.wap"
use "state.wap"
use "read.wap"
use "unify.wap"
use "declare.wap"
use "lifted.wap"

CLASS_WORD := "class"
TRAIT_WORD := "trait"
# the rule the elaborator's own refusals of a block name
BLOCK := "block"

# a case as written: its name, its fields, and its result type where one is written
class CaseWritten { name: text; fields: list<Node>; result: Node? }
# the enum, class or trait a statement writes: its head `Name(p: A): type` and its cases
class BlockWritten { head: Node; cases: list<CaseWritten>; trait: bool = no }
block_written(statement: Node): BlockWritten? := {
	enum_form = enum_written(statement)
	if enum_form is not ø { return BlockWritten(enum_form!.head, enum_form!.cases.map(case_written)) }
	trait_form = before_cases(after_words(statement, [TRAIT_WORD]) ?? return class_written(statement)) ?? return ø
	BlockWritten(trait_form.head, [CaseWritten(name_of(trait_form.head), trait_form.cases.map(operation_field), ø)], yes)
}
class_written(statement: Node): BlockWritten? := {
	class_form = before_cases(after_words(statement, [CLASS_WORD]) ?? return ø) ?? return ø
	BlockWritten(class_form.head, [CaseWritten(name_of(class_form.head), class_form.cases, ø)])
}
# an operation of a trait as its field: `less(a: T, b: T): bool` as `less: (a: T, b: T) -> bool`
operation_field(n: Node): Node := {
	operation = case_written(n)
	Key(symbol(operation.name), Op.Colon, Call(symbol(FUNCTION_TYPE), [List(operation.fields, Bracket.Round, Separator.Comma), operation.result ?? refused(BLOCK, "the operation ${n} writes no result type")]))
}
# `zero`, `successor(n: nat)`, `zero: Even(0)`, `step(e: Even(n)): Even(n + 2)`
case_written(n: Node): CaseWritten := match n {
	Key(named, Op.Colon, result) => CaseWritten(name_of(named), parameters_of(named), result)
	_ => CaseWritten(name_of(n), parameters_of(n), ø)
}

# nodes as written, to compare
spelled(nodes: list<Node>): list<text> := nodes.map(n => "${n}")

# A case read: its name, its found fields' count, its type over its fields, the block's parameters still free, and
# the conditions lifted out of its fields (lifted.wap)
class CaseRead { name: text; found: int; type: Term; lifted: list<Lifted> }

# The enums or the class of one unit elaborated into one inductive block and declared, with what each of its
# declarations finds
block_elaborated(p: Theory, statements: list<Node>) := {
	x = elaborating(p)
	written_blocks = statements.map(statement => block_written(statement)!)
	names = written_blocks.map(written => name_of(head_named(written.head)))
	# a type takes nothing: one the prelude declares it hides
	kernel_names = names.map(name => declared_name(p, name, []))
	shared = parameters_of(head_named(written_blocks#1.head))
	if written_blocks.any(written => spelled(parameters_of(head_named(written.head))) != spelled(shared)) { refused(BLOCK, "the enums ${names.join(", ")} name each other, so they are one block, and each writes the same parameters") }
	x.header = yes
	written = shared.map(parameter => gone_into(x, named_binder(parameter), ø)) + trait_letters(x, written_blocks#1)
	headers = written_blocks.map(written_block => header_elaborated(x, written_block.head))
	found = x.letters
	parameters = found + written
	types = (1 to #names).list().map(at => scoped(x.el, names#at, closed_filled(x.el, headers#at, written, no)))
	cases = (1 to #names).list().map(at => written_blocks#at.cases.map(case => case_elaborated(x, kernel_names#at, types, types#at, level_reached(x, headers#at), written, case)))
	x.header = no
	all_cases = cases.flat_map(type_cases => type_cases)
	lifting = all_cases.any(case => case.lifted is not empty)
	type_names = if lifting then kernel_names.map(plain_name) else kernel_names
	header_types = headers.map(header => closed_filled(x.el, header, parameters, no))
	levels = x.reading.levels.map(name => Parameter(name)) + level_holes_of(header_types).map(name => Parameter(name))
	standing = (1 to #names).list().map(at => apply_all(constant(type_names#at, levels), found))
	# a case's type and its lifted conditions over the parameters, each type of the block standing for its declaration
	over_parameters = (t: Term, function: bool) => closed_filled(x.el, instead_of(filled(x.el, t), types, standing), parameters, function)
	case_types = all_cases.map(case => over_parameters(case.type, no))
	conditions = all_cases.flat_map(case => case.lifted.map(lifted => over_parameters(lifted.condition, yes)))
	terms = finished(x, header_types + case_types + conditions, #header_types)
	case_terms = terms.drop(#names)
	block_types: list<BlockType> = []
	before = 0
	for at in 1 to #names {
		block_types += [BlockType(type_names#at, terms#at, cases_typed(cases#at, case_terms.drop(before)))]
		before += #cases#at
	}
	inductive_declared(p.environment, InductiveBlock(x.reading.levels, #parameters, block_types))
	if lifting { conditions_lifted(x, type_names, kernel_names, lifted_finished(all_cases, terms.drop(#names + #case_types))) }
	if written_blocks#1.trait { p.traits[names#1] = written_blocks#1.cases#1.fields.map(field => named_binder(field).name) }
	for at in 1 to #names {
		p.found[kernel_names#at] = #found
		p.found[recursor_name(type_names#at)] = #parameters + #names
		for case in cases#at { p.found[case.name] = #parameters + case.found }
	}
}
# a trait's letters, read from its operations: its written parameters
trait_letters(x: Elaborating, written: BlockWritten): list<Term> := {
	if not written.trait { return [] }
	for field in written.cases#1.fields { elaborated(x, named_binder(field).type!, any_sort(x)) }
	letters = x.letters
	x.letters = []
	letters
}
# the type after an enum's parameters: what its head writes after the colon, else Type
header_elaborated(x: Elaborating, head: Node): Term := match head {
	Key(named, Op.Colon, type) => elaborated(x, type, any_sort(x))
	_ => type_at(Zero)
}
# One case read under the block's parameters: its letters and fields gone into, its result type read or the type
# at the written parameters
case_elaborated(x: Elaborating, type_name: text, types: list<Term>, type: Term, level: Level, written: list<Term>, case: CaseWritten): CaseRead := {
	before = #x.letters
	fields = case.fields.map(field => gone_into(x, named_binder(field), ø))
	# a field of a subset that holds the block is of its carrier, its condition lifted out (lifted.wap)
	carried_fields: list<int> = []
	carried_conditions: list<Term> = []
	for at in 1 to #fields {
		hypothesis = hypothesis_of(x.el.c, variable_id(fields#at))
		lifting = carried(x, hypothesis.type, types)
		if lifting is not ø {
			hypothesis.type = lifting!.carrier
			carried_fields += [at]
			carried_conditions += [lifting!.condition]
		}
	}
	# a level of a field's type that nothing fixed is the block's, as the other fields' may be: `item(first: T)` of a
	# Type takes T: Type, and so does `less: T -> T -> bool`
	if not is_zero(level) { for field in fields { for name in level_holes_in(field_level(x, field)) { level_answered(x.el, Parameter(name), level) } } }
	result = if case.result is ø then apply_all(type, written) else elaborated(x, case.result!, any_sort(x))
	letters = x.letters.drop(before)
	x.letters = x.letters.take(before)
	unscoped(x.el, letters + fields)
	inside = letters + fields
	lifted = (1 to #carried_fields).list().map(at => Lifted(#letters + carried_fields#at, closed_filled(x.el, carried_conditions#at, inside, yes)))
	CaseRead("${type_name}${DOT}${case.name}", #letters, closed_filled(x.el, result, inside, no), lifted)
}
# the level of the universe a field's type lies in
field_level(x: Elaborating, field: Term): Level := level_filled(x.el, sort_level(filled(x.el, type_of(x.el.c, filled(x.el, type_of(x.el.c, field))))))
# the level of the sort a type reaches after its binders: Zero of `nat -> Prop`
level_reached(x: Elaborating, type: Term): Level := {
	parts = pi_parts(x, type) ?? return sort_level(computed(x.el.c, filled(x.el, type)))
	level_reached(x, parts.body)
}
# the lifted conditions of each case, each with its finished condition, in the same order
lifted_finished(cases: list<CaseRead>, conditions: list<Term>): list<list<Lifted>> := {
	finished_cases: list<list<Lifted>> = []
	at = 0
	for case in cases {
		finished_case: list<Lifted> = []
		for lifted in case.lifted {
			at += 1
			finished_case += [Lifted(lifted.field, conditions#at)]
		}
		finished_cases += [finished_case]
	}
	finished_cases
}
# the cases read with their finished types, in the same order
cases_typed(cases: list<CaseRead>, types: list<Term>): list<WrittenCase> := (1 to #cases).list().map(place => WrittenCase(cases#place.name, types#place))
# a term with each of these variables replaced by the term standing in its place
instead_of(t: Term, variables: list<Term>, standing: list<Term>): Term := (1 to #variables).list().fold(t, (inner, at) => replaced_by(inner, variable_id(variables#at), standing#at))
