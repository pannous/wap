# The elaborator's census (notes/coc-plan.md S1, test/wap/ratchet_census.sh): `wap
# wap/extensions/theory/elaborate/census.wap --tree <root> program.wap…` elaborates and checks every statement of
# each program as the elaborator's door does, each program alone on the prelude, but a refusal ends only its
# statement. It prints each refusal as `refused <program>: <refusal>`, then the total, `accepted n of N statements`.
use "file.wap"
use "read.wap"
use "../options.wap"
use "../environment.wap"

REFUSED_LINE := "refused "
TOTAL_LINE := "accepted "
# a program the elaborator cannot read counts as one statement, refused
UNREAD_PROGRAM := [0, 1]

refusal_printed(program: text, refusal: Error) := print "${REFUSED_LINE}${program}: ${refusal.message}"
# a program's statements elaborated into a theory of its own, each refusal printed: how many the kernel accepted, of
# how many
program_counted(spellings: Theory, program: text): list<int> := {
	p = Theory()
	p.spellings = spellings.spellings
	p.wap_folder = spellings.wap_folder
	try {
		taken = program_elaborated(p, program, unit => statement_accepted(p, program, unit))
		return [#taken.filter(accepted => accepted), #taken]
	} catch refusal { refusal_printed(program, refusal) }
	UNREAD_PROGRAM
}
# whether the kernel accepted a statement, its refusal printed
statement_accepted(p: Theory, program: text, unit: list<Node>): bool := {
	try {
		unit_elaborated(p, unit)
		return yes
	} catch refusal { refusal_printed(program, refusal) }
	no
}

try {
	arguments = door_arguments(args)
	spellings = Theory()
	spellings_loaded(spellings, arguments.wap_folder)
	counts = arguments.programs.map(program => program_counted(spellings, program))
	print "${TOTAL_LINE}${counts.map(c => c#1).sum} of ${counts.map(c => c#2).sum} statements"
} catch refusal { stopped_by(refusal) }
