# Choices by a condition (notes/elaborate.md "Operators, traits and conditions (E3)"): `if c then a else b` is a match.
# On a bool c it matches c, `yes` giving a and `no` giving b; on a proposition c it matches the decision of c a search
# finds, a `Decidable(c)`: in the arm `is_true(h)` a proof of c holds, in `is_false(h)` one of its negation. A
# proposition nothing decides is refused as an undecidable condition: a proposition is no yes or no to choose by.
use "../../../kernel/terms.wap"
use "../../../kernel/environment.wap"
use "../../../kernel/compute.wap"
use "../../../kernel/typing.wap"
use "../../../kernel/show.wap"
use "../../../kernel/forms.wap"
use "../../../core/analyze/holes.wap"
use "../../../core/analyze/unify.wap"
use "read.wap"
use "match.wap"
use "recursion.wap"
use "instances.wap"
use "sums.wap"

# the enum a decision of a proposition is of, and its cases: the proposition holds, it does not
DECIDABLE := "Decidable"
# the propositions `and` and `or` write between propositions nothing decides
AND := "And"
OR := "Or"
HOLDS := "is_true"
FAILS := "is_false"
# a bool's cases, the one the then-part is chosen by first
TRUTHS := [YES, NO]
# the rule a choice by a proposition nothing decides is refused by
UNDECIDABLE := "undecidable condition"
# how many decisions deep the search builds a decision from the decisions of its parts
SEARCH_DEPTH := 8
# how many values deep a choice inside a recursion is taken apart by the cases of what its condition waits on
CASE_DEPTH := 8

# A choice: a match on the condition's bool, or on the decision of its proposition
if_elaborated(x: Elaborating, condition: Node, then_part: Node, else_part: Node, wanted: Term?): Term := {
	tested = filled(x.el, elaborated(x, condition, ø))
	kept = then_part is True or same_name(then_part, condition)
	written = union_written(x, tested, kept, else_part) ?? connective_written(x, tested, kept, then_part, else_part, wanted)
	if written is not ø { return written! }
	if x.recursing is not ø { return choice_by_cases(x, tested, condition, then_part, else_part, wanted) ?? truth_matched(x, tested, then_part, else_part, wanted) }
	truth_matched(x, tested, then_part, else_part, wanted)
}
# `A and B` and `A or B` reach the elaborator as the choices sugar/conditions.wap writes, If(A, B, no) and
# `{ held = A; If(held, held, B) }` (kept: the then-part is the condition): where A is a proposition nothing decides
# and a type is wanted, they are And(A, B) and Or(A, B)
# (wiki/proposition.md), the other part a proposition too. ø for any other choice, so a choice of data by such a
# condition stays refused, and `if A then yes else no` is no connective
connective_written(x: Elaborating, tested: Term, kept: bool, then_part: Node, else_part: Node, wanted: Term?): Term? := {
	if (then_part is True and else_part is False) or (wanted is not ø and not is_sort(computed(x.el.c, filled(x.el, wanted!)))) { return ø }
	if not is_proposition_term(x, tested) or taken_back(x.el, () => decided(x, tested, SEARCH_DEPTH)) is not ø { return ø }
	if kept { return joined_proposition(x, OR, tested, else_part) }
	if else_part is False { return joined_proposition(x, AND, tested, then_part) }
	ø
}
joined_proposition(x: Elaborating, connective: text, tested: Term, other: Node): Term := apply_all(constant_of(x.theory.environment, kernel_name(x.theory, connective), []), [tested, elaborated(x, other, universe(Zero))])
# Inside a recursion a choice is read by the cases of what its condition waits on (wiki/Footguns.md "Deciding
# termination"): where the arms around decide the condition, only the part chosen; where it waits on a parameter or a
# part of one, a match on that value with the choice again in every arm. So `if equals(n, 0) then … else …
# f(subtract(n, 1))` reads the call where n is a successor, on the value below it, and a choice by `n <= 1` takes n
# apart twice
choice_by_cases(x: Elaborating, tested: Term, condition: Node, then_part: Node, else_part: Node, wanted: Term?): Term? := {
	decided = computed(x.el.c, known_in(x, tested))
	if is_case(decided, TRUTHS#1) { return elaborated(x, then_part, wanted) }
	if is_case(decided, TRUTHS#2) { return elaborated(x, else_part, wanted) }
	if x.cases_deep >= CASE_DEPTH { return ø }
	subject = waiting_on(x.el.c, decided) ?? return ø
	if not within_parameter(x, subject) { return ø }
	x.cases_deep += 1
	taken_apart = subject_matched(x, subject, [ArmWritten(symbol(ANY_CASE#1), If(condition, then_part, else_part))], wanted)
	x.cases_deep -= 1
	taken_apart
}
# whether a variable is a parameter of the recursion being read or a part the arms around took one apart into
within_parameter(x: Elaborating, variable: Term): bool := x.recursing!.parameters.any(parameter => variable_id(variable) in free_variables(known_in(x, filled(x.el, parameter))))
# whether a term is a case of this name
is_case(t: Term, case: text): bool := match head(t).shape {
	Constant(name, levels, _) => names_case(symbol(case), name)
	_ => no
}
# The variable a term's computing waits on: the value its recursor takes apart, or what that value waits on; ø for
# a term that waits on none
waiting_on(c: Checker, t: Term): Term? := {
	stuck = computed(c, t)
	match head(stuck).shape {
		Free(id) => if arguments(stuck) is empty then stuck else ø
		Constant(name, levels, _) => {
			facts = recursor_facts(c.environment, name) ?? return ø
			taken = before_major(facts)
			if #arguments(stuck) <= taken then ø else waiting_on(c, arguments(stuck)#(taken + 1))
		}
		_ => ø
	}
}
# a choice on a bool as the match of its cases, on a proposition as the match of its decision
truth_matched(x: Elaborating, tested: Term, then_part: Node, else_part: Node, wanted: Term?): Term := {
	if not same(computed(x.el.c, filled(x.el, type_of(x.el.c, tested))), PROP) { return subject_matched(x, tested, chosen(TRUTHS, [], then_part, else_part), wanted) }
	subject_matched(x, decision_of(x, tested), chosen([HOLDS, FAILS], [symbol(HOLE_WORD)], then_part, else_part), wanted)
}
# the two arms of a choice: the first case gives the then-part, the second the else-part
chosen(cases: list<text>, fields: list<Node>, then_part: Node, else_part: Node): list<ArmWritten> := [ArmWritten(case_written(cases#1, fields), then_part), ArmWritten(case_written(cases#2, fields), else_part)]
case_written(case: text, fields: list<Node>): Node := if fields is empty then symbol(case) else Key(symbol(case), Op.None, List(fields, Bracket.Round, Separator.Comma))

# the decision of a proposition that is chosen by, refused where nothing decides it
decision_of(x: Elaborating, proposition: Term): Term := decided(x, proposition, SEARCH_DEPTH) ?? refused(UNDECIDABLE, "${shown(proposition)} is a proposition nothing decides: declare a ${DECIDABLE}(${shown(proposition)})")
# The decision of a proposition: the one declaration giving a Decidable that is one of it, each binder it takes found
# by unification or, a decision itself, by the search one step deeper; ø where none is found, and two that decide it
# are refused as overloads are, naming both
decided(x: Elaborating, proposition: Term, depth: int): Term? := {
	if depth == 0 { return ø }
	wanted = apply(constant_of(x.theory.environment, decidable(x), []), proposition)
	deciding = the_only(declared_names(x.theory.environment).filter(name => decides(x, name, wanted, depth)), OVERLOAD, "${shown(proposition)} is decided by") ?? return ø
	decision_by(x, deciding!, wanted, depth)
}
# whether a declaration decides the type wanted, the holes taken back either way
decides(x: Elaborating, name: text, wanted: Term, depth: int): bool := taken_back(x.el, () => decision_by(x, name, wanted, depth) is not ø)
# a declaration's decision of the type wanted, its binders given holes; ø where it gives none, the holes taken back
decision_by(x: Elaborating, name: text, wanted: Term, depth: int): Term? := {
	d = declaration(x.theory.environment, name)!
	if result_name(d.type) != decidable(x) { return ø }
	kept = found_so_far(x.el)
	given = declared_holes(x, name, ø).function
	fits = try { unified(x.el, type_of(x.el.c, given), wanted) and arguments(given).all(binder => binder_decided(x, binder, depth)) } catch e { mismatch(e) }
	if fits { return filled(x.el, given) }
	back_to(x.el, kept)
	ø
}
# a binder's hole answered by unification, else by the decision its type asks for
binder_decided(x: Elaborating, binder: Term, depth: int): bool := {
	value = filled(x.el, binder)
	if not open(x.el, value) { return yes }
	type = computed(x.el.c, filled(x.el, type_of(x.el.c, value)))
	if result_name(type) != decidable(x) or open(x.el, type) { return no }
	decision = decided(x, arguments(type)#1, depth - 1) ?? return no
	unified(x.el, value, decision!)
}
# the enum of decisions where the program reads: its own where it declares one, else the prelude's
decidable(x: Elaborating): text := kernel_name(x.theory, DECIDABLE)
# the name of the constant a type gives after its binders, ø for any other
result_name(type: Term): text? := match head(result_of(type)).shape {
	Constant(name, levels, _) => name
	_ => ø
}
