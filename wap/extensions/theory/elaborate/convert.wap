# Conversions (notes/elaborate.md "Subtypes and obligations (E4)"): where the type wanted differs from the type given,
# the elaborator puts in the one declaration named `convert` that takes the given type to the wanted one: the
# prelude's from a subset to its parent, a program's own between its types. A conversion's value is its last binder,
# the ones before it are found. Two that fit are the refusal `conversion`, naming both. A function is never
# converted: what a function type wants is unified only. A conversion fits only when its fit is decided now: one whose
# unification waits on a hole or a level not yet found is no fit, never a guess.
use "../terms.wap"
use "../environment.wap"
use "../typing.wap"
use "../show.wap"
use "state.wap"
use "unify.wap"
use "read.wap"

# the name of a conversion's declarations
CONVERT_WORD := "convert"
# the rule two conversions between the same types are refused by
CONVERSION := "conversion"

# the term converted to the type wanted, ø where no conversion takes its type there
converted(x: Elaborating, t: Term, given: Term, wanted: Term): Term? := {
	if pi_parts(x, wanted) is not ø { return ø }
	attempt = (name: text) => conversion_given(x, name, t, wanted)
	fit = the_only(fitting(x, declarations_named(x.theory, CONVERT_WORD), attempt), CONVERSION, "${shown(given)} becomes a ${shown(wanted)} by") ?? return ø
	attempt(fit!)
}
# a conversion given t as its value, its other binders found
conversion_given(x: Elaborating, name: text, t: Term, wanted: Term): Term := {
	given = declared_holes(x, name, ø)
	waiting = put_off(x.el)
	if not (unified(x.el, arguments(given.function).last, t) and unified(x.el, given.type, wanted)) or put_off(x.el) > waiting { refused(VALUE_TYPE, "${name} does not take ${shown(filled(x.el, t))} to a ${shown(filled(x.el, wanted))}") }
	given.function
}
# how many problems wait on holes and levels not yet found
put_off(el: Elaboration): int := #el.problems + #el.level_problems
