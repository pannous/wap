# Conversions (notes/elaborate.md "Subtypes and obligations (E4)"): where the type wanted differs from the type given,
# the elaborator puts in the one declaration named `convert` that takes the given type to the wanted one: the
# prelude's from a subset to its parent, a program's own between its types. A conversion's value is its last binder,
# the ones before it are found. Two that fit are the refusal `conversion`, naming both. A function is never
# converted: what a function type wants is unified only. A conversion fits only when its fit is decided now: one that
# leaves a binder or a level of its own waiting on a hole is no fit, never a guess.
use "../../../kernel/terms.wap"
use "../../../kernel/environment.wap"
use "../../../kernel/typing.wap"
use "../../../kernel/show.wap"
use "../../../core/analyze/holes.wap"
use "../../../core/analyze/unify.wap"
use "read.wap"

# the name of a conversion's declarations
CONVERT_WORD := "convert"
# the rule two conversions between the same types are refused by
CONVERSION := "conversion"

# the term converted to the type wanted, ø where no conversion takes its type there
converted(x: Elaborating, t: Term, given: Term, wanted: Term): Term? := {
	if pi_parts(x, wanted) is not ø { return ø }
	attempt = (name: text) => conversion_given(x, name, t, given, wanted)
	fit = the_only(fitting(x, declarations_named(x.theory, CONVERT_WORD), attempt), CONVERSION, "${shown(given)} becomes a ${shown(wanted)} by") ?? return ø
	attempt(fit!)
}
# a conversion given t, of type `from`, as its value, its other binders found
conversion_given(x: Elaborating, name: text, t: Term, from: Term, wanted: Term): Term := {
	given = declared_holes(x, name, ø)
	value = arguments(given.function).last
	if not (unified(x.el, type_of(x.el.c, value), from) and unified(x.el, value, t) and unified(x.el, given.type, wanted) and all_found(x, given.function)) { refused(VALUE_TYPE, "${name} does not take ${shown(filled(x.el, t))} to a ${shown(filled(x.el, wanted))}") }
	given.function
}
# whether the conversion has found its binders before its value, and its levels: none waits on a hole
all_found(x: Elaborating, conversion: Term): bool := {
	found = filled(x.el, conversion)
	given = arguments(found)
	([head(found)] + given.take(#given - 1)).all(part => not open(x.el, part))
}
