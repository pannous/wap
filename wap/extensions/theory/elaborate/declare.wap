# A statement elaborated (notes/elaborate.md "Declaring"): a declaration's header read first, its letters becoming
# found binders, then its value read against the header's type; what is still open when it is read whole is refused
# as `cannot find`, and what is filled goes to the kernel, which judges it. `type of e` prints e's type, `export("file")`
# writes what the kernel accepted so far (../export.wap).
use "../terms.wap"
use "../levels.wap"
use "../environment.wap"
use "../typing.wap"
use "../compute.wap"
use "../equal.wap"
use "../show.wap"
use "../explicit.wap"
use "../export.wap"
use "../../../kernel/forms.wap"
use "../../../core/type_notation.wap"
use "state.wap"
use "read.wap"
use "recursion.wap"
use "instances.wap"
use "effects.wap"
use "templates.wap"
use "../../prove/prove.wap"
use "lifted.wap"

# the names a level hole left in a declaration's type becomes, the first one not written already; past them a name
# and a count
LEVEL_NAMES := ["u", "v", "w"]
# the refusal of a theorem without a proof
UNPROVED_THEOREM := "unproved theorem"
# the proof that leaves a gap: the statement is declared as an axiom, and every report names it
ASSUME_WORD := "assume"
# the proof that names laws for the provers to try first: `:= by add_zero, add_commutes`
BY_WORD := "by"
# the refusal of `by` naming a law that is not proved, or of the laws it names proving nothing
UNPROVED_BY := "unproved by"
# the declarations `wap verify` gives a verdict
REPORTED_WORDS := [AXIOM_WORD, LAW_WORD, THEOREM_WORD]

# A statement of a program in the lowered forms: a definition, an axiom, `type of e`, `export("file")` or a value
statement_elaborated(p: Theory, statement: Node) := match statement {
	Define(named, parameters, value) => declaration_elaborated(p, "", statement)
	Call(called, arguments) => {
		word = text(called)
		typed = asked_about(QUESTION_WORDS, word, arguments)
		if typed is not ø { return answered(p, shown(asked_type(p, typed!))) }
		resting = asked_about(AXIOMS_QUESTION_WORDS, word, arguments)
		if resting is not ø { return answered(p, axioms_shown(p.environment, text(resting!))) }
		effecting = asked_about(EFFECTS_QUESTION_WORDS, word, arguments)
		if effecting is not ø { return answered(p, effects_asked(p, text(effecting!))) }
		if word in DECLARATION_WORDS and #arguments == 1 { return declaration_elaborated(p, word, arguments#1) }
		if word == EXPORT_WORD and #arguments == 1 { return write(text(arguments#1), exported(p.environment)) }
		computed(p, statement)
	}
	_ => computed(p, statement)
}

# a question's answer printed, where the door says them (the run door's output is the program alone)
answered(p: Theory, answer: text) := if p.answering { print answer }
# what a question of two words, `type of e` or `axioms of name`, asks about; ø for another call
asked_about(words: list<text>, word: text, arguments: list<Node>): Node? := if word == words#1 and #arguments == 2 and text(arguments#1) == words#2 then arguments#2 else ø

# the word of a line naming a statement's parameter, `for x: T`
FOR_WORD := "for"

# A declaration under its word (empty for a plain definition), `axiom name: type` or `theorem name(parameters): type := proof`: the
# definition the word is called on, or a typed name without a value
declaration_elaborated(p: Theory, word: text, n: Node) := match n {
	Define(named, parameters, value) => {
		written = items_or_one(parameters)
		if word == "" and written.any(parameter => named_binder(parameter).type is ø) { untyped_elaborated(p, named, written, value) } else { definition_elaborated(p, word, named, written, value) }
	}
	_ => definition_elaborated(p, word, n, [], ø)
}

# A declaration `name(parameters): type := value` elaborated and declared. Its header is read first, where a letter
# nothing binds becomes a found binder; its type is the one written, else its value's. A theorem must be proved; a law
# without a proof goes to the provers, and one they cannot prove is a hint, kept beside the environment and never
# declared, so nothing can prove by it. A parameter without a written type takes its type from `typed`, a template's
# version (templates.wap). The name it is declared by; ø for a law kept as a hint
definition_elaborated(p: Theory, word: text, head: Node, written_parameters: list<Node>, value: Node?, typed: list<Term> = []): text? := {
	quantified = quantified_head(head)
	named = quantified.named
	parameters = written_parameters + quantified.parameters
	x = elaborating(p)
	name = definition_name(named)
	written_type = if is_binder(named) then binder_type(named) else ø
	if written_type is ø and value is ø { unelaborated(named) }
	if word == THEOREM_WORD and value is ø { refused(UNPROVED_THEOREM, "theorem ${name} has no proof: prove it after `:=`, or state it as a law, which may stay unproved") }
	header = header_read(x, parameters, written_type, typed)
	written = header.written
	result = header.result
	x.recursing = Recursion(name, written)
	assumed = value is not ø and text(value!) == ASSUME_WORD
	by_laws = if value is ø then ø else laws_named(p, value!)
	given = if value is ø then ø else bounded(x, value!, parameters)
	kept = found_so_far(x.el)
	diverged = no
	x.lifting = not (word in PROVED_WORDS)
	read = if value is ø or assumed or by_laws is not ø then ø else try { body_read(x, result, wanted => elaborated(x, given!.body, wanted)) } catch e {
		if not may_not_end(e) { raise e.message }
		back_to(x.el, kept)
		diverged = yes
		diverging(x, word, name, result, given!.body, e)
	}
	body = if read is ø then ø else read!.body
	instances_filled(x)
	type = (if read is ø then result else read!.result) ?? type_of(x.el.c, filled(x.el, body!))
	variables = x.letters + written
	closed_type = closed_filled(x.el, type, variables, no)
	provable = not (word in PROVED_WORDS) or assumed or statement_pure(x, name, closed_type, value)
	terms = finished(x, [closed_type] + (if body is ø then [] else [closed_filled(x.el, body!, variables, yes)]))
	if word in REPORTED_WORDS { p.stated += [name] }
	if assumed { p.assumed += [name] }
	proof = if body is not ø then terms#2 else if provable and (by_laws is not ø or (word == LAW_WORD and not assumed)) then proof_found(elaboration(p.environment, x.reading.levels), terms#1, by_laws ?? []) else ø
	if by_laws is not ø and proof is ø { refused(UNPROVED_BY, "${name} is not proved by ${by_laws!.map(law => law.name).join(", ")}: name in `by` the laws its steps need") }
	if word == LAW_WORD and proof is ø and not assumed {
		p.unproved_laws[name] = terms#1
		return ø
	}
	if given is not ø { within_bound(x, name, terms#1, given!.bound) }
	declaration = overloaded(p, Declaration(name, x.reading.levels, terms#1, declaration_kind(if diverged then OPAQUE_WORD else word, proof)), #x.letters, #variables)
	declared(p.environment, declaration)
	if x.recursing!.called and given is not ø { run_body_kept(p, declaration, parameters, written_type, typed, given!.body, diverged) }
	declaration.name
}

# A declaration's header read: its written parameters gone into, a parameter without a written type taking it from
# `typed`, and its written result; the header's instances found before the body, which may compute with them
class Header { written: list<Term>; result: Term? }
header_read(x: Elaborating, parameters: list<Node>, written_type: Node?, typed: list<Term>): Header := {
	x.header = yes
	written = (1 to #parameters).list().map(at => gone_into(x, named_binder(parameters#at), if at <= #typed then typed#at else ø))
	result = if written_type is ø then ø else elaborated(x, written_type!, any_sort(x))
	x.header = no
	instances_filled(x)
	Header(written, result)
}

# A function that calls itself runs by its body as written, its calls of itself calls of the constant now declared
# (notes/coc-plan.md 9.7): the body read again, checked by the kernel to have the function's type, and kept where the
# function equals it at every argument, a law the provers prove; one that may not end needs none, since nothing is
# proved of it. Why a body could not be kept is what erase says of the function (../run/erase.wap)
run_body_kept(p: Theory, d: Declaration, parameters: list<Node>, written_type: Node?, typed: list<Term>, body: Node, diverged: bool) := try {
	x = elaborating(p)
	x.lifting = yes
	header = header_read(x, parameters, written_type, typed)
	read = body_read(x, header.result, wanted => elaborated(x, body, wanted))
	instances_filled(x)
	run = finished(x, [closed_filled(x.el, read.body, x.letters + header.written, yes)])#1
	c = checker(p.environment, d.levels)
	if not equal(c, type_of(c, run), d.type) { refused(RUNNING, "${d.name} as written has the type ${shown_for(c, type_of(c, run))}, not its own ${shown_for(c, d.type)}") }
	if not diverged { unfolding_proved(p, d, run) }
	p.run_terms[d.name] = run
} catch e { p.run_refusals[d.name] = e.message }
# that a function equals its body as written at every argument, proved and declared as `<function>.unfolds`
UNFOLDS := ".unfolds"
unfolding_proved(p: Theory, d: Declaration, run: Term) := {
	c = checker(p.environment, d.levels)
	variables: list<Term> = []
	result = d.type
	while yes {
		match result.shape {
			Pi(binder, domain, body) => {
				variable = hypothesis(c, binder, domain)
				variables += [variable]
				result = instantiated(body, variable)
			}
			_ => break
		}
	}
	function = constant(d.name, d.levels.map(level => Parameter(level)))
	equality = apply_all(constant(kernel_name(p, EQUAL), [level_of(c, result)]), [result, apply_all(function, variables), beta(run, variables)])
	statement = closed_over(c, equality, variables, no)
	proof = proof_found(elaboration(p.environment, d.levels), statement, []) ?? refused(RUNNING, "that ${d.name} equals its body as written is not proved")
	declared(p.environment, Declaration(d.name + UNFOLDS, d.levels, statement, Theorem(proof)))
}

# A head whose statement starts with lines `for x: T`, each one a parameter as `law name(x: T)` writes it
# (wiki/proposition.md: `for n: nat` before a statement is the same as a parameter), the rest the statement
class Quantified { named: Node; parameters: list<Node> }
quantified_head(head: Node): Quantified := {
	lines = match binder_type(head) {
		List(items, Bracket.Curly, separator) => items
		_ => return Quantified(head, [])
	}
	count = 0
	while count < #lines and for_binder(lines#(count + 1)) is not ø { count += 1 }
	# `for` lines alone are no statement: the law reads as written
	if count == 0 or count == #lines or not is_binder(head) { return Quantified(head, []) }
	rest = lines.drop(count)
	Quantified(Key(symbol(binder_name(head)), Op.Colon, if #rest == 1 then rest#1 else List(rest, Bracket.Curly, Separator.Newline)), lines.take(count).map(line => for_binder(line)!))
}
# the binder of a line `for x: T`, ø for any other line
for_binder(line: Node): Node? := match line {
	List(items, Bracket.None, Separator.Space) => if #items == 2 and text(items#1) == FOR_WORD and is_binder(items#2) then items#2 else ø
	_ => ø
}
# the name a definition's head declares, `f` of `f: T` and of `f`
definition_name(named: Node): text := if is_binder(named) then binder_name(named) else text(named)

# the laws a proof `by a, b` names, each proved before; ø for any other proof
laws_named(p: Theory, value: Node): list<Declaration>? := match value {
	Call(called, arguments) => if text(called) == BY_WORD then arguments.flat_map(items_or_one).map(law => named_law(p, text(law))) else ø
	_ => ø
}
named_law(p: Theory, name: text): Declaration := declaration(p.environment, kernel_name(p, name)) ?? refused(if p.unproved_laws.has(name) then UNPROVED_BY else UNKNOWN_NAME, "`by` names ${name}, which is no law proved before")

# A declaration under the name it is declared by, its kernel name (`declared_name`), or for a second declaration of a
# name, the name and its own binders' types after the found ones, an overload of the name; one taking the same types
# as another, its result too, as `convert(bool): any` beside `convert(bool): Prop`, the overloads told apart by the
# type wanted. What a call of it finds is kept: its first `found` binders, of the `own` its header writes or finds
overloaded(p: Theory, d: Declaration, found: int, own: int): Declaration := {
	parts = binders_written(d.type, [], own)
	key = keyed(p, d.name, parts.taken.drop(found), parts.result)
	p.found[key] = found
	p.binders[key] = own
	Declaration(key, d.levels, d.type, d.kind)
}
keyed(p: Theory, name: text, taken: list<text>, result: text): text := {
	kernel = declared_name(p, name)
	if declaration(p.environment, kernel) is ø { return kernel }
	taking = "${kernel}(${taken.join(", ")})"
	key = if declaration(p.environment, taking) is ø then taking else "${taking}: ${result}"
	p.overloads[kernel] = (p.overloads.get(kernel) ?? [kernel]) + [key]
	key
}
# a type's first `own` binders' types and what is left, its result, as written
class Written { taken: list<text>; result: text }
binders_written(type: Term, names: list<text>, own: int): Written := match type.shape {
	Pi(binder, domain, body) => if own == 0 then Written([], shown_in(type, names, no_free_names())) else {
		inner = binders_written(body, names + [binder], own - 1)
		Written([shown_in(domain, names, no_free_names())] + inner.taken, inner.result)
	}
	_ => Written([], shown_in(type, names, no_free_names()))
}
# An explicit declaration's found binders, which its header writes as it writes every binder: the leading sorts a
# later binder's type names, the letters an elaborated header would leave unwritten (`count(T: Sort(u), xs: list(T))`
# is `count(xs: list(T))`)
explicit_found(type: Term): int := match type.shape {
	Pi(binder, domain, body) => if is_sort(domain) and named_later(body, 0) then 1 + explicit_found(body) else 0
	_ => 0
}
# whether a binder is named by the type of a binder after it
named_later(type: Term, index: int): bool := match type.shape {
	Pi(binder, domain, body) => mentions(domain, index) or named_later(body, index + 1)
	_ => no
}

# A term elaborated alone and filled: its type, then the term
asked(p: Theory, n: Node): list<Term> := {
	x = elaborating(p)
	t = elaborated(x, n, ø)
	instances_filled(x)
	finished(x, [type_of(x.el.c, filled(x.el, t)), filled(x.el, t)])
}
# the type of a term elaborated alone, a function at its head applied: a match's type is its motive's at the value
asked_type(p: Theory, n: Node): Term := {
	type = asked(p, n)#1
	beta(head(type), arguments(type))
}
# a statement that computes a value, `double(3)`: checked, and kept as the program's value, the last one shown when it
# runs, as a script shows its last statement's (sugar/calls.wap)
computed(p: Theory, n: Node) := p.values.add(asked(p, n)#2)

# Terms read whole, filled: a hole without an answer, or a level problem that does not hold, cannot be found; a level
# hole left in the leading terms (a declaration's type, a block's headers) becomes a level parameter, one left only
# in the others cannot be found
finished(x: Elaborating, terms: list<Term>, leading: int = 1): list<Term> := {
	filled_terms = terms.map(t => filled(x.el, t))
	open = filled_terms.flat_map(t => holes_in(x.el, t)).unique()
	if open is not empty { refused(CANNOT_FIND, "${open.map(id => x.el.holes#id.name).join(", ")} cannot be found from what is written") }
	if not level_problems_hold(x.el) { refused(CANNOT_FIND, "a universe level cannot be found from what is written") }
	holes = level_holes_of(filled_terms.take(leading))
	if filled_terms.drop(leading).any(t => term_level_holes(t).any(name => not (name in holes))) { refused(CANNOT_FIND, "a universe level cannot be found from what is written") }
	names = holes.map(hole => level_named(x.reading))
	filled_terms.map(t => with_levels(t, holes, names.map(name => Parameter(name))))
}
# the level holes left in filled terms, each once, in the order they are met
level_holes_of(terms: list<Term>): list<text> := terms.flat_map(term_level_holes).unique()
# a new level parameter of the reading, by the first name not taken
level_named(r: Reading): text := {
	at = 1
	while level_name(at) in r.levels { at += 1 }
	r.levels += [level_name(at)]
	level_name(at)
}
level_name(at: int): text := if at <= #LEVEL_NAMES then LEVEL_NAMES#at else "${LEVEL_NAMES#1}${at}"
