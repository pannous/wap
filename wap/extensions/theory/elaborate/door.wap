# The elaborator's door (notes/elaborate.md "What it reads and writes"): `wap wap/extensions/theory/elaborate/door.wap
# --tree <root> program.wap` checks the prelude of the wap tree <root> (wap/extensions/theory/prelude/) and then reads a program as it
# is written, the arguments, levels and types it leaves out found, and takes its statements in order. A program's
# declaration of a name the prelude declares hides the prelude's from there on. A declaration is elaborated, checked by
# the kernel and added, and nothing is said of it; `type of e` prints e's type. The first refusal is printed as its one
# line and ends the run with a failure. It reads the statements before lowering, which the elaborator replaces at the
# switch: an enum or class unit is read as written, a statement that binds names (`products(Pair, Unit)`) as the
# theory's door reads it, any other statement lowered alone first.
use "../../../core/pipeline.wap"
use "../../../core/language.wap"
use "../../../core/rules/lowering.wap"
use "../environment.wap"
use "../explicit.wap"
use "../bindings.wap"
use "../options.wap"
use "read.wap"
use "declare.wap"
use "blocks.wap"

# the prelude's files, each using the ones before it, read in the explicit spellings
PRELUDE_FOLDER := "wap/extensions/theory/prelude"
PRELUDE_FILES := ["logic", "numbers", "quotient", "data"]
NO_TREE := "the elaborator's door reads its prelude from the wap tree it is given: door.wap ${TREE_OPTION} <root> program.wap"

# a declaration word's declaration is lowered without its word, which lowering does not know
unit_elaborated(p: Theory, language: Language, unit: list<Node>) := {
	statement = unit#1
	if block_written(statement) is not ø { return block_elaborated(p, unit) }
	binding = binding_written(statement)
	if binding is not ø { return binding_declared(p.environment, Binding(binding!.word, binding!.names.map(name => kernel_name(p, name)))) }
	for word in DECLARATION_WORDS {
		declared = after_words(statement, [word])
		if declared is not ø { return declaration_elaborated(p, word, lowered(language, declared!)) }
	}
	statement_elaborated(p, lowered(language, statement))
}

# the prelude checked into the theory's environment, its declarations counted
prelude_checked(p: Theory, language: Language) := {
	for file in PRELUDE_FILES {
		for unit in units_of(statements_of(operated_file(language, in_folder(p.tree!, "${PRELUDE_FOLDER}/${file}.wap")))) { statement_checked(p.environment, unit_read(p.environment, unit)) }
	}
	p.prelude_size = #p.environment.places
}

language = base_language()
theory = Theory()
try {
	given = door_arguments(args)
	if given.tree is ø { raise NO_TREE }
	theory.tree = given.tree
	prelude_checked(theory, language)
	for unit in units_of(statements_of(operated_file(language, given.program))) { unit_elaborated(theory, language, unit) }
} catch refusal { stopped_by(refusal) }
