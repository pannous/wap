# The elaborator's door (notes/elaborate.md "What it reads and writes"): `wap wap/extensions/theory/elaborate/door.wap
# --tree <root> program.wap` reads a program as it is written, the arguments, levels and types it leaves out found, and takes its
# statements in order. A declaration is elaborated, checked by the kernel and added, and nothing is said of it;
# `type of e` prints e's type. The first refusal is printed as its one line and ends the run with a failure. It reads
# the statements before lowering, which the elaborator replaces at the switch: an enum or class unit is read as
# written, a statement that binds names (`products(Pair, Unit)`) as the theory's door reads it, any other statement
# lowered alone first.
use "../../../core/pipeline.wap"
use "../../../core/language.wap"
use "../../../core/rules/lowering.wap"
use "../environment.wap"
use "../explicit.wap"
use "../bindings.wap"
use "read.wap"
use "declare.wap"
use "blocks.wap"

# a declaration word's declaration is lowered without its word, which lowering does not know
unit_elaborated(p: Theory, unit: list<Node>) := {
	statement = unit#1
	if block_written(statement) is not ø { return block_elaborated(p, unit) }
	binding = binding_written(statement)
	if binding is not ø { return binding_declared(p.environment, binding!) }
	for word in DECLARATION_WORDS {
		declared = after_words(statement, [word])
		if declared is not ø { return declaration_elaborated(p, word, formed(p, declared!)) }
	}
	statement_elaborated(p, formed(p, statement))
}

# `door.wap --tree <root> program.wap`: the wap tree the prelude and the rules are read from
TREE_OPTION = "--tree"
# the folder of the tree the language is in
WAP_FOLDER = "wap"

# the door read without its tree would read the language's spellings, `if` and `match` among them, as no form
USAGE = "the door reads a program by the rules of a wap tree: door.wap ${TREE_OPTION} <root> program.wap"

if #args < 3 or args#1 != TREE_OPTION {
	print USAGE
	exit(REFUSED_EXIT)
}
language = base_language()
spellings = base_language()
rules_files_loaded(spellings, in_folder(args#2, WAP_FOLDER))
theory = Theory(tree: args#2, spellings: spellings)
try {
	for unit in units_of(statements_of(operated_file(language, args.last))) { unit_elaborated(theory, unit) }
} catch refusal { stopped_by(refusal) }
