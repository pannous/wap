# The elaborator's door (notes/elaborate.md): `wap wap/extensions/theory/elaborate/door.wap program.wap` reads a
# program as it is written, the arguments, levels and types it leaves out found, and takes its statements in order. A
# declaration is elaborated, checked by the kernel and added, and nothing is said of it; `type of e` prints e's type.
# The first refusal is printed as its one line and ends the run with a failure.
use "../../../core/bindings.wap"
use "../../../core/pipeline.wap"
use "../../../core/language.wap"
use "../../../core/rules/lowering.wap"
use "../environment.wap"
use "read.wap"
use "declare.wap"

language = base_language()
theory = Theory()
try {
	for statement in statements_in(lowered_program(language, operated_file(language, args#1))) { statement_elaborated(theory, statement) }
} catch refusal { stopped_by(refusal) }
