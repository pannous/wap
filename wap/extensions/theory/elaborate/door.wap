# The elaborator's door (notes/elaborate.md "What it reads and writes"): `wap wap/extensions/theory/elaborate/door.wap
# program.wap` elaborates a program statement by statement and prints as the kernel's door does: nothing for an
# accepted declaration, the type for `type of e`, the first refusal as its one line, which ends the run with a
# failure. It reads the statements before lowering, which the elaborator replaces at the switch: an enum or class
# unit is read as written, any other statement lowered alone first.
use "../../../core/pipeline.wap"
use "../../../core/language.wap"
use "../../../core/rules/lowering.wap"
use "../explicit.wap"
use "read.wap"
use "declare.wap"
use "blocks.wap"

# the exit code of a program the door refused
REFUSED_EXIT := 1

# a declaration word's declaration is lowered without its word, which lowering does not know
unit_elaborated(p: Theory, language: Language, unit: list<Node>) := {
	statement = unit#1
	if block_written(statement) is not ø { return block_elaborated(p, unit) }
	for word in DECLARATION_WORDS {
		declared = after_words(statement, [word])
		if declared is not ø { return declaration_elaborated(p, word, lowered(language, declared!)) }
	}
	statement_elaborated(p, lowered(language, statement))
}

language = base_language()
theory = Theory()
try {
	for unit in units_of(statements_of(operated_file(language, args#1))) { unit_elaborated(theory, language, unit) }
} catch refusal {
	print refusal.message
	exit(REFUSED_EXIT)
}
