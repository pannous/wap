# Effects (notes/elaborate.md "Effects (E5)", notes/coc-plan.md 3.8 and 9): what a function may do beyond computing a
# value is part of its type. `T ! IO` is the prelude's Eff(e, T), e the set of the effects named: a yes or no for each
# field of the prelude's Effects case, whose fields are the effects' words, none of them listed here. A recursion that
# is neither structural nor by a measure may not end: it is an opaque constant of `T ! Div`, which never unfolds, so it
# proves nothing and rests on no axiom; it runs by its body as written.
use "../../../kernel/terms.wap"
use "../../../kernel/environment.wap"
use "../../../kernel/compute.wap"
use "../../../kernel/typing.wap"
use "../../../kernel/show.wap"
use "../explicit.wap"
use "../../../kernel/forms.wap"
use "../../../core/type_notation.wap"
use "../../../core/analyze/holes.wap"
use "../../../core/analyze/unify.wap"
use "read.wap"
use "conditions.wap"
use "blocks.wap"
use "recursion.wap"
use "sums.wap"

# `T ! IO`, `f(x) := … ! Pure`: the mark of effects, and the question `effects of f`
EFFECT_MARK := "!"
EFFECTS_QUESTION_WORDS := ["effects", "of"]
# the prelude's effect sets, their one case, the set of what may not end, the computation types and the computation
# that never returns
EFFECTS := "Effects"
EFFECT_SET := "set"
DIVERGING := "diverging"
COMPUTATION := "Eff"
NEVER := "never"
# what `effects of` says of a function of no effect
PURE_WORD := "Pure"
# the prelude's computation of a value, one run with its value handed on, and one with fewer effects as one with more
PURE := "pure"
BIND := "bind"
WIDENED := "widened"
# the name of the value a computation run gives, where the program reads it
RAN := "ran"
# the elaborator's rule a computation where none may be, or a function past its written bound, is refused by
EFFECT := "effect"

# the effects' words: the fields of the Effects case, in order
effect_words(x: Elaborating): list<text> := binder_names(declared_effect(x, effect_case(x), "whose fields are the effects").type)
effect_case(x: Elaborating): text := "${kernel_name(x.theory, EFFECTS)}${DOT}${EFFECT_SET}"
# a declaration of the prelude's effects, refused loudly where the prelude has none
declared_effect(x: Elaborating, name: text, what: text): Declaration := declaration(x.theory.environment, name) ?? refused(UNKNOWN_NAME, "nothing declares ${name}, ${what}")
# the effects of a set: the words of its fields that are yes
set_words(x: Elaborating, set: Term): list<text> := {
	fields = arguments(computed(x.el.c, set))
	words = effect_words(x)
	(1 to #words).list().filter(at => result_name(computed(x.el.c, fields#at)) == case_constructed(kernel_name(x.theory, BOOL), YES)).map(at => words#at)
}
# the effects of what may not end, the prelude's set of them
diverging_effects(x: Elaborating): list<text> := {
	name = kernel_name(x.theory, DIVERGING)
	declared_effect(x, name, "the effects of what may not end")
	set_words(x, constant_of(x.theory.environment, name, []))
}
# the effects words name, each its case aside, which a note says
effects_written(x: Elaborating, words: list<Node>): list<text> := words.map(word => effect_named(x, text(word)))
effect_named(x: Elaborating, word: text): text := {
	known = effect_words(x)
	found = known.find(effect => lower(effect) == lower(word)) ?? refused(EFFECT, "${word} is no effect: the effects are ${known.join(", ")}")
	if found! != word { eprint("got it: ${word} is ${found!}") }
	found!
}
# the set of these effects, a yes or no for each
effect_set(x: Elaborating, effects: list<text>): Term := apply_all(constant_of(x.theory.environment, effect_case(x), []), effect_words(x).map(word => bool_value(x, if effects.contains(word) then YES else NO)))
# `T ! effects`: the computations with those effects that give a T; of a computation type, its own with these joined
computation(x: Elaborating, effects: list<text>, type: Term): Term := {
	if is_computation(x, type) {
		parts = arguments(folded(x, type))
		return computation(x, unique(set_words(x, parts#1) + effects), parts#2)
	}
	apply_all(constant_of(x.theory.environment, kernel_name(x.theory, COMPUTATION), [level_of(x, type)]), [effect_set(x, effects), type])
}
# the computation of a computation type that never returns
never_given(x: Elaborating, computations: Term): Term := {
	parts = arguments(folded(x, computations))
	apply_all(constant_of(x.theory.environment, kernel_name(x.theory, NEVER), [level_of(x, parts#2)]), parts)
}
# the level of a type's sort, which the prelude's computations of it take
level_of(x: Elaborating, type: Term): Level := sort_level(computed(x.el.c, filled(x.el, type_of(x.el.c, filled(x.el, type)))))
# whether a type is a computation type, `T ! e`; a function into one is none, it is a value
is_computation(x: Elaborating, type: Term): bool := match head(folded(x, type)).shape {
	Constant(name, levels, _) => name == kernel_name(x.theory, COMPUTATION)
	_ => no
}
# a type with its definitions unfolded until a function type or a computation type is reached, which stays named,
# never unfolded
folded(x: Elaborating, type: Term): Term := {
	t = computed_folded(x.el.c, filled(x.el, type))
	while result_name(t) != kernel_name(x.theory, COMPUTATION) and not is_function_type(t) { t = computed_folded(x.el.c, unfolded(x.el.c, t) ?? break) }
	t
}
is_function_type(t: Term): bool := match t.shape {
	Pi(binder, domain, body) => yes
	_ => no
}
# what a function's type gives after all its binders, each a variable of its type, unfolded as far
ended_in(x: Elaborating, type: Term): Term := {
	t = folded(x, type)
	match t.shape {
		Pi(binder, domain, body) => ended_in(x, instantiated(body, hypothesis(x.el.c, binder, domain)))
		_ => t
	}
}
# What `T ! IO` writes, the mark glued to its subject and the effects' words after it, a list by spaces: those two;
# ø for any other form
class Marked { subject: Node; words: list<Node> }
effect_marked(n: Node): Marked? := match unwrapped(n) {
	List(items, bracket, Separator.Space) => match unwrapped(items#1) {
		Call(mark, subject) => if text(mark) == EFFECT_MARK and #subject == 1 and #items > 1 then Marked(subject#1, items.drop(1).flat_map(items_or_one)) else ø
		_ => ø
	}
	_ => ø
}
# `T ! IO` read: the computations of the type with the effects named; ø for a form with no mark
computation_read(x: Elaborating, n: Node): Term? := {
	marked = effect_marked(n)
	if marked is ø { return ø }
	type = elaborated(x, marked!.subject, ø)
	if not is_sort(computed(x.el.c, filled(x.el, type_of(x.el.c, filled(x.el, type))))) {
		refused(EFFECT, "misplaced effect constraint: ${text(marked!.subject)} is no type, and `! …` bounds a function's effects or names a computation's type")
	}
	computation(x, effects_written(x, marked!.words), type)
}
# the effects a function's type gives: those of the computation it ends in, none where it ends in no computation
effects_given(x: Elaborating, type: Term): list<text> := {
	result = ended_in(x, type)
	if is_computation(x, result) then set_words(x, arguments(result)#1) else []
}
# effects as wiki/effects.md writes them: Pure, one effect, or several in brackets
effects_shown(effects: list<text>): text := if effects is empty then PURE_WORD else if #effects == 1 then effects#1 else "(${effects.join(" ")})"
# `effects of f`: the effects the declaration's type gives
effects_asked(p: Theory, name: text): text := {
	x = elaborating(p)
	effects_shown(effects_given(x, declared_named(p.environment, kernel_name(p, name)).type))
}

# A definition's body and the bound written after it, `f(x) := … ! IO`; the body alone where none is written
class Bounded { body: Node; bound: list<text>? }
bounded(x: Elaborating, value: Node, parameters: list<Node>): Bounded := {
	marked = effect_marked(value)
	if marked is ø or parameters is empty then Bounded(value, ø) else Bounded(marked!.subject, effects_written(x, marked!.words))
}
# a function's effects within its written bound, else refused naming what it does past it
within_bound(x: Elaborating, name: text, type: Term, bound: list<text>?) := {
	if bound is ø { return }
	past = effects_given(x, type).filter(effect => not bound!.contains(effect))
	if past is not empty { refused(EFFECT, "${name} is declared ! ${effects_shown(bound!)} but has ${effects_shown(past)}") }
}
# a computation where a value is wanted: refused, since what has effects is used only inside another computation
# inside a proof, where nothing runs, refused naming the chain from the proof to what has them
computation_refused(x: Elaborating, t: Term, given: Term) := {
	if not is_computation(x, given) { return }
	called = shown_for(x.el.c, head(filled(x.el, t)))
	chain = if x.recursing is ø then called else "${x.recursing!.name} → ${called}"
	refused(EFFECT, "${shown_for(x.el.c, filled(x.el, t))} has ${effects_shown(effects_given(x, given))} (${chain}), so it is used only inside another computation: a proof must be pure")
}
# A definition whose recursion may not end: an opaque constant of its result's computations with the effects of what
# may not end, the computation that never returns its value, the body as written kept for running it; a proof may
# not, and a result must be written for the computation's type
diverging(x: Elaborating, word: text, name: text, result: Term?, body: Node, refusal: Error): Read := {
	if word in PROVED_WORDS { refused(EFFECT, "${name} may not end (${effects_shown(diverging_effects(x))}), and a proof must be pure: ${refusal.message.replace(REFUSED + ENDING + ": ", "")}") }
	if result is ø { raise refusal.message + ": write its result type, so it is a computation that may not end" }
	x.pending = []
	x.lifts = []
	x.theory.run_bodies[name] = body
	computations = computation(x, diverging_effects(x), result!)
	Read(never_given(x, computations), computations)
}

# A computation where a plain value is wanted, inside a function: it runs before the nearest binder that closes
# around it (an arm, a branch of a choice, a let's rest, a function's body), and its value is read in its place
class Pending { computation: Term; value: Term; type: Term; effects: list<text> }
ran(x: Elaborating, t: Term, given: Term, wanted: Term?): Term? := {
	if not x.lifting or not is_computation(x, given) { return ø }
	type = arguments(folded(x, given))#2
	value = hypothesis(x.el.c, RAN, type)
	x.pending += [Pending(t, value, type, effects_given(x, given))]
	if wanted is ø then value else made_of(x, value, wanted!)
}
# a value where a computation is wanted: the computation of it; a computation of fewer effects: one of more
lifted_into(x: Elaborating, t: Term, given: Term, wanted: Term): Term? := {
	if not is_computation(x, wanted) { return ø }
	parts = arguments(folded(x, wanted))
	if not is_computation(x, given) { return apply_all(constant_of(x.theory.environment, kernel_name(x.theory, PURE), [level_of(x, parts#2)]), [parts#1, parts#2, made_of(x, t, parts#2)]) }
	had = arguments(folded(x, given))
	if not effects_given(x, given).all(effect => effects_given(x, wanted).contains(effect)) or not unified(x.el, had#2, parts#2) { return ø }
	apply_all(constant_of(x.theory.environment, kernel_name(x.theory, WIDENED), [level_of(x, parts#2)]), [had#1, parts#1, parts#2, t])
}
# A term read under a binder that closes: the computations run inside it bound around it, the first one outermost,
# each handing its value to the rest; their effects must be within those of the computation wanted (where none is
# wanted, the computation of the term with theirs). Else the effects found are what the function needs, and refused
closed_over(x: Elaborating, wanted: Term?, read: () -> Term): Term := {
	mark = #x.pending
	inner = read()
	opened = x.pending.drop(mark)
	if opened is empty { return inner }
	x.pending = x.pending.take(mark)
	effects = unique(opened.flat_map(run => run.effects) + (if wanted is ø then [] else effects_given(x, wanted!)))
	if wanted is not ø and (not is_computation(x, wanted!) or #effects > #effects_given(x, wanted!)) {
		x.lifts = unique(x.lifts + effects)
		computation_refused(x, opened#1.computation, type_of(x.el.c, filled(x.el, opened#1.computation)))
	}
	body = filled(x.el, if wanted is ø then made_of(x, inner, computation(x, effects, type_of(x.el.c, filled(x.el, inner)))) else inner)
	result = arguments(folded(x, type_of(x.el.c, body)))
	opened.reverse().fold(body, (next, run) => apply_all(constant_of(x.theory.environment, kernel_name(x.theory, BIND), [level_of(x, run.type), level_of(x, result#2)]), [result#1, run.type, result#2, made_of(x, run.computation, computation(x, effects, run.type)), closed_filled(x.el, next, [run.value], yes)]))
}
# A function's body read against its result, and where it runs computations a plain result does not hold, read
# again against the result's computations with the effects they have: the result the function then has
class Read { body: Term; result: Term? }
body_read(x: Elaborating, result: Term?, read: (Term?) -> Term): Read := {
	kept = found_so_far(x.el)
	before = arm_kept(x)
	first: Read? = try { Read(closed_over(x, result, () => read(result)), result) } catch e {
		if x.lifts is empty { raise e.message }
		refusal_only(e, [EFFECT])
		ø
	}
	if first is not ø { return first! }
	back_to(x.el, kept)
	arm_restored(x, before)
	x.pending = []
	lifted = computation(x, x.lifts, result!)
	x.lifts = []
	Read(closed_over(x, lifted, () => read(lifted)), lifted)
}
# whether a definition gives nothing, the prelude's Unit, a function of no parameters among them: it is called for
# what it does, so it is never pure, whatever its effects, a constant `x: Unit := Unit.unit` too; Unit's own case
# is a value
gives_nothing(x: Elaborating, d: Declaration): bool := not (d.kind is Constructor) and result_name(ended_in(x, d.type)) == kernel_name(x.theory, NOTHING)
# A law or theorem whose statement names a computation, or a function that gives nothing, is tested, never proved:
# what either does is nothing the theory knows
statement_pure(x: Elaborating, name: text, statement: Term, proof: Node?): bool := {
	computing = constants_in(statement).map(constant_name).find(used => used == kernel_name(x.theory, COMPUTATION) or impure(x, declaration(x.theory.environment, used)!))
	if computing is not ø and proof is not ø { refused(EFFECT, "${name} states something of ${written_name(computing!)}, which is not pure: a law of what is not pure is tested, never proved, so state it without a proof") }
	computing is ø
}
# whether what a declaration gives is not pure: a computation, or nothing
impure(x: Elaborating, d: Declaration): bool := is_computation(x, ended_in(x, d.type)) or gives_nothing(x, d)
