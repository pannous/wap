# A program file elaborated statement by statement (notes/elaborate.md "What it reads and writes"), what the
# elaborator's door and `wap verify` share. It reads the statements before lowering, which the elaborator replaces at
# the switch: an enum or class unit is read as written, a statement that binds names (`products(Pair, Unit)`) as the
# theory's door reads it, any other statement lowered alone first.
use "../../../core/pipeline.wap"
use "../../../core/paths.wap"
use "../../../core/analyze/declarations.wap"
use "../../../core/analyze/modules.wap"
use "../../../core/stage.wap"
use "../../../core/parse/reader.wap"
use "../../../core/parse/operators.wap"
use "../../../core/language.wap"
use "../../../core/rules/lowering.wap"
use "../../../core/rules/declared.wap"
use "../../wasm/modules.wap"
use "../../../core/rules/patterns.wap"
use "../../../kernel/terms.wap"
use "../../../kernel/environment.wap"
use "../../../kernel/compute.wap"
use "../../../kernel/show.wap"
use "../explicit.wap"
use "../bindings.wap"
use "../options.wap"
use "../../../kernel/forms.wap"
use "../../../core/type_notation.wap"
use "../../../core/format.wap"
use "read.wap"
use "declare.wap"
use "blocks.wap"
use "typed_laws.wap"
use "../../../core/analyze/terms.wap"
use "../../../kernel/primitives.wap"

# a declaration word's declaration is lowered without its word, which lowering does not know
unit_elaborated(p: Theory, unit: list<Node>) := {
	p.trials = 0
	statement = unit#1
	p.language = file_key(statement) in p.language_files
	if block_written(statement) is not ø { return block_elaborated(p, unit) }
	binding = binding_written(statement)
	if binding is not ø { return binding_declared(p.environment, WordBinding(binding!.word, binding!.names.map(name => kernel_name(p, name)))) }
	for word in DECLARATION_WORDS {
		declared = after_words(statement, [word])
		if declared is not ø { return declared_formed(p, word, declared!) }
	}
	statement_elaborated(p, formed(p, statement))
}

# a declaration formed and elaborated; one without a value, `law open(n: nat): T`, is formed as the head of a
# definition, since lowering reads parameters only before `:=`, and declared without its value
declared_formed(p: Theory, word: text, declared: Node) := {
	if is_definition(declared) { return declaration_elaborated(p, word, formed(p, declared)) }
	if not is_binder(declared) and not is_header(declared) { return short_law_formed(p, word, declared) }
	match formed(p, Call(symbol(DEFINE), [declared, symbol(HOLE_WORD)])) {
		Define(named, parameters, value) => {
			typed = if word == LAW_WORD then p.typed_laws.get(definition_name(named)) else ø
			if typed is not ø then typed_law_stated(p, definition_name(named), typed!) else definition_elaborated(p, word, named, items_or_one(parameters), ø)
		}
		_ => unelaborated(declared)
	}
}
# A law in the short form, `law square(-x) == square(x)` (wiki/laws.md): the law of its line, its names nothing declares
# found as a header's letters are, its parameters; reported under the first function of the program it calls
short_law_formed(p: Theory, word: text, statement: Node) := {
	name = "${word} ${line_of(statement) ?? #p.stated + 1}"
	declared_formed(p, word, Key(symbol(name), Op.Colon, statement))
	called = words_in(statement).filter(written => programs_function(p, written))
	if called is not empty { p.labels[name] = called#1 }
}
# whether a declaration is written as a head without a type, `law open` or `law open(n: nat)`: a name, given binders
# only
is_header(n: Node): bool := match n {
	Symbol(name) => yes
	Key(name, Op.None, List(items, Bracket.Round, separator)) => name is symbol and items.all(is_binder)
	_ => no
}
# whether the program declared a function of this name, typed or not; the language every program gets declares none
programs_function(p: Theory, name: text): bool := name in p.templates or declarations_named(p, name).any(declared => from_program(p, declared))
is_definition(n: Node): bool := match n { Call(called, arguments) => text(called) == DEFINE and #arguments == 2; _ => no }

# the prelude's files in the wap folder, in the explicit spellings, each using the ones before it
PRELUDE_FOLDER := "extensions/theory/prelude"
PRELUDE_FILES := ["logic", "numbers", "quotient", "data", "effects", "operators", "conversions", "any"]

# the prelude checked into the theory's environment, its declarations counted
prelude_checked(p: Theory, language: Language) := {
	for file in PRELUDE_FILES {
		for unit in file_units(language, prelude_file(p, file)) {
			statement = explicit_overloaded(p, unit)
			match statement {
				LaysOut(name, parts) => layout_noted(p, language, name, parts)
				_ => statement_checked(p.environment, statement)
			}
		}
	}
	p.prelude_size = size(p.environment)
}
# How the host runs a declaration of the prelude, the statement after it: `runs(add, m + n)`, plain wap naming the
# declaration's parameters; a case's also its test and how each field is taken out of a value, naming it `it`,
# `runs(nat.successor, n + 1, when: it > 0, n: it - 1)`; a type's the wap type, or the argument whose type it runs
# as, `runs(Eff, T)`. What the host runs is believed, never proved: notes/theory.md "The run trust base"
TEST_NAME := "when"
VALUE_NAME := "it"
# a layout noted: its value with the declaration's parameters at their places, a case's test and fields with the value
layout_noted(p: Theory, language: Language, name: text, parts: list<Node>) := {
	parameters = binder_names(declared_named(p.environment, name).type)
	at_value = (n: Node) => formatted(language, placed(n, [VALUE_NAME]))
	test = named_part(parts, TEST_NAME)
	fields: map<text, text> = {}
	for field in parameters { if named_part(parts, field) is not ø { fields[field] = at_value(named_part(parts, field)!) } }
	value = formatted(language, placed(parts#2, parameters))
	layout_written(p, name, Layout(value, if test is ø then ø else at_value(test!), fields, parts))
	row_meant(p.environment, name, #parameters, value)
}
# a function the host runs as one host operation on its parameters, in their order, is what that operation means:
# the row analyze makes of the operation at the function's type computes as the function (core/analyze/terms.wap)
row_meant(e: Environment, name: text, parameters: int, value: text) := {
	operation = FOLDED_ROWS.find(row => value == "${ROW_MARK} ${row}(${(1 to parameters).map(at => "\$${at}").join(", ")})") ?? return
	d = declared_named(e, name)
	added(e, Declaration(row_name(operation, d.type), [], d.type, Defined(constant_of(e, name, []))))
}
# the part named so, `when: it > 0`, of a layout's; ø where none is
named_part(parts: list<Node>, name: text): Node? := {
	for part in parts {
		match part {
			Key(key, Op.Colon, value) => if text(key) == name { return value }
			_ => ø
		}
	}
	ø
}
# code with each of these names at its place, `$1` for the first
placed(n: Node, names: list<text>): Node := renamed(n, names.map(name => [name, "\$${names.index_of(name)}"]))
# code with each name of a pair written as its second
renamed(n: Node, pairs: list<list<text>>): Node := match n {
	Symbol(name) => symbol((pairs.find(pair => pair#1 == name) ?? [name, name])#2)
	Call(called, arguments) => Call(renamed(called, pairs), arguments.map(argument => renamed(argument, pairs)))
	_ => with_parts(n, part => renamed(part, pairs))
}

# an explicit statement whose declaration takes a name declared before: an overload of it, by the elaborator's key
explicit_overloaded(p: Theory, unit: list<Node>): Statement := {
	statement = unit_read(p.environment, unit)
	match statement {
		Declares(d) => Declares(overloaded(p, d, explicit_found(d.type), binders_written_in(unit#1)))
		_ => statement
	}
}
prelude_file(p: Theory, file: text): text := in_folder(p.wap_folder, "${PRELUDE_FOLDER}/${file}.wap")
# a file's statements, each with the lines that belong to it
file_units(language: Language, path: text): list<list<Node>> := module_units(operated_file(language, path))
# the statements of a file as written, read alone, its uses and operators unread
written_units(path: text): list<list<Node>> := units_of(statements_of(notation(read(path), path)))

# a door's run: its arguments read (options.wap) and its language loaded into the theory, then its work with them;
# the first refusal is printed and ends the run
door_run(p: Theory, given: list<text>, work: (DoorArguments) -> ø) := {
	try {
		arguments = door_arguments(given)
		spellings_loaded(p, arguments.wap_folder)
		work(arguments)
	} catch refusal { stopped_by(refusal) }
}
# the elaborator's door: the prelude checked, then the modules the program uses and its own statements elaborated in
# order into the theory
door_elaborated(p: Theory, given: list<text>, prelude_read: (Theory, Language) -> ø = (p, language) => ø) := door_run(p, given, arguments => {
	language = base_language()
	modules_bringable(language)
	prelude_checked(p, language)
	prelude_read(p, language)
	p.typed_laws = laws_typed(p.wap_folder, door_program(arguments))
	preload = preload_read(language, p.wap_folder)
	p.language_files = preload.files
	modules = program_modules(language, door_program(arguments), preload)
	p.sets = program_sets(modules, preload)
	scopes = Scopes(seen_ids(p.environment))
	for module in modules {
		types = preloaded(preload, module)
		in_scope(p, scopes, module, modules_of(language, module, preload), types, () => {
			for unit in module_units(module) { if types { unit_taken(p, unit) } else { unit_elaborated(p, unit) } }
		})
	}
})
# Each module is read in its own scope (notes/coc-t2.md "The seam with TM"): the names the prelude declares and the
# language every program gets, those the modules it uses declare, then its own from their declarations on; two
# modules may so declare the same name, each one's uses meaning its own
class Scopes { every: map<text, int>; own: map<text, map<text, int>> = {} }
in_scope(p: Theory, scopes: Scopes, module: Node, used: list<Node>, everywhere: bool, read: () -> ø) := {
	outer = copy(scopes.every)
	for other in used {
		names = scopes.own.get(source_key(other))
		if names is not ø { outer.update(names!) }
	}
	own: map<text, int> = {}
	p.environment.outer = outer
	p.environment.ids = own
	read()
	scopes.own[source_key(module)] = own
	if everywhere { scopes.every.update(own) }
}
# a statement elaborated, or refused: then what it wrote is taken back and the names it declares keep the refusal, so
# a later use of one says why it is missing, the first refusal of a name (read.wap name_elaborated): the refusal's message, ø when accepted
unit_taken(p: Theory, unit: list<Node>): text? := {
	before = kept_of(p)
	p.laid_out = []
	try { kept_if_given(p.environment, () => { unit_elaborated(p, unit); yes }) } catch e {
		taken_back(p, before)
		file = file_key(unit#1).split(p.wap_folder + "/").last
		for name in unit.flat_map(declared_words).filter(name => not p.refused_names.has(name)) { p.refused_names[name] = "${name} is declared in ${file}, which the theory refused: ${e.message}" }
		return e.message
	}
	ø
}
# the language as a program is lowered in, loaded from a wap folder: a parameter the types module declares a function,
# `where`'s condition, takes its argument naming it as that function
spellings_loaded(p: Theory, wap_folder: text) := {
	p.wap_folder = wap_folder
	rules_files_loaded(p.spellings, p.wap_folder)
	p.spellings.declarations = Declarations(declarations_by_name(language_loaded(base_language(), p.wap_folder).signatures))
}
# a program file's code after the modules it uses, theirs first, each read once (wiki/use.md): the modules to
# elaborate in order
program_modules(language: Language, program: text, preload: Preload? = ø): list<Node> := {
	code = operated_file(language, program)
	modules_of(language, code, preload) + [code]
}
# the modules code uses, theirs first, each file read and operated once; with a preload, its modules first when the
# code or a module it uses names a word the preload declares, the way `use` brings in a module (wiki/use.md), unless
# the code is one of the files the preload is written in, a module it holds already left out
modules_of(language: Language, code: Node, preload: Preload? = ø): list<Node> := {
	used = modules_used(code, file => operated_file(language, file))
	if preload is ø or preloaded(preload!, code) or not ([code] + used).any(module => names_any(module, preload!.words)) { return used }
	preload!.modules + used.filter(module => not preloaded(preload!, module))
}
# whether a module is one of the files the types module is written in
preloaded(preload: Preload, module: Node): bool := source_key(module) in preload.files
# the places each of a program's names is set, in the program's own modules: the language every program gets names
# none of the program's constants, so a variable of its functions is no set of one
program_sets(modules: list<Node>, preload: Preload): map<text, list<Node>> := places_set(modules.filter(module => not preloaded(preload, module)))
# the name an operated statement declares, an enum's, class's or trait's as written; none of a statement that declares
# nothing
declared_words(statement: Node): list<text> := {
	block = block_written(statement)
	if block is not ø { return [block_name(block!)] }
	declaration = declaration_of(statement) ?? return []
	[text(declaration_name(declaration))]
}
# whether code names any of the words
names_any(code: Node, words: map<text, bool>): bool := if code is symbol then words.has(text(code)) else direct_parts(code).any(part => names_any(part, words))
# the types module, the language every program gets (core/pipeline.wap TYPES_FILE) read from the wap folder: its
# modules, itself last, the files it is written in, its includes', and the words they declare
class Preload { modules: list<Node>; files: list<text>; words: map<text, bool> }
preload_read(language: Language, wap_folder: text): Preload := {
	code = operated_file(language, in_folder(wap_folder, TYPES_FILE))
	modules = modules_used(code, file => operated_file(language, file)) + [code]
	words: map<text, bool> = {}
	for name in modules.flat_map(statements_of).flat_map(declared_words) { words[name] = yes }
	Preload(modules, (modules.map(source_key) + modules.flat_map(module => statements_of(module).map(file_key))).unique(), words)
}
# a module's statements, each with the lines that belong to it; a `use` line is read as its module, no statement
module_units(code: Node): list<list<Node>> := units_of(statements_of(code).filter(statement => phrase_part(statement, USE_WORD) is ø))
# the key a module's theory is kept by: its file, a standard module's as a program writes it (`lib/math.wap`) whether
# a program names it or `use math` finds it in the library beside the running module
source_key(code: Node): text := {
	file = file_key(code)
	if file.starts_with(module_key(library_of(program.folder)) + "/") then library_path(file) else file
}
