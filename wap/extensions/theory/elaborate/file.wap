# A program file elaborated statement by statement (notes/elaborate.md "What it reads and writes"), what the
# elaborator's door and `wap verify` share. It reads the statements before lowering, which the elaborator replaces at
# the switch: an enum or class unit is read as written, a statement that binds names (`products(Pair, Unit)`) as the
# theory's door reads it, any other statement lowered alone first.
use "../../../core/pipeline.wap"
use "../../../core/parse/reader.wap"
use "../../../core/language.wap"
use "../../../core/rules/lowering.wap"
use "../../../core/rules/declared.wap"
use "../../../core/rules/patterns.wap"
use "../environment.wap"
use "../explicit.wap"
use "../bindings.wap"
use "../options.wap"
use "../../../kernel/forms.wap"
use "../../../core/type_notation.wap"
use "read.wap"
use "declare.wap"
use "blocks.wap"

# a declaration word's declaration is lowered without its word, which lowering does not know
unit_elaborated(p: Theory, unit: list<Node>) := {
	p.trials = 0
	statement = unit#1
	if block_written(statement) is not ø { return block_elaborated(p, unit) }
	binding = binding_written(statement)
	if binding is not ø { return binding_declared(p.environment, Binding(binding!.word, binding!.names.map(name => kernel_name(p, name)))) }
	for word in DECLARATION_WORDS {
		declared = after_words(statement, [word])
		if declared is not ø { return declared_formed(p, word, declared!) }
	}
	statement_elaborated(p, formed(p, statement))
}

# a declaration formed and elaborated; one without a value, `law open(n: nat): T`, is formed as the head of a
# definition, since lowering reads parameters only before `:=`, and declared without its value
declared_formed(p: Theory, word: text, declared: Node) := {
	if is_definition(declared) { return declaration_elaborated(p, word, formed(p, declared)) }
	if not is_binder(declared) { return short_law_formed(p, word, declared) }
	match formed(p, Call(symbol(DEFINE), [declared, symbol(HOLE_WORD)])) {
		Define(named, parameters, value) => definition_elaborated(p, word, named, items_or_one(parameters), ø)
		_ => unelaborated(declared)
	}
}
# A law in the short form, `law square(-x) == square(x)` (wiki/laws.md): the law of its line, its names nothing declares
# found as a header's letters are, its parameters; reported under the first function of the program it calls
short_law_formed(p: Theory, word: text, statement: Node) := {
	name = "${word} ${line_of(statement) ?? #p.stated + 1}"
	declared_formed(p, word, Key(symbol(name), Op.Colon, statement))
	called = words_in(statement).filter(written => programs_function(p, written))
	if called is not empty { p.labels[name] = called#1 }
}
# whether the program declared a function of this name, typed or not
programs_function(p: Theory, name: text): bool := name in p.templates or declarations_named(p, name).any(declared => place(p.environment, declared) > p.prelude_size)
is_definition(n: Node): bool := match n { Call(called, arguments) => text(called) == DEFINE and #arguments == 2; _ => no }

# the prelude's files in the wap folder, in the explicit spellings, each using the ones before it
PRELUDE_FOLDER := "extensions/theory/prelude"
PRELUDE_FILES := ["logic", "numbers", "quotient", "data", "effects", "operators", "conversions", "any"]

# the prelude checked into the theory's environment, its declarations counted
prelude_checked(p: Theory, language: Language) := {
	for file in PRELUDE_FILES {
		for unit in file_units(language, prelude_file(p, file)) { statement_checked(p.environment, explicit_overloaded(p, unit)) }
	}
	p.prelude_size = #p.environment.places
}
# an explicit statement whose declaration takes a name declared before: an overload of it, by the elaborator's key
explicit_overloaded(p: Theory, unit: list<Node>): Statement := {
	statement = unit_read(p.environment, unit)
	match statement {
		Declares(d) => Declares(overloaded(p, d, explicit_found(d.type), binders_written_in(unit#1)))
		_ => statement
	}
}
prelude_file(p: Theory, file: text): text := in_folder(p.wap_folder, "${PRELUDE_FOLDER}/${file}.wap")
# a file's statements, each with the lines that belong to it
file_units(language: Language, path: text): list<list<Node>> := units_of(statements_of(operated_file(language, path)))
# the statements of a file as written, read alone, its uses and operators unread
written_units(path: text): list<list<Node>> := units_of(statements_of(notation(read(path), path)))

# a door's run: its arguments read (options.wap) and its language loaded into the theory, then its work with them;
# the first refusal is printed and ends the run
door_run(p: Theory, given: list<text>, work: (DoorArguments) -> ø) := {
	try {
		arguments = door_arguments(given)
		spellings_loaded(p, arguments.wap_folder)
		work(arguments)
	} catch refusal { stopped_by(refusal) }
}
# the elaborator's door: the prelude checked, then the program file's statements elaborated in order into the theory
door_elaborated(p: Theory, given: list<text>) := door_run(p, given, arguments => {
	for unit in program_units(p, door_program(arguments)) { unit_elaborated(p, unit) }
})
# the language as a program is lowered in, loaded from a wap folder: a parameter the types module declares a function,
# `filter`'s condition, takes its argument naming it as that function
spellings_loaded(p: Theory, wap_folder: text) := {
	p.wap_folder = wap_folder
	rules_files_loaded(p.spellings, p.wap_folder)
	p.spellings.declarations = Declarations(declarations_by_name(language_loaded(base_language(), p.wap_folder).signatures))
}
# the prelude checked into a theory, then the statements of a program file, in order, to elaborate into it
program_units(p: Theory, program: text): list<list<Node>> := {
	language = base_language()
	prelude_checked(p, language)
	file_units(language, program)
}
