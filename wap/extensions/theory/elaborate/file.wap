# A program file elaborated statement by statement (notes/elaborate.md "What it reads and writes"), what the
# elaborator's door and `wap verify` share. It reads the statements before lowering, which the elaborator replaces at
# the switch: an enum or class unit is read as written, a statement that binds names (`products(Pair, Unit)`) as the
# theory's door reads it, any other statement lowered alone first.
use "../../../core/pipeline.wap"
use "../../../core/analyze/declarations.wap"
use "../../../core/analyze/modules.wap"
use "../../../core/stage.wap"
use "../../../core/parse/reader.wap"
use "../../../core/parse/operators.wap"
use "../../../core/language.wap"
use "../../../core/rules/lowering.wap"
use "../../../core/rules/declared.wap"
use "../../../core/rules/patterns.wap"
use "../terms.wap"
use "../environment.wap"
use "../compute.wap"
use "../show.wap"
use "../explicit.wap"
use "../bindings.wap"
use "../options.wap"
use "../../../kernel/forms.wap"
use "../../../core/type_notation.wap"
use "../../../core/format.wap"
use "read.wap"
use "declare.wap"
use "blocks.wap"
use "lifted.wap"

# a declaration word's declaration is lowered without its word, which lowering does not know
unit_elaborated(p: Theory, unit: list<Node>) := {
	p.trials = 0
	statement = unit#1
	if block_written(statement) is not ø { return block_elaborated(p, unit) }
	binding = binding_written(statement)
	if binding is not ø { return binding_declared(p.environment, Binding(binding!.word, binding!.names.map(name => kernel_name(p, name)))) }
	for word in DECLARATION_WORDS {
		declared = after_words(statement, [word])
		if declared is not ø { return declared_formed(p, word, declared!) }
	}
	statement_elaborated(p, formed(p, statement))
}

# a declaration formed and elaborated; one without a value, `law open(n: nat): T`, is formed as the head of a
# definition, since lowering reads parameters only before `:=`, and declared without its value
declared_formed(p: Theory, word: text, declared: Node) := {
	if is_definition(declared) { return declaration_elaborated(p, word, formed(p, declared)) }
	if not is_binder(declared) and not is_header(declared) { return short_law_formed(p, word, declared) }
	match formed(p, Call(symbol(DEFINE), [declared, symbol(HOLE_WORD)])) {
		Define(named, parameters, value) => definition_elaborated(p, word, named, items_or_one(parameters), ø)
		_ => unelaborated(declared)
	}
}
# A law in the short form, `law square(-x) == square(x)` (wiki/laws.md): the law of its line, its names nothing declares
# found as a header's letters are, its parameters; reported under the first function of the program it calls
short_law_formed(p: Theory, word: text, statement: Node) := {
	name = "${word} ${line_of(statement) ?? #p.stated + 1}"
	declared_formed(p, word, Key(symbol(name), Op.Colon, statement))
	called = words_in(statement).filter(written => programs_function(p, written))
	if called is not empty { p.labels[name] = called#1 }
}
# whether a declaration is written as a head without a type, `law open` or `law open(n: nat)`: a name, given binders
# only
is_header(n: Node): bool := match n {
	Symbol(name) => yes
	Key(name, Op.None, List(items, Bracket.Round, separator)) => name is symbol and items.all(is_binder)
	_ => no
}
# whether the program declared a function of this name, typed or not
programs_function(p: Theory, name: text): bool := name in p.templates or declarations_named(p, name).any(declared => place(p.environment, declared) > p.prelude_size)
is_definition(n: Node): bool := match n { Call(called, arguments) => text(called) == DEFINE and #arguments == 2; _ => no }

# the prelude's files in the wap folder, in the explicit spellings, each using the ones before it
PRELUDE_FOLDER := "extensions/theory/prelude"
PRELUDE_FILES := ["logic", "numbers", "quotient", "data", "effects", "operators", "conversions", "any"]

# the prelude checked into the theory's environment, its declarations counted
prelude_checked(p: Theory, language: Language) := {
	laid: list<Statement> = []
	for file in PRELUDE_FILES {
		for unit in file_units(language, prelude_file(p, file)) {
			statement = explicit_overloaded(p, unit)
			statement_checked(p.environment, statement)
			match statement {
				LaysOut(name, parts) => {
					layout_noted(p, language, name, parts)
					laid += [statement]
				}
				_ => ø
			}
		}
	}
	p.prelude_size = #p.environment.places
	for statement in laid {
		match statement {
			LaysOut(name, parts) => layout_checked(p, language, name, parts)
			_ => ø
		}
	}
}
# How the host runs a declaration of the prelude, the statement after it: `runs(add, m + n)`, plain wap naming the
# declaration's parameters; a case's also its test and how each field is taken out of a value, naming it `it`,
# `runs(nat.successor, n + 1, when: it > 0, n: it - 1)`; a type's the wap type, or the argument whose type it runs
# as, `runs(Eff, T)`. What the host runs is believed, never proved: notes/theory.md "The run trust base"
TEST_NAME := "when"
VALUE_NAME := "it"
# a layout noted: its value with the declaration's parameters at their places, a case's test and fields with the value
layout_noted(p: Theory, language: Language, name: text, parts: list<Node>) := {
	parameters = binder_names(declared_named(p.environment, name).type)
	at_value = (n: Node) => formatted(language, placed(n, [VALUE_NAME]))
	test = named_part(parts, TEST_NAME)
	fields: map<text, text> = {}
	for field in parameters { if named_part(parts, field) is not ø { fields[field] = at_value(named_part(parts, field)!) } }
	p.layouts[name] = Layout(formatted(language, placed(parts#2, parameters)), if test is ø then ø else at_value(test!), fields)
}
# the part named so, `when: it > 0`, of a layout's; ø where none is
named_part(parts: list<Node>, name: text): Node? := {
	for part in parts {
		match part {
			Key(key, Op.Colon, value) => if text(key) == name { return value }
			_ => ø
		}
	}
	ø
}
# code with each of these names at its place, `$1` for the first
placed(n: Node, names: list<text>): Node := renamed(n, names.map(name => [name, "\$${names.index_of(name)}"]))
# code with each name of a pair written as its second
renamed(n: Node, pairs: list<list<text>>): Node := match n {
	Symbol(name) => symbol((pairs.find(pair => pair#1 == name) ?? [name, name])#2)
	Call(called, arguments) => Call(renamed(called, pairs), arguments.map(argument => renamed(argument, pairs)))
	_ => with_parts(n, part => renamed(part, pairs))
}

# A layout checked, since erase believes it: each spelling is elaborated as a definition over the host's types, the
# declaration's parameters at the types their values run as (`nat`'s as an int), so `it - 1` is an int; one of no
# value of its layout type is refused
LAYOUT := "layout"
LAYOUT_CHECKED := "laid_out"
# the name a case's value is checked under, `it` being no name a definition's parameter can take
VALUE_CHECKED := "value"
layout_checked(p: Theory, language: Language, name: text, parts: list<Node>) := {
	d = declared_named(p.environment, name)
	c = checker(p.environment, d.levels)
	binders: list<list<text>> = []
	type = d.type
	while yes {
		match type.shape {
			Pi(binder, domain, body) => {
				binders += [[binder, host_type(p, c, domain)]]
				type = instantiated(body, hypothesis(c, binder, domain))
			}
			_ => break
		}
	}
	result = host_type(p, c, type)
	# (a type's layout names a wap type: nothing to elaborate)
	if result == TYPE_WORD { return }
	spelled_as(p, language, name, binders, result, parts#2)
	value = [[VALUE_CHECKED, result]]
	at_value = [[VALUE_NAME, VALUE_CHECKED]]
	test = named_part(parts, TEST_NAME)
	if test is not ø { spelled_as(p, language, name, value, BOOL, renamed(test!, at_value)) }
	for binder in binders {
		field = named_part(parts, binder#1)
		if field is not ø { spelled_as(p, language, name, value, binder#2, renamed(field!, at_value)) }
	}
}
# a spelling of a layout elaborated as the value of a definition of these parameters, each a name and its host type
spelled_as(p: Theory, language: Language, name: text, binders: list<list<text>>, result: text, spelling: Node) := {
	written = formatted(language, spelling)
	head = if binders is empty then LAYOUT_CHECKED else "${LAYOUT_CHECKED}(${binders.map(binder => "${binder#1}: ${binder#2}").join(", ")})"
	try {
		checking = copied(p)
		for unit in module_units(operated_program(language, notation("${head}: ${result} := ${written}", LAYOUT_CHECKED))) { unit_elaborated(checking, unit) }
	} catch refusal { refused(LAYOUT, "${name} runs as ${written}, which is no ${result} there: ${refusal.message}") }
}
# the wap type a type's values run as: its layout's, the layouts of its arguments put in; a type of types `Type`, a
# function type of host types one, any other type as the theory shows it
host_type(p: Theory, c: Checker, type: Term): text := {
	folded = computed_folded(c, type)
	match folded.shape {
		Sort(level) => TYPE_WORD
		Pi(binder, domain, body) => "(${host_type(p, c, domain)}) -> ${host_type(p, c, instantiated(body, hypothesis(c, binder, domain)))}"
		_ => match head(folded).shape {
			Constant(name, levels) => {
				layout = p.layouts.get(name) ?? return shown_for(c, folded)
				given = arguments(folded)
				(1 to #given).reverse().fold(layout.value, (spelled, at) => spelled.replace("\$${at}", host_type(p, c, given#at)))
			}
			_ => shown_for(c, folded)
		}
	}
}
# an explicit statement whose declaration takes a name declared before: an overload of it, by the elaborator's key
explicit_overloaded(p: Theory, unit: list<Node>): Statement := {
	statement = unit_read(p.environment, unit)
	match statement {
		Declares(d) => Declares(overloaded(p, d, explicit_found(d.type), binders_written_in(unit#1)))
		_ => statement
	}
}
prelude_file(p: Theory, file: text): text := in_folder(p.wap_folder, "${PRELUDE_FOLDER}/${file}.wap")
# a file's statements, each with the lines that belong to it
file_units(language: Language, path: text): list<list<Node>> := module_units(operated_file(language, path))
# the statements of a file as written, read alone, its uses and operators unread
written_units(path: text): list<list<Node>> := units_of(statements_of(notation(read(path), path)))

# a door's run: its arguments read (options.wap) and its language loaded into the theory, then its work with them;
# the first refusal is printed and ends the run
door_run(p: Theory, given: list<text>, work: (DoorArguments) -> ø) := {
	try {
		arguments = door_arguments(given)
		spellings_loaded(p, arguments.wap_folder)
		work(arguments)
	} catch refusal { stopped_by(refusal) }
}
# the elaborator's door: the prelude checked, then the modules the program uses and its own statements elaborated in
# order into the theory
door_elaborated(p: Theory, given: list<text>) := door_run(p, given, arguments => {
	language = base_language()
	prelude_checked(p, language)
	modules = program_modules(language, door_program(arguments))
	p.sets = places_set(modules)
	for module in modules {
		for unit in module_units(module) { unit_elaborated(p, unit) }
	}
})
# the language as a program is lowered in, loaded from a wap folder: a parameter the types module declares a function,
# `filter`'s condition, takes its argument naming it as that function
spellings_loaded(p: Theory, wap_folder: text) := {
	p.wap_folder = wap_folder
	rules_files_loaded(p.spellings, p.wap_folder)
	p.spellings.declarations = Declarations(declarations_by_name(language_loaded(base_language(), p.wap_folder).signatures))
}
# a program file's code after the modules it uses, theirs first, each read once (wiki/use.md): the modules to
# elaborate in order
program_modules(language: Language, program: text): list<Node> := {
	code = operated_file(language, program)
	modules_of(language, code) + [code]
}
# the modules code uses, theirs first, each file read and operated once
modules_of(language: Language, code: Node): list<Node> := modules_used(code, file => operated_file(language, file))
# a module's statements, each with the lines that belong to it; a `use` line is read as its module, no statement
module_units(code: Node): list<list<Node>> := units_of(statements_of(code).filter(statement => phrase_part(statement, USE_WORD) is ø))
# the key a module's theory is kept by: its file, a standard module's as a program writes it (`lib/math.wap`) whether
# a program names it or `use math` finds it in the library beside the running module
source_key(code: Node): text := {
	file = module_key(file_of(code) ?? "")
	if file.starts_with(module_key(in_folder(program.folder, LIBRARY_FOLDER)) + "/") then library_path(file) else file
}
