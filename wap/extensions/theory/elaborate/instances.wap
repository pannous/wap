# Traits and their instances (notes/elaborate.md "Operators, traits and conditions (E3)"): a trait is a structure
# with a field per operation (blocks.wap reads `trait Orderable { less(a: T, b: T): bool }` as the class
# `Orderable(T)` holding `less: (a: T, b: T) -> bool`). An operation's name where no declaration of it fits is the
# field of an instance, a hole of the trait's type. Before a declaration is closed, a search fills each instance:
# at a type of the definition's letters it is the definition's own instance binder, a found binder after its letters,
# made where it is first asked for; at any other type it is the structure built from the declarations of the
# operations' names that fit there. None fits: the refusal `trait`, naming the definition to write.
use "../terms.wap"
use "../environment.wap"
use "../explicit.wap"
use "../compute.wap"
use "../typing.wap"
use "../show.wap"
use "state.wap"
use "unify.wap"
use "read.wap"

# the rule a type without a trait's operations is refused by
TRAIT := "trait"
# the name of a definition's instance binder
INSTANCE := "instance"

# the trait a name is an operation of, ø for any other name
trait_of(p: Theory, name: text): text? := p.traits.keys().find(trait => name in p.traits#trait)

# An operation of a trait no declaration of its name fits: the operation of an instance still to be found, given the
# arguments. ø where the name is no operation, or a declaration fits
trait_operation(x: Elaborating, name: text, candidates: list<text>, arguments: list<Node>, wanted: Term?): Term? := {
	trait = trait_of(x.theory, name) ?? return ø
	if fitting_declarations(x, candidates, arguments, wanted) is not empty { return ø }
	d = declaration(x.theory.environment, trait!)!
	instance = hole(x.el, "the ${trait!} of ${name}", holes_given(x, trait!, constant(trait!, []), d.type))
	instance_noted(x, instance)
	field = projection(trait!, (x.theory.traits#trait!).index_of(name), instance)
	given_arguments(x, field, type_of(x.el.c, field), arguments, wanted)
}
# a function given a hole for each of its binders: a trait at its types still to be found
holes_given(x: Elaborating, name: text, function: Term, type: Term): Term := {
	parts = pi_parts(x, type) ?? return function
	found = hole(x.el, "the ${parts.binder} of ${name}", parts.domain)
	holes_given(x, name, apply(function, found), instantiated(parts.body, found))
}
# a hole kept for the search when its type is a trait
instance_noted(x: Elaborating, h: Term) := if trait_typed(x, type_of(x.el.c, h)) is not ø { x.instances += [h] }
# the trait a type is, ø for any other type
trait_typed(x: Elaborating, type: Term): text? := match head(computed(x.el.c, filled(x.el, type))).shape {
	Constant(name, levels) => if x.theory.traits.has(name) then name else ø
	_ => ø
}

# Every instance hole filled: one whose type is still open waits, and is refused as `cannot find` if it stays so
instances_filled(x: Elaborating) := for instance in x.instances { instance_filled(x, instance) }
instance_filled(x: Elaborating, instance: Term) := {
	applied = filled(x.el, instance)
	h = unanswered(x.el, head(applied))
	if h is ø { return }
	wanted = computed(x.el.c, filled(x.el, type_of(x.el.c, applied)))
	if open(x.el, wanted) { return }
	answer = instance_found(x, trait_typed(x, wanted)!, wanted, h!)
	# the instance is a binder of the definition, outside the hole's scope: its type is the hole's where the hole stands
	if not unified(x.el, wanted, type_of(x.el.c, answer)) { refused(TRAIT, "${shown(answer)} is no ${shown(wanted)}") }
	x.el.answers[h!.id] = closed_filled(x.el, answer, arguments(applied), yes)
	if not problems_retried(x.el) { refused(TRAIT, "the ${shown(wanted)} found, ${shown(answer)}, leaves what was put off unsolved") }
}
# The instance of a trait at its types: the definition's binder at its letters, else the structure built at them
instance_found(x: Elaborating, trait: text, wanted: Term, h: Hole): Term := {
	own = x.letters.find(letter => same(filled(x.el, type_of(x.el.c, letter)), wanted))
	if own is not ø { return own! }
	if arguments(wanted).all(type => x.letters.any(letter => same(letter, type))) {
		binder = hypothesis(x.el.c, INSTANCE, wanted)
		x.letters += [binder]
		return binder
	}
	instance_built(x, trait, wanted, h)
}
# the structure of a trait at its types, each field the one declaration of the operation's name that fits there
instance_built(x: Elaborating, trait: text, wanted: Term, h: Hole): Term := {
	built = apply_all(constant("${trait}${DOT}${trait}", []), arguments(wanted))
	rest = type_of(x.el.c, built)
	for operation in x.theory.traits#trait {
		parts = pi_parts(x, rest)!
		field_type = filled(x.el, parts.domain)
		fits = fitting_declarations(x, declarations_named(x.theory, operation), [], field_type)
		if #fits != 1 { refused(TRAIT, "${shown(arguments(wanted)#1)} is not ${trait}, which ${h.name} asks for: define ${operation}: ${shown(field_type)}") }
		field = declared_given(x, fits#1, [], field_type)
		made_of(x, field, field_type)
		built = apply(built, field)
		rest = instantiated(parts.body, field)
	}
	built
}
