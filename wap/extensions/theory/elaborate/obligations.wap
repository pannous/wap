# Going down (notes/elaborate.md "Subtypes and obligations (E4)"): where a `T where p` is wanted and a T is given, the
# term is the value with a proof of p at it. That proof is the obligation, discharged by the first that works: the
# decision of p at the value computes to yes (to no: the refusal `condition`); a fact in scope proves it, a binder of
# its type or the proof a subset's value carries. Nothing proves it: the refusal `unproved condition`.
use "../terms.wap"
use "../environment.wap"
use "../compute.wap"
use "../typing.wap"
use "../show.wap"
use "../explicit.wap"
use "state.wap"
use "unify.wap"
use "read.wap"
use "conditions.wap"

# the test of a value against a subtype, and the bool a decision gives
IS_WORD := "is"
DECIDE := "decide"
# the class of a value with its proof, its one case and the field the proof is
SUBSET := "Subset"
INTRO := "intro"
PROOF_FIELD := 2
# the rules an obligation computed to no and one nothing proves are refused by
CONDITION := "condition"
UNPROVED_CONDITION := "unproved condition"

# t as a value of the subset wanted, its obligation discharged; ø where the type wanted is no subset of t's type
gone_down(x: Elaborating, t: Term, given: Term, wanted: Term): Term? := {
	within = computed(x.el.c, wanted)
	if result_name(within) != subset(x) or pi_parts(x, within) is not ø { return ø }
	parts = arguments(within)
	if not unified(x.el, given, parts#1) { return ø }
	obligation = condition_at(x, parts#2, t)
	proof = computed_proof(x, obligation) ?? fact_proof(x, obligation) ?? refused(UNPROVED_CONDITION, "nothing proves ${shown(obligation)}: test it with `if` first, or take a value whose type says it")
	levels = match head(within).shape { Constant(name, levels) => levels; _ => [] }
	apply_all(constant("${subset(x)}${DOT}${INTRO}", levels), [parts#1, parts#2, t, proof!])
}
# the proof the decision of the obligation computes to; ø where it computes to neither case
computed_proof(x: Elaborating, obligation: Term): Term? := {
	decision = computed(x.el.c, decided(x, obligation, SEARCH_DEPTH) ?? return ø)
	case = result_name(decision)
	if case == "${decidable(x)}${DOT}${FAILS}" { refused(CONDITION, "${shown(obligation)} is false") }
	if case == "${decidable(x)}${DOT}${HOLDS}" then arguments(decision).last else ø
}
# a fact in scope whose type is the obligation: a binder, or the proof a subset's value carries
fact_proof(x: Elaborating, obligation: Term): Term? := {
	carried = x.el.scope.filter(variable => result_name(computed(x.el.c, type_of(x.el.c, variable))) == subset(x))
	facts = x.el.scope + carried.map(variable => projection(subset(x), PROOF_FIELD, variable))
	facts.find(fact => {
		kept = found_so_far(x.el)
		fits = unified(x.el, type_of(x.el.c, fact), obligation)
		if not fits { back_to(x.el, kept) }
		fits
	})
}
# `x is S`: the decision of S's condition at x, a bool
is_elaborated(x: Elaborating, value: Node, type: Node): Term := {
	within = computed(x.el.c, filled(x.el, elaborated(x, type, ø)))
	if result_name(within) != subset(x) or pi_parts(x, within) is not ø { refused(VALUE_TYPE, "${shown(within)} is no type where a condition holds: `is` tests one") }
	parts = arguments(within)
	condition = condition_at(x, parts#2, elaborated(x, value, parts#1))
	apply_all(constant(kernel_name(x.theory, DECIDE), []), [condition, decision_of(x, condition)])
}
# a subset's condition at a value, as computed
condition_at(x: Elaborating, condition: Term, value: Term): Term := computed(x.el.c, filled(x.el, apply(condition, value)))
# the class of subsets where the program reads: its own where it declares one, else the prelude's
subset(x: Elaborating): text := kernel_name(x.theory, SUBSET)
