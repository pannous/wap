# Reading an expression (notes/elaborate.md "Reading an expression"): a lowered form read into a term of the type
# wanted, the holes it leaves answered by unification as the reading goes.
#
# A name is looked up among the binders around it, innermost first, then among the declarations. A declaration's
# found binders get a hole each, its written ones an argument each; the call's result is made the type wanted before
# its arguments are read, so they are read with more known. While a definition's header is read, a one-letter name
# nothing binds is a letter: a found binder of the definition.
use "../../../kernel/terms.wap"
use "../../../kernel/levels.wap"
use "../../../kernel/environment.wap"
use "../../../kernel/numbers.wap"
use "../../../kernel/compute.wap"
use "../../../kernel/typing.wap"
use "../../../kernel/show.wap"
use "../explicit.wap"
use "../../../kernel/forms.wap"
use "../../../core/type_notation.wap"
use "../../../core/stage.wap"
use "../../../core/analyze/holes.wap"
use "state.wap"
use "../../../core/analyze/unify.wap"
use "match.wap"
use "recursion.wap"
use "instances.wap"
use "conditions.wap"
use "convert.wap"
use "obligations.wap"
use "sums.wap"
use "templates.wap"
use "effects.wap"
use "../../../kernel/surface.wap"
use "../../../core/language.wap"
use "../../../core/rules/stages.wap"
use "../../../core/rules/lowering.wap"
use "statements.wap"

# the elaborator's own rules, which a refusal names
OVERLOAD := "overload"
# the refusal of a call no declaration of its name fits
NO_FIT := "no fitting overload"
# the refusal of a call that leaves out arguments its function takes (wiki/function.md "Partial application")
MISSING_ARGUMENTS := "missing arguments"
# the refusals of a declaration tried that does not fit: an argument of another type, also one no declaration of its
# name fits, more or fewer arguments than it takes, and a computation where a value is wanted
UNFIT := ILL_TYPED + [NO_FIT, NOT_A_FUNCTION, MISSING_ARGUMENTS, EFFECT]
# the refusal of a proof by a law stated without one
UNPROVED_LAW := "unproved law"
UNKNOWN_FORM := "unknown form"
# the overload trials one statement may make: past them it is refused, never left to search on
TRIAL_LIMIT := 10000
# what the program left out on purpose: a hole
HOLE_WORD := "_"
# the function a negative number is written with: `-3` is -(3)
NEGATION := "-"
# the length of a letter's name
LETTER_LENGTH := 1
# the prelude's cases of a list, what `[a, b]` is made of
LIST_ITEM := "list.item"
LIST_EMPTY := "list.empty"
# the one name found, ø for none; two or more are refused by the rule, `what` naming them all as written
the_only(found: list<text>, rule: text, what: text): text? := {
	if #found > 1 { refused(rule, "${what} ${found.map(written_name).join(" and ")}: keep one") }
	if found is empty then ø else found#1
}

# The program elaborated so far: the kernel's environment, and what the kernel does not keep: how many found binders
# each declaration takes before its written ones and how many binders its header has in all (a block's types and
# cases, never declared with them, end in their type, so every binder of theirs is their own), the declarations an overloaded name stands for, the laws stated
# without a proof (hints, tested where they can be, never a proof of anything), and each trait's operations
class Theory {
	environment: Environment = products_named(opened(core_environment()))
	found: map<text, int> = {}
	binders: map<text, int> = {}
	overloads: map<text, list<text>> = {}
	unproved_laws: map<text, Term> = {}
	# the functions with an untyped parameter, by name, each with the versions made of it
	templates: map<text, Template> = {}
	traits: map<text, list<text>> = {}
	# the language whose rules give the spellings read here no form of their own, `if` among them (sugar/), loaded
	# from the wap folder
	spellings: Language = base_language()
	# the laws, theorems and axioms in the order they are stated, which `wap verify` reports; those an `assume` left open
	stated: list<text> = []
	assumed: list<text> = []
	# what a report calls a law named by no word of the program (file.wap short_law_formed)
	labels: map<text, text> = {}
	# each name the program's code gives a value, `x = 1` or `x += 1`, at any depth: the places it is set
	# (declare.wap places_set)
	sets: map<text, list<Node>> = {}
	# the declarations the prelude made, the first ones in place; and the names a program's declaration hides of them,
	# each written name's kernel name
	prelude_size: int = 0
	hidden: map<text, text> = {}
	# the bodies as written of the functions that may not end, which run by them and are declared opaque
	run_bodies: map<text, Node> = {}
	# how the host runs what the prelude lays out, by name (file.wap layout_noted), and the functions of the types
	# module the host runs by their own name (declare.wap hosted_spelling)
	layouts: map<text, Layout> = {}
	# the names the statement being read laid out, which taking it back takes out of the layouts (taken_back)
	laid_out: list<text> = []
	# the bodies the functions that call themselves run by, their calls of themselves calls of the constant
	# (declare.wap run_body_kept), and why one could not be kept
	run_terms: map<text, Term> = {}
	run_refusals: map<text, text> = {}
	# whether the answers to `type of`, `axioms of` and `effects of` are printed (declare.wap answered)
	answering: bool = yes
	# the values the program's statements compute, in order (declare.wap computed)
	values: list<Term> = []
	# the names of the statements the theory refused and took back, each with that refusal (file.wap unit_taken)
	refused_names: map<text, text> = {}
	# the files of the language every program gets
	language_files: list<text> = []
	# whether the statement being read is of those files
	language: bool = no
	# where the language's declarations end, after the prelude's: the program's own come after
	language_size: int = 0
	# the wap folder the door is given (options.wap), in which its prelude is found
	wap_folder: text = ""
	# the overload trials the statement being read has made
	trials: int = 0
}
# another theory holding the same, kept to be restored to: its refusals and layouts copies the theory's own growing
# leaves as they were
copied(p: Theory): Theory := {
	other = kept_of(p)
	other.refused_names = copy(p.refused_names)
	other.layouts = copy(p.layouts)
	other
}
# what a theory holds before a statement, to take the statement back by: what the module keeps shared
kept_of(p: Theory): Theory := {
	kept = Theory()
	held(kept, p)
	kept
}
# a theory taken back to what it held before a statement (kept_of): the layouts the statement wrote taken out of the
# map it shares with the module
taken_back(p: Theory, before: Theory) := {
	held(p, before)
	for name in p.laid_out { p.layouts.remove(name) }
	p.laid_out = []
}
# how the host runs a name, written once: a second layout would replace the first unseen, so it is refused
layout_written(p: Theory, name: text, layout: Layout) := {
	if p.layouts.has(name) { refused(LAYOUT, "${name} is laid out twice: the host runs it one way") }
	p.layouts[name] = layout
	p.laid_out += [name]
}
# a theory made to hold again what another holds, each part a copy but the environment, which all share: what a
# statement declared there is taken back by the environment's own kept_if_given
held(p: Theory, from: Theory) := {
	p.environment = from.environment
	p.found = copy(from.found)
	p.binders = copy(from.binders)
	p.overloads = copy(from.overloads)
	p.unproved_laws = copy(from.unproved_laws)
	p.traits = copy(from.traits)
	p.spellings = from.spellings
	p.stated = copy(from.stated)
	p.assumed = copy(from.assumed)
	p.labels = copy(from.labels)
	p.sets = copy(from.sets)
	p.prelude_size = from.prelude_size
	p.hidden = copy(from.hidden)
	p.run_bodies = copy(from.run_bodies)
	p.run_terms = copy(from.run_terms)
	p.run_refusals = copy(from.run_refusals)
	p.values = copy(from.values)
	p.answering = from.answering
	p.templates = copy(from.templates)
	p.wap_folder = from.wap_folder
	p.language_files = from.language_files
	p.language_size = from.language_size
	# kept by the module, not the statement: a statement taken back keeps the refusals of the names it declares
	# (file.wap unit_taken), and the layouts it wrote are taken out by taken_back
	p.refused_names = from.refused_names
	p.layouts = from.layouts
}
# A written name's kernel name: the program's declaration where one hides the prelude's, a dotted name its owner's,
# `nat.zero` the program's nat's case
kernel_name(p: Theory, name: text): text := {
	owner = name.split(DOT)#1
	hiding = p.hidden.get(owner) ?? return name
	hiding + name[#owner ..]
}
# The reading of one declaration: its elaboration, which holds the binders in scope, the level names written
# (explicit.wap's Reading); while its header is read, the letters found, as their variables; the holes for
# instances of traits, which a search fills (instances.wap)
class Elaborating {
	theory: Theory
	el: Elaboration
	reading: Reading
	header: bool = no
	letters: list<Term> = []
	recursing: Recursion? = ø
	# a function's body read again as written (declare.wap run_body_kept): its calls of itself call its declaration
	itself: Itself? = ø
	below: list<Below> = []
	instances: list<Term> = []
	course: Course? = ø
	# why a match took apart its subject without the course, so a recursion on a value deeper than a field was not
	# reachable: said with the refusal of such a call
	without_course: text? = ø
	known: list<Known> = []
	# how many values the choices around have taken apart by the cases of what their conditions wait on (conditions.wap)
	cases_deep: int = 0
	# the names the innermost loop's round passes on to the rounds after it and to the rest after the loop, where a
	# break or a continue leaves it
	round_given: list<text>? = ø
	# inside a function, which runs a computation where a plain value is wanted; the computations run whose binder has
	# not closed yet, and the effects a binder that closed with plain type needed (effects.wap)
	lifting: bool = no
	pending: list<Pending> = []
	lifts: list<text> = []
	# how many terms were made of a type wanted other than their own, so a fit with fewer such steps wins an overload;
	# of a call's result, of a numeral, which is read at the type its place wants (a nat made an int is no step of the
	# argument's), counted apart
	indirect: int = 0
	result_steps: int = 0
	literal_steps: int = 0
}
# How the host runs a declaration of the prelude (file.wap layout_noted), plain wap with each argument at its place,
# `$1` for the first: a function's or a case's value, a type's wap type; a case's test that a value at `$1` is of it
# and its fields taken out of that value, by name; the parts of its statement as written, which erase checks
class Layout { value: text; test: text? = ø; fields: map<text, text> = {}; written: list<Node> = [] }
# a function as its body calls it, by its written name, and the declaration such a call is of
class Itself { written: text; name: text }
elaborating(p: Theory): Elaborating := Elaborating(p, elaboration(p.environment, []), Reading(p.environment))

# A term of the type wanted (ø: any)
elaborated(x: Elaborating, n: Node, wanted: Term?): Term := {
	t = form_elaborated(x, n, wanted)
	if wanted is ø then t else made_of(x, t, wanted!)
}
# a term made of the type wanted: the term itself, its conversion there (convert.wap), the value of a subset with its
# proof (obligations.wap), the case of a union holding it (sums.wap), or refused
made_of(x: Elaborating, t: Term, wanted: Term): Term := {
	given = type_of(x.el.c, filled(x.el, t))
	if unified(x.el, given, wanted) { return t }
	have = filled(x.el, given)
	want = filled(x.el, wanted)
	match t.shape {
		Numeral(value) => x.literal_steps += 1
		_ => x.indirect += 1
	}
	converted(x, t, have, want) ?? gone_down(x, t, have, want) ?? injected(x, t, have, want) ?? lifted_into(x, t, have, want) ?? ran(x, t, have, want) ?? {
		computation_refused(x, t, have)
		refused(VALUE_TYPE, "${shown(filled(x.el, t))} is a ${shown(have)}, where a ${shown(want)} is wanted")
	}
}

# A number as written: a whole one at least 0 a numeral; a negative one the negation of its size, `-3` is -(3); one
# with a fraction is refused, no term of the theory holds it yet, and never read as its whole part
number_elaborated(x: Elaborating, value: number, wanted: Term?): Term := {
	if not (value is int) { refused(UNKNOWN_FORM, "${value} has a fraction, which no number of the theory holds yet") }
	if value < 0 { return elaborated(x, Call(symbol(NEGATION), [Number(-value)]), wanted) }
	numeral(value as int)
}
form_elaborated(x: Elaborating, n: Node, wanted: Term?): Term := match n {
	Symbol(name) => if name == HOLE_WORD then hole(x.el, HOLE_WORD, wanted ?? hole(x.el, "the type of ${HOLE_WORD}", any_sort(x))) else name_elaborated(x, name, [], wanted)
	Empty => nothing_elaborated(x, wanted)
	Number(value) => number_elaborated(x, value, wanted)
	True => bool_value(x, YES)
	False => bool_value(x, NO)
	Text(value) => quoted(value)
	Char(value) => quoted(text(value))
	If(condition, then_part, else_part) => if_elaborated(x, condition, then_part, else_part, wanted)
	Case(subject, arms) => match_elaborated(x, subject, arms.map(arm_written), wanted)
	Get(subject, key) => match key {
		Text(value) => form_elaborated(x, named_form(n), wanted)
		_ => call_elaborated(x, symbol(ITEM_WORD), [subject, key], wanted)
	}
	# a function written where a type is, not lowered: `it => p` of `T where p` (sugar/data.wap)
	Call(called, arguments) => if FUNCTION_ARROWS.contains(text(called)) and #arguments == 2 then form_elaborated(x, Fn(parameter_list(x.theory.spellings, arguments#1), arguments#2), wanted) else call_elaborated(x, named_form(called), arguments, wanted)
	Key(called, Op.None, List(arguments, bracket, separator)) => if bracket in PARAMETER_BRACKETS then call_elaborated(x, called, arguments, wanted) else if bracket == Bracket.Square then levelled(x, called, arguments, wanted) else respelled(x, n, wanted, UNKNOWN_FORM, no_expression(n))
	Item(subject, key) => levelled(x, subject, items_or_one(key), wanted)
	Block(statements) => statements_elaborated(x, statements, wanted)
	Fn(parameters, body) => bound_elaborated(x, items_or_one(parameters).map(named_binder), body, yes, wanted)
	List(items, Bracket.Round, separator) => if #items == 1 then form_elaborated(x, items#1, wanted) else respelled(x, n, wanted, UNKNOWN_FORM, no_expression(n))
	List(items, Bracket.Square, separator) => computation_read(x, n) ?? form_elaborated(x, listed(x, items), wanted)
	_ => written_or(x, n, wanted) ?? optional_written(x, n) ?? respelled(x, n, wanted, UNKNOWN_FORM, no_expression(n))
}
# `[a, b]`: the list's cases where the program reads, list.item(a, list.item(b, list.empty))
listed(x: Elaborating, items: list<Node>): Node := items.reverse().fold(case_given(x, LIST_EMPTY, []), (rest, item) => case_given(x, LIST_ITEM, [item, rest]))
# a case given its fields, after a hole for each parameter of its type it does not find itself: an explicit
# declaration's (the prelude's) finds none
case_given(x: Elaborating, name: text, fields: list<Node>): Node := {
	kernel = kernel_name(x.theory, name)
	declared = declaration(x.theory.environment, kernel) ?? refused(UNKNOWN_NAME, "`[…]` writes a list by the cases ${LIST_EMPTY} and ${LIST_ITEM}, and ${written_name(kernel)} is not declared: the program's own list needs both cases")
	parameters = match declared.kind { Constructor(of, place, own) => binders_counted(declared.type) - own; _ => 0 }
	arguments = (1 to parameters - (x.theory.found.get(kernel) ?? 0)).list().map(at => Symbol(HOLE_WORD)) + fields
	if arguments is empty then Symbol(name) else Call(Symbol(name), arguments)
}
# a declaration at the levels written after its name, `Equal[1]`, which the rules write as Item(Equal, 1)
levelled(x: Elaborating, written: Node, levels: list<Node>, wanted: Term?): Term := {
	t = form_elaborated(x, written, wanted)
	name = match head(t).shape {
		Constant(name, held, _) => name
		_ => refused(UNKNOWN_FORM, "${text(written)} names no declaration to give levels")
	}
	if not unified(x.el, head(t), constant_of(x.theory.environment, name, levels.map(level => level_written(x, level)))) { refused(VALUE_TYPE, "${text(written)} takes ${#declaration(x.theory.environment, name)!.levels} levels, not ${#levels}") }
	t
}
# the function an item read by its place calls, `xs#i` being Get(xs, i), a field read by its name, `p.x`, Get(p, "x")
ITEM_WORD := "#"
# a dotted name, which the rules write as a field read, `bool.yes` as Get(bool, "yes"); any other node as it is
named_form(n: Node): Node := match n {
	Get(subject, key) => dotted(named_form(subject), Symbol(field_named(key)))
	_ => n
}
field_named(key: Node): text := match key {
	Text(value) => value
	_ => text(key)
}
# a sort of a level not known yet: what a type is read against
any_sort(x: Elaborating): Term := universe(level_hole(x.el))

# a function type, a sort of a level, a dotted name, or a function applied
call_elaborated(x: Elaborating, called: Node, arguments: list<Node>, wanted: Term?): Term := {
	word = text(called)
	if word == FUNCTION_TYPE and #arguments == 2 { return bound_elaborated(x, binders_of(arguments#1).map(typed_binder), arguments#2, no, wanted) }
	if word == DOT and #arguments == 2 { return form_elaborated(x, dotted(arguments#1, arguments#2), wanted) }
	if #arguments == 1 and word == TYPE_WORD { return type_at(level_written(x, arguments#1)) }
	if #arguments == 2 and word == IS_WORD { return is_elaborated(x, arguments#1, arguments#2) }
	if #arguments == 1 and word == SORT_WORD { return universe(level_written(x, arguments#1)) }
	match called {
		Symbol(name) => name_elaborated(x, name, arguments, wanted)
		_ => {
			function = elaborated(x, called, ø)
			given_arguments(x, function, type_of(x.el.c, filled(x.el, function)), arguments, wanted)
		}
	}
}

# A name and the arguments written after it: a binder around it, a sort, a declaration, or in a header a new letter
name_elaborated(x: Elaborating, name: text, arguments: list<Node>, wanted: Term?): Term := {
	bound = named(x.el, name)
	if bound is not ø { return given_arguments(x, bound!, type_of(x.el.c, bound!), arguments, wanted) }
	if x.recursing is not ø and name == x.recursing!.name {
		# a call of the name being defined is resolved among its overloads by its arguments, like any call: only one no
		# declaration takes calls the definition itself, its recursion
		kept = snapshot(x)
		declared = try { declared_call(x, name, arguments, wanted) } catch e {
			if not e.message.starts_with(REFUSED) { raise e.message }
			put_back(x, kept)
			ø
		}
		if declared is not ø { return declared! }
		x.recursing!.called = yes
		return recursive_call_elaborated(x, arguments, wanted)
	}
	if x.itself is not ø and name == x.itself!.written { return declared_given(x, x.itself!.name, arguments, wanted) }
	if arguments is empty and name == PROP_WORD { return PROP }
	if arguments is empty and name == TYPE_WORD { return type_at(Zero) }
	# `list.item(x, rest)`, which the rules write as `item(list, x, rest)`: the declaration under the first argument's
	# name, the more specific one
	if arguments is not empty {
		qualified = "${text(named_form(arguments#1))}${DOT}${name}"
		if declarations_named(x.theory, qualified) is not empty { return name_elaborated(x, qualified, arguments.drop(1), wanted) }
	}
	declared = declared_call(x, name, arguments, wanted)
	if declared is not ø { return declared! }
	if x.header and #name == LETTER_LENGTH {
		letter = scoped(x.el, name, wanted ?? hole_over(x.el, "the type of ${name}", any_sort(x), x.letters))
		x.letters += [letter]
		return given_arguments(x, letter, type_of(x.el.c, letter), arguments, wanted)
	}
	if name in x.theory.unproved_laws { refused(UNPROVED_LAW, "${name} is a law without a proof, a hint and never a proof: prove it after `:=`") }
	# a refused declaration's name, or a name it owns, `tree.leaf` of a refused enum tree
	refusal = x.theory.refused_names.get(name) ?? x.theory.refused_names.get(name.split(DOT)#1)
	if refusal is not ø { refused(REFUSED_DECLARATION, refusal!) }
	respelled(x, if arguments is empty then symbol(name) else Call(symbol(name), arguments), wanted, UNKNOWN_NAME, "${name} is neither a binder around it nor declared")
}

# a name's declaration given the arguments, the one of its overloads, traits' operations and template versions they
# fit; ø for a name nothing declares
declared_call(x: Elaborating, name: text, arguments: list<Node>, wanted: Term?): Term? := {
	template = x.theory.templates.get(name)
	# a template's versions are found by their types (templates.wap), never tried as declarations, so which call came
	# first does not choose
	candidates = declarations_named(x.theory, name).filter(candidate => template is ø or not template!.versions.any(version => version.name == candidate))
	traits = traits_of(x.theory, name)
	if #candidates == 1 and traits is empty and template is ø { return declared_given(x, candidates#1, arguments, wanted) }
	if candidates is not empty or traits is not empty or template is not ø { return overload_elaborated(x, name, candidates, traits, template, arguments, wanted) }
	ø
}
# A declaration at a level hole for each of its level parameters, a hole for each found binder, then its written
# binders given the arguments
declared_given(x: Elaborating, name: text, arguments: list<Node>, wanted: Term?): Term := declared_read(x, name, unread(arguments), wanted)
# a declaration given arguments unread or read already
declared_read(x: Elaborating, name: text, arguments: list<Argument>, wanted: Term?): Term := {
	if wanted is not ø and declaration(x.theory.environment, name)!.kind is Recursor { return recursor_given(x, name, arguments, wanted!) }
	# every binder given, the found ones too, as an explicit program calls it: no hole
	header = x.theory.binders.get(name)
	own = binders_of(x.theory, name)
	found = if #arguments == own then 0 else x.theory.found.get(name) ?? 0
	# a function declared with parameters is given each written one; a value of a function type, its binders no
	# parameters, may be given fewer
	written = own - (x.theory.found.get(name) ?? 0)
	if header is not ø and arguments is not empty and #arguments < written { refused(MISSING_ARGUMENTS, "${name} takes ${written} arguments and is given ${#arguments}: give each") }
	given = declared_holes(x, name, found)
	arguments_given(x, given.function, given.type, arguments, wanted)
}
# a declaration at a level hole for each of its level parameters, given a hole for each of its first `count` binders
declared_holes(x: Elaborating, name: text, count: int?): Given := {
	d = declaration(x.theory.environment, name)!
	levels = d.levels.map(level => level_hole(x.el))
	holes_given(x, name, constant_of(x.theory.environment, name, levels), with_levels(d.type, d.levels, levels), count)
}
# A function given a hole for each of its first `count` binders, for all of them where count is ø: its found binders,
# a trait at its types, a decision's parts. A hole whose type is a trait is kept for the search
class Given { function: Term; type: Term }
holes_given(x: Elaborating, name: text, function: Term, type: Term, count: int? = ø): Given := {
	if count == 0 { return Given(function, type) }
	parts = pi_parts(x, type) ?? return (if count is ø then Given(function, type) else refused(NOT_A_FUNCTION, "${name} has fewer binders than it finds"))
	found = hole(x.el, "the ${parts.binder} of ${name}", parts.domain)
	instance_noted(x, found)
	holes_given(x, name, apply(function, found), instantiated(parts.body, found), if count is ø then ø else count! - 1)
}

# A function of a type given its arguments, each read against its domain. Once the result no longer depends on the
# arguments still to read, it is made the type wanted: before the first, or after a type's hole, `list.item(_, 1, …)`
# wanting a list of ints reads 1 as an int
given_arguments(x: Elaborating, function: Term, type: Term, arguments: list<Node>, wanted: Term?): Term := arguments_given(x, function, type, unread(arguments), wanted)
# an argument of a call: as written, read against its parameter's type, or read already, made of that type, so a call
# that tries several declarations reads each argument once (overload_elaborated)
enum Argument { Unread(node: Node), Elaborated(term: Term) }
unread(nodes: list<Node>): list<Argument> := nodes.map(node => Unread(node))
arguments_given(x: Elaborating, function: Term, type: Term, arguments: list<Argument>, wanted: Term?): Term := {
	given = Applied(function, type)
	aimed = wanted is ø
	for at in 1 to #arguments {
		if not aimed {
			result = result_after(filled(x.el, given.rest), #arguments - at + 1)
			aimed = result is not ø and result!.loose == 0
			if aimed { unified(x.el, result!, wanted!) }
		}
		argument = arguments#at
		given = given_one(x, given, domain => match argument {
			# an argument refused alone is read again for each candidate, and distributed reads them again: the trial
			# limit refuses a program where that grows past it, as gave up
			Unread(node) => elaborated(x, it_read(x, node, domain), filled(x.el, domain))
			Elaborated(term) => made_of(x, term, filled(x.el, domain))
		}) ?? refused(NOT_A_FUNCTION, "${shown(filled(x.el, given.function))} is a ${shown(filled(x.el, given.rest))}, no function, and is given ${argument_shown(x, argument)}")
	}
	given.function
}
# a function given its arguments one by one, and the type of what it takes next
class Applied { function: Term; rest: Term }
# the function given one more argument, made of the type it takes; ø where it takes none
given_one(x: Elaborating, so_far: Applied, made: (Term) -> Term): Applied? := {
	parts = pi_parts(x, so_far.rest) ?? return ø
	value = made(parts.domain)
	Applied(apply(so_far.function, value), instantiated(parts.body, value))
}
argument_shown(x: Elaborating, argument: Argument): text := match argument {
	Unread(node) => text(node)
	Elaborated(term) => shown(filled(x.el, term))
}
# an argument's term read without a type wanted
term_alone(x: Elaborating, argument: Argument): Term := match argument {
	Unread(node) => elaborated(x, node, ø)
	Elaborated(term) => term
}
# an argument read alone, without a type wanted; unread still where it cannot be, all it found put back, so a
# lambda without binder types, an argument naming `it` or an overload chosen by its result is read against each
# parameter's type. So is a value built of cases holding a numeral, which alone is read as a nat where the place may
# want another type, as `[4, 5]` or `([4, 5])` is a list<int> where one is wanted; a numeral itself is read alone and
# made of the type wanted, a step `nearest` counts, and so is a call's result (an operator chain read
# again for each overload would be tried exponentially often)
read_alone(x: Elaborating, node: Node): Argument := {
	if names_it(node) { return Unread(node) }
	kept = snapshot(x)
	read = try { guarded(x, kept, () => elaborated(x, node, ø)) } catch e {
		refusal_only(e)
		ø
	}
	if read is ø { return Unread(node) }
	if numeral_in_cases(x.theory, filled(x.el, read!)) {
		put_back(x, kept)
		return Unread(node)
	}
	Elaborated(read!)
}
# whether a term is a case of a type given a numeral, at any depth of its fields
numeral_in_cases(p: Theory, t: Term): bool := match head(t).shape {
	Constant(name, levels, _) => declares_case(p, name) and holds_numeral(t)
	_ => no
}
declares_case(p: Theory, name: text): bool := match (declaration(p.environment, name) ?? return no).kind {
	Constructor(of, place, own) => yes
	_ => no
}
holds_numeral(t: Term): bool := t.shape is Numeral or parts(t).any(holds_numeral)
# an argument naming `it` where a function of one value is wanted is that function of it, as lowering reads one where
# a declared parameter takes a function (wiki/function.md): `nat where it == 1` is where(nat, it => it == 1)
it_read(x: Elaborating, argument: Node, domain: Term): Node :=
	if names_it(argument) and pi_parts(x, domain) is not ø then function_of(x, IT_WORD, argument) else argument
# the function of one value, under a binder, a body gives
function_of(x: Elaborating, binder: text, body: Node): Node := Fn(parameter_list(x.theory.spellings, symbol(binder)), body)
# what a function type gives after a count of its binders, as written; ø for one with fewer
result_after(type: Term, count: int): Term? := {
	if count == 0 { return type }
	match type.shape {
		Pi(binder, domain, body) => result_after(body, count - 1)
		_ => ø
	}
}
# a type computed to a function type: its binder, domain and body; ø for any other type
class PiParts { binder: text; domain: Term; body: Term }
pi_parts(x: Elaborating, type: Term): PiParts? := match computed(x.el.c, filled(x.el, type)).shape {
	Pi(binder, domain, body) => PiParts(binder, domain, body)
	_ => ø
}

# the declarations a name stands for: an overloaded name's, else its own, else none
declarations_named(p: Theory, name: text): list<text> := {
	kernel = kernel_name(p, name)
	p.overloads.get(kernel) ?? (if declaration(p.environment, kernel) is not ø then [kernel] else [])
}

# The declarations of an overloaded name tried in turn: exactly one must fit its arguments and the type wanted, else
# it is the version of the untyped function of that name, else the operation of a trait it names; none fitting is
# refused naming why each did not, a refusal met inside an argument included
overload_elaborated(x: Elaborating, name: text, candidates: list<text>, traits: list<text>, template: Template?, arguments: list<Node>, wanted: Term?): Term := {
	read = arguments.map(argument => read_alone(x, argument))
	trials = declarations_tried(x, candidates, read, wanted)
	fitting = fits(nearest(x.theory, trials, #arguments, wanted is not ø and is_sort(computed(x.el.c, filled(x.el, wanted!)))))
	if fitting is empty and template is not ø { return version_called(x, name, template!, read, wanted) }
	if fitting is empty and traits is not empty { return trait_operation(x, name, traits, read, wanted) }
	fit = the_only(fitting, OVERLOAD, "${name} here is")
	if fit is ø { return distributed(x, name, arguments, wanted) ?? refused(NO_FIT, "${name} is none of ${trials.map(trial => "${trial.candidate} (${trial.refusal!})").join(", ")} here") }
	declared_read(x, fit!, read, wanted)
}
# the declarations that fit the arguments and the type wanted
fitting_declarations(x: Elaborating, candidates: list<text>, arguments: list<Node>, wanted: Term?): list<text> := fits(declarations_tried(x, candidates, unread(arguments), wanted))
declarations_tried(x: Elaborating, candidates: list<text>, arguments: list<Argument>, wanted: Term?): list<Trial> := trials_of(x, candidates, candidate => {
	given = declared_read(x, candidate, arguments, wanted)
	# a result made of the type wanted is the place's step, counted after the arguments'
	if wanted is ø { return given }
	steps = x.indirect
	made = made_of(x, given, wanted!)
	x.result_steps += x.indirect - steps
	x.indirect = steps
	made
})
# the candidates an attempt does not refuse as ill-typed
fitting(x: Elaborating, candidates: list<text>, attempt: text -> Term): list<text> := fits(trials_of(x, candidates, attempt))
fits(trials: list<Trial>): list<text> := trials.filter(trial => trial.refusal is ø).map(trial => trial.candidate)
# a candidate an attempt was given: the refusal it met, ø where it fits, and how many terms it made of a type other
# than their own
class Trial { candidate: text; refusal: text?; indirect: int; result: int; literals: int }
# each candidate given to an attempt, the answers it gives taken back
trials_of(x: Elaborating, candidates: list<text>, attempt: text -> Term): list<Trial> := candidates.map(candidate => undone(x, () => {
	trial_counted(x.theory)
	before = snapshot(x)
	refusal = refusal_of(candidate, attempt)
	Trial(candidate, refusal, x.indirect - before.indirect, x.result_steps - before.result_steps, x.literal_steps - before.literal_steps)
}))
# one more candidate tried in this statement: past the limit the statement is given up
trial_counted(p: Theory) := {
	p.trials += 1
	if p.trials > TRIAL_LIMIT { refused(GAVE_UP, "the overloads of one statement were tried more than ${TRIAL_LIMIT} times") }
}
# what a read may change, kept to be put back: the answers found, the arm being read, the letters, instance holes,
# effects and lifts noted, the indirect steps counted, the course and the round read, the levels made
class Snapshot { found: Found; arm: ArmState; letters: int; instances: int; pending: int; lifts: int; indirect: int; result_steps: int; literal_steps: int; without_course: text?; round_given: list<text>?; levels: int }
snapshot(x: Elaborating): Snapshot := Snapshot(found_so_far(x.el), arm_kept(x), #x.letters, #x.instances, #x.pending, #x.lifts, x.indirect, x.result_steps, x.literal_steps, x.without_course, x.round_given, #x.el.c.levels)
put_back(x: Elaborating, kept: Snapshot) := {
	back_to(x.el, kept.found)
	arm_restored(x, kept.arm)
	x.letters = x.letters.take(kept.letters)
	x.instances = x.instances.take(kept.instances)
	x.pending = x.pending.take(kept.pending)
	x.lifts = x.lifts.take(kept.lifts)
	x.indirect = kept.indirect
	x.result_steps = kept.result_steps
	x.literal_steps = kept.literal_steps
	x.without_course = kept.without_course
	x.round_given = kept.round_given
	x.el.c.levels = x.el.c.levels.take(kept.levels)
}
# what an attempt gives; where it raises, all it found is put back first
guarded(x: Elaborating, kept: Snapshot, attempt: () -> T): T := try { attempt() } catch e { put_back(x, kept); raise e.message }
# what an attempt gives, all it found put back either way
undone(x: Elaborating, attempt: () -> T): T := {
	kept = snapshot(x)
	given = guarded(x, kept, attempt)
	put_back(x, kept)
	given
}
# the trials that do not fit, and those that fit best: a direct fit beats a fit through a conversion, of its arguments
# first, then of its result, so a numeral is read at the type its place wants, `abs(0 - 3)` subtracts ints; a whole
# call a part of one, `turned(x)` of `turned(x, when)`, one for the types given one for any type, `==(a: T, b: T)`;
# equal fits tie
nearest(p: Theory, trials: list<Trial>, given: int, type_wanted: bool): list<Trial> := {
	fitting = trials.filter(trial => trial.refusal is ø)
	if fitting is empty { return trials }
	# in a type's place, one giving a type before one giving data: `a implies b` the proposition, `bool` the type
	types = if type_wanted then fitting.filter(trial => gives_type(p, trial.candidate)) else []
	best = fewest_by(if types is empty then fitting else types, trial => trial.indirect)
	best = fewest_by(best, trial => trial.result)
	best = fewest_by(best, trial => left_open(p, trial.candidate, given))
	best = fewest_by(best, trial => letters_found(p, trial.candidate))
	# and, where nothing else tells them apart, a numeral at its own type: `1 + 2` adds nats
	best = fewest_by(best, trial => trial.literals)
	trials.filter(trial => trial.refusal is not ø) + best
}
# the trials a measure gives the least
fewest_by(trials: list<Trial>, measure: (Trial) -> int): list<Trial> := {
	least = trials.map(measure).min()
	trials.filter(trial => measure(trial) == least)
}
# whether a declaration gives a type, a proposition among them
gives_type(p: Theory, key: text): bool := is_sort(result_of(declaration(p.environment, key)!.type))
# how many of its written parameters a declaration leaves open given so many arguments
left_open(p: Theory, key: text, given: int): int := binders_of(p, key) - letters_found(p, key) - given
# how many binders a declaration's calls give: as many as its header wrote, or every one of its type's
binders_of(p: Theory, key: text): int := p.binders.get(key) ?? binders_counted(declaration(p.environment, key)!.type)
# whether the program declared this key, past the prelude and the language every program gets
from_program(p: Theory, key: text): bool := place(p.environment, key) > max(p.prelude_size, p.language_size)
# whether the prelude declares this key
from_prelude(p: Theory, key: text): bool := {
	at = place(p.environment, key)
	at > 0 and at <= p.prelude_size
}
# how many of a declaration's binders its header found, not wrote: none of a declaration no header was read for, a
# binding's (`quotients(Equal)`) or a law the elaborator states itself (`f.unfolds`), whose binders are all given
letters_found(p: Theory, key: text): int := p.found.get(key) ?? 0
# the refusal an attempt meets, ø where it fits
refusal_of(candidate: text, attempt: text -> Term): text? := try { attempt(candidate); ø } catch e { mismatch(e, UNFIT); e.message.replace(REFUSED, "") }

# --- binders

# a binder as written: its name and its type, ø where the type is left out
class WrittenBinder { name: text; type: Node? }
# a function's parameter, `x` or `x: A`; a function type's binder, `(x: A)` or a type alone, `A`
named_binder(n: Node): WrittenBinder := match n {
	Key(name, Op.Colon, type) => WrittenBinder(text(name), type)
	_ => WrittenBinder(text(n), ø)
}
typed_binder(n: Node): WrittenBinder := WrittenBinder(binder_name(n), binder_type(n))

# A binder gone into: its type as written, else as the type expected gives it, else a hole; in scope by its name
gone_into(x: Elaborating, binder: WrittenBinder, expected: Term?): Term := {
	domain = if binder.type is not ø then elaborated(x, binder.type!, any_sort(x)) else expected ?? hole(x.el, "the type of ${binder.name}", any_sort(x))
	if binder.type is not ø and expected is not ø and not unified(x.el, domain, expected!) { refused(VALUE_TYPE, "${binder.name} is written a ${shown(filled(x.el, domain))}, where a ${shown(filled(x.el, expected!))} is wanted") }
	scoped(x.el, binder.name, domain)
}

# A function type or a function over its binders: a function's binders take their types from the function type
# wanted where they are left out
bound_elaborated(x: Elaborating, binders: list<WrittenBinder>, body: Node, function: bool, wanted: Term?): Term := {
	entered = binders_entered(x, binders, if function then wanted else ø)
	inner = if function then closed_over(x, entered.rest, () => elaborated(x, body, entered.rest)) else elaborated(x, body, any_sort(x))
	unscoped(x.el, entered.variables)
	closed_filled(x.el, inner, entered.variables, function)
}
# binders gone into, in scope, and what the function type expected gives after them (ø: none expected)
class Gone { variables: list<Term>; rest: Term? }
binders_entered(x: Elaborating, binders: list<WrittenBinder>, expected: Term?): Gone := {
	rest = expected
	variables: list<Term> = []
	for binder in binders {
		parts = if rest is ø then ø else pi_parts(x, rest!)
		variable = gone_into(x, binder, if parts is ø then ø else parts!.domain)
		variables += [variable]
		rest = if parts is ø then ø else instantiated(parts!.body, variable)
	}
	Gone(variables, rest)
}

# a level as written; a name nothing binds is a level parameter of the declaration
level_written(x: Elaborating, n: Node): Level := {
	read_level = level_read(x.reading, n)
	for name in x.reading.levels { if not (name in x.el.c.levels) { x.el.c.levels += [name] } }
	read_level
}

# a form the elaborator does not read
unelaborated(n: Node) := refused(UNKNOWN_FORM, no_expression(n))
no_expression(n: Node): text := "${text(n)} is no expression"
# code in the kernel's forms: its spellings rewritten by the tree's rules, then lowered by the language that knows
# their forms
formed(p: Theory, code: Node): Node := lowered(p.spellings, rewritten_by(p.spellings, p.spellings.grammar.shape_rules, code).code)
# a node read here in no way, in a spelling the language's rules give a form: that form read, else the refusal
respelled(x: Elaborating, n: Node, wanted: Term?, rule: text, refusal: text): Term := {
	shaped = rewritten_by(x.theory.spellings, x.theory.spellings.grammar.shape_rules, n)
	if not shaped.fired { refused(rule, refusal) }
	form_elaborated(x, shaped.code, wanted)
}
# the prelude's bool and its cases, and its equality, as the elaborator names them
EQUAL := "Equal"
BOOL := "bool"
YES := "yes"
NO := "no"
bool_value(x: Elaborating, case: text): Term := constant_of(x.theory.environment, case_constructed(kernel_name(x.theory, BOOL), case), [])
