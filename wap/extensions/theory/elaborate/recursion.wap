# A function's calls of itself elaborated as induction hypotheses (notes/elaborate.md "Match and recursion (E2)"):
# while a definition's value is read, its own name is a call of its recursion. A match on one of its parameters takes
# the other written parameters into its motive, so they may change from call to call; each arm has a hypothesis per
# field of the matched type, the function at that field, and a call whose argument at the matched parameter's place
# is such a field is that hypothesis given the other arguments: `double(successor(k)) := … double(k)` reads the
# hypothesis of k. A call on anything else is refused, since its recursion may not end.
#
# Where the products are bound, a match on a parameter goes through its type's course (core/analyze/courses.wap): the arm reads the
# values below the value matched, which ride each match inside it, so a call on any value below, a field's field too,
# is the hypothesis found in them: `fib(successor(successor(j))) := … fib(j) … fib(successor(j))`.
use "../../../kernel/terms.wap"
use "../../../kernel/environment.wap"
use "../../../kernel/typing.wap"
use "../../../kernel/show.wap"
use "../../../kernel/compute.wap"
use "../../../kernel/equal.wap"
use "../../../core/analyze/holes.wap"
use "read.wap"

# the rule a call that may not end is refused by
RECURSION := "recursion"
# the rule a recursion whose end nothing shows is refused by, where it may not be one that may not end
ENDING := "ending"

# the definition being read: its name and its written parameters, as their variables; whether it calls itself
class Recursion { name: text; parameters: list<Term>; called: bool = no }
# a field of a matched value and its induction hypothesis, and the parameter the match took apart
class Below { subject: Term; field: Term; hypothesis: Term }
# a match through a course: the place of the parameter it took apart, and the values below the value being matched
class Course { place: int; below: Term }
# a variable matched, known in an arm to be its case applied to the fields
class Known { id: int; value: Term }
# an arm's state before it is read, restored after it and after a trial that refuses it
class ArmState { below: int; known: int; course: Course?; cases_deep: int }
arm_kept(x: Elaborating): ArmState := ArmState(#x.below, #x.known, x.course, x.cases_deep)
arm_restored(x: Elaborating, before: ArmState) := {
	x.below = x.below.take(before.below)
	x.known = x.known.take(before.known)
	x.course = before.course
	x.cases_deep = before.cases_deep
}

# the place of a parameter of the recursion being read, 0 for any other value
place_of(x: Elaborating, subject: Term): int := {
	r = x.recursing ?? return 0
	(1 to #r.parameters).list().find(at => same(r.parameters#at, filled(x.el, subject))) ?? 0
}

# the written parameters a match on this subject takes into its motive: the others of the definition being read, when
# the subject is one of its parameters
# the subject is one of its parameters; inside a course, the values below when their type names the subject
riding(x: Elaborating, subject: Term): list<Term> := {
	r = x.recursing ?? return []
	if place_of(x, subject) > 0 { return r.parameters.filter(parameter => not same(parameter, subject)) }
	c = x.course ?? return []
	if variable_id(subject) in free_variables(filled(x.el, type_of(x.el.c, c.below))) then [c.below] else []
}
# the course inside an arm: the values below as the arm binds them anew, where they rode the match
course_riding(x: Elaborating, ridden: list<Term>, bound: list<Term>): Course? := {
	c = x.course ?? return ø
	at = (1 to #ridden).list().find(place => same(ridden#place, c.below)) ?? return c
	Course(c.place, bound#at)
}

# The hypotheses in the values below, each by the value it is for: a pair of the motive's value and the values below
# that value, paired with the rest, down to the unit
course_below(x: Elaborating): list<Below> := {
	c = x.course ?? return []
	pairs_below(x, x.recursing!.parameters#(c.place), c.below)
}
# computed reduces the head only, so the pair's first type stays `motive(field)` with the field as written
pairs_below(x: Elaborating, subject: Term, path: Term): list<Below> := {
	products = x.theory.environment.products!
	type = computed(x.el.c, filled(x.el, type_of(x.el.c, path)))
	if not is_constant(head(type), products.pair) { return [] }
	pair = products.pair
	first = projection(pair, 1, path)
	below = Below(subject, arguments(arguments(arguments(type)#1)#2).last, projection(pair, 1, first))
	[below] + pairs_below(x, subject, projection(pair, 2, first)) + pairs_below(x, subject, projection(pair, 2, path))
}
heads(type: Term, name: text): bool := match head(type).shape {
	Constant(head_name, levels, _) => head_name == name
	_ => no
}
# a term with each variable known in the arms around replaced by what it is known to be
known_in(x: Elaborating, t: Term): Term := x.known.fold(t, (inner, known) => replaced_by(inner, known.id, known.value))

# The hypotheses of an arm's fields, each by the field it is for: those about fields of the matched type, the other
# types of its block's giving nothing to recur on
below_of(x: Elaborating, subject: Term, type_name: text, hypotheses: list<Term>): list<Below> := {
	riding = hypotheses.map(hypothesis => Below(subject, ridden_field(x, hypothesis), hypothesis))
	riding.filter(below => ends_in(filled(x.el, type_of(x.el.c, below.field)), type_name))
}
# the field a hypothesis is about: the value its motive is applied to, a function field's at its arguments
ridden_field(x: Elaborating, hypothesis: Term): Term := {
	type = result_of(type_of(x.el.c, hypothesis))
	if arguments(type) is empty { refused(RECURSION, "the hypothesis ${shown(type)} is about no field") }
	head(arguments(type).last)
}
# whether a type, after its binders as written, is the named type applied
ends_in(type: Term, name: text): bool := heads(result_of(type), name)

# A call of the definition being read: the hypothesis of the field it is called on, given the other arguments
recursive_call_elaborated(x: Elaborating, arguments: list<Node>, wanted: Term?): Term := {
	r = x.recursing!
	if #arguments == #r.parameters {
		for below in (x.below + course_below(x)).reverse() {
			place = place_of(x, below.subject)
			if place > 0 and equal(x.el.c, known_in(x, filled(x.el, elaborated(x, arguments#place, ø))), known_in(x, filled(x.el, below.field))) {
				others = arguments.take(place - 1) + arguments.drop(place)
				return given_arguments(x, below.hypothesis, type_of(x.el.c, below.hypothesis), others, wanted)
			}
		}
	}
	why = if x.without_course is not ø then " (only a field is reachable: ${x.without_course!})" else ""
	refused(ENDING, "${r.name}(${arguments.map(argument => text(argument)).join(", ")}) calls ${r.name} on no value below one it matched, so it may not end${why}")
}
