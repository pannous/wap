# The state of an elaboration (notes/elaborate.md "Holes"): the holes that stand for what a program left out, and
# their answers.
#
# A hole for a term is a free variable of the kernel that the elaborator may answer, so the kernel's typing and
# computing work on a term with holes as they are: a hole is a variable nothing is known of. A hole for a level is
# a level parameter named by LEVEL_HOLE and a number, a name no program writes. Nothing here is trusted: a term is
# filled and handed to the kernel, which judges it whole.

use "../terms.wap"
use "../levels.wap"
use "../environment.wap"

LEVEL_HOLE := "?"
# the elaborator's own rules, which a refusal names
CANNOT_FIND := "cannot find"

# A hole: the id of its free variable, and the name the program would have written for what it stands for
class Hole { id: int; name: text }
# two terms, or two levels, still to be made equal, put off until a hole is answered
class Problem { left: Term; right: Term }
class LevelProblem { left: Level; right: Level }
# The state of one declaration's elaboration: a checker, whose hypotheses hold the binders gone into and the holes
# alike; the holes by their ids and the answers found; the level holes' answers; the problems put off
class Elaboration {
	c: Checker
	holes: map<int, Hole> = {}
	answers: map<int, Term> = {}
	level_holes: int = 0
	level_answers: map<text, Level> = {}
	problems: list<Problem> = []
	level_problems: list<LevelProblem> = []
}
elaboration(e: Environment, levels: list<text>): Elaboration := Elaboration(checker(e, levels))

# A new hole of a type: what a letter, a `_` or an argument left out stands for
hole(el: Elaboration, name: text, type: Term): Term := {
	variable = hypothesis(el.c, name, type)
	id = #el.c.hypotheses
	el.holes[id] = Hole(id, name)
	variable
}
# A new level hole, known to the checker as a level parameter of the declaration until it is answered or made one
level_hole(el: Elaboration): Level := {
	el.level_holes += 1
	name = LEVEL_HOLE + "${el.level_holes}"
	el.c.levels += [name]
	Parameter(name)
}
is_level_hole(name: text): bool := name.starts_with(LEVEL_HOLE)

# the hole a term is while it has no answer, ø for any other term
unanswered(el: Elaboration, t: Term): Hole? := match t.shape {
	Free(id) => if el.answers.has(id) then ø else el.holes.get(id)
	_ => ø
}

# A level with every answered level hole replaced by its answer
level_filled(el: Elaboration, level: Level): Level := match level {
	Zero => level
	Successor(of) => Successor(level_filled(el, of))
	Max(left, right) => Max(level_filled(el, left), level_filled(el, right))
	Imax(left, right) => Imax(level_filled(el, left), level_filled(el, right))
	Parameter(name) => {
		answer = el.level_answers.get(name) ?? return level
		level_filled(el, answer)
	}
}
# A term with every answered hole replaced by its answer, levels too: a term is filled before it is computed,
# compared or handed on. An answer holds no loose variable, so it is put in under binders as it is
filled(el: Elaboration, t: Term): Term := {
	if not t.holds_free and not t.holds_parameter { return t }
	match t.shape {
		Free(id) => {
			answer = el.answers.get(id) ?? return t
			shorter = filled(el, answer)
			el.answers[id] = shorter
			shorter
		}
		Sort(level) => universe(level_filled(el, level))
		Constant(name, levels) => constant(name, levels.map(level => level_filled(el, level)))
		Apply(function, argument) => apply(filled(el, function), filled(el, argument))
		Lambda(binder, domain, body) => lambda(binder, filled(el, domain), filled(el, body))
		Pi(binder, domain, body) => pi(binder, filled(el, domain), filled(el, body))
		LetIn(binder, type, value, body) => let_in(binder, filled(el, type), filled(el, value), filled(el, body))
		Projection(structure, field, of) => projection(structure, field, filled(el, of))
		_ => t
	}
}

# the holes without an answer that a filled term holds, by their ids, each once
holes_in(el: Elaboration, t: Term): list<int> := {
	if not t.holds_free { return [] }
	match t.shape {
		Free(id) => if el.holes.has(id) and not el.answers.has(id) then [id] else []
		_ => parts(t).flat_map(part => holes_in(el, part)).unique()
	}
}
# whether a term names the variable of a binder gone into after a mark: what an answer to a hole made at that mark
# may not name, since the hole stands outside that binder. A later hole may be named: its own answer is judged when
# it comes
later_binder(el: Elaboration, t: Term, mark: int): bool := {
	if not t.holds_free { return no }
	match t.shape {
		Free(id) => id > mark and not el.holes.has(id)
		_ => parts(t).any(part => later_binder(el, part, mark))
	}
}
# the level holes without an answer that a filled level names, and that a filled term names, each once
level_holes_in(level: Level): list<text> := level_parameters(level).filter(name => is_level_hole(name))
term_level_holes(t: Term): list<text> := {
	if not t.holds_parameter { return [] }
	match t.shape {
		Sort(level) => level_holes_in(level)
		Constant(name, levels) => levels.flat_map(level_holes_in).unique()
		_ => parts(t).flat_map(term_level_holes).unique()
	}
}

# What the elaboration has found so far, kept to go back to when a reading fails: the answers and the problems
class Found { answers: map<int, Term>; level_answers: map<text, Level>; problems: list<Problem>; level_problems: list<LevelProblem> }
found_so_far(el: Elaboration): Found := {
	kept = Found({}, {}, el.problems, el.level_problems)
	kept.answers.update(el.answers)
	kept.level_answers.update(el.level_answers)
	kept
}
back_to(el: Elaboration, kept: Found) := {
	el.answers = {}
	el.answers.update(kept.answers)
	el.level_answers = {}
	el.level_answers.update(kept.level_answers)
	el.problems = kept.problems
	el.level_problems = kept.level_problems
}

# What is still open when a declaration is done: the names of the holes without an answer, and whether every level
# problem put off holds now. A declaration with either is refused by `cannot find`
holes_left(el: Elaboration): list<text> := el.holes.keys().filter(id => not el.answers.has(id)).map(id => el.holes#id.name)
level_problems_hold(el: Elaboration): bool := el.level_problems.all(problem => levels_equal(level_filled(el, problem.left), level_filled(el, problem.right)))
