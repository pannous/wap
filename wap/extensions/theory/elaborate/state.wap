# The elaborator's own part of its state: what only the elaborator reads of the holes and binders that
# core/analyze/holes.wap keeps, the unifier's state analyze and the provers share.

use "../../../kernel/terms.wap"
use "../../../kernel/levels.wap"
use "../../../core/analyze/holes.wap"

# the elaborator's own rules, which a refusal names
CANNOT_FIND := "cannot find"
# binders left, wherever in the scope they stand
unscoped(el: Elaboration, variables: list<Term>) := {
	left = variables.map(variable_id)
	el.scope = el.scope.filter(variable => not left.contains(variable_id(variable)))
}
level_problems_hold(el: Elaboration): bool := el.level_problems.all(problem => levels_equal(level_filled(el, problem.left), level_filled(el, problem.right)))
