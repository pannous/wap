# Statements read as terms (coc-plan 9.5, notes/elaborate.md "Statements and effects"): a block is its statements in
# order, each one binding what the rest of the block reads. A value given to a name is a new binding of it,
# `s = s + 1` a let whose body is the rest, so its type may change. A choice before the rest of the block joins
# again: the rest is read once, as a function of the names the parts give (the join), and each part ends by calling
# it, so a return in a part skips it. A counted loop is a walk down the number of its rounds: each round ends by
# calling the walk of the rounds left with the names it gives, the last one the join; a continue ends a round there, a
# break calls the join at once. A return gives the block's
# value at once, and the statements after it are never read.
use "../../../kernel/terms.wap"
use "../../../kernel/environment.wap"
use "../../../kernel/typing.wap"
use "../../../kernel/forms.wap"
use "../../../kernel/numbers.wap"
use "../../../kernel/recursors.wap"
use "../../../core/analyze/holes.wap"
use "state.wap"
use "read.wap"
use "effects.wap"
use "match.wap"
use "../../../kernel/compute.wap"
use "../../../kernel/inductive.wap"

# the elaborator's own rule a refusal names
STATEMENT := "statement"
# the names a choice's join, a loop's join, a round and the walk of the rounds after it are given, ones no program writes
JOIN := "the rest of the block"
EXIT := "the rest after the loop"
ROUND := "the round"
NEXT := "the next round"
LEFT := "the rounds left"
BEFORE := "the rounds before"
TOTAL := "the rounds in all"
# the number a round's range and the rounds before are conditions on
NUMBER := "the number"
# the fact a let's name is given, one no program writes
DEFINITION := "the definition of "
# the words a round's range and the walk's count are written in
WHERE_FUNCTION := "where"
AT_MOST := "<="
PLUS := "+"
EQUALS := "=="

# A block of the type wanted: its first statement, the rest of the block after it
statements_elaborated(x: Elaborating, statements: list<Node>, wanted: Term?): Term := {
	if statements is empty { refused(STATEMENT, "an empty block gives no value: write the value last") }
	first = statements#1
	rest = statements.drop(1)
	match first {
		Return(value) => elaborated(x, value, wanted)
		Block(inner) => statements_elaborated(x, inner + rest, wanted)
		Break() => left_elaborated(x, first, EXIT, [], wanted)
		Continue() => left_elaborated(x, first, NEXT, [next_round(x)], wanted)
		Set(place, value) => if rest is empty then no_value(first) else let_elaborated(x, place_binder(place), value, rest, wanted)
		If(condition, then_part, else_part) => if rest is empty then elaborated(x, first, wanted) else joined_elaborated(x, condition, statements_in(then_part), statements_in(else_part), rest, wanted)
		For(place, count, body) => if rest is empty then no_value(first) else walked_elaborated(x, place, count, statements_in(body), rest, wanted)
		_ => if rest is empty then elaborated(x, first, wanted) else refused(STATEMENT, "${text(first)} gives nothing the rest of the block reads: a value before the last is lost")
	}
}
# a statement that ends a block but gives no value
no_value(statement: Node): Term := refused(STATEMENT, "${text(statement)} gives no value: write the value after it")
# a part of a choice as statements, an else-part left out none
statements_in(part: Node): list<Node> := match part {
	Block(statements) => statements
	Empty => []
	_ => [part]
}

# `name = value` and the rest of the block: a let of the name, which holds the value's type in the rest
# (the computation the value is runs around the let; the rest closes inside it, where its name is bound)
let_elaborated(x: Elaborating, binder: WrittenBinder, value_written: Node, rest: list<Node>, wanted: Term?): Term := closed_over(x, wanted, () => {
	type = if binder.type is not ø then elaborated(x, binder.type!, any_sort(x)) else ø
	pending = #x.pending
	read = elaborated(x, value_written, type)
	value = filled(x.el, ran(x, read, type_of(x.el.c, filled(x.el, read)), ø) ?? read)
	held = filled(x.el, type ?? type_of(x.el.c, value))
	variable = scoped(x.el, binder.name, held)
	# a value that opened runs stands for their results, bound around the let: it is no fact about the name, and the
	# runs are taken back only where they were bound, so a count that did not grow means the value runs nothing
	definition = if #x.pending == pending then defined(x, variable, held, value) else []
	body = filled(x.el, rest_read(x, rest, wanted))
	unscoped(x.el, [variable] + definition.map(fact => fact.variable))
	defining = definition.fold(body, (inner, fact) => instantiated(abstracted(inner, variable_id(fact.variable)), fact.proof))
	let_in(binder.name, held, value, abstracted(defining, variable_id(variable)))
})
# A let's name equals its value: a fact in scope while the rest is read, and the name's refl once the let closes,
# where the kernel reads the rest with the value put in. None without an equality, for a value of no known sort, or
# for a value a computation gives part of: that is known only by running it
class LetFact { variable: Term; proof: Term }
defined(x: Elaborating, variable: Term, held: Term, value: Term): list<LetFact> := {
	numbers = x.theory.environment.numbers ?? return []
	level = match computed(x.el.c, filled(x.el, type_of(x.el.c, held))).shape {
		Sort(level) => level
		_ => return []
	}
	fact = apply_all(at_levels(numbers.equality, [level]), [held, variable, value])
	name = hypothesis_of(x.el.c, variable_id(variable)).binder
	[LetFact(scoped(x.el, DEFINITION + name, fact), apply_all(at_levels(reflexive_case(x.theory.environment, numbers.equality), [level]), [held, variable]))]
}

# the rest of a block after what binds names in it: a binder that closes, around which the computations run in it bind
rest_read(x: Elaborating, rest: list<Node>, wanted: Term?): Term := closed_over(x, wanted, () => statements_elaborated(x, rest, wanted))

# the name a value is given to, typed or not; a part of a value, `xs#1 = 2` or `xs#1: nat = 2`, is refused, never read as a name
place_binder(place: Node): WrittenBinder := match place {
	Symbol(name) => named_binder(place)
	Key(Symbol(name), Op.Colon, type) => named_binder(place)
	_ => refused(STATEMENT, "${text(place)} = … gives a part of a value: give the name the whole new value")
}

# A choice and the rest of the block: the rest read once as the join, a function of the names either part gives that
# the rest can see (in scope before, or given by both parts), and each part ending with its call
joined_elaborated(x: Elaborating, condition: Node, then_part: list<Node>, else_part: list<Node>, rest: list<Node>, wanted: Term?): Term := {
	then_given = names_given(then_part)
	else_given = names_given(else_part)
	given = unique(then_given + else_given).filter(name => named(x.el, name) is not ø or (then_given.contains(name) and else_given.contains(name)))
	rejoined(x, JOIN, given, rest, wanted, called => elaborated(x, If(condition, Block(then_part + [called]), Block(else_part + [called])), wanted))
}
# each name given scoped, of the type it had before
given_scoped(x: Elaborating, given: list<text>): list<Term> := given.map(given_name => scoped(x.el, given_name, type_before(x, given_name)))
# The rest of the block after a statement of several paths, read once as a function of the names given, let-bound
# under a name; split reads the statement with it in scope, given the call that ends each path
rejoined(x: Elaborating, name: text, given: list<text>, rest: list<Node>, wanted: Term?, split: (Node) -> Term): Term := {
	variables = given_scoped(x, given)
	body = rest_read(x, rest, wanted)
	unscoped(x.el, variables)
	join = closed_filled(x.el, body, variables, yes)
	join_type = type_of(x.el.c, join)
	joining = scoped(x.el, name, join_type)
	paths = split(Call(symbol(name), given.map(symbol)))
	unscoped(x.el, [joining])
	let_in(name, filled(x.el, join_type), filled(x.el, join), abstracted(filled(x.el, paths), variable_id(joining)))
}

# A counted loop and the rest of the block: the rest read once as the loop's join, of the names the body gives that
# the rest can see, and the loop the walk of the number type's recursor down the count, from no round before; a
# round's place is the number after the rounds before it, so it counts 1 … count
walked_elaborated(x: Elaborating, place: Node, count: Node, body: list<Node>, rest: list<Node>, wanted: Term?): Term := {
	numbers = loop_numbers(x)
	counted = elaborated(x, count, number_type(numbers))
	given = unique(names_given(body)).filter(name => named(x.el, name) is not ø)
	rejoined(x, EXIT, given, rest, wanted, _ => walk_elaborated(x, numbers, place, count, counted, body, given, wanted))
}
# The walk of the number type's recursor down the count to the loop's join, from no round before. Its motive holds of
# the rounds left: the rounds before are those that add up to the count with them, so each round is proved to lie
# between 1 and the count
walk_elaborated(x: Elaborating, numbers: Numbers, place: Node, count: Node, counted: Term, body: list<Node>, given: list<text>, wanted: Term?): Term := {
	exit = named(x.el, EXIT)!
	total = scoped(x.el, TOTAL, number_type(numbers))
	e = eliminating(x, total, pi(BEFORE, before_type(x, numbers, TOTAL, count), hypothesis_of(x.el.c, variable_id(exit)).type), recursor_name(constant_name(numbers.number)))
	unscoped(x.el, [total])
	walk = Applied(e.function, e.rest)
	walk = given_one(x, walk, motive => made_of(x, lambda(BEFORE, pi_parts(x, motive)!.domain, exit), motive))!
	walk = given_one(x, walk, step => made_of(x, round_elaborated(x, numbers, place, count, body, given, step, wanted), step))!
	for value in [counted, numeral(0)] + given.map(given_name => named(x.el, given_name)!) { walk = given_one(x, walk, taken => made_of(x, value, taken))! }
	walk.function
}
# The step of a walk: the rounds left, the walk of them, the rounds before and the names given, to a round: its place
# the number after the rounds before, between 1 and the count, the body, and the call of the walk of the rounds left
round_elaborated(x: Elaborating, numbers: Numbers, place: Node, count: Node, body: list<Node>, given: list<text>, step: Term, wanted: Term?): Term := {
	stepping = pi_parts(x, step)!
	left = scoped(x.el, LEFT, stepping.domain)
	walked = pi_parts(x, instantiated(stepping.body, left))!
	walking = scoped(x.el, NEXT, walked.domain)
	before = scoped(x.el, BEFORE, pi_parts(x, instantiated(walked.body, walking))!.domain)
	variables = given_scoped(x, given)
	range = round_type(x, numbers, count)
	this_round = elaborated(x, next_round(x), range)
	round = scoped(x.el, ROUND, range)
	around = x.round_given
	x.round_given = given
	run = rest_read(x, [Set(place, symbol(ROUND))] + body + [Continue()], wanted)
	x.round_given = around
	unscoped(x.el, [round])
	rounds = let_in(ROUND, range, this_round, abstracted(filled(x.el, run), variable_id(round)))
	unscoped(x.el, [left, walking, before] + variables)
	closed_filled(x.el, rounds, [left, walking, before] + variables, yes)
}
# the number after the rounds before: the round's place, and the rounds before the next round
next_round(x: Elaborating): Node := Call(symbol(constant_name(loop_numbers(x).successor)), [symbol(BEFORE)])
# the numbers a loop counts its rounds in
loop_numbers(x: Elaborating): Numbers := x.theory.environment.numbers ?? refused(STATEMENT, "a loop counts its rounds in numbers, and no numbers are declared")
# a round's type: the numbers from 1 to the count
round_type(x: Elaborating, numbers: Numbers, count: Node): Term := numbers_where(x, numbers, If(operation(AT_MOST, Number(1), symbol(NUMBER)), operation(AT_MOST, symbol(NUMBER), count), False()))
# the type of the rounds before, of the rounds left: the numbers adding up to the count with them
before_type(x: Elaborating, numbers: Numbers, left: text, count: Node): Term := numbers_where(x, numbers, operation(EQUALS, operation(PLUS, symbol(NUMBER), symbol(left)), count))
numbers_where(x: Elaborating, numbers: Numbers, condition: Node): Term := elaborated(x, Call(symbol(WHERE_FUNCTION), [symbol(constant_name(numbers.number)), function_of(x, NUMBER, condition)]), any_sort(x))
operation(name: text, a: Node, b: Node): Node := Call(symbol(name), [a, b])
# a break or a continue: the round left by calling the rest after the loop, or the walk of the rounds after it, with
# the names the round passes on; the statements after it are never read
left_elaborated(x: Elaborating, word: Node, name: text, leading: list<Node>, wanted: Term?): Term := {
	given = x.round_given ?? refused(STATEMENT, "${text(word)} leaves a loop: write it in a loop's body")
	elaborated(x, Call(symbol(name), leading + given.map(symbol)), wanted)
}
# a name's type before a choice, else a hole the parts' calls of the join answer
type_before(x: Elaborating, name: text): Term := {
	before = named(x.el, name)
	if before is ø then hole(x.el, "the type of ${name}", any_sort(x)) else hypothesis_of(x.el.c, variable_id(before!)).type
}
# the names statements give a value, a choice's parts' included
names_given(statements: list<Node>): list<text> := {
	given: list<text> = []
	for statement in statements {
		given += match statement {
			Set(place, value) => [place_binder(place).name]
			If(condition, then_part, else_part) => names_given(statements_in(then_part)) + names_given(statements_in(else_part))
			Block(inner) => names_given(inner)
			For(place, count, body) => names_given(statements_in(body))
			_ => []
		}
	}
	given
}
