# Unions (notes/elaborate.md "Sums (E7)"): `A or B` of two types is their sum, the prelude's Sum(A, B), whose cases
# left(a) and right(b) hold a value of either. A union is written in one normal form, so the same parts make one type
# however they are written: sums inside it flattened, each part computed and kept once, the parts ordered by their
# key, then summed from the right; a union of one part is that part.
use "../../../kernel/terms.wap"
use "../../../kernel/environment.wap"
use "../../../kernel/compute.wap"
use "../../../kernel/typing.wap"
use "../../../kernel/show.wap"
use "../../../kernel/levels.wap"
use "../explicit.wap"
use "../../../kernel/forms.wap"
use "../../../core/type_notation.wap"
use "../../../core/analyze/holes.wap"
use "state.wap"
use "../../../core/analyze/unify.wap"
use "read.wap"
use "match.wap"
use "conditions.wap"

# the prelude's enum of a value of one of two types, and its cases: a value of the first, of the second
SUM := "Sum"
LEFT_CASE := "left"
RIGHT_CASE := "right"
# the prelude's type of nothing, what ø is where a type is wanted, and its one value, ø where a value is
NOTHING := UNIT_NAME
NOTHING_VALUE := "unit"
# the name a distributed call's arm gives its case's value, a name no program writes
# the name a case's value is bound to in its arm, after the argument's place, so a second union taken apart keeps the first's
CASE_VALUE := "the value of the case at"

# `A or B` reaches the elaborator as the spelling of a condition, If(A, yes, B) (sugar/conditions.wap), since `or` is
# no word of the prelude: where the condition is a type, neither a bool nor a proposition, the union is its one
# reading. ø for any other choice
union_written(x: Elaborating, tested: Term, then_part: Node, else_part: Node): Term? := {
	if not then_part is True or not is_type(x, tested) { return ø }
	union_of(x, [tested, elaborated(x, else_part, any_sort(x))])
}
# whether a term is a type of data, a sort above Prop, or a proposition, of the sort Prop
is_type(x: Elaborating, t: Term): bool := in_prop(x, t) == no
is_proposition_term(x: Elaborating, t: Term): bool := in_prop(x, t) == yes
# whether the sort a term lies in is Prop, ø for a term that is no type
in_prop(x: Elaborating, t: Term): bool? := match computed(x.el.c, filled(x.el, type_of(x.el.c, t))).shape {
	Sort(level) => is_zero(simplified(level))
	_ => ø
}

# The union of types in its normal form: the parts other than nothing ordered by their key (hash, then shown form), nothing last, at the
# level of the part before it, as an optional value `T?` is Sum(T, Unit) at T's level
union_of(x: Elaborating, types: list<Term>): Term := {
	found = types.flat_map(type => summands(x, type))
	parts: list<Term> = []
	for part in found.filter(part => not is_nothing(x, part)).sorted(by: part => "${part.hash} ${shown(part)}") {
		if not parts.any(seen => same(seen, part)) { parts += [part] }
	}
	nothings = found.filter(part => is_nothing(x, part))
	if nothings is empty { return summed(x, parts) }
	last = if parts is empty then nothings#1 else nothing_type(x, level_of(x.el.c, parts.last))
	if not nothings.all(each => unified(x.el, each, last)) { refused(VALUE_TYPE, "${nothings.map(each => shown(filled(x.el, each))).join(" and ")} are two kinds of nothing") }
	summed(x, parts + [last])
}
# `T?`, the union of T and nothing; ø for any other form
optional_written(x: Elaborating, n: Node): Term? := {
	base = (written_parts_of(OPTIONAL_MARK, n) ?? return ø)#1
	union_of(x, [elaborated(x, base, any_sort(x)), nothing_type(x, level_hole(x.el))])
}
# ø: the type of nothing where a type is wanted, else its one value, at the level of the nothing a union wanted holds
nothing_elaborated(x: Elaborating, wanted: Term?): Term := {
	if wanted is ø { return nothing_value(x, [level_hole(x.el)]) }
	type = computed(x.el.c, filled(x.el, wanted!))
	if is_sort(type) { return nothing_type(x, level_hole(x.el)) }
	held = summands(x, type).find(part => is_nothing(x, part))
	nothing_value(x, if held is ø then [level_hole(x.el)] else type_levels(held!))
}
nothing_value(x: Elaborating, levels: list<Level>): Term := constant_of(x.theory.environment, "${nothing_name(x)}${DOT}${NOTHING_VALUE}", levels)
nothing_type(x: Elaborating, level: Level): Term := constant_of(x.theory.environment, nothing_name(x), [level])
is_nothing(x: Elaborating, t: Term): bool := match t.shape {
	Constant(name, levels, _) => name == nothing_name(x)
	_ => no
}
# the parts a type is the union of: a sum's parts' parts, any other type computed itself
summands(x: Elaborating, type: Term): list<Term> := {
	t = computed(x.el.c, filled(x.el, type))
	if not is_sum(x, t) { return [t] }
	arguments(t).flat_map(part => summands(x, part))
}
is_sum(x: Elaborating, t: Term): bool := match head(t).shape {
	Constant(name, levels, _) => name == sum_name(x) and #arguments(t) == 2
	_ => no
}
# the parts summed from the right, each sum at the levels of its two parts
summed(x: Elaborating, parts: list<Term>): Term := {
	if #parts == 1 { return parts#1 }
	rest = summed(x, parts.drop(1))
	apply_all(constant_of(x.theory.environment, sum_name(x), [level_of(x.el.c, parts#1), level_of(x.el.c, rest)]), [parts#1, rest])
}
# A value made a value of the union wanted: the case holding it at the part its type is, `left` for the first part,
# `right` of the rest's for any other; ø where the type wanted is no union, or no part of it is the value's type
injected(x: Elaborating, t: Term, given: Term, wanted: Term): Term? := {
	union = computed(x.el.c, wanted)
	if not is_sum(x, union) { return ø }
	parts = arguments(union)
	if unified(x.el, given, parts#1) { return case_of(x, LEFT_CASE, union, t) }
	inner = (if unified(x.el, given, parts#2) then t else injected(x, t, given, parts#2)) ?? return ø
	case_of(x, RIGHT_CASE, union, inner)
}
# a sum's case holding a value, at the sum's levels and parts
case_of(x: Elaborating, case: text, union: Term, value: Term): Term := apply_all(constant_of(x.theory.environment, "${sum_name(x)}${DOT}${case}", type_levels(union)), arguments(union) + [value])

# A call no declaration fits, an argument of it a union: the match on the first such argument, each case's arm the
# call given the case's value in its place. A declaration per part so makes one for the union, and a union of three
# parts distributes again in the arm of `right`. The match gives the type wanted, else the union of its arms' types;
# ø where no argument is a union
distributed(x: Elaborating, name: text, arguments: list<Node>, wanted: Term?): Term? := {
	for place in 1 to #arguments {
		if union_typed(x, arguments#place) { return cases_called(x, name, arguments, place, wanted) }
	}
	ø
}
# whether an argument read alone is of a union, taken back either way
union_typed(x: Elaborating, argument: Node): bool := undone(x, () => try { is_sum(x, computed(x.el.c, filled(x.el, type_of(x.el.c, elaborated(x, argument, ø))))) } catch e { mismatch(e) })
cases_called(x: Elaborating, name: text, written: list<Node>, place: int, wanted: Term?): Term := {
	subject = elaborated(x, written#place, ø)
	bound = "${CASE_VALUE} ${place}"
	call = Call(symbol(name), written.take(place - 1) + [symbol(bound)] + written.drop(place))
	parts = arguments(computed(x.el.c, filled(x.el, type_of(x.el.c, subject))))
	arms = [LEFT_CASE, RIGHT_CASE].map(case => ArmWritten(case_written(case, [symbol(bound)]), call))
	subject_matched(x, subject, arms, wanted ?? union_of(x, parts.map(part => type_given(x, call, bound, part))))
}
# the type of a call where the case's value is of a part, taken back
type_given(x: Elaborating, call: Node, bound: text, part: Term): Term := taken_back(x.el, () => {
	value = scoped(x.el, bound, part)
	type = filled(x.el, type_of(x.el.c, elaborated(x, call, ø)))
	unscoped(x.el, [value])
	type
})

# the enum of sums where the program reads: its own where it declares one, else the prelude's
sum_name(x: Elaborating): text := kernel_name(x.theory, SUM)
nothing_name(x: Elaborating): text := kernel_name(x.theory, NOTHING)
