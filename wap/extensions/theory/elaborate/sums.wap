# Unions (notes/elaborate.md "Sums (E7)"): `A or B` of two types is their sum, the prelude's Sum(A, B), whose cases
# left(a) and right(b) hold a value of either. A union is written in one normal form, so the same parts make one type
# however they are written: sums inside it flattened, each part computed and kept once, the parts ordered by their
# key, then summed from the right; a union of one part is that part.
use "../terms.wap"
use "../environment.wap"
use "../compute.wap"
use "../typing.wap"
use "../levels.wap"
use "../explicit.wap"
use "../../../kernel/forms.wap"
use "state.wap"
use "unify.wap"
use "read.wap"
use "match.wap"

# the prelude's enum of a value of one of two types, and its cases: a value of the first, of the second
SUM := "Sum"
LEFT := "left"
RIGHT := "right"

# `A or B` reaches the elaborator as the spelling of a condition, If(A, yes, B) (sugar/conditions.wap), since `or` is
# no word of the prelude: where the condition is a type, neither a bool nor a proposition, the union is its one
# reading. ø for any other choice
union_written(x: Elaborating, tested: Term, then_part: Node, else_part: Node): Term? := {
	if not then_part is True or not is_type(x, tested) { return ø }
	union_of(x, [tested, elaborated(x, else_part, any_sort(x))])
}
# whether a term is a type of data: it lies in a sort above Prop
is_type(x: Elaborating, t: Term): bool := match computed(x.el.c, filled(x.el, type_of(x.el.c, t))).shape {
	Sort(level) => not is_zero(simplified(level))
	_ => no
}

# the union of types in its normal form
union_of(x: Elaborating, types: list<Term>): Term := {
	parts: list<Term> = []
	for part in types.flat_map(type => summands(x, type)).sorted(by: part => part.hash) {
		if not parts.any(seen => same(seen, part)) { parts += [part] }
	}
	summed(x, parts)
}
# the parts a type is the union of: a sum's parts' parts, any other type computed itself
summands(x: Elaborating, type: Term): list<Term> := {
	t = computed(x.el.c, filled(x.el, type))
	if not is_sum(x, t) { return [t] }
	arguments(t).flat_map(part => summands(x, part))
}
is_sum(x: Elaborating, t: Term): bool := match head(t).shape {
	Constant(name, levels) => name == sum_name(x) and #arguments(t) == 2
	_ => no
}
# the parts summed from the right, each sum at the levels of its two parts
summed(x: Elaborating, parts: list<Term>): Term := {
	if #parts == 1 { return parts#1 }
	rest = summed(x, parts.drop(1))
	apply_all(constant(sum_name(x), [level_of(x.el.c, parts#1), level_of(x.el.c, rest)]), [parts#1, rest])
}
# A value made a value of the union wanted: the case holding it at the part its type is, `left` for the first part,
# `right` of the rest's for any other; ø where the type wanted is no union, or no part of it is the value's type
injected(x: Elaborating, t: Term, given: Term, wanted: Term): Term? := {
	union = computed(x.el.c, wanted)
	if not is_sum(x, union) { return ø }
	parts = arguments(union)
	if is_part(x, given, parts#1) { return case_of(x, LEFT, union, t) }
	inner = (if is_part(x, given, parts#2) then t else injected(x, t, given, parts#2)) ?? return ø
	case_of(x, RIGHT, union, inner)
}
# whether a part of a union is the type given, unified where it is
is_part(x: Elaborating, given: Term, part: Term): bool := taken_back(x.el, () => unified(x.el, given, part)) and unified(x.el, given, part)
# a sum's case holding a value, at the sum's levels and parts
case_of(x: Elaborating, case: text, union: Term, value: Term): Term := apply_all(constant("${sum_name(x)}${DOT}${case}", type_levels(union)), arguments(union) + [value])

# the enum of sums where the program reads: its own where it declares one, else the prelude's
sum_name(x: Elaborating): text := kernel_name(x.theory, SUM)
