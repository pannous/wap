# Untyped parameters (wiki/function.md "Untyped and `any` parameters"; notes/coc-plan.md, "an untyped function is a
# template"): `square(x) := x * x` declares nothing; each call elaborates it once more for its arguments' types, a
# version declared by the name and those types and called from then on, so `square(3)` is a nat and `square(x)` for
# an int x an int. A template nothing calls is never typed
use "../terms.wap"
use "../environment.wap"
use "../typing.wap"
use "../equal.wap"
use "../show.wap"
use "state.wap"
use "unify.wap"
use "read.wap"
use "declare.wap"

# a function with an untyped parameter as written: its name, its parameters and its value, and the versions made of it
class Template { named: Node; parameters: list<Node>; value: Node; versions: list<Version> = [] }
# a version of a template: its arguments' types and the name it is declared by
class Version { types: list<Term>; name: text }

# the refusals of a body that does not give its untyped parameters a type: two declarations fit, or nothing is found
UNDETERMINED := [OVERLOAD, CANNOT_FIND]

# A function with an untyped parameter: elaborated from its body where that gives the parameter a type, else a
# template, the theory put back as it was before the body was tried (wiki/function.md: from the body and the calls)
untyped_elaborated(p: Theory, named: Node, written: list<Node>, value: Node) := {
	before = copied(p)
	refusal = try { definition_elaborated(p, "", named, written, value); ø } catch e { e }
	if refusal is not ø {
		held(p, before)
		mismatch(refusal!, UNDETERMINED)
		p.templates[definition_name(named)] = Template(named, written, value)
	}
}

# a call of a template: the version for its arguments' types, made where it is the first, given the arguments read
version_called(x: Elaborating, name: text, template: Template, read: list<Argument>, wanted: Term?): Term := {
	types = read.map(argument => filled(x.el, type_of(x.el.c, term_alone(x, argument))))
	if #types != #template.parameters { refused(CANNOT_FIND, "${name} takes ${#template.parameters} arguments, whose types its untyped parameters take") }
	# a type still open, or naming a value bound around the call, is no type a version can be declared at
	local = types.find(type => type.holds_free)
	if local is not ø { refused(CANNOT_FIND, "${name} takes its parameters' types from its arguments, and ${shown(local!)} is known only here: write the types of ${name}'s parameters") }
	version = template.versions.find(version => (1 to #types).list().all(at => equal(x.el.c, version.types#at, types#at)))
	if version is ø {
		version = Version(types, definition_elaborated(x.theory, "", template.named, template.parameters, template.value, types)!)
		template.versions += [version!]
	}
	declared_read(x, version!.name, read, wanted)
}
