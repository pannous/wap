# Untyped parameters (wiki/function.md "Untyped and `any` parameters"; notes/coc-plan.md, "an untyped function is a
# template"): `square(x) := x * x` declares nothing; each call elaborates it once more for its arguments' types, a
# version declared by the name and those types and called from then on, so `square(3)` is a nat and `square(x)` for
# an int x an int. A template nothing calls is never typed
use "../terms.wap"
use "../environment.wap"
use "../typing.wap"
use "../show.wap"
use "state.wap"
use "unify.wap"
use "read.wap"
use "declare.wap"

# a function with an untyped parameter as written: its name, its parameters and its value
class Template { named: Node; parameters: list<Node>; value: Node }

# a call of a template: the version for its arguments' types, made where it is the first, given the arguments
version_called(x: Elaborating, name: text, template: Template, arguments: list<Node>, wanted: Term?): Term := {
	types = taken_back(x.el, () => arguments.map(argument => filled(x.el, type_of(x.el.c, elaborated(x, argument, ø)))))
	if #types != #template.parameters or types.any(type => open(x.el, type)) { refused(CANNOT_FIND, "${name} takes the types of its untyped parameters from its arguments: give it ${#template.parameters} arguments whose types are found") }
	key = "${name}(${types.map(shown).join(", ")})"
	if not x.theory.versions.has(key) { x.theory.versions[key] = definition_elaborated(x.theory, "", template.named, template.parameters, template.value, types)! }
	declared_given(x, x.theory.versions#key, arguments, wanted)
}
