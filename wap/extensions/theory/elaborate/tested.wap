# A law without a proof tested by computing (notes/coc-plan.md P1, wiki/proof.md "Checking proofs"): each of its
# parameters takes small values of its type, and the kernel computes the statement on each. An equation whose two
# sides compute to the same holds; one whose sides compute to different cases or numbers is a counterexample.
use "../../../kernel/terms.wap"
use "../../../kernel/environment.wap"
use "../../../kernel/compute.wap"
use "../../../kernel/equal.wap"
use "../../../kernel/inductive.wap"
use "../../../kernel/show.wap"

# how many layers of values a type gives (nat: 0 to 4), and how many tries a law gets at most
TRIED_DEPTH := 4
TRIED_LIMIT := 64

# what the tries found: every one held, one failed on these values, or none could be decided
enum Tried { Held, Failed(counterexample: text), Undecided }

# the law's statement tried on the values of its parameters' types
tried(c: Checker, statement: Term): Tried := {
	instances = instances_of(c, statement, [])
	if instances is empty { return Undecided }
	for instance in instances {
		answer = answered(c, instance.statement)
		if answer == no { return Failed(instance.values.join(", ")) }
		if answer is ø { return Undecided }
	}
	Held
}

# a statement with values in its parameters' places, and those values as `n = 1`
class Instance { statement: Term; values: list<text> }
# the statement with each parameter given each tried value of its type, in order; none when a parameter's type has
# no values to try
instances_of(c: Checker, statement: Term, values: list<text>): list<Instance> := match statement.shape {
	Pi(binder, domain, body) => tried_values(c, domain).flat_map(value => instances_of(c, instantiated(body, value), values + ["${binder} = ${shown(value)}"])).take(TRIED_LIMIT)
	_ => if values is empty then [] else [Instance(statement, values)]
}

# the values a type gives: an enum of one type without parameters or indices builds its cases without fields first,
# then each layer its cases whose fields are all of the type, from the layer before; any other type gives none
tried_values(c: Checker, type: Term): list<Term> := {
	facts = plain_enum(c, computed(c, type)) ?? return []
	cases = facts.block.types#1.cases
	makers = (1 .. #cases + 1).filter(place => facts.fields#1#place == #facts.recursive#1#place).map(place => Maker(constant(cases#place.name, []), facts.fields#1#place))
	layered(makers.filter(m => m.fields == 0).map(m => m.case), makers.filter(m => m.fields > 0), TRIED_DEPTH)
}
# a case of a type and how many fields of the type it takes
class Maker { case: Term; fields: int }
# a layer of values and those the makers build on it, depth layers more
layered(layer: list<Term>, makers: list<Maker>, depth: int): list<Term> :=
	if depth == 0 or layer is empty then layer else layer + layered(makers.flat_map(m => filled_by(m.case, m.fields, layer)).take(TRIED_LIMIT), makers, depth - 1)
# a case applied to every choice of its fields from the values
filled_by(case: Term, fields: int, values: list<Term>): list<Term> := if fields == 0 then [case] else values.flat_map(value => filled_by(apply(case, value), fields - 1, values))
# the facts of a type that is an enum of one type, without parameters, levels or indices
plain_enum(c: Checker, type: Term): InductiveFacts? := match type.shape {
	Constant(name, levels) => {
		d = declaration(c.environment, name) ?? return ø
		match d.kind {
			Inductive(facts) => if #facts.block.types == 1 and facts.block.parameters == 0 and facts.indices#1 == 0 then facts else ø
			_ => ø
		}
	}
	_ => ø
}

# whether an equation holds on these values: yes when its sides compute to the same, no when they compute to
# different cases or numbers; ø for a statement that is no equation, or sides that do not compute that far
answered(c: Checker, statement: Term): bool? := {
	equation = equation_of(c, statement) ?? return ø
	if equal(c, equation.left, equation.right) then yes else if differ(c, equation.left, equation.right) then no else ø
}
# whether two values computed are made differently: other numbers, other cases, or the same case with fields that
# differ
differ(c: Checker, a: Term, b: Term): bool := {
	x = computed(c, a)
	y = computed(c, b)
	m = number_of(x)
	n = number_of(y)
	if m is not ø and n is not ø { return m!.limbs != n!.limbs }
	left = case_name(c, head(x)) ?? return no
	right = case_name(c, head(y)) ?? return no
	fields = arguments(x)
	others = arguments(y)
	left != right or (#fields == #others and (1 .. #fields + 1).any(at => differ(c, fields#at, others#at)))
}
number_of(t: Term): Magnitude? := match t.shape {
	Numeral(value) => value
	_ => ø
}
# the case a term's head names, ø for a head that is no case
case_name(c: Checker, t: Term): text? := match t.shape {
	Constant(name, levels) => match (declaration(c.environment, name) ?? return ø).kind {
		Constructor(of, place, fields) => name
		_ => ø
	}
	_ => ø
}
