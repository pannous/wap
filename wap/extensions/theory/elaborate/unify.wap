# Unification (notes/elaborate.md "Holes"): whether two terms can be made equal, answering holes on the way.
#
# Two terms without a hole are the kernel's to compare (equal.wap). With holes the walk is the same, rule for rule,
# and adds what a hole allows: a hole standing alone is answered by the other side, when that side names neither
# the hole itself nor the variable of a binder gone into after the hole was made; the answer's type is unified with
# the hole's type, which is what finds a letter's level from its value. A hole applied to arguments waits as a
# problem put off, tried again whenever a hole is answered. A reading that fails leaves no answer behind.
#
# Nothing here is trusted. An answer that should not have been given makes a term the kernel refuses.

use "../terms.wap"
use "../levels.wap"
use "../environment.wap"
use "../compute.wap"
use "../equal.wap"
use "../typing.wap"
use "state.wap"

# Whether a and b can be made equal; answers found on a failed try are dropped
unified(el: Elaboration, a: Term, b: Term): bool := {
	left = filled(el, a)
	right = filled(el, b)
	if same(left, right) { return yes }
	if not open(el, left) and not open(el, right) { return equal(el.c, left, right) }
	kept = found_so_far(el)
	if made_equal(el, left, right) { return yes }
	back_to(el, kept)
	no
}

# whether a filled term holds a hole or a level hole without an answer
open(el: Elaboration, t: Term): bool := #holes_in(el, t) > 0 or names_level_hole(t)
names_level_hole(t: Term): bool := {
	if not t.holds_parameter { return no }
	match t.shape {
		Sort(level) => #level_holes_in(level) > 0
		Constant(name, levels) => levels.any(level => #level_holes_in(level) > 0)
		_ => parts(t).any(part => names_level_hole(part))
	}
}

made_equal(el: Elaboration, a: Term, b: Term): bool := {
	left = computed_folded(el.c, a)
	right = computed_folded(el.c, b)
	if same(left, right) { return yes }
	left_hole = unanswered(el, head(left))
	right_hole = unanswered(el, head(right))
	if left_hole is not ø and arguments(left) is empty { return answered(el, left_hole, right) }
	if right_hole is not ø and arguments(right) is empty { return answered(el, right_hole, left) }
	if left_hole is not ø or right_hole is not ø {
		el.problems += [Problem(left, right)]
		return yes
	}
	kept = found_so_far(el)
	if alike_made(el, left, right) { return yes }
	back_to(el, kept)
	# two unlike heads: the later-declared one unfolds, as in the kernel's equality
	left_place = unfolding_place(el.c, left)
	right_place = unfolding_place(el.c, right)
	if left_place == 0 and right_place == 0 { return no }
	next_left = if left_place >= right_place then unfolded(el.c, left) ?? left else left
	next_right = if right_place >= left_place then unfolded(el.c, right) ?? right else right
	made_equal(el, next_left, next_right)
}

# two terms of one shape whose parts can be made equal
alike_made(el: Elaboration, a: Term, b: Term): bool := match a.shape {
	Sort(level) => match b.shape {
		Sort(other) => levels_unified(el, level, other)
		_ => no
	}
	Numeral(value) => match b.shape {
		Numeral(other) => value == other
		_ => no
	}
	Free(id) => match b.shape {
		Free(other) => id == other
		_ => no
	}
	Constant(name, levels) => match b.shape {
		Constant(other, other_levels) => name == other and #levels == #other_levels and (1 .. #levels + 1).all(at => levels_unified(el, levels#at, other_levels#at))
		_ => no
	}
	Lambda(binder, domain, body) => match b.shape {
		Lambda(other_binder, other_domain, other_body) => bodies_unified(el, binder, domain, body, other_domain, other_body)
		_ => no
	}
	Pi(binder, domain, body) => match b.shape {
		Pi(other_binder, other_domain, other_body) => bodies_unified(el, binder, domain, body, other_domain, other_body)
		_ => no
	}
	Projection(structure, field, of) => match b.shape {
		Projection(other_structure, other_field, other_of) => field == other_field and unified(el, of, other_of)
		_ => no
	}
	Apply(function, argument) => match b.shape {
		Apply(other_function, other_argument) => {
			given = arguments(a)
			others = arguments(b)
			alike_made(el, head(a), head(b)) and #given == #others and (1 .. #given + 1).all(at => unified(el, given#at, others#at))
		}
		_ => no
	}
	_ => no
}
# two binders: domains made equal, then bodies under one fresh variable
bodies_unified(el: Elaboration, binder: text, domain: Term, body: Term, other_domain: Term, other_body: Term): bool := {
	if not unified(el, domain, other_domain) { return no }
	variable = hypothesis(el.c, binder, filled(el, domain))
	unified(el, instantiated(body, variable), instantiated(other_body, variable))
}

# A hole answered by a term: the term names neither the hole nor a binder gone into after the hole was made, and
# its type can be made the hole's type. Then the problems put off are tried again
answered(el: Elaboration, h: Hole, t: Term): bool := {
	value = filled(el, t)
	if holes_in(el, value).contains(h.id) or later_binder(el, value, h.id) { return no }
	el.answers[h.id] = value
	typed = try { unified(el, hypothesis_of(el.c, h.id).type, type_of(el.c, value)) } catch refusal { no }
	if not typed { return no }
	waiting = el.problems
	el.problems = []
	waiting.all(problem => unified(el, problem.left, problem.right))
}

# Whether two levels can be made equal: a level hole standing alone is answered by the other side, two successors
# by what they are above; levels that are equal whatever their holes are hold already; anything else is put off to
# the end of the declaration
levels_unified(el: Elaboration, a: Level, b: Level): bool := {
	left = level_filled(el, a)
	right = level_filled(el, b)
	if #level_holes_in(left) == 0 and #level_holes_in(right) == 0 { return levels_equal(left, right) }
	if level_answered(el, left, right) or level_answered(el, right, left) or levels_equal(left, right) { return yes }
	below_left = below(left)
	below_right = below(right)
	if below_left is not ø and below_right is not ø { return levels_unified(el, below_left, below_right) }
	el.level_problems += [LevelProblem(left, right)]
	yes
}
level_answered(el: Elaboration, hole: Level, value: Level): bool := match hole {
	Parameter(name) => {
		if not is_level_hole(name) or level_parameters(value).contains(name) { return no }
		el.level_answers[name] = value
		yes
	}
	_ => no
}
# the level a successor is above, ø for any other level
below(level: Level): Level? := match level {
	Successor(of) => of
	_ => ø
}
