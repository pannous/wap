# `wap verify program.wap` (notes/coc-plan.md P1, wiki/proof.md "Checking proofs"), run as `verify.wasm --seed <seed
# folder> program.wap` by the native wap or with `--tree <root>` (options.wap): the program elaborated as the
# elaborator's door reads it, a wrong proof refused there; then one verdict per law, theorem and axiom, in the order
# they are stated. Proved: its proof was checked; a proof that uses an axiom stays Proved and names the axioms it
# rests on. Assumed: it rests on an `assume`. Axiom: taken as true. A law
# without a proof is tried on small values (tested.wap): Tested when it held on each, FAILED with the values it broke
# on, Untested when it could be tried on none. The run fails when a law does.
use "file.wap"
use "read.wap"
use "../../../kernel/environment.wap"
use "tested.wap"

PROVED := "Proved"
RESTS_ON := ", rests on "
ASSUMED := "Assumed"
AXIOM := "Axiom"
UNTESTED := "Untested"
TESTED := "Tested"
FAILED := "FAILED, counterexample "
# a law without binders that computes to no
BROKEN := "FAILED"
FAILED_EXIT := 1

# the verdict of a statement the program made
verdict(p: Theory, name: text): text := {
	typed = p.typed_verdicts.get(name)
	if typed is not ø { return match typed! { Holds => PROVED; Breaks => BROKEN; Open => UNTESTED } }
	statement = p.unproved_laws.get(name)
	if statement is not ø {
		return match tried(checker(p.environment, []), statement!) {
			Held => TESTED
			Failed(counterexample) => FAILED + counterexample
			Undecided => UNTESTED
		}
	}
	resting = axioms_of(p.environment, constant_of(p.environment, name, []))
	if resting.any(axiom => axiom in p.assumed) { return ASSUMED }
	if name in resting then AXIOM else if resting is empty then PROVED else PROVED + RESTS_ON + resting.join(", ")
}

theory = Theory()
door_elaborated(theory, args)
verdicts = theory.stated.map(name => verdict(theory, name))
for at in 1 to #verdicts { print "${theory.labels.get(theory.stated#at) ?? theory.stated#at}: ${verdicts#at}" }
if verdicts.any(said => said.starts_with(BROKEN)) { exit(FAILED_EXIT) }
