# `wap verify program.wap` (notes/coc-plan.md P1, wiki/proof.md "Checking proofs"): the program elaborated as the
# elaborator's door reads it, a wrong proof refused there; then one verdict per law, theorem and axiom, in the order
# they are stated. Proved: its proof was checked. Assumed: it rests on an `assume`. Axiom: taken as true. A law
# without a proof is tried on small values (tested.wap): Tested when it held on each, FAILED with the values it broke
# on, Untested when it could be tried on none. The run fails when a law does.
use "../environment.wap"
use "read.wap"
use "file.wap"
use "tested.wap"

PROVED := "Proved"
ASSUMED := "Assumed"
AXIOM := "Axiom"
UNTESTED := "Untested"
TESTED := "Tested"
FAILED := "FAILED, counterexample "
FAILED_EXIT := 1

# the verdict of a statement the program made
verdict(p: Theory, name: text): text := {
	statement = p.unproved_laws.get(name)
	if statement is not ø {
		return match tried(checker(p.environment, []), statement!) {
			Held => TESTED
			Failed(counterexample) => FAILED + counterexample
			Undecided => UNTESTED
		}
	}
	resting = axioms_of(p.environment, name)
	if resting.any(axiom => axiom in p.assumed) { return ASSUMED }
	if name in resting then AXIOM else PROVED
}

theory = Theory()
file_elaborated(theory, args#1)
verdicts = theory.stated.map(name => verdict(theory, name))
for at in 1 to #verdicts { print "${theory.stated#at}: ${verdicts#at}" }
if verdicts.any(said => said.starts_with(FAILED)) { exit(FAILED_EXIT) }
