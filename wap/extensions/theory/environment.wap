# What the kernel holds while it checks (notes/coc-plan.md 6.6; this folder's files: notes/theory.md): the
# declarations accepted so far, the binders it is inside of, its step count, and the one way it refuses.

use "terms.wap"

# how many steps of computing a declaration's check may take before it is refused as "gave up": the same count on
# every machine
STEP_BUDGET := 10000000

# The rules a refusal names, in plain words: `refused by argument type: int is a Type, and box takes a Type(1)`. A
# test pins the rule, never the message after it
REFUSED := "refused by "
UNKNOWN_NAME := "unknown name"
LEVEL_COUNT := "level count"
LEVEL_PARAMETER := "level parameter"
NOT_A_FUNCTION := "not a function"
ARGUMENT_TYPE := "argument type"
NOT_A_TYPE := "not a type"
VALUE_TYPE := "value type"
NOT_A_PROPOSITION := "not a proposition"
NAME_TAKEN := "name taken"
NOT_CLOSED := "not closed"
GAVE_UP := "gave up"

refused(rule: text, found: text) := raise REFUSED + rule + ": " + found

# --- declarations

# What a declared name is: an axiom has its type alone; a definition and a theorem unfold to their value; an
# opaque constant's value was checked and is never read again
enum DeclarationKind {
	Axiom
	Defined(value: Term)
	Theorem(value: Term)
	Opaque(value: Term)
}
# A declaration: its name, the names of its level parameters, its type, and what it is
class Declaration { name: text; levels: list<text>; type: Term; kind: DeclarationKind }

# the value a use of the declaration unfolds to (6.4 delta), ø for one that never unfolds
unfolding(d: Declaration): Term? := match d.kind {
	Defined(value) => value
	Theorem(value) => value
	_ => ø
}

# The declarations accepted so far, and each one's place in the order of declaring, from 1: of two definitions the
# later one unfolds first (6.5)
class Environment {
	declarations: map<text, Declaration> = {}
	places: map<text, int> = {}
}
declaration(e: Environment, name: text): Declaration? := e.declarations.get(name)
place(e: Environment, name: text): int := e.places.get(name) ?? 0
# a declaration becomes part of the environment; typing.wap's `declared` checks it first and is the only caller
added(e: Environment, d: Declaration) := {
	e.places[d.name] = #e.places + 1
	e.declarations[d.name] = d
}

# --- the state of one check

# a binder the kernel is inside of: its name, for showing, and its type
class Hypothesis { binder: text; type: Term }
# a term and what a walk made of it, kept so the walk is not done again
class Kept { of: Term; result: Term }
# results by their term's hash; terms of one hash are told apart by `same`
class Memory { kept: map<int, list<Kept>> = {} }
remembered(memory: Memory, of: Term): Term? := {
	for kept in memory.kept.get(of.hash) ?? [] { if same(kept.of, of) { return kept.result } }
	ø
}
remember(memory: Memory, of: Term, result: Term) := {
	memory.kept[of.hash] = (memory.kept.get(of.hash) ?? []) + [Kept(of, result)]
}

# The state of the check of one declaration or one question: the environment, the declaration's level parameters,
# the binders gone into, the steps taken, and what compute.wap and typing.wap keep of closed terms
class Checker {
	environment: Environment
	levels: list<text> = []
	hypotheses: list<Hypothesis> = []
	steps: int = 0
	budget: int = STEP_BUDGET
	heads: Memory = Memory()
	types: Memory = Memory()
}
checker(e: Environment, levels: list<text>): Checker := Checker(e, levels)

# The free variable of a binder the kernel goes into (terms.wap: locally nameless): `(x: A) => b` is checked as
# `instantiated(b, hypothesis(c, "x", A))`
hypothesis(c: Checker, binder: text, type: Term): Term := {
	c.hypotheses += [Hypothesis(binder, type)]
	free(#c.hypotheses)
}
# the type and the name of a free variable the checker made
hypothesis_of(c: Checker, id: int): Hypothesis := c.hypotheses#id

# One step of computing counted; past the budget the check gave up, which is a refusal, never an acceptance
stepped(c: Checker) := {
	c.steps += 1
	if c.steps > c.budget { refused(GAVE_UP, "the check took more than ${c.budget} steps") }
}
