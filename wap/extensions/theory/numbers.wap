# Numbers in the theory (notes/coc-plan.md 6.7; this folder's files: notes/theory.md). A number literal is a natural
# number without bound, a short way to write `successor(… zero)`, and seven shortcuts compute arithmetic on two
# literals at once. The numbers declaration binds each shortcut to a library function by naming the theorems that fix
# that function on every literal; the kernel itself names no library word.

use magnitude
use "terms.wap"

# the seven shortcuts; each is fixed on every literal by its equations (6.7)
enum Shortcut { Add, Subtract, Multiply, Divide, Remainder, Equal, AtMost }

# What the numbers declaration bound: the number type's two cases, the truth values' yes and no, and the shortcut each
# switched-on function stands for
class Numbers { zero: text; successor: text; yes_case: text; no_case: text; shortcuts: map<text, Shortcut> = {} }

# a shortcut on two numbers: a number, or for a comparison a truth value. Subtracting past zero gives zero, dividing
# by zero gives zero and the remainder is then the number itself, as the equations fix them
shortcut_value(n: Numbers, shortcut: Shortcut, a: Magnitude, b: Magnitude): Term := match shortcut {
	Add => numeral(sum(a, b))
	Subtract => numeral(if compared(a, b) <= 0 then ZERO else difference(a, b))
	Multiply => numeral(product(a, b))
	Divide => numeral(if is_zero(b) then ZERO else divided(a, b).quotient)
	Remainder => numeral(if is_zero(b) then a else divided(a, b).rest)
	Equal => truth(n, compared(a, b) == 0)
	AtMost => truth(n, compared(a, b) <= 0)
}
truth(n: Numbers, holds: bool): Term := constant(if holds then n.yes_case else n.no_case, [])

# the number a literal holds, ø for any other term
literal(t: Term): Magnitude? := match t.shape {
	Numeral(value) => value
	_ => ø
}

# what a shortcut makes of t: ø unless t is a switched-on function applied to exactly two literals
shortcut_fired(n: Numbers, t: Term): Term? := {
	given = arguments(t)
	if #given != 2 { return ø }
	shortcut = match head(t).shape {
		Constant(name, levels) => n.shortcuts.get(name) ?? return ø
		_ => return ø
	}
	a = literal(given#1) ?? return ø
	b = literal(given#2) ?? return ø
	shortcut_value(n, shortcut, a, b)
}

# a literal where a rule asks for a case of the number type: zero, or the successor of the number before it (6.4)
opened(n: Numbers, value: Magnitude): Term := if is_zero(value) then constant(n.zero, []) else apply(constant(n.successor, []), numeral(difference(value, ONE)))
