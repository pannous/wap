# The theory doors' arguments (notes/theory.md "The door"): `--tree <root>`, the wap tree a door reads its prelude
# from, wherever it stands, and the program; anything else is refused with the usage
TREE_OPTION := "--tree"
NO_TREE := "the theory needs ${TREE_OPTION} <wap tree>"
class DoorArguments { tree: text; program: text }
door_arguments(given: list<text>): DoorArguments := {
	at = (1 to #given).find(place => given#place == TREE_OPTION)
	if at is ø or at! == #given { raise NO_TREE }
	rest = given.take(at! - 1) + given.drop(at! + 1)
	if #rest != 1 { raise "a theory door takes one program besides ${TREE_OPTION} <wap tree>, not: ${rest.join(" ")}" }
	DoorArguments(given#(at! + 1), rest#1)
}
