# The theory doors' arguments (notes/theory.md "The door"): the wap folder a door reads its prelude from, given as
# `--tree <root>`, a wap tree whose wap/ it is, or `--seed <folder>`, a seed folder, which holds the same; wherever it
# stands; and the program. Anything else is refused with the usage
use "../../core/pipeline.wap"

TREE_OPTION := "--tree"
SEED_OPTION := "--seed"
# the folder of wap's sources under the folder an option names
WAP_IN_TREE := "wap"
NO_TREE := "the theory needs ${TREE_OPTION} <wap tree> or ${SEED_OPTION} <seed folder>"
class DoorArguments { wap_folder: text; program: text }
door_arguments(given: list<text>): DoorArguments := {
	at = (1 to #given).find(place => given#place == TREE_OPTION or given#place == SEED_OPTION)
	if at is ø or at! == #given { raise NO_TREE }
	rest = given.take(at! - 1) + given.drop(at! + 1)
	if #rest != 1 { raise "a theory door takes one program besides ${TREE_OPTION} <wap tree>, not: ${rest.join(" ")}" }
	folder = given#(at! + 1)
	DoorArguments(if given#at! == TREE_OPTION then in_folder(folder, WAP_IN_TREE) else folder, rest#1)
}
