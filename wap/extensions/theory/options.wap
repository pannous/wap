# The theory doors' arguments (notes/theory.md "The door"): `--tree <root>`, the wap tree a door reads its prelude
# from, then the program; anything else is refused with the usage
TREE_OPTION := "--tree"
class DoorArguments { tree: text?; program: text }
door_arguments(given: list<text>): DoorArguments := {
	if #given == 1 { return DoorArguments(ø, given#1) }
	if #given == 3 and given#1 == TREE_OPTION { return DoorArguments(given#2, given#3) }
	raise "a theory door takes a program, after ${TREE_OPTION} <root> where it reads a prelude, not: ${given.join(" ")}"
}
