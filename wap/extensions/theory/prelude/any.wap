# A data node (wiki/node.md), what `any` holds: a value of each of the prelude's types becomes one where an any is
# wanted, its lists nested under list. An explicit program read after data.wap by the theory's door, each conversion
# an overload of `convert`.

enum any: Type { empty: any, truth(b: bool): any, number(n: int): any, words(t: text): any, items(xs: list[1](any)): any }

convert(o: Unit[1]): any := any.empty
convert(b: bool): any := any.truth(b)
convert(n: nat): any := any.number(int.of_nat(n))
convert(n: int): any := any.number(n)
convert(t: text): any := any.words(t)
convert(xs: list[1](any)): any := any.items(xs)
