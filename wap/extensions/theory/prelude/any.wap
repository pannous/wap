# A data node (wiki/node.md), what `any` holds: a value of each of the prelude's types becomes one where an any is
# wanted, its lists nested under list. Read by the elaborator after the explicit files (elaborate/file.wap), so each
# conversion is an overload of `convert`.

enum any { empty, truth(b: bool), number(n: int), words(t: text), items(xs: list(any)) }

convert(o: Unit[1]): any := any.empty
convert(b: bool): any := any.truth(b)
convert(n: nat): any := any.number(int.of_nat(n))
convert(n: int): any := any.number(n)
convert(t: text): any := any.words(t)
convert(xs: list(any)): any := any.items(xs)
