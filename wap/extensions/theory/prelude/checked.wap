# wap's checked types as an explicit program for the theory's door: rationals, wrapping integers, sets and maps, each
# a plain carrier with a condition on it (a subset) or with values it joins (a quotient). Read after logic.wap,
# numbers.wap, data.wap and quotient.wap, whose int, list, Pair and quotient it names (notes/coc-plan.md 3.6, L5). At
# the switch they move into wap/types, where `T where p` writes Subset(T, p) and `{a, b}` a set.
# Run: wap wap/extensions/theory/check.wap <logic.wap, numbers.wap, data.wap, quotient.wap and this file, joined>

# a value with a proof that the condition holds of it, what `T where p` writes
enum Subset(T: Sort(u), p: T -> Prop): Sort(max(1, u)) { intro(value: T, holds: p(value)): Subset(T, p) }

# a fraction: an integer over one that is not zero, the condition a test whose answer is no
nonzero(x: int): Prop := Equal[1](bool, is_zero(size(x)), bool.no)
enum fraction: Type { over(top: int, bottom: Subset[1](int, nonzero)): fraction }
top(f: fraction): int := projection(fraction, 1, f)
bottom(f: fraction): int := projection(Subset, 1, projection(fraction, 2, f))
# two fractions of one value, 1/2 and 2/4: crossed, their products agree
same_value(a: fraction, b: fraction): Prop := Equal[1](int, times(top(a), bottom(b)), times(top(b), bottom(a)))
# the rationals: fractions of one value are one rational, so a law cannot tell 1/2 from 2/4
rational: Type := quotient[1](fraction, same_value)

# the wrapping integers: integers 2^64 apart are one i64, so the largest plus one is the smallest
wrap: int := times(int.of_nat(4294967296), int.of_nat(4294967296))
wrapped_alike(a: int, b: int): Prop := Exists[1](int, (k: int) => Equal[1](int, sum(a, minus(b)), times(wrap, k)))
i64: Type := quotient[1](int, wrapped_alike)

# x is one of the items: a condition rather than a test, so T needs no equality
member(T: Sort(u), x: T, xs: list[u](T)): Prop :=
	list.recursor[1, u](T, (ys: list[u](T)) => Prop, False, (y: T) => (rest: list[u](T)) => (r: Prop) => Or(Equal[u](T, x, y), r), xs)
# two lists with the same members, in whatever order and however often
same_members(T: Sort(u), a: list[u](T), b: list[u](T)): Prop :=
	(x: T) -> And(member[u](T, x, a) -> member[u](T, x, b), member[u](T, x, b) -> member[u](T, x, a))
# a set: lists with the same members are one set
set(T: Sort(u)): Sort(max(1, u)) := quotient[max(1, u)](list[u](T), same_members[u](T))

# the first two of three alternatives the other way round, so two items swapped keep their members
law or_front_swapped(a: Prop, b: Prop, c: Prop, h: Or(a, Or(b, c))): Or(b, Or(a, c)) :=
	Or.recursor(a, Or(b, c), (x: Or(a, Or(b, c))) => Or(b, Or(a, c)),
		(ha: a) => Or.right(b, Or(a, c), Or.left(a, c, ha)),
		(hbc: Or(b, c)) => Or.recursor(b, c, (y: Or(b, c)) => Or(b, Or(a, c)),
			(hb: b) => Or.left(b, Or(a, c), hb),
			(hc: c) => Or.right(b, Or(a, c), Or.right(a, c, hc)), hbc), h)
law front_swapped_members(T: Sort(u), x: T, y: T, rest: list[u](T)): same_members[u](T, list.item[u](T, x, list.item[u](T, y, rest)), list.item[u](T, y, list.item[u](T, x, rest))) :=
	(z: T) => And.intro(
		member[u](T, z, list.item[u](T, x, list.item[u](T, y, rest))) -> member[u](T, z, list.item[u](T, y, list.item[u](T, x, rest))),
		member[u](T, z, list.item[u](T, y, list.item[u](T, x, rest))) -> member[u](T, z, list.item[u](T, x, list.item[u](T, y, rest))),
		(h: member[u](T, z, list.item[u](T, x, list.item[u](T, y, rest)))) => or_front_swapped(Equal[u](T, z, x), Equal[u](T, z, y), member[u](T, z, rest), h),
		(h: member[u](T, z, list.item[u](T, y, list.item[u](T, x, rest)))) => or_front_swapped(Equal[u](T, z, y), Equal[u](T, z, x), member[u](T, z, rest), h))

# a map's plain carrier, its entries: what a type that holds maps of itself is made of
entries(K: Sort(u), V: Sort(v)): Sort(max(1, max(u, v))) := list[max(1, max(u, v))](Pair[u, v](K, V))
keys(K: Sort(u), V: Sort(v), xs: entries[u, v](K, V)): list[u](K) :=
	mapped[max(1, max(u, v)), u](Pair[u, v](K, V), K, (p: Pair[u, v](K, V)) => projection(Pair, 1, p), xs)
# no item twice
distinct(T: Sort(u), xs: list[u](T)): Prop :=
	list.recursor[1, u](T, (ys: list[u](T)) => Prop, True, (y: T) => (rest: list[u](T)) => (r: Prop) => And(Not(member[u](T, y, rest)), r), xs)
# a map: entries with distinct keys, and entries with the same members are one map
keyed(K: Sort(u), V: Sort(v)): Sort(max(1, max(u, v))) := Subset[max(1, max(u, v))](entries[u, v](K, V), (xs: entries[u, v](K, V)) => distinct[u](K, keys[u, v](K, V, xs)))
same_entries(K: Sort(u), V: Sort(v), a: keyed[u, v](K, V), b: keyed[u, v](K, V)): Prop :=
	same_members[max(1, max(u, v))](Pair[u, v](K, V), projection(Subset, 1, a), projection(Subset, 1, b))
map(K: Sort(u), V: Sort(v)): Sort(max(1, max(u, v))) := quotient[max(1, max(u, v))](keyed[u, v](K, V), same_entries[u, v](K, V))

# a character: a text of one code point, what `char` writes (`text where #it == 1`), so a char is a text wherever one
# is wanted
one_point(t: text): Prop := Equal[1](nat, count[1](nat, points(t)), 1)
char: Type := Subset[1](text, one_point)
