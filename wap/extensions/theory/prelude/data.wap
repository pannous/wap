# wap's lists and optional values as an explicit program for the theory's door, read after logic.wap and numbers.wap,
# whose Pair, Equal, equal_congruent and nat it names (notes/coc-plan.md L3). At the switch they move into wap/types,
# where `[a, b]` writes a list and `T?` an optional value.
# Run: wap wap/extensions/theory/check.wap <logic.wap, numbers.wap and this file, one after the other>

# a list: empty, or an item before a list
enum list(T: Sort(u)): Sort(max(1, u)) { empty: list(T), item(first: T, rest: list(T)): list(T) }
runs(list, list<T>)
runs(list.empty, [], when: #it == 0)
runs(list.item, [first] + rest, when: #it > 0, first: it#1, rest: drop(it, 1))

# how many items a list holds, what `#xs` writes
count(T: Sort(u), xs: list[u](T)): nat :=
	list.recursor[1, u](T, (ys: list[u](T)) => nat, nat.zero, (x: T) => (rest: list[u](T)) => (n: nat) => nat.successor(n), xs)
runs(count, #xs)

# that a place, counted from 1, holds an item of a list
placed(T: Sort(u), ys: list[u](T), i: nat): Prop := Equal[1](bool, both(at_most(1, i), at_most(i, count[u](T, ys))), bool.yes)
# what a place holds of the empty list, from the proof that no is yes
no_case(T: Sort(u)): Equal[1](bool, bool.no, bool.yes) -> T := (h: Equal[1](bool, bool.no, bool.yes)) => false_elim[u](T, no_is_not_yes(h))
# the item at a place of a list that holds one there, what `xs#i` writes: the place first taken apart from the empty
# list, which holds none, then the item's first place from the rest's
item_at(T: Sort(u), xs: list[u](T)): (i: nat) -> placed[u](T, xs, i) -> T :=
	list.recursor[imax(1, u), u](T, (ys: list[u](T)) => (i: nat) -> placed[u](T, ys, i) -> T,
		(i: nat) => nat.recursor[u]((k: nat) => placed[u](T, list.empty[u](T), k) -> T,
			no_case[u](T),
			(k: nat) => (r: placed[u](T, list.empty[u](T), k) -> T) => no_case[u](T), i),
		(x: T) => (rest: list[u](T)) => (later: (i: nat) -> placed[u](T, rest, i) -> T) => (i: nat) =>
			nat.recursor[u]((k: nat) => placed[u](T, list.item[u](T, x, rest), k) -> T,
				no_case[u](T),
				(k: nat) => (r: placed[u](T, list.item[u](T, x, rest), k) -> T) =>
					nat.recursor[u]((j: nat) => Equal[1](bool, at_most(j, count[u](T, rest)), bool.yes) -> T,
						(h: Equal[1](bool, at_most(nat.zero, count[u](T, rest)), bool.yes)) => x,
						(j: nat) => (s: Equal[1](bool, at_most(j, count[u](T, rest)), bool.yes) -> T) => (h: Equal[1](bool, at_most(nat.successor(j), count[u](T, rest)), bool.yes)) => later(nat.successor(j))(h), k), i), xs)
runs(item_at, xs#i)
# the items after the first n, what `drop(xs, n)` writes
drop(T: Sort(u), xs: list[u](T), n: nat): list[u](T) :=
	nat.recursor[max(1, u)]((k: nat) => list[u](T), xs,
		(k: nat) => (earlier: list[u](T)) => list.recursor[max(1, u), u](T, (ys: list[u](T)) => list[u](T), list.empty[u](T),
			(x: T) => (rest: list[u](T)) => (later: list[u](T)) => rest, earlier), n)
runs(drop, drop(xs, n))

# the items of xs and then those of ys, what `xs + ys` writes
joined(T: Sort(u), xs: list[u](T), ys: list[u](T)): list[u](T) :=
	list.recursor[max(1, u), u](T, (zs: list[u](T)) => list[u](T), ys,
		(x: T) => (rest: list[u](T)) => (tail: list[u](T)) => list.item[u](T, x, tail), xs)
runs(joined, xs + ys)

# f applied to each item, what `xs.map(f)` writes
mapped(A: Sort(u), B: Sort(v), f: A -> B, xs: list[u](A)): list[v](B) :=
	list.recursor[max(1, v), u](A, (zs: list[u](A)) => list[v](B), list.empty[v](B),
		(x: A) => (rest: list[u](A)) => (tail: list[v](B)) => list.item[v](B, f(x), tail), xs)
runs(mapped, xs.map(f))

# the first laws of lists: the empty list joins without a trace on either side, and mapping keeps the count
law joined_empty(T: Sort(u), ys: list[u](T)): Equal[max(1, u)](list[u](T), joined[u](T, list.empty[u](T), ys), ys) :=
	Equal.refl[max(1, u)](list[u](T), ys)
law joined_to_empty(T: Sort(u), xs: list[u](T)): Equal[max(1, u)](list[u](T), joined[u](T, xs, list.empty[u](T)), xs) :=
	list.recursor[0, u](T, (zs: list[u](T)) => Equal[max(1, u)](list[u](T), joined[u](T, zs, list.empty[u](T)), zs),
		Equal.refl[max(1, u)](list[u](T), list.empty[u](T)),
		(x: T) => (rest: list[u](T)) => (h: Equal[max(1, u)](list[u](T), joined[u](T, rest, list.empty[u](T)), rest)) =>
			equal_congruent[max(1, u), max(1, u)](list[u](T), list[u](T), (zs: list[u](T)) => list.item[u](T, x, zs),
				joined[u](T, rest, list.empty[u](T)), rest, h), xs)
law count_mapped(A: Sort(u), B: Sort(v), f: A -> B, xs: list[u](A)): Equal[1](nat, count[v](B, mapped[u, v](A, B, f, xs)), count[u](A, xs)) :=
	list.recursor[0, u](A, (zs: list[u](A)) => Equal[1](nat, count[v](B, mapped[u, v](A, B, f, zs)), count[u](A, zs)),
		Equal.refl[1](nat, nat.zero),
		(x: A) => (rest: list[u](A)) => (h: Equal[1](nat, count[v](B, mapped[u, v](A, B, f, rest)), count[u](A, rest))) =>
			equal_congruent[1, 1](nat, nat, nat.successor, count[v](B, mapped[u, v](A, B, f, rest)), count[u](A, rest), h), xs)

# an optional value, what `T?` writes: a value, or nothing, the Unit part of the union `T or ø`
optional(T: Sort(u)): Sort(max(1, u)) := Sum[u, u](T, Unit[u])
# a value present, and the value missing
present(T: Sort(u), value: T): optional[u](T) := Sum.left[u, u](T, Unit[u], value)
missing(T: Sort(u)): optional[u](T) := Sum.right[u, u](T, Unit[u], Unit.unit[u])

# the value, or the fallback when it is missing, what `x ?? fallback` writes
or_else(T: Sort(u), x: optional[u](T), fallback: T): T :=
	Sum.recursor[u, u, u](T, Unit[u], (o: optional[u](T)) => T, (value: T) => value, (nothing: Unit[u]) => fallback, x)
law or_else_present(T: Sort(u), value: T, fallback: T): Equal[u](T, or_else[u](T, present[u](T, value), fallback), value) :=
	Equal.refl[u](T, value)
law or_else_missing(T: Sort(u), fallback: T): Equal[u](T, or_else[u](T, missing[u](T), fallback), fallback) :=
	Equal.refl[u](T, fallback)

# a value with a proof that the condition holds of it, what `T where p` writes: a class whose proof is a field
enum Subset(T: Sort(u), p: T -> Prop): Sort(max(1, u)) { intro(value: T, proof: p(value)): Subset(T, p) }
runs(Subset, T)
runs(Subset.intro, value, when: yes, value: it)
# the values of a type that meet a condition, `T where p`: what a list's where is for its items, a type's is for its values
where(T: Sort(u), p: T -> Prop): Sort(max(1, u)) := Subset[u](T, p)
# a value of a subset is a value of its parent, put in wherever the parent is wanted
convert(T: Sort(u), p: T -> Prop, s: Subset[u](T, p)): T := projection(Subset, 1, s)

# a pair's two values the other way round, and swapping twice gives the pair back
swapped(A: Sort(u), B: Sort(v), p: Pair[u, v](A, B)): Pair[v, u](B, A) :=
	Pair.recursor[max(1, max(u, v)), u, v](A, B, (q: Pair[u, v](A, B)) => Pair[v, u](B, A),
		(a: A) => (b: B) => Pair.intro[v, u](B, A, b, a), p)
law swapped_twice(A: Sort(u), B: Sort(v), p: Pair[u, v](A, B)): Equal[max(1, max(u, v))](Pair[u, v](A, B), swapped[v, u](B, A, swapped[u, v](A, B, p)), p) :=
	Pair.recursor[0, u, v](A, B, (q: Pair[u, v](A, B)) => Equal[max(1, max(u, v))](Pair[u, v](A, B), swapped[v, u](B, A, swapped[u, v](A, B, q)), q),
		(a: A) => (b: B) => Equal.refl[max(1, max(u, v))](Pair[u, v](A, B), Pair.intro[u, v](A, B, a, b)), p)

# a text: its code points, what "…" writes; a text literal is text_of applied to the list of its code points (the
# texts statement)
enum text: Type { of_points(points: list[1](nat)): text }
points(t: text): list[1](nat) := projection(text, 1, t)
text_of(points: list[1](nat)): text := text.of_points(points)
texts(text_of, list.empty, list.item)
