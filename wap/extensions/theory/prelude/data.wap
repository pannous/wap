# wap's lists and optional values as an explicit program for the theory's door, read after logic.wap and numbers.wap,
# whose Pair, Equal, equal_congruent and nat it names (notes/coc-plan.md L3). At the switch they move into wap/types,
# where `[a, b]` writes a list and `T?` an optional value.
# Run: wap wap/extensions/theory/check.wap <logic.wap, numbers.wap and this file, one after the other>

# a list: empty, or an item before a list
enum list(T: Sort(u)): Sort(max(1, u)) { empty: list(T), item(first: T, rest: list(T)): list(T) }

# how many items a list holds, what `#xs` writes
count(T: Sort(u), xs: list[u](T)): nat :=
	list.recursor[1, u](T, (ys: list[u](T)) => nat, nat.zero, (x: T) => (rest: list[u](T)) => (n: nat) => nat.successor(n), xs)

# the items of xs and then those of ys, what `xs + ys` writes
joined(T: Sort(u), xs: list[u](T), ys: list[u](T)): list[u](T) :=
	list.recursor[max(1, u), u](T, (zs: list[u](T)) => list[u](T), ys,
		(x: T) => (rest: list[u](T)) => (tail: list[u](T)) => list.item[u](T, x, tail), xs)

# f applied to each item, what `xs.map(f)` writes
mapped(A: Sort(u), B: Sort(v), f: A -> B, xs: list[u](A)): list[v](B) :=
	list.recursor[max(1, v), u](A, (zs: list[u](A)) => list[v](B), list.empty[v](B),
		(x: A) => (rest: list[u](A)) => (tail: list[v](B)) => list.item[v](B, f(x), tail), xs)

# the first laws of lists: the empty list joins without a trace on either side, and mapping keeps the count
law joined_empty(T: Sort(u), ys: list[u](T)): Equal[max(1, u)](list[u](T), joined[u](T, list.empty[u](T), ys), ys) :=
	Equal.refl[max(1, u)](list[u](T), ys)
law joined_to_empty(T: Sort(u), xs: list[u](T)): Equal[max(1, u)](list[u](T), joined[u](T, xs, list.empty[u](T)), xs) :=
	list.recursor[0, u](T, (zs: list[u](T)) => Equal[max(1, u)](list[u](T), joined[u](T, zs, list.empty[u](T)), zs),
		Equal.refl[max(1, u)](list[u](T), list.empty[u](T)),
		(x: T) => (rest: list[u](T)) => (h: Equal[max(1, u)](list[u](T), joined[u](T, rest, list.empty[u](T)), rest)) =>
			equal_congruent[max(1, u), max(1, u)](list[u](T), list[u](T), (zs: list[u](T)) => list.item[u](T, x, zs),
				joined[u](T, rest, list.empty[u](T)), rest, h), xs)
law count_mapped(A: Sort(u), B: Sort(v), f: A -> B, xs: list[u](A)): Equal[1](nat, count[v](B, mapped[u, v](A, B, f, xs)), count[u](A, xs)) :=
	list.recursor[0, u](A, (zs: list[u](A)) => Equal[1](nat, count[v](B, mapped[u, v](A, B, f, zs)), count[u](A, zs)),
		Equal.refl[1](nat, nat.zero),
		(x: A) => (rest: list[u](A)) => (h: Equal[1](nat, count[v](B, mapped[u, v](A, B, f, rest)), count[u](A, rest))) =>
			equal_congruent[1, 1](nat, nat, nat.successor, count[v](B, mapped[u, v](A, B, f, rest)), count[u](A, rest), h), xs)

# an optional value: missing, or a value present, what `T?` writes
enum optional(T: Sort(u)): Sort(max(1, u)) { missing: optional(T), present(value: T): optional(T) }

# the value, or the fallback when it is missing, what `x ?? fallback` writes
or_else(T: Sort(u), x: optional[u](T), fallback: T): T :=
	optional.recursor[u, u](T, (o: optional[u](T)) => T, fallback, (value: T) => value, x)
law or_else_present(T: Sort(u), value: T, fallback: T): Equal[u](T, or_else[u](T, optional.present[u](T, value), fallback), value) :=
	Equal.refl[u](T, value)
law or_else_missing(T: Sort(u), fallback: T): Equal[u](T, or_else[u](T, optional.missing[u](T), fallback), fallback) :=
	Equal.refl[u](T, fallback)

# a pair's two values the other way round, and swapping twice gives the pair back
swapped(A: Sort(u), B: Sort(v), p: Pair[u, v](A, B)): Pair[v, u](B, A) :=
	Pair.recursor[max(1, max(u, v)), u, v](A, B, (q: Pair[u, v](A, B)) => Pair[v, u](B, A),
		(a: A) => (b: B) => Pair.intro[v, u](B, A, b, a), p)
law swapped_twice(A: Sort(u), B: Sort(v), p: Pair[u, v](A, B)): Equal[max(1, max(u, v))](Pair[u, v](A, B), swapped[v, u](B, A, swapped[u, v](A, B, p)), p) :=
	Pair.recursor[0, u, v](A, B, (q: Pair[u, v](A, B)) => Equal[max(1, max(u, v))](Pair[u, v](A, B), swapped[v, u](B, A, swapped[u, v](A, B, q)), q),
		(a: A) => (b: B) => Equal.refl[max(1, max(u, v))](Pair[u, v](A, B), Pair.intro[u, v](A, B, a, b)), p)
