# wap's effects and computation types as an explicit program for the theory's door, read after logic.wap, whose bool
# and Unit it names (notes/coc-plan.md 9.2, L4). At the switch they move into wap/types, where `T ! IO` writes
# Eff(IO, T) and `T or Error` a value that may have failed (wiki/effects.md).
# Run: wap wap/extensions/theory/check.wap <logic.wap and this file, one after the other>

# what a computation may do beyond computing a value, a yes or no for each effect: an effect set's one written form,
# so two spellings of one set are one type. Allocation is no effect here: building a value is pure.
enum Effects: Type { set(io: bool, state: bool, fail: bool, div: bool, ffi: bool, async: bool, eval: bool, unsafe: bool): Effects }
pure_effects: Effects := Effects.set(bool.no, bool.no, bool.no, bool.no, bool.no, bool.no, bool.no, bool.no)

# a type with a member of it: what each computation type is made of
enum Inhabited: Type(u + 1) { intro(carrier: Type(u), member: carrier): Inhabited }

# The one opaque constant of the effects: at each effect set and type, the type of its computations and the
# computation that never returns. Its value is never unfolded, so what it is built from is nothing a program can see
# or prove anything of: no world to build, compare or use twice, and no axiom.
opaque computations(e: Effects, T: Type(u)): Inhabited[u] := Inhabited.intro[u](Unit[u + 1], Unit.unit[u + 1])
# `T ! e`: the computations that have the effects e and give a T
Eff(e: Effects, T: Type(u)): Type(u) := projection(Inhabited, 1, computations[u](e, T))
# the computation that never returns: every computation type has it, so a host operation needs no axiom
never(e: Effects, T: Type(u)): Eff[u](e, T) := projection(Inhabited, 2, computations[u](e, T))

# a computation of a value, and one run with its value handed to the next: all the theory knows of computations.
# A computation's value is used only inside another computation, so a pure term never runs one.
opaque pure(e: Effects, T: Type(u), x: T): Eff[u](e, T) := never[u](e, T)
opaque bind(e: Effects, A: Type(u), B: Type(v), c: Eff[u](e, A), next: A -> Eff[v](e, B)): Eff[v](e, B) := never[v](e, B)

# what a failed function gives, a host type like a file; and a value that may have failed, `T or Error`: a function
# that may raise (Fail) is a definition into it, and `try` is its match
opaque Error: Type := Unit[1]
enum Fallible(T: Sort(u)): Sort(max(1, u)) { value(v: T): Fallible(T), failed(e: Error): Fallible(T) }
