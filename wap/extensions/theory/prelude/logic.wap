# wap's logic as an explicit program for the theory's door (notes/theory.md "The explicit spellings"): every argument
# and every level written, nothing found. At the switch it moves into wap/types, where the operators `and`, `or`,
# `not`, `exists` and `==` write these types (notes/coc-plan.md 3.5, wiki/proposition.md).
# Run: wap wap/extensions/theory/check.wap wap/extensions/theory/prelude/logic.wap

# the proposition with no proof, and the one with exactly one
enum False: Prop {}
enum True: Prop { intro: True }

enum And(a: Prop, b: Prop): Prop { intro(left: a, right: b): And(a, b) }
enum Or(a: Prop, b: Prop): Prop { left(h: a): Or(a, b), right(h: b): Or(a, b) }
Not(a: Prop): Prop := a -> False

# equality: a is a parameter, the second place an index; refl is its one proof
enum Equal(T: Sort(u), a: T): T -> Prop { refl: Equal(T, a, a) }
enum Exists(T: Sort(u), p: T -> Prop): Prop { intro(w: T, h: p(w)): Exists(T, p) }

enum bool: Type { no: bool, yes: bool }
runs(bool, bool)
runs(bool.no, no, when: prim i32.eqz(it))
runs(bool.yes, yes, when: it)
# a proposition decided: data that says which way it holds, with the proof
enum Decidable(p: Prop): Type { is_false(h: Not(p)): Decidable(p), is_true(h: p): Decidable(p) }

# Pair, two values of any two types, and Unit, the one value, are core's (core/analyze/courses.wap): what the values
# below a value are made of, so a recursion may call itself on any of them
# a value of one of two types, what `A or B` of two types writes
enum Sum(A: Sort(u), B: Sort(v)): Sort(max(1, max(u, v))) { left(a: A): Sum(A, B), right(b: B): Sum(A, B) }

# two propositions that imply each other are equal (notes/coc-plan.md 13.2: one of the prelude's two axioms)
axiom proposition_extensionality(a: Prop, b: Prop, ab: a -> b, ba: b -> a): Equal[1](Prop, a, b)

# the first laws, each proved by a recursor: what every match and every proof by cases is made of
# from no proof, anything: a definition, since c may be data
false_elim(c: Sort(u), h: False): c := False.recursor[u]((x: False) => c, h)
law true_intro: True := True.intro
law and_left(a: Prop, b: Prop, h: And(a, b)): a :=
	And.recursor[0](a, b, (x: And(a, b)) => a, (l: a) => (r: b) => l, h)
law and_swap(a: Prop, b: Prop, h: And(a, b)): And(b, a) :=
	And.recursor[0](a, b, (x: And(a, b)) => And(b, a), (l: a) => (r: b) => And.intro(b, a, r, l), h)
law or_swap(a: Prop, b: Prop, h: Or(a, b)): Or(b, a) :=
	Or.recursor(a, b, (x: Or(a, b)) => Or(b, a), (l: a) => Or.right(b, a, l), (r: b) => Or.left(b, a, r), h)
law not_not_intro(a: Prop, h: a): Not(Not(a)) := (n: Not(a)) => n(h)
law not_false: Not(False) := (h: False) => h

law equal_symmetric(T: Sort(u), a: T, b: T, h: Equal[u](T, a, b)): Equal[u](T, b, a) :=
	Equal.recursor[0, u](T, a, (y: T) => (e: Equal[u](T, a, y)) => Equal[u](T, y, a), Equal.refl[u](T, a), b, h)
law equal_transitive(T: Sort(u), a: T, b: T, c: T, ab: Equal[u](T, a, b), bc: Equal[u](T, b, c)): Equal[u](T, a, c) :=
	Equal.recursor[0, u](T, b, (y: T) => (e: Equal[u](T, b, y)) => Equal[u](T, a, y), ab, c, bc)
law equal_congruent(A: Sort(u), B: Sort(v), f: A -> B, a: A, b: A, h: Equal[u](A, a, b)): Equal[v](B, f(a), f(b)) :=
	Equal.recursor[0, u](A, a, (y: A) => (e: Equal[u](A, a, y)) => Equal[v](B, f(a), f(y)), Equal.refl[v](B, f(a)), b, h)
law no_is_not_yes(h: Equal[1](bool, bool.no, bool.yes)): False :=
	Equal.recursor[0, 1](bool, bool.no, (y: bool) => (e: Equal[1](bool, bool.no, y)) => bool.recursor[1]((t: bool) => Prop, True, False, y), True.intro, bool.yes, h)
# a choice by a truth value whose part at no is false (`a and b` of propositions) holds only at yes: the truth value is
# yes, and the part at yes holds
law chosen_decided(a: bool, b: Prop, h: bool.recursor[1]((s: bool) => Prop, Equal[1](bool, bool.no, bool.yes), b, a)): Equal[1](bool, a, bool.yes) :=
	bool.recursor[0]((t: bool) => bool.recursor[1]((s: bool) => Prop, Equal[1](bool, bool.no, bool.yes), b, t) -> Equal[1](bool, t, bool.yes), (g: Equal[1](bool, bool.no, bool.yes)) => g, (g: b) => Equal.refl[1](bool, bool.yes), a)(h)
law chosen_at_yes(a: bool, b: Prop, h: bool.recursor[1]((s: bool) => Prop, Equal[1](bool, bool.no, bool.yes), b, a)): b :=
	bool.recursor[0]((t: bool) => bool.recursor[1]((s: bool) => Prop, Equal[1](bool, bool.no, bool.yes), b, t) -> b, (g: Equal[1](bool, bool.no, bool.yes)) => false_elim[0](b, no_is_not_yes(g)), (g: b) => g, a)(h)

law exists_yes: Exists[1](bool, (x: bool) => Equal[1](bool, x, bool.yes)) :=
	Exists.intro[1](bool, (x: bool) => Equal[1](bool, x, bool.yes), bool.yes, Equal.refl[1](bool, bool.yes))

# bool's own words, and a decision turned into a bool
negated(x: bool): bool := bool.recursor[1]((y: bool) => bool, bool.yes, bool.no, x)
runs(negated, prim i32.eqz(x))
both(x: bool, y: bool): bool := bool.recursor[1]((z: bool) => bool, bool.no, y, x)
decide(p: Prop, d: Decidable(p)): bool :=
	Decidable.recursor[1](p, (x: Decidable(p)) => bool, (h: Not(p)) => bool.no, (h: p) => bool.yes, d)
true_decided: Decidable(True) := Decidable.is_true(True, True.intro)
false_decided: Decidable(False) := Decidable.is_false(False, not_false)

# a recursor computes: each of these holds by refl alone
law negated_no: Equal[1](bool, negated(bool.no), bool.yes) := Equal.refl[1](bool, bool.yes)
law negated_twice: Equal[1](bool, negated(negated(bool.yes)), bool.yes) := Equal.refl[1](bool, bool.yes)
law decide_true: Equal[1](bool, decide(True, true_decided), bool.yes) := Equal.refl[1](bool, bool.yes)
law decide_false: Equal[1](bool, decide(False, false_decided), bool.no) := Equal.refl[1](bool, bool.no)
