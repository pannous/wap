# The natural numbers as an explicit program for the theory's door, read after logic.wap, whose bool and Equal it
# names (notes/theory.md "The declarations that bind names"). The numbers statement makes nat.zero, 1, 2 … values of nat;
# each shortcut statement lets the kernel compute a function on two numbers at once, licensed by the theorems that
# fix the function, each proved here without an axiom.

enum nat: Type { zero: nat, successor(n: nat): nat }
numbers(nat, bool.yes, Equal)

# the number before n, and 0 before 0
predecessor(n: nat): nat := nat.recursor[1]((t: nat) => nat, nat.zero, (k: nat) => (before: nat) => k, n)
is_zero(n: nat): bool := nat.recursor[1]((t: nat) => bool, bool.yes, (k: nat) => (r: bool) => bool.no, n)

add(m: nat, n: nat): nat := nat.recursor[1]((t: nat) => nat, m, (k: nat) => (sum: nat) => nat.successor(sum), n)
law add_zero(m: nat): Equal[1](nat, add(m, nat.zero), m) := Equal.refl[1](nat, m)
law add_successor(m: nat, n: nat): Equal[1](nat, add(m, nat.successor(n)), nat.successor(add(m, n))) :=
	Equal.refl[1](nat, nat.successor(add(m, n)))
shortcut(add, add, add_zero, add_successor)

subtract(m: nat, n: nat): nat := nat.recursor[1]((t: nat) => nat, m, (k: nat) => (rest: nat) => predecessor(rest), n)
law subtract_zero(m: nat): Equal[1](nat, subtract(m, nat.zero), m) := Equal.refl[1](nat, m)
law zero_subtract(n: nat): Equal[1](nat, subtract(nat.zero, n), nat.zero) :=
	nat.recursor[0]((k: nat) => Equal[1](nat, subtract(nat.zero, k), nat.zero), Equal.refl[1](nat, nat.zero),
		(k: nat) => (h: Equal[1](nat, subtract(nat.zero, k), nat.zero)) => equal_congruent[1, 1](nat, nat, predecessor, subtract(nat.zero, k), nat.zero, h), n)
law subtract_successors(m: nat, n: nat): Equal[1](nat, subtract(nat.successor(m), nat.successor(n)), subtract(m, n)) :=
	nat.recursor[0]((k: nat) => Equal[1](nat, subtract(nat.successor(m), nat.successor(k)), subtract(m, k)), Equal.refl[1](nat, m),
		(k: nat) => (h: Equal[1](nat, subtract(nat.successor(m), nat.successor(k)), subtract(m, k))) => equal_congruent[1, 1](nat, nat, predecessor, subtract(nat.successor(m), nat.successor(k)), subtract(m, k), h), n)
shortcut(subtract, subtract, subtract_zero, zero_subtract, subtract_successors)

multiply(m: nat, n: nat): nat := nat.recursor[1]((t: nat) => nat, nat.zero, (k: nat) => (product: nat) => add(product, m), n)
law multiply_zero(m: nat): Equal[1](nat, multiply(m, nat.zero), nat.zero) := Equal.refl[1](nat, nat.zero)
law multiply_successor(m: nat, n: nat): Equal[1](nat, multiply(m, nat.successor(n)), add(multiply(m, n), m)) :=
	Equal.refl[1](nat, add(multiply(m, n), m))
shortcut(multiply, multiply, multiply_zero, multiply_successor)

# m compared with every number, by recursion on m: at zero the answer for each n, and past zero the step that
# compares the successor of m with n by comparing m with the number before n; 0 is never the successor of m
compared(at_zero: nat -> bool, m: nat): nat -> bool :=
	nat.recursor[1]((t: nat) => nat -> bool, at_zero,
		(k: nat) => (before: nat -> bool) => (n: nat) => nat.recursor[1]((t: nat) => bool, bool.no, (j: nat) => (r: bool) => before(j), n), m)

equals(m: nat, n: nat): bool := compared(is_zero, m)(n)
law equals_zeros: Equal[1](bool, equals(nat.zero, nat.zero), bool.yes) := Equal.refl[1](bool, bool.yes)
law equals_successor_zero(m: nat): Equal[1](bool, equals(nat.successor(m), nat.zero), bool.no) := Equal.refl[1](bool, bool.no)
law equals_zero_successor(n: nat): Equal[1](bool, equals(nat.zero, nat.successor(n)), bool.no) := Equal.refl[1](bool, bool.no)
law equals_successors(m: nat, n: nat): Equal[1](bool, equals(nat.successor(m), nat.successor(n)), equals(m, n)) :=
	Equal.refl[1](bool, equals(m, n))
shortcut(equal, equals, equals_zeros, equals_successor_zero, equals_zero_successor, equals_successors)

at_most(m: nat, n: nat): bool := compared((k: nat) => bool.yes, m)(n)
law zero_at_most(n: nat): Equal[1](bool, at_most(nat.zero, n), bool.yes) := Equal.refl[1](bool, bool.yes)
law successor_at_most_zero(m: nat): Equal[1](bool, at_most(nat.successor(m), nat.zero), bool.no) := Equal.refl[1](bool, bool.no)
law at_most_successors(m: nat, n: nat): Equal[1](bool, at_most(nat.successor(m), nat.successor(n)), at_most(m, n)) :=
	Equal.refl[1](bool, at_most(m, n))
shortcut(at_most, at_most, zero_at_most, successor_at_most_zero, at_most_successors)

# a truth value taken apart by its two cases, each case knowing which one it is
law bool_cases(b: bool, p: bool -> Prop, if_no: Equal[1](bool, b, bool.no) -> p(bool.no), if_yes: Equal[1](bool, b, bool.yes) -> p(bool.yes)): p(b) :=
	bool.recursor[0]((y: bool) => Equal[1](bool, b, y) -> p(y), if_no, if_yes, b)(Equal.refl[1](bool, b))
law no_is_not_yes(h: Equal[1](bool, bool.no, bool.yes)): False :=
	Equal.recursor[0, 1](bool, bool.no, (y: bool) => (e: Equal[1](bool, bool.no, y)) => bool.recursor[1]((x: bool) => Prop, True, False, y), True.intro, bool.yes, h)
law yes_is_not_no(h: Equal[1](bool, bool.yes, bool.no)): False := no_is_not_yes(equal_symmetric[1](bool, bool.yes, bool.no, h))

# what equals says yes to is equal
sound_at(m: nat, n: nat): Prop := Equal[1](bool, equals(m, n), bool.yes) -> Equal[1](nat, m, n)
law equals_sound(m: nat, n: nat, h: Equal[1](bool, equals(m, n), bool.yes)): Equal[1](nat, m, n) :=
	nat.recursor[0]((i: nat) => (k: nat) -> sound_at(i, k),
		(k: nat) => nat.recursor[0]((j: nat) => sound_at(nat.zero, j), (e: Equal[1](bool, bool.yes, bool.yes)) => Equal.refl[1](nat, nat.zero),
			(j: nat) => (r: sound_at(nat.zero, j)) => (e: Equal[1](bool, bool.no, bool.yes)) => false_elim[0](Equal[1](nat, nat.zero, nat.successor(j)), no_is_not_yes(e)), k),
		(i: nat) => (before: (k: nat) -> sound_at(i, k)) => (k: nat) => nat.recursor[0]((j: nat) => sound_at(nat.successor(i), j),
			(e: Equal[1](bool, bool.no, bool.yes)) => false_elim[0](Equal[1](nat, nat.successor(i), nat.zero), no_is_not_yes(e)),
			(j: nat) => (r: sound_at(nat.successor(i), j)) => (e: Equal[1](bool, equals(i, j), bool.yes)) => equal_congruent[1, 1](nat, nat, nat.successor, i, j, before(j)(e)), k), m)(n)(h)

# a number at most n and other than n is at most n with one more added
steps_up(m: nat, n: nat): Prop := Equal[1](bool, at_most(m, n), bool.yes) -> Equal[1](bool, equals(m, n), bool.no) -> Equal[1](bool, at_most(nat.successor(m), n), bool.yes)
law at_most_step(m: nat, n: nat, h: Equal[1](bool, at_most(m, n), bool.yes), e: Equal[1](bool, equals(m, n), bool.no)): Equal[1](bool, at_most(nat.successor(m), n), bool.yes) :=
	nat.recursor[0]((i: nat) => (k: nat) -> steps_up(i, k),
		(k: nat) => nat.recursor[0]((j: nat) => steps_up(nat.zero, j),
			(a: Equal[1](bool, bool.yes, bool.yes)) => (d: Equal[1](bool, bool.yes, bool.no)) => false_elim[0](Equal[1](bool, bool.no, bool.yes), yes_is_not_no(d)),
			(j: nat) => (r: steps_up(nat.zero, j)) => (a: Equal[1](bool, bool.yes, bool.yes)) => (d: Equal[1](bool, bool.no, bool.no)) => Equal.refl[1](bool, bool.yes), k),
		(i: nat) => (before: (k: nat) -> steps_up(i, k)) => (k: nat) => nat.recursor[0]((j: nat) => steps_up(nat.successor(i), j),
			(a: Equal[1](bool, bool.no, bool.yes)) => (d: Equal[1](bool, bool.no, bool.no)) => false_elim[0](Equal[1](bool, bool.no, bool.yes), no_is_not_yes(a)),
			(j: nat) => (r: steps_up(nat.successor(i), j)) => (a: Equal[1](bool, at_most(i, j), bool.yes)) => (d: Equal[1](bool, equals(i, j), bool.no)) => before(j)(a)(d), k), m)(n)(h)(e)

# the laws of adding that dividing needs
law zero_add(n: nat): Equal[1](nat, add(nat.zero, n), n) :=
	nat.recursor[0]((k: nat) => Equal[1](nat, add(nat.zero, k), k), Equal.refl[1](nat, nat.zero),
		(k: nat) => (h: Equal[1](nat, add(nat.zero, k), k)) => equal_congruent[1, 1](nat, nat, nat.successor, add(nat.zero, k), k, h), n)
law successor_add(m: nat, n: nat): Equal[1](nat, add(nat.successor(m), n), nat.successor(add(m, n))) :=
	nat.recursor[0]((k: nat) => Equal[1](nat, add(nat.successor(m), k), nat.successor(add(m, k))), Equal.refl[1](nat, nat.successor(m)),
		(k: nat) => (h: Equal[1](nat, add(nat.successor(m), k), nat.successor(add(m, k)))) => equal_congruent[1, 1](nat, nat, nat.successor, add(nat.successor(m), k), nat.successor(add(m, k)), h), n)
law add_commutative(m: nat, n: nat): Equal[1](nat, add(m, n), add(n, m)) :=
	nat.recursor[0]((k: nat) => Equal[1](nat, add(m, k), add(k, m)), equal_symmetric[1](nat, add(nat.zero, m), m, zero_add(m)),
		(k: nat) => (h: Equal[1](nat, add(m, k), add(k, m))) => equal_transitive[1](nat, nat.successor(add(m, k)), nat.successor(add(k, m)), add(nat.successor(k), m),
			equal_congruent[1, 1](nat, nat, nat.successor, add(m, k), add(k, m), h), equal_symmetric[1](nat, add(nat.successor(k), m), nat.successor(add(k, m)), successor_add(k, m))), n)
law add_associative(a: nat, b: nat, c: nat): Equal[1](nat, add(add(a, b), c), add(a, add(b, c))) :=
	nat.recursor[0]((k: nat) => Equal[1](nat, add(add(a, b), k), add(a, add(b, k))), Equal.refl[1](nat, add(a, b)),
		(k: nat) => (h: Equal[1](nat, add(add(a, b), k), add(a, add(b, k)))) => equal_congruent[1, 1](nat, nat, nat.successor, add(add(a, b), k), add(a, add(b, k)), h), c)
law add_swapped(x: nat, a: nat, b: nat): Equal[1](nat, add(add(x, a), b), add(add(x, b), a)) :=
	equal_transitive[1](nat, add(add(x, a), b), add(x, add(a, b)), add(add(x, b), a), add_associative(x, a, b),
		equal_transitive[1](nat, add(x, add(a, b)), add(x, add(b, a)), add(add(x, b), a),
			equal_congruent[1, 1](nat, nat, (y: nat) => add(x, y), add(a, b), add(b, a), add_commutative(a, b)),
			equal_symmetric[1](nat, add(add(x, b), a), add(x, add(b, a)), add_associative(x, b, a))))
law zero_multiply(n: nat): Equal[1](nat, multiply(nat.zero, n), nat.zero) :=
	nat.recursor[0]((k: nat) => Equal[1](nat, multiply(nat.zero, k), nat.zero), Equal.refl[1](nat, nat.zero),
		(k: nat) => (h: Equal[1](nat, multiply(nat.zero, k), nat.zero)) => h, n)
law successor_multiply(m: nat, n: nat): Equal[1](nat, multiply(nat.successor(m), n), add(multiply(m, n), n)) :=
	nat.recursor[0]((k: nat) => Equal[1](nat, multiply(nat.successor(m), k), add(multiply(m, k), k)), Equal.refl[1](nat, nat.zero),
		(k: nat) => (h: Equal[1](nat, multiply(nat.successor(m), k), add(multiply(m, k), k))) => equal_congruent[1, 1](nat, nat, nat.successor, add(multiply(nat.successor(m), k), m), add(add(multiply(m, k), m), k),
			equal_transitive[1](nat, add(multiply(nat.successor(m), k), m), add(add(multiply(m, k), k), m), add(add(multiply(m, k), m), k),
				equal_congruent[1, 1](nat, nat, (y: nat) => add(y, m), multiply(nat.successor(m), k), add(multiply(m, k), k), h), add_swapped(multiply(m, k), k, m))), n)

# dividing m by n counts up through m: the remainder grows by one and starts again at 0 when it reaches n, and then
# the quotient grows by one. By 0 the remainder never reaches it, so the quotient stays 0 and the remainder is m
chosen(b: bool, if_no: nat, if_yes: nat): nat := bool.recursor[1]((y: bool) => nat, if_no, if_yes, b)
wraps(r: nat, n: nat): bool := equals(nat.successor(r), n)
remainder(m: nat, n: nat): nat := nat.recursor[1]((t: nat) => nat, nat.zero, (k: nat) => (r: nat) => chosen(wraps(r, n), nat.successor(r), nat.zero), m)
divide(m: nat, n: nat): nat := nat.recursor[1]((t: nat) => nat, nat.zero, (k: nat) => (q: nat) => chosen(wraps(remainder(k, n), n), q, nat.successor(q)), m)

divides_back(m: nat, n: nat): Prop := Equal[1](nat, add(multiply(divide(m, n), n), remainder(m, n)), m)
law divide_and_remainder(m: nat, n: nat): Equal[1](nat, add(multiply(divide(m, n), n), remainder(m, n)), m) :=
	nat.recursor[0]((j: nat) => divides_back(j, n), zero_multiply(n),
		(j: nat) => (h: divides_back(j, n)) => bool_cases(wraps(remainder(j, n), n),
			(y: bool) => Equal[1](nat, add(multiply(chosen(y, divide(j, n), nat.successor(divide(j, n))), n), chosen(y, nat.successor(remainder(j, n)), nat.zero)), nat.successor(j)),
			(e: Equal[1](bool, wraps(remainder(j, n), n), bool.no)) => equal_congruent[1, 1](nat, nat, nat.successor, add(multiply(divide(j, n), n), remainder(j, n)), j, h),
			(e: Equal[1](bool, wraps(remainder(j, n), n), bool.yes)) => equal_transitive[1](nat, multiply(nat.successor(divide(j, n)), n), add(multiply(divide(j, n), n), n), nat.successor(j),
				successor_multiply(divide(j, n), n),
				equal_transitive[1](nat, add(multiply(divide(j, n), n), n), add(multiply(divide(j, n), n), nat.successor(remainder(j, n))), nat.successor(j),
					equal_congruent[1, 1](nat, nat, (y: nat) => add(multiply(divide(j, n), n), y), n, nat.successor(remainder(j, n)),
						equal_symmetric[1](nat, nat.successor(remainder(j, n)), n, equals_sound(nat.successor(remainder(j, n)), n, e))),
					equal_congruent[1, 1](nat, nat, nat.successor, add(multiply(divide(j, n), n), remainder(j, n)), j, h)))), m)
law divide_by_zero(m: nat): Equal[1](nat, divide(m, nat.zero), nat.zero) :=
	nat.recursor[0]((j: nat) => Equal[1](nat, divide(j, nat.zero), nat.zero), Equal.refl[1](nat, nat.zero),
		(j: nat) => (h: Equal[1](nat, divide(j, nat.zero), nat.zero)) => h, m)
law remainder_below(m: nat, n: nat): Equal[1](bool, at_most(remainder(m, nat.successor(n)), n), bool.yes) :=
	nat.recursor[0]((j: nat) => Equal[1](bool, at_most(remainder(j, nat.successor(n)), n), bool.yes), Equal.refl[1](bool, bool.yes),
		(j: nat) => (h: Equal[1](bool, at_most(remainder(j, nat.successor(n)), n), bool.yes)) => bool_cases(wraps(remainder(j, nat.successor(n)), nat.successor(n)),
			(y: bool) => Equal[1](bool, at_most(chosen(y, nat.successor(remainder(j, nat.successor(n))), nat.zero), n), bool.yes),
			(e: Equal[1](bool, equals(remainder(j, nat.successor(n)), n), bool.no)) => at_most_step(remainder(j, nat.successor(n)), n, h, e),
			(e: Equal[1](bool, wraps(remainder(j, nat.successor(n)), nat.successor(n)), bool.yes)) => Equal.refl[1](bool, bool.yes)), m)
shortcut(divide, divide, remainder, divide_and_remainder, divide_by_zero, remainder_below)

# the integers: a natural number, or the negative number before minus it (-1 is negative_successor(0)), so every
# integer is made one way only
enum int: Type { of_nat(n: nat): int, negative_successor(n: nat): int }

# m - n as an integer
difference(m: nat, n: nat): int :=
	nat.recursor[1]((t: nat) => int, int.of_nat(subtract(m, n)), (k: nat) => (r: int) => int.negative_successor(k), subtract(n, m))
minus(x: int): int := int.recursor[1]((t: int) => int,
	(m: nat) => nat.recursor[1]((t: nat) => int, int.of_nat(nat.zero), (k: nat) => (r: int) => int.negative_successor(k), m),
	(m: nat) => int.of_nat(nat.successor(m)), x)
sum(a: int, b: int): int := int.recursor[1]((t: int) => int,
	(m: nat) => int.recursor[1]((t: int) => int, (n: nat) => int.of_nat(add(m, n)), (n: nat) => difference(m, nat.successor(n)), b),
	(m: nat) => int.recursor[1]((t: int) => int, (n: nat) => difference(n, nat.successor(m)), (n: nat) => int.negative_successor(nat.successor(add(m, n))), b), a)

# integer arithmetic computes through the shortcuts of nat
law minus_twice: Equal[1](int, minus(minus(int.of_nat(7))), int.of_nat(7)) := Equal.refl[1](int, int.of_nat(7))
law sum_across_zero: Equal[1](int, sum(minus(int.of_nat(3)), int.of_nat(5)), int.of_nat(2)) := Equal.refl[1](int, int.of_nat(2))
law sum_below_zero: Equal[1](int, sum(int.of_nat(2), minus(int.of_nat(1000000))), int.negative_successor(999997)) :=
	Equal.refl[1](int, int.negative_successor(999997))
