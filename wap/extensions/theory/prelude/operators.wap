# The operators of the prelude's numbers and lists, as wap's types module declares its own: each the function named by
# its spelling, `a + b` the call of `+`, here the call of the prelude function it writes. Read by the elaborator after
# the explicit files (elaborate/file.wap), so a list's letter is found where `#xs` is written.

+(m: nat, n: nat): nat := add(m, n)
-(m: nat, n: nat): nat := subtract(m, n)
*(m: nat, n: nat): nat := multiply(m, n)
/(m: nat, n: nat): nat := divide(m, n)
%(m: nat, n: nat): nat := remainder(m, n)
==(m: nat, n: nat): bool := equals(m, n)
<=(m: nat, n: nat): bool := at_most(m, n)

+(a: int, b: int): int := sum(a, b)
*(a: int, b: int): int := times(a, b)
-(x: int): int := minus(x)

#(xs: list(T)): nat := count(T, xs)
+(xs: list(T), ys: list(T)): list(T) := joined(T, xs, ys)
