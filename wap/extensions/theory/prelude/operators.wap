# The operators of the prelude's numbers, lists and texts, as wap's types module declares its own: each the function
# named by its spelling, `a + b` the call of `+`, here the call of the prelude function it writes. An explicit program
# read after numbers.wap and data.wap by the theory's door, each spelling an overload of the one before (a list's
# letter is a binder found where `#xs` is written)

+(m: nat, n: nat): nat := add(m, n)
-(m: nat, n: nat): nat := subtract(m, n)
*(m: nat, n: nat): nat := multiply(m, n)
/(m: nat, n: nat): nat := divide(m, n)
%(m: nat, n: nat): nat := remainder(m, n)
==(m: nat, n: nat): bool := equals(m, n)
<=(m: nat, n: nat): bool := at_most(m, n)
>=(m: nat, n: nat): bool := at_most(n, m)
<(m: nat, n: nat): bool := negated(at_most(n, m))
>(m: nat, n: nat): bool := negated(at_most(m, n))

+(a: int, b: int): int := sum(a, b)
*(a: int, b: int): int := times(a, b)
-(x: int): int := minus(x)

#(T: Sort(u), xs: list[u](T)): nat := count[u](T, xs)
+(T: Sort(u), xs: list[u](T), ys: list[u](T)): list[u](T) := joined[u](T, xs, ys)
#(t: text): nat := count[1](nat, points(t))
+(a: text, b: text): text := text.of_points(joined[1](nat, points(a), points(b)))

# the connectives over propositions (wiki/proposition.md): a comparison, a bool, is the proposition that it is yes
and(a: Prop, b: Prop): Prop := And(a, b)
or(a: Prop, b: Prop): Prop := Or(a, b)
implies(a: Prop, b: Prop): Prop := a -> b
not(a: Prop): Prop := Not(a)
