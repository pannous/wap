# Quotient types as an explicit program for the theory's door (notes/theory.md "The declarations that bind names"),
# read after logic.wap, whose Equal it names. The kernel adds the quotient and its ways out; that joined values are
# equal is this prelude's axiom, and function extensionality is proved from it (notes/coc-plan.md 13.2).
# Run: wap wap/extensions/theory/check.wap <logic.wap and this file, joined>

quotients(Equal)

# values the relation joins are equal in the quotient (one of the prelude's two axioms)
axiom quotient_sound(T: Sort(u), r: T -> T -> Prop, a: T, b: T, joined: r(a, b)): Equal[u](quotient[u](T, r), quotient.of[u](T, r, a), quotient.of[u](T, r, b))

# the functions from A whose result's type B depends on the argument, and two of them equal at every argument
functions(A: Sort(u), B: A -> Sort(v)): Sort(imax(u, v)) := (x: A) -> B(x)
pointwise(A: Sort(u), B: A -> Sort(v), f: functions[u, v](A, B), g: functions[u, v](A, B)): Prop :=
	(x: A) -> Equal[v](B(x), f(x), g(x))

# a function applied in the quotient of pointwise equality: lift is allowed, since pointwise equal functions give
# equal results
applied(A: Sort(u), B: A -> Sort(v), q: quotient[imax(u, v)](functions[u, v](A, B), pointwise[u, v](A, B)), x: A): B(x) :=
	quotient.lift[imax(u, v), v](functions[u, v](A, B), pointwise[u, v](A, B), B(x),
		(f: functions[u, v](A, B)) => f(x),
		(f: functions[u, v](A, B)) => (g: functions[u, v](A, B)) => (h: pointwise[u, v](A, B, f, g)) => h(x), q)

# pointwise equal functions are equal: made in the quotient they are equal by the axiom, and applying turns both
# back into the functions, since lift computes on a made value
law function_extensionality(A: Sort(u), B: A -> Sort(v), f: functions[u, v](A, B), g: functions[u, v](A, B), h: pointwise[u, v](A, B, f, g)): Equal[imax(u, v)](functions[u, v](A, B), f, g) :=
	equal_congruent[imax(u, v), imax(u, v)](quotient[imax(u, v)](functions[u, v](A, B), pointwise[u, v](A, B)), functions[u, v](A, B),
		(q: quotient[imax(u, v)](functions[u, v](A, B), pointwise[u, v](A, B))) => (x: A) => applied[u, v](A, B, q, x),
		quotient.of[imax(u, v)](functions[u, v](A, B), pointwise[u, v](A, B), f),
		quotient.of[imax(u, v)](functions[u, v](A, B), pointwise[u, v](A, B), g),
		quotient_sound[imax(u, v)](functions[u, v](A, B), pointwise[u, v](A, B), f, g, h))
