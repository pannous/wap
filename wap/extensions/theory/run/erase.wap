# Erase (notes/coc-plan.md 5.1, 9.7): what a program the theory accepted runs, as run terms (terms.wap). Its types,
# proofs and levels go: a binder or an argument that is a type, a type family or a proof runs as nothing. A function
# of the prelude runs by the host where hosts.wap says how, else by its value, unfolded where it is used: the prelude
# has no recursion, so unfolding ends. A function of the program runs as a Routine of its own, erased the first
# time a value reaches it. A term no run term stands for yet is refused by the rule `running`.
use "../terms.wap"
use "../environment.wap"
use "../typing.wap"
use "../compute.wap"
use "../show.wap"
use "../elaborate/read.wap"
use "terms.wap"
use "hosts.wap"

# a binder named nothing a program can write runs under this name
UNNAMED := "x"

# An erase under way: the checker its terms are typed by, the run name of each free variable it went into, and what
# runs so far, the functions erased by name
class Erasing {
	p: Theory
	c: Checker
	names: map<int, text> = {}
	running: Running = Running()
	erased: list<text> = []
}

# what a program the theory accepted runs: the functions its values reach, and the values
running(p: Theory): Running := {
	e = Erasing(p, checker(p.environment, []))
	e.running.values = p.values.map(value => run_of(e, value))
	e.running
}

run_of(e: Erasing, t: Term): Run := match t.shape {
	Free(id) => Local(e.names[id])
	Numeral(value) => Natural(value)
	LetIn(binder, type, value, body) => {
		held = run_of(e, value)
		variable = named_variable(e, binder, type)
		Named(e.names[variable_id(variable)], held, run_of(e, instantiated(body, variable)))
	}
	Lambda(binder, domain, body) => refused(RUNNING, "${shown_for(e.c, t)} is a function value, which no program runs from its terms yet")
	_ => applied(e, head(t), arguments(t))
}

# a head applied to its arguments as it runs: a host's spelling, a call of a program's function, a prelude function
# unfolded
applied(e: Erasing, function: Term, given: list<Term>): Run := match function.shape {
	Constant(name, levels) => {
		kept = given.filter(argument => is_data(e, argument)).map(argument => run_of(e, argument))
		spelling = HOST_FUNCTIONS.get(name)
		if spelling is not ø { return host_run(e, name, spelling!, kept) }
		if place(e.p.environment, name) > e.p.prelude_size {
			definition_erased(e, name)
			return if kept is empty then Global(name) else Called(Global(name), kept)
		}
		value = unfolded(e.c, apply_all(function, given)) ?? refused(RUNNING, "${name} runs by nothing: it has no value and the host does not run it")
		run_of(e, beta(head(value), arguments(value)))
	}
	Lambda(binder, domain, body) => run_of(e, beta(function, given))
	_ => if given is empty then refused(RUNNING, "${shown_for(e.c, function)} is no value a program runs") else Called(run_of(e, function), given.filter(argument => is_data(e, argument)).map(argument => run_of(e, argument)))
}

# the host's spelling of a prelude function given all the arguments it takes
host_run(e: Erasing, name: text, spelling: text, arguments: list<Run>): Run := {
	takes = (1 to 9).filter(at => spelling.contains("\$${at}")).count()
	if takes != #arguments { refused(RUNNING, "${name} is given ${#arguments} of its ${takes} arguments: the host runs it called whole") }
	Host(spelling, arguments)
}

# whether a term is data a program runs on, not a type, a type family or a proof
is_data(e: Erasing, t: Term): bool := runs_on(e, type_of(e.c, t))
# whether values of a type are data: it is no sort, no function into one and no proposition
runs_on(e: Erasing, type: Term): bool := not (result_of(computed(e.c, type)).shape is Sort) and not is_proposition(e.c, type)

# a binder gone into, its variable named for the run: the binder's name, with a count where another variable has it
named_variable(e: Erasing, binder: text, type: Term): Term := {
	variable = hypothesis(e.c, binder, type)
	written = if binder == "" or binder == "_" then UNNAMED else binder
	name = written
	count = 1
	while name in e.names.values() { count += 1; name = "${written}${count}" }
	e.names[variable_id(variable)] = name
	variable
}

# a function of the program erased once: its parameters that are data, its result's run type, its body
definition_erased(e: Erasing, name: text) := {
	if name in e.erased { return }
	e.erased += [name]
	declaration = declared_named(e.p.environment, name)
	body = unfolding(declaration) ?? refused(RUNNING, "${name} runs by nothing: it has no value")
	parameters: list<Typed> = []
	while yes {
		match body.shape {
			Lambda(binder, domain, inner) => {
				variable = named_variable(e, binder, domain)
				if runs_on(e, domain) { parameters += [Typed(e.names[variable_id(variable)], run_type(e, domain))] }
				body = instantiated(inner, variable)
			}
			_ => break
		}
	}
	result = run_type(e, type_of(e.c, body))
	e.running.routines += [Routine(name, parameters, result, run_of(e, body))]
}

# the wap type that holds a type's values as they run
run_type(e: Erasing, type: Term): text := match computed(e.c, type).shape {
	Constant(name, levels) => HOST_TYPES.get(name) ?? refused(RUNNING, "a value of ${name} has no layout the host runs it in yet")
	_ => refused(RUNNING, "a value of ${shown_for(e.c, type)} has no layout the host runs it in yet")
}
