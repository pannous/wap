# Erase (notes/coc-plan.md 5.1, 9.7): what a program the theory accepted runs, as run terms (terms.wap). Its types,
# proofs and levels go: a binder or an argument that is a type, a type family or a proof runs as nothing. A function
# of the prelude runs by the host where its layout says how (`runs(…)`, elaborate/file.wap), else by its value, unfolded where it is used: the prelude
# has no recursion, so unfolding ends. A function of the program runs as a Routine of its own, erased the first
# time a value reaches it. A term no run term stands for yet is refused by the rule `running`.
use "../../../kernel/terms.wap"
use "../../../kernel/numbers.wap"
use "../../../kernel/environment.wap"
use "../../../kernel/typing.wap"
use "../../../kernel/compute.wap"
use "../../../core/analyze/courses.wap"
use "../../../kernel/show.wap"
use "../elaborate/read.wap"
use "../elaborate/file.wap"
use "../explicit.wap"
use "../../../core/format.wap"
use "../../../core/pipeline.wap"
use "../../../core/language.wap"
use "../../../core/parse/reader.wap"
use "../../../core/parse/operators.wap"
use "../../../core/parse/atoms.wap"
use "../../../core/emit/values.wap"
use "../../../core/type_notation.wap"
use "../../../kernel/forms.wap"
use "../../../kernel/primitives.wap"
use "terms.wap"

# a binder named by words runs under them joined by this; one named nothing a program can write as show.wap's
# UNNAMED; the value a choice is made on under CHOSEN, the value of a host's operation under HELD
NAME_JOINER := "_"
CHOSEN := "chosen"
HELD := "held"

# An erase under way: the checker its terms are typed by, the run name of each free variable it went into, and what
# runs so far, the functions erased by name
# the run name of a copy of a function of the language every program gets, before its place
LANGUAGE_RUN := "language_"
class Erasing {
	p: Theory
	c: Checker
	names: map<int, text> = {}
	running: Running = Running()
	erased: list<text> = []
	# the run names given in the function being erased, which its variables' names keep apart
	scope: list<text> = []
}

# what a program the theory accepted runs: the functions its values reach, and the values
running(p: Theory): Running := {
	e = Erasing(p, checker(p.environment, []))
	e.running.values = p.values.map(value => run_of(e, value))
	e.running
}

run_of(e: Erasing, t: Term): Run := match t.shape {
	Free(id) => Local(e.names.get(id) ?? refused(RUNNING, "this uses the values below a case, which runs by recursion"))
	Numeral(value) => Natural(value)
	Quoted(value) => run_of(e, text_opened(e.c, value))
	LetIn(binder, type, value, body) => {
		held = run_of(e, value)
		variable = named_variable(e, binder, type)
		Named(e.names[variable_id(variable)], held, run_of(e, instantiated(body, variable)))
	}
	Lambda(binder, domain, body) => {
		if not runs_on(e, domain) { refused(RUNNING, "${shown_for(e.c, t)} is a function of a type or a proof, which runs as nothing") }
		variable = named_variable(e, binder, domain)
		Function(Typed(e.names[variable_id(variable)], run_type(e, domain)), run_of(e, instantiated(body, variable)))
	}
	Projection(structure, field, of) => projected(e, structure, field, of)
	_ => applied(e, head(t), arguments(t))
}
# a field of a structure's value as it runs: the layout of the structure's one case takes it out of the value
projected(e: Erasing, structure: Term, field: int, of: Term): Run := {
	facts = structure_facts(e.p.environment, structure) ?? refused(RUNNING, "${constant_name(structure)} is no structure whose field a projection takes")
	case = facts.block.types#1.cases#1.name
	layout = e.p.layouts.get(case) ?? refused(RUNNING, "a field of ${case} is taken, and the host has no layout for its type yet")
	names = binder_names(declared_named(e.p.environment, case).type)
	name = names#(#names - facts.fields#1#1 + field)
	Host(layout.fields.get(name) ?? refused(RUNNING, "${name} of ${case} is taken, and its layout does not take it out"), [run_of(e, of)])
}

# a head applied to its arguments as it runs: a host's spelling, a choice of a recursor or a course, a call of a
# program's function, a prelude function unfolded
applied(e: Erasing, function: Term, given: list<Term>): Run := match function.shape {
	Constant(name, levels, _) => {
		layout = e.p.layouts.get(name)
		if layout is not ø { return host_run(e, function, name, layout!, given) }
		match declared_named(e.p.environment, name).kind {
			Recursor(facts) => return chosen(e, name, facts, given)
			_ => ø
		}
		if place(e.p.environment, name) in e.p.environment.courses { return coursed(e, name, given) }
		if not from_prelude(e.p, name) {
			definition_erased(e, name)
			kept = data_runs(e, given)
			return if kept is empty then Global(run_name(e, name)) else Called(Global(run_name(e, name)), kept)
		}
		value = unfolded(e.c, apply_all(function, given)) ?? refused(RUNNING, "${name} runs by nothing: it has no value and the host does not run it")
		run_of(e, beta(head(value), arguments(value)))
	}
	Lambda(binder, domain, body) => run_of(e, beta(function, given))
	_ => if given is empty then refused(RUNNING, "${shown_for(e.c, function)} is no value a program runs") else Called(run_of(e, function), data_runs(e, given))
}
# the arguments that are data, as they run
data_runs(e: Erasing, given: list<Term>): list<Run> := given.filter(argument => is_data(e, argument)).map(argument => run_of(e, argument))

# The host's spelling of a prelude function given all the arguments it takes: those it spells, numbered again in
# their order; a host operation's value held at the wap type the function's value runs as, which types it (a word
# of the types module the host runs as written has no written layout)
host_run(e: Erasing, function: Term, name: text, layout: Layout, given: list<Term>): Run := {
	taking(name, given, #binder_names(declared_named(e.p.environment, name).type))
	used = (1 to #given).filter(at => layout.value.contains("\$${at}"))
	run = Host(used.fold(layout.value, (spelled, at) => spelled.replace("\$${at}", "\$${used.index_of(at)}")), used.map(at => run_of(e, given#at)))
	if layout.written is not empty and formed(e.p, layout.written#2) is Prim then Held(fresh_name(e, HELD), run_type(e, type_of(e.c, apply_all(function, given))), run) else run
}

# A recursor given all its arguments, its major premise last, as a choice between its minor premises, one per case,
# each given the arguments after the major premise (a motive of functions)
chosen(e: Erasing, name: text, facts: RecursorFacts, given: list<Term>): Run := {
	first_minor = facts.parameters + facts.motives
	major = first_minor + facts.minors + facts.indices + 1
	taking(name, given, major)
	type = constant_name(facts.of)
	if facts.cases is empty { refused(RUNNING, "${name} chooses among no cases: no value of ${type} runs") }
	subject = run_of(e, given#major)
	held = named_variable(e, CHOSEN, type_of(e.c, given#major))
	below = recursive_fields(e, type)
	alternatives = (1 to #facts.cases).map(at => alternative(e, constant_name(facts.cases#at), facts.fields#at, below#at, given#(first_minor + at), given.drop(major)))
	Choose(subject, e.names[variable_id(held)], alternatives)
}
# how many fields of each case of a type hold a value of its block, an induction hypothesis each
recursive_fields(e: Erasing, type: text): list<int> := {
	facts = type_facts(e, type)
	facts.recursive#place_in_block(facts, type).map(places => #places)
}
# what checks 1 to 5 found of the block a type is of, and the type's place in it
type_facts(e: Erasing, type: text): InductiveFacts := match declared_named(e.p.environment, type).kind {
	Inductive(facts) => facts
	_ => refused(RUNNING, "${type} is no enum")
}
place_in_block(facts: InductiveFacts, type: text): int := type_names(facts.block).index_of(type)
# a function given fewer arguments than it takes, refused: it runs given all of them
taking(name: text, given: list<Term>, count: int) := if #given < count { refused(RUNNING, "${name} is given ${#given} of its ${count} arguments: it runs given all it takes") }
# A course given all its arguments (core/analyze/courses.wap): its step at the indices, the value and the values below it, those
# given no run name, so a step that uses them is refused as recursion; the arguments after the value given to it
coursed(e: Erasing, name: text, given: list<Term>): Run := {
	type = name[.. #name - #COURSE]
	facts = type_facts(e, type)
	step_at = facts.block.parameters + 2
	value_at = step_at + facts.indices#place_in_block(facts, type) + 1
	taking(name, given, value_at)
	at_value = beta(given#step_at, given[step_at .. value_at])
	match at_value.shape {
		Lambda(binder, domain, body) => run_of(e, beta(instantiated(body, hypothesis(e.c, binder, domain)), given.drop(value_at)))
		_ => refused(RUNNING, "the step of ${name} is no function of the values below")
	}
}
# A minor premise taken as the alternative of its case: the case's host test, its fields named and spelled as the
# host takes them out of the value, then its value given the arguments after the major premise. The induction
# hypotheses after the fields get no run name, so a use is refused as recursion.
# DEBT: only the cases of a type the prelude lays out; an enum of the program needs its layout first
alternative(e: Erasing, case: text, fields: int, below: int, minor: Term, after: list<Term>): Alternative := {
	layout = e.p.layouts.get(case) ?? refused(RUNNING, "${case} is matched, and the host has no layout for its type yet")
	test = layout.test ?? refused(RUNNING, "${case} is matched, and its layout has no test")
	# (a case's fields are its last binders, after its type's parameters)
	field_names = binder_names(declared_named(e.p.environment, case).type)
	field_names = field_names.drop(#field_names - fields)
	variables: list<Term> = []
	types: list<text> = []
	inner = minor
	for at in 1 to fields + below {
		match inner.shape {
			Lambda(binder, domain, body) => {
				variable = if at <= fields then named_variable(e, binder, domain) else hypothesis(e.c, binder, domain)
				if at <= fields {
					variables += [variable]
					types += [run_type(e, domain)]
				}
				inner = instantiated(body, variable)
			}
			_ => refused(RUNNING, "the alternative of ${case} is no function of its fields")
		}
	}
	value = beta(inner, after)
	# (only the fields its value uses are taken out)
	used = (1 to #variables).filter(at => variable_id(variables#at) in free_variables(value))
	spellings = used.map(at => layout.fields.get(field_names#at) ?? refused(RUNNING, "${field_names#at} of ${case} is used, and its layout does not take it out"))
	Alternative(test, used.map(at => e.names[variable_id(variables#at)]), spellings, used.map(at => types#at), run_of(e, value))
}

# whether a term is data a program runs on, not a type, a type family or a proof
is_data(e: Erasing, t: Term): bool := runs_on(e, type_of(e.c, t))
# whether values of a type are data: it is no sort, no function into one and no proposition
runs_on(e: Erasing, type: Term): bool := not (result_of(computed(e.c, type)).shape is Sort) and not is_proposition(e.c, type)

# a binder gone into, its variable named for the run: the binder's name, with a count where another variable of
# the function has it
named_variable(e: Erasing, binder: text, type: Term): Term := {
	variable = hypothesis(e.c, binder, type)
	spelled = binder.codepoints.map(c => if is_name_char(text(c)) then text(c) else NAME_JOINER).join("")
	e.names[variable_id(variable)] = fresh_name(e, if spelled == "" or spelled == NAME_JOINER then UNNAMED else spelled)
	variable
}
# a name no other variable of the function has: the written one, with a count where another has it
fresh_name(e: Erasing, written: text): text := {
	name = written
	count = 1
	while name in e.scope { count += 1; name = "${written}${count}" }
	e.scope += [name]
	name
}

# a function of the program erased once: its parameters that are data, its result's run type, its body
definition_erased(e: Erasing, name: text) := {
	if name in e.erased { return }
	e.erased += [name]
	outer = e.scope
	e.scope = []
	refusal = e.p.run_refusals.get(name)
	if refusal is not ø { refused(RUNNING, "${name} calls itself, and runs by its body as written, which is kept by no proof: ${refusal!}") }
	body = e.p.run_terms.get(name) ?? unfolding(declared_named(e.p.environment, name)) ?? refused(RUNNING, "${name} runs by nothing: it has no value")
	parameters: list<Typed> = []
	while yes {
		match body.shape {
			Lambda(binder, domain, inner) => {
				variable = named_variable(e, binder, domain)
				if runs_on(e, domain) { parameters += [Typed(e.names[variable_id(variable)], run_type(e, domain))] }
				body = instantiated(inner, variable)
			}
			_ => break
		}
	}
	result = run_type(e, type_of(e.c, body))
	# (the body erased first: the functions it reaches are added meanwhile)
	run_body = run_of(e, body)
	e.running.routines += [Routine(run_name(e, name), parameters, result, run_body)]
	e.scope = outer
}

# the name a function of the program runs by, as the program wrote it: of an overload, the name the overloads share
run_name(e: Erasing, name: text): text := {
	# a function of the language runs as a copy of its own, which takes no name the language every program gets has
	if not from_program(e.p, name) { return "${LANGUAGE_RUN}${place(e.p.environment, name)}" }
	shared = e.p.overloads.keys().filter(kernel => name in e.p.overloads[kernel])
	written_name(if shared is empty then name else shared#1)
}

# the wap type that holds a type's values as they run: its layout's, as written or computed
run_type(e: Erasing, type: Term): text := host_type(e.p, e.c, type, unlaid => unlaid_refused(e, unlaid))
unlaid_refused(e: Erasing, type: Term): text := refused(RUNNING, "a value of ${shown_for(e.c, type)} has no layout the host runs it in yet")

# the wap type a type's values run as: its layout's, the host types of the arguments it names put in; a type of types
# `Type`, a function type of host types one; a type the prelude lays out no way to run is the unlaid's
host_type(p: Theory, c: Checker, type: Term, unlaid: (Term) -> text): text := {
	folded = computed_folded(c, type)
	match folded.shape {
		Sort(level) => TYPE_WORD
		Pi(binder, domain, body) => "(${host_type(p, c, domain, unlaid)}) -> ${host_type(p, c, instantiated(body, hypothesis(c, binder, domain)), unlaid)}"
		_ => {
			whole = [folded, computed(c, type)].find(t => layout_of(p, t) is not ø) ?? return unlaid(type)
			layout = layout_of(p, whole)!
			given = arguments(whole)
			# (a type given fewer arguments than it takes has no host type: its layout names a place none fills)
			if #given < #binder_names(type_of(c, head(whole))) { return unlaid(type) }
			# (`Eff`'s effects, which its layout names no place of, are asked no host type)
			filled(layout.value, #given, at => host_type(p, c, given#at, unlaid))
		}
	}
}
# the layout of the declaration a type applies
layout_of(p: Theory, type: Term): Layout? := match head(type).shape {
	Constant(name, levels, _) => p.layouts.get(name)
	_ => ø
}

# A layout checked, since erase believes it: each spelling is host code, typed by wap's own typer as the value of a
# definition of the parameters it names, each at the wap type its values run as (`nat`'s as an int, so `it - 1` is an
# int); a type's spelling as the type of a value. One the typer refuses is refused. What the typer checks is that the
# spelling is well typed; that it means what the theory's word does is believed (notes/theory.md "The run trust base")
LAYOUT_CHECKED := "laid_out"
# the name a case's value is checked under, `it` being no name a definition's parameter can take
VALUE_CHECKED := "value"
# wap's own language and types module, which type the host's code
class HostTyping { language: Language; types: Module; theory: Theory }
# every layout of the prelude checked
layouts_checked(p: Theory, language: Language) := {
	wap = base_language()
	host = HostTyping(wap, language_loaded(wap, p.wap_folder), p)
	for name in p.layouts.keys() { layout_checked(p, host, name, p.layouts[name].written) }
}
layout_checked(p: Theory, host: HostTyping, name: text, parts: list<Node>) := {
	d = declared_named(p.environment, name)
	c = checker(p.environment, d.levels)
	binders: list<list<text>> = []
	type = d.type
	while yes {
		match type.shape {
			Pi(binder, domain, body) => {
				binders += [[binder, host_type(p, c, domain)]]
				type = instantiated(body, hypothesis(c, binder, domain))
			}
			_ => break
		}
	}
	result = host_type(p, c, type)
	# (a type's spelling is a wap type: that of a value)
	if result == TYPE_WORD {
		type_written = formatted(host.language, parts#2)
		spelled_as(host, name, [[VALUE_CHECKED, type_written]], type_written, symbol(VALUE_CHECKED))
		return
	}
	spelled_as(host, name, binders, result, parts#2)
	value = [[VALUE_CHECKED, result]]
	at_value = [[VALUE_NAME, VALUE_CHECKED]]
	test = named_part(parts, TEST_NAME)
	if test is not ø { spelled_as(host, name, value, BOOL, renamed(test!, at_value)) }
	for binder in binders {
		field = named_part(parts, binder#1)
		if field is not ø { spelled_as(host, name, value, binder#2, renamed(field!, at_value)) }
	}
}
# a spelling typed by the host as the value of a definition of the parameters it names, each a name and its wap type;
# one that is a host operation, `prim i64.add(m, n)`, is checked against its row instead
spelled_as(host: HostTyping, name: text, binders: list<list<text>>, result: text, spelling: Node) := {
	operation = formed(host.theory, spelling)
	if operation is Prim {
		if wasm_types(name, binders, operation) != [wasm_type(name, result)] { refused(LAYOUT, "${name} runs as ${formatted(host.language, spelling)}, whose value is no ${result}") }
		return
	}
	written = formatted(host.language, spelling)
	named = words_in(spelling)
	parameters = binders.filter(binder => binder#1 in named and binder#2 != TYPE_WORD).map(binder => "${binder#1}: ${binder#2}").join(", ")
	source = "${LAYOUT_CHECKED}(${parameters}): ${result} := ${written}"
	try {
		code = operated_program(host.language, notation(source, LAYOUT_CHECKED))
		typed_modules(host.language, [declared_module(host.language, code)], host.types, LAYOUT_CHECKED)
	} catch refusal { refused(LAYOUT, "${name} runs as ${written}, which wap types as no ${result}: ${refusal.message}") }
}
# A host operation checked against its row (kernel/primitives.wap): its operands, the parameters it names, numbers and
# operations inside it, of exactly the wasm types the row takes; the wasm types it gives
wasm_types(name: text, binders: list<list<text>>, spelling: Node): list<list<int>> := match spelling {
	Prim(operation, given) => {
		row = PRIMITIVES.get(text(operation)) ?? refused(LAYOUT, "${name} runs as ${operation}, which is no operation of the host")
		if given.flat_map(operand => wasm_types(name, binders, operand)) != row.takes { refused(LAYOUT, "${name} runs as the host's ${operation}, which takes operands of other wasm types") }
		row.gives
	}
	Number(value) => [wasm_type(name, if value is int then INT_TYPE else FLOAT_TYPE)]
	_ => [wasm_type(name, (binders.find(binder => binder#1 == text(spelling)) ?? refused(LAYOUT, "${name} runs as an operation on ${spelling}, which is no parameter"))#2)]
}
wasm_type(name: text, type: text): list<int> := WORD_LAYOUTS.get(type) ?? refused(LAYOUT, "${name} runs as a host operation on a ${type}, which has no wasm type")
# the wap type a type's values run as, where a layout is checked: one the prelude lays out no way to run, a type
# variable `T` or `Effects`, whose values a layout only passes on, as the theory names it
host_type(p: Theory, c: Checker, type: Term): text := host_type(p, c, type, unlaid => shown_for(c, unlaid))
