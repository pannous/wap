# What runs by the host in place of the prelude's definitions (notes/coc-plan.md 9.7): a number of the prelude runs
# as a machine int, its arithmetic as the machine's, a truth value as wap's bool. Each spelling is plain wap with the
# arguments it uses at their places, `$1`, `$2`, types and proofs counted too, and the prelude's functions it stands
# for; each type the wap type that holds its values. The slice of S4's host layouts that S2 runs by, until the
# prelude's own definitions carry these as `prim` bodies.
# DEBT: a nat or an int runs as a machine int, so a number past 2^63 wraps where the theory's does not.

HOST_FUNCTIONS: map<text, list<text>> := {
	"($1 + $2)": ["add", "sum"],
	"($1 * $2)": ["multiply", "times"],
	"($1 == $2)": ["equals", "equal_integers"],
	"(-$1)": ["minus"],
	"($1 < 0)": ["negative"],
	"(not $1)": ["negated"],
	"yes": ["bool.yes"],
	"no": ["bool.no"],
	"$1": ["int.of_nat"],
	"$3": ["pure"]
}
# each case of a type the host lays out: the test that a value is of it, then the spelling of each field taken out
HOST_CASES: map<text, list<text>> := {
	"bool.no": ["(not $1)"],
	"bool.yes": ["$1"],
	"nat.zero": ["($1 == 0)"],
	"nat.successor": ["($1 > 0)", "($1 - 1)"],
	"int.of_nat": ["($1 >= 0)", "$1"],
	"int.negative_successor": ["($1 < 0)", "(-$1 - 1)"]
}
# the computations of the prelude (prelude/effects.wap): a computation of a value runs as its value, `Eff(e, T)` as a
# T; one handing its value to the next, `bind(e, A, B, c, next)`, runs c, then next's body with c's value
HOST_COMPUTATION := "Eff"
HOST_COMPUTATION_VALUE := 2
HOST_SEQUENCE := "bind"
HOST_SEQUENCE_ARGUMENTS := 5
HOST_SEQUENCE_FIRST := 4
HOST_SEQUENCE_NEXT := 5
HOST_TYPES: map<text, text> := { "int": "int", "bool": "bool" }

# the host's spelling of a prelude function, ø for one the host does not run
host_spelling(name: text): text? := {
	spellings = HOST_FUNCTIONS.keys().filter(spelling => name in HOST_FUNCTIONS[spelling])
	if spellings is empty then ø else spellings#1
}
# the host's spelling with the arguments' code put in, the last place first so `$1` never eats `$10`'s digits
host_spelled(spelling: text, arguments: list<text>): text := (1 to #arguments).reverse().fold(spelling, (spelled, at) => spelled.replace("\$${at}", arguments#at))
