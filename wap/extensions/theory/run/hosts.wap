# What runs by the host in place of the prelude's definitions (notes/coc-plan.md 9.7): a number of the prelude runs
# as a machine int, its arithmetic as the machine's, a truth value as wap's bool. Each function a spelling of plain wap
# with each argument once, at `$1`, `$2`; each type the wap type that holds its values. The slice of S4's host layouts that
# S2 runs by, until the prelude's own definitions carry these as `prim` bodies.
# DEBT: a nat or an int runs as a machine int, so a number past 2^63 wraps where the theory's does not.

HOST_FUNCTIONS: map<text, text> := {
	"nat.zero": "0",
	"nat.successor": "($1 + 1)",
	"add": "($1 + $2)",
	"multiply": "($1 * $2)",
	"equals": "($1 == $2)",
	"at_most": "($1 <= $2)",
	"int.of_nat": "$1",
	"sum": "($1 + $2)",
	"times": "($1 * $2)",
	"minus": "(-$1)",
	"equal_integers": "($1 == $2)",
	"bool.yes": "yes",
	"bool.no": "no",
	"negated": "(not $1)"
}
# each case of a type the host lays out: the test that a value is of it, then the spelling of each field taken out
HOST_CASES: map<text, list<text>> := {
	"bool.no": ["(not $1)"],
	"bool.yes": ["$1"],
	"nat.zero": ["($1 == 0)"],
	"nat.successor": ["($1 > 0)", "($1 - 1)"],
	"int.of_nat": ["($1 >= 0)", "$1"],
	"int.negative_successor": ["($1 < 0)", "(-$1 - 1)"]
}
HOST_TYPES: map<text, text> := { "nat": "int", "int": "int", "bool": "bool" }

# the host's spelling with the arguments' code put in, the last place first so `$1` never eats `$10`'s digits
host_spelled(spelling: text, arguments: list<text>): text := (1 to #arguments).reverse().fold(spelling, (spelled, at) => spelled.replace("\$${at}", arguments#at))
