# Lower (notes/coc-plan.md 5.1): what a program runs (terms.wap) written as plain wap, every parameter and result
# typed, which today's compiler binds, types and emits: S2's bridge to the emitter, the printed program the run door's
# output.
use "terms.wap"

# the program in plain wap: its functions, then its values, the last one the program's shown value
written_program(r: Running): text := (r.routines.map(routine_written) + r.values.map(code_of)).join("\n")

# `double(n: int): int := n + n`; a function of no parameters a constant, `answer: int := 42`
routine_written(d: Routine): text := {
	head = if d.parameters is empty then d.name else "${d.name}(${d.parameters.map(p => "${p.name}: ${p.type}").join(", ")})"
	"${head}: ${d.result} := ${code_of(d.body)}"
}

code_of(r: Run): text := match r {
	Local(name) => name
	Global(name) => name
	Called(function, arguments) => "${code_of(function)}(${arguments.map(code_of).join(", ")})"
	Natural(value) => "${value}"
	Named(name, value, body) => "{ ${name} = ${code_of(value)}; ${code_of(body)} }"
	Choose(subject, held, alternatives) => "{ ${held} = ${code_of(subject)}; ${chosen_written(held, alternatives)} }"
	Host(spelling, arguments) => host_spelled(spelling, arguments.map(code_of))
	Held(name, type, value) => "{ ${name}: ${type} = ${code_of(value)}; ${name} }"
	Function(parameter, body) => "((${parameter.name}: ${parameter.type}) => ${code_of(body)})"
}


# the alternatives tried in order, the last one taken without its test: `if (chosen == 0) then 1 else …`
chosen_written(held: text, alternatives: list<Alternative>): text := {
	last = alternative_written(held, alternatives.last)
	alternatives.take(#alternatives - 1).reverse().fold(last, (rest, a) => "if ${host_spelled(a.test, [held])} then ${alternative_written(held, a)} else ${rest}")
}
# an alternative's value, its fields taken out of the value held first
alternative_written(held: text, a: Alternative): text := if a.fields is empty then code_of(a.body) else "{ ${(1 to #a.fields).map(at => "${a.fields#at}: ${a.types#at} = ${host_spelled(a.spellings#at, [held])}; ").join("")}${code_of(a.body)} }"
