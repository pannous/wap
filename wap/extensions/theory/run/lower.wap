# Lower (notes/coc-plan.md 5.1): what a program runs (terms.wap) written as plain wap, every parameter and result
# typed, which today's compiler binds, types and emits: S2's bridge to the emitter. Before S3 the facts the emitter
# reads are written from the run terms' types here instead, one function per family of facts, and the printed
# program stays this door's output.
use magnitude
use "terms.wap"
use "hosts.wap"

# the program in plain wap: its functions, then its values, the last one the program's shown value
written_program(r: Running): text := (r.routines.map(routine_written) + r.values.map(code_of)).join("\n") + "\n"

# `double(n: int): int := n + n`; a function of no parameters a constant, `answer: int := 42`
routine_written(d: Routine): text := {
	head = if d.parameters is empty then d.name else "${d.name}(${d.parameters.map(p => "${p.name}: ${p.type}").join(", ")})"
	"${head}: ${d.result} := ${code_of(d.body)}"
}

code_of(r: Run): text := match r {
	Local(name) => name
	Global(name) => name
	Called(function, arguments) => "${code_of(function)}(${arguments.map(code_of).join(", ")})"
	Natural(value) => digits(value)
	Named(name, value, body) => "{ ${name} = ${code_of(value)}; ${code_of(body)} }"
	Host(spelling, arguments) => host_spelled(spelling, arguments.map(code_of))
}
