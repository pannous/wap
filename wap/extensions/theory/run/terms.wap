# Run terms (notes/coc-plan.md 5.1 "erase", 9.7 "What runs"): what a program the theory accepted runs, its types,
# proofs and levels gone. Erase (erase.wap) makes them of the kernel's terms, lower (lower.wap) writes them as plain
# wap. A run term names its variables, as wap does: the kernel's indices are gone with its binders' types.
use magnitude

enum Run {
	# a parameter or a let's name
	Local(name: text)
	# a function the program runs, one of its routines
	Global(name: text)
	Called(function: Run, arguments: list<Run>)
	Natural(value: Magnitude)
	# a value given a name for the body after it, `{ x = 1; x + x }`
	Named(name: text, value: Run, body: Run)
	# the alternative of the case the subject's value is, held under a name: a recursor of an enum whose cases take
	# apart no value of itself, `if` or a `match` without recursion
	Choose(subject: Run, held: text, alternatives: list<Alternative>)
	# what the host does in place of a function of the prelude (hosts.wap): its wap spelling with each argument at
	# its `$k`, `$1 + $2`
	Host(spelling: text, arguments: list<Run>)
}

# one alternative of a Choose: the host's test that the value is its case, the names of its fields with the host's
# spelling of each taken out of the value, its value; each spelling holds the value at `$1`
class Alternative { test: text; fields: list<text>; spellings: list<text>; body: Run }
# a parameter of a function as it runs: its name and the wap type that holds its values
class Typed { name: text; type: text }
# a function as it runs, its result's wap type and its body
class Routine { name: text; parameters: list<Typed>; result: text; body: Run }
# what a program runs: its functions, then the values its statements compute, the last one shown (sugar/calls.wap)
class Running {
	routines: list<Routine> = []
	values: list<Run> = []
}
