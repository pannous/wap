# The second checker (notes/theory.md "A second opinion"): `wap check.wap <export>` reads an export the theory door
# wrote and checks every statement again, by its own rules and with nothing of the kernel. Silent when it accepts
# the export; otherwise it prints the first refusal and exits with 1.
use "expressions.wap"
use "read.wap"
use "judge.wap"
use "blocks.wap"
use "bindings.wap"

REFUSED_EXIT := 1

environment = Environment()
try {
	for statement in statements_read(read(args#1)) {
		match statement {
			Declares(d) => admitted(environment, d)
			DeclaresBlock(block) => block_admitted(environment, block)
			Binds(word, names) => bound(environment, word, names)
		}
	}
} catch refusal {
	print refusal.message
	exit(REFUSED_EXIT)
}
