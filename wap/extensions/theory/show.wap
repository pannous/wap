# STAND-IN, never committed: theory-explicit's show.wap replaces it
use "terms.wap"
shown(t: Term): text := match t.shape {
	Bound(index) => "#${index}"
	Free(id) => "?${id}"
	Sort(level) => "Sort(${level_shown(level)})"
	Constant(name, levels) => if levels is empty then name else name + "[" + levels.map(level => level_shown(level)).join(", ") + "]"
	Apply(function, argument) => shown(function) + "(" + shown(argument) + ")"
	Lambda(binder, domain, body) => "(${binder}: ${shown(domain)}) => ${shown(body)}"
	Pi(binder, domain, body) => "((${binder}: ${shown(domain)}) -> ${shown(body)})"
	LetIn(binder, type, value, body) => "{ ${binder}: ${shown(type)} = ${shown(value)}; ${shown(body)} }"
	Numeral(value) => "${value}"
	Projection(structure, field, of) => shown(of) + ".${field}"
}
level_shown(level: Level): text := match level {
	Zero => "0"
	Successor(of) => level_shown(of) + "+1"
	Max(left, right) => "max(${level_shown(left)}, ${level_shown(right)})"
	Imax(left, right) => "imax(${level_shown(left)}, ${level_shown(right)})"
	Parameter(name) => name
}
