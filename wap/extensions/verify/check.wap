# `wap check [--strict] program.wap` (wiki/type.md "Proved or checked", wiki/cli.md), run as `check.wasm --seed <seed
# folder> program.wap` by the native wap or with `--tree <root>` (options.wap): the obligations the program's types
# leave, a warning each, once the laws it proves are facts. An obligation the provers prove, as a law of its function
# under the laws proved before it, is not listed (notes/coc-v3.md); `--strict` refuses the first one left.
use "laws.wap"
use "options.wap"
use "../../core/analyze/dispatch.wap"

UNPROVED_CONDITION := "refused by unproved condition: "
FAILED_EXIT := 1
# the name an obligation's statement is declared by, after its place in the list
OBLIGATION_LAW := "obligation "

# whether the provers prove an obligation's statement for every value of its function's parameters; one with no
# kernel term is left to the run
obligation_proved(obligation: Obligation, at: int): bool := {
	if obligation.statement != ø { return statement_proved(TYPES.environment, "${OBLIGATION_LAW}${at}", obligation.statement!) }
	type = obligation.function_type ?? return no
	value = obligation.value ?? return no
	statement_proved(TYPES.environment, "${OBLIGATION_LAW}${at}", law_statement(TYPES.environment, type, value, []))
}

try {
	arguments = door_arguments(args)
	laws = laws_typed(arguments.wap_folder, door_program(arguments))
	# each law's verdict declares the proved ones as theorems: the facts the obligations are proved under
	for law in laws { try typed_verdict(law) catch refusal { refusal_only(refusal) } }
	left = (1 to #obligations).filter(at => not obligation_proved(obligations#at, at)).map(at => obligations#at.line).unique()
	if arguments.strict and left is not empty { raise UNPROVED_CONDITION + left#1 }
	for line in left { print line }
} catch refusal { stopped_by(refusal) }
