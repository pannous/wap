# The laws of a program as analyze types them (wiki/law.md "Checking a law", notes/coc-t5.md): the program goes
# through the compile's front, each law the bool function of its binders (extensions/law_statements.wap), and analyze
# enters each pure function into its environment as a kernel definition (core/analyze/terms.wap). A law whose
# function the kernel holds defined gets the kernel's verdict; one whose function the kernel only assumes is refused
# naming the first function it calls that the kernel only assumes; one analyze refuses says why and gets none.
use "../../core/pipeline.wap"
use "../wasm/modules.wap"
use "../../core/bindings.wap"
use "../../core/stage.wap"
use "../../core/rules/stages.wap"
use "../../core/parse/cascade.wap"
use "../../core/parse/operator_table.wap"
use "../../core/analyze/declarations.wap"
use "../../core/errors.wap"
use "../../core/language.wap"
use "../../core/type_notation.wap"
use "../../kernel/terms.wap"
use "../../kernel/environment.wap"
use "../../kernel/typing.wap"
use "../../kernel/compute.wap"
use "../../kernel/show.wap"
use "../../kernel/numbers.wap"
use "../../kernel/equality.wap"
use "../../kernel/forms.wap"
use "../prove/prove.wap"
use "../../core/analyze/holes.wap"
use "../../core/analyze/terms.wap"

# the rules the front reads laws by, and the name each law's function takes
LAW_STATEMENT_RULES := "extensions/law_statements.wap"
LAW_FUNCTION := "law_"
# the refusal of a law that names what the kernel only assumes
ASSUMED_NAMED := "assumed function"
# the name of the hypothesis a subtype's binder brings, after the binder's
CONDITION_HOLDS_BINDER := "_holds"
# a law's proof marked beside its statement (law_statements.wap), and the proofs written: the statement computed, the
# provers given the laws named (wiki/proof.md)
PROOF_MARK := "law proof"
REFL_WORD := "refl"
BY_WORD := "by"
ASSUME_WORD := "assume"
AXIOM_WORD := "axiom"
AXIOMS_OF_WORD := "axioms_of"
# the refusal of a proof of no form verify reads
PROOF_REFUSED := "proof"

# a law analyze typed: its name, its function's key and id in the environment, the first function its body calls
# that the kernel only assumes, all found while analyze's names are in scope, and the ids of its hypotheses' functions
class TypedLaw { name: text; key: text; id: int?; assumed: text?; given: list<Premise> = []; proof: Node? = ø; refused: text? = ø }
# a law's hypothesis: its binder's name and the id of its function
class Premise { binder: text; id: int }
# the laws of a program, in the order they are stated, the compiler's answers to the questions the program asks at
# its top, and the names it asks the axioms of (wiki/proof.md "What a proof rests on"), answered once the laws are
# proved; a law analyze refuses, or one a hypothesis of which it refuses, says why on standard error
class LawsTyped { laws: list<TypedLaw>; answers: list<text>; asked: list<text> }
laws_typed(wap_folder: text, program: text): LawsTyped := {
	front = base_language()
	RULE_WORDS.said = yes
	modules_bringable(front)
	rules_files_loaded(front, wap_folder)
	based(front, in_folder(wap_folder, LAW_STATEMENT_RULES))
	types = types_declared(front, wap_folder)
	split = hypotheses_split(shaped_program(front, program_operated(front, program)), front)
	TYPES.refused = {}
	TYPES.axioms = split.axioms
	typed = typed_modules(front, [module_declared(declared_program(split.code))], types, program)
	refusals = TYPES.refused!
	TYPES.refused = ø
	keys: map<text, text> = {}
	for statement in statements_in(typed) { if statement is Define { keys[text(defined_name(statement))] = function_key(statement) } }
	laws: list<TypedLaw> = []
	for function in split.laws {
		name = if function.starts_with(LAW_FUNCTION) then function[#LAW_FUNCTION ..] else function
		given = split.given.get(function) ?? []
		parts = law_parts(function, given)
		why = parts.map(part => if keys.has(part) then refusals.get(keys[part]) else "typing left ${part} out").find(reason => reason != ø)
		held = if why == ø then given.filter(each => named_id(TYPES.environment, keys[each.function]) == ø) else []
		reason = why ?? (if held is empty then ø else "its hypothesis ${held#1.binder} is no statement the kernel holds")
		if reason != ø { laws += [TypedLaw(name, function, ø, ø, refused: reason)]; continue }
		key = keys[function]
		# an axiom of data, `axiom num: Type`, is a word and no law: only one stating a proposition has a verdict
		if taken_as(split.proofs.get(function) ?? symbol("")) == TypedVerdict.Axiom and not is_proposition(checker(TYPES.environment, []), declared_at(TYPES.environment, named_id(TYPES.environment, key)!)!.type) { continue }
		statement = statements_in(typed).find(statement => statement is Define and function_key(statement) == key)!
		laws += [TypedLaw(name, key, named_id(TYPES.environment, key), assumed_callee(TYPES.environment, statement), given.map(each => Premise(each.binder, named_id(TYPES.environment, keys[each.function])!)), split.proofs.get(function))]
	}
	# a definition no law holds that typing refused is a failed verdict of its own, `bad: refused by value type: …`
	laws_held = split.laws.flat_map(function => law_parts(function, split.given.get(function) ?? [])).filter(part => keys.has(part)).map(part => keys[part])
	for name in keys.keys { if refusals.has(keys[name]) and not laws_held.contains(keys[name]) { laws += [TypedLaw(name, keys[name], ø, ø, refused: refusals[keys[name]])] } }
	for key in refusals.keys { if not laws_held.contains(key) and not keys.values().contains(key) { eprint refusals[key] } }
	LawsTyped(laws, statements_in(typed).map(answer_in).filter(answer => has_fact(answer, ANSWERED)).map(answer => text(answer)), split.asked)
}
# a law's function and its hypotheses' functions
law_parts(function: text, given: list<Given>) as list<text> := [function] + given.map(each => each.function)
# A law's binder whose type is a statement, `h: a <= b`, is a hypothesis: the law's function takes the other binders,
# and each hypothesis is a function of them of its own, its statement, named after the law and the binder. Split as the
# shape rules wrote the law's function, before its names are declared: the code, the laws' functions in their order and
# each one's hypotheses' functions
LAW_GIVEN := " given "
class Split { code: Node; language: Language; laws: list<text> = []; given: map<text, list<Given>> = {}; proofs: map<text, Node> = {}; asked: list<text> = []; axioms: map<text, bool> = {} }
# a hypothesis as written: its binder's name and the name of its function
class Given { binder: text; function: text }
hypotheses_split(code: Node, language: Language) as Split := {
	split = Split(code, language)
	statements = top_level_statements(code).filter(statement => not axioms_asked(statement, split)).map(statement => proof_apart(statement, split)).flat_map(statement => hypotheses_apart(statement, split))
	# a lone law with hypotheses becomes several statements, so the code is a run of lines from then on
	split.code = refitted(if #statements == 1 then statements#1 else List(statements, Bracket.None, Separator.Newline), code)
	split
}
# the value a top-level statement gives, the program's last one shown through a variable
answer_in(statement: Node) as Node := match unwrapped(statement) { Set(place, value) => value; _ => statement }
# whether a statement asks the axioms of a name, `axioms of hard`, the name kept to answer after the proofs
axioms_asked(statement: Node, split: Split) as bool := match unwrapped(statement) {
	Key(called, applied, arguments) => if text(called) == AXIOMS_OF_WORD { split.asked += [text(items_of(arguments)#1)]; yes } else no
	_ => no
}
# a law's function whose statement has its proof beside it, the function of the statement alone and the proof kept
proof_apart(statement: Node, split: Split) as Node := {
	axiom = axiom_function(statement)
	if axiom != ø { split.laws += [axiom!]; split.proofs[axiom!] = symbol(AXIOM_WORD); split.axioms[axiom!] = yes; return statement }
	law = law_read(statement) ?? return statement
	match unwrapped(law.body) {
		Key(mark, applied, sides) => if text(mark) != PROOF_MARK then statement else {
			proof = items_of(sides)#2
			split.proofs[law.name] = proof
			# a proof that is a term, `choice(a)`, is the law's function itself, its statement its result type
			if is_term_proof(proof) then law_written(LawRead(law.defines, law.head, law.name, law.applied, law.arguments, items_of(sides)#1, proof), law.name, law.arguments, proof, statement) else law_written(law, law.name, law.arguments, items_of(sides)#1, statement)
		}
		_ => statement
	}
}
# the name of the function an axiom defines, its body the word axiom, `choice(a: Prop): a := axiom()`; ø for any other
# statement
axiom_function(statement: Node) as text? := match statement {
	Call(defines, parts) => if proof_word(called_word(parts#2)) == AXIOM_WORD then text(head_word(parts#1)) else ø
	_ => ø
}
# the word a call calls, `axiom` of `axiom()`, any other code itself
called_word(n: Node) as Node := match unwrapped(n) { Key(called, Op.None, group) => called; _ => n }
# the name a definition's head declares, `choice` of `choice(a: Prop): a` and of `num: Type`
head_word(declared: Node) as Node := match unwrapped(declared) { Key(head, Op.Colon, result) => called_word(head); _ => declared }
# A law's function as a statement defines it, `law_x(a: int) := …`, its result written or not: its parts, ø for any
# other statement
class LawRead { defines: Node; head: Node; name: text; applied: Op; arguments: Node; result: Node?; body: Node }
law_read(statement: Node) as LawRead? := match statement {
	Call(defines, parts) => {
		result = match parts#1 { Key(declared, Op.Colon, type) => type; _ => ø }
		head = match parts#1 { Key(declared, Op.Colon, type) => declared; _ => parts#1 }
		match unwrapped(head) {
			Key(name, applied, arguments) => if text(name).starts_with(LAW_FUNCTION) then LawRead(defines, head, text(name), applied, arguments, result, parts#2) else ø
			_ => ø
		}
	}
	_ => ø
}
# a law's function written again under a name, with these binders and this body, its result as the law wrote it
law_written(law: LawRead, name: text, arguments: Node, body: Node, at: Node) as Node := {
	head = refitted(Key(symbol(name), law.applied, arguments), law.head)
	refitted(Call(law.defines, [if law.result == ø then head else Key(head, Op.Colon, law.result!), body]), at)
}
hypotheses_apart(statement: Node, split: Split) as list := {
	law = law_read(statement) ?? return [statement]
	split.laws += [law.name]
	binders = items_of(law.arguments)
	names = binders.map(binder => text(declared_name(binder)))
	given = binders.filter(binder => is_hypothesis(binder, names, split.language))
	if given is empty { return [statement] }
	values = with_items(law.arguments, binders.filter(binder => not is_hypothesis(binder, names, split.language)))
	split.given[law.name] = given.map(binder => Given(text(declared_name(binder)), "${law.name}${LAW_GIVEN}${declared_name(binder)}"))
	[law_written(law, law.name, values, law.body, statement)] + given.map(binder => law_written(law, "${law.name}${LAW_GIVEN}${declared_name(binder)}", values, declared_type(binder)!, statement))
}
# whether a binder's annotation is a statement about the law's binders, a truth of them written with an operator of
# the language, `h: a <= b`, `h: not (a <= b)`, `h: a and b`; a type, `x: T` or `e: Even(n)`, is a word or a call of
# one, and a statement typing then finds no truth of is refused with its law
is_hypothesis(binder: Node, binders: list<text>, language: Language) as bool := {
	type = declared_type(binder) ?? return no
	nodes_in(type).any(part => unwrapped(part) is Symbol and binders.contains(text(part))) and match unwrapped(type) {
		Call(called, items) => operator_spelled(language, text(called)) != ø
		Symbol(name) => no
		_ => yes
	}
}

# A typed law's verdict, the kernel's: a law without binders holds where its function computes to yes and breaks
# where it computes to no; one with binders holds where the provers prove its statement yes for every value of them,
# the proof checked by the kernel; any other is left open, for the run to test. Refused where its function is only
# assumed, naming the first function its body calls that the kernel only assumes
enum TypedVerdict { Holds, Breaks, Open, Assumed, Axiom }
typed_verdict(law: TypedLaw): TypedVerdict := {
	e = TYPES.environment
	id = law.id ?? refused(ASSUMED_NAMED, "law ${law.name} is not typed")
	d = declared_at(e, id)!
	if law.proof != ø and taken_as(law.proof!) == TypedVerdict.Axiom { return TypedVerdict.Axiom }
	if d.kind is Axiom { refused(ASSUMED_NAMED, "law ${law.name} names ${law.assumed ?? law.key}, which the kernel only assumes: it may write, raise or act, so no law states it") }
	if law.proof != ø { return proof_checked(e, law, d, law.proof!) }
	if d.type.shape is Pi { return if law_proved(e, law, d) then Holds else Open }
	held = decided(e, constant(id, law.key, [])) ?? return Open
	if held then Holds else Breaks
}
# whether the provers prove a law's statement yes for every value of its binders, the proof declared as its theorem, of the law's own name, so a later proof uses it
law_proved(e: Environment, law: TypedLaw, d: Declaration): bool := {
	statement = law_statement(e, d.type, unfolding(d)!, law.given)
	proof = proof_found(elaboration(e, []), statement, []) ?? return no
	declared(e, Declaration(law.name, [], statement, Theorem(proof)))
	yes
}
# the kernel's constant of a declaration by its name, ø for a name it holds none of
declared_constant(name: text): Term? := constant(named_id(TYPES.environment, name) ?? return ø, name, [])
# the axioms a law declared by its name rests on, none for one declared by no name of its own
resting_on(name: text): list<text> := axioms_of(TYPES.environment, declared_constant(name) ?? return []).map(key_word)
# the answer to `axioms of name`, the axioms it rests on, a law computed to yes resting on none
axioms_said(name: text, laws: list<TypedLaw>): text := if declared_constant(name) == ø and not laws.any(law => law.name == name) then "axioms of ${name}: ${name} names no law, axiom or definition" else "[${resting_on(name).join(", ")}]"
# whether a law's proof is `assume`
is_assume(proof: Node?) as bool := proof_word(proof) == ASSUME_WORD
# a statement taken as true without a proof, an assume's or an axiom's verdict; ø for a proof
taken_as(proof: Node) as TypedVerdict? := if proof_word(proof) == ASSUME_WORD then Assumed else if proof_word(proof) == AXIOM_WORD then Axiom else ø
proof_word(proof: Node?) as text := match unwrapped(proof ?? return "") { Symbol(word) => word; _ => "" }
# a law's written proof made the term of its statement, declared as its theorem, which the kernel checks: a wrong one
# is refused by value type, naming the statement it proves and the one it should; `assume` declares the statement an
# axiom of the law's name, which every law resting on it names (wiki/proof.md "What a proof rests on")
proof_checked(e: Environment, law: TypedLaw, d: Declaration, proof: Node): TypedVerdict := {
	# a proof term the kernel took as the law's function proves its type, the statement
	if is_term_proof(proof) {
		declared(e, Declaration(law.name, [], d.type, Theorem(constant(law.id!, law.key, []))))
		return Holds
	}
	statement = law_statement(e, d.type, unfolding(d)!, law.given)
	taken = taken_as(proof)
	if taken != ø {
		declared(e, Declaration(law.name, [], statement, DeclarationKind.Axiom))
		return taken!
	}
	term = proof_term(e, statement, proof) ?? refused(PROOF_REFUSED, "law ${law.name} := ${proof}: a law's proof is ${REFL_WORD}, its statement computed, or ${BY_WORD} the laws it follows from")
	declared(e, Declaration(law.name, [], statement, Theorem(term)))
	Holds
}
proof_term(e: Environment, statement: Term, proof: Node): Term? := match unwrapped(proof) {
	Symbol(name) => if name == REFL_WORD then reflexive_under(e, statement) else ø
	_ => {
		named = by_named(proof) ?? return ø
		laws = named.map(law => declaration(e, text(law)) ?? refused(PROOF_REFUSED, "by ${law}: ${law} names no law proved before"))
		proof_found(elaboration(e, []), statement, laws) ?? refused(PROOF_REFUSED, "by ${named.join(", ")}: the provers find no proof of ${shown(statement)} from ${named.join(", ")}")
	}
}
# whether a proof is a term to check, `choice(a)` or `h`, not a word wap verify takes, `refl`, `axiom`, or `by` laws
is_term_proof(proof: Node) as bool := by_named(proof) == ø and not (proof_word(proof) in [REFL_WORD, AXIOM_WORD, ASSUME_WORD])
# the laws a `by` names, as the reader wrote them: `by a`, `by a, b`, `by(a, b)`; ø for another proof
by_named(proof: Node) as list<Node>? := match unwrapped(proof) {
	Key(called, applied, arguments) => if text(called) == BY_WORD then items_of(arguments) else ø
	List(items, bracket, separator) => match unwrapped(items#1) {
		Symbol(word) => if word == BY_WORD then items.drop(1) else ø
		_ => (by_named(items#1) ?? return ø) + items.drop(1)
	}
	_ => ø
}
# `Equal.refl` of a statement's left side, under each of its binders
reflexive_under(e: Environment, statement: Term): Term := match statement.shape {
	Pi(binder, domain, body) => lambda(binder, domain, reflexive_under(e, body))
	_ => {
		sides = arguments(statement)
		reflexive(e, TYPE_LEVEL, sides#1, sides#2)
	}
}
# `statement == yes` for every value of the binders of the law's function type, the statement its function's value
# at a variable for each binder, under its hypotheses, each the same of its function; each variable then bound by its
# binder, and a binder of a subtype followed by its condition's hypothesis, `Π n: nat, Π n_holds: (n >= 0) == yes`.
# The variables' ids are 1 up, as a definition's value is closed
law_statement(e: Environment, type: Term, value: Term, given: list<Premise>): Term := {
	parts = arrow_parts(type)
	names = binder_names(type)
	count = #parts - 1
	variables = (1 to count).map(at => free(at))
	holds = given.reverse.fold(proposition_of(e, beta(value, variables)), (body, each) => pi(each.binder, truth_stated(e, apply_all(constant(each.id, declared_at(e, each.id)!.name, []), variables)), body))
	(1 to count).reverse.fold(holds, (body, at) => pi(names#at, parts#at, abstracted(hypothesized(e, parts#at, free(at), names#at, body), at)))
}
# a statement under the hypothesis that a binder of a subtype holds its condition; as it is for any other binder
hypothesized(e: Environment, domain: Term, variable: Term, name: text, body: Term): Term := {
	if subset_condition(domain) == ø { return body }
	condition = condition_name(e, domain)!
	id = named_id(e, condition) ?? refused(ASSUMED_NAMED, "the condition of ${name}'s type, ${shown(domain)}, is no definition the kernel holds: it calls what the kernel only assumes, so no law over it is stated")
	pi(name + CONDITION_HOLDS_BINDER, truth_stated(e, apply(constant(id, condition, []), variable)), body)
}
# the first function a typed body calls whose instance the kernel only assumes, by its written name
assumed_callee(e: Environment, body: Node): text? := {
	for n in nodes_in(body) {
		found = callee_assumed(e, n)
		if found is not ø { return found }
	}
	ø
}
callee_assumed(e: Environment, call: Node): text? := match call {
	Call(called, arguments) => {
		id = named_id(e, place_key(fact_of(called, DEFINED_AT) ?? return ø)) ?? return ø
		if declared_at(e, id)!.kind is Axiom then text(called) else ø
	}
	_ => ø
}
