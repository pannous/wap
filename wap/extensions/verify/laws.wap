# The laws of a program as analyze types them (wiki/law.md "Checking a law", notes/coc-t5.md): the program goes
# through the compile's front, each law the bool function of its binders (extensions/law_statements.wap), and analyze
# enters each pure function into its environment as a kernel definition (core/analyze/terms.wap). A law whose
# function the kernel holds defined gets the kernel's verdict; one whose function the kernel only assumes is refused
# naming the first function it calls that the kernel only assumes; one analyze refuses says why and gets none.
use "../../core/pipeline.wap"
use "../wasm/modules.wap"
use "../../core/bindings.wap"
use "../../core/stage.wap"
use "../../core/rules/stages.wap"
use "../../core/parse/cascade.wap"
use "../../core/parse/operator_table.wap"
use "../../core/analyze/declarations.wap"
use "../../core/errors.wap"
use "../../core/language.wap"
use "../../core/type_notation.wap"
use "../../kernel/terms.wap"
use "../../kernel/environment.wap"
use "../../kernel/typing.wap"
use "../../kernel/compute.wap"
use "../../kernel/show.wap"
use "../../kernel/numbers.wap"
use "../../kernel/equality.wap"
use "../../kernel/forms.wap"
use "../prove/prove.wap"
use "../prove/goals.wap"
use "../../core/analyze/holes.wap"
use "../../core/analyze/terms.wap"
use "../../kernel/recursors.wap"

# the rules the front reads laws by, and the name each law's function takes
LAW_STATEMENT_RULES := "extensions/law_statements.wap"
LAW_FUNCTION := "law_"
# the refusal of a law that names what the kernel only assumes
ASSUMED_NAMED := "assumed function"
# the name of the hypothesis a subtype's binder brings, after the binder's
CONDITION_HOLDS_BINDER := "_holds"
# the refusal of a proof of no form verify reads
PROOF_REFUSED := "proof"
# the question a program asks of a name at its top, `axioms of hard`, answered once the laws are proved
AXIOMS_OF_WORD := "axioms_of"

# a law analyze typed: its name, its function's key and id in the environment, the first function its body calls
# that the kernel only assumes, all found while analyze's names are in scope, and the ids of its hypotheses' functions
class TypedLaw { name: text; key: text; id: int?; assumed: text?; given: list<Premise> = []; proof: Node? = ø; binders: list<text> = []; refused: text? = ø }
# a law's hypothesis: its binder's name and the id of its function
class Premise { binder: text; id: int }
# a program through the compile's front, its laws split off: what both doors read (verify.wap, check.wap)
class ProgramTyped { split: Split; typed: Node; refusals: map<text, text> }
program_typed(wap_folder: text, program: text): ProgramTyped := {
	front = base_language()
	modules_bringable(front)
	rules_files_loaded(front, wap_folder)
	based(front, in_folder(wap_folder, LAW_STATEMENT_RULES))
	types = types_declared(front, wap_folder)
	split = hypotheses_split(shaped_program(front, program_operated(front, program)), front)
	TYPES.refused = {}
	answer: (ByHole) -> Term? = (by: ByHole) => by_answer(by, split)
	TYPES.prove = answer
	typed = typed_modules(front, [module_declared(declared_program(split.code))], types, program)
	refusals = TYPES.refused!
	TYPES.refused = ø
	TYPES.prove = ø
	ProgramTyped(split, typed, refusals)
}
# the laws of a program, in the order they are stated: each law's bool function, each proof's @proof function, a law
# analyze refuses, or one a hypothesis of which it refuses, with why; the compiler's answers to the questions the
# program asks at its top, and the names it asks the axioms of (wiki/proof.md "What a proof rests on"), answered once
# the laws are proved
class LawsTyped { laws: list<TypedLaw>; answers: list<text>; asked: list<text> }
laws_typed(wap_folder: text, program: text): LawsTyped := {
	front = program_typed(wap_folder, program)
	split = front.split
	refusals = front.refusals
	defines = statements_in(front.typed).filter(statement => statement is Define)
	keys: map<text, text> = {}
	for statement in defines { keys[text(defined_name(statement))] = function_key(statement) }
	laws: list<TypedLaw> = split.laws.filter(function => not keys.has(function)).map(function => TypedLaw(function[#LAW_FUNCTION ..], function, ø, ø, refused: "typing left ${function} out"))
	for statement in defines {
		function = text(defined_name(statement))
		proof = proof_of(statement)
		if proof == ø and not split.laws.contains(function) { continue }
		name = if proof != ø then function else function[#LAW_FUNCTION ..]
		given = split.given.get(function) ?? []
		why = ([function] + given.map(each => each.function)).map(part => if keys.has(part) then refusals.get(keys[part]) else "typing left ${part} out").find(reason => reason != ø)
		if why != ø { laws += [TypedLaw(name, function, ø, ø, refused: why)]; continue }
		key = keys[function]
		id = (each: text) => named_id(TYPES.environment, keys[each])
		premised = premises(given, id)
		if premised == ø { laws += [TypedLaw(name, key, ø, ø, refused: "its hypothesis ${given.find(each => id(each.function) == ø)!.binder} is no statement the kernel holds")]; continue }
		laws += [TypedLaw(name, key, named_id(TYPES.environment, key), assumed_callee(TYPES.environment, statement), premised!, proof, split.binders.get(function) ?? [])]
	}
	LawsTyped(laws, statements_in(front.typed).map(answer_in).filter(answer => has_fact(answer, ANSWERED)).map(answer => text(answer)), split.asked)
}
# a proof's body, the definition of its law's @proof function (extensions/law_for.wap); ø for any other definition
proof_of(definition: Node) as Node? := if annotation(definition, PROOF_ANNOTATION) == ø then ø else match definition { Define(name, parameters, body) => body; _ => ø }
# the name a law's theorem has in the kernel: a proof's its function's key, a law's the law's own
kernel_name(law: TypedLaw): text := if law.proof == ø then law.name else law.key
# A law's binder whose type is a statement, `h: a <= b`, is a hypothesis: the law's function takes the other binders,
# and each hypothesis is a function of them of its own, its statement, named after the law and the binder. Split as the
# shape rules wrote the law's function, before its names are declared: the code, the laws' functions in their order and
# each one's hypotheses' functions, and each one's binders in their order
LAW_GIVEN := " given "
class Split { code: Node; language: Language; laws: list<text> = []; given: map<text, list<Given>> = {}; binders: map<text, list<text>> = {}; asked: list<text> = [] }
# a hypothesis as written: its binder's name and the name of its function
class Given { binder: text; function: text }
hypotheses_split(code: Node, language: Language) as Split := {
	split = Split(code, language)
	statements = top_level_statements(code).filter(statement => not axioms_asked(statement, split)).flat_map(statement => hypotheses_apart(statement, split))
	# a lone law with hypotheses becomes several statements, so the code is a run of lines from then on
	split.code = refitted(if #statements == 1 then statements#1 else List(statements, Bracket.None, Separator.Newline), code)
	split
}
# the value a top-level statement gives, the program's last one shown through a variable
answer_in(statement: Node) as Node := match unwrapped(statement) { Set(place, value) => value; _ => statement }
# whether a statement asks the axioms of a name, `axioms of hard`, the name kept to answer after the proofs
axioms_asked(statement: Node, split: Split) as bool := match unwrapped(statement) {
	Key(called, applied, arguments) => if text(called) == AXIOMS_OF_WORD { split.asked += [text(items_of(arguments)#1)]; yes } else no
	_ => no
}
hypotheses_apart(statement: Node, split: Split) as list := match statement {
	Call(defines, parts) => match parts#1 {
		Key(head, colon, result) => match unwrapped(head) {
			Key(name, applied, arguments) => {
				if not text(name).starts_with(LAW_FUNCTION) { return [statement] }
				split.laws += [text(name)]
				binders = items_of(arguments)
				names = binders.map(binder => text(declared_name(binder)))
				split.binders[text(name)] = names
				given = binders.filter(binder => is_hypothesis(binder, names, split.language))
				if given is empty { return [statement] }
				values = with_items(arguments, binders.filter(binder => not is_hypothesis(binder, names, split.language)))
				function = (called: text, value: Node) => refitted(Call(defines, [Key(refitted(Key(symbol(called), applied, values), head), colon, result), value]), statement)
				split.given[text(name)] = given.map(binder => Given(text(declared_name(binder)), "${name}${LAW_GIVEN}${declared_name(binder)}"))
				[function(text(name), parts#2)] + given.map(binder => function("${name}${LAW_GIVEN}${declared_name(binder)}", declared_type(binder)!))
			}
			_ => [statement]
		}
		_ => [statement]
	}
	_ => [statement]
}
# whether a binder's annotation is a statement about the law's binders, a truth of them written with an operator of
# the language, `h: a <= b`, `h: not (a <= b)`, `h: a and b`; a type, `x: T` or `e: Even(n)`, is a word or a call of
# one, and a statement typing then finds no truth of is refused with its law
is_hypothesis(binder: Node, binders: list<text>, language: Language) as bool := {
	type = declared_type(binder) ?? return no
	nodes_in(type).any(part => unwrapped(part) is Symbol and binders.contains(text(part))) and match unwrapped(type) {
		Call(called, items) => operator_spelled(language, text(called)) != ø
		Symbol(name) => no
		_ => yes
	}
}

# A typed law's verdict, the kernel's: a law without binders holds where its function computes to yes and breaks
# where it computes to no; one with binders holds where the provers prove its statement yes for every value of them,
# the proof checked by the kernel; any other is left open, for the run to test. Refused where its function is only
# assumed, naming the first function its body calls that the kernel only assumes
enum TypedVerdict { Holds, Breaks, Open, Assumed, Axiom }
typed_verdict(law: TypedLaw): TypedVerdict := {
	e = TYPES.environment
	id = law.id ?? refused(ASSUMED_NAMED, "law ${law.name} is not typed")
	d = declared_at(e, id)!
	if law.proof != ø { return proof_verdict(law, d) }
	if d.kind is Axiom { refused(ASSUMED_NAMED, "law ${law.name} names ${law.assumed ?? law.key}, which the kernel only assumes: it may write, raise or act, so no law states it") }
	if d.type.shape is Pi { return if law_proved(e, law, d) then Holds else Open }
	value = computed(checker(e, []), constant(id, law.key, []))
	if is_constant(value, e.literals!.yes_case) then Holds else if is_constant(value, e.literals!.no_case) then Breaks else Open
}
statement_of(e: Environment, law: TypedLaw, d: Declaration): Term := law_statement(e, d.type, unfolding(d)!, law.given)
# whether the provers prove a law's statement yes for every value of its binders, the proof declared as its theorem, of
# the law's own name, so a proof uses it; one a proof's `by` named is proved already (lemma_proved), its theorem
# declared of this statement, and a declaration of the name with any other type proves nothing of it
law_proved(e: Environment, law: TypedLaw, d: Declaration): bool := {
	statement = statement_of(e, law, d)
	proved = declaration(e, law.name)
	if proved != ø then proved!.type == statement else statement_proved(e, law.name, statement)
}
# whether the provers prove a statement, the proof declared as the theorem of this name
statement_proved(e: Environment, name: text, statement: Term): bool := {
	proof = proof_found(elaboration(e, []), statement, []) ?? return no
	declared(e, Declaration(name, [], statement, Theorem(proof)))
	yes
}
# the axioms a law declared by its name rests on, none for one declared by no name of its own
resting_on(name: text): list<text> := axioms_of(TYPES.environment, declared_constant(name) ?? return [])
# the kernel's constant of a declaration by its name, ø for a name it holds none of
declared_constant(name: text): Term? := constant(named_id(TYPES.environment, name) ?? return ø, name, [])
# whether a law's proof is `assume`
is_assume(proof: Node?) as bool := proof_word(proof) == ASSUME_WORD
# a statement taken as true without a proof, an assume's or an axiom's verdict; ø for a proof
taken_as(proof: Node) as TypedVerdict? := {
	at = TAKEN_WORDS.index_of(proof_word(proof))
	if at <= 0 then ø else [TypedVerdict.Assumed, TypedVerdict.Axiom]#at
}
proof_word(proof: Node?) as text := match unwrapped(proof ?? return "") { Symbol(word) => word; _ => "" }
# A proof's verdict: the kernel took its function's value, the proof, as of the statement its result states (core
# checks it as it enters the function), so it holds; an assumed one is an assume's or an axiom's statement taken as
# true, which every law resting on it names (wiki/proof.md "What a proof rests on"), or a proof of no form verify reads
proof_verdict(law: TypedLaw, d: Declaration): TypedVerdict := if not d.kind is Axiom then Holds else taken_as(law.proof!) ?? refused(PROOF_REFUSED, "law ${law.name} := ${law.proof!}: a law's proof is ${REFL_WORD}, its statement computed, or ${BY_WORD} the laws it follows from")
# A `by`'s proof (core/analyze/terms.wap by_term): the provers given the laws it names and the binders around it
by_answer(by: ByHole, split: Split): Term? := {
	e = TYPES.environment
	names = by.laws.map(law => text(law))
	laws = by.laws.map(law => lemma(e, text(law), by.function, split) ?? refused(PROOF_REFUSED, unproved_named(law, by.function)))
	elaborated_over(by.c, el => filled(el, first_proof(Goal(el, by.context, by.type, laws), PROVERS) ?? refused(PROOF_REFUSED, "by ${names.join(", ")}: the provers find no proof of ${shown(by.type)} from ${names.join(", ")}")))
}
# the law a `by` names: the program's function of the name, a proof; a declaration of it, the prelude's theorem; or the
# program's law of it, its statement proved now
lemma(e: Environment, name: text, function: (text) -> Term?, split: Split): Declaration? := {
	found = function(name)
	if found != ø { return declared_at(e, constant_id(found!)) }
	declaration(e, name) ?? lemma_proved(e, name, function, split)
}
# a law's hypotheses as premises, each the id of its function's declaration as `id` finds it; ø where one has none
premises(written: list<Given>, id: (text) -> int?) as list<Premise>? := {
	ids = written.map(each => id(each.function))
	if ids.any(found => found == ø) then ø else (1 to #written).list().map(at => Premise(written#at.binder, ids#at!))
}
# (with its hypotheses' functions as the split wrote them, so it states what its own verdict reads)
lemma_proved(e: Environment, name: text, function: (text) -> Term?, split: Split): Declaration? := {
	law = declared_at(e, constant_id(function(LAW_FUNCTION + name) ?? return ø))!
	given = premises(split.given.get(LAW_FUNCTION + name) ?? [], each => constant_id(function(each) ?? return ø)) ?? return ø
	if statement_proved(e, name, law_statement(e, law.type, unfolding(law) ?? return ø, given)) then declaration(e, name) else ø
}
# why a law a `by` names is no lemma: a law stated but not proved proves nothing, any other name is no law
unproved_named(law: Node, function: (text) -> Term?): text := if function(LAW_FUNCTION + text(law)) is ø then "by ${law}: ${law} names no law proved before" else "refused by unproved law: ${law} is Tested, so it proves nothing"
# A law's statement over its function's binders as the kernel states it: each parameter, one of a subtype followed by
# its condition holding, then each hypothesis at the parameters, over `statement == yes`, its function's value at them,
# `Π n: nat, Π n_holds: (n >= 0) == yes, …`
law_statement(e: Environment, type: Term, value: Term, given: list<Premise>): Term := {
	c = checker(e, [])
	parts = arrow_parts(type)
	names = binder_names(type)
	parameters = (1 to #parts - 1).map(at => entered(c, names#at, parts#at))
	values = variables(parameters)
	hypotheses = given.map(each => entered(c, each.binder, truth_stated(e, apply_all(constant(each.id, declared_at(e, each.id)!.name, []), values))))
	pis(parameters.flat_map(parameter => [parameter] + condition_held(e, c, parameter)) + hypotheses, proposition_of(e, beta(value, values)))
}
condition_held(e: Environment, c: Checker, parameter: Local): list<Local> := {
	if subset_condition(parameter.domain) == ø { return [] }
	condition = condition_name(e, parameter.domain)!
	id = named_id(e, condition) ?? refused(ASSUMED_NAMED, "the condition of ${parameter.binder}'s type, ${shown(parameter.domain)}, is no definition the kernel holds: it calls what the kernel only assumes, so no law over it is stated")
	[entered(c, parameter.binder + CONDITION_HOLDS_BINDER, truth_stated(e, apply(constant(id, condition, []), parameter.variable)))]
}
# the first function a typed body calls whose instance the kernel only assumes, by its written name
assumed_callee(e: Environment, body: Node): text? := {
	for n in nodes_in(body) {
		found = callee_assumed(e, n)
		if found is not ø { return found }
	}
	ø
}
callee_assumed(e: Environment, call: Node): text? := match call {
	Call(called, arguments) => {
		id = named_id(e, place_key(fact_of(called, DEFINED_AT) ?? return ø)) ?? return ø
		if declared_at(e, id)!.kind is Axiom then text(called) else ø
	}
	_ => ø
}
