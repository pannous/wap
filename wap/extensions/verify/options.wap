# wap verify's arguments (notes/theory.md "The door"): the wap folder it reads the language from, given as
# `--tree <root>`, a wap tree whose wap/ it is, or `--seed <folder>`, a seed folder, which holds the same; wherever it
# stands; and the programs, one for a door that reads one. Anything else is refused with the usage
use "../../core/pipeline.wap"

TREE_OPTION := "--tree"
SEED_OPTION := "--seed"
# `--run-rules <file>`: where wap verify writes the rules the law run reads its laws with hypotheses by
RUN_RULES_OPTION := "--run-rules"
# what an option starts with, never a program's path
OPTION_MARK := "--"
# the folder of wap's sources under the folder an option names
WAP_IN_TREE := "wap"
NO_TREE := "the theory needs ${TREE_OPTION} <wap tree> or ${SEED_OPTION} <seed folder>"
class DoorArguments { wap_folder: text; programs: list<text>; run_rules: text = "" }
# an option's value and the arguments without the two, "" where the option is not given
class Taken { value: text; rest: list<text> }
option_taken(given: list<text>, options: list<text>): Taken := {
	at = (1 to #given).find(place => options.contains(given#place)) ?? return Taken("", given)
	if at == #given { raise "${given#at} takes a value" }
	Taken(given#(at + 1), given.take(at - 1) + given.drop(at + 1))
}
door_arguments(given: list<text>): DoorArguments := {
	run_rules = option_taken(given, [RUN_RULES_OPTION])
	folder = option_taken(run_rules.rest, [TREE_OPTION, SEED_OPTION])
	if folder.value == "" { raise NO_TREE }
	stray = folder.rest.find(program => program.starts_with(OPTION_MARK))
	if stray is not ø { raise "${stray!} is no option: ${NO_TREE}" }
	DoorArguments(if run_rules.rest.contains(TREE_OPTION) then in_folder(folder.value, WAP_IN_TREE) else folder.value, folder.rest, run_rules.value)
}
# the one program of a door that reads one
door_program(arguments: DoorArguments): text := {
	if #arguments.programs != 1 { raise "a theory door takes one program besides ${TREE_OPTION} <wap tree>, not: ${arguments.programs.join(" ")}" }
	arguments.programs#1
}
