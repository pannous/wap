# The verdicts `wap verify` prints after a law's name (verify.wap), which the native driver reads back and joins with
# the run's (native/driver.wap)
PROVED := "Proved"
TESTED := "Tested"
UNTESTED := "Untested"
ASSUMED := "Assumed"
AXIOM := "Axiom"
BROKEN := "FAILED"
VERDICT_WORDS := [PROVED, TESTED, BROKEN, UNTESTED, ASSUMED, AXIOM]
