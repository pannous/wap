# `wap verify program.wap` (wiki/law.md "Checking a law", wiki/proof.md "Checking proofs"), run as `verify.wasm
# --seed <seed folder> program.wap` by the native wap or with `--tree <root>` (options.wap): one verdict per law the
# program states, in their order, the kernel's (laws.wap), after the answers to the questions it asks at its top.
# Proved: its function computes to yes, or the provers proved it for every value of its binders and the kernel checked
# the proof. FAILED: it computes to no. Untested: the kernel leaves it open, and the run's verdict stands in its place
# (native/driver.wap). A refusal is printed in its law's place; the first refusal of the program ends the run. The run
# fails when a law does.
use "laws.wap"
use "options.wap"
use "../../kernel/environment.wap"

PROVED := "Proved"
UNTESTED := "Untested"
ASSUMED := "Assumed"
AXIOM := "Axiom"
BROKEN := "FAILED"
FAILED_EXIT := 1

RESTS_ON := ", rests on "

# a law's verdict as printed, or the refusal that leaves it none, and whether it fails the run: a broken law does, and
# one whose typing is refused; a proved law resting on an assume is Assumed, one resting on axioms names them
# (wiki/proof.md "What a proof rests on")
class Shown { said: text; fails: bool = no }
verdict(law: TypedLaw, assumed: list<text>): Shown := {
	if law.refused != ø { return Shown("${law.name}: ${law.refused!}", yes) }
	typed = try typed_verdict(law) catch refusal {
		refusal_only(refusal)
		return Shown(refusal.message)
	}
	Shown("${law.name}: ${match typed { Holds => proved_said(law.name, assumed); Breaks => BROKEN; Open => UNTESTED; Assumed => ASSUMED; Axiom => AXIOM }}", typed == TypedVerdict.Breaks)
}
proved_said(name: text, assumed: list<text>): text := {
	resting = resting_on(name)
	if resting.any(axiom => assumed.contains(axiom)) then ASSUMED else if resting is empty then PROVED else PROVED + RESTS_ON + resting.join(", ")
}

try {
	arguments = door_arguments(args)
	typed = laws_typed(arguments.wap_folder, door_program(arguments))
	assumed = typed.laws.filter(law => is_assume(law.proof)).map(law => law.name)
	verdicts = typed.laws.map(law => verdict(law, assumed))
	for answer in typed.answers + typed.asked.map(name => axioms_said(name, typed.laws)) { print answer }
	for shown in verdicts { print shown.said }
	if verdicts.any(shown => shown.fails) { exit(FAILED_EXIT) }
} catch refusal { stopped_by(refusal) }
