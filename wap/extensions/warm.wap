# The compiler's warm state (wap#42, decision wap-packed-library): every file it reads before a program, its rules and
# its types module, operated once and packed (extensions/packed.wap), so a compiled compiler brings them in from its
# own bytes and reads no source; a source is read only where no warm state was baked. Each file is kept by its path in
# the wap folder, so a state written in one folder holds in any other.
use "packed.wap"
use "../core/pipeline.wap"
use "../core/paths.wap"
use "../core/stage.wap"
use "../core/language.wap"
use "../core/rules/stages.wap"

# the files the language read so far, packed: [path: [code, [word, …]], …]
warm_state(language: Language, wap_folder: text) as text := pack(List(language.operated.keys.map(file => Key(Text(inside(wap_folder, file)), Op.Colon, List([language.operated[file].code, List(language.operated[file].words.map(word => Text(word)), Bracket.Square, Separator.Comma)], Bracket.Square, Separator.Comma))), Bracket.Square, Separator.Comma))

# a packed warm state brought in: each file's code operated already, found by its path in this wap folder; an empty one
# brings nothing, so the files are read
warm_brought(language: Language, wap_folder: text, state: text) := {
	if state == "" { return }
	match unpack(state) {
		List(files, bracket, separator) => for file in files { match file { Key(Text(path), op, List(kept, square, comma)) => language.operated[in_folder(wap_folder, path)] = Operated(kept#1, items_of(kept#2).map(word => text(word))); _ => raise "warm state: no file entry: ${text(file)}" } }
		_ => raise "warm state: no list of files"
	}
}

# rules built from warm files were checked when the state was written: their termination is not checked again
rules_checked(language: Language) := { for stage in [SHAPE_STAGE, DECLARED_STAGE, TYPED_STAGE] { rules_of_stage(language, stage).checked = yes } }

# a file's path inside the wap folder
inside(wap_folder: text, file: text) as text := {
	folder = normalized_path(wap_folder)
	prefix = if folder == "." then "" else folder + "/"
	if file.starts_with(prefix) then file[#prefix ..] else raise "warm state: ${file} lies outside ${folder}"
}
