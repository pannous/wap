# The compiler's warm state (wap#42, decision wap-packed-library): every file it reads before a program, its rules and
# its types module, operated once and packed (extensions/packed.wap), so a compiled compiler brings them in from its
# own bytes and reads no source; a source is read only where no warm state was baked. Every path in it, a file's and
# each place's, is kept inside the wap folder, so a state written in one folder holds in any other.
use "packed.wap"
use "../core/pipeline.wap"
use "../core/paths.wap"
use "../core/stage.wap"
use "../core/language.wap"
use "../core/analyze/declarations.wap"
use "../core/bindings.wap"
use "../core/parse/operator_table.wap"
use "../core/rules/patterns.wap"

# what stands for the wap folder in a written path
WAP_FOLDER_MARK = "<wap>/"
# the entry beside the files' that holds the standard library's words
STANDARD_ENTRY = "<standard>"
# the library's folders whose modules only a `use` brings in, never their words (wiki/use.md "Library folders")
USED_ONLY = ["extra", "host"]

# the files the language read so far, packed: [path: [code, [word, …]], …], and the standard library's words, each
# with the module defining it: <standard>: [word: path, …]
warm_state(language: Language, wap_folder: text) as text := pack(List(language.operated.keys.map(file => Key(Text(file), Op.Colon, List([language.operated[file].code, List(language.operated[file].words.map(word => Text(word)), Bracket.Square, Separator.Comma)], Bracket.Square, Separator.Comma))) + [standard_entry(language, wap_folder)], Bracket.Square, Separator.Comma), path => marked(wap_folder, path))
standard_entry(language: Language, wap_folder: text) as Node := Key(Text(STANDARD_ENTRY), Op.Colon, List(standard_signatures(language, wap_folder).map(signature => Key(Text(signature.name), Op.Colon, Text(signature.module))), Bracket.Square, Separator.Comma))
# the words the standard library's modules define at their tops, each naming its module: read from the sources by a
# compiler without a warm state, so a cold and a warm compile know the same words
standard_signatures(language: Language, wap_folder: text) as list<Signature> := standard_files(in_folder(wap_folder, LIBRARY_FOLDER)).flat_map(file => unique(words_named(read_notation(language, file))).map(word => standard_signature(word, file)))
standard_signature(word: text, file: text) as Signature := Signature(word, word, DefinitionKind.Standard, Text(file), module: file)
# the standard library's modules: its own and those of its folders, but the folders only a `use` brings in
standard_files(library: text) as list<text> := ([library] + list_files(library).filter(entry => not entry.contains(".") and not (entry in USED_ONLY)).map(entry => library + "/" + entry)).flat_map(folder => list_files(folder).filter(name => name.ends_with(".wap")).map(name => folder + "/" + name))

# a packed warm state brought in: each file's code operated already, found by its path in this wap folder; an empty one
# brings nothing, so the files are read
warm_brought(language: Language, wap_folder: text, state: text) := {
	if state == "" { return }
	match unpack(state, path => unmarked(wap_folder, path)) {
		List(files, bracket, separator) => for file in files { match file {
			Key(Text(path), op, List(kept, square, comma)) => if path == STANDARD_ENTRY { language.standard = kept.map(standard_word) } else { language.operated[path] = Operated(kept#1, items_of(kept#2).map(word => text(word))) }
			_ => raise "warm state: no file entry: ${text(file)}"
		} }
		_ => raise "warm state: no list of files"
	}
}

# a word of the standard library, as its entry holds it, `primes: "<wap>/lib/math.wap"`
standard_word(entry: Node) as Signature := match entry {
	Key(Text(word), op, Text(file)) => Signature(word, word, DefinitionKind.Standard, Text(file), module: file)
	_ => raise "warm state: no standard word: ${text(entry)}"
}

# a path inside the wap folder with the folder's mark in its place, `<wap>/types/rules.wap`; any other text as it is
marked(wap_folder: text, path: text) as text := {
	prefix = in_folder(wap_folder, "") + "/"
	if path.starts_with(prefix) then WAP_FOLDER_MARK + path[#prefix ..] else path
}
unmarked(wap_folder: text, path: text) as text := if path.starts_with(WAP_FOLDER_MARK) then in_folder(wap_folder, path[#WAP_FOLDER_MARK ..]) else path

# rules built from warm files were checked when the state was written: their termination is not checked again
rules_checked(language: Language) := { for stage in [SHAPE_STAGE, DECLARED_STAGE, TYPED_STAGE] { rules_of_stage(language, stage).checked = yes } }
