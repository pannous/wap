# The compiler's warm state (wap#42, decision wap-packed-library): every file it reads before a program, its rules and
# its types module, operated once, and the library's modules lowered once, packed (extensions/packed.wap), so a compiled compiler brings them in from its
# own bytes and reads no source; a source is read only where no warm state was baked. Every path in it, a file's and
# each place's, is kept inside the wap folder, so a state written in one folder holds in any other.
use "packed.wap"
use "../core/pipeline.wap"
use "../core/paths.wap"
use "../core/stage.wap"
use "../core/errors.wap"
use "../core/language.wap"
use "../core/analyze/declarations.wap"
use "../core/analyze/modules.wap"
use "../core/bindings.wap"
use "../core/parse/operator_table.wap"
use "../core/rules/patterns.wap"
use "../kernel/forms.wap"

# what stands for the wap folder in a written path
WAP_FOLDER_MARK = "<wap>/"
# the entry beside the files' that holds the standard library's words
STANDARD_ENTRY = "<standard>"
# the entry beside the files' that holds the library's modules lowered
LOWERED_ENTRY = "<lowered>"
# the entry beside the files' that holds the files read in order, whose places number them in the ids of their code
NUMBERS_ENTRY = "<numbers>"
# the library's folders whose modules only a `use` brings in, never their words (wiki/use.md "Library folders")
USED_ONLY = ["extra", "host"]
# the standard modules whose words every program has, named without a hint (wiki/standard-library.md "list")
USE_FREE_MODULES = ["list", "text", "map"]

# the files the language read so far, packed: [path: [code, [word, …], declared code where it was declared], …], and the standard library's words, each
# with the modules defining it: <standard>: [word: [path, …], …], and the library's modules lowered: <lowered>: [path:
# code, …], and the files read in order: <numbers>: [path, …]
warm_state(language: Language, wap_folder: text, types: Module) as text := {
	# the library lowered first: lowering declares the modules the types module uses, which their entries then carry
	lowered = lowered_entry(language, types)
	pack(List(language.operated.keys.map(file => file_entry(file, language.operated[file])) + [standard_entry(language, wap_folder), lowered, Key(Text(NUMBERS_ENTRY), Op.Colon, List(sources_read.keys.map(file => Text(file)), Bracket.Square, Separator.Comma))], Bracket.Square, Separator.Comma), path => marked(wap_folder, path))
}
# a file's entry: its operated code, its words, and its declared code where it was declared (a module's wap section
# holds its files so too, extensions/wasm/modules.wap)
file_entry(file: text, operated: Operated) as Node := Key(Text(file), Op.Colon, List([operated.code, List(operated.words.map(word => Text(word)), Bracket.Square, Separator.Comma)] + (if operated.declared == ø then [] else [operated.declared!]), Bracket.Square, Separator.Comma))
# a file's entry brought in: its code operated already, and declared where it was
file_brought(language: Language, path: text, kept: list<Node>) := { language.operated[path] = Operated(kept#1, items_of(kept#2).map(word => text(word)), ø, if #kept > 2 then kept#3 else ø) }
# the library's modules, the types module and those it uses, each lowered as a compile lowers it
lowered_entry(language: Language, types: Module) as Node := {
	uses = used_modules(language, types.code)
	Key(Text(LOWERED_ENTRY), Op.Colon, List((uses + [types]).map(module => Key(Text(module_key(module.file)), Op.Colon, lowered_module(language, module, uses, types))), Bracket.Square, Separator.Comma))
}
standard_entry(language: Language, wap_folder: text) as Node := {
	standard = standard_words(language, wap_folder)
	Key(Text(STANDARD_ENTRY), Op.Colon, List(standard.keys.map(word => Key(Text(word), Op.Colon, List(standard[word].map(file => Text(file)), Bracket.Square, Separator.Comma))), Bracket.Square, Separator.Comma))
}
# the words the standard library's modules define at their tops, each with the modules defining it: read from the
# sources by a compiler without a warm state, so a cold and a warm compile know the same words; read by a language of
# their own, so the files their uses bring stay out of the compile and its warm state
standard_words(language: Language, wap_folder: text) as map<text, list<text>> := {
	standard: map<text, list<text>> = {}
	reading = base_language()
	reading.build.bringers = language.build.bringers
	for file in standard_files(library_of(wap_folder)) {
		for word in unique(words_named(read_notation(reading, file))) { standard[word] = (if standard.has(word) then standard[word] else []) + [file] }
	}
	standard
}
# the standard library's modules: its own and those of its folders, but the folders only a `use` brings in
standard_files(library: text) as list<text> := ([library] + listed_in(library).filter(entry => not entry.contains(".") and not (entry in USED_ONLY)).map(entry => library + "/" + entry)).flat_map(folder => listed_in(folder).filter(name => name.ends_with(".wap")).map(name => folder + "/" + name))

# a packed warm state brought in: each file's code operated already, and declared where it was, so no compile shapes
# the library again (trusted as built, as its lowered modules are), found by its path in this wap folder; an empty one
# brings nothing, so the files are read
warm_brought(language: Language, wap_folder: text, state: text) := {
	if state == "" { return }
	match unpack(state, path => unmarked(wap_folder, path)) {
		List(files, bracket, separator) => for file in files { match file {
			Key(Text(path), op, List(kept, square, comma)) => if path == STANDARD_ENTRY { held = HeldModules(); for word in kept { standard_word_brought(language, word, held) } } else if path == LOWERED_ENTRY { for module in kept { lowered_brought(language, module) } } else if path == NUMBERS_ENTRY { for numbered in kept { file_number(text(numbered)) } } else { file_brought(language, path, kept) }
			_ => raise "warm state: no file entry: ${text(file)}"
		} }
		_ => raise "warm state: no list of files"
	}
}

# a word of the standard library, as its entry holds it, `primes: ["<wap>/lib/math.wap"]`
standard_word_brought(language: Language, entry: Node, held: HeldModules) := match entry {
	Key(Text(word), op, files) => language.build.standard[word] = items_of(files).map(file => held_module(text(file), held))
	_ => raise "warm state: no standard word: ${text(entry)}"
}

# a standard module as the library holds it: its source, else the module compiled from it (a seed folder holds no
# source, scripts/refresh-seed.sh); each file's module found once, each folder listed once
class HeldModules { modules: map<text, text> = {}, listings: map<text, list<text>> = {} }
held_module(file: text, held: HeldModules) as text := {
	if not held.modules.has(file) {
		folder = folder_of(file)
		if not held.listings.has(folder) { held.listings[folder] = listed_in(folder) }
		held.modules[file] = (named_in(file_module_name(file), folder, held.listings[folder]) + [file])#1
	}
	held.modules[file]
}
# a library module lowered, as its entry holds it, `"<wap>/types.wasm": code`
lowered_brought(language: Language, entry: Node) := match entry {
	Key(Text(file), op, Block(statements)) => language.lowered[file] = Block(statements)
	_ => raise "warm state: no lowered module: ${text(entry)}"
}

# a path inside the wap folder with the folder's mark in its place, `<wap>/types/rules.wap`; any other text as it is
marked(wap_folder: text, path: text) as text := {
	prefix = in_folder(wap_folder, "") + "/"
	if path.starts_with(prefix) then WAP_FOLDER_MARK + path[#prefix ..] else path
}
unmarked(wap_folder: text, path: text) as text := if path.starts_with(WAP_FOLDER_MARK) then in_folder(wap_folder, path[#WAP_FOLDER_MARK ..]) else path

# rules built from warm files were checked when the state was written: their termination is not checked again
rules_checked(language: Language) := { for stage in RULE_STAGES { rules_of_stage(language, stage).unchecked = [] } }
