# The library compiled once (notes/compile_inputs.md): the types module beside the compiler as the module types.wasm,
# which a program reads as a module used (modules.wap: its export names declare its functions) instead of the types
# module's source. The build that writes the module vouches for it, as it does for the compiler beside it: a compile
# reads no library source to check it.
use "modules.wap"
use "../../core/pipeline.wap"
use "../../core/emit/wasm.wap"
use "../../core/paths.wap"
use "../../core/stage.wap"
use "../../core/emit/functions.wap"
use "../../core/analyze/types.wap"
use "../../kernel/forms.wap"

# beside the compiler, carrying the files it uses (modules.wap carried_files), so it reads no source
LIBRARY_MODULE = "types.wasm"
# the custom section naming the folder of the compiler a module was compiled by, where a host looks for a module it
# imports by a bare name, before the importer's folder, as a dynamic linker reads its rpath: a program finds the library
# of the compiler that built it
COMPILER_SECTION = "wap.compiler"

# the file of the folder the library is read from: the module beside the compiler, else the source; the types module
# compiled as the program reads the source
library_file(folder: text, program: text) as text := {
	module = in_folder(folder, LIBRARY_MODULE)
	if is_library(folder, program) or not names_beside(module).contains(LIBRARY_MODULE) then TYPES_FILE else LIBRARY_MODULE
}
# the files the library carries, when the types module is the one compiled
library_carried(folder: text, program: text) as list<text> := if is_library(folder, program) then carried_files(program) else []
# the module a program shares its raise tag with: the library when it is read compiled (which defines its tag even
# where it raises nothing), so a raise in it or in a module compiled against it is caught in the program; else none,
# the program's tag its own
raise_module(folder: text, library: text) as text := if library == LIBRARY_MODULE then bare_or_path(in_folder(folder, LIBRARY_MODULE)) else ""
# whether the program compiled is the library, the types module
is_library(folder: text, program: text) as bool := module_key(program) == module_key(in_folder(folder, TYPES_FILE))
# a module's bytes with the folder of the compiler that compiled it (COMPILER_SECTION)
compiled_by(folder: text, compiled: list<int>) as list<int> := compiled + custom_section(COMPILER_SECTION, normalized_path(folder).bytes)
