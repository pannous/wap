# The library compiled once (notes/compile_inputs.md): the types module compiled as the module types.wasm, which a
# program reads as a module used (modules.wap: its export names declare its functions) instead of the types module's
# source. The compiler holds the library it was built with in its own bytes (compiler.wap LIBRARY), so no file beside
# it can drift from it, and writes it once beside itself, named by its hash, where a module compiled against it links it
# by that path, so another compiler's library is never linked in its place.
use "modules.wap"
use "../../core/pipeline.wap"
use "../../core/emit/wasm.wap"
use "../../core/paths.wap"
use "../../core/stage.wap"
use "../../core/emit/functions.wap"
use "../../core/analyze/types.wap"
use "../../kernel/forms.wap"

# where the library stands among the compiler's files, carrying the files it uses (modules.wap carried_files), so it
# reads no source
LIBRARY_MODULE = "types.wasm"
# the library compiled in the fast build mode (compiler.wap FAST_COMMAND), its ints words that wrap, beside the compiler
# where a fast compile of the types module wrote it (the native wap makes it once, extensions/native/programs.wap)
FAST_LIBRARY_MODULE = "types-fast.wasm"

# the fast library's bytes, empty where none was written yet: the types module is then compiled with the program
fast_library(folder: text) as text := if exists(in_folder(folder, FAST_LIBRARY_MODULE)) then read(in_folder(folder, FAST_LIBRARY_MODULE)) else ""
# the library's bytes held; empty bytes hold nothing
library_held(folder: text, bytes: text) := { if bytes { held_modules[in_folder(folder, LIBRARY_MODULE)] = bytes } }
# the file of the folder the library is read from: the module held, else the source; the types module compiled as the
# program reads the source
library_file(folder: text, program: text) as text := if is_library(folder, program) or not held_modules.has(in_folder(folder, LIBRARY_MODULE)) then TYPES_FILE else LIBRARY_MODULE
# the files the library carries, when the types module is the one compiled
library_carried(folder: text, program: text) as list<text> := if is_library(folder, program) then carried_files(program) else []
# the module a program shares its raise tag with: the library when it is read compiled (which defines its tag even
# where it raises nothing), so a raise in it or in a module compiled against it is caught in the program; else none,
# the program's tag its own
raise_module(folder: text, library: text) as text := if library == LIBRARY_MODULE then linked_name(in_folder(folder, LIBRARY_MODULE)) else ""
# whether the program compiled is the library, the types module
is_library(folder: text, program: text) as bool := library_place(program) == library_place(in_folder(folder, TYPES_FILE))
