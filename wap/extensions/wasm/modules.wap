# A compiled module used as source (wiki/wasm-representation.md "Export names"): `use "m.wasm"` reads m's export
# section, where each function's name is its header line, `add(a: int, b: int = 1) → int`, and declares each as a
# function of m, a foreign primitive the host links by m's path (core/emit/host.wap foreign_imported). What wasm erases
# travels in m's wap section as wap source, read before the exports' declarations.
use "../../kernel/forms.wap"
use "../../core/parse/cascade.wap"
use "../../core/analyze/calls.wap"
use "../../core/analyze/declarations.wap"
use "../../core/emit/opcodes.wap"
use "../../core/emit/wasm.wap"
use "../../core/stage.wap"
use "../../core/paths.wap"
use "../../core/parse/reader.wap"

# the bytes before the first section (magic and version)
PREAMBLE_BYTES = 8
# what a header line writes before its result type, and the high bit of a LEB128 byte, set on all but the last
RESULT_ARROW = " → "
MORE_BYTES = 128
# the parts of the names of wasm's instructions on the linear memory
MEMORY_OPERATIONS = [".load", ".store", "memory."]

# the source a compiled module stands for: its wap section, then a definition of each function and value it exports
# under its header line, the module named as the host finds it (bare_or_path)
wasm_source(path: text) as text := {
	bytes = read(path)
	named = bare_or_path(path)
	([custom_text(bytes, WAP_SECTION)] + exports_of(bytes).map(item => if item.kind == GLOBAL_KIND then foreign_value(named, item.header) else foreign_definition(named, item.header))).join("\n")
}
# a module beside the compiler by its bare name, which the host looks up beside the module importing it and then
# beside the compiler, so a program and the compiler's folder move freely; any other by its path
bare_or_path(path: text) as text := if folder_of(path) == normalized_path(program.folder) then path.split("/").last else path
# `x: int = prim foreign("m.wasm", "x: int")`: m's global, the one x every module using m shares
foreign_value(path: text, header: text) as text := "${header} = prim foreign(\"${path}\", \"${header}\")"

# The functions a module compiles once and exports, those its files write with every parameter typed and a body of
# their own, not a primitive, each the only statement of its phrase, and its values, each a global the modules using it
# share; the rest of its code travels as wap source, every statement of a phrase (a class, its constructor, its show)
# together. A function that reaches the linear memory travels as source too, so it runs on the memory of the program
# calling it, a text it places for a C call where that call reads it, and so does a value such a function names, and a
# function naming that value
compiled_once(module: Module, records: Records) as list<Signature> := {
	statements = top_level_statements(module.code)
	touching = memory_words(statements, module.signatures.filter(is_value).map(value => value.name))
	typed = module.signatures.filter(signature => is_function(signature) and all_typed(signature, records) and compiled_body(defining_statement(module.code, signature)!) and not touching.contains(signature.name))
	ids = typed.map(signature => definer_id(signature.definer))
	kept = statements.filter(statement => not defined_by(statement, ids)).map(statement => line_place(statement_place(statement)))
	values = module.signatures.filter(value => is_value(value) and not touching.contains(value.name))
	typed.filter(signature => not kept.contains(line_place(defining_statement(module.code, signature)!))) + values
}
compiled_body(statement: Node) as bool := match statement { Call(called, arguments) => not arguments#2 is Prim; _ => no }
declared_word(statement: Node) as text? := if declaration_of(statement) == ø then ø else text(declaration_name(declaration_of(statement)!))
# the words whose statements load or store memory or name a word that does, and the values they name: a function that
# names such a value names the program's own
memory_words(statements: list<Node>, values: list<text>, words: list<text> = []) as list<text> := {
	reached = statements.filter(statement => declared_word(statement) != ø and reaches_memory(statement, words))
	named = values.filter(value => reached.any(statement => names_word(statement, value)))
	grown = reached.map(statement => declared_word(statement)!) + named.filter(value => not reached.any(statement => declared_word(statement) == value))
	if #grown == #words then words else memory_words(statements, values, grown)
}
reaches_memory(n: Node, words: list<text>) as bool := match n {
	Prim(operation, arguments) => MEMORY_OPERATIONS.any(part => text(operation).contains(part)) or arguments.any(argument => reaches_memory(argument, words))
	Symbol(name) => words.contains(name)
	_ => inner_nodes(n).any(part => reaches_memory(part, words))
}
names_word(n: Node, word: text) as bool := match n {
	Symbol(name) => name == word
	_ => inner_nodes(n).any(part => names_word(part, word))
}
inner_nodes(n: Node) as list<Node> := match n {
	Call(called, arguments) => [called] + arguments
	_ => direct_parts(unwrapped(n))
}
defined_by(statement: Node, ids: list<text>) as bool := declaration_of(statement) != ø and ids.contains(definer_id(declaration_name(declaration_of(statement)!)))
# the wap section's source: the module's files as written, each top-level statement but the definitions compiled
# once, which their export names declare, and the includes, whose files follow in their place
header_source(file: text, module: Module, exported: list<Signature>) as text := {
	cut = exported.map(signature => line_place(defining_statement(module.code, signature)!))
	written_files(file).map(written => kept_lines(written, cut)).join("")
}
line_place(statement: Node) as text := "${file_of(statement)}:${line_of(statement)}"
# a file and the files it includes, in their order
written_files(file: text) as list<text> := [file] + files_named(notation(read(file), file), INCLUDE_WORD).flat_map(written_files)
# a file's text without the lines of the statements cut and of its includes, each statement up to the next one
kept_lines(file: text, cut: list<text>) as text := {
	lines = read(file).split("\n")
	statements = top_level_statements(notation(read(file), file)).filter(statement => line_of(statement) != ø)
	starts = statements.map(statement => line_of(statement)!) + [#lines + 1]
	kept = ""
	for at in 0 to #statements - 1 {
		if not cut.contains(line_place(statements[at])) and phrase_text(statements[at], INCLUDE_WORD) == ø { kept += lines[starts[at] - 1 .. starts[at + 1] - 1].join("\n") + "\n" }
	}
	kept
}
# where a top-level statement is written: its own place, a class's that of its name
statement_place(statement: Node) as Node := if line_of(statement) == ø and declaration_of(statement) != ø then declaration_name(declaration_of(statement)!) else statement

# `add(a: int, b: int = 1) as int := prim foreign("m.wasm", "add(a: int, b: int = 1) → int", a, b)`
foreign_definition(path: text, header: text) as text := {
	parts = header.split(RESULT_ARROW)
	head = parts#1
	result = if #parts == 2 then " as " + parts#2 else ""
	given = head.split("(").drop(1).join("(")
	names = given.split(", ").filter(part => part.contains(": ")).map(part => part.split(": ")#1)
	"${head}${result} := prim foreign(\"${path}\", \"${header}\", ${names.join(", ")})"
}

# the text of a module's custom section of that name, "" when it has none
custom_text(bytes: text, name: text) as text := {
	r = WasmReader(bytes)
	while r.at < byte_count(bytes) {
		id = next_byte(r)
		size = unsigned_read(r)
		end = r.at + size
		if id == CUSTOM_SECTION and name_read(r) == name { return bytes_between(bytes, r.at, end) }
		r.at = end
	}
	""
}
# the functions and values a module's bytes export, read from its export section: each one's header line and its kind
class WasmReader { bytes: text; at: int = PREAMBLE_BYTES }
class ModuleExport { header: text; kind: int }
exports_of(bytes: text) as list<ModuleExport> := {
	r = WasmReader(bytes)
	while r.at < byte_count(bytes) {
		id = next_byte(r)
		size = unsigned_read(r)
		if id == EXPORT_SECTION { return (0 upto unsigned_read(r)).flat_map(each => item_export(r)) }
		r.at += size
	}
	[]
}
# one export: its name, its kind and its index; kept when its name is a function's header line (main's is none) or a
# value's
item_export(r: WasmReader) as list<ModuleExport> := {
	name = name_read(r)
	kind = next_byte(r)
	unsigned_read(r)
	if kind == FUNCTION_KIND and name.contains("(") or kind == GLOBAL_KIND then [ModuleExport(name, kind)] else []
}
next_byte(r: WasmReader) as int := {
	r.at += 1
	byte_at(r.bytes, r.at - 1)
}
# an unsigned LEB128 number, 7 bits a byte, the low bits first
unsigned_read(r: WasmReader) as int := {
	value = 0
	scale = 1
	byte = next_byte(r)
	while byte >= MORE_BYTES {
		value += (byte - MORE_BYTES) * scale
		scale *= MORE_BYTES
		byte = next_byte(r)
	}
	value + byte * scale
}
name_read(r: WasmReader) as text := {
	count = unsigned_read(r)
	r.at += count
	bytes_between(r.bytes, r.at - count, r.at)
}
