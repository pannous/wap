# A compiled module used as source (wiki/wasm-representation.md "Export names"): `use "m.wasm"` reads m's export
# section, where each function's name is its header line, `add(a: int, b: int = 1) → int`, and declares each as a
# function of m, a foreign primitive the host links by m's path (core/emit/host.wap foreign_imported). What wasm erases
# travels in m's wap section as wap source, read before the exports' declarations.
use "../../kernel/forms.wap"
use "../../core/analyze/calls.wap"
use "../../core/analyze/declarations.wap"
use "../../core/emit/opcodes.wap"
use "../../core/emit/wasm.wap"
use "../../core/stage.wap"
use "../../core/errors.wap"

# the bytes before the first section (magic and version)
PREAMBLE_BYTES = 8
# what a header line writes before its result type, and the high bit of a LEB128 byte, set on all but the last
RESULT_ARROW = " → "
MORE_BYTES = 128

# the source a compiled module stands for: its wap section, then a definition of each function it exports under its
# header line
wasm_source(path: text) as text := {
	bytes = read(path)
	([custom_text(bytes, WAP_SECTION)] + export_names(bytes).filter(name => name.contains("(")).map(header => foreign_definition(path, header))).join("\n")
}

# The functions a module compiles once and exports: those its files write with every parameter typed and a body of
# their own, not a primitive, each the only statement of its phrase; the rest of its code travels as wap source, every
# statement of a phrase (a class, its constructor, its show) together
compiled_once(module: Module, records: Records) as list<Signature> := {
	typed = module.signatures.filter(signature => is_function(signature) and all_typed(signature, records) and compiled_body(defining_statement(module.code, signature)!))
	ids = typed.map(signature => definer_id(signature.definer))
	kept = travelling(module).filter(statement => not defined_by(statement, ids)).map(place_of)
	typed.filter(signature => not kept.contains(place_of(statement_place(defining_statement(module.code, signature)!))))
}
compiled_body(statement: Node) as bool := match statement { Call(called, arguments) => not arguments#2 is Prim; _ => no }
defined_by(statement: Node, ids: list<text>) as bool := declaration_of(statement) != ø and ids.contains(definer_id(declaration_name(declaration_of(statement)!)))
# the top-level statements of a module that a file writes, each at its place
travelling(module: Module) as list<Node> := top_level_statements(module.code).filter(statement => line_of(statement_place(statement)) != ø)
# the wap section's source: each top-level phrase of the module as its file writes it, once, but the definitions
# compiled once, which their export names declare
header_source(module: Module, exported: list<Signature>) as text := {
	statements = travelling(module).map(statement_place)
	done = exported.map(signature => place_of(statement_place(defining_statement(module.code, signature)!)))
	files: map<text, list<text>> = {}
	for statement in statements { if not files.has(file_of(statement)!) { files[file_of(statement)!] = read(file_of(statement)!).split("\n") } }
	written = ""
	for statement in statements {
		if not done.contains(place_of(statement)) { written += written_lines(statement, statements, files) }
		done += [place_of(statement)]
	}
	written
}
# where a top-level statement is written: its own place, a class's that of its name
statement_place(statement: Node) as Node := if line_of(statement) == ø and declaration_of(statement) != ø then declaration_name(declaration_of(statement)!) else statement
# a statement's lines in its file, up to the next statement of that file
written_lines(statement: Node, statements: list<Node>, files: map<text, list<text>>) as text := {
	file = file_of(statement)!
	lines = files[file]
	start = line_of(statement)!
	end = #lines + 1
	for other in statements { if file_of(other) == file and line_of(other)! > start { end = min(end, line_of(other)!) } }
	lines[start - 1 .. end - 1].join("\n") + "\n"
}

# `add(a: int, b: int = 1) as int := prim foreign("m.wasm", "add(a: int, b: int = 1) → int", a, b)`
foreign_definition(path: text, header: text) as text := {
	parts = header.split(RESULT_ARROW)
	head = parts#1
	result = if #parts == 2 then " as " + parts#2 else ""
	given = head.split("(").drop(1).join("(")
	names = given.split(", ").filter(part => part.contains(": ")).map(part => part.split(": ")#1)
	"${head}${result} := prim foreign(\"${path}\", \"${header}\", ${names.join(", ")})"
}

# the text of a module's custom section of that name, "" when it has none
custom_text(bytes: text, name: text) as text := {
	r = WasmReader(bytes)
	while r.at < byte_count(bytes) {
		id = next_byte(r)
		size = unsigned_read(r)
		end = r.at + size
		if id == CUSTOM_SECTION and name_read(r) == name { return bytes_between(bytes, r.at, end) }
		r.at = end
	}
	""
}
# the names of the functions a module's bytes export, read from its export section
class WasmReader { bytes: text; at: int = PREAMBLE_BYTES }
export_names(bytes: text) as list<text> := {
	r = WasmReader(bytes)
	while r.at < byte_count(bytes) {
		id = next_byte(r)
		size = unsigned_read(r)
		if id == EXPORT_SECTION { return (0 upto unsigned_read(r)).flat_map(each => function_export(r)) }
		r.at += size
	}
	[]
}
# one export: its name, its kind and its index; the name when it is a function's
function_export(r: WasmReader) as list<text> := {
	name = name_read(r)
	kind = next_byte(r)
	unsigned_read(r)
	if kind == FUNCTION_KIND then [name] else []
}
next_byte(r: WasmReader) as int := {
	r.at += 1
	byte_at(r.bytes, r.at - 1)
}
# an unsigned LEB128 number, 7 bits a byte, the low bits first
unsigned_read(r: WasmReader) as int := {
	value = 0
	scale = 1
	byte = next_byte(r)
	while byte >= MORE_BYTES {
		value += (byte - MORE_BYTES) * scale
		scale *= MORE_BYTES
		byte = next_byte(r)
	}
	value + byte * scale
}
name_read(r: WasmReader) as text := {
	count = unsigned_read(r)
	r.at += count
	bytes_between(r.bytes, r.at - count, r.at)
}
