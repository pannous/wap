# A compiled module used as source (wiki/wasm-representation.md "Export names"): `use "m.wasm"` reads m's export
# section, where each function's name is its header line, `add(a: int, b: int = 1) → int`, and declares each as a
# function of m, a foreign primitive the host links by m's path (core/emit/host.wap foreign_imported).

# the export section's id, a function's kind of export, the bytes before the first section (magic and version)
EXPORT_SECTION = 7
FUNCTION_EXPORT = 0
PREAMBLE_BYTES = 8
# what a header line writes before its result type, and the high bit of a LEB128 byte, set on all but the last
RESULT_ARROW = " → "
MORE_BYTES = 128

# the source a compiled module stands for: a definition of each function it exports under its header line
wasm_source(path: text) as text := export_names(read(path)).filter(name => name.contains("(")).map(header => foreign_definition(path, header)).join("\n")

# `add(a: int, b: int = 1) as int := prim foreign("m.wasm", "add(a: int, b: int = 1) → int", a, b)`
foreign_definition(path: text, header: text) as text := {
	parts = header.split(RESULT_ARROW)
	head = parts#1
	result = if #parts == 2 then " as " + parts#2 else ""
	given = head.split("(").drop(1).join("(")
	names = given.split(", ").filter(part => part.contains(": ")).map(part => part.split(": ")#1)
	"${head}${result} := prim foreign(\"${path}\", \"${header}\", ${names.join(", ")})"
}

# the names of the functions a module's bytes export, read from its export section
class WasmReader { bytes: text; at: int = PREAMBLE_BYTES }
export_names(bytes: text) as list<text> := {
	r = WasmReader(bytes)
	while r.at < byte_count(bytes) {
		id = next_byte(r)
		size = unsigned_read(r)
		if id == EXPORT_SECTION { return (0 upto unsigned_read(r)).flat_map(each => function_export(r)) }
		r.at += size
	}
	[]
}
# one export: its name, its kind and its index; the name when it is a function's
function_export(r: WasmReader) as list<text> := {
	name = name_read(r)
	kind = next_byte(r)
	unsigned_read(r)
	if kind == FUNCTION_EXPORT then [name] else []
}
next_byte(r: WasmReader) as int := {
	r.at += 1
	byte_at(r.bytes, r.at - 1)
}
# an unsigned LEB128 number, 7 bits a byte, the low bits first
unsigned_read(r: WasmReader) as int := {
	value = 0
	scale = 1
	byte = next_byte(r)
	while byte >= MORE_BYTES {
		value += (byte - MORE_BYTES) * scale
		scale *= MORE_BYTES
		byte = next_byte(r)
	}
	value + byte * scale
}
name_read(r: WasmReader) as text := {
	count = unsigned_read(r)
	r.at += count
	bytes_between(r.bytes, r.at - count, r.at)
}
