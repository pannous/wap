# A compiled module used as its code (wiki/wasm-representation.md "Format"): `use "m.wasm"` brings in m's wap section,
# its files as the compiler read them, packed (extensions/packed.wap) as the warm state packs the compiler's own
# (extensions/warm.wap): what wasm erases (rules, classes, the bodies that travel along) and a definition of each
# function and value m exports under its header line, `add(a: int, b: int = 1) → int`, a foreign primitive the host
# links by m's path (core/emit/host.wap foreign_imported). No source is read, so m needs none beside it.
use "../../kernel/forms.wap"
use "../../core/parse/cascade.wap"
use "../../core/analyze/calls.wap"
use "../../core/analyze/declarations.wap"
use "../../kernel/opcodes.wap"
use "../../core/emit/wasm.wap"
use "../../core/emit/host.wap"
use "../../core/stage.wap"
use "../../core/paths.wap"
use "../../core/errors.wap"
use "../../core/parse/reader.wap"
use "../../core/parse/operators.wap"
use "../../core/language.wap"
use "../../core/pipeline.wap"
use "../packed.wap"
use "../warm.wap"

# the bytes before the first section (magic and version)
PREAMBLE_BYTES = 8
# what a header line writes before its result type, and the high bit of a LEB128 byte, set on all but the last
RESULT_ARROW = " → "
MORE_BYTES = 128
# the ending of a source file
SOURCE_ENDING = ".wap"
# what a module's wap section writes for its own path, a file inside it after it (`<module>/host.wap`), and for the
# name a host links it by (linked_name)
MODULE_MARK = "<module>"
LINKED_MARK = "<linked>"
# the custom section holding the folder of the held modules a module imports by their file names
LIBRARY_SECTION = "wap.library"

# the modules the compiler holds in its own bytes (the library, library.wap) by the path each stands for; each is
# written once beside that path, named by its hash, where a host links it
held_modules: map<text, text> = {}
# a prime below 2^56, so a hash times 31 stays an int
HELD_HASH_SIZE = 72057594037927931
# a module's bytes: held, else read from its path
module_read(path: text) as text := if held_modules.has(path) then held_modules[path] else read(path)
# the file a held module is written to beside the path it stands for, named by its hash
held_file(path: text) as text := path.replace(".wasm", "-${hashed(held_modules[path], HELD_HASH_SIZE)}.wasm")
# the name a module importing the one at the path links it by, resolved now: a held module's file name, which the host
# finds in the folder the importing module records (library_section), else the path
linked_name(path: text) as text := if held_modules.has(path) then file_name(held_file(path)) else path
# each held module written to its file, where none is yet
held_written() := for path in held_modules.keys {
	file = held_file(path)
	if not exists(file) { write_bytes(file, held_modules[path].bytes) }
}

# a language that brings in each compiled module a program uses, by its ending, as module_brought does
modules_bringable(language: Language) := { language.build.bringers[MODULE_ENDING] = module_brought }
# a compiled module brought in as its wap section holds it, each of its files operated already, those it carries
# inside it (`m.wasm/host.wap`); a section of no packed code is refused, as a module built before packing
module_brought(language: Language, path: text) as bool := {
	section = custom_text(module_read(path), WAP_SECTION)
	if section == "" { raise "${path} holds no wap code: compile it again" }
	match unpack(section, written => in_module(written, path)) {
		List(files, bracket, separator) => for file in files { match file {
			Key(Text(at), op, List(kept, square, comma)) => file_brought(language, at, kept)
			_ => raise "${path}: its wap section holds no file: compile it again"
		} }
		_ => raise "${path}: its wap section holds no files: compile it again"
	}
	yes
}
# a path the section writes, as the module at the path stands for it
in_module(written: text, path: text) as text := if written == LINKED_MARK then linked_name(path) else if written.starts_with(MODULE_MARK) then path + written[#MODULE_MARK ..] else written
# `x: int = prim foreign("m.wasm", "x: int")`: m's global, the one x every module using m shares
foreign_value(path: text, header: text) as text := "${header} = prim foreign(\"${path}\", \"${header}\")"

# The functions a module compiles once and exports, those its files write with every parameter typed and a body of
# their own, not a primitive, each the only statement of its phrase, and its values, each a global the modules using it
# share; the rest of its code travels as packed code in its wap section, every statement of a phrase (a class, its
# constructor, its show) together. The library's functions run on the one memory every program calling it imports (core/emit/wasm.wap), so a
# text placed for a C call is where that call reads it
compiled_once(module: Module, records: Records) as list<Signature> := {
	statements = top_level_statements(module.code)
	typed = module.signatures.filter(signature => is_function(signature) and all_typed(signature, records) and compiled_body(defining_statement(module.code, signature)!))
	ids = typed.map(signature => definer_id(signature.definer))
	kept = statements.filter(statement => not defined_by(statement, ids)).map(statement => line_place(statement_place(statement)))
	typed.filter(signature => not kept.contains(line_place(defining_statement(module.code, signature)!))) + module.signatures.filter(is_value)
}
# the functions the modules a program uses write with `export`, which the program exports too under their plain names;
# a name the program defines itself is refused
library_exports(modules: list<Module>) as list<Signature> := {
	own = modules.last.signatures.map(signature => signature.name)
	exported = modules.take(#modules - 1).flat_map(module => module.signatures.filter(signature => fact_items(module.code, EXPORTS).map(name => text(name)).contains(signature.name)))
	for signature in exported.filter(signature => own.contains(signature.name)) { refused(signature.definer, "the program and a module it uses both export ${signature.name}: rename one") }
	exported
}
compiled_body(statement: Node) as bool := match statement { Call(called, arguments) => not arguments#2 is Prim; _ => no }
defined_by(statement: Node, ids: list<text>) as bool := declaration_of(statement) != ø and ids.contains(definer_id(declaration_name(declaration_of(statement)!)))
# the wap section: the module's file as read, without the definitions compiled once, a definition of each export under
# its header line in their place, its values' first, as the code reads them; then each file it carries. Each path in
# them, a place's or a use's, is written inside the module, so a use reads no file beside it
module_section(language: Language, file: text, module: Module, exported: list<Signature>, exports: list<ModuleExport>, carried: list<text>) as text := {
	cut = exported.map(signature => line_place(defining_statement(module.code, signature)!))
	code = language.operated[file].code
	kept = top_level_statements(code).filter(statement => not cut.contains(line_place(statement_place(statement)))).map(statement => carried_used(language, file, statement, carried))
	values = operated_lines(language, file, exports.filter(item => item.kind == GLOBAL_KIND).map(item => foreign_value(LINKED_MARK, item.header)))
	functions = operated_lines(language, file, exports.filter(item => item.kind != GLOBAL_KIND).map(item => foreign_definition(LINKED_MARK, item.header)))
	own = Operated(with_facts_of(List(values + kept + functions, Bracket.None, Separator.Newline), code), language.operated[file].words)
	inside = written_files(file)
	pack(List([file_entry(file, own)] + carried.map(path => file_entry(path, language.operated[path])), Bracket.Square, Separator.Comma), written => module_written(written, inside, carried))
}
# lines of wap read as the file's code
operated_lines(language: Language, file: text, lines: list<text>) as list<Node> := if lines is empty then [] else top_level_statements(read_in(language, file, () => operated_program(language, notation(lines.join("\n"), file))))
# a use of a file the module carries, written by the file's whole path, which the section writes inside the module
carried_used(language: Language, file: text, statement: Node, carried: list<text>) as Node := {
	path = beside(file_of(statement) ?? file, phrase_text(statement, USE_WORD) ?? return statement)
	if carried.contains(path) then with_facts_of(operated_lines(language, file, ["${USE_WORD} \"${path}\""])#1, statement) else statement
}
# a path as the section writes it: the module's file its mark, a file it includes or carries inside it by its name
module_written(written: text, inside: list<text>, carried: list<text>) as text := if written == inside#1 then MODULE_MARK else if inside.contains(written) or carried.contains(written) then MODULE_MARK + "/" + file_name(written) else written
# the functions and values a module exports, each under its header line
module_exports(m: WasmModule) as list<ModuleExport> := m.exports.flat_map(entry => item_export(WasmReader(bytes_text(entry), 0)))
line_place(statement: Node) as text := "${file_of(statement)}:${line_of(statement)}"
# a file and the files it includes, in their order
written_files(file: text) as list<text> := [file] + files_named(notation(read(file), file), INCLUDE_WORD).flat_map(written_files)
# A compiled module may carry the files it uses and those they use, as packed code, each an entry of its wap section by
# its name, its own code then using them inside it, `use "types.wasm/host.wap"`, where a carried file's own use finds the one
# beside it, so reading it reads no file beside it (the library, library.wap)
carried_files(file: text) as list<text> := {
	carried: list<text> = []
	more = sources_used(written_files(file))
	while more {
		carried += more
		more = sources_used(more).filter(used => not carried.contains(used))
	}
	names = carried.map(file_name)
	for name in names { if #names.filter(other => other == name) > 1 { raise "a module carries the files it uses by name, and two are named ${name}" } }
	carried
}
# the source files the files use, each once
sources_used(files: list<text>) as list<text> := files.flat_map(file => files_named(notation(read(file), file), USE_WORD)).filter(used => used.ends_with(SOURCE_ENDING)).unique
file_name(path: text) as text := path.split("/").last
library_section(folder: text) as list<int> := custom_section(LIBRARY_SECTION, folder.bytes)
# where a top-level statement is written: its own place, a class's that of its name
statement_place(statement: Node) as Node := if line_of(statement) == ø and declaration_of(statement) != ø then declaration_name(declaration_of(statement)!) else statement

# `add(a: int, b: int = 1) as int := prim foreign("m.wasm", "add(a: int, b: int = 1) → int", a, b)`
foreign_definition(path: text, header: text) as text := {
	parts = header.split(RESULT_ARROW)
	head = parts#1
	result = if #parts == 2 then " as " + parts#2 else ""
	given = head.split("(").drop(1).join("(")
	names = given.split(", ").filter(part => part.contains(": ")).map(part => part.split(": ")#1)
	"${head}${result} := prim foreign(${(["\"${path}\"", "\"${header}\""] + names).join(", ")})"
}

# the text of a module's custom section of that name, "" when it has none
custom_text(bytes: text, name: text) as text := {
	r = WasmReader(bytes)
	while r.at < byte_count(bytes) {
		id = next_byte(r)
		size = unsigned_read(r)
		end = r.at + size
		if id == CUSTOM_SECTION and name_read(r) == name { return bytes_between(bytes, r.at, end) }
		r.at = end
	}
	""
}
# a module's bytes read from a place, and a function or value it exports: its header line and its kind
class WasmReader { bytes: text; at: int = PREAMBLE_BYTES }
class ModuleExport { header: text; kind: int }
# one export: its name, its kind and its index; kept when its name is a function's header line (main's is none) or a
# value's
item_export(r: WasmReader) as list<ModuleExport> := {
	name = name_read(r)
	kind = next_byte(r)
	unsigned_read(r)
	if kind == FUNCTION_KIND and (name.contains("(") or name.contains(": ")) or kind == GLOBAL_KIND then [ModuleExport(name, kind)] else []
}
next_byte(r: WasmReader) as int := {
	r.at += 1
	byte_at(r.bytes, r.at - 1)
}
# an unsigned LEB128 number, 7 bits a byte, the low bits first
unsigned_read(r: WasmReader) as int := {
	value = 0
	scale = 1
	byte = next_byte(r)
	while byte >= MORE_BYTES {
		value += (byte - MORE_BYTES) * scale
		scale *= MORE_BYTES
		byte = next_byte(r)
	}
	value + byte * scale
}
name_read(r: WasmReader) as text := {
	count = unsigned_read(r)
	r.at += count
	bytes_between(r.bytes, r.at - count, r.at)
}
