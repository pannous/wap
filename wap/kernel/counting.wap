# The count core declares (notes/unify-provers.md "count_declared and int_declared"): the natural numbers int's cases
# carry, `enum ·count { zero; successor(c: ·count) }`, the functions on them int's meanings are made of, and their
# shortcuts, so a function on two literals computes at once. Each shortcut is fixed by theorems the kernel checks:
# those computing proves are made from the statements the shortcut needs, the rest proved by the count's recursor.
# Every name carries the mark `·`, so no program writes or meets it.

use "terms.wap"
use "levels.wap"
use "environment.wap"
use "typing.wap"
use "inductive.wap"
use "recursors.wap"
use "numbers.wap"
use "equality.wap"
use "logic.wap"

COUNT := "·count"
COUNT_ZERO := "·count.zero"
COUNT_SUCCESSOR := "·count.successor"
COUNT_EQUALS_ITSELF := "·count_equals_itself"
COUNT_ZERO_ADD := "·count_zero_add"
COUNT_EQUALS_SOUND := "·count_equals_sound"
EQUAL_INTEGERS_ITSELF := "·equal_integers_itself"
EQUALS_SOUND := "·equals_sound"
EQUALS_COMPLETE := "·equals_complete"
PREDECESSOR := "·predecessor"
IS_ZERO := "·is_zero"
ADD := "·add"
SUBTRACT := "·subtract"
MULTIPLY := "·multiply"
COMPARED := "·compared"
EQUALS := "·equals"
AT_MOST := "·at_most"
UPS := "·ups"
DOWNS := "·downs"
DIFFERENCE := "·difference"
MINUS := "·minus"
SUM := "·sum"
TIMES := "·times"
EQUAL_INTEGERS := "·equal_integers"
NOT_ABOVE := "·not_above"
INT_BELOW := "·below"
ABOVE := "·above"
NOT_BELOW := "·not_below"
SUBTRACTED := "·subtracted"
UNEQUAL := "·unequal"
# the meaning of each host operation on two ints, the function its row is defined as (core/analyze/terms.wap)
INT_MEANINGS := {"i64.add": SUM, "i64.sub": SUBTRACTED, "i64.mul": TIMES, "i64.eq": EQUAL_INTEGERS, "i64.ne": UNEQUAL, "i64.le_s": NOT_ABOVE, "i64.lt_s": INT_BELOW, "i64.gt_s": ABOVE, "i64.ge_s": NOT_BELOW}
# the name of a shortcut's fixing theorem: its function's name and its place among them
FIXED := " fixed "

# A term builder over one checker: a function of a binder, its body made from the binder's variable
class Building { e: Environment; c: Checker }
function_of(b: Building, name: text, type: Term, body: (Term) -> Term): Term := {
	x = entered(b.c, name, type)
	lambdas([x], body(x.variable))
}
named(b: Building, name: text): Term := constant_of(b.e, name, [])
called(b: Building, name: text, arguments: list<Term>): Term := apply_all(named(b, name), arguments)
# the count's recursor at a level: into the motive's type of each count, from the base at zero and the step from each
# count and the motive at it
counted(b: Building, level: Level, motive: (Term) -> Term, base: Term, step: (Term, Term) -> Term, major: Term): Term := {
	count = named(b, COUNT)
	arms = [function_of(b, "t", count, motive), base, function_of(b, "k", count, k => function_of(b, "r", motive(k), r => step(k, r)))]
	apply_all(constant_of(b.e, recursor_name(COUNT), [level]), arms + [major])
}
# a definition of binders of one type, its value made from their variables
defined_over(b: Building, name: text, domain: Term, binders: list<text>, result: Term, value: (list<Term>) -> Term) := {
	locals = binders.map(binder => entered(b.c, binder, domain))
	declared(b.e, Declaration(name, [], pis(locals, result), Defined(lambdas(locals, value(variables(locals))))))
}

count_declared(e: Environment) := {
	header = universe(TYPE_LEVEL)
	inductive_declared(e, InductiveBlock([], 0, [BlockType(COUNT, header, [WrittenCase(COUNT_ZERO, pi(COUNT, header, bound(0))), WrittenCase(COUNT_SUCCESSOR, pi(COUNT, header, pi("c", bound(0), bound(1))))])]))
	numbers_declared(e, constant_of(e, COUNT, []), e.literals!.yes_case, constant_of(e, EQUAL, []))
	b = Building(e, checker(e, []))
	count = named(b, COUNT)
	truths = e.literals!
	to_count = (t: Term) => count
	to_truth = (t: Term) => truths.truth
	next = (t: Term) => apply(named(b, COUNT_SUCCESSOR), t)
	defined_over(b, PREDECESSOR, count, ["n"], count, x => counted(b, TYPE_LEVEL, to_count, named(b, COUNT_ZERO), (k, r) => k, x#1))
	defined_over(b, IS_ZERO, count, ["n"], truths.truth, x => counted(b, TYPE_LEVEL, to_truth, truths.yes_case, (k, r) => truths.no_case, x#1))
	defined_over(b, ADD, count, ["m", "n"], count, x => counted(b, TYPE_LEVEL, to_count, x#1, (k, r) => next(r), x#2))
	defined_over(b, SUBTRACT, count, ["m", "n"], count, x => counted(b, TYPE_LEVEL, to_count, x#1, (k, r) => called(b, PREDECESSOR, [r]), x#2))
	defined_over(b, MULTIPLY, count, ["m", "n"], count, x => counted(b, TYPE_LEVEL, to_count, named(b, COUNT_ZERO), (k, r) => called(b, ADD, [r, x#1]), x#2))
	# m compared with every count: at zero the answer for each n, and zero is never a successor
	comparison = pi("_", count, truths.truth)
	at_zero = entered(b.c, "at_zero", comparison)
	m = entered(b.c, "m", count)
	declared(e, Declaration(COMPARED, [], pis([at_zero, m], comparison), Defined(lambdas([at_zero, m], paired(b, truths.truth, at_zero.variable, j => truths.no_case, m.variable)))))
	defined_over(b, EQUALS, count, ["m", "n"], truths.truth, x => apply(called(b, COMPARED, [named(b, IS_ZERO), x#1]), x#2))
	defined_over(b, AT_MOST, count, ["m", "n"], truths.truth, x => apply(called(b, COMPARED, [function_of(b, "k", count, k => truths.yes_case), x#1]), x#2))
	shortcut_fixed(b, Shortcut.Add, ADD)
	shortcut_fixed(b, Shortcut.Subtract, SUBTRACT)
	shortcut_fixed(b, Shortcut.Multiply, MULTIPLY)
	shortcut_fixed(b, Shortcut.Equal, EQUALS)
	shortcut_fixed(b, Shortcut.AtMost, AT_MOST)
	count_bridge_declared(b)
}

# m's function of every n, by both counts at once: at zero the function `at_zero`, at a successor and zero
# `at_first(j)` of the count j before it, at two successors its value at the two counts before
paired(b: Building, type: Term, at_zero: Term, at_first: (Term) -> Term, m: Term): Term := {
	count = named(b, COUNT)
	counted(b, TYPE_LEVEL, t => pi("_", count, type), at_zero, (j, before) => function_of(b, "n", count, n => counted(b, TYPE_LEVEL, t => type, at_first(j), (k, r) => apply(before, k), n)), m)
}

# A shortcut bound to a function, each statement fixing it declared a theorem: proved by computing where both sides
# compute to one count, else by the count's recursor (subtract's two, counting down to zero)
shortcut_fixed(b: Building, kind: Shortcut, function: text) := {
	statements = shortcut_statements(b.e.numbers!, kind, [named(b, function)])
	names = (1 to #statements).map(at => "${function}${FIXED}${at}")
	for at in 1 to #statements { declared(b.e, Declaration(names#at, [], statements#at, Theorem(fixing_proof(b, kind, at, statements#at)))) }
	shortcut_bound(b.e, kind, [named(b, function)] + names.map(name => named(b, name)))
}
fixing_proof(b: Building, kind: Shortcut, at: int, statement: Term): Term := if kind == Shortcut.Subtract and at == 2 then zero_subtract_proof(b) else if kind == Shortcut.Subtract and at == 3 then successors_subtract_proof(b) else computed_proof(b, statement)
# a proof by computing of `Π binders. Equal(T, left, right)`: refl of the right side under the same binders
computed_proof(b: Building, statement: Term): Term := match statement.shape {
	Pi(binder, domain, body) => lambda(binder, domain, computed_proof(b, body))
	_ => {
		sides = arguments(statement)
		reflexive(b.e, TYPE_LEVEL, sides#1, sides#3)
	}
}
# `subtract(zero, n) == zero`, by the count's recursor: each step takes the count before both sides
zero_subtract_proof(b: Building): Term := {
	zero = named(b, COUNT_ZERO)
	stated = (k: Term) => counts_equal(b, called(b, SUBTRACT, [zero, k]), zero)
	function_of(b, "n", named(b, COUNT), n => counted(b, Zero, stated, reflexive(b.e, TYPE_LEVEL, named(b, COUNT), zero), (k, h) => before_both(b, called(b, SUBTRACT, [zero, k]), zero, h), n))
}
# `subtract(successor(m), successor(n)) == subtract(m, n)`, by the count's recursor on n
successors_subtract_proof(b: Building): Term := {
	count = named(b, COUNT)
	next = (t: Term) => apply(named(b, COUNT_SUCCESSOR), t)
	function_of(b, "m", count, m => function_of(b, "n", count, n => {
		stated = (k: Term) => counts_equal(b, called(b, SUBTRACT, [next(m), next(k)]), called(b, SUBTRACT, [m, k]))
		counted(b, Zero, stated, reflexive(b.e, TYPE_LEVEL, count, m), (k, h) => before_both(b, called(b, SUBTRACT, [next(m), next(k)]), called(b, SUBTRACT, [m, k]), h), n)
	}))
}
counts_equal(b: Building, left: Term, right: Term): Term := equated(b.e, TYPE_LEVEL, named(b, COUNT), left, right)
# from `left == right`, `predecessor(left) == predecessor(right)`
before_both(b: Building, left: Term, right: Term, h: Term): Term := apply_all(constant_of(b.e, EQUAL_CONGRUENT, [TYPE_LEVEL, TYPE_LEVEL]), [named(b, COUNT), named(b, COUNT), named(b, PREDECESSOR), left, right, h])

# `enum int { zero; positive(n: ·count); negative(n: ·count) }`, filling core's int: positive(n) is
# n + 1 and negative(n) is -(n + 1), so each int has one form. Its functions go by its two counts, an int x being
# ups(x) - downs(x): only ups, downs, minus and difference see its cases
int_declared(e: Environment) := {
	header = universe(TYPE_LEVEL)
	count = constant_of(e, COUNT, [])
	cases = INT_CASES.map(case => WrittenCase("${INT_WORD}.${case}", if case == INT_CASES#1 then pi(INT_WORD, header, bound(0)) else pi(INT_WORD, header, pi("n", count, bound(1)))))
	inductive_declared(e, InductiveBlock([], 0, [BlockType(INT_WORD, header, cases)]))
	b = Building(e, checker(e, []))
	int = named(b, INT_WORD)
	truth = e.literals!.truth
	zero = named(b, COUNT_ZERO)
	next = (t: Term) => apply(named(b, COUNT_SUCCESSOR), t)
	defined_over(b, UPS, int, ["x"], count, x => int_split(b, TYPE_LEVEL, t => count, (at, n) => if at == 2 then next(n!) else zero, x#1))
	defined_over(b, DOWNS, int, ["x"], count, x => int_split(b, TYPE_LEVEL, t => count, (at, n) => if at == 3 then next(n!) else zero, x#1))
	defined_over(b, MINUS, int, ["x"], int, x => int_split(b, TYPE_LEVEL, t => int, (at, n) => if at == 1 then case_of(b, 1) else if at == 2 then apply(case_of(b, 3), n!) else apply(case_of(b, 2), n!), x#1))
	# m - n of two counts in its one form, by both counts at once, so the difference of two successors is the
	# difference of the counts before them
	from_zero = function_of(b, "n", count, n => counted(b, TYPE_LEVEL, t => int, case_of(b, 1), (k, r) => apply(case_of(b, 3), k), n))
	defined_over(b, DIFFERENCE, count, ["m", "n"], int, x => apply(paired(b, int, from_zero, j => apply(case_of(b, 2), j), x#1), x#2))
	ups = (t: Term) => called(b, UPS, [t])
	downs = (t: Term) => called(b, DOWNS, [t])
	add = (l: Term, r: Term) => called(b, ADD, [l, r])
	multiply = (l: Term, r: Term) => called(b, MULTIPLY, [l, r])
	# two ints' counts crossed: ups(a) + downs(b) against ups(b) + downs(a)
	crossed = (name: text, a: Term, c: Term) => called(b, name, [add(ups(a), downs(c)), add(ups(c), downs(a))])
	defined_over(b, SUM, int, ["a", "b"], int, x => called(b, DIFFERENCE, [add(ups(x#1), ups(x#2)), add(downs(x#1), downs(x#2))]))
	defined_over(b, TIMES, int, ["a", "b"], int, x => called(b, DIFFERENCE, [add(multiply(ups(x#1), ups(x#2)), multiply(downs(x#1), downs(x#2))), add(multiply(ups(x#1), downs(x#2)), multiply(downs(x#1), ups(x#2)))]))
	defined_over(b, EQUAL_INTEGERS, int, ["a", "b"], truth, x => crossed(EQUALS, x#1, x#2))
	defined_over(b, NOT_ABOVE, int, ["a", "b"], truth, x => crossed(AT_MOST, x#1, x#2))
	defined_over(b, INT_BELOW, int, ["a", "b"], truth, x => called(b, NOT_ABOVE, [called(b, SUM, [x#1, apply(case_of(b, 2), zero)]), x#2]))
	defined_over(b, ABOVE, int, ["a", "b"], truth, x => called(b, INT_BELOW, [x#2, x#1]))
	defined_over(b, NOT_BELOW, int, ["a", "b"], truth, x => called(b, NOT_ABOVE, [x#2, x#1]))
	defined_over(b, SUBTRACTED, int, ["a", "b"], int, x => called(b, SUM, [x#1, called(b, MINUS, [x#2])]))
	defined_over(b, UNEQUAL, int, ["a", "b"], truth, x => called(b, NEGATED, [called(b, EQUAL_INTEGERS, [x#1, x#2])]))
	int_bridge_declared(b)
	e.integers = Integers(int, case_of(b, 1), case_of(b, 2), case_of(b, 3), named(b, SUM), named(b, MINUS), named(b, NOT_ABOVE), named(b, EQUAL_INTEGERS), named(b, EQUALS_SOUND), named(b, EQUALS_COMPLETE))
}
# int's case at an index of INT_CASES
case_of(b: Building, at: int): Term := named(b, int_case(at))
# int's recursor at a level: into the motive's type of each int, each case's arm made from its index and its count
# (ø at zero)
int_split(b: Building, level: Level, motive: (Term) -> Term, arm: (int, Term?) -> Term, x: Term): Term := {
	int = named(b, INT_WORD)
	arms = (1 to #INT_CASES).map(at => if at == 1 then arm(at, ø) else function_of(b, "n", named(b, COUNT), n => arm(at, n)))
	apply_all(constant_of(b.e, recursor_name(INT_WORD), [level]), [function_of(b, "t", int, motive)] + arms + [x])
}
# the function a host operation on two ints means, ø for any other
int_meaning(e: Environment, operation: text): Term? := if INT_MEANINGS.has(operation) then constant_of(e, INT_MEANINGS[operation], []) else ø

# --- the bridge between `(a == b) == yes` and `Equal(T, a, b)`, for counts and then for ints

# the count's recursor into Prop, by cases or by induction
induced(b: Building, motive: (Term) -> Term, base: Term, step: (Term, Term) -> Term, major: Term): Term := counted(b, Zero, motive, base, step, major)
# a function of a proof of `premise`, its body made from the proof
assuming(b: Building, premise: Term, body: (Term) -> Term): Term := function_of(b, "h", premise, body)
# `(m == n) == yes`, of two counts by the count's equals
told_equal(b: Building, function: text, m: Term, n: Term): Term := truth_stated(b.e, called(b, function, [m, n]))
# anything, from `no == yes`
absurd(b: Building, wanted: Term, h: Term): Term := apply_all(constant_of(b.e, FALSE_ELIM, [Zero]), [wanted, apply(named(b, NO_IS_NOT_YES), h)])
# from `left == right`, `f(left) == f(right)`, f a function of counts into a type at TYPE_LEVEL
carried(b: Building, into: Term, f: Term, left: Term, right: Term, h: Term): Term := apply_all(constant_of(b.e, EQUAL_CONGRUENT, [TYPE_LEVEL, TYPE_LEVEL]), [named(b, COUNT), into, f, left, right, h])
# `Π k: type. statement(k)`
for_every(b: Building, type: Term, statement: (Term) -> Term): Term := {
	k = entered(b.c, "k", type)
	pis([k], statement(k.variable))
}
# a theorem of binders of one type, its statement and proof made from their variables
proved_over(b: Building, name: text, binders: list<Local>, statement: Term, proof: Term) := theorem_declared(b.e, name, [], binders, statement, proof)

count_bridge_declared(b: Building) := {
	count = named(b, COUNT)
	zero = named(b, COUNT_ZERO)
	next = named(b, COUNT_SUCCESSOR)
	refl = (t: Term) => reflexive(b.e, TYPE_LEVEL, count, t)
	n = entered(b.c, "n", count)
	proved_over(b, COUNT_EQUALS_ITSELF, [n], told_equal(b, EQUALS, n.variable, n.variable), induced(b, k => told_equal(b, EQUALS, k, k), reflexive(b.e, TYPE_LEVEL, b.e.literals!.truth, b.e.literals!.yes_case), (k, h) => h, n.variable))
	proved_over(b, COUNT_ZERO_ADD, [n], counts_equal(b, called(b, ADD, [zero, n.variable]), n.variable), induced(b, k => counts_equal(b, called(b, ADD, [zero, k]), k), refl(zero), (k, h) => carried(b, count, next, called(b, ADD, [zero, k]), k, h), n.variable))
	# what equals says yes to is equal: by induction on m for every n, each by n's cases
	sound_at = (i: Term, k: Term) => pis([entered(b.c, "h", told_equal(b, EQUALS, i, k))], counts_equal(b, i, k))
	at_zero = function_of(b, "k", count, k => induced(b, j => sound_at(zero, j), assuming(b, told_equal(b, EQUALS, zero, zero), h => refl(zero)), (j, r) => assuming(b, told_equal(b, EQUALS, zero, apply(next, j)), h => absurd(b, counts_equal(b, zero, apply(next, j)), h)), k))
	stepped = (i: Term, before: Term) => function_of(b, "k", count, k => induced(b, j => sound_at(apply(next, i), j), assuming(b, told_equal(b, EQUALS, apply(next, i), zero), h => absurd(b, counts_equal(b, apply(next, i), zero), h)), (j, r) => assuming(b, told_equal(b, EQUALS, apply(next, i), apply(next, j)), h => carried(b, count, next, i, j, apply(apply(before, j), h))), k))
	m = entered(b.c, "m", count)
	k = entered(b.c, "k", count)
	h = entered(b.c, "h", told_equal(b, EQUALS, m.variable, k.variable))
	every = induced(b, i => for_every(b, count, j => sound_at(i, j)), at_zero, stepped, m.variable)
	proved_over(b, COUNT_EQUALS_SOUND, [m, k, h], counts_equal(b, m.variable, k.variable), apply(apply(every, k.variable), h.variable))
}
# `Equal(·count, a, b)` turned and chained
turned(b: Building, left: Term, right: Term, h: Term): Term := apply_all(constant_of(b.e, EQUAL_SYMMETRIC, [TYPE_LEVEL]), [named(b, COUNT), left, right, h])
chained(b: Building, left: Term, middle: Term, right: Term, first: Term, second: Term): Term := apply_all(constant_of(b.e, EQUAL_TRANSITIVE, [TYPE_LEVEL]), [named(b, COUNT), left, middle, right, first, second])

# int's equal_integers says yes to itself, says yes only to equal ints, and says yes to equal ints
int_bridge_declared(b: Building) := {
	int = named(b, INT_WORD)
	zero = named(b, COUNT_ZERO)
	valued = (at: int, n: Term?) => if at == 1 then case_of(b, 1) else apply(case_of(b, at), n!)
	ints_equal = (left: Term, right: Term) => equated(b.e, TYPE_LEVEL, int, left, right)
	told = (left: Term, right: Term) => told_equal(b, EQUAL_INTEGERS, left, right)
	x = entered(b.c, "x", int)
	proved_over(b, EQUAL_INTEGERS_ITSELF, [x], told(x.variable, x.variable), called(b, COUNT_EQUALS_ITSELF, [called(b, ADD, [called(b, UPS, [x.variable]), called(b, DOWNS, [x.variable])])]))
	# two negatives' counts are told equal shifted by zero's add: `(zero + n == zero + m) == yes`
	unshifted = (m: Term, n: Term, h: Term) => {
		shifted = (t: Term) => called(b, ADD, [zero, t])
		apart = called(b, COUNT_EQUALS_SOUND, [shifted(n), shifted(m), h])
		chained(b, m, shifted(m), n, turned(b, shifted(m), m, called(b, COUNT_ZERO_ADD, [m])), chained(b, shifted(m), shifted(n), n, turned(b, shifted(n), shifted(m), apart), called(b, COUNT_ZERO_ADD, [n])))
	}
	# one case against itself: zero is zero, positives and negatives are equal by their counts
	same = (at: int, m: Term?, n: Term?, h: Term) => if at == 1 then reflexive(b.e, TYPE_LEVEL, int, valued(1, ø)) else carried(b, int, case_of(b, at), m!, n!, if at == 2 then called(b, COUNT_EQUALS_SOUND, [m!, n!, h]) else unshifted(m!, n!, h))
	# by a's cases for every b, each by b's cases: two different cases are never told equal
	sound_at = (left: Term, right: Term) => pis([entered(b.c, "h", told(left, right))], ints_equal(left, right))
	against = (at: int, m: Term?) => function_of(b, "r", int, right => int_split(b, Zero, t => sound_at(valued(at, m), t), (other, n) => assuming(b, told(valued(at, m), valued(other, n)), proof => if other == at then same(at, m, n, proof) else absurd(b, ints_equal(valued(at, m), valued(other, n)), proof)), right))
	a = entered(b.c, "a", int)
	r = entered(b.c, "r", int)
	h = entered(b.c, "h", told(a.variable, r.variable))
	every = int_split(b, Zero, t => for_every(b, int, y => sound_at(t, y)), against, a.variable)
	proved_over(b, EQUALS_SOUND, [a, r, h], ints_equal(a.variable, r.variable), apply(apply(every, r.variable), h.variable))
	same_ints = entered(b.c, "h", ints_equal(a.variable, r.variable))
	motive = motive_of(b.e, b.c, TYPE_LEVEL, int, a.variable, y => told(a.variable, y))
	proved_over(b, EQUALS_COMPLETE, [a, r, same_ints], told(a.variable, r.variable), rewritten(b.e, TYPE_LEVEL, int, a.variable, motive, called(b, EQUAL_INTEGERS_ITSELF, [a.variable]), r.variable, same_ints.variable))
}
