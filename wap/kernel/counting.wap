# The count core declares (notes/unify-provers.md "count_declared and int_declared"): the natural numbers int's cases
# carry, `enum ·count { zero; successor(c: ·count) }`, the functions on them int's meanings are made of, and their
# shortcuts, so a function on two literals computes at once. Each shortcut is fixed by theorems the kernel checks:
# those computing proves are made from the statements the shortcut needs, the rest proved by the count's recursor.
# Every name carries the mark `·`, so no program writes or meets it.

use "terms.wap"
use "levels.wap"
use "environment.wap"
use "typing.wap"
use "inductive.wap"
use "recursors.wap"
use "numbers.wap"
use "equality.wap"
use "show.wap"
use "logic.wap"

COUNT := "·count"
COUNT_ZERO := "·count.zero"
COUNT_SUCCESSOR := "·count.successor"
COUNT_EQUALS_ITSELF := "·count_equals_itself"
COUNT_ZERO_ADD := "·count_zero_add"
COUNT_EQUALS_SOUND := "·count_equals_sound"
EQUAL_INTEGERS_ITSELF := "·equal_integers_itself"
EQUALS_SOUND := "·equals_sound"
EQUALS_COMPLETE := "·equals_complete"
PREDECESSOR := "·predecessor"
IS_ZERO := "·is_zero"
ADD := "·add"
SUBTRACT := "·subtract"
MULTIPLY := "·multiply"
COMPARED := "·compared"
EQUALS := "·equals"
AT_MOST := "·at_most"
UPS := "·ups"
DOWNS := "·downs"
DIFFERENCE := "·difference"
COUNTS_SUBTRACTED := "·counts_subtracted"
MINUS := "·minus"
SUM := "·sum"
TIMES := "·times"
EQUAL_INTEGERS := "·equal_integers"
NOT_ABOVE := "·not_above"
BELOW := "·below"
ABOVE := "·above"
NOT_BELOW := "·not_below"
SUBTRACTED := "·subtracted"
UNEQUAL := "·unequal"
TRUNCATED_QUOTIENT := "·truncated_quotient"
TRUNCATED_REMAINDER := "·truncated_remainder"
WORD_WRAPPED := "word.wrapped"
WRAPPED_SUM := "·wrapped_sum"
WRAPPED_DIFFERENCE := "·wrapped_difference"
WRAPPED_PRODUCT := "·wrapped_product"
# the meaning of each host operation on two ints, the function its row is defined as (core/analyze/terms.wap)
INT_MEANINGS := {"i64.add": SUM, "i64.sub": SUBTRACTED, "i64.mul": TIMES, "i64.eq": EQUAL_INTEGERS, "i64.ne": UNEQUAL, "i64.le_s": NOT_ABOVE, "i64.lt_s": BELOW, "i64.gt_s": ABOVE, "i64.ge_s": NOT_BELOW, "i64.div_s": TRUNCATED_QUOTIENT, "i64.rem_s": TRUNCATED_REMAINDER}
# the meaning of each host operation that wraps on two words, a refinement of int: int's meaning wrapped
WORD_MEANINGS := {"i64.add": WRAPPED_SUM, "i64.sub": WRAPPED_DIFFERENCE, "i64.mul": WRAPPED_PRODUCT}
# the name of a shortcut's fixing theorem: its function's name and its place among them
FIXED := " fixed "
# the fixing theorems the count's recursor proves, the others computing does: `subtract(zero, n) == zero` and
# `subtract(successor(m), successor(n)) == subtract(m, n)`
ZERO_SUBTRACT := fixing_name(SUBTRACT, 2)
SUCCESSORS_SUBTRACT := fixing_name(SUBTRACT, 3)

# a theorem of the building's environment, with no level parameters
theorem(b: Building, name: text, binders: list<Local>, statement: Term, proof: Term) := theorem_declared(b.e, name, [], binders, statement, proof)
truth_of(b: Building): Term := b.e.literals!.truth

successor(b: Building, t: Term): Term := apply(named(b, COUNT_SUCCESSOR), t)
# the count's recursor at a level: into the motive's type of each count, from the base at zero and the step from each
# count and the motive at it
counted(b: Building, level: Level, motive: (Term) -> Term, base: Term, step: (Term, Term) -> Term, major: Term): Term := {
	count = named(b, COUNT)
	arms = [function_of(b, "t", count, motive), base, function_of(b, "k", count, k => function_of(b, "r", motive(k), r => step(k, r)))]
	apply_all(constant_of(b.e, recursor_name(COUNT), [level]), arms + [major])
}
# a definition of binders of one type, its value made from their variables
defined_over(b: Building, name: text, domain: Term, binders: list<text>, result: Term, value: (list<Term>) -> Term) := {
	locals = binders.map(binder => entered(b.c, binder, domain))
	definition_declared(b.e, name, [], locals, result, value(variables(locals)))
}

count_declared(e: Environment) := {
	header = universe(TYPE_LEVEL)
	inductive_declared(e, InductiveBlock([], 0, [BlockType(COUNT, header, [WrittenCase(COUNT_ZERO, pi(COUNT, header, bound(0))), WrittenCase(COUNT_SUCCESSOR, pi(COUNT, header, pi("c", bound(0), bound(1))))])]))
	numbers_declared(e, constant_of(e, COUNT, []), e.literals!.yes_case, constant_of(e, EQUAL, []))
	b = building(e)
	count = named(b, COUNT)
	truths = e.literals!
	to_count = (t: Term) => count
	to_truth = (t: Term) => truths.truth
	defined_over(b, PREDECESSOR, count, ["n"], count, x => counted(b, TYPE_LEVEL, to_count, named(b, COUNT_ZERO), (k, r) => k, x#1))
	defined_over(b, IS_ZERO, count, ["n"], truths.truth, x => counted(b, TYPE_LEVEL, to_truth, truths.yes_case, (k, r) => truths.no_case, x#1))
	defined_over(b, ADD, count, ["m", "n"], count, x => counted(b, TYPE_LEVEL, to_count, x#1, (k, r) => successor(b, r), x#2))
	defined_over(b, SUBTRACT, count, ["m", "n"], count, x => counted(b, TYPE_LEVEL, to_count, x#1, (k, r) => called(b, PREDECESSOR, [r]), x#2))
	defined_over(b, MULTIPLY, count, ["m", "n"], count, x => counted(b, TYPE_LEVEL, to_count, named(b, COUNT_ZERO), (k, r) => called(b, ADD, [r, x#1]), x#2))
	# m compared with every count: at zero the answer for each n, and zero is never a successor
	comparison = pi("_", count, truths.truth)
	at_zero = entered(b.c, "at_zero", comparison)
	m = entered(b.c, "m", count)
	declared(e, Declaration(COMPARED, [], pis([at_zero, m], comparison), Defined(lambdas([at_zero, m], paired(b, TYPE_LEVEL, (i, j) => truths.truth, at_zero.variable, j => truths.no_case, (j, k, before) => before, m.variable)))))
	defined_over(b, EQUALS, count, ["m", "n"], truths.truth, x => apply(called(b, COMPARED, [named(b, IS_ZERO), x#1]), x#2))
	defined_over(b, AT_MOST, count, ["m", "n"], truths.truth, x => apply(called(b, COMPARED, [function_of(b, "k", count, k => truths.yes_case), x#1]), x#2))
	shortcut_fixed(b, Shortcut.Add, ADD)
	shortcut_fixed(b, Shortcut.Subtract, SUBTRACT)
	shortcut_fixed(b, Shortcut.Multiply, MULTIPLY)
	shortcut_fixed(b, Shortcut.Equal, EQUALS)
	shortcut_fixed(b, Shortcut.AtMost, AT_MOST)
	count_bridge_declared(b)
}

# m's function of every n into `motive(m, n)`, by both counts at once, a definition or a proof alike: at zero the
# function `at_zero`, at a successor and zero `at_first(j)` of the count j before it, at two successors
# `at_both(j, k, before)` of the counts before and the function's value `before` at them
paired(b: Building, level: Level, motive: (Term, Term) -> Term, at_zero: Term, at_first: (Term) -> Term, at_both: (Term, Term, Term) -> Term, m: Term): Term := {
	count = named(b, COUNT)
	counted(b, level, i => for_every(b, count, j => motive(i, j)), at_zero, (j, before) => function_of(b, "n", count, n => counted(b, level, k => motive(successor(b, j), k), at_first(j), (k, r) => at_both(j, k, apply(before, k)), n)), m)
}

# A shortcut bound to a function, each statement fixing it declared a theorem: proved by computing where both sides
# compute to one count, else by the count's recursor (subtract's two, counting down to zero)
shortcut_fixed(b: Building, kind: Shortcut, function: text) := shortcut_proved(b, kind, [function], statements => (1 to #statements).map(at => fixing_proof(b, fixing_name(function, at), statements#at)))
# a shortcut bound to its functions, each statement fixing them declared a theorem named by the first function, with
# the proof made for it: the kernel refuses a proof that is not of its statement
shortcut_proved(b: Building, kind: Shortcut, functions: list<text>, proved: (list<Term>) -> list<Term>) := {
	constants = functions.map(function => named(b, function))
	statements = shortcut_statements(b.e, kind, constants)
	proofs = proved(statements)
	if #proofs != #statements { refused(SHORTCUT, "${kind} is fixed by ${#statements} theorems, and is given ${#proofs} proofs") }
	names = (1 to #statements).map(at => fixing_name(functions#1, at))
	for at in 1 to #statements { declared(b.e, Declaration(names#at, [], statements#at, Theorem(proofs#at))) }
	shortcut_bound(b.e, kind, constants + names.map(name => named(b, name)))
}
fixing_name(function: text, at: int): text := "${function}${FIXED}${at}"
fixing_proof(b: Building, name: text, statement: Term): Term := if name == ZERO_SUBTRACT then zero_subtract_proof(b) else if name == SUCCESSORS_SUBTRACT then successors_subtract_proof(b) else computed_proof(b, statement)
# a proof by computing of `Π binders. Equal(T, left, right)`: refl of the right side under the same binders
computed_proof(b: Building, statement: Term): Term := match statement.shape {
	Pi(binder, domain, body) => lambda(binder, domain, computed_proof(b, body))
	_ => {
		sides = arguments(statement)
		reflexive(b.e, TYPE_LEVEL, sides#1, sides#3)
	}
}
# `subtract(zero, n) == zero`, by the count's recursor: each step takes the count before both sides
zero_subtract_proof(b: Building): Term := {
	zero = named(b, COUNT_ZERO)
	stated = (k: Term) => counts_equal(b, called(b, SUBTRACT, [zero, k]), zero)
	function_of(b, "n", named(b, COUNT), n => counted(b, Zero, stated, reflexive(b.e, TYPE_LEVEL, named(b, COUNT), zero), (k, h) => before_both(b, called(b, SUBTRACT, [zero, k]), zero, h), n))
}
# `subtract(successor(m), successor(n)) == subtract(m, n)`, by the count's recursor on n
successors_subtract_proof(b: Building): Term := {
	count = named(b, COUNT)
	function_of(b, "m", count, m => function_of(b, "n", count, n => {
		stated = (k: Term) => counts_equal(b, called(b, SUBTRACT, [successor(b, m), successor(b, k)]), called(b, SUBTRACT, [m, k]))
		counted(b, Zero, stated, reflexive(b.e, TYPE_LEVEL, count, m), (k, h) => before_both(b, called(b, SUBTRACT, [successor(b, m), successor(b, k)]), called(b, SUBTRACT, [m, k]), h), n)
	}))
}
counts_equal(b: Building, left: Term, right: Term): Term := equated(b.e, TYPE_LEVEL, named(b, COUNT), left, right)
# from `left == right`, `predecessor(left) == predecessor(right)`
before_both(b: Building, left: Term, right: Term, h: Term): Term := apply_all(constant_of(b.e, EQUAL_CONGRUENT, [TYPE_LEVEL, TYPE_LEVEL]), [named(b, COUNT), named(b, COUNT), named(b, PREDECESSOR), left, right, h])

# `enum int { natural(n: ·count); negative(n: ·count) }`, filling core's int: natural(n) is
# n and negative(n) is -(n + 1), so each int has one form. Its sum, product and order are Lean's Int.add, Int.mul
# and Int.le, by its cases, so Lean's theorems of them bind with no bridge; its equality and the proofs go by its two
# counts, an int x being difference(ups(x), downs(x)) (kernel/integer_laws.wap ·sum_crossed, ·times_crossed, ·not_above_crossed)
int_declared(e: Environment) := {
	header = universe(TYPE_LEVEL)
	count = constant_of(e, COUNT, [])
	cases = INT_CASES.map(case => WrittenCase("${INT_WORD}.${case}", pi(INT_WORD, header, pi("n", count, bound(1)))))
	inductive_declared(e, InductiveBlock([], 0, [BlockType(INT_WORD, header, cases)]))
	b = building(e)
	int = named(b, INT_WORD)
	truth = e.literals!.truth
	zero = named(b, COUNT_ZERO)
	defined_over(b, UPS, int, ["x"], count, x => int_split(b, TYPE_LEVEL, t => count, (at, n) => if at == NATURAL_CASE then n else zero, x#1))
	defined_over(b, DOWNS, int, ["x"], count, x => int_split(b, TYPE_LEVEL, t => count, (at, n) => if at == NEGATIVE_CASE then successor(b, n) else zero, x#1))
	# -n of a count in its one form: zero, then the negative of the count before
	from_zero = function_of(b, "n", count, n => counted(b, TYPE_LEVEL, t => int, valued(b, NATURAL_CASE, zero), (k, r) => valued(b, NEGATIVE_CASE, k), n))
	defined_over(b, MINUS, int, ["x"], int, x => int_split(b, TYPE_LEVEL, t => int, (at, n) => if at == NATURAL_CASE then apply(from_zero, n) else valued(b, NATURAL_CASE, successor(b, n)), x#1))
	# m - n of two counts in its one form, by both counts at once, so the difference of two successors is the
	# difference of the counts before them
	defined_over(b, DIFFERENCE, count, ["m", "n"], int, x => apply(paired(b, TYPE_LEVEL, (i, j) => int, from_zero, j => valued(b, NATURAL_CASE, successor(b, j)), (j, k, before) => before, x#1), x#2))
	add = (l: Term, r: Term) => called(b, ADD, [l, r])
	multiply = (l: Term, r: Term) => called(b, MULTIPLY, [l, r])
	# Lean's Int.subNatNat: m - n of two counts by n - m, zero there giving natural(m - n), a successor a negative
	defined_over(b, COUNTS_SUBTRACTED, count, ["m", "n"], int, x => subtracted_over(b, called(b, SUBTRACT, [x#1, x#2]), called(b, SUBTRACT, [x#2, x#1])))
	# Lean's Int.add and Int.mul, by both ints' cases; a negative's
	# count one short of its size, so a product of sizes is made a natural, or a negative through from_zero (negOfNat)
	ints_defined(b, SUM, (i, m, j, n) => if i == NATURAL_CASE and j == NATURAL_CASE then valued(b, NATURAL_CASE, add(m, n)) else if i == NATURAL_CASE then subtracted(b, m, successor(b, n)) else if j == NATURAL_CASE then subtracted(b, n, successor(b, m)) else valued(b, NEGATIVE_CASE, successor(b, add(m, n))))
	ints_defined(b, TIMES, (i, m, j, n) => if i == j then valued(b, NATURAL_CASE, multiply(sized(b, i, m), sized(b, j, n))) else apply(from_zero, multiply(sized(b, i, m), sized(b, j, n))))
	defined_over(b, EQUAL_INTEGERS, int, ["a", "b"], truth, x => crossed(b, EQUALS, x#1, x#2))
	defined_over(b, SUBTRACTED, int, ["a", "b"], int, x => called(b, SUM, [x#1, called(b, MINUS, [x#2])]))
	# Lean's Int.le: b - a is no negative
	defined_over(b, NOT_ABOVE, int, ["a", "b"], truth, x => natural_tested(b, called(b, SUBTRACTED, [x#2, x#1])))
	defined_over(b, BELOW, int, ["a", "b"], truth, x => called(b, NOT_ABOVE, [called(b, SUM, [x#1, valued(b, NATURAL_CASE, successor(b, zero))]), x#2]))
	defined_over(b, ABOVE, int, ["a", "b"], truth, x => called(b, BELOW, [x#2, x#1]))
	defined_over(b, NOT_BELOW, int, ["a", "b"], truth, x => called(b, NOT_ABOVE, [x#2, x#1]))
	defined_over(b, UNEQUAL, int, ["a", "b"], truth, x => called(b, NEGATED, [called(b, EQUAL_INTEGERS, [x#1, x#2])]))
	int_bridge_declared(b)
	e.bridges += [Bridge(int, named(b, EQUAL_INTEGERS), named(b, EQUALS_SOUND), named(b, EQUALS_COMPLETE))]
	e.integers = Integers(int, case_of(b, NATURAL_CASE), case_of(b, NEGATIVE_CASE), named(b, SUM), named(b, MINUS), named(b, NOT_ABOVE))
	shortcut_fixed(b, Shortcut.Difference, DIFFERENCE)
}
# a function of two ints by both ints' cases, each arm made from their indices and counts
ints_defined(b: Building, name: text, arm: (int, Term, int, Term) -> Term) := {
	int = named(b, INT_WORD)
	defined_over(b, name, int, ["a", "b"], int, x => int_split(b, TYPE_LEVEL, t => int, (i, m) => int_split(b, TYPE_LEVEL, t => int, (j, n) => arm(i, m, j, n), x#2), x#1))
}
# the size of an int at a case and its count: a negative's count is one short of it
sized(b: Building, at: int, c: Term): Term := if at == NATURAL_CASE then c else successor(b, c)
# two ints' counts crossed in a count's comparison: ups(a) + downs(c) against ups(c) + downs(a), their equality and
# order as integer_laws' proofs read them
crossed(b: Building, name: text, a: Term, c: Term): Term := called(b, name, [called(b, ADD, [called(b, UPS, [a]), called(b, DOWNS, [c])]), called(b, ADD, [called(b, UPS, [c]), called(b, DOWNS, [a])])])
# the int a count's recursor gives at `major`: natural(base) at zero, negative(k) at k's successor (COUNTS_SUBTRACTED's
# body at `major` n - m and `base` m - n)
subtracted_over(b: Building, base: Term, major: Term): Term := counted(b, TYPE_LEVEL, t => named(b, INT_WORD), valued(b, NATURAL_CASE, base), (k, r) => valued(b, NEGATIVE_CASE, k), major)
subtracted(b: Building, m: Term, n: Term): Term := called(b, COUNTS_SUBTRACTED, [m, n])
# whether an int is natural: yes at its first case, no at its second
natural_tested(b: Building, x: Term): Term := int_split(b, TYPE_LEVEL, t => truth_of(b), (at, n) => if at == NATURAL_CASE then b.e.literals!.yes_case else b.e.literals!.no_case, x)
# int's case at an index of INT_CASES
case_of(b: Building, at: int): Term := named(b, int_case(at))
# an int's case at an index, its count n
valued(b: Building, at: int, n: Term): Term := apply(case_of(b, at), n)
ints_equal(b: Building, left: Term, right: Term): Term := equated(b.e, TYPE_LEVEL, named(b, INT_WORD), left, right)
# `(left == right) == yes` of two ints
told(b: Building, left: Term, right: Term): Term := told_equal(b, EQUAL_INTEGERS, left, right)
# int's recursor at a level: into the motive's type of each int, each case's arm made from its index and its count
int_split(b: Building, level: Level, motive: (Term) -> Term, arm: (int, Term) -> Term, x: Term): Term := {
	int = named(b, INT_WORD)
	arms = (1 to #INT_CASES).map(at => function_of(b, "n", named(b, COUNT), n => arm(at, n)))
	apply_all(constant_of(b.e, recursor_name(INT_WORD), [level]), [function_of(b, "t", int, motive)] + arms + [x])
}
# the function a host operation on two ints means, or on two words where it wraps; ø for any other
int_meaning(e: Environment, operation: text, words: bool): Term? := {
	meanings = if words and WORD_MEANINGS.has(operation) then WORD_MEANINGS else INT_MEANINGS
	if meanings.has(operation) then constant_of(e, meanings[operation], []) else ø
}

# --- the bridge between `(a == b) == yes` and `Equal(T, a, b)`, for counts and then for ints

# the count's recursor into Prop, by cases or by induction
induced(b: Building, motive: (Term) -> Term, base: Term, step: (Term, Term) -> Term, major: Term): Term := counted(b, Zero, motive, base, step, major)
# a theorem by the count's induction on one binder: its statement the motive at that binder's variable
inducted(b: Building, name: text, binders: list<Local>, motive: (Term) -> Term, base: Term, step: (Term, Term) -> Term, major: Term) := theorem(b, name, binders, motive(major), induced(b, motive, base, step, major))
# a function of a proof of `premise`, its body made from the proof
assuming(b: Building, premise: Term, body: (Term) -> Term): Term := function_of(b, "h", premise, body)
# `(m == n) == yes`, of two counts by the count's equals
told_equal(b: Building, function: text, m: Term, n: Term): Term := truth_stated(b.e, called(b, function, [m, n]))
# anything, from `no == yes`
absurd(b: Building, wanted: Term, h: Term): Term := apply_all(constant_of(b.e, FALSE_ELIM, [Zero]), [wanted, apply(named(b, NO_IS_NOT_YES), h)])
# `successor(left) == successor(right)` from `left == right`
successors(b: Building, i: Identity): Identity := mapped(b.c, named(b, COUNT), t => successor(b, t), i)
# `zero + t == t`
zero_added(b: Building, t: Term): Identity := Identity(named(b, COUNT), called(b, ADD, [named(b, COUNT_ZERO), t]), t, called(b, COUNT_ZERO_ADD, [t]))
# `Π k: type. statement(k)`
for_every(b: Building, type: Term, statement: (Term) -> Term): Term := {
	k = entered(b.c, "k", type)
	pis([k], statement(k.variable))
}

count_bridge_declared(b: Building) := {
	count = named(b, COUNT)
	zero = named(b, COUNT_ZERO)
	n = entered(b.c, "n", count)
	theorem(b, COUNT_EQUALS_ITSELF, [n], told_equal(b, EQUALS, n.variable, n.variable), induced(b, k => told_equal(b, EQUALS, k, k), reflexive(b.e, TYPE_LEVEL, truth_of(b), b.e.literals!.yes_case), (k, h) => h, n.variable))
	theorem(b, COUNT_ZERO_ADD, [n], counts_equal(b, called(b, ADD, [zero, n.variable]), n.variable), induced(b, k => counts_equal(b, called(b, ADD, [zero, k]), k), reflexive(b.e, TYPE_LEVEL, count, zero), (k, h) => successors(b, Identity(count, called(b, ADD, [zero, k]), k, h)).proof, n.variable))
	# what equals says yes to is equal: by induction on m for every n, each by n's cases
	sound_at = (i: Term, k: Term) => pis([entered(b.c, "h", told_equal(b, EQUALS, i, k))], counts_equal(b, i, k))
	at_zero = function_of(b, "k", count, k => induced(b, j => sound_at(zero, j), assuming(b, told_equal(b, EQUALS, zero, zero), h => reflexive(b.e, TYPE_LEVEL, count, zero)), (j, r) => assuming(b, told_equal(b, EQUALS, zero, successor(b, j)), h => absurd(b, counts_equal(b, zero, successor(b, j)), h)), k))
	at_first = (i: Term) => assuming(b, told_equal(b, EQUALS, successor(b, i), zero), h => absurd(b, counts_equal(b, successor(b, i), zero), h))
	at_both = (i: Term, j: Term, before: Term) => assuming(b, told_equal(b, EQUALS, successor(b, i), successor(b, j)), h => successors(b, Identity(count, i, j, apply(before, h))).proof)
	m = entered(b.c, "m", count)
	k = entered(b.c, "k", count)
	h = entered(b.c, "h", told_equal(b, EQUALS, m.variable, k.variable))
	every = paired(b, Zero, sound_at, at_zero, at_first, at_both, m.variable)
	theorem(b, COUNT_EQUALS_SOUND, [m, k, h], counts_equal(b, m.variable, k.variable), apply(apply(every, k.variable), h.variable))
}
# int's equal_integers says yes to itself, says yes only to equal ints, and says yes to equal ints
int_bridge_declared(b: Building) := {
	int = named(b, INT_WORD)
	zero = named(b, COUNT_ZERO)
	x = entered(b.c, "x", int)
	theorem(b, EQUAL_INTEGERS_ITSELF, [x], told(b, x.variable, x.variable), called(b, COUNT_EQUALS_ITSELF, [called(b, ADD, [called(b, UPS, [x.variable]), called(b, DOWNS, [x.variable])])]))
	# two negatives' counts are told equal shifted by zero's add: `(zero + n == zero + m) == yes`
	unshifted = (m: Term, n: Term, h: Term) => {
		shifted = (t: Term) => called(b, ADD, [zero, t])
		apart = called(b, COUNT_EQUALS_SOUND, [shifted(n), shifted(m), h])
		followed(b.c, [flipped(b.c, zero_added(b, m)), flipped(b.c, Identity(named(b, COUNT), shifted(n), shifted(m), apart)), zero_added(b, n)]).proof
	}
	# one case against itself: naturals and negatives are equal by their counts
	same = (at: int, m: Term, n: Term, h: Term) => mapped(b.c, int, t => valued(b, at, t), Identity(named(b, COUNT), m, n, if at == NATURAL_CASE then called(b, COUNT_EQUALS_SOUND, [m, n, h]) else unshifted(m, n, h))).proof
	# by a's cases for every b, each by b's cases: two different cases are never told equal
	sound_at = (left: Term, right: Term) => pis([entered(b.c, "h", told(b, left, right))], ints_equal(b, left, right))
	against = (at: int, m: Term) => function_of(b, "r", int, right => int_split(b, Zero, t => sound_at(valued(b, at, m), t), (other, n) => assuming(b, told(b, valued(b, at, m), valued(b, other, n)), proof => if other == at then same(at, m, n, proof) else absurd(b, ints_equal(b, valued(b, at, m), valued(b, other, n)), proof)), right))
	a = entered(b.c, "a", int)
	r = entered(b.c, "r", int)
	h = entered(b.c, "h", told(b, a.variable, r.variable))
	every = int_split(b, Zero, t => for_every(b, int, y => sound_at(t, y)), against, a.variable)
	theorem(b, EQUALS_SOUND, [a, r, h], ints_equal(b, a.variable, r.variable), apply(apply(every, r.variable), h.variable))
	same_ints = entered(b.c, "h", ints_equal(b, a.variable, r.variable))
	motive = motive_of(b.e, b.c, TYPE_LEVEL, int, a.variable, y => told(b, a.variable, y))
	theorem(b, EQUALS_COMPLETE, [a, r, same_ints], told(b, a.variable, r.variable), rewritten(b.e, TYPE_LEVEL, int, a.variable, motive, called(b, EQUAL_INTEGERS_ITSELF, [a.variable]), r.variable, same_ints.variable))
}
