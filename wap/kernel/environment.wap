# What the kernel holds while it checks (notes/coc-plan.md 6.6; this folder's files: notes/theory.md): the
# declarations accepted so far, the binders it is inside of, its step count, and the one way it refuses.

use "terms.wap"
use "numbers.wap"

# how many steps of computing a declaration's check may take before it is refused as "gave up": the same count on
# every machine
STEP_BUDGET := 10000000
# how deep a case computed to find another's may nest, `x + 700000000` taking the numeral apart down to a stuck x:
# past it the check gave up too, before the machine's stack does
DEPTH_BUDGET := 10000

# The rules a refusal names, in plain words: `refused by argument type: int is a Type, and box takes a Type(1)`. A
# test pins the rule, never the message after it
REFUSED := "refused by "
# the exit code of a program a door refused
REFUSED_EXIT := 1
UNKNOWN_NAME := "unknown name"
REFUSED_DECLARATION := "refused declaration"
LEVEL_COUNT := "level count"
LEVEL_PARAMETER := "level parameter"
NOT_A_FUNCTION := "not a function"
ARGUMENT_TYPE := "argument type"
NOT_A_TYPE := "not a type"
VALUE_TYPE := "value type"
CONDITION := "condition"
NOT_A_PROPOSITION := "not a proposition"
NAME_TAKEN := "name taken"
NOT_CLOSED := "not closed"
GAVE_UP := "gave up"
ENUM_HEADER := "enum header"
CASE_TYPE := "case type"
PARAMETERS := "parameters"
CASE_RESULT := "case result"
FIELD_UNIVERSE := "field universe"
STRICT_POSITIVITY := "strict positivity"
NO_NUMBERS := "no numbers"
NOT_A_STRUCTURE := "not a structure"
DATA_FROM_PROOF := "data out of a proof"
NUMBERS := "numbers"
INTEGERS := "integers"
SHORTCUT := "shortcut"
NOT_EXPLICIT := "not explicit"
QUOTIENTS := "quotients"
PRODUCTS := "products"
TEXTS := "texts"
ROW_OVERFLOW := "row overflow"
# a term no run term stands for yet: what a program runs is erased from it (run/erase.wap)
RUNNING := "running"

refused(rule: text, found: text) := raise REFUSED + rule + ": " + found
# a door's run stopped by its first refusal, printed as its one line, with a failure
stopped_by(refusal: Error) := {
	print refusal.message
	exit(REFUSED_EXIT)
}
# the refusals of an ill-typed term: a value or an argument of another type than the one wanted, or a value whose
# condition computes to no where a subtype is wanted
ILL_TYPED := [VALUE_TYPE, ARGUMENT_TYPE, CONDITION]
# An error a try reads as a refusal by one of these rules, any rule by default; any other error, a bug, is raised
# again as it was (a raise carries its text alone)
refusal_only(e: Error, rules: list<text> = [""]) := if not rules.any(rule => e.message.starts_with(REFUSED + rule)) { raise e.message }
# a refusal a try reads as no: an ill-typed term's by default
mismatch(e: Error, rules: list<text> = ILL_TYPED): bool := {
	refusal_only(e, rules)
	no
}

# --- declarations

# What a declared name is: an axiom has its type alone; a definition and a theorem unfold to their value; an
# opaque constant's value was checked and is never read again
enum DeclarationKind {
	Axiom
	Defined(value: Term)
	Theorem(value: Term)
	Opaque(value: Term)
	# a type of an inductive block, and one of its cases: its type's constant, its place among the type's cases, and
	# how many fields it takes after the block's parameters
	Inductive(facts: InductiveFacts)
	Constructor(of: Term, place: int, fields: int)
	# the recursor of a type of a block (recursors.wap)
	Recursor(facts: RecursorFacts)
	# one of the quotient's four constants (quotients.wap)
	Quotient(part: QuotientPart)
	# a host operation, a row of primitives.wap, computing on literals by the row's fold; the choice, a condition's
	# two arms, computing on a truth to one of them (compute.wap)
	Row(operation: text)
	Choice
}
# the quotient type, the maker of its values, and the two ways out of it, which compute on a made value
enum QuotientPart { Former, Of, Lift, Induct }

# An inductive block as it is written (7): its level parameters and the count of parameters all its types share,
# and its types, each with its cases. Inside the block a type of it is written as its constant at the block's level
# parameters
class WrittenCase { name: text; type: Term }
class BlockType { name: text; type: Term; cases: list<WrittenCase> }
class InductiveBlock { levels: list<text>; parameters: int; types: list<BlockType> }
type_names(block: InductiveBlock): list<text> := block.types.map(type => type.name)
# What checks 1 to 5 found of a block, so the recursors are made without finding it again: the block as declared and
# its types' constants at its level parameters; the block made plain, its types first and then one for each container a type of it is nested in, each case over those
# types as a block is written, as the added ones are never declared; each container as a function of the block's
# parameters (nested.wap); the universe its types lie in; each type's count of indices; each case's count
# of fields and the places of the fields that hold a type of the block, by type and then by case; whether its
# recursors may compute into any universe or into Prop only; and the flags of check 7: a structure (one type, one
# case, no indices, holding no value of itself) and K (a proposition of one type, one case without fields)
class InductiveFacts {
	block: InductiveBlock
	types: list<Term>
	plain: InductiveBlock
	nested: list<Term>
	level: Level
	indices: list<int>
	fields: list<list<int>>
	recursive: list<list<list<int>>>
	any_motive: bool
	structure: bool
	k: bool
	# each type's cases by their ids, in order
	cases: list<list<int>> = []
}

# What iota reads of a recursor: its type and that type's cases, each a constant at the block's level parameters, with each case's count of fields; the
# counts of the binders it takes before the major premise; one computation rule per case, a closed function of the
# parameters, the motives, the minor premises and the case's fields; and K (the block's flag)
class RecursorFacts {
	of: Term
	cases: list<Term>
	fields: list<int>
	parameters: int
	motives: int
	minors: int
	indices: int
	rules: list<Term>
	k: bool
}

# a type's place in its block, 0 for a constant of none of its types
type_place(facts: InductiveFacts, type: Term): int := facts.types.index_where(own => is_constant(own, type))
# a case of a block's type at the type's levels, by its place, at the id its block gave it
block_case(facts: InductiveFacts, type: Term, place: int): Term := constant(facts.cases#(type_place(facts, type))#place, facts.block.types#(type_place(facts, type)).cases#place.name, constant_levels(type))

# A declaration: its name, the names of its level parameters, its type, and what it is
class Declaration { name: text; levels: list<text>; type: Term; kind: DeclarationKind }

# the facts of a structure a constant names (7, check 7: one type, one case, no indices, holding no value of
# itself), ø for any other constant
structure_facts(e: Environment, constant: Term): InductiveFacts? := {
	d = declared_at(e, constant_id(constant)) ?? return ø
	match d.kind {
		Inductive(facts) => if facts.structure and facts.block.types#1.name == d.name then facts else ø
		_ => ø
	}
}

# the value a use of the declaration unfolds to (6.4 delta), ø for one that never unfolds
unfolding(d: Declaration): Term? := match d.kind {
	Defined(value) => value
	Theorem(value) => value
	_ => ø
}

# The declarations accepted so far, by id: the id is the place in the order of declaring, from 1, so of two
# definitions the later one unfolds first (6.5). Ids are never given twice: a declaration taken back (`back_to`) keeps
# its place in the log and is never found again. An axiom is filled where a declaration of its name and type arrives:
# the declaration takes its place, so every term naming the assumed word means the definition from then on
class Environment {
	log: list<Declaration> = []
	# the ids taken back
	taken_back: map<int, bool> = {}
	# the scope being read, the id each name means there: its own names, where a declaration added is named and no
	# name is declared twice, and the names it sees from outside, which its own hide. Whoever reads a module sets the
	# module's (two modules may declare one name)
	ids: map<text, int> = {}
	outer: map<text, int> = {}
	# the words core declares, whenever it first needs one: seen from every scope, below the scopes' own and outer names
	core: map<text, int> = {}
	# the axioms each declaration rests on, by id, through everything its type and its value name
	axioms: map<int, list<int>> = {}
	# the number type and the shortcuts, once the numbers statement bound them (numbers.wap)
	numbers: Numbers? = ø
	# the function a text literal stands for and the list it takes, once the texts statement bound them (numbers.wap)
	texts: Texts? = ø
	# the pair and the unit types, once the products statement bound them (below.wap)
	products: Products? = ø
	# the types the literals are of and the truths, where no numbers or texts statement binds them (core's words)
	literals: Literals? = ø
	# the quotient and the maker of its values, once the quotients statement declared them (quotients.wap)
	quotients: Quotients? = ø
	# the ids of the courses below.wap made, so a course of the same name the program declared is never taken for one
	courses: list<int> = []
	# what it accepted, in order, as it was given: what an export writes (export.wap)
	accepted: list<Accepted> = []
	# the axioms filled, in order, each with the assumption it replaced, which a take-back puts back
	fills: list<Fill> = []
}
class Fill { id: int; assumed: Declaration }
# A statement the kernel accepted: a declaration, an inductive block as written, or a binding statement
enum Accepted {
	AcceptedDeclaration(d: Declaration)
	AcceptedBlock(block: InductiveBlock)
	AcceptedBinding(word: text, names: list<text>)
}
# the types a number, a text and a truth literal are of, and the two truths, each a constant
class Literals { number: Term; text: Term; truth: Term; yes_case: Term; no_case: Term }
# the pair type and its one case, the unit type and its one case, each a constant
class Products { pair: Term; intro: Term; unit: Term; one: Term }
# the quotient type and the maker of its values, each a constant
class Quotients { former: Term; made: Term }
declaration(e: Environment, name: text): Declaration? := e.log#(named_id(e, name) ?? return ø)
# the id a name means in the scope being read
named_id(e: Environment, name: text): int? := e.ids.get(name) ?? e.outer.get(name) ?? e.core.get(name)
# the id each name the scope being read sees means, its own names over those from outside
seen_ids(e: Environment): map<text, int> := {
	seen = copy(e.outer)
	seen.update(e.ids)
	seen
}
# the declaration of a name that must be declared, else refused
# the declaration of an id while it is live; ø for an id taken back or never given
declared_at(e: Environment, id: int): Declaration? := if id >= 1 and id <= #e.log and not e.taken_back.has(id) then e.log#id else ø
# a constant's declaration, refused where it is taken back
declaration_of(e: Environment, constant: Term): Declaration := match constant.shape {
	Constant(name, levels, id) => declared_at(e, id) ?? refused(UNKNOWN_NAME, "nothing is named ${name} here")
	_ => raise "only a constant names a declaration"
}
# Declarations added together, made given the ids they take, so one may name another before it is added (a block's
# types in its cases, a recursor in its rules, a quotient's former in its other parts); each checked once the ones
# before it are added. Where making or a check refuses, none is added
declared_together(e: Environment, names: list<text>, made: (list<int>) -> list<Declaration>, checked: (Declaration) -> T): list<Declaration> := kept_if_given(e, () => {
	size = #e.log
	declarations = made(ids_given(e, names, name => assumed_id(e, name)))
	# a name meaning an axiom of another type fills nothing: made again, it takes a new id, so it is refused as taken or,
	# in a module's scope, hides the assumption
	unfilling = declarations.filter(d => assumed_id(e, d.name) is not ø and filled_id(e, d) is ø).map(d => d.name)
	if unfilling is not empty { declarations = made(ids_given(e, names, name => if unfilling.contains(name) then ø else assumed_id(e, name))) }
	if #e.log != size or declarations.map(d => d.name) != names { raise "declarations made together are added by declared_together alone, in the order of their names" }
	for d in declarations {
		added(e, d)
		checked(d)
	}
	declarations
})!
# the ids declarations of these names take: an assumption's own where it is to be filled, else the next new ones
ids_given(e: Environment, names: list<text>, kept: (text) -> int?): list<int> := {
	ids: list<int> = []
	for name in names { ids += [kept(name) ?? #e.log + #ids.filter(id => id > #e.log) + 1] }
	ids
}
# the id of the axiom a name means, ø where it means none
assumed_id(e: Environment, name: text): int? := {
	id = named_id(e, name) ?? return ø
	if (declared_at(e, id) ?? return ø).kind is Axiom then id else ø
}
# the id of the axiom a declaration fills: one of its name, levels and type
filled_id(e: Environment, d: Declaration): int? := {
	id = assumed_id(e, d.name) ?? return ø
	assumed = e.log#id
	if assumed.type == d.type and assumed.levels == d.levels then id else ø
}
# a declaration by its name as a constant at these levels
constant_of(e: Environment, name: text, levels: list<Level>): Term := constant(place(e, name), name, levels)
declared_named(e: Environment, name: text): Declaration := {
	d = declaration(e, name)
	if d is ø { refused(UNKNOWN_NAME, "nothing is named ${name}") }
	d!
}
place(e: Environment, name: text): int := named_id(e, name) ?? 0
# the ids given so far, the live ones and those taken back
size(e: Environment): int := #e.log
# the names the scope being read sees, those from outside first
declared_names(e: Environment): list<text> := e.core.keys().filter(name => not e.ids.has(name) and not e.outer.has(name)) + e.outer.keys().filter(name => not e.ids.has(name)) + e.ids.keys()
# Every axiom a declaration rests on (`axioms of name`): an axiom rests on itself, any other declaration on what the
# names in its type and its value rest on, an opaque value's names too
axioms_of(e: Environment, constant: Term): list<text> := (e.axioms.get(constant_id(constant)) ?? []).map(id => e.log#id.name)
# the axioms a declaration rests on as `axioms of` prints them, `[hard]`
axioms_shown(e: Environment, constant: Term): text := "[${axioms_of(e, constant).join(", ")}]"
# what the declaration of this id rests on, through the constants of these terms; `own` is yes for an axiom
rests_on(e: Environment, id: int, terms: list<Term>, own: bool) := {
	resting: list<int> = if own then [id] else []
	for used in terms.flat_map(constants_in) {
		for axiom in e.axioms.get(constant_id(used)) ?? [] { if not resting.contains(axiom) { resting += [axiom] } }
	}
	e.axioms[id] = resting
}
# whether a declaration was stated as written, not made by a block or the quotients
stated(d: Declaration): bool := match d.kind {
	Axiom => yes
	Defined(value) => yes
	Theorem(value) => yes
	Opaque(value) => yes
	Inductive(facts) => no
	Constructor(of, place, fields) => no
	Recursor(facts) => no
	Quotient(part) => no
	Row(operation) => no
	Choice => no
}
# a declaration becomes part of the environment, checked first by typing.wap's `declared` or inductive.wap, its name
# new in the scope being read; one stated as written is recorded for an export
added(e: Environment, d: Declaration) := {
	filled = filled_id(e, d)
	if filled is not ø {
		e.fills += [Fill(filled!, e.log#filled!)]
		at = filled!
		e.log#at = d
	} else {
		if e.ids.has(d.name) { refused(NAME_TAKEN, "${d.name} is declared already") }
		e.log += [d]
	}
	e.ids[d.name] = filled ?? #e.log
	if stated(d) { e.accepted += [AcceptedDeclaration(d)] }
}

# a word core declares: in core's scope, under every other, its name new there
core_added(e: Environment, d: Declaration) := {
	if e.core.has(d.name) { refused(NAME_TAKEN, "${d.name} is declared already") }
	e.log += [d]
	e.core[d.name] = #e.log
	if stated(d) { e.accepted += [AcceptedDeclaration(d)] }
}

# How far the environment reached, and what the binding statements had bound by then, so what was declared after
# is taken back: a refused statement, a search that found nothing, a block's types held as axioms while it is checked
class Reach {
	size: int = 0
	accepted: int = 0
	courses: int = 0
	numbers: Numbers? = ø
	texts: Texts? = ø
	products: Products? = ø
	quotients: Quotients? = ø
	fills: int = 0
}
mark(e: Environment): Reach := Reach(#e.log, #e.accepted, #e.courses, e.numbers, e.texts, e.products, e.quotients, #e.fills)
# the environment taken back to a reach: each declaration made since is taken back and loses its name, its id stays
# given, so a term or a kept answer naming it finds nothing; the bindings and the courses are what they were then
back_to(e: Environment, reach: Reach) := {
	for id in reach.size + 1 to #e.log {
		e.taken_back[id] = yes
		e.axioms.remove(id)
		name = e.log#id.name
		if e.ids.get(name) == id { e.ids.remove(name) }
		if e.core.get(name) == id { e.core.remove(name) }
	}
	e.accepted = e.accepted.take(reach.accepted)
	e.courses = e.courses.take(reach.courses)
	e.numbers = reach.numbers
	e.texts = reach.texts
	e.products = reach.products
	e.quotients = reach.quotients
	for fill in e.fills.drop(reach.fills).reverse {
		at = fill.id
		e.log#at = fill.assumed
		e.axioms[fill.id] = [fill.id]
	}
	e.fills = e.fills.take(reach.fills)
}
# Every take-back is this: what an attempt gives, kept with what it declared; where it gives ø or refuses, the
# environment taken back to where it was before it, never by hand
kept_if_given(e: Environment, attempt: () -> T?): T? := {
	reach = mark(e)
	given = try { attempt() } catch refusal {
		back_to(e, reach)
		raise refusal.message
	}
	if given is ø { back_to(e, reach) }
	given
}

# The checks every declaration passes before its type is read, an inductive block's levels too: its level parameters
# are distinct and its terms are closed; that its name is new, `added` checks
levels_distinct(levels: list<text>) := {
	for at in 1 to #levels {
		if levels.take(at - 1).contains(levels#at) { refused(LEVEL_PARAMETER, "the level parameter ${levels#at} is named twice") }
	}
}
closed(t: Term, name: text) := {
	if t.loose > 0 or t.holds_free { refused(NOT_CLOSED, "${name} holds a variable bound nowhere") }
}

# --- the state of one check

# a binder the kernel is inside of: its name, for showing, and its type
class Hypothesis { binder: text; type: Term }
# a term and what a walk made of it, kept so the walk is not done again
class Kept { of: Term; result: Term }
# results by their term's hash; terms of one hash are told apart by `same`
class Memory { kept: map<int, list<Kept>> = {} }
remembered(memory: Memory, of: Term): Term? := {
	for kept in memory.kept.get(of.hash) ?? [] { if same(kept.of, of) { return kept.result } }
	ø
}
remember(memory: Memory, of: Term, result: Term) := {
	memory.kept[of.hash] = (memory.kept.get(of.hash) ?? []) + [Kept(of, result)]
}
# whether b was kept as a result of a: a pair kept, such as two terms found equal
kept_pair(memory: Memory, a: Term, b: Term): bool := (memory.kept.get(a.hash) ?? []).any(kept => same(kept.of, a) and same(kept.result, b))

# The state of the check of one declaration or one question: the environment, the declaration's level parameters,
# the binders gone into, the steps taken, what compute.wap keeps of closed terms and typing.wap of any term, and the
# pairs equal.wap found equal; what a type found is read with: nothing, or what an elaboration has found since
class Checker {
	environment: Environment
	levels: list<text> = []
	hypotheses: list<Hypothesis> = []
	filled_in: (Term) -> Term = (t: Term) => t
	steps: int = 0
	budget: int = STEP_BUDGET
	depth: int = 0
	heads: Memory = Memory()
	equalities: Memory = Memory()
	# the judgements the check made, numbered by their place (typing.wap), and each term's, by the term's hash
	judgements: list<Checked> = []
	judged: map<int, list<int>> = {}
}
# A judgement (6.3): a term has a type. Only typing.wap's rule functions make one
class Checked { term: Term; type: Term }
# a checker's levels its own: a hole's level it adds (elaborate/state.wap) leaves the declaration's levels as they are
checker(e: Environment, levels: list<text>): Checker := Checker(e, copy(levels))

# The free variable of a binder the kernel goes into (terms.wap: locally nameless): `(x: A) => b` is checked as
# `instantiated(b, hypothesis(c, "x", A))`
hypothesis(c: Checker, binder: text, type: Term): Term := {
	c.hypotheses.add(Hypothesis(binder, type))
	free(#c.hypotheses)
}
# the type and the name of a free variable the checker made
hypothesis_of(c: Checker, id: int): Hypothesis := c.hypotheses#id
# a term under the checker's free variables closed over them again, the first outermost: as a function type, or as a
# function
closed_over(c: Checker, t: Term, variables: list<Term>, function: bool): Term := closed_typed(c, t, variables, function, variable => hypothesis_of(c, variable_id(variable)).type)
# the same, each binder's type as typed gives it
closed_typed(c: Checker, t: Term, variables: list<Term>, function: bool, typed: (Term) -> Term): Term := variables.reverse().fold(t, (inner, variable) => {
	binder = hypothesis_of(c, variable_id(variable)).binder
	body = abstracted(inner, variable_id(variable))
	if function then lambda(binder, typed(variable), body) else pi(binder, typed(variable), body)
})

# One step of computing counted; past the budget the check gave up, which is a refusal, never an acceptance
stepped(c: Checker) := {
	c.steps += 1
	if c.steps > c.budget { refused(GAVE_UP, "the check took more than ${c.budget} steps") }
}
# a computation one level deeper, refused as given up past the depth budget
deeper(c: Checker, computation: () -> Term): Term := {
	if c.depth >= DEPTH_BUDGET { refused(GAVE_UP, "the check nested more than ${DEPTH_BUDGET} cases deep") }
	c.depth += 1
	result = try { computation() } catch e {
		c.depth -= 1
		raise e.message
	}
	c.depth -= 1
	result
}
