# The equality every law states (wiki/law.md, notes/coc-t5.md): `Equal(T, a, b)`, the proposition that a and b of a
# type T are the same, a block whose one proof `Equal.refl(T, a)` is that a is a. Beside it the laws the provers glue
# proofs with (extensions/prove/linear.wap), each a theorem by Equal's recursor, checked as it is declared.

use "terms.wap"
use "levels.wap"
use "environment.wap"
use "typing.wap"
use "inductive.wap"
use "recursors.wap"

EQUAL := "Equal"
REFL := "Equal.refl"
EQUAL_SYMMETRIC := "equal_symmetric"
EQUAL_TRANSITIVE := "equal_transitive"
EQUAL_CONGRUENT := "equal_congruent"
# the level parameter of the type compared, and of the type a congruence leads into
EQUAL_LEVELS := ["u", "v"]

# `enum Equal(T: Sort(u), a: T): T -> Prop { refl: Equal(T, a, a) }` and its glue laws
equality_declared(e: Environment) := {
	u = Parameter(EQUAL_LEVELS#1)
	header = pi("T", universe(u), pi("a", bound(0), pi("b", bound(1), PROP)))
	reflexive = pi(EQUAL, header, pi("T", universe(u), pi("a", bound(0), apply_all(bound(2), [bound(1), bound(0), bound(0)]))))
	inductive_declared(e, InductiveBlock([EQUAL_LEVELS#1], 2, [BlockType(EQUAL, header, [WrittenCase(REFL, reflexive)])]))
	symmetric_declared(e)
	transitive_declared(e)
	congruent_declared(e)
}
# `Equal(T, a, b)` at a level
equated(e: Environment, level: Level, type: Term, left: Term, right: Term): Term := apply_all(constant_of(e, EQUAL, [level]), [type, left, right])
# `Equal.refl(T, a)` at a level
reflexive(e: Environment, level: Level, type: Term, value: Term): Term := apply_all(constant_of(e, REFL, [level]), [type, value])
# Equal's recursor into Prop: from a proof of the motive at `from`, a proof of it at `to`, given `Equal(T, from, to)`
rewritten(e: Environment, level: Level, type: Term, from: Term, motive: Term, proof: Term, to: Term, equal: Term): Term := apply_all(constant_of(e, recursor_name(EQUAL), [Zero, level]), [type, from, motive, proof, to, equal])
# a theorem of these binders, proving the statement by the proof
theorem_declared(e: Environment, name: text, levels: list<text>, binders: list<Local>, statement: Term, proof: Term) := declared(e, Declaration(name, levels, pis(binders, statement), Theorem(lambdas(binders, proof))))
# the motive `(y: T) => (h: Equal(T, from, y)) => body(y)` of a rewrite from `from`
motive_of(e: Environment, c: Checker, level: Level, type: Term, from: Term, body: (Term) -> Term): Term := {
	y = entered(c, "y", type)
	h = entered(c, "h", equated(e, level, type, from, y.variable))
	lambdas([y, h], body(y.variable))
}

# `equal_symmetric(T, a, b, h: Equal(T, a, b)): Equal(T, b, a)`
symmetric_declared(e: Environment) := {
	u = Parameter(EQUAL_LEVELS#1)
	c = checker(e, [EQUAL_LEVELS#1])
	t = entered(c, "T", universe(u))
	a = entered(c, "a", t.variable)
	b = entered(c, "b", t.variable)
	h = entered(c, "h", equated(e, u, t.variable, a.variable, b.variable))
	motive = motive_of(e, c, u, t.variable, a.variable, y => equated(e, u, t.variable, y, a.variable))
	proof = rewritten(e, u, t.variable, a.variable, motive, reflexive(e, u, t.variable, a.variable), b.variable, h.variable)
	theorem_declared(e, EQUAL_SYMMETRIC, [EQUAL_LEVELS#1], [t, a, b, h], equated(e, u, t.variable, b.variable, a.variable), proof)
}
# `equal_transitive(T, a, b, c, ab: Equal(T, a, b), bc: Equal(T, b, c)): Equal(T, a, c)`
transitive_declared(e: Environment) := {
	u = Parameter(EQUAL_LEVELS#1)
	c = checker(e, [EQUAL_LEVELS#1])
	t = entered(c, "T", universe(u))
	a = entered(c, "a", t.variable)
	b = entered(c, "b", t.variable)
	z = entered(c, "c", t.variable)
	ab = entered(c, "ab", equated(e, u, t.variable, a.variable, b.variable))
	bc = entered(c, "bc", equated(e, u, t.variable, b.variable, z.variable))
	motive = motive_of(e, c, u, t.variable, b.variable, y => equated(e, u, t.variable, a.variable, y))
	proof = rewritten(e, u, t.variable, b.variable, motive, ab.variable, z.variable, bc.variable)
	theorem_declared(e, EQUAL_TRANSITIVE, [EQUAL_LEVELS#1], [t, a, b, z, ab, bc], equated(e, u, t.variable, a.variable, z.variable), proof)
}
# `equal_congruent(A, B, f: A -> B, a, b, h: Equal(A, a, b)): Equal(B, f(a), f(b))`
congruent_declared(e: Environment) := {
	u = Parameter(EQUAL_LEVELS#1)
	v = Parameter(EQUAL_LEVELS#2)
	c = checker(e, EQUAL_LEVELS)
	from = entered(c, "A", universe(u))
	into = entered(c, "B", universe(v))
	f = entered(c, "f", pis([entered(c, "x", from.variable)], into.variable))
	a = entered(c, "a", from.variable)
	b = entered(c, "b", from.variable)
	h = entered(c, "h", equated(e, u, from.variable, a.variable, b.variable))
	image = apply(f.variable, a.variable)
	motive = motive_of(e, c, u, from.variable, a.variable, y => equated(e, v, into.variable, image, apply(f.variable, y)))
	proof = rewritten(e, u, from.variable, a.variable, motive, reflexive(e, v, into.variable, image), b.variable, h.variable)
	theorem_declared(e, EQUAL_CONGRUENT, EQUAL_LEVELS, [from, into, f, a, b, h], equated(e, v, into.variable, image, apply(f.variable, b.variable)), proof)
}
