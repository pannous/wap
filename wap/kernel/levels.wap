# Universe levels compared (notes/coc-plan.md 6.2): two levels are equal when they agree for every value of their
# parameters, and `a <= b` is asked the same way. Both are decided, not approximated: a parameter whose being zero
# decides an Imax is split into the cases zero and successor, and what is left is a maximum of parameters and
# numbers, each with a number added, which is compared part by part.

use "terms.wap"

# the name a plain number's part has in place of a parameter's
NO_PARAMETER := ""

# whether a level is zero whatever its parameters are, and whether it is never zero
is_zero(level: Level): bool := match level {
	Zero => yes
	Successor(of) => no
	Max(left, right) => is_zero(left) and is_zero(right)
	Imax(left, right) => is_zero(right)
	Parameter(name) => no
}
never_zero(level: Level): bool := match level {
	Zero => no
	Successor(of) => yes
	Max(left, right) => never_zero(left) or never_zero(right)
	Imax(left, right) => never_zero(right)
	Parameter(name) => no
}

# a level with every Imax decided whose right side is always or never zero: `imax(u, 0)` is 0, `imax(u, v + 1)` is
# `max(u, v + 1)`
simplified(level: Level): Level := match level {
	Zero => level
	Successor(of) => Successor(simplified(of))
	Max(left, right) => Max(simplified(left), simplified(right))
	Imax(left, right) => imax_decided(simplified(left), simplified(right))
	Parameter(name) => level
}
imax_decided(left: Level, right: Level): Level := if is_zero(right) then Zero else if never_zero(right) then Max(left, right) else Imax(left, right)
# the level of a function type from a domain at one level to a result at another (6.3): a function type that ends in
# a proposition is a proposition
imax_level(domain: Level, result: Level): Level := imax_decided(simplified(domain), simplified(result))

# a parameter whose being zero or not decides whether a simplified level is zero, ø where none does
deciding(level: Level): text? := match level {
	Parameter(name) => name
	Max(left, right) => deciding(left) ?? deciding(right)
	Imax(left, right) => deciding(right)
	_ => ø
}
# a parameter that decides an Imax still in a simplified level, ø when no Imax is left
undecided(level: Level): text? := match level {
	Successor(of) => undecided(of)
	Max(left, right) => undecided(left) ?? undecided(right)
	Imax(left, right) => deciding(right) ?? undecided(left) ?? undecided(right)
	_ => ø
}

# One part of a level without Imax, which is the largest of its parts: a parameter, or a plain number, with a
# number added
class LevelPart { parameter: text; added: int }
level_parts(level: Level, added: int): list<LevelPart> := match level {
	Zero => [LevelPart(NO_PARAMETER, added)]
	Successor(of) => level_parts(of, added + 1)
	Max(left, right) => level_parts(left, added) + level_parts(right, added)
	Imax(left, right) => level_parts(left, added) + level_parts(right, added)
	Parameter(name) => [LevelPart(name, added)]
}
# whether a part never exceeds the largest of others: a parameter's part needs a part of the same parameter with at
# least its number, since that parameter may grow while the others stay 0; a plain number needs any part with at
# least its number, since every part is at least its number
part_covered(part: LevelPart, others: list<LevelPart>): bool := others.any(other => other.added >= part.added and (part.parameter == NO_PARAMETER or other.parameter == part.parameter))
plain_at_most(a: Level, b: Level): bool := {
	others = level_parts(b, 0)
	level_parts(a, 0).all(part => part_covered(part, others))
}

# Whether a <= b for every value of the parameters
level_at_most(a: Level, b: Level): bool := {
	left = simplified(a)
	right = simplified(b)
	split = undecided(left) ?? undecided(right) ?? return plain_at_most(left, right)
	names = [split]
	zero = [Zero]
	more = [Successor(Parameter(split))]
	level_at_most(level_with(left, names, zero), level_with(right, names, zero)) and level_at_most(level_with(left, names, more), level_with(right, names, more))
}
# Whether two levels are equal for every value of the parameters
levels_equal(a: Level, b: Level): bool := level_same(a, b) or (level_at_most(a, b) and level_at_most(b, a))

# the parameters a level names, each once
level_parameters(level: Level): list<text> := match level {
	Zero => []
	Successor(of) => level_parameters(of)
	Max(left, right) => (level_parameters(left) + level_parameters(right)).unique()
	Imax(left, right) => (level_parameters(left) + level_parameters(right)).unique()
	Parameter(name) => [name]
}
# the level parameters and holes a term names (core/analyze/holes.wap), each once
term_levels(t: Term): list<text> := {
	if not t.holds_parameter { return [] }
	match t.shape {
		Sort(level) => level_parameters(level)
		Constant(name, levels, _) => levels.flat_map(level_parameters).unique()
		_ => parts(t).flat_map(term_levels).unique()
	}
}
# the number a level without parameters is, ø for one with a parameter
level_number(level: Level): int? := match level {
	Zero => 0
	Successor(of) => { below = level_number(of) ?? return ø; below + 1 }
	Max(left, right) => { first = level_number(left) ?? return ø; second = level_number(right) ?? return ø; max(first, second) }
	Imax(left, right) => { first = level_number(left) ?? return ø; second = level_number(right) ?? return ø; if second == 0 then 0 else max(first, second) }
	Parameter(name) => ø
}
