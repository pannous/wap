# The logic core declares beside Equal (notes/unify-provers.md "Logic support"): the proposition with no proof and
# the one with exactly one, and the first laws of the truths that every proof by a bool's cases rests on, each checked
# as it is declared. Their names carry the mark `·`, so no program writes or meets them.

use "terms.wap"
use "levels.wap"
use "environment.wap"
use "typing.wap"
use "inductive.wap"
use "recursors.wap"
use "equality.wap"

FALSE := "·False"
TRUE := "·True"
TRUE_INTRO := "·True.intro"
FALSE_ELIM := "·false_elim"
NO_IS_NOT_YES := "·no_is_not_yes"
YES_IS_NOT_NO := "·yes_is_not_no"
BOOL_CASES := "·bool_cases"
NEGATED := "·negated"
# the level parameter of what false_elim gives
ELIM_LEVEL := "u"

logic_declared(e: Environment) := {
	inductive_declared(e, InductiveBlock([], 0, [BlockType(FALSE, PROP, [])]))
	inductive_declared(e, InductiveBlock([], 0, [BlockType(TRUE, PROP, [WrittenCase(TRUE_INTRO, pi(TRUE, PROP, bound(0)))])]))
	false_elim_declared(e)
	no_is_not_yes_declared(e)
	yes_is_not_no_declared(e)
	bool_cases_declared(e)
	negated_declared(e)
}
# a definition of these binders, the value its function of them
definition_declared(e: Environment, name: text, levels: list<text>, binders: list<Local>, type: Term, value: Term) := declared(e, Declaration(name, levels, pis(binders, type), Defined(lambdas(binders, value))))
# bool's recursor into a sort of this level: the motive, the arm at no, the arm at yes, the truth taken apart
truth_split(e: Environment, level: Level, motive: Term, at_no: Term, at_yes: Term, truth: Term): Term := apply_all(constant_of(e, recursor_name(constant_name(e.literals!.truth)), [level]), [motive, at_no, at_yes, truth])

# `false_elim(c: Sort(u), h: False): c`, by False's recursor: from no proof, anything
false_elim_declared(e: Environment) := {
	c = checker(e, [ELIM_LEVEL])
	into = entered(c, "c", universe(Parameter(ELIM_LEVEL)))
	h = entered(c, "h", constant_of(e, FALSE, []))
	motive = lambdas([entered(c, "x", h.domain)], into.variable)
	definition_declared(e, FALSE_ELIM, [ELIM_LEVEL], [into, h], into.variable, apply_all(constant_of(e, recursor_name(FALSE), [Parameter(ELIM_LEVEL)]), [motive, h.variable]))
}
# `no_is_not_yes(h: Equal(bool, no, yes)): False`: rewriting no to yes in a motive true at no and false at yes
no_is_not_yes_declared(e: Environment) := {
	c = checker(e, [])
	truths = e.literals!
	h = entered(c, "h", truths_equal(e, truths.no_case, truths.yes_case))
	told = (y: Term) => truth_split(e, TYPE_LEVEL, lambdas([entered(c, "t", truths.truth)], PROP), constant_of(e, TRUE, []), constant_of(e, FALSE, []), y)
	motive = motive_of(e, c, TYPE_LEVEL, truths.truth, truths.no_case, told)
	proof = rewritten(e, TYPE_LEVEL, truths.truth, truths.no_case, motive, constant_of(e, TRUE_INTRO, []), truths.yes_case, h.variable)
	theorem_declared(e, NO_IS_NOT_YES, [], [h], constant_of(e, FALSE, []), proof)
}
# `yes_is_not_no(h: Equal(bool, yes, no)): False`, turned and given to no_is_not_yes
yes_is_not_no_declared(e: Environment) := {
	c = checker(e, [])
	truths = e.literals!
	h = entered(c, "h", truths_equal(e, truths.yes_case, truths.no_case))
	turned = apply_all(constant_of(e, EQUAL_SYMMETRIC, [TYPE_LEVEL]), [truths.truth, truths.yes_case, truths.no_case, h.variable])
	theorem_declared(e, YES_IS_NOT_NO, [], [h], constant_of(e, FALSE, []), apply(constant_of(e, NO_IS_NOT_YES, []), turned))
}
# `bool_cases(b, p: bool -> Prop, if_no: Equal(bool, b, no) -> p(no), if_yes: Equal(bool, b, yes) -> p(yes)): p(b)`:
# a truth taken apart by its two cases, each case knowing which one it is
bool_cases_declared(e: Environment) := {
	c = checker(e, [])
	truths = e.literals!
	b = entered(c, "b", truths.truth)
	p = entered(c, "p", pis([entered(c, "x", truths.truth)], PROP))
	knowing = (y: Term) => pis([entered(c, "e", truths_equal(e, b.variable, y))], apply(p.variable, y))
	if_no = entered(c, "if_no", knowing(truths.no_case))
	if_yes = entered(c, "if_yes", knowing(truths.yes_case))
	y = entered(c, "y", truths.truth)
	split = truth_split(e, Zero, lambdas([y], knowing(y.variable)), if_no.variable, if_yes.variable, b.variable)
	theorem_declared(e, BOOL_CASES, [], [b, p, if_no, if_yes], apply(p.variable, b.variable), apply(split, reflexive(e, TYPE_LEVEL, truths.truth, b.variable)))
}
# `negated(b: bool): bool`, yes at no and no at yes
negated_declared(e: Environment) := {
	c = checker(e, [])
	truths = e.literals!
	b = entered(c, "b", truths.truth)
	value = truth_split(e, TYPE_LEVEL, lambdas([entered(c, "t", truths.truth)], truths.truth), truths.yes_case, truths.no_case, b.variable)
	definition_declared(e, NEGATED, [], [b], truths.truth, value)
}
