# A block whose types occur nested under another inductive type made a plain block (notes/coc-plan.md 7, "Nested
# types"; this folder's files: notes/theory.md): each container at its arguments, `list(Tree)`, becomes one more
# type of the block, with the container's cases copied in, and every occurrence of it is replaced by that type. The
# plain block is checked as any other; a container that uses its parameter negatively fails strict positivity there.

use "terms.wap"
use "environment.wap"
use "compute.wap"
use "equal.wap"
use "typing.wap"
use "show.wap"
use "inductive.wap"

# a type of the block added for a container takes the first type's name and this mark and its count, a name no
# program writes
NESTED_MARK := "#"

# The nesting being undone: the block, the free variables of its parameters, the variables standing for its types and
# for those added, the containers found so far and the types added for them
class Unnesting {
	c: Checker
	block: InductiveBlock
	parameters: list<Term>
	types: list<Term>
	containers: list<Term> = []
	added: list<BlockType> = []
}

# The block made plain, the variable standing for each of its types, and for each type added, the container it stands
# for as a function of the block's parameters; a block without nesting is itself
class Unnested { block: InductiveBlock; types: list<Term>; nested: list<Term> }
unnested(c: Checker, block: InductiveBlock, parameters: list<Term>, variables: list<Term>): Unnested := {
	u = Unnesting(c, block, parameters, variables)
	types = block.types.map(type => type_unnested(u, type))
	# a type added may nest a container itself, adding more while it is read
	at = 1
	while at <= #u.added {
		u.added#at = type_unnested(u, u.added#at)
		at += 1
	}
	Unnested(InductiveBlock(block.levels, block.parameters, types + u.added), u.types, u.containers.map(container => over_parameters(u, container, yes)))
}
type_unnested(u: Unnesting, type: BlockType): BlockType := BlockType(type.name, type.type, type.cases.map(case => case_unnested(u, case)))

# a case whose type holds no container of the block's types is itself, and so is one written with fewer binders than
# the block's parameters, which its check refuses
case_unnested(u: Unnesting, case: WrittenCase): WrittenCase := {
	if #binders_entered(u.c, case.type).entered < #u.parameters { return case }
	inside = passed(u.c, case.type, u.parameters)
	if not nests(u, inside) { return case }
	WrittenCase(case.name, over_parameters(u, replaced(u, inside), no))
}

# whether a term holds a type of the block as an argument of another inductive type
nests(u: Unnesting, t: Term): bool := container_of(u, t) is not ø or parts(t).any(part => nests(u, part))

# A term with each container of the block's types replaced by the type added for it. Under a binder the variable
# is a free one, so the parameters' variables are told from a case's own
replaced(u: Unnesting, t: Term): Term := {
	if not holds(t, u.types) { return t }
	container = container_of(u, t)
	if container is not ø { return apply_all(added_for(u, container!), u.parameters + arguments(t).drop(#arguments(container!))) }
	match t.shape {
		Apply(function, argument) => apply(replaced(u, function), replaced(u, argument))
		Pi(binder, domain, body) => pi(binder, replaced(u, domain), body_replaced(u, binder, domain, body))
		Lambda(binder, domain, body) => lambda(binder, replaced(u, domain), body_replaced(u, binder, domain, body))
		_ => t
	}
}
# a binder's body with its containers replaced, under one fresh variable
body_replaced(u: Unnesting, binder: text, domain: Term, body: Term): Term := {
	variable = hypothesis(u.c, binder, domain)
	abstracted(replaced(u, instantiated(body, variable)), variable_id(variable))
}

# The container a term applies when it is an inductive type, not of the block, whose parameters hold a type of the
# block: that type applied to its parameters alone; its indices hold no type of the block, and its parameters no
# variable but the block's parameters (the rule strict positivity)
container_of(u: Unnesting, t: Term): Term? := {
	facts = inductive_facts(u.c, head(t)) ?? return ø
	given = arguments(t)
	if #given < facts.block.parameters { return ø }
	parameters = given.take(facts.block.parameters)
	if not parameters.any(parameter => holds(parameter, u.types)) { return ø }
	if given.drop(facts.block.parameters).any(index => holds(index, u.types)) { refused(STRICT_POSITIVITY, "${shown_by(u.c, t)} holds a type of its block in an index") }
	if parameters.any(parameter => free_variables(parameter).any(id => place_among(free(id), u.parameters + u.types) == 0)) { refused(STRICT_POSITIVITY, "${shown_by(u.c, t)} holds a variable of its case") }
	apply_all(head(t), parameters)
}

# the facts of an inductive type a term names, ø for any other term
inductive_facts(c: Checker, t: Term): InductiveFacts? := match (declared_at(c.environment, constant_id(t)) ?? return ø).kind {
	Inductive(facts) => facts
	_ => ø
}

# The variable of the type added for a container, added when it is new: the block's parameters, then the
# container's indices, in the container's universe, which the block's must be (enum header); its cases the
# container's as declared, at its levels and parameters, so a container that was nested itself is unnested again in turn
added_for(u: Unnesting, container: Term): Term := {
	written = #u.block.types
	for at in 1 to #u.containers { if same(u.containers#at, container) { return u.types#(written + at) } }
	name = "${u.block.types#1.name}${NESTED_MARK}${#u.containers + 1}"
	type = head(container)
	cases = container_cases(u.c, type)
	header = at_container(u, type, container)
	u.containers += [container]
	u.added += [BlockType(name, header, (1 to #cases).list().map(place => WrittenCase("${name}.${cases#place.name}", at_container(u, case_constant(u.c, type, place), container))))]
	u.types += [hypothesis(u.c, name, header)]
	u.types#(written + #u.containers)
}

# the type of a declaration of the container, its own or a case's, at the container's levels and parameters, closed
# over the block's parameters
at_container(u: Unnesting, declared: Term, container: Term): Term := {
	declared_as = declaration_of(u.c.environment, declared)
	over_parameters(u, passed(u.c, with_levels(declared_as.type, declared_as.levels, constant_levels(head(container))), arguments(container)), no)
}

# the cases of an inductive type, as written, its constant given
container_cases(c: Checker, type: Term): list<WrittenCase> := {
	facts = inductive_facts(c, type)!
	facts.block.types#(type_place(facts, type)).cases
}
# a case of an inductive type at the type's levels, its constant and the case's place given
case_constant(c: Checker, type: Term, place: int): Term := block_case(inductive_facts(c, type)!, type, place)

# --- terms

# a term under the block's parameters closed over them again: as a function type, or as a function
over_parameters(u: Unnesting, t: Term, function: bool): Term := closed_over(u.c, t, u.parameters, function)

# a function type given its first arguments: what it gives for them
passed(c: Checker, t: Term, given: list<Term>): Term := given.fold(t, (rest, argument) => instantiated(binder_body(c, rest), argument))

