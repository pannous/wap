# The wasm binary format's codes: section ids, value and heap types, kinds, and the opcodes of the instructions
# wap emits, each as its bytes. Format reference: https://webassembly.github.io/spec/core/binary/
MAGIC = [0x00, 0x61, 0x73, 0x6D]
VERSION = [0x01, 0x00, 0x00, 0x00]

# section ids, in the order the format requires them, a custom section's anywhere
CUSTOM_SECTION = 0
TYPE_SECTION = 1
IMPORT_SECTION = 2
FUNCTION_SECTION = 3
TABLE_SECTION = 4
MEMORY_SECTION = 5
TAG_SECTION = 13
GLOBAL_SECTION = 6
EXPORT_SECTION = 7
START_SECTION = 8
ELEMENT_SECTION = 9
DATA_COUNT_SECTION = 12
CODE_SECTION = 10
DATA_SECTION = 11

# value types, each its bytes; a reference to a declared type is `nullable(index)`
I32 = [0x7F]
I64 = [0x7E]
F32 = [0x7D]
F64 = [0x7C]
ANYREF = [0x6E]
# a reference to a function, the type of a table of them
FUNCREF = [0x70]
# the storage of an array of bytes, packed
I8 = [0x78]
# heap types, each its bytes (a declared type's is signed(index)), and type constructors
ANY_HEAP = [0x6E]
# the heap type of the references wasm compares by identity, structs and arrays among them
EQ_HEAP = [0x6D]
NULLABLE_REFERENCE = 0x63
FUNCTION_TYPE = 0x60
STRUCT_TYPE = 0x5F
ARRAY_TYPE = 0x5E
# a type that others may extend, with the types it extends
SUBTYPE = 0x50
# types declared together, one recursion group
REC_GROUP = 0x4E
IMMUTABLE = 0
MUTABLE = 1

# what an import or export is
FUNCTION_KIND = 0x00
TABLE_KIND = 0x01
MEMORY_KIND = 0x02
TAG_KIND = 0x04
GLOBAL_KIND = 0x03
# the name every module exports its memory by, which a program reading the compiled library imports it by
MEMORY_EXPORT = "memory"
# the table of the functions values refer to, which every module shares with the library it reads as its memory
TABLE_EXPORT = "warp/functions"

# a tag of an exception, the only kind of tag, and a try_table's clause catching one tag's exceptions with their values
EXCEPTION_TAG = 0x00
CATCH = 0x00
# a data segment kept passive, for `array.new_data`, and an element segment of function indices, for `table.init`
PASSIVE_SEGMENT = 0x01
ACTIVE_SEGMENT = 0x00
# where a module's data starts in its memory (wasm.wap data_placed), and a memory page's size
DATA_ADDRESS = 65536
PAGE_BYTES = 65536

# Instructions, each its opcode bytes; `instruction(opcode, indices)` adds the unsigned immediates it takes.
UNREACHABLE = [0x00]
BLOCK = [0x02]
# a raise: the exception of a tag thrown, its values on the stack, and a block that catches such
THROW = [0x08]
TRY_TABLE = [0x1F]
LOOP = [0x03]
IF = [0x04]
ELSE = [0x05]
BRANCH = [0x0C]
BRANCH_IF = [0x0D]
# the type of a block that takes and leaves nothing
VOID_BLOCK = [0x40]
RETURN = [0x0F]
CALL = [0x10]
RETURN_CALL = [0x12]
# a call of the function a typed function reference on the stack refers to, `call_ref $type`
CALL_REF = [0x14]
CALL_INDIRECT = [0x11]
DROP = [0x1A]
LOCAL_GET = [0x20]
LOCAL_SET = [0x21]
LOCAL_TEE = [0x22]
GLOBAL_GET = [0x23]
GLOBAL_SET = [0x24]
I32_LOAD = [0x28]
I32_LOAD8_U = [0x2D]
I32_STORE = [0x36]
I64_LOAD = [0x29]
F64_LOAD = [0x2B]
F32_LOAD = [0x2A]
I64_STORE = [0x37]
F64_STORE = [0x39]
F32_STORE = [0x38]
I32_STORE8 = [0x3A]
MEMORY_SIZE = [0x3F]
MEMORY_GROW = [0x40]
I32_CONST = [0x41]
I64_CONST = [0x42]
F64_CONST = [0x44]
I32_EQZ = [0x45]
I32_EQ = [0x46]
I32_NE = [0x47]
I32_GT_S = [0x4A]
I32_LT_U = [0x49]
I32_GE_U = [0x4F]
I64_EQ = [0x51]
I64_LT_U = [0x54]
I64_GE_S = [0x59]
F64_EQ = [0x61]
F32_EQ = [0x5B]
I32_ADD = [0x6A]
I32_SUB = [0x6B]
I32_MUL = [0x6C]
I32_DIV_U = [0x6E]
I64_ADD = [0x7C]
I64_SUB = [0x7D]
I32_AND = [0x71]
I32_OR = [0x72]
I32_WRAP_I64 = [0xA7]
I64_EXTEND_I32_U = [0xAD]
REF_NULL = [0xD0]
# the table grown by a count of slots, giving its old size; slots of the table set from an element segment
TABLE_GROW = [0xFC, 15]
TABLE_INIT = [0xFC, 12]
REF_IS_NULL = [0xD1]
REF_EQ = [0xD3]
REF_AS_NON_NULL = [0xD4]
END = [0x0B]
STRUCT_NEW = [0xFB, 0x00]
STRUCT_GET = [0xFB, 0x02]
STRUCT_SET = [0xFB, 0x05]
REF_TEST = [0xFB, 0x14]
# a test that takes ø as of the type too, `ref.test null $t`
REF_TEST_NULL = [0xFB, 0x15]
REF_CAST = [0xFB, 0x16]
REF_CAST_NULL = [0xFB, 0x17]
ARRAY_NEW_DEFAULT = [0xFB, 0x07]
ARRAY_NEW_FIXED = [0xFB, 0x08]
ARRAY_NEW_DATA = [0xFB, 0x09]
ARRAY_GET = [0xFB, 0x0B]
ARRAY_GET_U = [0xFB, 0x0D]
ARRAY_SET = [0xFB, 0x0E]
ARRAY_LEN = [0xFB, 0x0F]
ARRAY_COPY = [0xFB, 0x11]
