# The host's operations: the leaves a `prim` names (forms.wap Prim) whose wasm types are the same in every module,
# one row each by the name the prim writes: the wasm types it takes and gives, and its instructions. A function the
# host imports (WASI) has no instructions: the emitter calls its import. Every other operation the emitter performs
# itself depends on the module or on its operands' types (core/emit/primitives.wap).
use "opcodes.wap"

class WasmOperation { takes: list<list<int>>; gives: list<list<int>>; code: list<int> }
# operations of one signature, each name with its instructions
class Operations { takes: list<list<int>>; gives: list<list<int>>; codes: map<text, list<int>> }

PRIMITIVES = rows_of([
	Operations([I64, I64], [I64], {
		"i64.add": I64_ADD, "i64.sub": I64_SUB, "i64.mul": [0x7E], "i64.div_s": [0x7F], "i64.rem_s": [0x81], "i64.and": [0x83],
		"i64.or": [0x84], "i64.xor": [0x85], "i64.shl": [0x86], "i64.shr_s": [0x87], "i64.shr_u": [0x88], "i64.rotl": [0x89], "i64.rotr": [0x8A]
	}),
	Operations([I64, I64], [I32], {"i64.eq": I64_EQ, "i64.ne": [0x52], "i64.lt_s": [0x53], "i64.gt_s": [0x55], "i64.le_s": [0x57], "i64.ge_s": I64_GE_S}),
	Operations([I64], [I64], {"i64.clz": [0x79], "i64.ctz": [0x7A], "i64.popcnt": [0x7B]}),
	Operations([F64, F64], [F64], {"f64.add": [0xA0], "f64.sub": [0xA1], "f64.mul": [0xA2], "f64.div": [0xA3]}),
	Operations([F64, F64], [I32], {"f64.eq": F64_EQ, "f64.ne": [0x62], "f64.lt": [0x63], "f64.gt": [0x64], "f64.le": [0x65], "f64.ge": [0x66]}),
	Operations([F64], [F64], {"f64.neg": [0x9A], "f64.floor": [0x9C], "f64.ceil": [0x9B], "f64.abs": [0x99], "f64.sqrt": [0x9F]}),
	Operations([F64], [I64], {"i64.trunc_f64_s": [0xB0], "i64.reinterpret_f64": [0xBD]}),
	Operations([I64], [F64], {"f64.convert_i64_s": [0xB9], "f64.reinterpret_i64": [0xBF]}),
	Operations([I32], [I64], {"i64.extend_i32_u": I64_EXTEND_I32_U, "i64.extend_i32_s": [0xAC]}),
	Operations([I64], [I32], {"i32.wrap_i64": I32_WRAP_I64}),
	Operations([I32], [I32], {"i32.eqz": I32_EQZ}),
	Operations([F64], [F32], {"f32.demote_f64": [0xB6]}),
	Operations([F32], [F64], {"f64.promote_f32": [0xBB]}),
	Operations([], [], {"unreachable": UNREACHABLE}),
	# the module's memory, its loads and stores by their alignment and offset, and the host's functions
	Operations([I32], [I32], {"i32.load8_u": I32_LOAD8_U + [0, 0], "i32.load": I32_LOAD + [2, 0], "fd_close": []}),
	Operations([I32, I32], [], {"i32.store": I32_STORE + [2, 0], "i32.store8": I32_STORE8 + [0, 0]}),
	Operations([], [I32], {"memory.size": MEMORY_SIZE + [0]}),
	Operations([I32, I32, I32, I32], [I32], {"fd_write": [], "fd_read": [], "poll_oneoff": []}),
	Operations([I32, I32], [I32], {"args_sizes_get": [], "args_get": [], "environ_sizes_get": [], "environ_get": [], "random_get": []}),
	Operations([I32], [], {"proc_exit": []}),
	Operations([I32, I64, I32, I32], [I32], {"fd_seek": []}),
	Operations([I32, I32, I32, I32, I32, I64, I64, I32, I32], [I32], {"path_open": []}),
	Operations([I32, I64, I32], [I32], {"clock_time_get": []}),
	Operations([I32, I32, I32, I64, I32], [I32], {"fd_readdir": []})
])
# The layouts of the types a word names that need no type of the module, the same in every module: `number` and `any`
# hold any value, a plain one boxed (core/emit/values.wap fitted)
# (an i32 is wasm's own i32, the machine word that wraps at 32 bits and the int a foreign function's signature writes:
# an address in the module's memory too; int32 is its other spelling, sugar/types.wap)
# (a float32 is wasm's f32, the float a foreign function's signature writes for C's float)
# (a ø parameter, which an argument giving no value is passed to, an anyref holding null)
WORD_LAYOUTS = {"int": I64, "float": F64, "float32": F32, "bool": I32, "char": I32, "i32": I32, "number": ANYREF, "any": ANYREF, "or": ANYREF, "ø": ANYREF}
# the words a whole numeral is of where one of them is wanted, `x: i32 = 5`, by the bits they hold (core/analyze/types.wap)
WHOLE_BITS = {"int": 64, "i32": 32}
# the layouts of plain values: the only ones a build keeping its values in the memory takes, and the words of them, each
# boxed where an `any` holds it
PLAIN_VALUES = [I32, I64, F32, F64]
BOXED_WORDS = WORD_LAYOUTS.keys.filter(word => WORD_LAYOUTS[word] in PLAIN_VALUES)
# The types library's functions the emitter calls itself, each by its name and its parameters' types: two texts
# compared, two joined, one written to a file. Every program types them, as the emitter may call them where the
# program does not
TEXT_EQUALITY = "==(text, text)"
TEXT_JOINING = "+(text, text)"
TEXT_WRITING = "write(text, int, bool)"
RUNTIME_WORDS = [TEXT_EQUALITY, TEXT_JOINING, TEXT_WRITING]
rows_of(groups: list<Operations>) as map<text, WasmOperation> := {
	rows: map<text, WasmOperation> = {}
	for group in groups {
		for name in group.codes.keys { rows[name] = WasmOperation(group.takes, group.gives, group.codes[name]) }
	}
	rows
}
# whether an operation is a function the host imports
is_imported(operation: WasmOperation) as bool := operation.code is empty
