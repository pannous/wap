# Quotient types (notes/coc-plan.md 6.4 and 6.6; this folder's files: notes/theory.md "The declarations that bind
# names"). The statement `quotients(Equal)` names the type of equality and adds four constants: the quotient of a type
# by a relation, the maker of its values, and the two ways out, lift and induct, which compute on a made value
# (compute.wap). That joined values are equal is an axiom of the prelude, never the kernel's.

use "terms.wap"
use "levels.wap"
use "environment.wap"
use "typing.wap"
use "inductive.wap"
use "recursors.wap"

# the four constants the statement adds
QUOTIENT := "quotient"
QUOTIENT_OF := "quotient.of"
QUOTIENT_LIFT := "quotient.lift"
QUOTIENT_INDUCT := "quotient.induct"
# the level parameters of the type taken apart and of the type lift leads into
QUOTIENT_LEVELS := ["u", "v"]

# the place of a way out's function among its arguments, and of the made value it computes on, 0 for a part that
# never computes
QUOTIENT_FUNCTION := 4
# the argument of quotient(T, r) its values are held as: T, its carrier, as Lean erases Quot.mk
QUOTIENT_CARRIER := 1
quotient_major(part: QuotientPart): int := if part == QuotientPart.Lift then 6 else if part == QuotientPart.Induct then 5 else 0

# `quotients(equality)`: equality has the shape of `Equal`; the four constants are checked by typing and added, resting
# on nothing. It stands once
quotients_declared(e: Environment, equality: Term) := {
	if e.quotients is not ø { refused(QUOTIENTS, "the quotients are declared already") }
	equality_checked(e, equality, QUOTIENTS)
	names = [QUOTIENT, QUOTIENT_OF, QUOTIENT_LIFT, QUOTIENT_INDUCT]
	declared_together(e, names, ids => quotient_parts(e, equality, ids), part => {
		level_of(checker(e, part.levels), part.type)
		rested(e, part)
	})
	# the parts took the last ids, in the order of their names
	first = size(e) - #names
	e.quotients = Quotients(constant(first + 1, QUOTIENT, []), constant(first + 2, QUOTIENT_OF, []))
	e.held_as[first + 1] = QUOTIENT_CARRIER
}
# the four constants of the quotients, given the ids they take
quotient_parts(e: Environment, equality: Term, ids: list<int>): list<Declaration> := {
	u = Parameter(QUOTIENT_LEVELS#1)
	v = Parameter(QUOTIENT_LEVELS#2)
	c = checker(e, QUOTIENT_LEVELS)
	t = entered(c, "T", universe(u))
	r = entered(c, "r", pis([entered(c, "a", t.variable), entered(c, "b", t.variable)], PROP))
	shared = [t, r]
	quotiented = apply_all(constant(ids#1, QUOTIENT, [u]), variables(shared))
	a = entered(c, "a", t.variable)
	b = entered(c, "b", t.variable)
	q = entered(c, "q", quotiented)
	# lift: a function that gives equal results on joined values
	into = entered(c, "B", universe(v))
	f = entered(c, "f", pis([a], into.variable))
	respects = entered(c, "respects", pis([a, b, entered(c, "joined", apply_all(r.variable, [a.variable, b.variable]))], apply_all(at_levels(equality, [v]), [into.variable, apply(f.variable, a.variable), apply(f.variable, b.variable)])))
	# induct: a property of every made value holds of every value
	motive = entered(c, "motive", pis([q], PROP))
	h = entered(c, "h", pis([a], apply(motive.variable, apply_all(constant(ids#2, QUOTIENT_OF, [u]), variables(shared) + [a.variable]))))
	[
		Declaration(QUOTIENT, [QUOTIENT_LEVELS#1], pis(shared, universe(u)), Quotient(QuotientPart.Former)),
		Declaration(QUOTIENT_OF, [QUOTIENT_LEVELS#1], pis(shared + [a], quotiented), Quotient(QuotientPart.Of)),
		Declaration(QUOTIENT_LIFT, QUOTIENT_LEVELS, pis(shared + [into, f, respects, q], into.variable), Quotient(QuotientPart.Lift)),
		Declaration(QUOTIENT_INDUCT, [QUOTIENT_LEVELS#1], pis(shared + [motive, h, q], apply(motive.variable, q.variable)), Quotient(QuotientPart.Induct))
	]
}
