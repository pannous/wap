# How a running program holds an int (wiki/number.md "Whole numbers": an int is unbounded and exact), the one layout
# both builds read: one i64, which is the int itself where the int is a scalar, at least SMALLEST_SCALAR; a smaller
# word is a handle, the place of a whole number past the scalars in the types library's table (types/whole.wap). Each
# number has one handle, so two ints are equal where their words are. Handles are never freed, so a program makes at
# most HANDLES whole numbers past the scalars in its life.
HANDLES := 4294967296
# -2^63 + HANDLES, and 2^63 - 1
SMALLEST_SCALAR := -9223372032559808512
LARGEST_SCALAR := 9223372036854775807
# the type of the scalars (types/whole.wap): a row on ints whose value compiling shows is one runs as its instruction
# (core/analyze/dispatch.wap row_fitted)
SCALAR_WORD = "scalar"
# the bounds of the word a row of the machine gives as an int (core/analyze/bounds.wap): a 32-bit word given where an
# int is wanted is extended unsigned (core/emit/primitives.wap wasm_called), a count among them; one extended signed
UNSIGNED_WORD := [0, 4294967295]
ROW_BOUNDS = {"i64.extend_i32_u": UNSIGNED_WORD, "i64.extend_i32_s": [-2147483648, 2147483647], "array.len": UNSIGNED_WORD, "array.get_u": UNSIGNED_WORD, "list_count": UNSIGNED_WORD, "i32.load": UNSIGNED_WORD, "i32.load8_u": UNSIGNED_WORD}
# a word where an int is wanted, a handle below the scalars, and an int's word, wrapped by 2^64 (core/analyze/fits.wap)
WIDENED_WORD = "widened"
WRAPPED_WORD = "wrapped"
# the types library's functions a row on ints runs where an operand or its value is past the scalars, by the row's
# name (core/emit/primitives.wap carried_code); an order's function gives -1, 0 or 1
CARRIED_ROWS = {"i64.add": "carried_sum", "i64.sub": "carried_difference", "i64.mul": "carried_product", "i64.div_s": "carried_quotient", "i64.rem_s": "carried_remainder", "i64.shl": "carried_shifted", "i64.shr_s": "carried_halved", "i64.and": "carried_and", "i64.or": "carried_or", "i64.xor": "carried_xor", "i64.shr_u": "carried_unsigned_halved"}
ORDER_ROWS = ["i64.lt_s", "i64.gt_s", "i64.le_s", "i64.ge_s"]
CARRIED_ORDER = "carried_order"
# an int past the scalars where the machine takes a plain word (32 bits, a foreign function's argument), refused; a
# word a foreign function gives, widened
CARRIED_NARROWING = "beyond_scalars"
WIDENING = "widened(i64)"
CARRIED_WORDS = (CARRIED_ROWS.values() + [CARRIED_ORDER]).map(word => "${word}(int, int)") + ["${CARRIED_NARROWING}(int)", WIDENING]
