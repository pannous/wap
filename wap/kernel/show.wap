# A term shown in wap notation, as format writes it: `(a: Prop) -> a -> And(a, a)`, `identity[1](bool)`, `Type(u)`;
# given the environment it is declared in, a type former applied as a type is written, `list<nat>` (wiki/type.md).
#
# A binder whose variable the rest does not use is shown without its name (`a -> b`); arrows nest to the right
# without brackets, and a function type or function standing as a domain or as the function applied is bracketed.
# A binder named like one around it gets a number, so each variable is shown by the binder it refers to.
use "terms.wap"
use "levels.wap"
use "environment.wap"

# a binder written without a name, shown where its variable is used
UNNAMED := "x"

# a closed term shown
shown(t: Term, e: Environment? = ø): text := shown_in(t, [], no_free_names(), e)
no_free_names(): map<int, text> := {}

# t shown inside binders of these names, the innermost last, its free variables by these names
shown_in(t: Term, names: list<text>, free: map<int, text>, e: Environment?): text := match t.shape {
	Bound(index) => if index < #names then names#(#names - index) else "#${index}"
	Free(id) => free.get(id) ?? "_${id}"
	Sort(level) => sort_shown(level)
	Constant(name, levels, _) => int_shown(t) ?? if levels is empty then name else "${name}[${levels.map(level => level_shown(level)).join(", ")}]"
	Apply(function, argument) => int_shown(t) ?? if type_former(e, head(t)) then "${constant_name(head(t))}<${listed(arguments(t), names, free, e)}>" else "${operand_shown(head(t), names, free, e)}(${listed(arguments(t), names, free, e)})"
	Lambda(binder, domain, body) => { name = fresh(binder, names + values(free)); "(${name}: ${shown_in(domain, names, free, e)}) => ${shown_in(body, names + [name], free, e)}" }
	Pi(binder, domain, body) => if mentions(body, 0) then { name = fresh(binder, names + values(free)); "(${name}: ${shown_in(domain, names, free, e)}) -> ${shown_in(body, names + [name], free, e)}" } else "${operand_shown(domain, names, free, e)} -> ${shown_in(body, names + [UNNAMED], free, e)}"
	LetIn(binder, type, value, body) => { name = fresh(binder, names + values(free)); "{ ${name}: ${shown_in(type, names, free, e)} = ${shown_in(value, names, free, e)}; ${shown_in(body, names + [name], free, e)} }" }
	Numeral(value) => "${value}"
	Quoted(value) => show(value)
	Projection(structure, field, of) => "projection(${constant_name(structure)}, ${field}, ${shown_in(of, names, free, e)})"
}
# terms shown as a call's arguments: `a, b`
listed(terms: list<Term>, names: list<text>, free: map<int, text>, e: Environment?): text := terms.map(t => shown_in(t, names, free, e)).join(", ")
# whether a constant names a type former, its every parameter a type and its result a type, no proposition: `list`;
# without an environment none is known, so it is shown as a function is, its levels in brackets
type_former(e: Environment?, t: Term): bool := match t.shape {
	Constant(name, levels, id) => e != ø and former_type((declared_at(e!, id) ?? return no).type)
	_ => no
}
former_type(type: Term): bool := match type.shape {
	Pi(binder, domain, body) => match domain.shape { Sort(level) => former_type(body); _ => no }
	Sort(level) => never_zero(level)
	_ => no
}
# an int's case over a count numeral, shown as the whole number it is (counting.wap): `int.positive(1)` is 2
int_shown(t: Term): text? := {
	value = int_value(t) ?? return ø
	"${value}"
}
int_value(t: Term): int? := match t.shape {
	Constant(name, levels, _) => if name == int_case(1) then 0 else ø
	Apply(function, argument) => {
		count = match argument.shape { Numeral(value) => value + 1; _ => return ø }
		case = match function.shape { Constant(name, levels, _) => name; _ => return ø }
		if case == int_case(2) then count else if case == int_case(3) then -count else ø
	}
	_ => ø
}
# a term standing where an arrow would take it apart: a function type or a function, bracketed
operand_shown(t: Term, names: list<text>, free: map<int, text>, e: Environment?): text := match t.shape {
	Pi(binder, domain, body) => "(${shown_in(t, names, free, e)})"
	Lambda(binder, domain, body) => "(${shown_in(t, names, free, e)})"
	_ => shown_in(t, names, free, e)
}
# a binder's name, numbered when a binder around it has it already
fresh(binder: text, names: list<text>): text := {
	base = if binder == "" then UNNAMED else binder
	name = base
	count = 1
	while names.contains(name) {
		count += 1
		name = "${base}${count}"
	}
	name
}
# whether t uses the variable bound `index` binders out
mentions(t: Term, index: int): bool := if t.loose <= index then no else match t.shape {
	Bound(at) => at == index
	Lambda(binder, domain, body) => mentions(domain, index) or mentions(body, index + 1)
	Pi(binder, domain, body) => mentions(domain, index) or mentions(body, index + 1)
	LetIn(binder, type, value, body) => mentions(type, index) or mentions(value, index) or mentions(body, index + 1)
	_ => parts(t).any(part => mentions(part, index))
}

# Prop, Type, Type(u) for the universe above u, Sort(u) for one that may be Prop
sort_shown(level: Level): text := {
	number = level_number(level)
	if number is not ø { return if number == 0 then "Prop" else if number == 1 then "Type" else "Type(${number! - 1})" }
	match level {
		Successor(of) => "Type(${level_shown(of)})"
		_ => "Sort(${level_shown(level)})"
	}
}
# a level as written: 2, u, u + 1, max(u, v), imax(u, v)
level_shown(level: Level): text := {
	number = level_number(level)
	if number is not ø { return "${number}" }
	match level {
		Successor(of) => level_above_shown(of, 1)
		Max(left, right) => "max(${level_shown(left)}, ${level_shown(right)})"
		Imax(left, right) => "imax(${level_shown(left)}, ${level_shown(right)})"
		Parameter(name) => name
		_ => "0"
	}
}
# a level so many steps above another: u + 2
level_above_shown(level: Level, steps: int): text := match level {
	Successor(of) => level_above_shown(of, steps + 1)
	_ => "${level_shown(level)} + ${steps}"
}
