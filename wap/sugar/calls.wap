# Calls written other ways (notes/agents/wap-owner.md sugar/): `x.f(y)` is f(x, y), any function on any value, and
# `x.f` is x's part named f, a field or else f(x) (kernel/forms.wap Get), so a chain reads in order: `xs.map(f).sum`
rule $x.$f($arguments...) => $f($x, $arguments...)
# an item after a part or a method call, `g.names["b"]`, `line.split(" ")[1][1:]`, is the part or the call taken first,
# then its items: the reader glued the brackets to the name
rule $x.$part[$key] => ($x.$part)[$key]
# and a call of that item, `b.handlers["a"]("x")`, calls the item, never f on x
rule $x.$f[$key]($arguments...) => Get($x, "$f")[$key]($arguments...)
rule $x.$f => Get($x, "$f")
# `function floor` names the function without calling it, as `floor` alone does where a value is wanted (wiki/lambda.md)
rule function $name: Symbol => $name
# a script shows its last value, if it gives one: `1 + 2` alone prints 3
# (the value held first, then shown by a statement annotated shown: a module a program uses runs all but that, its
# warp/start, core/emit/emitter.wap)
rule (Block $statements... $last: value) where script => { $statements...; shown_value = $last; @shown print(show(shown_value)) }
