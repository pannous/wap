# Conditions written other ways, as If (notes/agents/wap-owner.md sugar/; wiki/keyword.md): the spellings wap's
# own source uses. The condition runs to the first then or block, the then part to the first else, so `else if …`
# chains.

# a block of code in braces, `{ print "a" }`, a then part without then
pattern Braces = { $statements... }

rule if $condition... then $then... else $else... => If($condition, $then, $else)
rule if $condition... then $then... => If($condition, $then, ø)
rule if $condition... $then: Braces else $else... => If($condition, $then, $else)
rule if $condition... $then: Braces => If($condition, $then, ø)
# whose else is it? `if a then if b then x else y` reads two ways
rule if $condition... then if $inner... else $else... => refuse "this else may belong to either if: put the inner if in braces"

rule unless $c $body => If($c, ø, $body)

# a body and its handler for when it raises, a function of the caught Error (wiki/Error.md): `try parse(s) else 0`,
# `try { raise "boom" } catch e { e.message }`; a handler that does not name the error ignores it
rule try $body... catch $error $handler: Braces => Try($body, $error => $handler)
rule try $body... catch $handler: Braces => Try($body, _ => $handler)
rule try $body... else $otherwise... => Try($body, _ => $otherwise)

# a choice written after its condition, `c ? a : b` (the operator table's choice, below every operator), and a
# statement guarded after it, `print "a" if c`
rule ($c ? $then : $else) => If($c, $then, $else)
rule $then... if $c => If($c, $then, ø)
# `a ?? b`: a's value when it has one, else b, which runs only then; a runs once, held under a fresh name
rule $a ?? $b => { held = $a; If(missing(held), $b, held!) }
# a chain of comparisons, `a < b < c` (core/parse/operators.wap chained_call): both comparisons of neighbours, the middle
# value computed once; a chain of truth values reads two ways, `p == q == r` a chain or `(p == q) == r`
rule comparison_chain($a, $op, $b, $next, $c) => { held = $b; chained(held, $op($a, held) and $next(held, $c)) }
rule chained($middle: bool, $chain) => refuse "a chain of truth values reads two ways: write (p == q) == r or p == q and q == r"
rule chained($middle: value, $chain) => $chain
# a comparison with ø, `x == ø`, `x is ø`, `x != ø`, is whether x is missing, whatever its type compares by
rule $a == ø => missing($a)
rule $a is ø => missing($a)
# DEBT: A rule's output names resolve where the rule fires: a template's words are bound in the program's scope, so a
#   local named `missing` hid the types module's predicate here (calls.wap words_missing was renamed `lacking`). Paid
#   off when a template's names bind in the rule's own file, as a hygienic macro's do.
rule $a != ø => not missing($a)
