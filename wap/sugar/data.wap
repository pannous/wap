# Data reached other ways, as Get (wap/kernel/forms.wap Data): the spellings wap's own source uses.

# a list's item by its place, counting from 1: `xs#2`
rule ($subject#$key) => Get($subject, $key)
# a quoted key is the item of that key, never a word of the subject's type: `{count: 5}#"count"` is 5
rule ($subject#($key: Text)) => $subject[$key]
# an item given a value by its place, `xs#2 = 5`, `m#"a" = 1`: the set of the subject's type, a list's or a map's,
# its value worked out first, then the subject and the place, as Python does
rule ($subject#$key = $value) => set($value, $subject, $key)
# an item's own item, `xs#1[1 ..]`, is the item taken first, then its index: the reader glued the brackets to the
# place, as it glues them to a part's name (calls.wap `x.f[key]`)
rule ($subject#$key[$index]) => Get($subject, $key)[$index]


# a list's item by its index, counting from 0 (wiki/indexing.md): `xs[0]` is the first item, `xs#1`
rule $subject[$index] => Item($subject, $index)
# a slice by indexes as in Python, `xs[1:3]` indexes 1 up to 3 (wiki/indexing.md): the range `xs[1 .. 3]`
rule $subject[$from: $to] => $subject[$from .. $to]
# a spread written as in Python, `[0, *xs]`, is JavaScript's `...xs` (wiki/list.md "Spread"); a template spells
# `...` as a word by its text, since written bare it repeats a part of the template
rule (*$xs) => Symbol("...")($xs)
# a condition on `it`, `xs where it > 1` (wiki/list.md), `int where it > 0` (wiki/subtype.md): the condition is the
# function of `it` it writes, so a list's are the items it keeps and a type's the values that meet it
rule $xs where $condition => where($xs, it => $condition)
