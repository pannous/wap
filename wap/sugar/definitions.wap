# Definitions written other ways (notes/agents/wap-owner.md sugar/): the spellings wap's own source uses
# a result type after `as`, `f(x) as T := …`, is the typed head `f(x): T := …`
rule ($head as $type := $body) => ($head: $type := $body)
# a built-in's body, an operation the emitter performs itself (kernel/forms.wap Prim), written by the types module and
# by any library: `print(t: text) := prim print_text(t)`, `popcount(n: int) as int := prim i64.popcnt(n)`
rule prim $operation($arguments...) => Prim($operation, $arguments...)
# a wasm instruction by its mnemonic, its type and operation glued by a dot: `prim i64.add(a, b)` (kernel/opcodes.wap)
rule prim $type.$operation($arguments...) => Prim(Symbol("$type.$operation"), $arguments...)
# which variable a name means (kernel/forms.wap Variable): `global x` the program's, `let x` a new one here. The word
# leads its phrase, so an assignment after it is the phrase's one part, `global (n = 1)`, whose place is the Variable
rule global $name => Variable($name, global)
rule let $name => Variable($name, local)
rule global ($name = $value) => (Variable($name, global) = $value)
rule let ($name = $value) => (Variable($name, local) = $value)
# a definition's modifiers (wiki/keyword.md Modifiers): `public f(x) := …` and `global f(x) := …` change nothing, a
# definition is the program's word and its importers' already; `const z = 7` is the constant z := 7
# DEBT: the wiki keeps an untyped library word private unless it is public (wiki/function.md, keyword.md); wap shows
#   every definition, so public changes nothing yet. Paid off when an untyped word is its own module's only.
rule public $definition => $definition
# TODO (card rule-word-set) one rule `where $word in [global, public, const, def]` once a rule's where takes more than one word
rule (global $head := $body) => ($head := $body)
rule (public $head := $body) => ($head := $body)
rule (def $head := $body) => ($head := $body)
rule (const $head := $body) => ($head := $body)
# `def f(x) { x * 2 }` (wiki/keyword.md def) is f(x) := { x * 2 }
rule def $head $body: Braces => ($head := $body)
rule const ($name = $value) => ($name := $value)
# a type named for another, a condition on it or not (wiki/subtype.md): `type char = text where #it == 1` is the
# definition char := text where #it == 1, `type vector(T, n: nat) = list<T> where #it == n` one with parameters
rule (type $head = $body) => ($head := $body)
# a property of a value (decision property-accessors): `canvas.width := canvas_width` the getter width(canvas), read
# as canvas.width; `canvas.width(w) := …` the setter width(canvas, w), called as canvas.width(w)
rule ($subject.$name := $body) => ($name($subject) := $body)
rule ($subject.$name($parameters...) := $body) => ($name($subject, $parameters...) := $body)
# A program's operator (wiki/operator.md), its spelling and binding known to the reader already: the function of that
# name, its head as a function's, its result type written or not. `operator ⊕` alone is infix; without parameters an
# infix operator's operands are left and right, another's it
rule (operator $rest... := $body) => (infix operator $rest... := $body)
rule ($fixity operator $definition := $body) => ($definition := $body)
rule ($fixity operator $definition: $type := $body) => ($definition: $type := $body)
rule (infix operator $name: Symbol := $body) => ($name(left, right) := $body)
# a glyph pair bracketing its operand calls the function named, `circumfix operator ‖ ‖ := abs`: ‖x‖ is abs(x)
rule (circumfix operator $opening: Symbol $closing: Symbol := $function) => ($opening(it) := $function(it))
rule ($fixity operator $name: Symbol := $body) => ($name(it) := $body)
# a precedence declaration is no code: the reader placed its operator (core/parse/operator_table.wap)
rule operator $spelling has precedence $side $other => ()
# A theorem, a law and an axiom (wiki/proof.md, wiki/laws.md) are the word called on the declaration: a proved one the definition of its proof, `theorem
# four: 2 + 2 == 4 := refl` (extensions/law_for.wap); one without a value whose name takes parameters one of a function type, `axiom f(x: A): B`
# is `axiom f: (x: A) -> B`
# TODO (card rule-word-set) one rule each `where $word in [theorem, law, axiom]` once a rule's where takes more than one word
rule theorem ($name($parameters...): $type) => theorem($name: (($parameters...) -> $type))
rule law ($name($parameters...): $type) => law($name: (($parameters...) -> $type))
rule axiom ($name($parameters...): $type) => axiom($name: (($parameters...) -> $type))
