# Definitions written other ways (notes/agents/wap-owner.md sugar/): the spellings wap's own source uses
# a result type after `as`, `f(x) as T := …`, is the typed head `f(x): T := …`
rule ($head as $type := $body) => ($head: $type := $body)
# a built-in's body, an operation the emitter performs itself (kernel/forms.wap Prim); only the types module writes it:
# `print(t: text) := prim print_text(t)`
rule prim $operation($arguments...) => Prim($operation, $arguments...)
# a wasm instruction by its mnemonic, its type and operation glued by a dot: `prim i64.add(a, b)` (core/emit/opcodes.wap)
rule prim $type.$operation($arguments...) => Prim(Symbol("$type.$operation"), $arguments...)
# which variable a name means (kernel/forms.wap Variable): `global x` the program's, `let x` a new one here. The word
# leads its phrase, so an assignment after it is the phrase's one part, `global (n = 1)`, whose place is the Variable
rule global $name => Variable($name, global)
rule let $name => Variable($name, local)
rule global ($name = $value) => (Variable($name, global) = $value)
rule let ($name = $value) => (Variable($name, local) = $value)
# a definition's modifiers (wiki/keyword.md Modifiers): `public f(x) := …` and `global f(x) := …` change nothing, a
# definition is the program's word and its importers' already; `const z = 7` is the constant z := 7
# DEBT: the wiki keeps an untyped library word private unless it is public (wiki/function.md, keyword.md); wap shows
#   every definition, so public changes nothing yet. Paid off when an untyped word is its own module's only.
rule public $definition => $definition
rule (global $head := $body) => ($head := $body)
rule const ($name = $value) => ($name := $value)
rule (const $head := $body) => ($head := $body)
# A program's operator (wiki/operator.md), its spelling and binding known to the reader already: the function of that
# name. `operator ⊕` alone is infix; without parameters an infix operator's operands are left and right, another's it
rule (operator $rest... := $body) => (infix operator $rest... := $body)
rule ($fixity operator $name($parameters...) := $body) => ($name($parameters...) := $body)
rule (infix operator $name: Symbol := $body) => ($name(left, right) := $body)
rule ($fixity operator $name: Symbol := $body) => ($name(it) := $body)
