# Loops and the words that leave them, as While, Break, Continue and Return (wiki/keyword.md): the spellings wap's own
# source uses.

rule while $condition... $body: Braces => While($condition, $body)
rule return $value... => Return($value)
rule return => Return(Empty())
rule break => Break()
rule continue => Continue()
rule until $condition... $body: Braces => While(not $condition, $body)

# A loop over each item of a list or each int of a range, as While (wiki/keyword.md for); a range is counted without
# one. Its count goes up before the body, so `continue` moves on; the names the rule binds itself are fresh, never the
# program's.
# DEBT: `for` is two rules, a `to` range (`..` a spelling of it) and a list walked by index, not an iterator
#   (`i = iterator(xs)`, While(has_next(i), …)): wap's own source walks only these two; a Range held in a name
#   (`r = 1 to 3; for i in r`) takes the list rule. Paid off by the first third kind of thing to walk.
rule for $item in $from to $last $body: Braces => { $item = $from - 1; while $item < $last { $item = $item + 1; $body } }
rule for $item in $from .. $end $body: Braces => for $item in $from to $end - 1 $body
rule for $item in $items $body: Braces => { held = $items; at = 0; while at < #held { at = at + 1; $item = held#at; $body } }
# what is walked without naming its item names it `it`: `for 1..10 { print it }`, `for xs: print it` (wiki/for.md)
rule for $items $body: Braces => for it in $items $body

# A comprehension, a list of a value for each item (wiki/keyword.md for … if): `[x * 2 for x in xs if x > 1]` the
# value of each item the condition keeps
rule [$value... for $item in $items... for $other in $others...] => flat_map($items, $item => [$value... for $other in $others...])
rule [$value... for $item in $items... if $condition...] => [$value... for $item in filter($items, $item => $condition)]
rule [$value... for $item in $items...] => map($items, $item => $value)
