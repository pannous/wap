# Loops and the words that leave them, as While, Break, Continue and Return (wiki/keyword.md): the spellings wap's own
# source uses.

rule while $condition... $body: Braces => While($condition, $body)
rule return $value... => Return($value)
rule return => Return(Empty())
rule break => Break()
rule continue => Continue()
rule until $condition... $body: Braces => While(not $condition, $body)

# A loop over each int of a range or each item of a list, a For over their places (wiki/keyword.md for); a range is
# counted with no list, what is no list is walked as the list `walked` makes of it, a map as its keys. The names the
# rule assigns itself are fresh, never the program's, the place `at` too.
rule for $item in $from to $last $body: Braces => { first = $from; at = 0; For(at, $last - first + 1, { $item = first + at - 1; $body }) }
rule for $item in $from .. $end $body: Braces => for $item in $from to $end - 1 $body
rule for $item in $items $body: Braces => { held = walked($items); at = 0; For(at, #held, { $item = held#at; $body }) }
# what is walked without naming its item names it `it`: `for 1..10 { print it }`, `for xs: print it` (wiki/for.md)
rule for $items $body: Braces => for it in $items $body
# a map walked with each key and its value named, a list with each place and its item: `for key, value in scores { … }`
# (wiki/inventions.md)
rule for $key, $value in $map $body: Braces => { held = pairs($map); for $key in held { $value = held[$key]; $body } }

# A comprehension, a list of a value for each item (wiki/keyword.md for … if): `[x * 2 for x in xs if x > 1]` the
# value of each item the condition keeps
rule [$value... for $item in $items... for $other in $others... $clauses...] => flat_map($items, $item => [$value... for $other in $others... $clauses...])
rule [$value... for $item in $items... if $condition...] => [$value... for $item in filter($items, $item => $condition)]
rule [$value... for $item in $items...] => map($items, $item => $value)
