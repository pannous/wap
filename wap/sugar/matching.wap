# A choice by patterns, as Case (wap/kernel/forms.wap; wiki/pattern-matching.md): `match x { 1 => "one"; _ => "other" }`
rule match $subject... { ($pattern => $result)... } => Case($subject, Arm($pattern, $result)...)
# arms written as keys, `match coin { Penny: 1; Dime: 10 }` (wiki/matching.md): the arms `Penny => 1`
rule match $subject... { ($pattern: $result)... } => match $subject { ($pattern => $result)... }
# a rest written without a name, `[.., last]`, is the rest no name holds, `..._` (wiki/pattern-matching.md)
rule [$before..., .., $after...] => [$before..., Symbol("...")(_), $after...]
