# Types declared other ways, as Record (wap/kernel/forms.wap Record; wiki/class.md): the spellings wap's own source
# uses.

# a class, its fields typed names, a field's default after `=` (wiki/class.md), then its methods; the rule writes its
# constructor, a field with a default left out of a call taking it, the instance as data, and each method as a function
# whose first parameter, self, is the instance, so `p.size()` calls size(p) and `p.size` too; and text, the instance in
# its constructor form, `P{x: 3}`, each field shown by its own type's show, which a class's own text replaces, its
# show the text, so a list of instances shows each by the class's text, the shown fields a list<text> even where there are
# none; and fields, the field names in order
# (wiki/reflection.md)
# DEBT: The class rule's helper words (`member_as "field"`, `member_of`, `member_named`, `shown_case`) are ordinary
#   words: a program writing them is rewritten too. Paid off when a program meets one: words only rule files may write
#   get a private word in the reader.
# a required word (wiki/trait.md), a member without a body, its result any where it writes none
rule class $name { $before... ($word($parameters...)) $after... } => class $name { $before... ($word($parameters...): any) $after... }
rule class $name { $members... } => instances $name [$members...]; (member_as "method" $name $members)...
# a class extending another, `class B extends A {…}`, `class B < A {…}` or `class B: A {…}` (wiki/class.md,
# wiki/trait.md): A's fields, then its own
# `square: shape {…}` reads as a key whose value is the phrase of the base and the members
pattern Claim = $base { $members... }
rule class $name: Claim($base, $members...) => class $name extends $base { $members... }
rule class $name < $base { $members... } => class $name extends $base { $members... }
rule class $name extends $base: class { $members... } => inherited $name $base [$members...]
# the class's name says what it extends, `@extends(A)`, so its values are values of A (wiki/class.md)
rule inherited $name Record($base, [$fields...], []) [$members...] => class @extends($base) $name { $fields... $members... }
# a protocol base, its record annotated so: the class claims it, the protocol's function of it, `shape(s)`, the class
# itself, which the typing refuses where the class lacks a word of the protocol
rule inherited $name @protocol Record($base, $fields, []) [$members...] => class $name { $members... }; Symbol("$base")(self: $name): Symbol("held_$base") := Symbol("held_$base")(self, Symbol("${base}_words")((claimed_word $name $fields)...))
# a claim boxes its class as the held value does, each word of the protocol a lambda from the field's function type
rule claimed_word $name ($word: (($base, $types...) -> $type)) => (word_lambda $word $name [$types...])
rule claimed_word $name $field => ()
rule inherited $name Record($base, $fields, $cases) [$members...] => refuse "a class extends a class, never an enum: an enum's cases are its values"
# a class with a required word is a protocol (wiki/trait.md), its record annotated so: it has no instances of its own,
# so no constructor, text or show, and no fields, only words, some with a default body; any other class has its fields
# and all three
rule instances $name [$before..., ($word($parameters...): $type), $after...] => @protocol Record($name, [(required_field $name $before)..., (required_field $name ($word($parameters...): $type)), (required_field $name $after)...], []); (abstract $before)...; (abstract $after)...; held $name [$before..., ($word($parameters...): $type), $after...]
rule instances $name [$members...] => Record($name, [(member_as "field" $members)...], []); constructed $name [$members...]; text(self: $name): text := "$name{" + join([(member_as "shown" $members)...] as list<text>, ", ") + "}"; show(self: $name): text := text(self); fields(self: $name): list<text> := [(member_as "named" $members)...]
# a class with an init is made by it (wiki/class.md "init is the constructor"): its fields' defaults, then init run on
# them with the call's arguments, `P(3)` of `init(v: int) := { x = v * 2 }`; any other class by its fields
rule constructed $name [$before..., (init(($parameter: $type)...) := $body), $after...] => ($name(($parameter: $type)...): $name := { made = $name{(member_as "default" $before)..., (member_as "default" $after)...}; init(made, ($parameter)...); made })
rule constructed $name [$members...] => ($name((member_as "parameter" $members)...) := $name{(member_as "given" $members)...})
# What a class's member writes in each part of the class rule: a method its function, a field with a default its
# parameter as written, any other field what member_of writes for that part; a member a part does not take writes
# nothing
rule member_as "method" $name ($method($parameters...) as $type := $body) => member_as "method" $name ($method($parameters...): $type := $body)
rule member_as "method" $name ($method($parameters...): $type := $body) => ($method(self: $name, $parameters...): $type := $body)
rule member_as "method" $name ($method($parameters...) := $body) => ($method(self: $name, $parameters...) := $body)
rule member_as "method" $name $member => ()
# a required word is the protocol's field of the function type taking the protocol first, the conforming value's own
rule required_field $name ($word($parameters...): $type) => $word: (($name, $parameters...) -> $type)
rule required_field $name $member => ()
# GUESS (C2's A, notes/coc-c2.md): a trait's value held with its words. The words class has a field per required word with
# the trait's place made any, the held class a value and its words, the boxing `shape(x: T)` builds both (typed anew for
# each T, so each lambda reaches T's own word or the trait's default), and a forwarder per word reads the field, so a word
# called on a held value picks it as the most specific. The names `${name}_words` and `held_$name` and the lambdas'
# `$parameters...` standing as both names and types are guesses
rule held $name [$members...] => Record(Symbol("${name}_words"), [(words_field $members)...], []); constructed Symbol("${name}_words") [(words_field $members)...]; class Symbol("held_$name") { value: any; words: Symbol("${name}_words") }; Symbol("$name")(value: T): Symbol("held_$name") := Symbol("held_$name")(value, Symbol("${name}_words")((boxed_word $members)...)); (forwarded $name $members)...
# a parameter's type and its name, an unwritten type being any: the words class takes the types, a call the names
rule parameter_type ($n: $t) => $t
rule parameter_type $n => any
rule parameter_name ($n: $t) => $n
rule parameter_name $n => $n
rule words_field ($word($parameters...): $type) => $word: ((any, (parameter_type $parameters)...) -> $type)
rule words_field $member => ()
# the one lambda builder of a trait's words: a word's lambda over any and its written parameters, each by its own name (a bare
# one is an any), given to the word on the held value `v as $held`; a member's parameters and a claim's function type both come here
# GUESS (unbuilt): the parameters' names and types read in one sequence, `((parameter_name $parameters): (parameter_type $parameters))...`
rule word_lambda $word $held [$parameters...] => ((v: any, ((parameter_name $parameters): (parameter_type $parameters))...) => $word(v as $held, (parameter_name $parameters)...))
rule boxed_word ($word($parameters...): $type) => (word_lambda $word T [$parameters...])
rule boxed_word $member => ()
# the field is called as a value, so the call is the field's and no forwarder's
rule forwarded $name ($word($parameters...): $type) => ($word(h: Symbol("held_$name"), $parameters...): $type := { word = h.words.$word; word(h.value, (parameter_name $parameters)...) })
rule forwarded $name $member => ()
# a protocol's member is a required word or a word's default body
rule abstract ($word($parameters...): $type) => ()
rule abstract ($head := $body) => ()
rule abstract $member => refuse "a protocol holds words, `area()`, and their default bodies, never fields: a class doing it has the fields"
rule member_as "parameter" ($field: $type = $default) => $field: $type = $default
rule member_as "default" ($field: $type = $default) => $field: $default
rule member_as "default" ($field: Symbol = $default) => $field: $default
# a typed field keeps its default in the record, which a class extending it takes along (wiki/class.md)
rule member_as "field" ($field: $type = $default) => $field: $type = $default
rule member_as $part ($field: $type = $default) => member_of $part ($field: $type)
rule member_as $part ($field: $type) => member_of $part ($field: $type)
# a field given only its default, `at = 0`, has the default's type (wiki/class.md): declared and taken as written
rule member_as "field" ($field: Symbol = $default) => $field = $default
rule member_as "parameter" ($field: Symbol = $default) => $field = $default
rule member_as $part ($field: Symbol = $default) => member_named $part $field
# a method is no field; anything else is no member: refused, never dropped
rule member_as $part ($head := $body) => ()
rule member_as $part $member => refuse "a class member is a field, `name: type` (`addresses: list<text>`) or `name = default`, or a method `name(…) := …`"
# a field, its default left out, as its declaration and its constructor parameter; the other parts need its name only
rule member_of "field" ($field: $type) => $field: $type
rule member_of "parameter" ($field: $type) => $field: $type
rule member_of $part ($field: $type) => member_named $part $field
# a field's value given to the instance, and its show
rule member_named "given" $field => $field: $field
rule member_named "shown" $field => "$field: " + show(self.$field)
rule member_named "named" $field => "$field"
rule member_named $part $field => ()

# an enum, its cases a bare name, `Dime`, a name with fields, `Circle(r: float)`, or a name with its spelling,
# `Error = "error"` (wiki/enum.md "Cases with spellings"); each case a value of the enum's type; its show by match over
# the cases; its text, a case's spelling or else its name, and the case a text spells, `"error" as Level`
rule enum $name { $cases... } => Record($name, [], [(case_named $cases)...]); text(self: $name): text := Case(self, (spelled_case $name $cases)...); Symbol("$name")(spelling: text): $name := { Case(spelling, (case_spelled $name $cases)...); raise("no case of $name is spelled " + spelling) }; ==(a: $name, b: text): bool := text(a) == b; indexed $name [$cases...]
# a case as the record declares it, a spelling kept beside its name: `Colon = ":"` is `Colon: ":"`
rule case_named ($case = $spelling) => ($case: $spelling)
rule case_named $case => $case
# the arm of an enum's text for one case, and of the case for a text: a case with a spelling has that spelling, a
# case with fields its show, any other its name
rule spelled_case $name ($case = $spelling) => Arm($name.$case, $spelling)
rule spelled_case $name $case: Symbol => Arm($name.$case, "$case")
rule spelled_case $name $case($fields...) => shown_case $name $case($fields...)
rule case_spelled $name ($case = $spelling) => Arm($spelling, Return($name.$case))
rule case_spelled $name $case: Symbol => Arm("$case", Return($name.$case))
rule case_spelled $name $case($fields...) => Arm("$case", ø)
# an enum of plain cases counts them from 0 (wiki/enum.md "Cases and numbers"): `Coin.Dime as int` 2 and `2 as Coin`
# Dime, and shows a case by its name (prelude.wap show); a tagged union, a case with fields among them (wiki/variant.md),
# has no count, so `3 as Node` stays an atom, and shows a case with its fields
rule indexed $name [$before..., $case($fields...), $after...] => (show(self: $name): text := Case(self, (shown_case $name $before)..., shown_case $name $case($fields...), (shown_case $name $after)...))
rule indexed $name [$cases...] => (int(self: $name): int := prim case_number(self)); (Symbol("$name")(index: int): $name := case_of([(case_valued $name $cases)...], index, "$name"))
rule case_valued $name ($case = $spelling) => $name.$case
rule case_valued $name $case: Symbol => $name.$case
# the arm of an enum's show for one case: a bare case shows its name, a case with fields its name and their values
rule shown_case $name ($case = $spelling) => Arm($name.$case, "$case")
rule shown_case $name $case: Symbol => Arm($name.$case, "$case")
rule shown_case $name $case(($field: $type)...) => Arm($case(($field)...), "$case(" + join([(show($field))...], ", ") + ")")
