# Types written in words, as their bracketed form (wiki/type.md; the wiki's main spelling): `list of int` is list<int>
rule list of $item => list<$item>
# int32, the other spelling of the machine word i32 (wiki/number.md)
type int32 = i32
# a value's type, the static one (wiki/type.md "The type of a value"; core/analyze/calls.wap type_of_typed)
rule type of $x => type_of($x)
# a list converted to a list of another item type is read item by item, a copy: `chars as list<text>`, `ys as list<positive>`
# checks each item (wiki/subtype.md); only a value known to be a list, an any stays the general rule's checked cast
rule ($value: list) as list<$item> => { converted: list<$item> = $value.map(function $item); converted }
# a type with parts names no function: the value is held in a place of that type, `[] as list<text>` an empty list of texts
rule $value as $name<$parts...> => { converted: $name<$parts...> = $value; converted }
# a value converted to an optional type is missing where the conversion raises: `"x" as int?` is a missing int (wiki/optional.md)
rule $value as $type? => { converted: $type? = try ($value as $type) else ø; converted }
# a value converted to a type is the type's function of it: `op as text` is text(op), `97 as codepoint` is codepoint(97);
# a value that is of the type already is itself, an any holding a User the User (wiki/conversion.md)
rule $value as $type => { converted: $type = if (given = $value) is $type then given else $type(given); converted }
# a trait is a class (wiki/trait.md): `trait shape { area(); scaled(by) }` a class of two required words
rule trait $name { $members... } => class $name { $members... }
# `a is not b` is not (a is b), never a test of `not b` (wiki/ambiguity.md "is not")
rule $a is not $b => not ($a is $b)
# a test of one value after `is`, declared with a result of yes or no, is a call of it: `xs is empty` is empty(xs); a
# type's name stays a type test. A declaration rule: it asks what the word after `is` is declared as
rule $x is $p: predicate => $p($x)
# a type before a name declares it of that type (wiki/type.md): `int j = 7` is j: int = 7, `Point p = Point(1, 2)` too;
# a word that names no type stays as written
rule ($type: type $name: Symbol = $value) => ($name: $type = $value)
