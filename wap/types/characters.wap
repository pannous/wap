# The types module's character words (AGENTS.md "Layers"): a character's kind and a text's case, over texts.wap's
# bytes

# the characters a hex digit takes beyond the digits
HEX_LETTERS := "abcdefABCDEF"
# the bytes of A, Z, a and z, and how far a lower case letter's byte lies above its capital's
UPPER_A_BYTE := 65
UPPER_Z_BYTE := 90
LOWER_A_BYTE := 97
LOWER_Z_BYTE := 122
CASE_DISTANCE := 32

# a character's kind: a decimal digit, an ASCII letter, either, a hex digit
is_digit(c: text): bool := c >= "0" and c <= "9"
# a text of decimal digits only, and at least one: `"123".is_digits` is yes, `"".is_digits` no
is_digits(t: text): bool := t != "" and t.bytes.all(is_digit_byte)
is_alpha(c: text): bool := (c >= "a" and c <= "z") or (c >= "A" and c <= "Z")
is_alphanumeric(c: text): bool := is_alpha(c) or is_digit(c)
is_hex_digit(c: text): bool := is_digit(c) or HEX_LETTERS.contains(c)

# t with its letters A to Z in lower case: `"Hé ABC".lower()` is "hé abc"
# a text's ASCII letters in lower or upper case, every other character kept: ascii_upper("straße") is "STRAßE"
ascii_lower(t: text): text := t.bytes.map(b => byte_text(if b >= UPPER_A_BYTE and b <= UPPER_Z_BYTE then b + CASE_DISTANCE else b)).join("")
ascii_upper(t: text): text := t.bytes.map(b => byte_text(if b >= LOWER_A_BYTE and b <= LOWER_Z_BYTE then b - CASE_DISTANCE else b)).join("")
# DEBT: lower and upper become the full Unicode default mapping (wiki/Footguns.md "Case mapping"), uniscript's,
# linked only into programs that call them, once that on-use linking is built; until then they change ASCII letters.
# Callers that mean ASCII write ascii_lower and ascii_upper (core's bindings.wap, parse/atoms.wap and
# analyze/shapes.wap after the next seed refresh), so the compiler never pulls uniscript in
lower(t: text): text := ascii_lower(t)
upper(t: text): text := ascii_upper(t)
