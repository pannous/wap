# What a function may do beyond computing its value (wiki/effects.md), in the order `effects of` names them
use "../kernel/primitives.wap"

enum Effect { State; Allocation; IO; FFI; Async; Unsafe; Div; Eval; Fail }
# (the order of the cases, written out)
EFFECT_ORDER = [Effect.State, Effect.Allocation, Effect.IO, Effect.FFI, Effect.Async, Effect.Unsafe, Effect.Div, Effect.Eval, Effect.Fail]
# the word for none of them, what a function that only computes its value claims, `! Pure`
PURE_WORD = "Pure"

# what a host operation may do beyond computing its value, each effect with the operations that bring it: the host's
# imports and printing IO, a whole number's division, a float's truncation, the trap and a raise Fail. A foreign
# function is the host's IO where its module is WASI, else FFI (core/analyze/effects.wap)
IO_OPERATIONS = HOST_FUNCTIONS + ["print_text"]
FAILING_OPERATIONS = DIVIDING + ["i64.trunc_f64_s", "unreachable", "raise_text"]
# the operations that change in place what their first argument holds, State where the caller holds it: a list's item
# added, set, taken off or stored, a text's byte set or copied
STATE_OPERATIONS = ["list_add", "list_set", "list_pop", "item.store", "array.set", "array.copy"]
