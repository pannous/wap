# The host's machinery the types module's file and command-line words use (system.wap, which `use`s it, so programs do
# not see it): plain warp over the module's memory and WASI's calls. Its primitives are the memory's bytes and words,
# the emitter's helpers that grow it, place a text in it and write a text from it (core/emit/host.wap), and each WASI
# call by its own name (core/emit/primitives.wap).

use "text_bytes.wap"

# the memory: an iovec [address, length] at 0, the count a call moved or the file it opened at 8, a path's bytes from
# 16; a read's in scratch(count)
IOVEC_AT := 0
MOVED_AT := 8
BYTES_AT := 16
# WASI: the folders the host opens for a program, the current one and then the root (wap/extensions/native/run.wap),
# where a path starting with / opens; links followed; the rights to read and seek; seek from the start or the end
CURRENT_FOLDER := 3
ROOT_FOLDER := 4
# the root folders looked through for an absolute path's: one, or each drive's on Windows
MOST_ROOTS := 26
FOLLOW_LINKS := 1
# a link's target read at most this long; links followed by hand at most this often in one path
LINK_BYTES := 4096
LINK_HOPS := 40
READ_AND_SEEK := 6
# WASI: open flags to create a missing file and empty one that is there; the right to write
CREATED_OR_EMPTIED := 9
WRITE_RIGHT := 64
FROM_START := 0
FROM_END := 2
# WASI: the open flag of a folder and the right to read its entries; an entry: where the next one starts (its first
# word), its name's length at 16, its name after the header; the bytes read at once
FOLDER_FLAG := 2
READ_ENTRIES := 16384
NAME_LENGTH_AT := 16
ENTRY_HEADER := 24
ENTRIES_READ := 65536
# WASI: the files a program starts with open, its standard input, output and error
STANDARD_INPUT := 0
STANDARD_OUTPUT := 1
STANDARD_ERROR := 2
# WASI: the wall clock, its time in nanoseconds since 1970, asked to a millisecond; a word's range, two words one int
WALL_CLOCK := 0
NANOS_PER_MILLI := 1000000
WORD_RANGE := 4294967296
# WASI: the monotonic clock; poll_oneoff's clock subscription, its bytes, its clock at 16 and its timeout in nanoseconds
# at 24 as two words, relative as its other fields are 0; the event it gives back, its bytes
MONOTONIC_CLOCK := 1
SUBSCRIPTION_BYTES := 48
CLOCK_AT := 16
TIMEOUT_AT := 24
EVENT_BYTES := 32
# splitmix64's gamma, a generator's step, and its mixer's two factors (system.wap splitmixed); a byte's bits
GOLDEN_GAMMA := 0x9E3779B97F4A7C15
MIX_FIRST := 0xBF58476D1CE4E5B9
MIX_SECOND := 0x94D049BB133111EB
BYTE_MASK := 255

memory_byte(at: int): int := prim i32.load8_u(at)
memory_word(at: int): int := prim i32.load(at)
set_memory_byte(at: int, b: int) := prim i32.store8(at, b)
set_memory_word(at: int, word: int) := prim i32.store(at, word)
# the unsigned 32-bit word at an address
unsigned_word(at: int): int := (memory_word(at) + WORD_RANGE) % WORD_RANGE
# a 64-bit int as two words, the low one first
memory_int(at: int): int := unsigned_word(at) + unsigned_word(at + 4) * WORD_RANGE
set_memory_int(at: int, n: int) := {
	set_memory_word(at, n % WORD_RANGE)
	set_memory_word(at + 4, n ÷ WORD_RANGE)
}
# the memory grown to hold `count` bytes from BYTES_AT (texts.wap places a text's bytes there and writes them)
memory_holding(count: int) := prim memory_held(count)
# where `count` bytes of scratch go: from BYTES_AT, the memory grown to hold them; new memory where texts are in the
# memory, whose data (the literal texts) starts past 65536, which a long scratch from BYTES_AT would overwrite
scratch(count: int): int := {
	if texts_in_memory() { return text_address(text_made(count)) }
	memory_holding(count)
	BYTES_AT
}

args_sizes_get(count_at: int, size_at: int): int := prim args_sizes_get(count_at, size_at)
args_get(addresses_at: int, bytes_at: int): int := prim args_get(addresses_at, bytes_at)
environ_sizes_get(count_at: int, size_at: int): int := prim environ_sizes_get(count_at, size_at)
environ_get(addresses_at: int, bytes_at: int): int := prim environ_get(addresses_at, bytes_at)
path_open(folder: int, lookup: int, path_at: int, length: int, flags: int, rights: int, inherited: int, file_flags: int, opened_at: int): int := prim path_open(folder, lookup, path_at, length, flags, rights, inherited, file_flags, opened_at)
fd_seek(file: int, offset: int, whence: int, position_at: int): int := prim fd_seek(file, offset, whence, position_at)
fd_read(file: int, iovecs_at: int, count: int, moved_at: int): int := prim fd_read(file, iovecs_at, count, moved_at)
fd_close(file: int): int := prim fd_close(file)
fd_readdir(folder: int, entries_at: int, length: int, cookie: int, used_at: int): int := prim fd_readdir(folder, entries_at, length, cookie, used_at)
clock_time_get(clock: int, precision: int, time_at: int): int := prim clock_time_get(clock, precision, time_at)
random_get(at: int, count: int): int := prim random_get(at, count)
poll_oneoff(subscriptions_at: int, events_at: int, count: int, given_at: int): int := prim poll_oneoff(subscriptions_at, events_at, count, given_at)
# WASI calls no primitive is named after, imported as another module's functions are
path_readlink(folder: int, path_at: int, length: int, target_at: int, room: int, used_at: int): int := {
	answer: i32 = prim foreign("wasi_snapshot_preview1", "path_readlink", i32(folder), i32(path_at), i32(length), i32(target_at), i32(room), i32(used_at))
	int(answer)
}
fd_prestat_get(folder: int, prestat_at: int): int := {
	answer: i32 = prim foreign("wasi_snapshot_preview1", "fd_prestat_get", i32(folder), i32(prestat_at))
	int(answer)
}
fd_prestat_dir_name(folder: int, name_at: int, length: int): int := {
	answer: i32 = prim foreign("wasi_snapshot_preview1", "fd_prestat_dir_name", i32(folder), i32(name_at), i32(length))
	int(answer)
}
# a clock's time in nanoseconds, asked to a precision: WASI's clock_time_get puts it at 0, as two words
clock_nanos(clock: int, precision: int): int := {
	clock_time_get(clock, precision, 0)
	memory_int(0)
}

# the memory's bytes from an address, as a text
memory_text(at: int, count: int): text := {
	t = text_made(count)
	for offset in 0 upto count { set_text_byte(t, offset, memory_byte(at + offset)) }
	t
}
# a text's bytes placed in the memory from an address
memory_placed(at: int, t: text) := for offset in 0 upto byte_count(t) { set_memory_byte(at + offset, byte_at(t, offset)) }
# the memory's bytes from an address up to the first zero, as a text
zero_ended(at: int): text := {
	end = at
	while memory_byte(end) != 0 { end += 1 }
	memory_text(at, end - at)
}
# the file at a path opened with these flags and rights, relative to the current folder or from the root (/…), else
# from the root by its real path; ø for a path it cannot open
opened_at(written: text, flags: int, rights: int): int? := {
	path = home_expanded(written)
	(if path.starts_with("/") then opened_from_root(path, flags, rights) else opened_in(CURRENT_FOLDER, path, flags, rights)) ?? opened_from_root(real_path(path) ?? return ø, flags, rights)
}
opened_from_root(path: text, flags: int, rights: int): int? := {
	root = root_of(path) ?? return ø
	opened_in(root.folder, root.inside, flags, rights)
}
# an absolute path's root folder and the path inside it: of the folders the host opens after the current one, the first
# whose name begins the path, "/" (on Windows each drive's, "/c", "/d")
class Rooted { folder: int, inside: text }
root_of(path: text): Rooted? := {
	for folder in ROOT_FOLDER upto ROOT_FOLDER + MOST_ROOTS {
		name = folder_name(folder) ?? return ø
		start = if name.ends_with("/") then name else name + "/"
		if path.starts_with(start) { return Rooted(folder, path[byte_count(start) ..]) }
	}
	ø
}
opened_in(folder: int, path: text, flags: int, rights: int): int? := {
	place(path)
	if path_open(folder, FOLLOW_LINKS, BYTES_AT, byte_count(path), flags, rights, 0, 0, MOVED_AT) != 0 { return ø }
	memory_word(MOVED_AT)
}
# a path from the root, its links kept: as it is when it starts there, else in the current folder; ø when the host
# names the current folder by no absolute path
rooted(path: text): text? := if path.starts_with("/") then path else (current_folder() ?? return ø) + "/" + path
# a path made absolute, its links followed and its `.` and `..` gone: the host's WASI (wasmtime's) follows no link to
# an absolute path and no `..` out of the folder it opened, so a path that needs them is opened from the root by this;
# ø when the host names the current folder by no absolute path, or the links go round
real_path(path: text): text? := {
	pending = (rooted(path) ?? return ø).split("/")
	real: list<text> = []
	hops = 0
	while pending is not empty {
		part = pending#1
		pending = pending.drop(1)
		if part == ".." { real = real.take(max(#real - 1, 0)) }
		else if part != "" and part != "." {
			target = link_target("/" + (real + [part]).join("/")) ?? ""
			if target == "" { real += [part] }
			else {
				hops += 1
				if hops > LINK_HOPS { return ø }
				if target.starts_with("/") { real = [] }
				pending = target.split("/") + pending
			}
		}
	}
	"/" + real.join("/")
}
# the target of the link at an absolute path, ø when it is no link
link_target(path: text): text? := {
	root = root_of(path) ?? return ø
	length = byte_count(root.inside)
	at = scratch(length + LINK_BYTES)
	memory_placed(at, root.inside)
	if path_readlink(root.folder, at, length, at + length, LINK_BYTES, MOVED_AT) != 0 { return ø }
	memory_text(at + length, memory_word(MOVED_AT))
}
# the current folder's absolute path, as the host names the first folder it opens (WASI's prestat: the name's length
# at 4); ø when the host names it otherwise (".")
current_folder(): text? := {
	name = folder_name(CURRENT_FOLDER) ?? return ø
	if name.starts_with("/") then name else ø
}
# the name the host gives a folder it opens, ø for a number it opens no folder at
folder_name(folder: int): text? := {
	if fd_prestat_get(folder, MOVED_AT) != 0 { return ø }
	length = memory_word(MOVED_AT + 4)
	at = scratch(length)
	fd_prestat_dir_name(folder, at, length)
	memory_text(at, length)
}
# the file opened, a path it cannot open raising the refusal and the path
opened(path: text, flags: int, rights: int, refusal: text): int := opened_at(path, flags, rights) ?? raise(refusal + path)
# a file's bytes read into the memory from `at` until `total` are or a read gives none; the count read
bytes_read(file: int, at: int, total: int): int := {
	done = 0
	while done < total {
		set_memory_word(IOVEC_AT, at + done)
		set_memory_word(IOVEC_AT + 4, total - done)
		fd_read(file, IOVEC_AT, 1, MOVED_AT)
		if memory_word(MOVED_AT) == 0 { return done }
		done += memory_word(MOVED_AT)
	}
	done
}
