# The laws of the whole numbers the linear prover builds its proofs of (notes/unify-provers.md): sums regrouped and
# cancelled, a difference read as a gap, and every comparison one `<=`. Each is proved by the provers from int's two
# cases, by computing, apart and induction, never by the linear prover, which rests on them. Equal sums are turned,
# chained and carried into a sum around them by the kernel's own laws of equality (kernel/equality.wap).

law zero_add(y: int): 0 + y == y
law add_zero(a: int): a + 0 == a
law add_commutative(a: int, b: int): a + b == b + a
law add_associative(a: int, b: int, c: int): (a + b) + c == a + (b + c)
law add_swapped(x: int, a: int, b: int): (x + a) + b == (x + b) + a
law add_minus(x: int): x + -x == 0
law minus_add(a: int, b: int): -(a + b) == -a + -b
law add_cancel(a: int, b: int, c: int, h: a + c == b + c): a == b
law add_difference(a: int, b: int): a + (b + -a) == b

law difference_nonnegative(a: int, b: int, h: a <= b): 0 <= b + -a
law nonnegative_add(a: int, b: int, h: 0 <= a, k: 0 <= b): 0 <= a + b
law gap_bound(t: int, g: int, u: int, h: 0 <= g, k: t + g == u): t <= u
law beyond_not_above(a: int, b: int, h: not (a <= b)): b + 1 <= a

law both_first(a: bool, b: bool, h: a and b): a
law both_second(a: bool, b: bool, h: a and b): b

# nat's words' inverses (types/numbers.wap), read once wap lowers an inverse's definition (wiki/enum.md "Patterns by
# inverse")
zero⁻¹(n: nat): nat? := if n == 0 then n
successor⁻¹(n: nat): nat? := if n > 0 then n - 1
