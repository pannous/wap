# the natural numbers (wiki/number.md), their recursor (wiki/enum.md "The recursor") and their words with their
# inverses, which let `match n { zero => a; successor(k) => b }` take n apart (wiki/enum.md "Patterns by inverse").
# Read by nothing yet: TODO (card dependent-types) in types/numbers.wap once a type alias declares a type name rather
# than a word rewrite (a rewrite rule in the types module changes how every program reads `:`), the inverses once wap
# lowers an inverse's definition
type nat = int where it >= 0
recursor(base: T, step: (nat, T) -> T, n: nat): T := if n == 0 then base else step(n - 1, recursor(base, step, n - 1))
zero: nat := 0
successor(k: nat): nat := k + 1
zero⁻¹(n: nat): nat? := if n == 0 then n
successor⁻¹(n: nat): nat? := if n > 0 then n - 1
