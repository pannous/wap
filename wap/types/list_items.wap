# How a list holds its items, the one list file a build may swap (as text_bytes.wap for texts): every other list word
# is plain wap over these (lists.wap, prelude.wap). Here a list is a GC array, each word a primitive of the emitter
# (core/emit/primitives.wap); a native build, whose wasm2c takes no GC type, takes wap/types/memory_lists.wap,
# a list in the module's memory.

# how many items a list holds, a list of any items: a bare `list` fits every list<T>
#(xs: list): int := prim list_count(xs)
# an item put at the end of a list, which grows in place: every name holding it sees the item
add(xs: list<T>, item: T) := prim list_add(xs, item)
# the last item taken off a list; an empty one raises
pop(xs: list<T>): T := prim list_pop(xs)
# a list's item at a place, counting from 1, `xs#2`; a place past the end raises
#(xs: list<T>, at: int): T := prim list_item(xs, at - 1)
# a list's item at a place, counting from 1, given a value, `xs#2 = 5`
set(at: int, of: list<T>, to: T) := prim list_set(of, at - 1, to)
# a new list of the same items, which grows apart from the first: `b = a` shares a list, `b = copy(a)` does not
# (wiki/reference.md)
copy(xs: list<T>): list<T> := prim list_slice(xs, 0, #xs)
