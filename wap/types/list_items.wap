# How a list holds its items, the one list file a build may swap (as text_bytes.wap for texts): every other list word
# is plain wap over these (lists.wap, prelude.wap). Here a list is a GC array, each word a primitive of the emitter
# (core/emit/primitives.wap); a native build, whose wasm2c takes no GC type, takes wap/types/memory_lists.wap,
# a list in the module's memory.

# how many items a list holds, a list of any items: a bare `list` fits every list<T>
#(xs: list): int := prim list_count(xs)
# an item put at the end of a list, which grows in place: every name holding it sees the item
add(xs: list<T>, item: T) := prim list_add(xs, item)
# the last item taken off a list; an empty one raises
pop(xs: list<T>): T := prim list_pop(xs)
# a list's item at a place, counting from 1, `xs#2`; a place past the end raises
#(xs: list<T>, at: int): T := prim list_item(xs, at - 1)
# a list's item at a place, counting from 1, given a value, `xs#2 = 5`
set(at: int, of: list<T>, to: T) := prim list_set(of, at - 1, to)
# the items of a list at the places of a range, counting from 0, up to the list's end: `[1, 2, 3][1 .. 9]` is [2, 3]
slice(xs: list<T>, r: Range): list<T> := prim list_slice(xs, r.from, slice_end(xs, r) - r.from)
# the bytes each item of the list takes: its type's width (as in memory_lists.wap, which a native build takes in place
# of this file)
item_bytes(xs: list<T>): int := prim item.bytes(xs)
# A list's items handed to C (types/c.wap c_items): the address of their copy in the memory, packed at their width as C
# reads an array of them, as a GC array has no address; copied back into the list once the call returns
# (items_returned), as C may write into them
items_handed(xs: list<T>): int := {
	global handed_at
	width = item_bytes(xs)
	at = c_reserved(#xs * width)
	for place in 0 upto #xs { item_placed(at + place * width, xs[place]) }
	handed_at.add(at)
	at
}
# the list's items as C left them in their copy, the first of the call's copies still to be read back
items_returned(xs: list<T>) := {
	global handed_at
	at = handed_at#1
	handed_at = handed_at.drop(1)
	for place in 0 upto #xs { xs[place] = item_found(xs, at + place * item_bytes(xs)) }
}
# where the copies of the lists handed to the C call running are, in the order of its parameters
handed_at: list<int> = []
item_placed(at: int, item: T) := prim item.store(at, item)
item_found(xs: list<T>, at: int): T := prim item.load(at)
