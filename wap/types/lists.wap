# The types module's list words (AGENTS.md "Layers"): plain warp over lists and function values, a list in, a value
# or a new list out. `xs.map(f)` is map(xs, f) by the dot rule (sugar/calls.wap). A letter in a signature is a
# type variable, bound by the call: map's U is f's result for an item.

# whether every item of a list fits a test, any item does, a list holds an item: `xs.all(x => x > 0)`, `xs.contains(3)`
all(xs: list<T>, fits: (T) -> bool): bool := xs.index_where(x => not fits(x)) == 0
any(xs: list<T>, fits: (T) -> bool): bool := xs.index_where(fits) > 0
contains(xs: list<T>, item: T): bool := xs.any(x => x == item)
# whether a list holds an item, as a map has a key: `[1, 2].has(2)` is yes
has(xs: list<T>, item: T): bool := xs.contains(item)
# an item put at the end of a list, the list given back, so appends chain: `[]<<1<<2` is [1, 2]
<<(xs: list<T>, item: T): list<T> := { xs.add(item); xs }
# whether a list holds an item, the operator's reading: `x in xs` is xs.contains(x)
in(x: T, xs: list<T>): bool := xs.contains(x)
# a missing value is in no list: `ø in [1, 2]` is no, and an optional's value is looked for as itself
in(x: T?, xs: list<T>): bool := not missing(x) and xs.contains(x!)
contains(xs: list<T>, item: T?): bool := item in xs

# how many a list, a text or a range holds, what # counts: `xs.count`, also written `xs.length` or `xs.size`
count(x: T): int := #x
# how often an item is in a list: `[2, 1, 2].count(2)` is 2
count(xs: list<T>, item: T): int := xs.filter(x => x == item).count
# two lists are equal when their items are, in order, each pair by its own type's ==
==(xs: list<T>, ys: list<T>): bool := {
	if #xs != #ys { return no }
	for at in 1 to #xs { if xs#at != ys#at { return no } }
	yes
}
# a new list of the same items, which grows apart from the first: `b = a` shares a list, `b = copy(a)` does not
# (wiki/reference.md)
copy(xs: list<T>): list<T> := xs[0 ..]
# what `for` walks of a value: the value itself, its items by place; a map has its own (types/maps.wap)
walked(xs: T): T := xs
# the keys `for key, value in` walks of a list: its places, from 1 (a map has its own, types/maps.wap)
pairs(xs: list<T>): Range := 1 to #xs
# a new list of a's items, then b's: `[1, 2] + [3]` is [1, 2, 3]
+(a: list<T>, b: list<T>): list<T> := {
	out = copy(a)
	for x in b { out.add(x) }
	out
}
# a list with an item added at its end, a new list: `[1, 2] + 3` is [1, 2, 3]; a list on the right joins instead
+(a: list<T>, item: T): list<T> := a + [item]
# a list grown in place, its items shared (wiki/list.md): `xs += [5, 6]` adds 5 and 6 to the end of xs itself, so a
# name sharing xs sees them; `+` makes a new list
+=(xs: list<T>, more: list<T>): list<T> := { xs.extend(more); xs }
+=(xs: list<T>, item: T): list<T> := { xs.add(item); xs }
# element-wise arithmetic (wiki/Footguns.md "lists"): two lists of one size item by item, `[1, 2] .* [3, 4]` is
# [3, 8], or each item with one number, `[1, 2, 3] .+ 4` is [5, 6, 7]
paired(xs: list<T>, ys: list<T>, f: (T, T) -> U): list<U> := {
	if #xs != #ys { raise "element-wise arithmetic needs lists of one size, not ${#xs} and ${#ys}" }
	(0 upto #xs).map(i => f(xs[i], ys[i]))
}
# one value as many times as a list has items, so a number meets each item
spread(y: T, n: int): list<T> := (0 upto n).map(i => y)
.+(xs: list<T>, ys: list<T>): list<T> := paired(xs, ys, (a, b) => a + b)
.-(xs: list<T>, ys: list<T>): list<T> := paired(xs, ys, (a, b) => a - b)
.*(xs: list<T>, ys: list<T>): list<T> := paired(xs, ys, (a, b) => a * b)
./(xs: list<T>, ys: list<T>): list<float> := paired(xs, ys, (a, b) => a / b)
.+(xs: list<T>, y: T): list<T> := xs .+ spread(y, #xs)
.-(xs: list<T>, y: T): list<T> := xs .- spread(y, #xs)
.*(xs: list<T>, y: T): list<T> := xs .* spread(y, #xs)
./(xs: list<T>, y: T): list<float> := xs ./ spread(y, #xs)
# the item at a place counting from 0 taken out, the items after it moved down one, in their order
remove_at(xs: list<T>, at: int): T := {
	if at < 0 or at >= #xs { raise "this list has no item at this place" }
	removed = xs[at]
	for place in at + 1 upto #xs { xs[place - 1] = xs[place] }
	xs.pop()
	removed
}
# an item put in at a place counting from 0, the items from there moved up one: `xs.insert(v, at: 0)` puts v first
insert(xs: list<T>, item: T, at: int) := {
	if at < 0 or at > #xs { raise "this list has no place \(at) to insert at" }
	xs.add(item)
	place = #xs - 1
	while place > at {
		xs[place] = xs[place - 1]
		place -= 1
	}
	xs[at] = item
}

# the items without their repeats, each where it first appears: `[1, 2, 1].unique` is [1, 2]
unique(xs: list<T>): list<T> := {
	out: list<T> = []
	for x in xs { if not out.contains(x) { out.add(x) } }
	out
}
# each item's result, in order: `[1, 2].map(x => x * 10)` is [10, 20]
map(xs: list<T>, f: (T) -> U): list<U> := {
	out: list<U> = []
	for x in xs { out.add(f(x)) }
	out
}
# the items that fit a test, in order
filter(xs: list<T>, fits: (T) -> bool): list<T> := {
	out: list<T> = []
	for x in xs { if fits(x) { out.add(x) } }
	out
}
# the items of a list of optionals that hold a value: `[1, ø, 3].compact` is [1, 3]
compact(xs: list<T?>): list<T> := {
	out: list<T> = []
	for x in xs { if x != ø { out.add(x!) } }
	out
}
# the first item that fits a test, ø when none does: `[1, 2, 3].find(x => x > 1)` is 2
find(xs: list<T>, fits: (T) -> bool): T? := {
	at = xs.index_where(fits)
	if at == 0 then ø else xs#at
}
# each item's list of results, joined: `[1, 2].flat_map(x => [x, x])` is [1, 1, 2, 2]
flat_map(xs: list<T>, f: (T) -> list<U>): list<U> := {
	out: list<U> = []
	for x in xs { for y in f(x) { out.add(y) } }
	out
}
# the items combined into one value from a first one, left to right: `[1, 2, 3].fold(0, (sum, x) => sum + x)` is 6
fold(xs: list<T>, first: U, combined: (U, T) -> U): U := {
	value = first
	for x in xs { value = combined(value, x) }
	value
}
# the items added up and multiplied: `[1, 2, 3].sum()` is 6, `[2, 3, 4].product()` 24
# DEBT: four lines of one shape; two once a numeric T can name its zero and one (warp-wap-reader)
sum(xs: list<int>): int := xs.fold(0, (total, x) => total + x)
sum(xs: list<float>): float := xs.fold(0.0, (total, x) => total + x)
product(xs: list<int>): int := xs.fold(1, (total, x) => total * x)
product(xs: list<float>): float := xs.fold(1.0, (total, x) => total * x)
# the items' texts joined, the separator between each two: `["a", "b"].join(", ")` is "a, b", `['a', 'b'].join("")`
# is "ab", `[1, 2].join(" ")` is "1 2"; each text's bytes copied once into a text of the joined length
join(xs: list<T>, separator: text): text := xs.map(x => text(x)).join(separator)
join(xs: list<text>, separator: text): text := {
	if xs is empty { return "" }
	count = byte_count(separator) * (#xs - 1)
	for x in xs { count += byte_count(x) }
	out = text_made(count)
	at = copied_into(out, 0, xs#1)
	for place in 2 to #xs { at = copied_into(out, copied_into(out, at, separator), xs#place) }
	out
}
# a text's bytes copied into another from `at`, and where they end
copied_into(target: text, at: int, t: text): int := {
	bytes_copied(t, 0, byte_count(t), target, at)
	at + byte_count(t)
}

# the first n items, and the items after them: `[1, 2, 3].take(2)` is [1, 2], `[1, 2, 3].drop(2)` is [3]
take(xs: list<T>, n: int): list<T> := xs[0 .. n]
drop(xs: list<T>, n: int): list<T> := xs[min(n, #xs) .. #xs]
# the items in the order of their keys, equal keys in the list's order: `["bb", "a"].sorted(by: t => #t)` is ["a", "bb"]
sorted(xs: list<T>, by: (T) -> K): list<T> := xs.sorted(before: (a, b) => by(a) < by(b))
# the items in the order a comparison gives, `before(a, b)` yes when a goes first, equal ones in the list's order:
# `[3, 1, 2].sorted(before: (a, b) => a > b)` is [3, 2, 1]
sorted(xs: list<T>, before: (T, T) -> bool): list<T> := {
	if #xs < 2 { return copy(xs) }
	half = #xs ÷ 2
	merged(xs.take(half).sorted(before: before), xs.drop(half).sorted(before: before), before)
}
# two sorted lists as one, an item of the second only before the first's when it goes first, so equal items keep
# their order
merged(a: list<T>, b: list<T>, before: (T, T) -> bool): list<T> := {
	# halves in order already, as a sorted list's are, join as they are
	if not before(b#1, a#(#a)) { return a + b }
	out: list<T> = []
	i = 1
	j = 1
	while i <= #a and j <= #b {
		if before(b#j, a#i) {
			out += [b#j]
			j += 1
		} else {
			out += [a#i]
			i += 1
		}
	}
	out + a.drop(i - 1) + b.drop(j - 1)
}
# the items in the order a comparator gives, as JavaScript's: a negative `compare(a, b)` puts a first:
# `[3, 1, 2].sorted(compare: (a, b) => b - a)` is [3, 2, 1]
sorted(xs: list<T>, compare: (T, T) -> int): list<T> := xs.sorted(before: (a, b) => compare(a, b) < 0)
# the items in their own order, equal ones in the list's order: `["b", "a"].sorted()` is ["a", "b"]
sorted(xs: list<T>): list<T> := xs.sorted(by: x => x)

# a list's last item; an empty list raises: `[1, 2].last` is 2
last(xs: list<T>): T := xs#(#xs)
# a list's least and greatest item; an empty list raises: `[3, 1, 2].min` is 1, `[3, 1, 2].max` 3
min(xs: list<T>): T := xs.fold(xs#1, (least, x) => if x < least then x else least)
max(xs: list<T>): T := xs.fold(xs#1, (most, x) => if x > most then x else most)
# the items in the other order, as a new list: `[1, 2, 3].reverse` is [3, 2, 1]
reverse(xs: list<T>): list<T> := (1 to #xs).map(at => xs#(#xs + 1 - at))
# the position of an item, counted from 1, 0 when the list holds none: `[10, 20].index_of(20)` is 2 (wiki/indexing.md)
index_of(xs: list<T>, item: T): int := {
	for at in 1 upto #xs + 1 { if xs#at == item { return at } }
	0
}
# the position of the first item that fits a test, 0 when none does
index_where(xs: list<T>, fits: (T) -> bool): int := {
	at = 0
	while at < #xs {
		at += 1
		if fits(xs#at) { return at }
	}
	0
}

# a list in warp notation, each item shown by its own show: `show([1, 2])` is [1, 2]
show(xs: list<T>): text := "[" + xs.map(x => show(x)).join(", ") + "]"

# whether a list has no items: `xs is empty`
empty(xs: list): bool := #xs == 0

# Python's list words (wiki/list.md "Python's words"), each place counting from 0 as in Python: `xs.pop(1)` the item
# taken out at a place (wap's remove_at), `xs.clear()` every item taken out, `xs.extend(ys)` ys's items added at the
# end, in place, `xs.index(20)` the place of an item, raising when the list holds none (wap's index_of counts from 1)
pop(xs: list<T>, at: int): T := xs.remove_at(at)
clear(xs: list<T>) := { while #xs > 0 { xs.pop() } }
extend(xs: list<T>, more: list<T>) := { for x in more { xs.add(x) } }
index(xs: list<T>, item: T): int := {
	at = xs.index_of(item)
	if at == 0 { raise "this list holds no such item" }
	at - 1
}

# a list of numbers' Euclidean length, the root of its squares' sum: `norm([3, 4])` is 5 (its count stays `length`)
norm(v: list<float>): float := sqrt(v.map(x => x * x).sum())
norm(v: list<int>): float := norm(v.map(x => float(x)))
