# The logic of propositions in wap spelling (wiki/proposition.md, notes/coc-t6a.md T6a6, coc-t6a12.md): the proposition
# with no proof and the one with one, the connectives and their words, the existence of a value, and the one axiom
# propositions rest on. Plain wap over Prop binders; the core's types-as-values and Prop binders are T6a6's core part,
# and this file is included by types.wap once that reading is in.

# no proof, and exactly one: the kernel's own (kernel/logic.wap), so there is one False and one True
type False = ·False
type True = ·True

# both hold: a proof of each. One holds: a proof of one of them. A does not hold: a function to False
enum And(a: Prop, b: Prop): Prop { both(first: a, second: b) }
enum Or(a: Prop, b: Prop): Prop { by_first(proof: a), by_second(proof: b) }
# TODO (card t6a6) `a -> False` as a value needs the core's types as values
Not(a: Prop): Prop := a -> False

# some value of the type has the property: the value and the proof for it
enum Exists(T: Type, holds: T -> Prop): Prop { witness(value: T, proof: holds(value)) }

# a proposition that is proved or refuted, so a choice may read it
enum Decidable(a: Prop): Type { proved(proof: a), refuted(refutation: Not(a)) }

# the words of the connectives on propositions: `not` and `implies` beside the bool ones are plain overloads
# (polymorphism.md); `and` and `or` are no functions (sugar/conditions.wap refuses them as overloads), the operator rows
# map them on Prop straight to And and Or
# TODO (card t6a6) the operator rows pick `A and B` and `A or B` by the operands' sort (Prop), bool short-circuit untouched
# TODO (card t6a6) `exists x: T where P(x)` is Exists(T, x => P(x)) and `for x: T` before a statement a binder; the reading that carries them
# TODO (card t6a6) True.intro finds the kernel's ·True.intro through the alias (T5b5's dotted lookup), with a check line
not(a: Prop): Prop := Not(a)
implies(a: Prop, b: Prop): Prop := a -> b

# propositions that imply each other are equal: the axiom (wiki/proposition.md "Equality")
axiom proposition_extensionality(a: Prop, b: Prop, forward: a -> b, backward: b -> a): a == b
