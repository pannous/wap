# The types module's map words (AGENTS.md "Layers"): a map<K, V> holds its keys and its values as two lists, an entry
# the same place in both, in the order the keys were set; a map of more than a few keys also holds slots, a table of
# their places by their hash, so a key is found without searching them all (core/emit/values.wap map_parts).

# a map of more keys than this finds them by their hash, a smaller one searches them in order
INDEXED_FROM := 8

# a map's keys and its values as it holds them, an entry the same place in both, not copied, and its slots: held_keys,
# held_values and held_slots of list_items.wap, the list file a build may swap
# the place of a key among a map's keys, counting from 1, 0 when the map lacks it: through its slots, from the slot of
# the key's hash on up to an empty one; a map of a few keys searches them in order. A map made with many keys, a
# literal, gets its slots at its first read
key_place(m: map<K, V>, key: K): int := {
	keys = held_keys(m)
	slots = held_slots(m)
	if slots is empty and slots_wanted(#keys) > 0 { reslotted(m, no) }
	if slots is empty { return keys.index_of(key) }
	at = hashed(key, #slots)
	place = slots[at]
	while place != 0 {
		if keys#place == key { return place }
		at = (at + 1) % #slots
		place = slots[at]
	}
	0
}
# a key's hash, a slot of a table of that size: a text's by its bytes, an int's by itself, a list of ints' by its items,
# any other key's by its text;
# a power of two as the size, as a map's slots are, keeps the low bits, the remainder without dividing
hashed(t: text, size: int where it > 0): int := {
	low = if size > 1 and (size & (size - 1)) == 0 then size - 1 else 0
	hash = 0
	for at in 0 upto byte_count(t) {
		next = hash * 31 + byte_at(t, at)
		hash = if low > 0 then next & low else next % size
	}
	hash
}
hashed(n: int, size: int where it > 0): int := (n % size + size) % size
hashed(xs: list<int>, size: int where it > 0): int := xs.fold(0, (hash, x) => hashed(hash * 31 + x, size))
hashed(key: T, size: int where it > 0): int := hashed(text(key), size)
# the slots a map of this many keys holds: none for a few, else a power of two at least twice the count, so that
# the slots follow from the keys alone
slots_wanted(count: int): int := {
	if count <= INDEXED_FROM { return 0 }
	size = 2 * INDEXED_FROM
	while size < 2 * count { size *= 2 }
	size
}
# a map's slots kept in step with its keys once one was added or removed: the last key placed where the table keeps
# its size after an add, else every key placed anew
reslotted(m: map<K, V>, added: bool) := {
	keys = held_keys(m)
	slots = held_slots(m)
	size = slots_wanted(#keys)
	if added and size > 0 and size == #slots { key_slotted(slots, keys, #keys) } else {
		while #slots > size { slots.remove_at(#slots - 1) }
		for at in 0 upto #slots { slots[at] = 0 }
		while #slots < size { slots.add(0) }
		if size > 0 { for place in 1 to #keys { key_slotted(slots, keys, place) } }
	}
}
# a key's place written in the first empty slot from its hash on
key_slotted(slots: list<int>, keys: list<K>, place: int) := {
	at = hashed(keys#place, #slots)
	while slots[at] != 0 { at = (at + 1) % #slots }
	slots[at] = place
}
# a map in wap notation, its entries in braces, each value shown by its own show: `show({a: "x"})` is {a: "x"}
show(m: map<K, V>): text := "{" + keys(m).map(key => text(key) + ": " + show(m#key)).join(", ") + "}"
# two maps are equal when they hold the same keys, each with an equal value, in whatever order the keys were set
==(a: map<K, V>, b: map<K, V>): bool := #a == #b and held_keys(a).all(key => b.has(key) and a#key == b#key)
# a map's count of entries: `#{"a": 1, "b": 2}` is 2
#(m: map<K, V>): int := #held_keys(m)
# a map's count of entries and its first value, as words: `m.count` and `m.first` are these, a key of either name
# reads as `m#"count"` (wiki/map.md)
count(m: map<K, V>): int := #m
# whether a map has no keys, as a list is empty: `{} is empty`, and `if {}` takes the else branch
empty(m: map<K, V>): bool := empty(held_keys(m))
first(m: map<K, V>): V := held_values(m)#1
# a map's value by its key: `m["a"]`, `m.a`; a key the map lacks raises
#(m: map<K, V>, key: K): V := {
	at = key_place(m, key)
	if at == 0 { raise "this map has no such key" }
	held_values(m)#at
}
# a key given its value, `set v of: m key: k`, as `m#k = v` and `m["a"] = 1` write it: the value of a key the map holds
# changed, the key and the value added at the end otherwise
set(to: V, of: map<K, V>, key: K) := {
	at = key_place(of, key)
	values = held_values(of)
	if at == 0 {
		held_keys(of).add(key)
		values.add(to)
		reslotted(of, yes)
	} else { values[at - 1] = to }
}
# a map's keys, a new list in the order they were set: `{a: 1, b: 2}.keys()` is ["a", "b"]
keys(m: map<K, V>): list<K> := copy(held_keys(m))
# what `for` walks of a map: its keys, `for key in {a: 1, b: 2}` walks "a" and "b" (wiki/inventions.md)
walked(m: map<K, V>): list<K> := held_keys(m)
# the keys `for key, value in` walks of a map: the map itself, whose walk is its keys: `for key, value in {a: 1}` walks "a" with 1
pairs(m: map<K, V>): map<K, V> := m
# a map's values, a new list in the order their keys were set: `{a: 1, b: 2}.values()` is [1, 2]
values(m: map<K, V>): list<V> := copy(held_values(m))
# whether a map holds a key
has(m: map<K, V>, key: K): bool := key_place(m, key) > 0
# whether a map holds a key, `"a" in {a: 1}`
in(key: K, m: map<K, V>): bool := m.has(key)
# a key's value, ø when the map holds none: `{a: 1}.get("b") ?? 0` is 0
get(m: map<K, V>, key: K): V? := {
	at = key_place(m, key)
	if at > 0 then held_values(m)#at else ø
}
# a key taken out of a map with its value, the others kept in their order; a missing key leaves the map as it was
remove(m: map<K, V>, key: K) := {
	at = key_place(m, key)
	if at > 0 {
		held_keys(m).remove_at(at - 1)
		held_values(m).remove_at(at - 1)
		reslotted(m, no)
	}
}

# Python's dict words (wiki/list.md "Python's words"): `m.pop("a")` a key's value, the key taken out, a missing key
# raising; `m.update(n)` each of n's keys given its value in m; `m.setdefault("a", 0)` a key's value, the default
# given to it first when m lacks the key
pop(m: map<K, V>, key: K): V := {
	value = m#key
	m.remove(key)
	value
}
update(m: map<K, V>, from: map<K, V>) := { for key in keys(from) { m#key = from#key } }
# a new map of the same entries, which grows apart from the first, as a list's copy does
copy(m: map<K, V>): map<K, V> := {
	out: map<K, V> = {}
	out.update(m)
	out
}
setdefault(m: map<K, V>, key: K, default: V): V := {
	if not m.has(key) { m#key = default }
	m#key
}
