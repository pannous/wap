# How a list holds its items in a native build (build.sh), which takes this file for types/list_items.wap, as wasm2c
# takes no GC type: a list is the address of its header in the module's memory, [count u32][room u32][items u32], the
# items each at its type's width in a block of their own (core/emit/primitives.wap item.load, item.bytes), packed as C
# reads an array of them, so a list grows in place, its block
# copied to a larger one, and every name holding it sees the item added. The memory comes from text_bytes.wap's
# memory_taken.
# DEBT: a list's memory is never freed, nor its old block when it grows: fine for the native wap's driver and short
#   programs, not for a long-running one
# (copied over list_items.wap in a native build, so beside the text_bytes.wap it uses, memory_texts.wap there)
use "text_bytes.wap"

HEADER_BYTES := 12
# the most bytes an item takes, which a block reserves for each
ITEM_BYTES := 8
ROOM_FIRST := 4
# the GC heap's list_pop says the same (core/emit/lists.wap POPPED_EMPTY), which a library file cannot read
POPPED_EMPTY := "pop of an empty list"

# a list as the address it is, and back: a list<int> a literal retypes as the list it makes (core/analyze/data.wap
# built_in_memory), as every list is one address here
list_address(xs: list): int := prim i64.extend_i32_u(xs)
list_at(at: int): list<int> := prim i32.wrap_i64(at)
# how many items a list holds, how many its block has room for, where its block starts
@kernel(list.count)
#(xs: list): int := memory_word(list_address(xs))
room(xs: list): int := memory_word(list_address(xs) + 4)
items_at(xs: list): int := memory_word(list_address(xs) + 8)
# the bytes each item of the list takes: its type's width
item_bytes(xs: list<T>): int := prim item.bytes(xs)
# where a list's items are in the memory, packed at their width as C reads an array of them (lib/foreign.wap
# items_handed)
items_address(xs: list<T>): int := items_at(xs)
# a list's item at a place, counting from 1, `xs#2`, and given a value, `xs#2 = 5`
#(xs: list<T>, at: int): T := prim item.load(items_at(xs) + (at - 1) * item_bytes(xs))
set(to: T, of: list<T>, at: int) := prim item.store(items_at(of) + (at - 1) * item_bytes(of), to)
# an empty list with room for `count` items: what a list literal starts from (core/analyze/data.wap built_in_memory)
reserved(count: int): list<int> := {
	at = memory_taken(HEADER_BYTES)
	set_memory_word(at + 4, count)
	set_memory_word(at + 8, memory_taken(count * ITEM_BYTES))
	list_at(at)
}
# an item put at the end of a list, its block moved to one twice as large when it is full
add(xs: list<T>, item: T) := {
	count = #xs
	if count == room(xs) {
		larger = if count == 0 then ROOM_FIRST else count * 2
		block = memory_taken(larger * ITEM_BYTES)
		for at in 0 upto count * item_bytes(xs) { set_memory_byte(block + at, memory_byte(items_at(xs) + at)) }
		set_memory_word(list_address(xs) + 4, larger)
		set_memory_word(list_address(xs) + 8, block)
	}
	set_memory_word(list_address(xs), count + 1)
	set(item, xs, count + 1)
}
# a list with an item added: each item of a list literal in turn
extended(xs: list<T>, item: T): list<T> := {
	add(xs, item)
	xs
}
# the last item taken off a list; an empty list raises, as a list of the GC heap does
pop(xs: list<T>): T := {
	count = #xs
	if count == 0 { raise POPPED_EMPTY }
	set_memory_word(list_address(xs), count - 1)
	xs#count
}
# the items of a list at the places of a range, counting from 0, up to the list's end, in a new list
slice(xs: list<T>, r: Range): list<T> := {
	out: list<T> = []
	for at in r.from upto slice_end(xs, r) { out.add(xs#(at + 1)) }
	out
}

# A map in the memory: the address of its three lists, its keys, its values and its slots (maps.wap), one word each.
# One with room for `count` entries, its type the map's that typing gives it, and one with an entry given its value:
# each entry of a map literal in turn (core/analyze/data.wap built_in_memory)
held_keys(m: map<K, V>): list<K> := prim item.load(map_address(m))
held_values(m: map<K, V>): list<V> := prim item.load(map_address(m) + ITEM_BYTES)
held_slots(m: map<K, V>): list<int> := prim item.load(map_address(m) + 2 * ITEM_BYTES)
map_address(m: map<K, V>): int := prim i64.extend_i32_u(m)
map_reserved(count: int): map<text, int> := {
	at = memory_taken(3 * ITEM_BYTES)
	set_memory_word(at, list_address(reserved(count)))
	set_memory_word(at + ITEM_BYTES, list_address(reserved(count)))
	set_memory_word(at + 2 * ITEM_BYTES, list_address(reserved(0)))
	prim i32.wrap_i64(at)
}
entered(m: map<K, V>, key: K, value: V): map<K, V> := {
	m#key = value
	m
}
