# The types module's number words (AGENTS.md "Layers"): plain warp over the prelude's comparisons.

# the bytes a decimal number's text holds beside its digits
PLUS_BYTE := 43
DOT_BYTE := 46
EXPONENT_BYTES := [69, 101]
# the digits a float reads exactly into an int before the rest only scale it
MANTISSA_LIMIT := 100000000000000000

# the circle's and growth's constants (wiki/math.md)
π := 3.141592653589793
pi := π
HALF_PI := 1.5707963267948966
QUARTER_PI := 0.7853981633974483
# tan(π/8): above it atan turns its argument toward 0 by atan(x) = π/4 + atan((x - 1) / (x + 1))
TAN_EIGHTH_PI := 0.41421356237309503
LN2 := 0.6931471805599453

# the smaller and the larger of two values: `min(3, 2)` is 2, `max(1.5, 2.5)` 2.5
min(a: T, b: T): T := if a < b then a else b
max(a: T, b: T): T := if a > b then a else b
# whether a whole number divides by 2: `even(4)` is yes, `odd(4)` no
even(n: int): bool := n % 2 == 0
odd(n: int): bool := not even(n)

# a value in warp notation, as a program's result shows it: an int, a float by its shortest digits, yes or no
show(n: int): text := text(n)
show(x: float): text := text(x)
show(b: bool): text := text(b)
# a narrow number, as a list<int32> or list<float32> holds one, shown as its full-width number
show(n: i32): text := show(int(n))
show(x: float32): text := show(float(x))

# the machine word i64 (wiki/number.md "Whole numbers"), which wraps as the machine does: an int becomes one by `as` or
# where one is declared
type i64 < int

# the float a decimal text writes, a sign, a fraction and an exponent allowed: `float("-2.5e3")` is -2500.0; any other
# text raises
float(t: text): float := {
	n = byte_count(t)
	at = if n > 0 and (byte_at(t, 0) == MINUS_BYTE or byte_at(t, 0) == PLUS_BYTE) then 1 else 0
	mantissa = 0
	scale = 0
	fraction = no
	while at < n and (is_digit_byte(byte_at(t, at)) or (byte_at(t, at) == DOT_BYTE and not fraction)) {
		if byte_at(t, at) == DOT_BYTE {
			fraction = yes
		} else if mantissa < MANTISSA_LIMIT {
			mantissa = mantissa * 10 + byte_at(t, at) - ZERO_BYTE
			if fraction { scale -= 1 }
		} else if not fraction {
			scale += 1
		}
		at += 1
	}
	if at < n and byte_at(t, at) in EXPONENT_BYTES { scale += int(bytes_between(t, at + 1, n).replace("+", "")); at = n }
	if at < n or n == 0 { raise("float: " + t + " is no decimal number") }
	# divided by a power of ten rather than times its inverse, which no float holds exactly: 25e-6 is 0.000025
	value = if scale < 0 then float(mantissa) / 10.0 ^ (0 - scale) else float(mantissa) * 10.0 ^ scale
	if n > 0 and byte_at(t, 0) == MINUS_BYTE then -value else value
}
is_digit_byte(b: int): bool := b >= ZERO_BYTE and b < ZERO_BYTE + 10
# the number a decimal text writes: an int beyond an int's range as a float until exact numbers
number(t: text): number := float(t)
number(n: number): number := n
# the character of a code: `char(97)` is 'a'
char(code: int): char := prim i32.wrap_i64(code)

# The circle and growth functions, in plain wap as wasm has no instruction for them: each brings its argument near 0,
# where a series converges fast (wiki/math.md)
# the sum of a series from its first term, each next term made from the one before and its number 1, 2, …; summed
# until a term no longer changes the sum
series_sum(first: float, next: (float, int) -> float): float := {
	sum = first
	term = first
	k = 1
	while sum + next(term, k) != sum {
		term = next(term, k)
		sum += term
		k += 1
	}
	sum
}
# sine and cosine near 0, |r| ≤ π/4, by their Taylor series
sine_series(r: float): float := series_sum(r, (term, k) => -term * r * r / ((2 * k) * (2 * k + 1)))
cosine_series(r: float): float := series_sum(1.0, (term, k) => -term * r * r / ((2 * k - 1) * (2 * k)))
# sin(x + quarters · π/2): x brought within π/4 of a multiple of π/2, then the series of that quarter
sine_turned(x: float, quarters: int): float := {
	nearest = round(x / HALF_PI)
	r = x - nearest * HALF_PI
	turn = (nearest + quarters) % 4
	if turn == 0 then sine_series(r) else if turn == 1 then cosine_series(r) else if turn == 2 then -sine_series(r) else -cosine_series(r)
}
sin(x: float): float := sine_turned(x, 0)
cos(x: float): float := sine_turned(x, 1)
tan(x: float): float := sin(x) / cos(x)

two_to(k: int): float := if k >= 0 then 2.0 ^ k else 1 / 2.0 ^ (0 - k)
# e^x: x = k·ln 2 + r with |r| ≤ ln 2 / 2, so e^x = 2^k · e^r, e^r by its series
exp(x: float): float := {
	k = round(x / LN2)
	r = x - k * LN2
	series_sum(1.0, (term, n) => term * r / n) * two_to(k)
}
# the natural logarithm of a positive x: x = m·2^k with 1 ≤ m < 2, ln m = 2·atanh((m - 1) / (m + 1)) by its series
log(x: float): float := {
	if x <= 0 { raise "log of ${x}: only positive numbers have a logarithm" }
	k = 0
	m = x
	while m >= 2 {
		m /= 2
		k += 1
	}
	while m < 1 {
		m *= 2
		k -= 1
	}
	s = (m - 1) / (m + 1)
	2 * series_sum(s, (term, n) => term * s * s * (2 * n - 1) / (2 * n + 1)) + k * LN2
}
sinh(x: float): float := (exp(x) - exp(-x)) / 2
cosh(x: float): float := (exp(x) + exp(-x)) / 2
# the sign of a whole number, 1, -1 or 0 (a float's is lib/math.wap)
sign(x: int): int := if x > 0 then 1 else if x < 0 then -1 else 0

# the natural numbers (wiki/number.md), and their recursor (wiki/enum.md "The recursor"): `nat.recursor(0, (k, double_k) => double_k + 2, n)`
type nat = int where it >= 0
recursor(base: T, step: (nat, T) -> T, n: nat): T := if n == 0 then base else step(n - 1, recursor(base, step, n - 1))

# the natural numbers' words (their inverses, which let `match n { zero => a; successor(k) => b }` take n apart, wait in
# types/integers.wap for the lowering of an inverse's definition, wiki/enum.md "Patterns by inverse")
zero: nat := 0
successor(k: nat): nat := k + 1
