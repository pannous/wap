# The types: the standard language every program gets, as whole definitions with their bodies (AGENTS.md
# "Layers"). A built-in is declared here like any function; its body is a primitive, `prim`, where warp ends and wasm
# or the host begins: a wasm instruction (`prim i64.add(a, b)`), a conversion, or a host word (`prim print_text(t)`),
# so `a + b` is an ordinary call whose int overload happens to be one instruction. The compiler knows none of these
# names: the declare stage reads their signatures from this file, the emitter their bodies. A module it uses holds words
# programs do not see.

use "floats.wap"
use "host.wap"

# `a ≈ b` holds within RELATIVE_TOLERANCE of either side, the looser `a ~ b` within ROUGH_TOLERANCE, both within
# ABSOLUTE_TOLERANCE near zero
RELATIVE_TOLERANCE := 0.000000001
ROUGH_TOLERANCE := 0.01
ABSOLUTE_TOLERANCE := 0.000000000001


# a text written to the standard output, then a line end
print(t: text) := write(t, STANDARD_OUTPUT, yes)
# any other value printed as its text: `print 1 + 2` prints 3
print(x: T) := print(text(x))
# a text written to the standard error, then a line end; the program goes on
eprint(t: text) := write(t, STANDARD_ERROR, yes)
# a got-it note on the standard error: `hint "write a + b for a plus b"` prints "hint: write a + b for a plus b"
hint(message: text) := eprint("hint: " + message)
# the program stopped with a message on the standard error, then a line end; it never finishes
raise(message: text): never := prim raise_text(message)
# 1 when the condition holds, else the message raised: `assert 1 + 1 == 2` is 1
assert(holds: bool, message: text): int := if holds then 1 else raise message
# DEBT: one function with `message: text = "assertion failed"` once the seed lowers default parameters in the types module
assert(holds: bool): int := assert(holds, "assertion failed")


# arithmetic and comparisons of ints and of floats, each one wasm instruction; a call picks the overload its
# arguments' types fit
# DEBT: An int and a float mixed are refused: `1 + 2.5` finds no `+` taking (int, float) (warp gives 3.5), since
#   overloads are chosen by exact types and no conversion of an int to a float where one is wanted exists yet. Paid
#   off by that conversion, in typing, not by mixed overloads.
+(a: int, b: int): int := prim i64.add(a, b)
-(a: int, b: int): int := prim i64.sub(a, b)
*(a: int, b: int): int := prim i64.mul(a, b)
<<(a: int, b: int): int := prim i64.shl(a, b)
# a shift right keeps the sign; >>> shifts zeros in, the bits read as unsigned: `-1 >>> 60` is 15
>>(a: int, b: int): int := prim i64.shr_s(a, b)
>>>(a: int, b: int): int := prim i64.shr_u(a, b)
# the bits of two ints combined (wiki/function.md): `5 | 3` is 7, `5 & 3` is 1
|(a: int, b: int): int := prim i64.or(a, b)
&(a: int, b: int): int := prim i64.and(a, b)
# a value piped into a function: `x |> f` and `x | f` are `f(x)`, so `2.0 | square | sqrt` is 2.0
|>(x: T, f: (T) -> R): R := f(x)
|(x: T, f: (T) -> R): R := x |> f
# exclusive or: of two ints bit by bit, `5 xor 3` is 6; of two bools yes when they differ
xor(a: int, b: int): int := prim i64.xor(a, b)
xor(a: bool, b: bool): bool := a != b
# `a implies b` (wiki/laws.md), also `a ⇒ b`: no only when a holds and b does not
implies(a: bool, b: bool): bool := not a or b
# an int's sign turned: `-x`
-(x: int): int := 0 - x
# a number's distance from zero: `abs(-3)` is 3, `abs(-2.5)` 2.5
abs(x: int): int := if x < 0 then -x else x
# the Euclidean quotient and remainder of ints, warp's (wiki/Footguns.md "Negative modulo"): the remainder is never
# negative, 0 ≤ r < |b|, and a == b * (a ÷ b) + a % b: `-7 % 3` is 2, `7 % -3` is 1, `-7 ÷ 2` is -4, `7 ÷ -3` is -2
÷(a: int, b: int): int := quotient(a - a % b, b)
%(a: int, b: int): int := {
	r = truncated_remainder(a, b)
	if r >= 0 then r else if b > 0 then r + b else r - b
}
# the remainder of the truncated quotient, of the dividend's sign: `-7 rem 3` and `-7 ⦼ 3` are -1
rem(a: int, b: int): int := truncated_remainder(a, b)
==(a: int, b: int): bool := prim i64.eq(a, b)
!=(a: int, b: int): bool := prim i64.ne(a, b)
<(a: int, b: int): bool := prim i64.lt_s(a, b)
>(a: int, b: int): bool := prim i64.gt_s(a, b)
<=(a: int, b: int): bool := prim i64.le_s(a, b)
>=(a: int, b: int): bool := prim i64.ge_s(a, b)
+(a: float, b: float): float := prim f64.add(a, b)
-(a: float, b: float): float := prim f64.sub(a, b)
*(a: float, b: float): float := prim f64.mul(a, b)
/(a: float, b: float): float := prim f64.div(a, b)
# a power by squaring, `2 ^ 10` is 1024, `1.5 ^ 2` is 2.25; a float's negative power is its inverse's, an int's is no int
^(a: int, b: int): int := if b < 0 then raise "an int's negative power is no int; write a float: 2.0 ^ -1" else powered(a, b, 1)
^(a: float, b: int): float := if b < 0 then 1.0 / powered(a, 0 - b, 1.0) else powered(a, b, 1.0)
# a float to a power that is a float: 2.0 ^ 0.5 is √2
^(a: float, b: float): float := exp(b * log(a))
==(a: float, b: float): bool := prim f64.eq(a, b)
!=(a: float, b: float): bool := prim f64.ne(a, b)
<(a: float, b: float): bool := prim f64.lt(a, b)
>(a: float, b: float): bool := prim f64.gt(a, b)
<=(a: float, b: float): bool := prim f64.le(a, b)
>=(a: float, b: float): bool := prim f64.ge(a, b)

# texts: equal when their bytes are, joined by +
!=(a: text, b: text): bool := not(a == b)
# any two values of one type are equal by that type's equality: cases by tag and fields, instances field by field,
# lists item by item (core/emit/equality.wap); the overloads above are the plain values' own
==(a: T, b: T): bool := prim tag_equal(a, b)
!=(a: T, b: T): bool := not(a == b)
# any two values of one type are ordered by that type's <: the other three orders follow from it
>(a: T, b: T): bool := b < a
<=(a: T, b: T): bool := not(b < a)
>=(a: T, b: T): bool := not(a < b)
# a case's name, `Bracket.Round` is "Round", which shows it too where its cases have no fields (sugar/records.wap)
text(e: enum): text := prim case_name(e)
show(e: enum): text := prim case_name(e)
# the plain case of a number among its enum's cases (sugar/records.wap indexed), one that is no case raising
case_of(cases: list<T>, number: int, enum_name: text): T := if number >= 0 and number < #cases then cases[number] else raise("${number} is no " + enum_name + " case")

# the int a text of decimal digits writes, a leading - its sign: `int("-42")` is -42; any other text raises
int(t: text): int := {
	negative = byte_count(t) > 1 and byte_at(t, 0) == MINUS_BYTE
	if byte_count(t) == 0 { raise("int: an empty text writes no int") }
	value = 0
	for at in (if negative then 1 else 0) .. byte_count(t) {
		digit = byte_at(t, at) - ZERO_BYTE
		if digit < 0 or digit > 9 { raise("int: " + t + " is no decimal int") }
		value = value * 10 + digit
	}
	if negative then -value else value
}
# the bytes of the characters - and 0
MINUS_BYTE := 45
ZERO_BYTE := 48

# a value's text, as a text's holes show it: `"n is ${n}"`
# a value made into its own type is itself (wiki/conversion.md: T(x) makes a T), so `x as int` of an int is x
text(t: text): text := t
int(n: int): int := n
float(x: float): float := x
bool(b: bool): bool := b
text(c: char): text := encoded(ord(c), 1, 1)
text(b: bool): text := if b then "yes" else "no"
# an optional's text: its value's, or ø when it is missing
text(x: T?): text := if missing(x) then "ø" else text(x!)
# any other value's text is its show: a list's, a map's, an instance's, `text([1, "a"])` is "[1, \"a\"]" (user 2026-11-23)
text(x: T): text := show(x)

# the other truth value: `not yes` is no (`!` and `¬` are its aliases)
not(x): bool := if x then no else yes
# A value as a condition reads it (wiki/truthiness.md): truthy when it is not empty, so one word decides both `if x`
# and `x is empty`, and a class's own empty decides `if b`. 0, 0.0 and ø are empty here, a text and a list beside
# their own words (types/texts.wap, lists.wap)
empty(n: int): bool := n == 0
empty(x: float): bool := x == 0.0
# an optional is empty when it is missing or its value is: `count: int? = 0` is falsy (wiki/truthiness.md)
empty(x: T?): bool := missing(x) or empty(x!)
# any other value, an instance whose class says nothing among them, is not empty, so it counts as yes; this least
# specific empty yields to every typed one
empty(x: T): bool := no
truthy(x: T): bool := not empty(x)
# a value as a bool: `bool("no")` and `bool("0")` are no, as a text written for a yes or no reads; any other value is
# its truth (wiki/conversion.md)
FALSE_SPELLINGS: list<text> := ["no", "0"]
bool(t: text): bool := not FALSE_SPELLINGS.contains(t) and truthy(t)
bool(c: char): bool := bool(text(c))
bool(x: T): bool := truthy(x)

# the ints from one to another, both included: `2 to 5` is Range(2, 5), `2 .. 5` stops before 5, Range(2, 4)
# (sugar/ranges.wap)
class Range { from: int; last: int }
# how many ints a range holds, and its int at a place counting from 1, so `for i in r` walks a range a name holds as
# it walks a list
#(r: Range): int := r.last - r.from + 1
#(r: Range, at: int): int := r.from + at - 1
# the place after the last a range takes of a list, counting from 0, the list's count where the range runs past its end
slice_end(xs: list<T>, r: Range): int := if r.last < #xs then r.last + 1 else #xs
# a range's ints as a list, which it is read as wherever a list is wanted: `(1 to 3).filter(odd)` (wiki/conversion.md)
list(r: Range): list<int> := {
	out: list<int> = []
	for at in r { out.add(at) }
	out
}
# the largest int, where a range left open ends: `xs[2 ..]` is Range(2, LAST_INT), every item from the place 2 on
LAST_INT := 0x7FFFFFFFFFFFFFFF

# a float's 64 bits as an int and back, and a character's code: `ord('a')` is 97
float_bits(x: float): int := prim i64.reinterpret_f64(x)
bits_float(bits: int): float := prim f64.reinterpret_i64(bits)
ord(c: char): int := prim i64.extend_i32_u(c)
# a float's sign turned, its whole parts, an int as a float
-(x: float): float := prim f64.neg(x)
abs(x: float): float := if x < 0.0 then -x else x
floor(x: float): float := prim f64.floor(x)
ceil(x: float): float := prim f64.ceil(x)
sqrt(x: float): float := prim f64.sqrt(x)
# `√x`, the square root: a float's as sqrt gives it; an int's when it is a whole number, `√16` 4, else refused, as wap
# has no exact roots yet (warp keeps `√2` exact) and gives no float in their place
√(x: float): float := sqrt(x)
√(n: int): int := {
	root = round(sqrt(float(n)))
	if root * root == n then root else raise("√${n} is no whole number, and wap has no exact roots yet: write √${n}.0 for the float")
}
trunc(x: float): int := prim i64.trunc_f64_s(x)
# x's nearest whole number, a half away from zero: `round(2.5)` is 3, `round(-2.5)` is -3
round(x: float): int := if x < 0 then 0 - trunc(0.5 - x) else trunc(x + 0.5)
# x rounded to some places after the point, a half away from zero: `round_to(2.345, 2)` is 2.35. Of x's two
# neighbours on that grid the nearer one wins, measured against x itself: x * 100 is 234.49999999999997
round_to(x: float, places: int): float := if x < 0 then 0.0 - round_to(0.0 - x, places) else nearest_on_grid(x, 10.0 ^ places)
nearest_on_grid(x: float, scale: float): float := {
	steps = floor(x * scale)
	below = steps / scale
	above = (steps + 1.0) / scale
	if above - x <= x - below then above else below
}
float(n: int): float := prim f64.convert_i64_s(n)
# a float's whole part, toward zero: `int(2.7)` and `2.7 as int` are 2, `int(-2.7)` is -2
int(x: float): int := trunc(x)
# a number at a narrower width and back, as a list<float32> or a C float holds one: a float32 the float's nearest, an
# i32 the int's low 32 bits
float32(x: float): float32 := prim f32.demote_f64(x)
float(x: float32): float := prim f64.promote_f32(x)
i32(n: int): i32 := prim i32.wrap_i64(n)
int(n: i32): int := prim i64.extend_i32_s(n)

# a float's text: its shortest digits that read back (types/floats.wap)
text(x: float): text := float_text(x)
# a float other than ∞, -∞ and NaN
is_finite(x: float): bool := x == x and x != infinity() and x != -infinity()

# `sin(π) ≈ 0` (wiki/operator.md, equality.md): two floats equal up to rounding; `100 ~ 100.5` within 1%
≈(a: float, b: float): bool := close_within(a, b, RELATIVE_TOLERANCE)
~(a: float, b: float): bool := close_within(a, b, ROUGH_TOLERANCE)
close_within(a: float, b: float, tolerance: float): bool := {
	difference = abs(a - b)
	difference <= tolerance * abs(a) or difference <= tolerance * abs(b) or difference <= ABSOLUTE_TOLERANCE
}

# bools compared: equal when both are yes or both no
==(a: bool, b: bool): bool := if a then b else not(b)
# identical: equal and of one type, so `3 === 3.0` is no where `3 == 3.0` is yes (wiki/equality.md)
# DEBT: `===` is value equality here, where warp's `===` is identity (wiki/equality.md): two separately built `[1]`
#   are `===` under wap. Off the census: wap's own compiler compares definitions by their DEFINER id instead. Paid off
#   when `===` is ref.eq identity.
===(a: T, b: T): bool := a == b
===(a, b): bool := no
!==(a, b): bool := not(a === b)
# optional values, T?: a T or ø (wiki/optional.md); `x!` is x's value, raising when x is missing
missing(x: T?): bool := prim ref.is_null(x)
!(x: T?): T := prim optional_value(x)
==(a: T?, b: T?): bool := if missing(a) then missing(b) else not missing(b) and a! == b!
!=(a: T?, b: T?): bool := not(a == b)
# `a ?? b` is a rule (sugar/conditions.wap): b runs only when a is missing


# a value no show takes by its type, an any whose value none takes at run time (a call of show on an any tests each
# show first, core/analyze/dispatch.wap) or a map: raised, naming the word; ø, which no type's show takes, shows as "ø"
show(x: any): text := if x is ø then "ø" else raise("show: no show takes this value's type")
# lists alike item by item, maps key by key in any order: `{x: 1, y: 2} ≈ {y: 2.0000000001, x: 1}` (wiki/operator.md)
≈(a: list<T>, b: list<T>): bool := #a == #b and (1 to #a).all(i => a#i ≈ b#i)
≈(a: map<K, V>, b: map<K, W>): bool := #a == #b and a.keys.all(key => b.has(key) and a[key] ≈ b[key])
