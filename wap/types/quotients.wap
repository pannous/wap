# Quotients in the library (wiki/quotient.md, notes/coc-q1.md): the types made of `quotient(T, same)`, the axiom they
# rest on, and what follows from it. The word `quotient(T, same)` as a type and `quotient.of`/`lift` as calls are the
# kernel's (kernel/quotients.wap), reached through the core reading Q1's plan names; this file is plain wap over them,
# and is included by types.wap once that reading is in.

# a pair of whole numbers read as a ratio, equal when their cross products are
class fraction { top: int; bottom: int where it != 0 }
same_value(a: fraction, b: fraction) := a.top * b.bottom == b.top * a.bottom
type rational = quotient(fraction, same_value)

# a list up to order and repeats: two lists hold the same items when each item is in both
same_items(a: list<T>, b: list<T>) := a.all(item => b.contains(item)) and b.all(item => a.contains(item))
type set<T> = quotient(list<T>, same_items)

# values the relation joins are equal: the one axiom quotients rest on. The relation is a proposition; a bool relation
# is passed as joined(same)
axiom quotient_sound(a: T, b: T, same: (T, T) -> Prop, h: same(a, b)): (quotient.of(a) as quotient(T, same)) == quotient.of(b)

# the relation joining two functions: equal at every argument (wiki/proposition.md `for x: T`)
pointwise_equal(p: (A) -> B, q: (A) -> B): Prop :=
	for a: A
	p(a) == q(a)
# functions equal at every argument are equal: out of the quotient of functions by that, whose application at a is a
# function of it (`lift` respects the relation by the hypothesis), and the values joined by it equal
theorem function_extensionality(f: (A) -> B, g: (A) -> B, h: (a: A) -> f(a) == g(a)): f == g := chain
	f ==
		(a => quotient.of(f).lift(k => k(a)))    by refl ==
		(a => quotient.of(g).lift(k => k(a)))    by quotient_sound(f, g, pointwise_equal, h) ==
		g                                        by refl

# a value of T as the quotient's value it makes (wiki/quotient.md "quotient.of"), S found from the type wanted; when the
# program runs it is that value itself, as lift's q is (the kernel reads a call of it as quotient.of)
of(a: T): quotient(T, S) := prim as_is(a)

# what a relation must be for its quotient's == to be the quotient's equality: joining each value with itself, both
# ways, and along a chain (wiki/quotient.md "half == fraction(2, 4)")
reflexive(same: (T, T) -> bool): Prop :=
	for a: T
	same(a, a)
symmetric(same: (T, T) -> bool): Prop :=
	for a: T
	for b: T
	same(a, b) implies same(b, a)
transitive(same: (T, T) -> bool): Prop :=
	for a: T
	for b: T
	for c: T
	same(a, b) and same(b, c) implies same(a, c)
# two truths each implying the other are one, by bool's cases
theorem bools_equal(x: bool, y: bool): (x implies y) and (y implies x) implies x == y := match x
	yes => match y
		yes => refl
		no => by assume
	no => match y
		yes => by assume
		no => refl
# for a fixed a, same(a, b) is one truth for the values same joins: each side implies the other along a chain
theorem joined_after(same: (T, T) -> bool, a: T, s: symmetric(same), t: transitive(same)): respects(b => same(a, b), same) := by bools_equal, s, t
# so is the lift of it over any value of the quotient: by the quotient's induction, on a made value both lifts are
# same(a, b) and same(a', b)
theorem lifted_after(same: (T, T) -> bool, q: quotient(T, same), s: symmetric(same), t: transitive(same)): respects(a => q.lift(b => same(a, b), respected: joined_after(same, a, s, t)), same) :=
	quotient.induct(q, b => by joined_after, s, t)
# a quotient's values are equal where its relation joins what they are made of: lift twice, the relation's laws the
# provers' (the respect proofs follow from them)
==(p: quotient(T, S), q: quotient(T, S), r: reflexive(S) = by, s: symmetric(S) = by, t: transitive(S) = by): bool :=
	p.lift(a => q.lift(b => S(a, b), respected: joined_after(S, a, s, t)), respected: lifted_after(S, q, s, t))
# the lemma same_value's transitive needs: a nonzero factor cancels, by sign's cases
law times_cancel(x: int, y: int, k: int): x * k == y * k and k != 0 implies x == y := by sign_product, times_commutes

# an int's sign (types/numbers.wap): it multiplies, and equal cross products give equal signs (what the lift of a
# fraction's sign needs). The order matters: each law is a lemma of the next (law.md "A law proved before is a lemma of
# the laws after it").
# GUESS (unbuilt, red until t6a4 builds): `match` as proof by cases, `by` naming the lemmas to its provers, and the
# provers proving the five product laws from the kernel's laws of the same statements (kernel/integer_laws.wap)
law zero_times(y: int): 0 * y == 0
law one_times(y: int): 1 * y == y
law distribute(a: int, b: int, c: int): (a + b) * c == a * c + b * c
law times_commutes(x: int, y: int): x * y == y * x
law times_negated(x: int, y: int): (-x) * y == -(x * y)
theorem times_associates(x: nat, y: int, z: int): (x * y) * z == x * (y * z) := match x
	0 => by zero_times
	k + 1 => chain
		((k + 1) * y) * z == (k * y + y) * z    by distribute, one_times ==
			(k * y) * z + y * z                 by distribute ==
			k * (y * z) + y * z                 by times_associates(k, y, z) ==
			(k + 1) * (y * z)                   by distribute, one_times
law positive_product(x: int, y: int): x > 0 and y > 0 implies x * y > 0 := by times_commutes, times_associates

# the three mixed-sign cases follow from positive_product on |x| and |y|
law negative_times_positive(x: int, y: int): x < 0 and y > 0 implies x * y < 0 := by positive_product, times_negated
law positive_times_negative(x: int, y: int): x > 0 and y < 0 implies x * y < 0 := by positive_product, times_negated
law negative_product(x: int, y: int): x < 0 and y < 0 implies x * y > 0 := by positive_product, times_negated
law zero_product(x: int, y: int): x == 0 or y == 0 implies x * y == 0 := by times_commutes

# by the cases of sign: x and y are each positive, negative or zero, one subject at a time
theorem sign_product(x: int, y: int): sign(x * y) == sign(x) * sign(y) := match x > 0
	yes => match y > 0
		yes => by positive_product
		no => match y < 0
			yes => by positive_times_negative
			no => by zero_product
	no => match x < 0
		yes => match y > 0
			yes => by negative_times_positive
			no => match y < 0
				yes => by negative_product
				no => by zero_product
		no => by zero_product

# a square is positive for a nonzero x, by the cases of its sign
theorem square_positive(x: int): x != 0 implies sign(x * x) == 1 := match x > 0
	yes => by positive_product
	no => by negative_product

# from sign_product: a * d == c * b makes (a * b) * (d * d) == (c * d) * (b * b), and a square is positive for b, d != 0
theorem sign_respects(a: int, b: int, c: int, d: int): b != 0 and d != 0 and a * d == c * b implies sign(a * b) == sign(c * d) := chain
	sign(a * b) == sign(a * b) * sign(d * d)   by square_positive ==
		sign(a * d) * sign(b * d)              by sign_product ==
		sign(c * b) * sign(b * d)              by sign_product ==
		sign(c * d) * sign(b * b)              by sign_product ==
		sign(c * d)                            by square_positive

# a bool relation as the proposition a quotient's relation is, joined where it says yes: the one spelling of that
# reading, which the kernel's reading of quotient(T, same) gives too (core/analyze/terms.wap truth_adapted)
joined(same: (T, T) -> bool): (T, T) -> Prop := (a, b) => same(a, b) == yes
# a function out of a quotient respects its relation when it gives one answer for the values the relation joins
respects(f: (T) -> R, same: (T, T) -> bool): Prop :=
	for a: T
	for b: T
	joined(same)(a, b) implies f(a) == f(b)
# a function of the values of T as a function of the quotient (wiki/quotient.md "Functions out of a quotient"), with the
# proof that it respects the relation, which a call leaves to the provers (`by`): unproved, the call is refused. When
# the program runs, q is held as a value of T and lift is a plain call. S is the quotient's relation, a letter found
# from q's type as T is
# (the body is the run's only: the kernel reads a call of lift as quotient.lift, and as_is has no kernel meaning, or
# as_is(of(a)) == a with quotient_sound would equate fraction(1, 2) and fraction(2, 4))
lift(q: quotient(T, S), f: (T) -> R, respected: respects(f, S) = by): R := f(prim as_is(q))

