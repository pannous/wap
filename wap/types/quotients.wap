# Quotients in the library (wiki/quotient.md, notes/coc-q1.md): the types made of `quotient(T, same)`, the axiom they
# rest on, and what follows from it. The word `quotient(T, same)` as a type and `quotient.of`/`lift` as calls are the
# kernel's (kernel/quotients.wap), reached through the core reading Q1's plan names; this file is plain wap over them,
# and is included by types.wap once that reading is in.

# a pair of whole numbers read as a ratio, equal when their cross products are
class fraction { top: int; bottom: int where it != 0 }
same_value(a: fraction, b: fraction) := a.top * b.bottom == b.top * a.bottom
type rational = quotient(fraction, same_value)

# a list up to order and repeats: two lists hold the same items when each item is in both
same_items(a: list<T>, b: list<T>) := a.all(item => b.contains(item)) and b.all(item => a.contains(item))
type set<T> = quotient(list<T>, same_items)

# values the relation joins are equal: the one axiom quotients rest on. The relation is a proposition; a bool relation
# is passed as `(a, b) => same(a, b) == yes`
axiom quotient_sound(a: T, b: T, same: (T, T) -> Prop, h: same(a, b)): (quotient.of(a) as quotient(T, same)) == quotient.of(b)

# functions equal at every argument are equal: out of the quotient of functions by that, whose application at a is a
# function of it (`lift` respects the relation by the hypothesis), and the values joined by it equal
theorem function_extensionality(f: (A) -> B, g: (A) -> B, h: (a: A) -> f(a) == g(a)): f == g := chain
	f ==
		(a => quotient.of(f).lift(k => k(a)))    by refl ==
		(a => quotient.of(g).lift(k => k(a)))    by quotient_sound(f, g, (p, q) => for a: A, p(a) == q(a), h) ==
		g                                        by refl

# sign(x: int) is lib/math.wap:134 (one definition; deleting it there waits for the preload include, test_math uses it).
# an int's sign: it multiplies, and equal cross products give equal signs (what the lift of a fraction's sign needs).
# The order matters: each law is a lemma of the next (law.md "A law proved before is a lemma of the laws after it").
# GUESS (unbuilt): the `match` over comparisons as proof by cases, and `by` naming the lemmas to its provers.
law positive_product(x: int, y: int): x > 0 and y > 0 implies x * y > 0

# the three mixed-sign cases follow from positive_product on |x| and |y|
law negative_times_positive(x: int, y: int): x < 0 and y > 0 implies x * y < 0 := by positive_product
law positive_times_negative(x: int, y: int): x > 0 and y < 0 implies x * y < 0 := by positive_product
law negative_product(x: int, y: int): x < 0 and y < 0 implies x * y > 0 := by positive_product

# by the cases of sign: x and y are each positive, negative or zero
theorem sign_product(x: int, y: int): sign(x * y) == sign(x) * sign(y) := match x > 0, x < 0, y > 0, y < 0
	yes, _, yes, _ => by positive_product
	yes, _, _, yes => by positive_times_negative
	_, yes, yes, _ => by negative_times_positive
	_, yes, _, yes => by negative_product
	_ => by zero_product   # GUESS: a zero factor gives the zero product, the provers' linear arithmetic

# from sign_product: a * d == c * b makes (a * b) * (d * d) == (c * d) * (b * b), and a square is positive for b, d != 0
# GUESS: the step through the squares may need its own lemma (square_positive) if `by` cannot find it
law square_positive(x: int): x != 0 implies sign(x * x) == 1 := by sign_product, positive_product, negative_product
theorem sign_respects(a: int, b: int, c: int, d: int): b != 0 and d != 0 and a * d == c * b implies sign(a * b) == sign(c * d) := chain
	sign(a * b) == sign(a * b) * sign(d * d)   by square_positive ==
		sign(a * d) * sign(b * d)              by sign_product ==
		sign(c * b) * sign(b * d)              by sign_product ==
		sign(c * d) * sign(b * b)              by sign_product ==
		sign(c * d)                            by square_positive

# Waiting on the core reading of quotients (notes/coc-q1.md): `==` of a quotient's values, `lift` with its respect
# obligation, and the i64 case. Not included by types.wap yet: programs say `use quotients`.
