# Quotients in the library (wiki/quotient.md, notes/coc-q1.md): the types made of `quotient(T, same)`, the axiom they
# rest on, and what follows from it. The word `quotient(T, same)` as a type and `quotient.of`/`lift` as calls are the
# kernel's (kernel/quotients.wap), reached through the core reading Q1's plan names; this file is plain wap over them,
# and is included by types.wap once that reading is in.

# a pair of whole numbers read as a ratio, equal when their cross products are
class fraction { top: int; bottom: int where it != 0 }
same_value(a: fraction, b: fraction) := a.top * b.bottom == b.top * a.bottom
type rational = quotient(fraction, same_value)

# a list up to order and repeats: two lists hold the same items when each item is in both
same_items(a: list<T>, b: list<T>) := a.all(item => b.contains(item)) and b.all(item => a.contains(item))
type set<T> = quotient(list<T>, same_items)

# values the relation joins are equal: the one axiom quotients rest on. The relation is a proposition; a bool relation
# is passed as `(a, b) => same(a, b) == yes`
axiom quotient_sound(a: T, b: T, same: (T, T) -> Prop, h: same(a, b)): quotient.of(a) == quotient.of(b)

# functions equal at every argument are equal: out of the quotient of functions by that, whose application at a is a
# function of it (`lift` respects the relation by the hypothesis), and the values joined by it equal
theorem function_extensionality(f: (A) -> B, g: (A) -> B, h: (a: A) -> f(a) == g(a)): f == g := chain
	f ==
		(a => quotient.of(f).lift(k => k(a)))    by refl ==
		(a => quotient.of(g).lift(k => k(a)))    by quotient_sound(f, g, (p, q) => for a: A, p(a) == q(a), h) ==
		g                                        by refl

# an int's sign, and that it multiplies (the lemmas the provers use for the wiki's `sign` of a fraction: by the signs
# of the two factors, the cases of int); equal cross products give equal signs of the fractions' tops and bottoms
sign(x: int): int := if x > 0 then 1 else if x < 0 then -1 else 0
law sign_product(x: int, y: int): sign(x * y) == sign(x) * sign(y)
law sign_respects(a: int, b: int, c: int, d: int): b != 0 and d != 0 and a * d == c * b implies sign(a * b) == sign(c * d)

# Waiting on the core reading of quotients (notes/coc-q1.md): `==` of a quotient's values, `lift` with its respect
# obligation, and the i64 case.
