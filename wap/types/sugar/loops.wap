# Loops and the words that leave them, as While, Break, Continue and Return (wiki/keyword.md): the spellings wap's own
# source uses.

rule while $condition... $body: Braces => While($condition, $body)
rule return $value... => Return($value)
rule return => Return(Empty())
rule break => Break()
rule continue => Continue()
rule until $condition... $body: Braces => While(not $condition, $body)

# A loop over each item of a list or each int of a range, as While (wiki/keyword.md for). Its count goes up before the
# body, so `continue` moves on; the names the rule binds itself are fresh, never the program's.
# DEBT: `for` is two rules, a `to` range and a list walked by index, not the iterator of notes/kernel.md:82: wap's own
#   source walks only these two; a Range held in a name (`r = 1 to 3; for i in r`) takes the list rule. Paid off by
#   the first third kind of thing to walk.
rule for $item in $from to $last $body: Braces => { $item = $from - 1; while $item < $last { $item = $item + 1; $body } }
rule for $item in $items $body: Braces => { held = $items; at = 0; while at < #held { at = at + 1; $item = held#at; $body } }
