# How a text holds its UTF-8 bytes, the one file a build may swap: every other text word is plain wap over these
# (texts.wap, prelude.wap, host.wap), equality, joining and writing too. Here a text is a GC array of its bytes, each
# word a primitive of the emitter (core/emit/primitives.wap); a native build, whose wasm2c takes no GC type, takes
# types/memory_texts.wap, a text in the module's memory.
use "host.wap"

# a text's byte count, a byte (from 0)
byte_count(t: text): int := prim array.len(t)
byte_at(t: text, at: int): int := prim array.get_u(t, at)
# whether two texts are the one array: then equal without reading a byte
same_place(a: text, b: text): bool := prim ref.eq(a, b)
# a text of `count` zero bytes, and one of them set: how a text is made from bytes
text_made(count: int): text := prim array.new_default(count)
set_text_byte(t: text, at: int, b: int) := prim array.set(t, at, b)
# the bytes of a text from `start` up to `stop` set in another from `at`
bytes_copied(source: text, start: int, stop: int, target: text, at: int) := prim array.copy(target, at, source, start, stop - start)
# the address of a text's bytes in the memory, where the host reads them: placed from BYTES_AT (host.wap)
bytes_placed(t: text): int := {
	place(t)
	BYTES_AT
}
# whether a text is in the module's memory, and the address of its bytes there (C's view of it, c.wap): a GC one is not
texts_in_memory(): bool := no
text_address(t: text): int := 0
