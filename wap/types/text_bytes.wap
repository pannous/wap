# How a text holds its UTF-8 bytes, the one file a build may swap: every other text word is plain wap over these
# (texts.wap, prelude.wap, host.wap). Here a text is a GC array of its bytes, each word a primitive of the emitter
# (core/emit/primitives.wap); a native build, whose wasm2c takes no GC type, takes types/memory_texts.wap,
# a text in the module's memory.

# a text's byte count, a byte (from 0), a new text of the bytes from `start` up to `stop`
byte_count(t: text): int := prim array.len(t)
byte_at(t: text, at: int): int := prim array.get_u(t, at)
bytes_between(t: text, start: int, stop: int): text := prim array_slice(t, start, stop - start)
# a text of `count` zero bytes, and one of them set: how a text is made from bytes
text_made(count: int): text := prim array.new_default(count)
set_text_byte(t: text, at: int, b: int) := prim array.set(t, at, b)
# texts: equal when their bytes are, joined by +
==(a: text, b: text): bool := prim text_equal(a, b)
+(a: text, b: text): text := prim text_joined(a, b)
# a text's bytes placed in the memory from BYTES_AT (host.wap); a text written to a file, a line end after it when
# `line` says so
place(t: text) := prim text_placed(t)
write(t: text, file: int, line: bool) := prim text_written(t, file, line)
# whether a text is in the module's memory, and the address of its bytes there (C's view of it, c.wap): a GC one is not
texts_in_memory(): bool := no
text_address(t: text): int := 0
