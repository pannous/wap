# The types module's text words (AGENTS.md "Layers"): plain warp over a text's UTF-8 bytes, as warp's runtime words
# (core/runtime/text_words.warp, characters.warp). Positions count characters from 1; byte offsets count from 0.
# Its primitives are the array operations on a text's bytes: its length, a byte, a new text of some of them.

use "host.wap"

# a byte that continues a character: 10xxxxxx
CONTINUATION_FROM := 128
CONTINUATION_UNTIL := 192
# the decimal digits, each one byte, at the place of its value
DIGITS := "0123456789"
# a text this long keeps its count and its last place found; a shorter one is read from its start, as cheap as the check
LONG_TEXT_BYTES := 64
# the blanks trim takes off: space, tab, line feed, carriage return
BLANK_BYTES := [32, 9, 10, 13]
# what a character's lead byte keeps of its code, by the character's byte count: all of 0xxxxxxx, five bits of
# 110xxxxx, four of 1110xxxx, three of 11110xxx; each continuation byte keeps six
LEAD_BITS := [128, 32, 16, 8]
CONTINUATION_BITS := 64
# the code points that join the character before them into one grapheme (UAX #29 abridged): combining marks of the
# common scripts (Latin, Cyrillic, Hebrew, Arabic, Devanagari, the general blocks), the joiners, variation selectors,
# skin tones and tags, each range its first and last code point
GRAPHEME_EXTENDING := [[0x300, 0x36F], [0x483, 0x489], [0x591, 0x5BD], [0x5BF, 0x5BF], [0x5C1, 0x5C2], [0x5C4, 0x5C5],
	[0x5C7, 0x5C7], [0x610, 0x61A], [0x64B, 0x65F], [0x670, 0x670], [0x6D6, 0x6DC], [0x6DF, 0x6E4], [0x900, 0x903],
	[0x93A, 0x94F], [0x951, 0x957], [0x1AB0, 0x1AFF], [0x1DC0, 0x1DFF], [0x200C, 0x200D], [0x20D0, 0x20FF],
	[0xFE00, 0xFE0F], [0xFE20, 0xFE2F], [0x1F3FB, 0x1F3FF], [0xE0020, 0xE007F]]
# the joiner after which the next character belongs to the grapheme too (👩‍💻), and the regional indicators two of
# which make one flag (🇩🇪)
ZERO_WIDTH_JOINER := 0x200D
REGIONAL_INDICATORS := [0x1F1E6, 0x1F1FF]
CARRIAGE_RETURN := 13
LINE_FEED := 10

# texts: equal when their bytes are (at once when they are one text), joined by +; a new text of the bytes from `start` up to `stop`
@kernel(text.equal)
==(a: text, b: text): bool := {
	if one_text(a, b) { return yes }
	if byte_count(a) != byte_count(b) { return no }
	for at in 0 upto byte_count(a) { if byte_at(a, at) != byte_at(b, at) { return no } }
	yes
}
@kernel(text.join)
+(a: text, b: text): text := {
	# a side with no bytes adds none: the other side is the text joined
	if byte_count(b) == 0 { return a }
	if byte_count(a) == 0 { return b }
	joined = text_made(byte_count(a) + byte_count(b))
	bytes_copied(a, 0, byte_count(a), joined, 0)
	bytes_copied(b, 0, byte_count(b), joined, byte_count(a))
	joined
}
bytes_between(t: text, start: int, stop: int): text := {
	part = text_made(stop - start)
	bytes_copied(t, start, stop, part, 0)
	part
}
# a text's bytes placed in the memory from BYTES_AT (host.wap), the memory grown to hold them
place(t: text) := {
	memory_holding(byte_count(t))
	memory_placed(BYTES_AT, t)
}
# a text written to a file, a line end after it when `line` says so: again from where a write stopped until every byte
# is taken; a write that fails or takes none stops the program
# DEBT: A failed write stops without naming itself: a write that fails or takes none (closed stdout, `| head`) stops
#   with wasm's bare "unreachable", not a raise, as a raise would write through this word again
write(t: text, file: int, line: bool) := {
	at = bytes_placed(t)
	done = 0
	while done < byte_count(t) {
		set_memory_word(IOVEC_AT, at + done)
		set_memory_word(IOVEC_AT + 4, byte_count(t) - done)
		if fd_write(file, IOVEC_AT, 1, MOVED_AT) != 0 or memory_word(MOVED_AT) == 0 { trapped() }
		done += memory_word(MOVED_AT)
	}
	if line { write("\n", file, no) }
}
# WASI's write of the bytes the iovecs at an address name, the count written put at `moved_at`
fd_write(file: int, iovecs_at: int, count: int, moved_at: int): int := prim fd_write(file, iovecs_at, count, moved_at)
# the program stopped where it cannot go on
trapped() := prim unreachable()
# a text of one byte
byte_text(b: int): text := {
	t = text_made(1)
	set_text_byte(t, 0, b)
	t
}
# bytes as one text
bytes_text(bytes: list<int>): text := {
	t = text_made(#bytes)
	for at in 0 upto #bytes { set_text_byte(t, at, bytes[at]) }
	t
}
# a code's UTF-8 bytes: the fewest that hold it, from `count` bytes up, scale the part of the code below the lead byte's
# bits; the lead byte marked by its count, then the continuation bytes
encoded(code: int, count: int, scale: int): text := {
	leads = LEAD_BITS
	if code < leads#count * scale or count == #leads then byte_text(256 - 2 * leads#count + code ÷ scale) + continuation_bytes(code, scale ÷ CONTINUATION_BITS) else encoded(code, count + 1, scale * CONTINUATION_BITS)
}
# the continuation bytes of a code from the one holding `scale`'s six bits down to the last
continuation_bytes(code: int, scale: int): text := if scale == 0 then "" else byte_text(CONTINUATION_FROM + (code ÷ scale) rem CONTINUATION_BITS) + continuation_bytes(code, scale ÷ CONTINUATION_BITS)

is_continuation_byte(b: int): bool := b >= CONTINUATION_FROM and b < CONTINUATION_UNTIL
# the byte offset after the character at offset `at`
character_end(t: text, at: int): int := {
	end = at + 1
	while end < byte_count(t) and is_continuation_byte(byte_at(t, end)) { end += 1 }
	end
}
# whether a character starts at a byte offset: every byte but a continuation byte starts one
starts_character(t: text, at: int): bool := not is_continuation_byte(byte_at(t, at))
# the byte offset before the character that ends at offset `at`
character_start_before(t: text, at: int): int := {
	start = at - 1
	while start > 0 and is_continuation_byte(byte_at(t, start)) { start -= 1 }
	start
}
# the long text a character was last found in, its place and its byte offset: the next place asked of the same text is
# counted from there, forward or back, so a walk over a text's places, peeks back included, reads each byte about once
# (held, the text is never freed while kept, so no other text can stand at its place; texts are not changed once made)
found_text = ""
found_place = 1
found_at = 0
# the byte offset of t's index-th character, counted from 1; past the last, the byte count
character_offset(t: text, index: int): int := {
	global found_text
	global found_place
	global found_at
	long = byte_count(t) >= LONG_TEXT_BYTES
	resumed = long and one_text(t, found_text) and index * 2 >= found_place
	place = if resumed then found_place else 1
	at = if resumed then found_at else 0
	while place > index and at > 0 {
		at = character_start_before(t, at)
		place -= 1
	}
	while place < index and at < byte_count(t) {
		at = character_end(t, at)
		place += 1
	}
	if long {
		found_text = t
		found_place = place
		found_at = at
	}
	at
}

# the characters from one place to another, counted from 0 as a list's: `"warp"[1 .. 3]` is "ar"
slice(t: text, r: Range): text := bytes_between(t, character_offset(t, r.from + 1), character_offset(t, min(r.last, byte_count(t)) + 2))
# a text repeated: `"ab" * 3` is "ababab", none for 0 times
*(t: text, times: int): text := {
	out = ""
	for at in 1 to times { out += t }
	out
}
# what counting a text counts (wiki/char.md): `count bytes of: "aβc"` is 4, `count chars of: "aβc"` is 3
enum CountUnit { bytes, chars }
count(unit: CountUnit, of: text): int := match unit { CountUnit.bytes: byte_count(of); CountUnit.chars: #of }
# a text's UTF-8 bytes: `"aé".bytes` is [97, 195, 169]
bytes(t: text): list<int> := {
	read: list<int> = []
	for at in 0 upto byte_count(t) { read.add(byte_at(t, at)) }
	read
}
# characters as one-character texts, where texts are wanted (core/analyze/calls.wap as_read)
list(cs: list<char>): list<text> := cs.map(c => text(c))
# the characters as a reader sees them, a letter with its marks: `"👍🏽".graphemes` is ["👍🏽"] (wiki/string.md)
graphemes(t: text): list<text> := {
	out: list<text> = []
	start = 0
	previous = 0
	flag_open = no
	at = 0
	while at < byte_count(t) {
		end = character_end(t, at)
		code = decoded(t, at, end)
		joins = in_range(code, REGIONAL_INDICATORS) and flag_open or previous == ZERO_WIDTH_JOINER or previous == CARRIAGE_RETURN and code == LINE_FEED or GRAPHEME_EXTENDING.any(range => in_range(code, range))
		if at > start and not joins {
			out.add(bytes_between(t, start, at))
			start = at
		}
		flag_open = in_range(code, REGIONAL_INDICATORS) and not flag_open
		previous = code
		at = end
	}
	if at > start { out.add(bytes_between(t, start, at)) }
	out
}
# a code point within a range's first and last
in_range(code: int, range: list<int>): bool := code >= range#1 and code <= range#2
# a text's characters, decoded from its UTF-8 bytes: `"aé".codepoints` is ['a', 'é']
codepoints(t: text): list<char> := {
	out: list<char> = []
	at = 0
	while at < byte_count(t) {
		end = character_end(t, at)
		out.add(char(decoded(t, at, end)))
		at = end
	}
	out
}
# a text's characters, each a text of one: `chars("aé")` is ["a", "é"], also written characters
chars(t: text): list<text> := t.codepoints.map(c => text(c))
# a text of one character as that character (wiki/char.md: a one-character text is a character): `"é" as codepoint`
# is 'é'; any other text raises
char(t: text): char := {
	characters = codepoints(t)
	if #characters != 1 { raise "only a text of one character is a char" }
	characters#1
}
# the code of the character whose bytes lie between two offsets
decoded(t: text, start: int, end: int): int := {
	code = byte_at(t, start) % LEAD_BITS#(end - start)
	for at in start + 1 ..< end { code = code * CONTINUATION_BITS + byte_at(t, at) % CONTINUATION_BITS }
	code
}

# whether a text has no characters: `t is empty`
empty(t: text): bool := t == ""
# an int's decimal digits, `-` before a negative one's; counted on the int made negative, so the smallest int has its
# digits too
text(n: int): text := if n < 0 then "-" + negated_digits(n) else negated_digits(0 - n)
# the digits of a negative int's size, or of 0: counted, then written into one text from the last
negated_digits(n: int): text := {
	count = 1
	shorter = n
	while shorter <= -10 {
		shorter = tens_of(shorter)
		count += 1
	}
	digits = text_made(count)
	rest = n
	for at in 1 to count {
		set_text_byte(digits, count - at, byte_at(DIGITS, 0 - rest rem 10))
		rest = tens_of(rest)
	}
	digits
}
# a negative int without its last digit: `tens_of(-123)` is -12
tens_of(n: int): int := (n - n rem 10) ÷ 10
# a text and an int's digits joined, in either order: `"a" + 3` is "a3", `1 + "x"` is "1x" (wiki/string.md); a text
# that spells a number joins too, with a hint that it does, since `"5" + 3` might have meant 8: once a run, so a loop
# joining such texts says it once
+(t: text, n: int): text := number_spelled_noted(t) + text(n)
+(n: int, t: text): text := text(n) + number_spelled_noted(t)
number_spelled_hinted = no
number_spelled_noted(t: text): text := {
	global number_spelled_hinted
	if is_digits(t) and not number_spelled_hinted {
		number_spelled_hinted = yes
		hint("\"${t}\" spells a number and is joined as a text: int(\"${t}\") for its number")
	}
	t
}
# how many characters t holds: `#"héllo"` is 5
# the long text counted last and its count, so a loop that asks a text's count at every step counts it once
counted_text = ""
counted = 0
@kernel(text.count)
#(t: text): int := {
	global counted_text
	global counted
	if byte_count(t) < LONG_TEXT_BYTES { return characters_counted(t) }
	if not one_text(t, counted_text) {
		counted_text = t
		counted = characters_counted(t)
	}
	counted
}
characters_counted(t: text): int := {
	count = 0
	for at in 0 upto byte_count(t) { if starts_character(t, at) { count += 1 } }
	count
}
# t's character at a place, counted from 1: `"abc"#2` is "b"
#(t: text, place: int): text := {
	start = character_offset(t, place)
	bytes_between(t, start, if start < byte_count(t) then character_end(t, start) else start)
}

# part's bytes stand in t from byte offset at on
bytes_match_at(t: text, part: text, at: int): bool := {
	if at < 0 or at + byte_count(part) > byte_count(t) { return no }
	i = 0
	while i < byte_count(part) {
		if byte_at(t, at + i) != byte_at(part, i) { return no }
		i += 1
	}
	yes
}
starts_with(t: text, start: text): bool := bytes_match_at(t, start, 0)
ends_with(t: text, end: text): bool := bytes_match_at(t, end, byte_count(t) - byte_count(end))
# the character position of part's first place in t, counted from 1; 0 when t holds no part
find(t: text, part: text): int := find(t, part, 1)
# part's first place in t at or after the position `from`, read in place: `find("abab", "b", 3)` is 4
find(t: text, part: text, from: int): int := {
	at = character_offset(t, from)
	position = from
	while at <= byte_count(t) - byte_count(part) {
		if bytes_match_at(t, part, at) { return position }
		at = character_end(t, at)
		position += 1
	}
	0
}
contains(t: text, part: text): bool := find(t, part) > 0
# how often part is in t, the places apart: `"banana".count("an")` is 2
count(t: text, part: text): int := {
	found = 0
	at = find(t, part)
	while at > 0 {
		found += 1
		at = find(t, part, at + #part)
	}
	found
}
# the byte offset of part's first place in t, counted from 0, ø when t holds no part: `"éb".byte_index_of("b")` is 2
# (wiki/indexing.md)
byte_index_of(t: text, part: text): int? := {
	for at in 0 ..< byte_count(t) - byte_count(part) + 1 {
		if bytes_match_at(t, part, at) { return at }
	}
	ø
}
# a text in a text, a char in a text: `"b" in "abc"`, `'\n' in line` (lists.wap in for a list's item)
in(part: text, t: text): bool := t.contains(part)
in(c: char, t: text): bool := t.contains(text(c))
# t without the blanks (spaces, tabs, line ends) at its start and end: `"  a b ".trim()` is "a b"
trim(t: text): text := trimmed_where(t, is_blank_byte)
# t without the bytes that cut tells at its start and end
trimmed_where(t: text, cut: (int) -> bool): text := {
	start = 0
	stop = byte_count(t)
	while start < stop and cut(byte_at(t, start)) { start += 1 }
	while stop > start and cut(byte_at(t, stop - 1)) { stop -= 1 }
	bytes_between(t, start, stop)
}
# texts alike but for case and the blanks and punctuation around them: `"Hello!" ~ "hello"` (wiki/operator.md)
~(a: text, b: text): bool := rough_text(a) == rough_text(b)
rough_text(t: text): text := lower(trimmed_where(t, is_no_word_byte))
# a byte of no letter or digit; a byte of a character past ASCII counts as a letter's
is_no_word_byte(b: int): bool := b < 128 and not is_alphanumeric(byte_text(b))
is_blank_byte(b: int): bool := b in BLANK_BYTES
# the parts of t between its separators, in order: `"a/b".split("/")` is ["a", "b"], a text without one is its only part
split(t: text, separator: text): list<text> := {
	parts: list<text> = []
	start = 0
	at = 0
	while at <= byte_count(t) - byte_count(separator) and byte_count(separator) > 0 {
		if bytes_match_at(t, separator, at) {
			parts.add(bytes_between(t, start, at))
			at += byte_count(separator)
			start = at
		} else {
			at += 1
		}
	}
	parts.add(bytes_between(t, start, byte_count(t)))
	parts
}
# t backwards, character by character: `"abc".reverse` is "cba"
reverse(t: text): text := t.codepoints.reverse.map(c => text(c)).join("")
# the words of t, the parts between its blanks: `words("a  b\tc")` is ["a", "b", "c"]
words(t: text): list<text> := t.bytes.map(b => byte_text(if is_blank_byte(b) then BLANK_BYTES#1 else b)).join("").split(" ").filter(part => part != "")
# t with each place of a part given another text: `"a-b-c".replace("-", "+")` is "a+b+c"
replace(t: text, part: text, other: text): text := split(t, part).join(other)

# texts in byte order, which is code point order: `"a" < "b"`
<(a: text, b: text): bool := compared(a, b) < 0
# below 0 when a comes first, 0 when equal, above 0 when b does
compared(a: text, b: text): int := {
	at = 0
	while at < byte_count(a) and at < byte_count(b) {
		if byte_at(a, at) != byte_at(b, at) { return byte_at(a, at) - byte_at(b, at) }
		at += 1
	}
	byte_count(a) - byte_count(b)
}


# a text in warp notation, in its quotes, its quote, backslash, line breaks and tabs escaped: `show("a\"b")` is
# "a\"b"; a character shows as its one-character text
show(t: text): text := "\"" + escaped(t) + "\""
show(c: char): text := show(text(c))
# t with a backslash before each quote and backslash, its line breaks, tabs and carriage returns as \n, \t and \r
escaped(t: text): text := t.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\t", "\\t").replace("\r", "\\r")
# t's lines from its first written one to its last, without the indentation the written ones share: a raw block as
# a word taking one reads it, `shader { … }` (wiki/dsl.md)
dedented(t: text): text := {
	lines = t.split("\n")
	written = (1 to #lines).filter(at => lines#at.trim() != "")
	if written is empty { return "" }
	common = min(written.map(at => indent_width(lines#at)))
	lines[written#1 - 1 .. written.last].map(line => if line.trim() == "" then "" else line[common .. #line]).join("\n")
}
# the blanks a line starts with
indent_width(line: text): int := {
	width = 0
	while width < byte_count(line) and is_blank_byte(byte_at(line, width)) { width += 1 }
	width
}
