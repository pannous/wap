# The traits wap has words for (wiki/trait.md "Built-in traits"): what a value can do, each a class of the words a
# type conforms by defining for itself, no claim needed. The table's other traits come when a word of theirs exists.
trait Equatable { equals(b): bool }
trait Orderable { less(b): bool }
trait Comparable { compare(b): int }
trait Sized { size(): int }
trait Iterable { iterate(): list }
trait Addable { add(b) }
trait Printable { text(): text }

# the order of numbers and texts as Comparable reads it: negative, 0 or positive as a is before, at or after b
compare(a: int, b: int): int := a - b
compare(a: float, b: float): int := order_of(a < b, a > b)
compare(a: text, b: text): int := order_of(a < b, a > b)
order_of(before: bool, after: bool): int := if before then -1 else if after then 1 else 0
compare(a: char, b: char): int := ord(a) - ord(b)
# a value equals one of its type field by field, cases by tag and fields, lists item by item (core/emit/equality.wap),
# as `==` compares two values of one type through equals (prelude.wap); a type's own equals is the more specific choice
equals(a: T, b: T): bool := prim tag_equal(a, b)
# the order of a type that conforms, through its own compare: `<`, and with it `>`, `<=` and `>=` (prelude.wap),
# `sorted` and `min`; a type's own `<` is the more specific choice
<(a: Comparable, b: Comparable): bool := compare(a, b) < 0
# what a type walks as, through its own iterate, as `for` takes it (sugar/loops.wap); a list walks as itself
iterate(xs: list<T>): list<T> := xs
walked(g: Iterable): list := iterate(g)
