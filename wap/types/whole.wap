# Whole numbers past 64 bits (wiki/number.md "Whole numbers"): an int is exact and never overflows, so where a sum,
# difference or product leaves 64 bits the running program carries into a Whole, a sign and a Magnitude
# (kernel/magnitude.wap). small(w) gives the int back where the number fits 64 bits again, so each number has one
# spelling: the running program keeps a Whole only outside 64 bits. ÷ and % are the Euclidean pair ints have
# (prelude.wap): the remainder is never negative.

# a whole number, its sign and its size; zero is never negative
class Whole { negative: bool; size: Magnitude }

whole(n: int): Whole := Whole(n < 0, magnitude(n))
signed(negative: bool, size: Magnitude): Whole := Whole(negative and not is_zero(size), size)
# the int a whole number is where it fits 64 bits, ø past them
small(w: Whole): int? := {
	if compared(w.size, LARGEST_SIZE) <= 0 { return if w.negative then -whole(w.size) else whole(w.size) }
	if w.negative and compared(w.size, SMALLEST_SIZE) == 0 then SMALLEST_INT else ø
}
LARGEST_SIZE := magnitude(9223372036854775807)
SMALLEST_INT := -9223372036854775807 - 1
SMALLEST_SIZE := magnitude(SMALLEST_INT)

-(w: Whole): Whole := signed(not w.negative, w.size)
+(a: Whole, b: Whole): Whole := {
	if a.negative == b.negative { return signed(a.negative, sum(a.size, b.size)) }
	if compared(a.size, b.size) >= 0 then signed(a.negative, difference(a.size, b.size)) else signed(b.negative, difference(b.size, a.size))
}
-(a: Whole, b: Whole): Whole := a + -b
*(a: Whole, b: Whole): Whole := signed(a.negative != b.negative, product(a.size, b.size))
# the Euclidean quotient and remainder: a == b * (a ÷ b) + a % b with 0 ≤ a % b < |b|
÷(a: Whole, b: Whole): Whole := {
	parts = divided(a.size, b.size)
	if not a.negative { return signed(b.negative, parts.quotient) }
	signed(not b.negative, if is_zero(parts.rest) then parts.quotient else sum(parts.quotient, ONE))
}
%(a: Whole, b: Whole): Whole := {
	rest = divided(a.size, b.size).rest
	Whole(no, if a.negative and not is_zero(rest) then difference(b.size, rest) else rest)
}
# -1, 0 or 1
compared(a: Whole, b: Whole): int := {
	if a.negative != b.negative { return if a.negative then -1 else 1 }
	if a.negative then compared(b.size, a.size) else compared(a.size, b.size)
}
==(a: Whole, b: Whole): bool := compared(a, b) == 0
<(a: Whole, b: Whole): bool := compared(a, b) < 0
text(w: Whole): text := (if w.negative then "-" else "") + digits(w.size)
