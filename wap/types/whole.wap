# Whole numbers past 64 bits (wiki/number.md "Whole numbers"): an int is exact and never overflows. The run holds an
# int as one i64 (kernel/scalars.wap): a scalar is its own word, any other int a handle of its Whole, a sign and a
# Magnitude (kernel/magnitude.wap), in the table below. The emitter runs a row on ints as its instruction while its
# operands and its value are scalars, and else as one of the carried functions here, so each number has one spelling.
# ÷ and % are the Euclidean pair ints have (prelude.wap): the remainder is never negative.

# a whole number, its sign and its size; zero is never negative
class Whole { negative: bool; size: Magnitude }

# the ints the run holds as their own words
type scalar = int where it >= SMALLEST_SCALAR and it <= LARGEST_SCALAR

whole(n: int): Whole := Whole(n < 0, magnitude(n))
signed(negative: bool, size: Magnitude): Whole := Whole(negative and not is_zero(size), size)
# the int a whole number is where it is a scalar, ø past them
small(w: Whole): int? := {
	if compared(w.size, if w.negative then SMALLEST_SIZE else LARGEST_SIZE) > 0 { return ø }
	if w.negative then 0 - whole(w.size) else whole(w.size)
}
LARGEST_SIZE := magnitude(LARGEST_SCALAR)
SMALLEST_SIZE := magnitude(0 - SMALLEST_SCALAR)

-(w: Whole): Whole := signed(not w.negative, w.size)
+(a: Whole, b: Whole): Whole := {
	if a.negative == b.negative { return signed(a.negative, sum(a.size, b.size)) }
	if compared(a.size, b.size) >= 0 then signed(a.negative, difference(a.size, b.size)) else signed(b.negative, difference(b.size, a.size))
}
-(a: Whole, b: Whole): Whole := a + -b
*(a: Whole, b: Whole): Whole := signed(a.negative != b.negative, product(a.size, b.size))
# the Euclidean quotient and remainder: a == b * (a ÷ b) + a % b with 0 ≤ a % b < |b|
÷(a: Whole, b: Whole): Whole := {
	parts = divided(a.size, b.size)
	if not a.negative { return signed(b.negative, parts.quotient) }
	signed(not b.negative, if is_zero(parts.rest) then parts.quotient else sum(parts.quotient, ONE))
}
%(a: Whole, b: Whole): Whole := {
	rest = divided(a.size, b.size).rest
	Whole(no, if a.negative and not is_zero(rest) then difference(b.size, rest) else rest)
}
# the quotient toward zero and its remainder, of the dividend's sign, as the machine's rows divide
truncated_quotient(a: Whole, b: Whole): Whole := signed(a.negative != b.negative, divided(a.size, b.size).quotient)
truncated_remainder(a: Whole, b: Whole): Whole := signed(a.negative, divided(a.size, b.size).rest)
# 2 to a power
power_of_two(n: int): Whole := (1 to n).fold(whole(1), (power, at) => power * whole(2))
# -1, 0 or 1
compared(a: Whole, b: Whole): int := {
	if a.negative != b.negative { return if a.negative then -1 else 1 }
	if a.negative then compared(b.size, a.size) else compared(a.size, b.size)
}
==(a: Whole, b: Whole): bool := compared(a, b) == 0
<(a: Whole, b: Whole): bool := compared(a, b) < 0
text(w: Whole): text := (if w.negative then "-" else "") + digits(w.size)
float(w: Whole): float := (if w.negative then -1.0 else 1.0) * w.size.limbs.reverse().fold(0.0, (value, limb) => value * float(LIMB) + float(limb))

# The table of the whole numbers past the scalars the program made, a handle's place in it its word above the smallest
# word, and each number's handle by its digits
wholes: list<Whole> = []
handles: map<text, int> = {}
# an int's word as it is held, and a word held as an int, neither converted
word_of(n: int): i64 := prim as_is(n)
int_held(w: i64): int := prim as_is(w)
# the smallest word, the first handle
SMALLEST_WORD: i64 := word_of(SMALLEST_SCALAR) - word_of(HANDLES)
is_handle(w: i64): bool := w < word_of(SMALLEST_SCALAR)
# the whole number an int is: its handle's, or its own
whole_of(n: int): Whole := if is_handle(word_of(n)) then wholes[int_held(word_of(n) - SMALLEST_WORD)] else whole(n)
# the int a whole number is: itself where it is a scalar, else its handle, the one it was given before or a new one;
# past HANDLES of them the program stops, naming the limit, never giving a wrong number
int_of(w: Whole): int := small(w) ?? handle_of(w)
handle_of(w: Whole): int := {
	key = text(w)
	known = handles.get(key)
	if known != ø { return known! }
	if #wholes == HANDLES { raise "a program makes at most ${HANDLES} whole numbers past ±9223372032559808512, and this one needs more" }
	handle = int_held(SMALLEST_WORD + word_of(#wholes))
	wholes.add(w)
	handles[key] = handle
	handle
}
# a word as the int it is, a handle where it is below the scalars, and an int's word, the number wrapped by 2^64
# (core/analyze/fits.wap converted)
widened(w: i64): int := if is_handle(w) then handle_of(Whole(yes, difference(BEYOND_WORDS, magnitude(int_held(w - SMALLEST_WORD))))) else int_held(w)
wrapped(w: i64): i64 := if is_handle(w) then whole_word(wholes[int_held(w - SMALLEST_WORD)]) else w
whole_word(w: Whole): i64 := {
	size = w.size.limbs.reverse().fold(word_of(0), (value, limb) => value * word_of(LIMB) + word_of(limb))
	if w.negative then word_of(0) - size else size
}
# 2^63, the size of the smallest word
BEYOND_WORDS := sum(LARGEST_SIZE, ONE)

# The bits of whole numbers, two's complement without end: a negative number's bits are its complement's, -w - 1,
# flipped. Sizes are combined 32 bits at a time
CHUNK := 4294967296
CHUNK_MASK := CHUNK - 1
CHUNK_SIZE := magnitude(CHUNK)
complement(w: Whole): Whole := -w - whole(1)
# a size's chunks, the lowest first, and the whole number chunks make
chunks(m: Magnitude): list<int> := {
	parts: list<int> = []
	rest = m
	while not is_zero(rest) {
		parts.add(whole(divided(rest, CHUNK_SIZE).rest))
		rest = divided(rest, CHUNK_SIZE).quotient
	}
	parts
}
chunked(parts: list<int>): Whole := parts.reverse().fold(whole(0), (value, part) => value * whole(CHUNK) + whole(part))
# two sizes' bits combined chunk by chunk
combined(a: Magnitude, b: Magnitude, bits: (int, int) -> int): Whole := {
	x = chunks(a)
	y = chunks(b)
	chunked((0 upto max(#x, #y)).map(at => bits(if at < #x then x[at] else 0, if at < #y then y[at] else 0)))
}
# a chunk's bits and those another's leaves off
unmasked(x: int, y: int): int := x & (y xor CHUNK_MASK)
&(a: Whole, b: Whole): Whole := {
	if a.negative and not b.negative { return b & a }
	if not b.negative { return combined(a.size, b.size, (x, y) => x & y) }
	if not a.negative { return combined(a.size, complement(b).size, unmasked) }
	complement(combined(complement(a).size, complement(b).size, (x, y) => x | y))
}
|(a: Whole, b: Whole): Whole := {
	if a.negative and not b.negative { return b | a }
	if not b.negative { return combined(a.size, b.size, (x, y) => x | y) }
	if not a.negative { return complement(combined(complement(b).size, a.size, unmasked)) }
	complement(combined(complement(a).size, complement(b).size, (x, y) => x & y))
}
xor(a: Whole, b: Whole): Whole := {
	if a.negative and not b.negative { return xor(b, a) }
	if not b.negative { return combined(a.size, b.size, (x, y) => x xor y) }
	if not a.negative { return complement(combined(a.size, complement(b).size, (x, y) => x xor y)) }
	combined(complement(a).size, complement(b).size, (x, y) => x xor y)
}
# a word shifted right with zeros in, as the machine shifts
unsigned_halved(w: i64, b: i64): i64 := prim i64.shr_u(w, b)

# An int's rows where an operand or the value is past the scalars, each the row's value exact (kernel/scalars.wap
# CARRIED_ROWS); a shift's count is a scalar
carried_sum(a: int, b: int): int := int_of(whole_of(a) + whole_of(b))
carried_difference(a: int, b: int): int := int_of(whole_of(a) - whole_of(b))
carried_product(a: int, b: int): int := int_of(whole_of(a) * whole_of(b))
carried_quotient(a: int, b: int): int := int_of(truncated_quotient(whole_of(a), whole_of(b)))
carried_remainder(a: int, b: int): int := int_of(truncated_remainder(whole_of(a), whole_of(b)))
carried_shifted(a: int, b: int): int := int_of(whole_of(a) * power_of_two(b))
carried_halved(a: int, b: int): int := int_of(whole_of(a) ÷ power_of_two(b))
carried_and(a: int, b: int): int := int_of(whole_of(a) & whole_of(b))
carried_or(a: int, b: int): int := int_of(whole_of(a) | whole_of(b))
carried_xor(a: int, b: int): int := int_of(xor(whole_of(a), whole_of(b)))
# an unsigned shift reads the int as its 64-bit word (`-1 >>> 60` is 15), so an int no word holds has none
carried_unsigned_halved(a: int, b: int): int := {
	w = whole_of(a)
	if compared(w.size, if w.negative then BEYOND_WORDS else LARGEST_SIZE) > 0 { raise "${a} >>> ${b}: an unsigned shift reads a 64-bit word, and ${a} is past them" }
	widened(unsigned_halved(whole_word(w), word_of(b)))
}
carried_order(a: int, b: int): int := compared(whole_of(a), whole_of(b))
# an int past the scalars where the machine takes a 32-bit word: a list's place, a character's code
beyond_scalars(n: int): int := raise "${n} is past the whole numbers the machine takes here"
