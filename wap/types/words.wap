# The machine words (wiki/number.md, wiki/quotient.md "Quotients in the library", notes/coc-t8.md T8b): i64 as the whole
# numbers in 64 bits, a refinement of int with the wasm rows as its operations, which wrap where an int's rows refuse
# past i64. A law over i64 reads through the quotient of int by differences of multiples of 2^64: types/quotients.wap's
# quotient.of makes its values and its == (lift twice) compares them, so wrapped sums and products are equal to the
# exact ones as quotient values.

# the bits of i64
I64_BITS = 64
# the largest and the smallest whole number a signed word of this many bits holds
# TODO (card dependent-types) largest is right at 64 bits only through the compiler's own wrapping ints; written plainly
#   once whole numbers are exact (exact-big-literals)
largest(bits: int): int := 2 ^ (bits - 1) - 1
smallest(bits: int): int := -largest(bits) - 1

# the whole numbers that fit a machine word; a literal outside is refused naming the range
type i64 = int where it >= smallest(I64_BITS) and it <= largest(I64_BITS)

# TODO (card t8b) once the word rows mean their wrapping (WRAPPED_SUM …), a row that is one prim call needs no range check
# wasm's rows on words: sums, differences and products wrap, so the result is a word
+(a: i64, b: i64): i64 := prim i64.add(a, b)
-(a: i64, b: i64): i64 := prim i64.sub(a, b)
*(a: i64, b: i64): i64 := prim i64.mul(a, b)
# a word's quotient, Euclidean as int's: no zero divisor, and no -1 under the smallest word, whose quotient 2^63 is
# no word (wasm traps)
÷(a: i64, b: i64 where it != 0 and not (a == smallest(I64_BITS) and it == -1)): i64 := prim i64.div_s(a - a % b, b)
# the remainders, Euclidean as int's (wiki/Footguns.md "Negative modulo") and truncated; smallest % -1 is 0
%(a: i64, b: i64 where it != 0): i64 := euclidean(rem(a, b), b, 0 as i64)
rem(a: i64, b: i64 where it != 0): i64 := prim i64.rem_s(a, b)
<<(a: i64, b: i64): i64 := prim i64.shl(a, b)
==(a: i64, b: i64): bool := prim i64.eq(a, b)
<(a: i64, b: i64): bool := prim i64.lt_s(a, b)
<=(a: i64, b: i64): bool := prim i64.le_s(a, b)

# the word a whole number wraps to by 2^64, as the wrapping rows give it: the kernel's wrapping itself. A word is its
# own wrap; an int past one is its remainder by 2^64 above the smallest word
@kernel(word.wrapped)
wrapped_word(x: int): int := if x is i64 then x else (x - smallest(I64_BITS)) % 2 ^ I64_BITS + smallest(I64_BITS)
# two whole numbers are the same word when they wrap to the same word, so they differ by a multiple of 2^64: the
# relation i64's laws are read through, reflexive, symmetric and transitive as == is
same_wrapped(a: int, b: int) := wrapped_word(a) == wrapped_word(b)
type wrapped = quotient(int, same_wrapped)
# a word wraps to itself: the kernel's theorem, stated there and proved there
@kernel(word.wrapped_twice)
law wrapped_twice(x: int): wrapped_word(wrapped_word(x)) == wrapped_word(x)

# a word's rows give the exact result as the same wrapped number: the wrapping row's result and the exact sum of the
# two as ints (int's own rows, the kernel's ·sum and ·times by int's two cases, the operands read as ints) are one value
# of the quotient; the right side's quotient is the one == takes, so only the left names it
# (the two quotient values compare as same_wrapped of the wrapping result and the exact one, which is wrapped_twice)
law word_sum_wraps(a: i64, b: i64): (quotient.of((a + b) as int) as wrapped) == quotient.of((a as int) + (b as int)) := by wrapped_twice
law word_product_wraps(a: i64, b: i64): (quotient.of((a * b) as int) as wrapped) == quotient.of((a as int) * (b as int)) := by wrapped_twice
# TODO (card t8b) i32 as the same refinement of int by largest(32): its layout is 32 bits by its name (kernel/primitives.wap
#   WORD_LAYOUTS, the host words, memory lists), and a refinement of int is laid out as int, so it waits on storage by
#   range (T8c)
