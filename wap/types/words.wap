# The machine words (wiki/number.md, wiki/quotient.md "Quotients in the library", notes/coc-t8.md T8b): i64 as the whole
# numbers in 64 bits, a refinement of int with the wasm rows as its operations, which wrap where an int's rows refuse
# past i64. A law over i64 reads through the quotient of int by differences of multiples of 2^64: types/quotients.wap's
# quotient.of makes its values and its == (lift twice) compares them, so wrapped sums and products are equal to the
# exact ones as quotient values. Included from types.wap with quotients.wap, its i64 then replacing numbers.wap's.

# the range of a word of this many bits, and the modulus its wrapping rows count by
WORD_BITS = 64
WORD_MODULUS = 2 ^ WORD_BITS
WORD_LARGEST = WORD_MODULUS ÷ 2 - 1
WORD_SMALLEST = -WORD_LARGEST - 1

# the whole numbers that fit a machine word; a literal outside is refused naming the range (T4d1)
type i64 = int where it >= WORD_SMALLEST and it <= WORD_LARGEST

# TODO (card t8b) a prim is trusted at its declared result type, so a row that is one prim call needs no range check
# wasm's rows on words: sums, differences and products wrap, so the result is a word
+(a: i64, b: i64): i64 := prim i64.add(a, b)
-(a: i64, b: i64): i64 := prim i64.sub(a, b)
*(a: i64, b: i64): i64 := prim i64.mul(a, b)
÷(a: i64, b: i64): i64 := prim i64.div_s(a, b)
%(a: i64, b: i64): i64 := prim i64.rem_s(a, b)
<<(a: i64, b: i64): i64 := prim i64.shl(a, b)
==(a: i64, b: i64): bool := prim i64.eq(a, b)
<(a: i64, b: i64): bool := prim i64.lt_s(a, b)
<=(a: i64, b: i64): bool := prim i64.le_s(a, b)

# two whole numbers are the same word when they differ by a multiple of 2^64: the relation i64's laws are read through
same_wrapped(a: int, b: int) := (a - b) % WORD_MODULUS == 0
type wrapped = quotient(int, same_wrapped)

# a word's rows give the exact result as the same wrapped number: the wrapping row's result and the exact sum of the
# two as ints (int's own rows, the kernel's ·sum and ·times by int's two cases, the operands read as ints) are one value
# of the quotient; the right side's quotient is the one == takes, so only the left names it
law word_sum_wraps(a: i64, b: i64): (quotient.of((a + b) as int) as wrapped) == quotient.of((a as int) + (b as int))
law word_product_wraps(a: i64, b: i64): (quotient.of((a * b) as int) as wrapped) == quotient.of((a as int) * (b as int))
# TODO (card t8b) i32, the machine word of 32 bits (kernel/primitives.wap WORD_LAYOUTS) as the same refinement: WORD_BITS a parameter of the declaration
